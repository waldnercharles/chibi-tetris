version 1
name "ReactionChecks"
(array)entities {
    - {
        name "World"
        prototype "TestWorld"
        components {
            Session mode=1 effects=0
        }
    }
    - {
        name "Board1"
        prototype "Board"
        components {
            GlobalBinding name="Board1"
        }
    }
    - {
        name "Report"
        prototype "TestReport"
        (array)behaviors "ReactionChecks"
    }
}
