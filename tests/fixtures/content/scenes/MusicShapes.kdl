    }
    - {
        name "Label3"
        prototype "HudText"
        components {
            MeshAsset source="content/meshes/text/digit_3.mesh"
            RenderState hidden=#false
            Transform3D {
                position x=-430.0 y=-105.0 z=0.0
                scale x=16.0 y=16.0 z=1.0
            }
        }
    }
    - {
        name "Shape3"
        prototype "MusicShapeField"
        components {
            GlobalBinding name="Shape3"
            Transform3D {
                position x=430.0 y=-250.0 z=0.0
                scale x=0.19 y=0.19 z=0.19
            }
        }
    }
    - {
        name "Label4"
        prototype "HudText"
