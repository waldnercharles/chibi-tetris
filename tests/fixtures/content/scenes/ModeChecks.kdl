version 1
name "ModeChecks"
(array)entities {
    - name="World" prototype="World"
    - {
        name "Board1"
        prototype "TestBoard"
        components {
            GlobalBinding name="Board1"
        }
    }
    - {
        name "Board2"
        prototype "TestBoard"
        components {
            GlobalBinding name="Board2"
        }
    }
    - {
        name "Report"
        prototype "TestReport"
        (array)behaviors "ModeChecks"
    }
}
