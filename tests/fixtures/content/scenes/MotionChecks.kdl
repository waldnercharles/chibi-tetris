version 1
name "MotionChecks"
(array)entities {
    - name="Camera" prototype="Camera"
    - name="World" prototype="TestWorld"
    - {
        name "Board1"
        prototype "Board"
        components {
            GlobalBinding name="Board1"
            BoardState index=0
        }
    }
    - {
        name "Report"
        prototype "TestReport"
        (array)behaviors "MotionChecks"
    }
}
