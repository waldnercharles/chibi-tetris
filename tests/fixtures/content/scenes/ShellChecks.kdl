version 1
name "ShellChecks"
(array)entities {
    - {
        name "World"
        prototype "World"
        components {
            Session audio_ready=#true
        }
    }
    - {
        name "Board1"
        prototype "TestBoard"
        components {
            GlobalBinding name="Board1"
        }
    }
    - {
        name "Board2"
        prototype "TestBoard"
        components {
            GlobalBinding name="Board2"
        }
    }
    - {
        name "Report"
        prototype "TestReport"
        (array)behaviors "ShellChecks"
    }
}
