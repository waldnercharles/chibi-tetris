version 1
name "StageChecks"
presentation "3d"
(array)entities {
    - {
        name "World"
        prototype "ConsumerWorld"
        components {
            Session effects=2 mode=0 run=1 screen=1
            StageState seed=800001.0
        }
    }
    - {
        name "Board1"
        prototype "TestBoard"
        components {
            GlobalBinding name="Board1"
            BoardState index=0
        }
    }
    - {
        name "Board2"
        prototype "TestBoard"
        components {
            GlobalBinding name="Board2"
            BoardState index=1
        }
    }
    - name="Vortex" prototype="VortexField"
    - name="Stars" prototype="StarField"
    - name="Environment" prototype="Environment"
    - {
        name "Report"
        prototype "TestReport"
        (array)behaviors "StageChecks"
    }
}
