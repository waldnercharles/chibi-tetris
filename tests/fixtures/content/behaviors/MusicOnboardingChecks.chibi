// Exercises the production chooser and board without a browser audio source.
behavior MusicOnboardingChecks {
    world: entity
    board: entity
    frame: int = 0
    waiting_row: int = 0
    waiting_run: int = 0
    waiting_elapsed := 0

    function Check(condition: bool, message: string) {
        self.TestReport.checks += 1
        if condition {
            return
        }
        self.TestReport.failures += 1
        if self.TestReport.first_failure == "" {
            self.TestReport.first_failure = message
        }
    }

    on Begin {
        world = get_global_variable("World")
        board = get_global_variable("Board1")
    }

    on Tick {
        match (frame) {
            case 1 {
                Check(world.Session.screen == 0 && !world.Session.audio_ready, "launch offers play or connect audio")
                Check(world.Session.run == 0 && world.Session.elapsed == 0, "launch has no active run or timer")
                waiting_row = board.BoardState.row
                world.Session.audio_request = 2
            }
            case 4 {
                Check(world.Session.audio_source == 1 && world.Session.audio_status == 1, "connect directly requests host audio capture")
                Check(world.Session.screen == 0 && !world.Session.audio_ready, "pending capture retains the opening actions")
                world.Session.audio_request = 2
            }
            case 7 {
                Check(world.Session.audio_source == 1 && world.Session.audio_status == 1, "retry directly requests capture again")
                Check(!world.Session.audio_signal && !world.Session.audio_ready, "retry never fabricates connected audio")
            }
            case 10 {
                Check(world.Session.audio_request == 0, "capture command is consumed once")
                Check(world.Session.run == 0, "pending capture does not create a run")
            }
            case 13 {
                Check(world.Session.screen == 0 && !world.Session.audio_ready, "pending capture keeps play available")
                Check(world.Session.elapsed == 0, "pending capture leaves the timer stopped")
                world.Session.audio_request = 2
            }
            case 16 {
                Check(world.Session.audio_source == 1 && world.Session.audio_status == 1, "repeated retries remain explicit capture requests")
                Check(!world.Session.audio_signal && !world.Session.audio_ready, "pending stream has no fabricated signal")
            }
            case 120 {
                Check(world.Session.run == 0 && world.Session.elapsed == 0, "capture waiting never advances the timer")
                Check(board.BoardState.pieces > 0 && world.Session.attract, "capture waiting keeps the real demonstration playing")
                Check(world.Session.audio_source == 1 && !world.Session.audio_ready, "capture waiting never silently falls back to score")
            }
            case 355 {
                Check(world.Session.screen == 1 && world.Session.audio_ready && world.Session.run == 1 && world.Session.mode == 0, "Play completes the clear handoff while capture is pending")
                Check(world.Session.audio_source == 0, "explicit score clears the external source selection")
            }
            case 362 {
                Check(world.Session.elapsed > 0, "timer begins after the explicit score choice and reveal")
                waiting_run = world.Session.run
                waiting_elapsed = world.Session.elapsed
                waiting_row = board.BoardState.row
            }
            case 368 {
                Check(world.Session.screen == 0 && !world.Session.audio_ready && world.Session.audio_source == 1 && world.Session.audio_status == 1, "M from pause directly requests audio capture")
                Check(world.Session.audio_return_screen == 2, "source selection remembers the paused screen")
                Check(world.Session.run == waiting_run && world.Session.elapsed == waiting_elapsed, "reconnecting preserves the run and paused timer")
                Check(board.BoardState.row == waiting_row, "reconnecting preserves the paused falling piece")
                world.Session.audio_request = 1
            }
            case 372 {
                Check(world.Session.screen == 2 && world.Session.audio_ready, "explicit fallback returns to the existing pause")
                Check(world.Session.run == waiting_run && world.Session.elapsed == waiting_elapsed, "reconnection does not reset or resume a paused run")
                self.TestReport.done = true
            }
        }
        frame += 1
    }
}
