// Exercises the production chooser and board without a browser audio source.
behavior MusicOnboardingChecks {
    world: entity
    board: entity
    frame: int = 0
    waiting_row: int = 0
    waiting_run: int = 0
    waiting_elapsed := 0

    function Check(condition: bool, message: string) {
        self.TestReport.checks += 1
        if condition {
            return
        }
        self.TestReport.failures += 1
        if self.TestReport.first_failure == "" {
            self.TestReport.first_failure = message
        }
    }

    on Begin {
        world = get_global_variable("World")
        board = get_global_variable("Board1")
    }

    on Tick {
        match (frame) {
            case 1 {
                Check(world.Session.screen == 0 && !world.Session.audio_ready, "launch waits for an explicit music choice")
                Check(world.Session.run == 0 && world.Session.elapsed == 0, "launch has no active run or timer")
                waiting_row = board.BoardState.row
                world.Session.audio_request = 1
            }
            case 4 {
                Check(world.Session.audio_provider == 1, "YouTube command selects its launch request")
                Check(world.Session.screen == 0 && world.Session.audio_source == 0 && !world.Session.audio_ready, "opening YouTube does not imply captured audio")
                world.Session.audio_request = 2
            }
            case 7 {
                Check(world.Session.audio_provider == 2, "Spotify command selects its launch request")
                Check(world.Session.screen == 0 && !world.Session.audio_ready, "opening Spotify does not start the run")
                world.Session.audio_request = 3
            }
            case 10 {
                Check(world.Session.audio_provider == 3, "TIDAL command selects its launch request")
                Check(world.Session.audio_choice == 3, "provider launch leaves share audio as the next confirm action")
                world.Session.audio_request = 5
            }
            case 13 {
                Check(world.Session.audio_source == 1 && world.Session.audio_status == 1, "share audio waits for the host permission and signal")
                Check(world.Session.screen == 0 && !world.Session.audio_ready, "waiting capture cannot start a run")
                world.Session.audio_request = 5
            }
            case 16 {
                Check(world.Session.audio_source == 1 && world.Session.audio_status == 1, "retry remains an explicit capture request")
                Check(!world.Session.audio_signal && !world.Session.audio_ready, "retry never fabricates an audio signal")
            }
            case 65 {
                Check(world.Session.run == 0 && world.Session.elapsed == 0, "capture waiting never advances the timer")
                Check(board.BoardState.row == waiting_row && board.BoardState.pieces == 0, "capture waiting never drops or locks a piece")
                Check(world.Session.audio_source == 1 && !world.Session.audio_ready, "capture waiting never silently falls back to score")
            }
            case 80 {
                Check(world.Session.screen == 1 && world.Session.audio_ready && world.Session.run == 1 && world.Session.mode == 0, "score shortcut starts journey once without also choosing duet")
                Check(world.Session.audio_source == 0 && world.Session.audio_provider == 0, "explicit score clears the external source selection")
                Check(world.Session.elapsed > 0, "timer begins only after the explicit score choice")
            }
            case 87 {
                waiting_run = world.Session.run
                waiting_elapsed = world.Session.elapsed
                waiting_row = board.BoardState.row
            }
            case 93 {
                Check(world.Session.screen == 0 && !world.Session.audio_ready, "M from pause reopens the chooser")
                Check(world.Session.audio_return_screen == 2, "source selection remembers the paused screen")
                Check(world.Session.run == waiting_run && world.Session.elapsed == waiting_elapsed, "reconnecting preserves the run and paused timer")
                Check(board.BoardState.row == waiting_row, "reconnecting preserves the paused falling piece")
                world.Session.audio_request = 4
            }
            case 97 {
                Check(world.Session.screen == 2 && world.Session.audio_ready, "explicit fallback returns to the existing pause")
                Check(world.Session.run == waiting_run && world.Session.elapsed == waiting_elapsed, "reconnection does not reset or resume a paused run")
                self.TestReport.done = true
            }
        }
        frame += 1
    }
}
