// The real stage director must retain every transition coordinate while stopped.
behavior StageChecks {
    world: entity
    frame: int = 0
    frozen_style := 0
    frozen_clock := 0
    frozen_seed := 0
    frozen_direction := vec3(0, 0, 0)
    frozen_light := 0
    frozen_color: uint = 0
    frozen_revision: int = 0
    transition_baseline := 0
    transition_clock := 0
    wrap_revision: int = 0
    frozen_character := vec3(0, 0, 0)
    frozen_structure := vec3(0, 0, 0)
    section_baseline := 0

    function Check(condition: bool, message: string) {
        self.TestReport.checks += 1
        if condition {
            return
        }
        self.TestReport.failures += 1
        if self.TestReport.first_failure == "" {
            self.TestReport.first_failure = message
        }
    }

    on Begin {
        world = get_global_variable("World")
        ReactionRules.Initialize(world, 1)
        ReactionRules.Initialize(get_global_variable("Board1"), 1)
        ReactionRules.Initialize(get_global_variable("Board2"), 1)
    }

    function LightSum() -> (value: number) {
        value = 0
        lights := find_entities_with_component("PointLight")
        for light in lights {
            if light.PointLight.radius == 1700 {
                value += light.PointLight.intensity
            }
        }
        return value
    }

    function Frozen() {
        Check(world.StageState.character.x == frozen_character.x && world.StageState.character.y == frozen_character.y && world.StageState.character.z == frozen_character.z, "musical traits freeze at their rendered values while stopped")
        Check(world.StageState.structure.x == frozen_structure.x && world.StageState.structure.y == frozen_structure.y && world.StageState.structure.z == frozen_structure.z, "section shape and density freeze while stopped")
        Check(world.StageState.style == frozen_style, "stage morph retains its exact position while stopped")
        Check(world.StageState.clock == frozen_clock, "stage lighting and particle flow retain their clock while stopped")
        Check(world.StageState.seed == frozen_seed, "stopped state and new run never reseed stable particle identities")
        Check(world.StageState.revision == frozen_revision, "paused audio and chapter changes do not advance the stage")
        Check(world.DirectionalLight.color == frozen_color, "the complete stage palette retains its color while stopped")
        direction := world.DirectionalLight.direction
        Check(direction.x == frozen_direction.x && direction.y == frozen_direction.y && direction.z == frozen_direction.z, "the directional light retains its orientation while stopped")
    }

    function Palette(family: int) {
        color := world.DirectionalLight.color
        red := cast<number>(color >> 24 & cast<uint>(255))
        green := cast<number>(color >> 16 & cast<uint>(255))
        blue := cast<number>(color >> 8 & cast<uint>(255))
        match (family) {
            case 0 {
                Check(blue > red + 70 && green > red + 60, "ordered orbits light the well with a cyan palette")
            }
            case 1 {
                Check(abs(red - green) < 12 && abs(green - blue) < 30, "tonal ribbons use pale ivory light")
            }
            case 2 {
                Check(red > green + 60 && green > blue + 60, "airy branches have a distinct amber palette")
            }
            case 3 {
                Check(green > red + 90 && blue > red + 70, "dense clouds use teal light")
            }
        }
    }

    function StageGeometry() {
        count: int = 0
        geometry := find_entities_with_component("Geometry3D")
        for item in geometry {
            if item.Geometry3D.depth > 10 {
                count += 1
            }
        }
        Check(count == 0, "the cosmic stage has no surrounding solid facets")
        count = 0
        lights := find_entities_with_component("PointLight")
        for light in lights {
            if light.PointLight.radius == 1700 {
                count += 1
            }
        }
        Check(count == 3, "removing the facets retains all three real stage lights")
    }

    on Tick {
        match (frame) {
            case 4 {
                Check(world.StageState.seed == 800001 && world.StageState.style == 1, "explicit seed reproduces the ivory orbital opening")
                Palette(1)
                Check(world.StageState.revision == 1 && world.StageState.reason == 1, "startup publishes one stage revision")
                Check(world.StageState.transition == 1 && world.StageState.target == 1, "startup begins fully settled without a morph from zero")
                Check(LightSum() > 8, "the stage has actual local lights with measurable intensity")
                world.Session.stage = 1
            }
            case 6 {
                Check(world.StageState.revision == 1 && world.StageState.style == 1, "chapter progress never overrides the measured musical form")
                world.MusicCharacterState.ready = true
                world.MusicCharacterState.character = vec3(0.9, 0.1, 0.1)
                world.MusicCharacterState.dynamics = vec3(0.6, 0.45, 0.9)
                world.MusicCharacterState.envelope = 0.55
                world.MusicCharacterState.selected = 0
                world.MusicCharacterState.section_serial = 1
                world.VisualState.energy = 0.75
                world.VisualState.bass = 0.8
                world.VisualState.mid = 0.3
                world.VisualState.treble = 0.2
            }
            case 9 {
                Check(world.StageState.target == 0 && world.StageState.style < 1 && world.StageState.style > 0.99, "percussive identity begins the shorter backward morph toward ordered orbits")
                Check(world.StageState.revision == 2 && world.StageState.reason == 2, "initial audible identity owns the first musical morph")
                frozen_character = world.StageState.character
                frozen_structure = world.StageState.structure
                frozen_style = world.StageState.style
                frozen_clock = world.StageState.clock
                frozen_seed = world.StageState.seed
                frozen_revision = world.StageState.revision
                frozen_direction = world.DirectionalLight.direction
                frozen_light = LightSum()
                frozen_color = world.DirectionalLight.color
                world.Session.screen = 2
            }
            case 13 {
                Frozen()
                Check(LightSum() == frozen_light, "pause retains the actual light intensities")
                world.Session.stage = 4
                world.Session.run = 2
                world.Session.seed = 99991
                world.VisualState.energy = 0.1
                world.VisualState.bass = 0.1
                world.VisualState.treble = 0.95
                world.MusicCharacterState.character = vec3(0.7, 0.25, 0.15)
                world.MusicCharacterState.envelope = 0.9
            }
            case 17 {
                Frozen()
                world.Session.screen = 1
                world.Session.reduced_motion = true
            }
            case 21 {
                Frozen()
                Check(LightSum() == 0, "reduced motion disables moving local light effects")
                world.Session.reduced_motion = false
                world.Session.effects = 0
            }
            case 25 {
                Frozen()
                Check(LightSum() == 0, "effects off disables local light effects")
                world.Session.effects = 2
            }
            case 28 {
                Check(world.StageState.style < frozen_style && frozen_style - world.StageState.style < 0.02, "resume continues the in-flight stage transition without a jump")
                Check(world.StageState.clock > frozen_clock && world.StageState.clock - frozen_clock < 0.1, "resume advances only the new frame deltas")
                Check(world.StageState.seed == frozen_seed && world.StageState.revision == frozen_revision, "resume and session restart retain the in-flight stage and stable seed")
                Check(LightSum() > 8, "resume restores the lit scene")
            }
            case 42 {
                Check(world.StageState.style < frozen_style && world.StageState.style > 0.85, "scene evolution remains smooth through subsequent audio frames")
                Check(world.StageState.revision == 2, "ordinary beats never masquerade as repeated song boundaries")
                world.Session.screen = 2
                world.StageState.style = 3
                world.StageState.target = 3
                world.StageState.transition = 1
            }
            case 43 {
                StageGeometry()
                Palette(3)
                world.Session.screen = 1
                world.MusicCharacterState.selected = 0
                world.MusicCharacterState.section_serial = 2
                world.MusicCharacterState.envelope = 0.7
            }
            case 46 {
                Check(world.StageState.target == 0 && world.StageState.style > 3 && world.StageState.style < 3.01, "dense clouds take the shorter wrap toward ordered cyan orbits")
                Check(world.StageState.transition > 0 && world.StageState.transition < 0.01, "the final-family morph begins gradually")
                transition_baseline = world.StageState.transition
                transition_clock = world.StageState.clock
                wrap_revision = world.StageState.revision
            }
            case 76 {
                elapsed := world.StageState.clock - transition_clock
                progress := world.StageState.transition - transition_baseline
                Check(elapsed > 0.49 && elapsed < 0.51, "the transition check observes thirty real advancing frames")
                Check(abs(progress - elapsed / 10) < 0.00001, "cosmic compositions morph over ten seconds instead of rushing through five")
                Check(world.StageState.revision == wrap_revision, "musical frames do not restart an in-flight composition")
                world.StageState.transition = 0.999
            }
            case 80 {
                Check(world.StageState.style == 0 && world.StageState.target == 0, "the completed final-family morph wraps to the same cyan endpoint")
                Palette(0)
                Check(world.StageState.transition == 1 && world.StageState.revision == wrap_revision, "wrap completion settles once without creating another transition")
                Check(world.StageState.seed == frozen_seed, "the complete cycle retains every stable particle identity")
                Check(LightSum() > 8, "the complete cycle retains the actual lit scene")
                section_baseline = world.StageState.structure.z
                world.MusicCharacterState.section_serial = 3
                world.MusicCharacterState.envelope = 1
            }
            case 82 {
                Check(world.StageState.section_serial == 3 && world.StageState.revision == wrap_revision && world.StageState.style == 0, "a same-family section updates ownership without rotating the composition")
                Check(world.StageState.structure.z > section_baseline, "a same-family section continuously changes the form envelope")
                world.Session.screen = 2
                world.StageState.style = 2
                world.StageState.target = 2
            }
            case 84 {
                Palette(2)
                world.StageState.style = 0
                world.StageState.target = 0
                world.StageState.transition = 1
                world.MusicCharacterState.selected = 3
                world.MusicCharacterState.section_serial = 4
                world.Session.screen = 1
            }
            case 87 {
                Check(world.StageState.target == 3 && world.StageState.style > 3.99 && world.StageState.style < 4, "the inverse wrap follows the adjacent family instead of visiting two unrelated forms")
                self.TestReport.done = true
            }
        }
        frame += 1
    }
}
