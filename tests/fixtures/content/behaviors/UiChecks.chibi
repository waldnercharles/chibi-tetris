// Click the production 3D controls, including collapsed and expanded hitboxes.
behavior UiChecks {
    world: entity
    camera: entity
    frame: int = 0

    function Check(condition: bool, message: string) {
        self.TestReport.checks += 1
        if condition {
            return
        }
        self.TestReport.failures += 1
        if self.TestReport.first_failure == "" {
            self.TestReport.first_failure = message
        }
    }

    function VisibleLabel(source: string) -> (visible: bool) {
        meshes := find_entities_with_component("MeshAsset")
        for mesh in meshes {
            if mesh.MeshAsset.source == source && !mesh.RenderState.hidden {
                return true
            }
        }
        return false
    }

    function LabelOpacity(source: string) -> (opacity: number) {
        for mesh in find_entities_with_component("MeshAsset") {
            if mesh.MeshAsset.source == source && !mesh.RenderState.hidden {
                return cast<number>(mesh.Material.scene & 255) / 255
            }
        }
        return 0
    }

    function OptionsHeight() -> (height: number) {
        for surface in find_entities_with_component("Shader") {
            if surface.Shader.material == "UiPlate" && surface.Geometry3D.width == 320 && surface.Transform3D.position.y < -35 && surface.Transform3D.position.z == 64 {
                return surface.Geometry3D.height
            }
        }
        return 0
    }

    function VisiblePlates() -> (count: int) {
        count = 0
        surfaces := find_entities_with_component("Shader")
        for surface in surfaces {
            if surface.Shader.material == "UiPlate" && !surface.RenderState.hidden {
                count += 1
            }
        }
        return count
    }

    function CameraNear(point: CF_V3) -> (depth: number) {
        rotation := camera.Transform3D.rotation
        return 2 * (rotation.x * rotation.z + rotation.w * rotation.y) * point.x + 2 * (rotation.y * rotation.z - rotation.w * rotation.x) * point.y + (1 - 2 * (rotation.x * rotation.x + rotation.y * rotation.y)) * point.z
    }

    function TextAbovePanels() -> (ordered: bool) {
        surfaces := find_entities_with_component("Shader")
        for label in surfaces {
            if label.Shader.material != "UiInk" || label.RenderState.hidden {
                continue
            }
            position := label.Transform3D.position
            for plate in surfaces {
                if plate.Shader.material != "UiPlate" || plate.RenderState.hidden {
                    continue
                }
                center := plate.Transform3D.position
                if abs(position.x - center.x) < plate.Geometry3D.width * 0.5 && abs(position.y - center.y) < plate.Geometry3D.height * 0.5 && CameraNear(position) <= CameraNear(center) + 1 {
                    return false
                }
            }
        }
        return true
    }

    on Begin {
        world = get_global_variable("World")
        camera = get_global_variable("Camera")
    }

    on Tick {
        match (frame) {
            case 4 {
                Check(VisibleLabel("content/meshes/text/ui_audio.mesh") && VisibleLabel("content/meshes/text/ui_play.mesh"), "opening actions have compact labelled panels")
                Check(!VisibleLabel("content/meshes/text/ui_effects.mesh") && VisiblePlates() == 5, "game options start collapsed")
                opacity := LabelOpacity("content/meshes/text/ui_play.mesh")
                Check(opacity > 0 && opacity < 1, "opening controls fade into view")
                Check(TextAbovePanels(), "opening headings sort in front of their translucent panels")
            }
            case 9 {
                Check(world.Session.audio_source == 1 && world.Session.audio_status == 1, "Connect button requests the host source")
                Check(world.Session.run == 0 && world.Session.screen == 0, "Connect does not start the player run")
            }
            case 13 {
                Check(world.Session.mode == 0, "old mode button positions leave Journey selected")
            }
            case 17 {
                Check(VisibleLabel("content/meshes/text/ui_effects.mesh") && VisibleLabel("content/meshes/text/ui_volume.mesh"), "options disclosure reveals grouped settings")
                Check(VisiblePlates() == 10, "expanded controls have their own visible button geometry")
                opacity := LabelOpacity("content/meshes/text/ui_effects.mesh")
                Check(opacity > 0 && opacity < 1, "settings fade in while their pointer controls are already active")
                Check(OptionsHeight() > 40 && OptionsHeight() < 200, "options layout unfolds between its closed and expanded bounds")
                Check(!VisibleLabel("content/meshes/text/ui_v.mesh") && !VisibleLabel("content/meshes/text/ui_f.mesh") && !VisibleLabel("content/meshes/text/ui_g.mesh"), "expanded settings have no keyboard legends")
            }
            case 21 {
                Check(world.Session.effects == 0, "pointer effects action shares the keyboard setting path")
            }
            case 25 {
                Check(world.Session.reduced_motion, "pointer motion action enables reduced motion")
                Check(OptionsHeight() == 200, "reduced motion finishes layout travel immediately")
            }
            case 29 {
                Check(!world.Session.ghost, "pointer ghost action toggles the ghost")
            }
            case 33 {
                Check(abs(world.Session.master - 0.7) < 0.001, "minus button lowers volume once")
            }
            case 37 {
                Check(abs(world.Session.master - 0.8) < 0.001, "plus button raises volume once")
                Check(world.Session.setting_request == 0, "pointer setting request is consumed")
                Check(TextAbovePanels(), "settled option names and values sort in front of every containing panel")
            }
            case 41 {
                Check(!VisibleLabel("content/meshes/text/ui_effects.mesh") && VisiblePlates() == 5, "collapse removes the settings geometry and text")
            }
            case 45 {
                Check(world.Session.reduced_motion && world.Session.effects == 0 && !world.Session.ghost, "collapsed setting hitboxes are inactive")
            }
            case 49 {
                Check(world.Session.entering && world.Session.audio_source == 0, "Play explicitly falls back while capture is pending")
                opacity := LabelOpacity("content/meshes/text/ui_play.mesh")
                Check(VisiblePlates() > 0 && opacity > 0 && opacity < 1, "opening controls fade out after Play accepts the pointer immediately")
            }
            case 79 {
                Check(world.Session.run == 1 && world.Session.mode == 0 && !world.Session.entering, "Journey starts after the reduced-motion handoff")
                Check(VisiblePlates() == 0 && VisibleLabel("content/meshes/text/score.mesh"), "play HUD replaces the compact opening controls")
                self.TestReport.done = true
            }
        }
        frame += 1
    }
}
