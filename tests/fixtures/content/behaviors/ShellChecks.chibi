// Milestones are test inputs. Session transitions and commits run the real Shell.
behavior ShellChecks {
    world: entity
    board: entity
    frame: int = 0

    function Check(condition: bool, message: string) {
        self.TestReport.checks += 1
        if condition {
            return
        }
        self.TestReport.failures += 1
        if self.TestReport.first_failure == "" {
            self.TestReport.first_failure = message
        }
    }
    on Begin {
        world = get_global_variable("World")
        board = get_global_variable("Board1")
    }
    on Tick {
        match (frame) {
            case 1 {
                Check(world.Session.screen == 1 && world.Session.stage == 0, "new profile immediately plays first chapter")
            }
            case 3 {
                Check(world.Session.screen == 1 && world.Session.mode == 0 && world.Session.run == 1, "Journey starts")
            }
            case 15 {
                board.BoardState.lines = 12
                board.BoardState.score = 1200
            }
            case 18 {
                Check(world.Session.stage == 1, "twelve lines advance Journey")
                Check(read_saved_number("chapter", -1).Number == 1, "chapter unlock commits")
            }
            case 19 {
                board.BoardState.lines = 0
                send_event<"Restart">(world)
            }
            case 22 {
                Check(world.Session.stage == 0 && world.Session.run == 2, "restart returns to starting chapter")
            }
            case 28 {
                Check(world.Session.stage == 1 && world.Session.screen == 2 && world.Session.run == 3, "chapter key selects an unlocked chapter and stays paused")
            }
            case 31 {
                Check(world.Session.stage == 1 && world.Session.run == 3, "chapter key cannot select a locked chapter")
            }
            case 36 {
                Check(world.Session.stage == 1 && world.Session.screen == 1 && world.Session.run == 3, "Enter resumes selected chapter and chapter keys do not interrupt play")
            }
            case 44 {
                board.BoardState.lines = 12
            }
            case 47 {
                Check(world.Session.stage == 2, "selected chapter progresses")
            }
            case 48 {
                board.BoardState.lines = 0
                send_event<"Restart">(world)
            }
            case 51 {
                Check(world.Session.stage == 1, "restart remembers selected starting chapter")
            }
            case 54 {
                Check(world.Session.screen == 2, "P pauses without opening a menu")
            }
            case 66 {
                Check(world.Session.screen == 1, "Enter resumes the in-world pause")
            }
            case 72 {
                Check(world.Session.screen == 1, "preferences leave the run active")
                Check(abs(world.Session.master - 0.9) < 0.00001 && abs(world.Session.das - 0.15) < 0.00001, "volume key preserves movement delay")
                Check(abs(world.Session.arr - 0.035) < 0.00001 && world.Session.effects == 0, "effects key preserves repeat timing")
                Check(world.Session.reduced_motion && !world.Session.ghost, "settings toggle motion and ghost")
                Check(read_saved_number("chapter", -1).Number == 2, "second chapter unlock survives restart")
            }
            case 76 {
                Check(world.Session.stage == 0 && world.Session.screen == 2 && world.Session.run == 5, "previous chapter key selects an earlier unlocked chapter")
            }
            case 78 {
                Check(world.Session.stage == 0 && world.Session.run == 5, "previous chapter key stops at first chapter")
            }
            case 84 {
                Check(world.Session.stage == 2 && world.Session.screen == 2 && world.Session.run == 7, "chapter keys browse through all unlocked chapters without resuming")
            }
            case 98 {
                board.BoardState.topout = true
            }
            case 101 {
                Check(world.Session.screen == 3 && !world.Session.won, "topout produces result before chapter selection")
            }
            case 105 {
                Check(world.Session.stage == 1 && world.Session.screen == 2 && world.Session.run == 8, "chapter selection also works from results")
                self.TestReport.done = true
            }
        }
        frame += 1
    }
}
