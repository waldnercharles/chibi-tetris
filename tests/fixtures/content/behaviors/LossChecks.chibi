// Real board top-out releases occupied cells before returning to the menu.
behavior LossChecks {
    world: entity
    board: entity
    partner: entity
    vortex: entity
    tiles: entity[]
    positions: CF_V3[]
    colors: uint[]
    previews: entity[]
    preview_positions: CF_V3[]
    started: int = -1
    frame: int = 0
    score: int = 0
    pieces: int = 0
    run: int = 0
    elapsed := 0
    field_time := 0
    quiet := false
    duet := false
    seen: int[] = [0, 0]
    released: int = 0

    function Check(condition: bool, message: string) {
        self.TestReport.checks += 1
        if condition {
            return
        }
        self.TestReport.failures += 1
        if self.TestReport.first_failure == "" {
            self.TestReport.first_failure = message
        }
    }

    on Begin {
        world = get_global_variable("World")
        board = get_global_variable("Board1")
        partner = get_global_variable("Board2")
        vortex = get_global_variable("Vortex")
        quiet = read_saved_number("test_quiet", 0).Number != 0
        duet = read_saved_number("test_duet", 0).Number != 0
    }

    function VisibleTiles() -> (count: int) {
        count = 0
        for tile in tiles {
            if !tile.RenderState.hidden {
                count += 1
            }
        }
        return count
    }

    function VisibleLabel(name: string) -> (visible: bool) {
        source := format_text("content/meshes/text/{}.mesh", name)
        for label in find_entities_with_component("MeshAsset") {
            if label.MeshAsset.source == source && !label.RenderState.hidden {
                return true
            }
        }
        return false
    }

    function VisiblePreviews() -> (count: int) {
        count = 0
        for tile in previews {
            if !tile.RenderState.hidden {
                count += 1
            }
        }
        return count
    }

    function WellOffset(x: number) -> (offset: number) {
        if duet && x > 0 {
            return partner.Transform3D.position.y
        }
        return board.Transform3D.position.y
    }

    function CheckPreviews() {
        expected: int = 24
        if duet {
            expected = 48
        }
        Check(length(previews) == expected && VisiblePreviews() == expected, "Hold and Next remain visible while the original blocks depart")
        for i in 0..length(previews) - 1 {
            tile := get(previews, i)
            before := get(preview_positions, i)
            p := tile.Transform3D.position
            p.y -= WellOffset(p.x)
            Check(abs(p.x - before.x) + abs(p.y - before.y) + abs(p.z - before.z) < 0.01, "loss keeps every Hold and Next preview fixed")
        }
    }

    function ReleaseFields() -> (count: int) {
        count = 0
        for field in find_entities_with_component("ParticleField3D") {
            if field.Shader.material == "ReactionParticles.Release" && field.ParticleField3D.count > 0 {
                count += 1
            }
        }
        return count
    }

    function RowRecords(source: entity, index: int) {
        serial := get(seen, index) + 1
        while serial <= source.ReactionQueue.serial {
            record := ReactionRules.Read(source, serial)
            if record.ReactionEvent.kind == 22 {
                expected: int = 0
                for p in positions {
                    if abs(p.y - record.ReactionEvent.y) < 0.01 && abs(p.x - record.ReactionEvent.x) < 120 {
                        column := cast<int>(round((p.x - record.ReactionEvent.x + 108) / 24))
                        expected = expected | 1 << column
                    }
                }
                Check(expected != 0 && record.ReactionEvent.detail == expected, "loss fragments capture only the original occupied cells")
                Check(record.ReactionEvent.point0.z > 0, "loss captures the actual settled block front")
                released += 1
            }
            serial += 1
        }
        seen[index] = source.ReactionQueue.serial
    }

    on Tick {
        if frame == 1 && duet {
            send_event<"Duet">(world)
        }
        if started < 0 && board.BoardState.topout {
            started = frame
            score = board.BoardState.score
            pieces = board.BoardState.pieces
            run = world.Session.run
            for tile in find_entities_with_component("MeshAsset") {
                p := tile.Transform3D.position
                p.y -= WellOffset(p.x)
                if tile.MeshAsset.source == "content/meshes/Block.mesh" && !tile.RenderState.hidden && tile.Geometry3D.width == 16 {
                    previews = array_add(previews, tile)
                    preview_positions = array_add(preview_positions, p)
                }
                if tile.MeshAsset.source == "content/meshes/Block.mesh" && !tile.RenderState.hidden && tile.Geometry3D.width == 22 {
                    tiles = array_add(tiles, tile)
                    positions = array_add(positions, p)
                    colors = array_add(colors, tile.Material.scene)
                }
            }
            Check(length(tiles) > 20, "real legal drops leave an occupied stack at top-out")
        }
        if started >= 0 {
            if world.Session.screen == 4 {
                RowRecords(board, 0)
                if duet {
                    RowRecords(partner, 1)
                }
            }
            age := frame - started
            if age == 2 {
                elapsed = world.Session.elapsed
                field_time = vortex.ParticleField3D.time
                Check(world.Session.screen == 4, "loss waits for the stack departure before returning to the menu")
                Check(VisibleTiles() == length(tiles), "loss preserves the occupied board before the fracture wave")
                CheckPreviews()
            }
            if age == 20 {
                Check(board.BoardState.score == score && board.BoardState.pieces == pieces, "departure preserves score and ignores gameplay input")
                Check(world.Session.elapsed == elapsed, "departure keeps the player clock frozen")
            }
            if age == 20 && quiet {
                Check(VisibleTiles() == 0, "quiet loss retires the board without outward travel")
                Check(ReleaseFields() == 0, "quiet loss emits no drifting release fields")
                Check(world.Session.screen == 4, "quiet board settles before returning to the menu")
                CheckPreviews()
            }
            if age == 55 && !quiet {
                Check(VisibleTiles() == length(tiles), "loss detaches the original blocks without replacing their bodies")
                Check(ReleaseFields() > 0, "actual occupied rows release particle geometry")
                Check(vortex.ParticleField3D.time > field_time, "loss keeps scenery moving while gameplay is frozen")
            }
            if (age == 88 || age == 130) && !quiet {
                Check(VisibleTiles() == length(tiles), "original colored blocks remain whole through the outward departure")
                upward: int = 0
                downward: int = 0
                nearest_depth := 0
                farthest_depth := 0
                for i in 0..length(tiles) - 1 {
                    tile := get(tiles, i)
                    before := get(positions, i)
                    p := tile.Transform3D.position
                    q := tile.Transform3D.rotation
                    center := 0
                    if duet {
                        center = -254
                        if before.x > 0 {
                            center = 254
                        }
                    }
                    x := p.x - before.x
                    y := p.y - before.y
                    Check(x * x + y * y > 6400, "loss sends actual blocks well beyond their grid cells")
                    Check(x * (before.x - center) + y * before.y > 0, "each block departs radially away from its own well center")
                    Check(abs(p.z - before.z) > 0.001 && abs(q.x) + abs(q.y) + abs(q.z) > 0.01, "original block meshes tumble through depth")
                    if before.y > 48 && y > 40 {
                        upward += 1
                    }
                    if before.y < -48 && y < -40 {
                        downward += 1
                    }
                    nearest_depth = min(nearest_depth, p.z - before.z)
                    farthest_depth = max(farthest_depth, p.z - before.z)
                    Check(tile.Transform3D.scale.x == 1 && tile.Transform3D.scale.y == 1 && tile.Transform3D.scale.z == 1 && tile.Geometry3D.width == 22, "block bodies keep their full dimensions throughout flight")
                    Check(tile.Material.scene == get(colors, i), "each released block retains its original piece color")
                }
                Check(upward > 0 && downward > 0, "upper and lower cells leave in opposite vertical directions")
                Check(nearest_depth < -25 && farthest_depth > 25, "the release expands both behind and in front of the board")
                Check(ReleaseFields() > 0, "quiet ember trails accompany the colored block bodies")
                Check(world.Session.screen == 4, "the menu waits for the loss choreography")
                CheckPreviews()
            }
            if age == 148 && !quiet {
                Check(VisibleTiles() > 0, "full-size bodies still depart before leaving view")
                for tile in tiles {
                    Check(tile.Transform3D.scale.x == 1 && tile.Transform3D.scale.y == 1 && tile.Transform3D.scale.z == 1, "loss never scales a departing or retired body toward zero")
                }
            }
            if age == 230 && !quiet {
                Check(world.Session.screen == 0 && world.Session.attract && !world.Session.entering, "the returned menu waits for explicit pointer Play")
                Check(world.Session.elapsed == elapsed && world.Session.run == run, "menu demo never advances the completed run")
                Check(!board.BoardState.topout, "the menu demo recovers from the lost board")
            }
            if age == 182 || quiet && age == 28 {
                Check(world.Session.screen == 0 && world.Session.attract && !world.Session.won, "loss returns directly to the Journey menu")
                Check(VisibleLabel("ui_journey"), "the returned menu shows Journey in the complete scene")
                Check(VisibleLabel("ui_play"), "the returned menu shows the explicit Play action")
                Check(!VisibleLabel("game_over"), "loss returns without a Game Over label")
                Check(VisiblePreviews() == 0, "Hold and Next hide in the menu")
                Check(world.Session.elapsed == elapsed, "loss animation never advances the game clock")
                best := "journey"
                if duet {
                    best = "duet"
                }
                Check(read_saved_number(best, 0).Number >= score && world.Session.run == run, "loss records the score without starting another player run")
                Check(board.ReactionQueue.dropped == 0, "row release fits the immutable event queue")
                if !quiet {
                    Check(released > 0 && ReleaseFields() == released, "each occupied row owns one quiet continuing ember field")
                    Check(world.VisualState.cue_dropped == 0, "both occupied boards fit the fixed field pool without losing cells")
                    Check(ReleaseFields() > 0, "dim fragment tails continue after returning to the menu")
                }
                self.TestReport.done = true
            }
        }
        frame += 1
    }
}
