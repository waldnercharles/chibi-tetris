// Production board, camera and HUD. Host readiness is supplied explicitly so
// the no-device controller can verify the distinction between Connect and Play.
behavior AttractChecks {
    world: entity
    board: entity
    camera: entity
    frame: int = 0
    demo_lines: int = 0
    demo_clears: int = 0
    demo_events: int = 0
    recovery_serial: int = 0
    tiles: entity[]
    positions: CF_V3[]

    function Check(condition: bool, message: string) {
        self.TestReport.checks += 1
        if condition {
            return
        }
        self.TestReport.failures += 1
        if self.TestReport.first_failure == "" {
            self.TestReport.first_failure = message
        }
    }

    on Begin {
        world = get_global_variable("World")
        board = get_global_variable("Board1")
        camera = get_global_variable("Camera")
    }

    function LabelOpacity(source: string) -> (opacity: number) {
        meshes := find_entities_with_component("MeshAsset")
        for mesh in meshes {
            if mesh.MeshAsset.source == source && !mesh.RenderState.hidden {
                return cast<number>(mesh.Material.scene & 255) / 255
            }
        }
        return -1
    }

    on Tick {
        match (frame) {
            case 10 {
                Check(world.Session.attract && world.Session.screen == 0, "opening retains explicit play actions")
                Check(camera.Transform3D.position.x < -100, "opening camera gives the real board its side composition")
                Check(camera.Camera.width > 1200 && abs(camera.Camera.fov - 0.61086524) < 0.001, "opening framing contains the chooser and demonstration board")
                Check(world.Session.run == 0 && world.Session.elapsed == 0, "demo has no player run or timer")
            }
            case 120 {
                Check(board.BoardState.pieces > 0 && board.BoardState.drop_serial > 0, "attract play genuinely drops and locks pieces")
                Check(board.BoardState.score > 0, "attract play uses ordinary board scoring")
                Check(world.Session.run == 0 && world.Session.elapsed == 0, "real demo play never advances player progress")
                Check(world.Session.mode == 0, "mode key leaves Journey selected")
                world.Session.audio_source = 1
                world.Session.audio_ready = true
                recovery_serial = board.ReactionQueue.serial
                board.BoardState.topout = true
            }
            case 130 {
                Check(world.Session.screen == 0 && !world.Session.entering && world.Session.run == 0, "connected audio still waits for explicit Play")
                Check(board.ReactionQueue.serial >= recovery_serial && !board.BoardState.topout, "demo recovery retains event continuity for visual consumers")
                demo_lines = board.BoardState.lines
                demo_clears = board.BoardState.clear_serial
                demo_events = board.ReactionQueue.serial
            }
            case 144 {
                Check(world.Session.entering && world.Session.departing && world.Session.attract && world.Session.run == 0, "Play begins the shared body release before resetting the demo")
                Check(world.Session.audio_ready && world.Session.audio_source == 1, "Play preserves the selected connected source")
                Check(board.BoardState.topout && board.BoardState.clear_serial == demo_clears, "handoff freezes the demo without inventing a line clear")
                Check(board.BoardState.lines == demo_lines, "handoff release never awards line-clear progress")
                for tile in find_entities_with_component("MeshAsset") {
                    if tile.MeshAsset.source == "content/meshes/Block.mesh" && !tile.RenderState.hidden && tile.Geometry3D.width == 22 {
                        tiles = array_add(tiles, tile)
                        position := tile.Transform3D.position
                        position.y -= board.Transform3D.position.y
                        positions = array_add(positions, position)
                    }
                }
                Check(length(tiles) > 0, "handoff preserves the actual occupied block meshes")
                Check(world.Session.hud_alpha == 0, "gameplay HUD waits for the clear")
            }
            case 210 {
                Check(world.Session.attract && world.Session.entering && world.Session.run == 0, "demo reset waits for clear effects to finish")
                Check(camera.Transform3D.position.x > -130 && camera.Transform3D.position.x < 90, "camera travels toward the play composition")
                Check(camera.Camera.fov > 0.61 && camera.Camera.fov < 0.88, "intro widens the perspective lens continuously with the camera move")
                Check(board.BoardState.clear_serial == demo_clears, "handoff emits no line clear")
                found := false
                for serial in demo_events + 1..board.ReactionQueue.serial {
                    cue := ReactionRules.Read(board, serial)
                    if cue.ReactionEvent.kind == 22 {
                        found = cue.ReactionEvent.result == 1 && cue.ReactionEvent.detail > 0
                    }
                }
                Check(found, "Play uses the same occupied-row release event as loss")
                for i in 0..length(tiles) - 1 {
                    tile := get(tiles, i)
                    before := get(positions, i)
                    delta := tile.Transform3D.position - before
                    delta.y -= board.Transform3D.position.y
                    Check(!tile.RenderState.hidden && delta.x * delta.x + delta.y * delta.y > 1600 && delta.x * before.x + delta.y * before.y > 0, "demo blocks travel outward intact before the new run")
                    Check(tile.Transform3D.scale.x == 1 && tile.Transform3D.scale.y == 1 && tile.Transform3D.scale.z == 1, "intro release preserves full block size")
                }
            }
            case 332 {
                Check(!world.Session.attract && world.Session.entering && world.Session.run == 1, "fresh run starts during the final reveal")
                Check(world.Session.mode == 0 && world.Session.goal == 12, "Play enters Journey")
                Check(world.Session.hud_alpha > 0 && world.Session.hud_alpha < 1, "HUD materializes gradually")
                opacity := LabelOpacity("content/meshes/text/score.mesh")
                Check(opacity > 0 && opacity < 1, "visible score text has partial material opacity during the reveal")
                Check(world.Session.elapsed == 0 && board.BoardState.pieces == 0 && board.BoardState.score == 0, "reveal keeps the new board and timer still")
            }
            case 347 {
                Check(board.BoardState.pieces == 0, "player hard drop is suppressed during the reveal")
            }
            case 382 {
                Check(!world.Session.attract && !world.Session.entering && world.Session.hud_alpha == 1, "handoff completes with fully visible play HUD")
                Check(world.Session.screen == 1 && world.Session.run == 1 && world.Session.elapsed > 0, "fresh player run begins after the handoff")
                Check(camera.Transform3D.position.x > 80, "camera reaches the normal play composition")
                Check(camera.Camera.width == 1000 && abs(camera.Camera.fov - 0.88) < 0.001, "completed single-board intro uses the wider gameplay composition")
                Check(board.BoardState.pieces == 0 && board.BoardState.lines == 0, "demo stack and score do not leak into the player run")
                Check(world.Session.audio_source == 1, "external source survives the entire handoff")
                Check(LabelOpacity("content/meshes/text/score.mesh") == 1, "finished handoff shows the actual score mesh")
                Check(LabelOpacity("content/meshes/text/ui_play.mesh") < 0 && LabelOpacity("content/meshes/text/ui_sprint.mesh") < 0, "opening action meshes disappear after Play")
                self.TestReport.done = true
            }
        }
        frame += 1
    }
}
