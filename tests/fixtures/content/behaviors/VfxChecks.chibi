// Production consumer regression. The fixture has no stage lights or audio,
// so local reaction lights and field lifetimes can be observed directly.
behavior VfxChecks {
    world: entity
    first: entity
    second: entity
    vortex: entity
    stars: entity
    packet: entity
    drop_tail: entity
    duet_tail: entity
    drop_age := 0
    duet_age := 0
    landing: entity
    settling: entity
    turning: entity
    shifting: entity
    holding: entity
    falling: entity
    light: entity
    oldest: entity
    fast_tail: entity
    slow_tail: entity
    slow_energy: entity
    charged_tail: entity
    sparse_tail: entity
    old_age := 0
    light_release := 0
    frame: int = 0

    function Check(condition: bool, message: string) {
        self.TestReport.checks += 1
        if condition {
            return
        }
        self.TestReport.failures += 1
        if self.TestReport.first_failure == "" {
            self.TestReport.first_failure = message
        }
    }

    on Begin {
        world = get_global_variable("World")
        first = get_global_variable("Board1")
        second = get_global_variable("Board2")
        vortex = get_global_variable("Vortex")
        stars = get_global_variable("Stars")
        ReactionRules.Initialize(world, 1)
        ReactionRules.Initialize(first, 1)
        ReactionRules.Initialize(second, 1)
        packet = world
        landing = world
        settling = world
        light = world
        oldest = world
    }

    function Record(source: entity, kind: int, result: int, x: number, y: number, amount: int) {
        record := source.ReactionQueue.write
        ReactionRules.Emit(source, kind, result, x, y, 1, amount, 3)
        record.ReactionEvent.width = 48
        record.ReactionEvent.center_offset = 12
        record.ReactionEvent.point0 = vec3(x, y, 9)
        record.ReactionEvent.point1 = vec3(x + 24, y, 10)
        record.ReactionEvent.point2 = vec3(x, y - 24, 11)
        record.ReactionEvent.point3 = vec3(x + 24, y - 24, 12)
    }

    function ActiveCues() -> (count: int) {
        count = 0
        fields := find_entities_with_component("ParticleField3D")
        for field in fields {
            if field != vortex && field != stars && field.ParticleField3D.count > 0 {
                count += 1
            }
        }
        return count
    }

    function CueAt(x: number, y: number) -> (found: entity) {
        found = world
        fields := find_entities_with_component("ParticleField3D")
        for field in fields {
            if field != vortex && field != stars && field.ParticleField3D.count > 0 {
                p := field.Transform3D.position
                if abs(p.x - x) < 0.01 && abs(p.y - y) < 0.01 {
                    found = field
                    break
                }
            }
        }
        return found
    }

    function RowInstances(x: number, y: number) -> (count: int) {
        count = 0
        fields := find_entities_with_component("ParticleField3D")
        for field in fields {
            if field != vortex && field != stars && field.ParticleField3D.count > 0 {
                p := field.Transform3D.position
                if abs(p.x - x) < 0.01 && abs(p.y - y) < 0.01 {
                    count += field.ParticleField3D.count
                    Check(abs(p.z - 10.5) < 0.01, "every clear layer preserves the captured mean block front")
                    Check(field.Shader.material == "ReactionParticles.Release", "clear fields bind the dedicated release shader before its parameters")
                    debris_count: int = 96
                    if world.Session.effects == 1 {
                        debris_count = 48
                    }
                    if field.ParticleField3D.count == debris_count {
                        Check(!field.ParticleField3D.additive, "heavy fragments use opaque physical geometry")
                    }
                }
            }
        }
        return count
    }

    function LayerAt(x: number, y: number, count: int) -> (found: entity) {
        fields := find_entities_with_component("ParticleField3D")
        for field in fields {
            if field != vortex && field != stars && field.ParticleField3D.count == count {
                position := field.Transform3D.position
                if abs(position.x - x) < 0.01 && abs(position.y - y) < 0.01 {
                    return field
                }
            }
        }
        return world
    }

    function Clear(mask: int, amount: int) {
        record := first.ReactionQueue.write
        // A deliberately unrelated piece origin catches reconstruction from
        // the current piece after compaction instead of the immutable mask.
        Record(first, 9, 1, 999, 777, amount)
        record.ReactionEvent.detail = mask
    }

    on Tick {
        match (frame) {
            case 8 {
                Check(ActiveCues() == 0, "fresh fields are dormant")
                Record(first, 2, 1, 80, 96, 0)
                Record(first, 1, 0, -60, 50, 0)
                Record(first, 6, 1, 20, 150, 6)
                Record(first, 8, 1, 20, 6, 0)
                Record(first, 1, 1, -110, 120, 1)
                Record(first, 7, 1, -160, 10, 0)
                Record(first, 4, 1, 130, 80, 1)
            }
            case 10 {
                Check(ActiveCues() == 9, "ordinary actions own their bounded layers and hard-drop lock does not replay its landing")
                turning = CueAt(80, 96)
                blocked := CueAt(-60, 50)
                packet = LayerAt(20, 150, 96)
                drop_tail = LayerAt(20, 150, 768)
                Check(drop_tail != world, "hard drop keeps a separate bounded cloud after the immediate wash")
                landing = LayerAt(20, 6, 96)
                settling = LayerAt(20, 6, 128)
                shifting = CueAt(-110, 120)
                holding = CueAt(-160, 10)
                falling = CueAt(130, 80)
                Check(turning != world && blocked != world, "local input fields retain their action origins")
                Check(packet != world && landing != world, "packet starts at the captured piece and landing shifts exactly six cells")
                Check(settling != world, "hard-drop landing has an independent restrained settling tail")
                Check(shifting != world && holding != world && falling != world, "move hold and soft fall preserve their own captured origins")
                if turning != world && blocked != world {
                    Check(turning.ParticleField3D.count == 96 && blocked.ParticleField3D.count == 20, "turn and rejection use restrained counts")
                    Check(turning.Shader.material == "ReactionParticles.Cue" && blocked.Shader.material == "ReactionParticles.Cue", "ordinary input keeps its compact contact shader")
                    Check(turning.Transform3D.position.z == 0, "field origin leaves captured front-face depth in the point payload")
                }
                if packet != world && landing != world {
                    Check(packet.Geometry3D.primitive == 5 && landing.Geometry3D.primitive == 5, "cue configuration retains the supported octahedron mesh primitive")
                    Check(packet.Geometry3D.height == 1 && landing.Geometry3D.height == 1, "the short wash and contact use grains rather than tall rail geometry")
                    Check(packet.ParticleField3D.count == 96 && landing.ParticleField3D.count == 96, "drop layers have bounded independent instance counts")
                }
                lights := find_entities_with_component("PointLight")
                for candidate in lights {
                    if abs(candidate.Transform.x - 32) < 0.01 && abs(candidate.PointLight.elevation + 28.7) < 0.01 {
                        light = candidate
                    }
                }
                Check(light != world, "grounded light sits below the lowest captured landing cell")
                if light != world {
                    Check(abs(light.Transform.y - 12.5) < 0.01, "light depth follows the captured front face")
                    Check(light.PointLight.intensity > 0.1, "hard-drop contact lights the landing on the placement frame")
                }
            }
            case 17 {
                if light != world {
                    Check(light.PointLight.intensity > 0.1, "contact illumination continues while the brief wash has already finished")
                    Check(packet.ParticleField3D.count == 0, "the traveled-space wash ends before the former delayed impact would begin")
                    if drop_tail != world {
                        Check(drop_tail.ParticleField3D.count == 768, "secondary drop grains outlive the immediate wash")
                    }
                    light_release = light.PointLight.intensity
                }
            }
            case 22 {
                if light != world {
                    Check(light.PointLight.intensity > 0 && light.PointLight.intensity < light_release, "immediate contact light decays without a second delayed attack")
                }
            }
            case 30 {
                if packet != world && landing != world {
                    Check(packet.ParticleField3D.count == 0, "the short drop wash never lingers over the next falling piece")
                    if drop_tail != world {
                        Check(drop_tail.ParticleField3D.count == 768 && drop_tail.ParticleField3D.time > 0.3, "drop wake retains its own clock after placement")
                    }
                    Check(landing.ParticleField3D.count == 96, "delayed landing keeps its full particle lifetime after arrival")
                }
                if settling != world {
                    Check(settling.ParticleField3D.count == 128 && settling.ParticleField3D.time > 0.3, "settling dust retains its independent longer release")
                }
                if turning != world && shifting != world && holding != world && falling != world {
                    Check(turning.ParticleField3D.count == 96 && shifting.ParticleField3D.count == 48, "rotation and movement trails outlive their former short flash")
                    Check(holding.ParticleField3D.count == 48 && falling.ParticleField3D.count == 32, "hold and soft fall also retain smooth local tails")
                }
            }
            case 32 {
                world.Session.reduced_motion = true
            }
            case 38 {
                Check(ActiveCues() == 0, "long action tails retire smoothly without replay when motion is disabled")
                if light != world {
                    Check(light.PointLight.intensity == 0, "impact light reaches zero at its release endpoint")
                }
                world.Session.reduced_motion = false
            }
            case 40 {
                for i in 0..31 {
                    Record(first, 11, 1, 1000 + i, 1000, 0)
                    Record(second, 11, 1, 2000 + i, 1000, 0)
                    ReactionRules.Emit(world, 20, 1, 0, 1, 1, 1, 0)
                }
            }
            case 42 {
                Check(ActiveCues() == 96, "all fixed pool slots can carry independent live cues")
                oldest = CueAt(1000, 1000)
                Check(oldest != world, "oldest saturated cue remains present")
                if oldest != world {
                    old_age = oldest.ParticleField3D.time
                }
                Record(first, 1, 0, -500, -500, 0)
            }
            case 44 {
                Check(world.VisualState.cue_dropped == 1, "full pool counts the skipped incoming cue")
                Check(world.VisualState.cue_overwrites == 0, "saturation never overwrites live geometry")
                Check(CueAt(-500, -500) == world, "a saturated pool does not replace a visible cue")
                if oldest != world {
                    Check(oldest.ParticleField3D.time > old_age && oldest.ParticleField3D.count == 80, "oldest cue keeps its clock and geometry under saturation")
                }
                Check(first.ReactionQueue.dropped == 0 && second.ReactionQueue.dropped == 0 && world.ReactionQueue.dropped == 0, "cosmetic saturation does not drop event queue records")
                world.Session.reduced_motion = true
            }
            case 46 {
                Check(ActiveCues() > 0, "reduced motion releases visible cues over several frames")
            }
            case 50 {
                Check(ActiveCues() == 0, "retirement completes before slots are reused")
                Record(first, 2, 1, 80, 96, 0)
                Record(first, 6, 1, 20, 150, 6)
                Record(first, 8, 1, 20, 6, 0)
            }
            case 52 {
                Check(ActiveCues() == 2, "quiet hard drop uses one stationary contact confirmation")
                turn := CueAt(80, 96)
                quiet_drop := CueAt(20, 6)
                Check(turn != world && quiet_drop != world, "quiet confirmations retain physical origins")
                if turn != world && quiet_drop != world {
                    Check(turn.ParticleField3D.count == 8 && quiet_drop.ParticleField3D.count == 8, "quiet confirmations keep the minimum count")
                }
                lights := find_entities_with_component("PointLight")
                for candidate in lights {
                    Check(candidate.PointLight.intensity == 0, "quiet input never creates a new reaction light")
                }
            }
            case 62 {
                Check(ActiveCues() == 0, "quiet confirmation fades finish without replay")
                Check(world.VisualState.cue_dropped == 1 && world.VisualState.cue_overwrites == 0, "pool diagnostics distinguish skips from destructive reuse")
                world.Session.reduced_motion = false
            }
            case 64 {
                Clear(1 << 18 | 1 << 19 | 1 << 20 | 1 << 21, 4)
            }
            case 66 {
                Check(ActiveCues() == 16, "four cleared rows own four independent layers each")
                total: int = 0
                for row in 18..21 {
                    count := RowInstances(-254, 276 - row * 24)
                    Check(count == 2656, "each full-effect row owns 320 fracture grains 96 chunks 2048 embers and 192 energy grains")
                    total += count
                }
                Check(total == 10624, "a four-line clear reserves its larger finite celebration budget")
                Check(CueAt(999, 777) == world, "clear layers never follow the newly spawned piece origin")
                lights := find_entities_with_component("PointLight")
                row_lights: int = 0
                for candidate in lights {
                    if abs(candidate.Transform.x + 254) < 0.01 {
                        row_lights += 1
                        Check(abs(candidate.Transform.y - 12.5) < 0.01, "clear illumination starts just in front of the captured block face")
                        Check(candidate.PointLight.elevation <= -156 && candidate.PointLight.elevation >= -228, "clear illumination belongs to the cleared rows")
                    }
                }
                Check(row_lights == 4, "every cleared row owns one bounded local light")
            }
            case 84 {
                Check(ActiveCues() == 16, "clear fronts sustain the visible row while longer layers start spreading")
                Check(RowInstances(-254, -228) == 2656, "the half-second clear front retains its original row budget")
            }
            case 104 {
                Check(ActiveCues() == 12, "chunks and dim energy continue after the brief fracture front")
                Check(RowInstances(-254, -228) == 2336, "long tails do not stretch the bright fracture lifetime")
            }
            case 128 {
                Check(ActiveCues() == 8, "microembers and energy keep flowing after the heavy fragments expire")
                Check(RowInstances(-254, -228) == 2240, "only dim additive layers retain the long release")
            }
            case 156 {
                Check(ActiveCues() == 8, "all four rows retain their dim tails after the former clear deadline")
                world.Session.effects = 0
                world.Session.mode = 1
            }
            case 158 {
                Check(ActiveCues() == 8, "full clear tails remain alive during the continuous retirement interval")
            }
            case 160 {
                Check(ActiveCues() == 0, "full clear tails reach zero before their slots are reused")
                world.Session.effects = 1
                Clear(1 << 2 | 1 << 20, 2)
            }
            case 162 {
                Check(ActiveCues() == 8, "nonadjacent clear rows receive independent layers in Solo")
                Check(RowInstances(0, 228) == 1328 && RowInstances(0, -204) == 1328, "reduced effects halves every clear layer without moving its row")
                Check(CueAt(0, -228) == world, "the row mask never fills an uncleared neighboring row")
                world.Session.effects = 0
            }
            case 164 {
                Check(ActiveCues() == 8, "effects-off releases existing sparse tails continuously")
            }
            case 168 {
                Check(ActiveCues() == 0, "effects-off finishes retirement before field reuse")
                Clear(1 << 21, 1)
            }
            case 170 {
                Check(ActiveCues() == 1 && RowInstances(0, -228) == 8, "effects-off uses one small stationary clear confirmation")
            }
            case 180 {
                Check(ActiveCues() == 0, "quiet row confirmation reaches its normal release endpoint")
                Check(world.VisualState.cue_dropped == 1 && world.VisualState.cue_overwrites == 0, "the multirow celebration and mode changes never overwrite a live field")
                world.Session.effects = 2
                Record(first, 8, 1, 80, 30, 0)
            }
            case 182 {
                landing = LayerAt(80, 30, 96)
                settling = LayerAt(80, 30, 128)
                Check(ActiveCues() == 2 && landing != world && settling != world, "natural gravity lock creates one contact and one settling layer")
                lights := find_entities_with_component("PointLight")
                found := false
                for candidate in lights {
                    if abs(candidate.Transform.x - 92) < 0.01 && abs(candidate.PointLight.elevation + 4.7) < 0.01 {
                        found = true
                        Check(abs(candidate.Transform.y - 12.5) < 0.01, "natural lock light uses the captured block front")
                        Check(candidate.PointLight.intensity > 0.1 && candidate.PointLight.intensity <= 0.324, "natural lock has a smaller immediate light than hard drop")
                    }
                }
                Check(found, "natural lock illumination belongs to its lowest occupied cells")
            }
            case 214 {
                if landing != world && settling != world {
                    Check(landing.ParticleField3D.count == 96 && settling.ParticleField3D.count == 128, "contact and settling remain alive through a restrained half-second release")
                }
            }
            case 224 {
                if landing != world && settling != world {
                    Check(landing.ParticleField3D.count == 0 && settling.ParticleField3D.count == 128, "settling outlives the contact without restarting its clock")
                }
            }
            case 248 {
                Check(ActiveCues() == 0, "both natural landing layers finish before their fields are reused")
                Check(world.VisualState.cue_dropped == 1 && world.VisualState.cue_overwrites == 0, "long ordinary tails stay within the fixed pool")
            }
            case 250 {
                world.Session.mode = 1
                world.VisualState.beat_confidence = 1
                world.VisualState.beat_period = 0.3
                world.VisualState.energy = 0
                world.VisualState.bass = 0
                Clear(1 << 21, 1)
            }
            case 252 {
                fast_tail = LayerAt(0, -228, 2048)
                Check(fast_tail != world && RowInstances(0, -228) == 2656, "fast quiet music starts a full bounded clear")
            }
            case 280 {
                world.VisualState.beat_period = 0.9
                world.VisualState.energy = 1
                world.VisualState.bass = 1
                Clear(1 << 18, 1)
            }
            case 282 {
                slow_tail = LayerAt(0, -156, 2048)
                slow_energy = LayerAt(0, -156, 192)
                Check(slow_tail != world && slow_energy != world, "slow measured music starts both long additive layers")
                Check(fast_tail.ParticleField3D.time > 0.45 && fast_tail.ParticleField3D.count == 2048, "new tempo leaves the previous clear clock and budget untouched")
            }
            case 286 {
                world.VisualState.beat_confidence = 0
                Clear(1 << 19, 1)
            }
            case 288 {
                charged_tail = LayerAt(0, -180, 2048)
                Check(charged_tail != world, "energetic audio can shape a tail before tempo confidence is available")
            }
            case 340 {
                Check(fast_tail.ParticleField3D.count == 2048 && slow_tail.ParticleField3D.count == 2048, "both song-shaped tails outlive the old 1.4 second effect")
                Check(abs(fast_tail.Transform3D.position.x) < 0.01 && abs(fast_tail.Transform3D.position.y + 228) < 0.01 && abs(fast_tail.Transform3D.position.z - 10.5) < 0.01 && abs(slow_tail.Transform3D.position.x) < 0.01 && abs(slow_tail.Transform3D.position.y + 156) < 0.01 && abs(slow_tail.Transform3D.position.z - 10.5) < 0.01, "long motion keeps the original row and front-depth anchors")
            }
            case 440 {
                Check(fast_tail.ParticleField3D.count == 2048 && fast_tail.ParticleField3D.time > 3.1, "fast-song embers remain allocated through their final smooth fade")
                Check(slow_tail.ParticleField3D.count == 2048 && slow_energy.ParticleField3D.count == 192, "slow-song energy and embers still coexist after two seconds")
            }
            case 452 {
                Check(fast_tail.ParticleField3D.count == 0 && slow_tail.ParticleField3D.count == 2048, "fast clear finishes independently while the slower song tail continues")
                world.Session.effects = 1
                world.VisualState.beat_confidence = 0
                world.VisualState.beat_period = 0.9
                world.VisualState.energy = 0
                world.VisualState.bass = 0
                Clear(1 << 20, 1)
            }
            case 454 {
                sparse_tail = LayerAt(0, -204, 1024)
                Check(sparse_tail != world && RowInstances(0, -204) == 1328, "sparse mode preserves all four release layers at half density")
                Check(slow_tail.ParticleField3D.count == 2048 && slow_tail.ParticleField3D.time > 2.8, "density and confidence changes never mutate an existing tail")
            }
            case 564 {
                Check(charged_tail.ParticleField3D.count == 2048 && charged_tail.ParticleField3D.time > 4.5, "measured energy extends the fallback-period tail beyond its quiet duration")
            }
            case 590 {
                Check(slow_tail.ParticleField3D.count == 2048 && slow_energy.ParticleField3D.count == 192, "slow music sustains dim energy and ember motion beyond five seconds")
                Check(sparse_tail.ParticleField3D.count == 1024, "sparse tails keep the full song-derived duration")
            }
            case 594 {
                Check(charged_tail.ParticleField3D.count == 0, "energy-shaped tails finish independently of the slower measured tempo")
            }
            case 624 {
                Check(slow_energy.ParticleField3D.count == 0 && slow_tail.ParticleField3D.count == 2048, "energy thins before the final six-second ember tail")
            }
            case 648 {
                Check(slow_tail.ParticleField3D.count == 0, "even the slowest full-density tail respects the six-second bound")
                Check(sparse_tail.ParticleField3D.count == 1024, "uncertain tempo uses a stable middle-length fallback")
            }
            case 708 {
                Check(sparse_tail.ParticleField3D.count == 1024 && sparse_tail.ParticleField3D.time > 4.2, "fallback tempo retains the last smooth ember fade")
            }
            case 720 {
                Check(ActiveCues() == 0, "all song-shaped fields finish before their slots are reused")
                world.Session.effects = 2
                world.VisualState.beat_confidence = 1
                world.VisualState.beat_period = 0.9
                world.VisualState.energy = 1
                world.VisualState.bass = 1
                Clear((1 << 22) - 4, 20)
            }
            case 722 {
                Check(ActiveCues() == 80, "a tall demonstration clear stays inside the same fixed pool")
                oldest = LayerAt(0, 228, 2048)
                old_age = oldest.ParticleField3D.time
                Clear(1 << 18 | 1 << 19 | 1 << 20 | 1 << 21, 4)
            }
            case 724 {
                Check(ActiveCues() == 96, "overlapping long clear bursts fill but never enlarge the pool")
                Clear(1 << 2, 1)
            }
            case 726 {
                Check(ActiveCues() == 96 && world.VisualState.cue_dropped == 5, "a saturated release skips four incoming layers without overwriting visible tails")
                Check(oldest.ParticleField3D.count == 2048 && oldest.ParticleField3D.time > old_age, "saturation preserves the oldest captured tail and its clock")
                Check(world.VisualState.cue_overwrites == 0, "long lifetimes never introduce destructive field reuse")
            }
            case 748 {
                Check(ActiveCues() == 96, "overlapped clear fronts retain the same bounded half-second timing")
                world.Session.reduced_motion = true
            }
            case 750 {
                Check(ActiveCues() == 96, "reduced-motion changes release long fields through a continuous fade")
            }
            case 754 {
                Check(ActiveCues() == 0, "reduced-motion retirement reaches zero before reuse")
                Clear(1 << 21, 1)
            }
            case 756 {
                Check(ActiveCues() == 1 && RowInstances(0, -228) == 8, "reduced motion ignores song length and keeps a short stationary confirmation")
            }
            case 768 {
                Check(ActiveCues() == 0 && world.VisualState.cue_dropped == 5 && world.VisualState.cue_overwrites == 0, "quiet release expires and preserves saturation diagnostics")
                world.Session.reduced_motion = false
                world.Session.mode = 3
                world.VisualState.energy = 1
                world.VisualState.bass = 1
                Record(first, 6, 1, -254, 180, 14)
                Record(second, 6, 1, 254, 100, 8)
            }
            case 770 {
                drop_tail = LayerAt(-254, 180, 768)
                duet_tail = LayerAt(254, 100, 768)
                Check(drop_tail != world && duet_tail != world, "both Duet boards keep separate persistent drop wakes")
            }
            case 790 {
                if drop_tail != world && duet_tail != world {
                    drop_age = drop_tail.ParticleField3D.time
                    duet_age = duet_tail.ParticleField3D.time
                }
                world.Session.screen = 2
            }
            case 800 {
                if drop_tail != world && duet_tail != world {
                    Check(drop_tail.ParticleField3D.time == drop_age && duet_tail.ParticleField3D.time == duet_age, "pause retains both drop clocks and their particle shapes")
                }
                world.Session.screen = 1
                Record(first, 6, 0, 10, 10, 8)
            }
            case 802 {
                Check(LayerAt(10, 10, 768) == world, "a rejected hard drop cannot emit a persistent wake")
                if drop_tail != world {
                    Check(drop_tail.ParticleField3D.time > drop_age && drop_tail.ParticleField3D.time - drop_age < 0.05, "resume advances the drop wake without replaying paused time")
                }
                Record(first, 6, 1, 50, 50, 0)
            }
            case 804 {
                Check(LayerAt(50, 50, 768) == world, "a zero-distance hard drop has no traveled-space wake")
            }
            case 1040 {
                if drop_tail != world && duet_tail != world {
                    Check(drop_tail.ParticleField3D.count == 768 && duet_tail.ParticleField3D.count == 768, "both long drop wakes survive four active seconds")
                    Check(drop_tail.ParticleField3D.time > 4.2, "a drop wake retains continuous time while its grains join the background")
                    Check(drop_tail.Transform3D.position.x == -254 && duet_tail.Transform3D.position.x == 254, "later input never moves a captured Duet wake")
                }
            }
            case 1145 {
                if drop_tail != world && duet_tail != world {
                    Check(drop_tail.ParticleField3D.count == 0 && duet_tail.ParticleField3D.count == 0, "even charged drop wakes finish within six active seconds")
                }
                Check(ActiveCues() == 0 && world.VisualState.cue_overwrites == 0, "persistent drops release their bounded slots without overwriting another effect")
                self.TestReport.done = true
            }
        }
        frame += 1
    }
}
