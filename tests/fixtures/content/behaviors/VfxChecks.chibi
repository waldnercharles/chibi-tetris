// Production consumer regression. The fixture has no stage lights or audio,
// so local reaction lights and field lifetimes can be observed directly.
behavior VfxChecks {
    world: entity
    first: entity
    second: entity
    vortex: entity
    stars: entity
    packet: entity
    landing: entity
    settling: entity
    turning: entity
    shifting: entity
    holding: entity
    falling: entity
    light: entity
    oldest: entity
    old_age := 0
    frame: int = 0

    function Check(condition: bool, message: string) {
        self.TestReport.checks += 1
        if condition {
            return
        }
        self.TestReport.failures += 1
        if self.TestReport.first_failure == "" {
            self.TestReport.first_failure = message
        }
    }

    on Begin {
        world = get_global_variable("World")
        first = get_global_variable("Board1")
        second = get_global_variable("Board2")
        vortex = get_global_variable("Vortex")
        stars = get_global_variable("Stars")
        ReactionRules.Initialize(world, 1)
        ReactionRules.Initialize(first, 1)
        ReactionRules.Initialize(second, 1)
        packet = world
        landing = world
        settling = world
        light = world
        oldest = world
    }

    function Record(source: entity, kind: int, result: int, x: number, y: number, amount: int) {
        record := source.ReactionQueue.write
        ReactionRules.Emit(source, kind, result, x, y, 1, amount, 3)
        record.ReactionEvent.width = 48
        record.ReactionEvent.center_offset = 12
        record.ReactionEvent.point0 = vec3(x, y, 9)
        record.ReactionEvent.point1 = vec3(x + 24, y, 10)
        record.ReactionEvent.point2 = vec3(x, y - 24, 11)
        record.ReactionEvent.point3 = vec3(x + 24, y - 24, 12)
    }

    function ActiveCues() -> (count: int) {
        count = 0
        fields := find_entities_with_component("ParticleField3D")
        for field in fields {
            if field != vortex && field != stars && field.ParticleField3D.count > 0 {
                count += 1
            }
        }
        return count
    }

    function CueAt(x: number, y: number) -> (found: entity) {
        found = world
        fields := find_entities_with_component("ParticleField3D")
        for field in fields {
            if field != vortex && field != stars && field.ParticleField3D.count > 0 {
                p := field.Transform3D.position
                if abs(p.x - x) < 0.01 && abs(p.y - y) < 0.01 {
                    found = field
                    break
                }
            }
        }
        return found
    }

    function RowInstances(x: number, y: number) -> (count: int) {
        count = 0
        fields := find_entities_with_component("ParticleField3D")
        for field in fields {
            if field != vortex && field != stars && field.ParticleField3D.count > 0 {
                p := field.Transform3D.position
                if abs(p.x - x) < 0.01 && abs(p.y - y) < 0.01 {
                    count += field.ParticleField3D.count
                    Check(abs(p.z - 10.5) < 0.01, "every clear layer preserves the captured mean block front")
                    Check(field.Shader.material == "ReactionParticles.Release", "clear fields bind the dedicated release shader before its parameters")
                    debris_count: int = 96
                    if world.Session.effects == 1 {
                        debris_count = 48
                    }
                    if field.ParticleField3D.count == debris_count {
                        Check(!field.ParticleField3D.additive, "heavy fragments use opaque physical geometry")
                    }
                }
            }
        }
        return count
    }

    function LayerAt(x: number, y: number, count: int) -> (found: entity) {
        fields := find_entities_with_component("ParticleField3D")
        for field in fields {
            if field != vortex && field != stars && field.ParticleField3D.count == count {
                position := field.Transform3D.position
                if abs(position.x - x) < 0.01 && abs(position.y - y) < 0.01 {
                    return field
                }
            }
        }
        return world
    }

    function Clear(mask: int, amount: int) {
        record := first.ReactionQueue.write
        // A deliberately unrelated piece origin catches reconstruction from
        // the current piece after compaction instead of the immutable mask.
        Record(first, 9, 1, 999, 777, amount)
        record.ReactionEvent.detail = mask
    }

    on Tick {
        match (frame) {
            case 8 {
                Check(ActiveCues() == 0, "fresh fields are dormant")
                Record(first, 2, 1, 80, 96, 0)
                Record(first, 1, 0, -60, 50, 0)
                Record(first, 6, 1, 20, 150, 6)
                Record(first, 8, 1, 20, 6, 0)
                Record(first, 1, 1, -110, 120, 0)
                Record(first, 7, 1, -160, 10, 0)
                Record(first, 4, 1, 130, 80, 1)
            }
            case 10 {
                Check(ActiveCues() == 8, "ordinary actions own their bounded layers and hard-drop lock does not replay its landing")
                turning = CueAt(80, 96)
                blocked := CueAt(-60, 50)
                packet = CueAt(20, 150)
                landing = LayerAt(20, 6, 64)
                settling = LayerAt(20, 6, 96)
                shifting = CueAt(-110, 120)
                holding = CueAt(-160, 10)
                falling = CueAt(130, 80)
                Check(turning != world && blocked != world, "local input fields retain their action origins")
                Check(packet != world && landing != world, "packet starts at the captured piece and landing shifts exactly six cells")
                Check(settling != world, "hard-drop landing has an independent restrained settling tail")
                Check(shifting != world && holding != world && falling != world, "move hold and soft fall preserve their own captured origins")
                if turning != world && blocked != world {
                    Check(turning.ParticleField3D.count == 72 && blocked.ParticleField3D.count == 12, "turn and rejection use restrained counts")
                    Check(turning.Shader.material == "ReactionParticles.Cue" && blocked.Shader.material == "ReactionParticles.Cue", "ordinary input keeps its compact contact shader")
                    Check(turning.Transform3D.position.z == 0, "field origin leaves captured front-face depth in the point payload")
                }
                if packet != world && landing != world {
                    Check(packet.Geometry3D.primitive == 5 && landing.Geometry3D.primitive == 5, "cue configuration retains the supported octahedron mesh primitive")
                    Check(packet.Geometry3D.height == 1.8 && landing.Geometry3D.height == 1, "drop elongation never leaks into contact geometry")
                    Check(packet.ParticleField3D.count == 96 && landing.ParticleField3D.count == 64, "drop layers have bounded independent instance counts")
                }
                lights := find_entities_with_component("PointLight")
                for candidate in lights {
                    if abs(candidate.Transform.x - 32) < 0.01 && abs(candidate.PointLight.elevation + 28.7) < 0.01 {
                        light = candidate
                    }
                }
                Check(light != world, "grounded light sits below the lowest captured landing cell")
                if light != world {
                    Check(abs(light.Transform.y - 12.5) < 0.01, "light depth follows the captured front face")
                    Check(light.PointLight.intensity == 0, "delayed impact light stays dark before packet arrival")
                }
            }
            case 17 {
                if light != world {
                    Check(light.PointLight.intensity == 0, "landing illumination waits for the full smoother packet transit")
                }
            }
            case 22 {
                if light != world {
                    Check(light.PointLight.intensity > 0.1 && light.PointLight.intensity <= 0.45, "impact light rises through a restrained attack after arrival")
                }
            }
            case 30 {
                if packet != world && landing != world {
                    Check(packet.ParticleField3D.count == 96, "descending grains retain a smooth tail after their arrival")
                    Check(landing.ParticleField3D.count == 64, "delayed landing keeps its full particle lifetime after arrival")
                }
                if settling != world {
                    Check(settling.ParticleField3D.count == 96 && settling.ParticleField3D.time > 0.3, "settling dust retains its independent longer release")
                }
                if turning != world && shifting != world && holding != world && falling != world {
                    Check(turning.ParticleField3D.count == 72 && shifting.ParticleField3D.count == 32, "rotation and movement trails outlive their former short flash")
                    Check(holding.ParticleField3D.count == 48 && falling.ParticleField3D.count == 24, "hold and soft fall also retain smooth local tails")
                }
            }
            case 32 {
                world.Session.reduced_motion = true
            }
            case 38 {
                Check(ActiveCues() == 0, "long action tails retire smoothly without replay when motion is disabled")
                if light != world {
                    Check(light.PointLight.intensity == 0, "impact light reaches zero at its release endpoint")
                }
                world.Session.reduced_motion = false
            }
            case 40 {
                for i in 0..31 {
                    Record(first, 11, 1, 1000 + i, 1000, 0)
                    Record(second, 11, 1, 2000 + i, 1000, 0)
                    ReactionRules.Emit(world, 20, 1, 0, 1, 1, 1, 0)
                }
            }
            case 42 {
                Check(ActiveCues() == 96, "all fixed pool slots can carry independent live cues")
                oldest = CueAt(1000, 1000)
                Check(oldest != world, "oldest saturated cue remains present")
                if oldest != world {
                    old_age = oldest.ParticleField3D.time
                }
                Record(first, 1, 0, -500, -500, 0)
            }
            case 44 {
                Check(world.VisualState.cue_dropped == 1, "full pool counts the skipped incoming cue")
                Check(world.VisualState.cue_overwrites == 0, "saturation never overwrites live geometry")
                Check(CueAt(-500, -500) == world, "a saturated pool does not replace a visible cue")
                if oldest != world {
                    Check(oldest.ParticleField3D.time > old_age && oldest.ParticleField3D.count == 80, "oldest cue keeps its clock and geometry under saturation")
                }
                Check(first.ReactionQueue.dropped == 0 && second.ReactionQueue.dropped == 0 && world.ReactionQueue.dropped == 0, "cosmetic saturation does not drop event queue records")
                world.Session.reduced_motion = true
            }
            case 46 {
                Check(ActiveCues() > 0, "reduced motion releases visible cues over several frames")
            }
            case 50 {
                Check(ActiveCues() == 0, "retirement completes before slots are reused")
                Record(first, 2, 1, 80, 96, 0)
                Record(first, 6, 1, 20, 150, 6)
                Record(first, 8, 1, 20, 6, 0)
            }
            case 52 {
                Check(ActiveCues() == 2, "quiet hard drop uses one stationary contact confirmation")
                turn := CueAt(80, 96)
                quiet_drop := CueAt(20, 6)
                Check(turn != world && quiet_drop != world, "quiet confirmations retain physical origins")
                if turn != world && quiet_drop != world {
                    Check(turn.ParticleField3D.count == 8 && quiet_drop.ParticleField3D.count == 8, "quiet confirmations keep the minimum count")
                }
                lights := find_entities_with_component("PointLight")
                for candidate in lights {
                    Check(candidate.PointLight.intensity == 0, "quiet input never creates a new reaction light")
                }
            }
            case 62 {
                Check(ActiveCues() == 0, "quiet confirmation fades finish without replay")
                Check(world.VisualState.cue_dropped == 1 && world.VisualState.cue_overwrites == 0, "pool diagnostics distinguish skips from destructive reuse")
                world.Session.reduced_motion = false
            }
            case 64 {
                Clear(1 << 18 | 1 << 19 | 1 << 20 | 1 << 21, 4)
            }
            case 66 {
                Check(ActiveCues() == 16, "four cleared rows own four independent layers each")
                total: int = 0
                for row in 18..21 {
                    count := RowInstances(-254, 276 - row * 24)
                    Check(count == 2656, "each full-effect row owns 320 fracture grains 96 chunks 2048 embers and 192 energy grains")
                    total += count
                }
                Check(total == 10624, "a four-line clear reserves its larger finite celebration budget")
                Check(CueAt(999, 777) == world, "clear layers never follow the newly spawned piece origin")
                lights := find_entities_with_component("PointLight")
                row_lights: int = 0
                for candidate in lights {
                    if abs(candidate.Transform.x + 254) < 0.01 {
                        row_lights += 1
                        Check(abs(candidate.Transform.y - 12.5) < 0.01, "clear illumination starts just in front of the captured block face")
                        Check(candidate.PointLight.elevation <= -156 && candidate.PointLight.elevation >= -228, "clear illumination belongs to the cleared rows")
                    }
                }
                Check(row_lights == 4, "every cleared row owns one bounded local light")
            }
            case 84 {
                Check(ActiveCues() == 12, "fracture fronts disappear while chunks embers and energy continue")
                Check(RowInstances(-254, -228) == 2336, "fracture retirement keeps the full longer-lived row budget")
            }
            case 104 {
                Check(ActiveCues() == 8, "expanding energy retires before the heavier fragments and microembers")
                Check(RowInstances(-254, -228) == 2144, "debris and ember layers retain independent lifetimes")
            }
            case 128 {
                Check(ActiveCues() == 4, "microembers keep flowing after the heavy fragments expire")
                Check(RowInstances(-254, -228) == 2048, "the long tail retains thousands of independently evaluated microembers")
            }
            case 156 {
                Check(ActiveCues() == 0, "all clear layers expire before their fixed fields can be reused")
                world.Session.effects = 1
                world.Session.mode = 1
            }
            case 158 {
                Clear(1 << 2 | 1 << 20, 2)
            }
            case 160 {
                Check(ActiveCues() == 8, "nonadjacent clear rows receive independent layers in Solo")
                Check(RowInstances(0, 228) == 1328 && RowInstances(0, -204) == 1328, "reduced effects halves every clear layer without moving its row")
                Check(CueAt(0, -228) == world, "the row mask never fills an uncleared neighboring row")
                world.Session.effects = 0
            }
            case 162 {
                Check(ActiveCues() == 8, "effects-off releases the existing long clear tails continuously")
            }
            case 166 {
                Check(ActiveCues() == 0, "effects-off finishes retirement before field reuse")
                Clear(1 << 21, 1)
            }
            case 168 {
                Check(ActiveCues() == 1 && RowInstances(0, -228) == 8, "effects-off uses one small stationary clear confirmation")
            }
            case 180 {
                Check(ActiveCues() == 0, "quiet row confirmation reaches its normal release endpoint")
                Check(world.VisualState.cue_dropped == 1 && world.VisualState.cue_overwrites == 0, "the multirow celebration and mode changes never overwrite a live field")
                world.Session.effects = 2
                Record(first, 8, 1, 80, 30, 0)
            }
            case 182 {
                landing = LayerAt(80, 30, 64)
                settling = LayerAt(80, 30, 96)
                Check(ActiveCues() == 2 && landing != world && settling != world, "natural gravity lock creates one contact and one settling layer")
                lights := find_entities_with_component("PointLight")
                found := false
                for candidate in lights {
                    if abs(candidate.Transform.x - 92) < 0.01 && abs(candidate.PointLight.elevation + 4.7) < 0.01 {
                        found = true
                        Check(abs(candidate.Transform.y - 12.5) < 0.01, "natural lock light uses the captured block front")
                        Check(candidate.PointLight.intensity > 0.1 && candidate.PointLight.intensity <= 0.324, "natural lock has a smaller immediate light than hard drop")
                    }
                }
                Check(found, "natural lock illumination belongs to its lowest occupied cells")
            }
            case 214 {
                if landing != world && settling != world {
                    Check(landing.ParticleField3D.count == 64 && settling.ParticleField3D.count == 96, "contact and settling remain alive through a restrained half-second release")
                }
            }
            case 224 {
                if landing != world && settling != world {
                    Check(landing.ParticleField3D.count == 0 && settling.ParticleField3D.count == 96, "settling outlives the contact without restarting its clock")
                }
            }
            case 248 {
                Check(ActiveCues() == 0, "both natural landing layers finish before their fields are reused")
                Check(world.VisualState.cue_dropped == 1 && world.VisualState.cue_overwrites == 0, "long ordinary tails stay within the fixed pool")
                self.TestReport.done = true
            }
        }
        frame += 1
    }
}
