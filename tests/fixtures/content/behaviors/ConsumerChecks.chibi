// Exercise the production Environment after records leave the board queues.
behavior ConsumerChecks {
    world: entity
    first: entity
    second: entity
    vortex: entity
    stars: entity
    frame: int = 0
    frozen_time := 0

    function Check(condition: bool, message: string) {
        self.TestReport.checks += 1
        if condition {
            return
        }
        self.TestReport.failures += 1
        if self.TestReport.first_failure == "" {
            self.TestReport.first_failure = message
        }
    }

    on Begin {
        world = get_global_variable("World")
        first = get_global_variable("Board1")
        second = get_global_variable("Board2")
        vortex = get_global_variable("Vortex")
        stars = get_global_variable("Stars")
        ReactionRules.Initialize(world, 1)
        ReactionRules.Initialize(first, 1)
        ReactionRules.Initialize(second, 1)
    }

    function ActiveCues() -> (count: int) {
        count = 0
        fields := find_entities_with_component("ParticleField3D")
        for field in fields {
            if field != vortex && field != stars && field.ParticleField3D.count > 0 {
                count += 1
            }
        }
        return count
    }

    function CuesAt(x: number, y: number) -> (count: int) {
        count = 0
        fields := find_entities_with_component("ParticleField3D")
        for field in fields {
            if field != vortex && field != stars && field.ParticleField3D.count > 0 {
                position := field.Transform3D.position
                if abs(position.x - x) < 0.01 && abs(position.y - y) < 0.01 {
                    count += 1
                }
            }
        }
        return count
    }

    function QuietCues(expected: int) {
        Check(ActiveCues() == expected, "quiet input creates only fresh confirmations")
        fields := find_entities_with_component("ParticleField3D")
        for field in fields {
            if field != vortex && field != stars && field.ParticleField3D.count > 0 {
                Check(field.ParticleField3D.count == 24, "quiet feedback uses the reduced particle count")
                Check(field.ParticleField3D.time <= 0.08, "quiet confirmations retain their short lifetime")
            }
        }
        lights := find_entities_with_component("PointLight")
        for light in lights {
            Check(light.PointLight.intensity == 0, "quiet feedback never creates local light flashes")
        }
    }

    function Batch(board: entity, center: number) {
        for i in 0..11 {
            ReactionRules.Emit(board, 1, 1, center + i * 4, 160, 1, 1, 3)
        }
        ReactionRules.Emit(board, 2, 1, center, 130, 1, 0, 3)
        ReactionRules.Emit(board, 7, 1, center, 105, 0, 2, 3)
        ReactionRules.Emit(board, 6, 1, center, 80, 0, 8, 3)
        ReactionRules.Emit(board, 8, 1, center, -112, 0, 0, 3)
        // Four original rows plus four combo arcs expand two records to eight cues.
        rows := cast<int>(0)
        for row in 18..21 {
            rows = rows | 1 << row
        }
        ReactionRules.Emit(board, 9, 1, center, -112, 0, 4, rows)
        ReactionRules.Emit(board, 10, 1, center, -112, 0, 4, rows)
    }

    on Tick {
        match (frame) {
            case 8 {
                Check(ActiveCues() == 0, "fresh environment has no unconfigured cues")
                Batch(first, -300)
                Batch(second, 300)
                ReactionRules.Emit(world, 17, 0, 0, 0, -1, 0, 0)
            }
            case 10 {
                Check(ActiveCues() == 51, "both expanded Duet batches survive until their first render")
                Check(CuesAt(-300, 160) == 1, "first board action retains its own origin")
                Check(CuesAt(300, 160) == 1, "second board action retains its own origin")
                Check(CuesAt(-300, -112) == 3, "hard drop landing lock and combo keep the recorded landing")
                Check(CuesAt(-254, -156) == 1 && CuesAt(254, -156) == 1, "clear cues retain each board and original row")
                Check(CuesAt(180, 270) == 1, "rejected chapter receives one local confirmation")
                Check(CuesAt(-170, 0) == 0 && CuesAt(170, 0) == 0, "rejected chapter never celebrates")
                Check(world.VisualState.cue_overwrites == 0, "ordinary combined batches never overwrite visible cues")
                Check(first.ReactionQueue.dropped == 0 && second.ReactionQueue.dropped == 0 && world.ReactionQueue.dropped == 0, "consumer drains complete queues without loss")
                world.Session.run = 2
                world.ReactionQueue.run = 2
                ReactionRules.Initialize(first, 2)
                ReactionRules.Initialize(second, 2)
                ReactionRules.Emit(first, 1, 1, -333, 77, -1, 1, 3)
                ReactionRules.Emit(world, 15, 1, 1, 2, 0, 3, 0)
            }
            case 12 {
                Check(ActiveCues() == 3, "restart clears old cues before consuming its first records")
                Check(CuesAt(-333, 77) == 1, "first input of a new run is never skipped")
                Check(CuesAt(-300, 160) == 0 && CuesAt(300, 160) == 0, "previous run leaves no surviving action geometry")
                Check(CuesAt(-170, 0) == 1 && CuesAt(170, 0) == 1, "restart session confirmation survives the board reset")
            }
            case 14 {
                Check(ActiveCues() == 3, "consumed records do not replay on later ticks")
                world.Session.reduced_motion = true
                ReactionRules.Emit(first, 1, 1, -333, 77, -1, 1, 3)
                ReactionRules.Emit(first, 6, 1, -310, 50, 0, 3, 3)
            }
            case 16 {
                QuietCues(3)
                Check(CuesAt(-333, 77) == 1 && CuesAt(-310, -22) == 1, "quiet confirmations retain their event origins")
                frozen_time = vortex.ParticleField3D.time
                world.VisualState.energy = 0.9
                world.VisualState.bass = 0.8
                world.VisualState.treble = 0.7
            }
            case 23 {
                Check(ActiveCues() == 0, "quiet confirmations expire without replay")
                Check(vortex.ParticleField3D.time == frozen_time && stars.ParticleField3D.time == frozen_time, "reduced motion freezes both background clocks despite audio")
                world.Session.reduced_motion = false
                world.Session.effects = 0
                ReactionRules.Emit(first, 1, 0, -290, 65, -1, 0, 3)
                ReactionRules.Emit(world, 20, 1, 0, 1, 1, 1, 0)
            }
            case 25 {
                QuietCues(2)
                Check(vortex.ParticleField3D.count == 0 && stars.ParticleField3D.count == 512, "effects off keeps only the sparse background")
                Check(vortex.ParticleField3D.time == frozen_time, "effects off does not resume background travel")
                world.Session.effects = 2
                world.Session.screen = 2
                ReactionRules.Emit(world, 13, 1, 1, 2, 0, 2, 0)
            }
            case 29 {
                Check(vortex.ParticleField3D.time == frozen_time && stars.ParticleField3D.time == frozen_time, "pause freezes background travel after restoring full effects")
                Check(CuesAt(180, 270) == 1, "pause has fresh feedback while gameplay travel is frozen")
                world.Session.screen = 1
                ReactionRules.Emit(world, 14, 1, 2, 1, 0, 1, 0)
            }
            case 31 {
                Check(vortex.ParticleField3D.time > frozen_time, "resume restarts background travel")
                Check(CuesAt(180, 270) >= 1, "resume receives its own confirmation")
            }
            case 42 {
                Check(ActiveCues() == 0, "all consumed input cues finish without replay")
                Check(first.ReactionQueue.dropped == 0 && second.ReactionQueue.dropped == 0 && world.ReactionQueue.dropped == 0, "all transition records remain within their queues")
                Check(world.VisualState.cue_overwrites == 0, "lifetime reuse avoids visible pool saturation")
                self.TestReport.done = true
            }
        }
        frame += 1
    }
}
