version 3
name "CosmicParticles"
domain "shader-library"
id_counter 300000
description "Four continuous 3D particle families, stable identities, shared musical motion and cyclic stage palettes."
(array)graphs {
    - kind="event" name="Functions"
    - {
        id 110
        kind "function"
        name "ParticleRandom"
        description "Fixed random coordinates. Variation is sampled once at scene startup, never per frame."
        entry_id 120
        return_id 130
        call_depth_limit 64
        (array)nodes {
            - {
                id 120
                type "Function Entry"
                (array)outputs {
                    - id=140 name="Index" type="float" kind="data"
                    - id=150 name="Seed" type="float" kind="data"
                    - id=160 name="Variation" type="float" kind="data"
                }
            }
            - {
                id 130
                type "Return"
                (array)inputs {
                    - id=170 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 180
                type "Behavior Expression"
                reference_name "fract(sin(vec3(Index * 0.731 + Seed * 0.113 + Variation * 0.017, Index * 0.593 + Seed * 0.317 + Variation * 0.029, Index * 0.419 + Seed * 0.713 + Variation * 0.043)) * vec3(4375.585, 2257.145, 1964.267))"
                inputs {
                    Index id=190 type="float"
                    Seed id=200 type="float"
                    Variation id=210 type="float"
                }
                outputs {
                    Result id=220 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="120.Index" to="180.Index"
            - from="120.Seed" to="180.Seed"
            - from="120.Variation" to="180.Variation"
            - from="180.Result" to="130.Value"
        }
    }
    - {
        id 230
        kind "function"
        name "StageWeights"
        description "Four cyclic weights sum to one, including the lattice-to-aurora wrap."
        entry_id 240
        return_id 250
        call_depth_limit 64
        (array)nodes {
            - {
                id 240
                type "Function Entry"
                (array)outputs {
                    - id=260 name="Style" type="float" kind="data"
                }
            }
            - {
                id 250
                type "Return"
                (array)inputs {
                    - id=270 name="Value" type="struct" type_name="ShaderVec4" kind="data"
                }
            }
            - {
                id 280
                type "Behavior Expression"
                reference_name "vec4(1 - smoothstep(0, 1, min(abs(Style), 4 - abs(Style))), 1 - smoothstep(0, 1, min(abs(Style - 1), 4 - abs(Style - 1))), 1 - smoothstep(0, 1, min(abs(Style - 2), 4 - abs(Style - 2))), 1 - smoothstep(0, 1, min(abs(Style - 3), 4 - abs(Style - 3))))"
                inputs {
                    Style id=290 type="float"
                }
                outputs {
                    Result id=300 type="struct" type_name="ShaderVec4"
                }
            }
        }
        (array)edges {
            - from="240.Style" to="280.Style"
            - from="280.Result" to="250.Value"
        }
    }
    - {
        id 310
        kind "function"
        name "AuroraCurtain"
        description "Five deep, vertically flowing aurora curtains with broad folded surfaces."
        entry_id 320
        return_id 330
        call_depth_limit 64
        (array)nodes {
            - {
                id 320
                type "Function Entry"
                (array)outputs {
                    - id=340 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=350 name="Phase" type="float" kind="data"
                    - id=360 name="Bass" type="float" kind="data"
                    - id=370 name="Mid" type="float" kind="data"
                    - id=380 name="Reaction" type="float" kind="data"
                }
            }
            - {
                id 330
                type "Return"
                (array)inputs {
                    - id=390 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 400
                type "Behavior Expression"
                reference_name "vec3((Random.x - 0.5) * 3400 + sin(Random.y * 7 + Phase * 0.23) * (45 + Mid * 70), (Random.y - 0.5) * 2000 + sin(Random.x * 9 + Phase * 0.19) * (140 + Bass * 130), -1700 + floor(Random.z * 5) * 165 + sin(Random.x * 10 + Phase * 0.21 + floor(Random.z * 5)) * (230 + Mid * 130 + Reaction * 80) + (fract(Random.z * 5) - 0.5) * 50)"
                inputs {
                    Random id=410 type="struct" type_name="ShaderVec3"
                    Phase id=420 type="float"
                    Bass id=430 type="float"
                    Mid id=440 type="float"
                    Reaction id=450 type="float"
                }
                outputs {
                    Result id=460 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="320.Random" to="400.Random"
            - from="320.Phase" to="400.Phase"
            - from="320.Bass" to="400.Bass"
            - from="320.Mid" to="400.Mid"
            - from="320.Reaction" to="400.Reaction"
            - from="400.Result" to="330.Value"
        }
    }
    - {
        id 470
        kind "function"
        name "PetalCoordinates"
        description "A six-petal radial shell, curved through depth instead of a flat polar wheel."
        entry_id 480
        return_id 490
        call_depth_limit 64
        (array)nodes {
            - {
                id 480
                type "Function Entry"
                (array)outputs {
                    - id=500 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=510 name="Phase" type="float" kind="data"
                    - id=520 name="Bass" type="float" kind="data"
                    - id=530 name="Mid" type="float" kind="data"
                    - id=540 name="Reaction" type="float" kind="data"
                }
            }
            - {
                id 490
                type "Return"
                (array)inputs {
                    - id=550 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 560
                type "Behavior Expression"
                reference_name "vec3(430 + Random.y * 1230 + sin(Random.x * 37.6991118 + Phase * 0.18) * (110 + Bass * 130 + Reaction * 70), Random.x * 6.2831853 + Phase * 0.11 + sin(Random.y * 4 + Phase * 0.13) * (0.08 + Mid * 0.1), -1550 + sin(Random.y * 3.1415927) * 480 + cos(Random.x * 37.6991118 + Phase * 0.18) * 190 + (Random.z - 0.5) * 120)"
                inputs {
                    Random id=570 type="struct" type_name="ShaderVec3"
                    Phase id=580 type="float"
                    Bass id=590 type="float"
                    Mid id=600 type="float"
                    Reaction id=610 type="float"
                }
                outputs {
                    Result id=620 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="480.Random" to="560.Random"
            - from="480.Phase" to="560.Phase"
            - from="480.Bass" to="560.Bass"
            - from="480.Mid" to="560.Mid"
            - from="480.Reaction" to="560.Reaction"
            - from="560.Result" to="490.Value"
        }
    }
    - {
        id 630
        kind "function"
        name "PetalPosition"
        description "Tilt the petal shell while retaining its central opening."
        entry_id 640
        return_id 650
        call_depth_limit 64
        (array)nodes {
            - {
                id 640
                type "Function Entry"
                (array)outputs {
                    - id=660 name="Shell" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 650
                type "Return"
                (array)inputs {
                    - id=670 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 680
                type "Behavior Expression"
                reference_name "vec3(cos(Shell.y) * Shell.x, sin(Shell.y) * Shell.x * 0.79, Shell.z + sin(Shell.y) * Shell.x * 0.14)"
                inputs {
                    Shell id=690 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=700 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="640.Shell" to="680.Shell"
            - from="680.Result" to="650.Value"
        }
    }
    - {
        id 710
        kind "function"
        name "DuneRibbons"
        description "Eleven horizontal dune ribbons roll independently through a deep landscape."
        entry_id 720
        return_id 730
        call_depth_limit 64
        (array)nodes {
            - {
                id 720
                type "Function Entry"
                (array)outputs {
                    - id=740 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=750 name="Phase" type="float" kind="data"
                    - id=760 name="Bass" type="float" kind="data"
                    - id=770 name="Mid" type="float" kind="data"
                    - id=780 name="Reaction" type="float" kind="data"
                }
            }
            - {
                id 730
                type "Return"
                (array)inputs {
                    - id=790 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 800
                type "Behavior Expression"
                reference_name "vec3((Random.x - 0.5) * 3550 + sin(Phase * 0.14 + Random.y * 4) * (55 + Mid * 40), -810 + floor(Random.y * 11) * 162 + sin(Random.x * 8 + floor(Random.y * 11) * 0.63 + Phase * 0.22) * (95 + Bass * 100 + Reaction * 70) + (fract(Random.y * 11) - 0.5) * 34, -1550 + cos(Random.x * 5 + Random.y * 4 + Phase * 0.16) * 470 + (Random.z - 0.5) * 100)"
                inputs {
                    Random id=810 type="struct" type_name="ShaderVec3"
                    Phase id=820 type="float"
                    Bass id=830 type="float"
                    Mid id=840 type="float"
                    Reaction id=850 type="float"
                }
                outputs {
                    Result id=860 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="720.Random" to="800.Random"
            - from="720.Phase" to="800.Phase"
            - from="720.Bass" to="800.Bass"
            - from="720.Mid" to="800.Mid"
            - from="720.Reaction" to="800.Reaction"
            - from="800.Result" to="730.Value"
        }
    }
    - {
        id 870
        kind "function"
        name "OrbitCoordinates"
        description "Three woven, closed knot tubes with continuous motion along their depth."
        entry_id 880
        return_id 890
        call_depth_limit 64
        (array)nodes {
            - {
                id 880
                type "Function Entry"
                (array)outputs {
                    - id=900 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=910 name="Phase" type="float" kind="data"
                    - id=920 name="Bass" type="float" kind="data"
                    - id=930 name="Mid" type="float" kind="data"
                    - id=940 name="Reaction" type="float" kind="data"
