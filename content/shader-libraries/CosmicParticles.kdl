version 3
name "CosmicParticles"
domain "shader-library"
id_counter 180000
description "Continuous 3D particle currents with stable instance identities. Integrated flow and turning phase carry input momentum; smooth audio deforms the current without recycling particles."
(array)graphs {
    - kind="event" name="Functions"
    - {
        id 1000
        kind "function"
        name "ParticleRandom"
        description "Stable particle variation shared by both fields."
        entry_id 1010
        return_id 1020
        call_depth_limit 64
