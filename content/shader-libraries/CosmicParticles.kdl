                reference_name "vec3(860 + sin(Random.x * 18.8495559 + Phase * 0.19) * (260 + Bass * 100) + cos(Random.y * 6.2831853) * (65 + Mid * 70), Random.x * 6.2831853 + Phase * 0.09 + floor(Random.z * 3) * 2.0943951, -1550 + cos(Random.x * 18.8495559 + Phase * 0.19) * 470 + sin(Random.y * 6.2831853) * (100 + Reaction * 110) + (fract(Random.z * 3) - 0.5) * 40)"
                inputs {
                    Random id=970 type="struct" type_name="ShaderVec3"
                    Phase id=980 type="float"
                    Bass id=990 type="float"
                    Mid id=1000 type="float"
                    Reaction id=1010 type="float"
                }
                outputs {
                    Result id=1020 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="880.Random" to="960.Random"
            - from="880.Phase" to="960.Phase"
            - from="880.Bass" to="960.Bass"
            - from="880.Mid" to="960.Mid"
            - from="880.Reaction" to="960.Reaction"
            - from="960.Result" to="890.Value"
        }
    }
    - {
        id 1030
        kind "function"
        name "OrbitPosition"
        description "Spread the knot lattice around the playfield with genuine near and far arcs."
        entry_id 1040
        return_id 1050
        call_depth_limit 64
        (array)nodes {
            - {
                id 1040
                type "Function Entry"
                (array)outputs {
                    - id=1060 name="Orbit" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 1050
                type "Return"
                (array)inputs {
                    - id=1070 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 1080
                type "Behavior Expression"
                reference_name "vec3(cos(Orbit.y) * Orbit.x * 1.42, sin(Orbit.y) * Orbit.x * 0.88, Orbit.z + sin(Orbit.y) * 160)"
                inputs {
                    Orbit id=1090 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=1100 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="1040.Orbit" to="1080.Orbit"
            - from="1080.Result" to="1050.Value"
        }
    }
    - {
        id 1110
        kind "function"
        name "BlendStage"
        description "The same particle moves continuously between neighboring field families."
        entry_id 1120
        return_id 1130
        call_depth_limit 64
        (array)nodes {
            - {
                id 1120
                type "Function Entry"
                (array)outputs {
                    - id=1140 name="Aurora" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1150 name="Petal" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1160 name="Dune" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1170 name="Orbit" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1180 name="Weights" type="struct" type_name="ShaderVec4" kind="data"
