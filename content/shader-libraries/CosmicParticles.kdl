            - {
                id 1200
                type "Behavior Expression"
                reference_name "Aurora * Weights.x + Petal * Weights.y + Dune * Weights.z + Orbit * Weights.w"
                inputs {
                    Aurora id=1210 type="struct" type_name="ShaderVec3"
                    Petal id=1220 type="struct" type_name="ShaderVec3"
                    Dune id=1230 type="struct" type_name="ShaderVec3"
                    Orbit id=1240 type="struct" type_name="ShaderVec3"
                    Weights id=1250 type="struct" type_name="ShaderVec4"
                }
