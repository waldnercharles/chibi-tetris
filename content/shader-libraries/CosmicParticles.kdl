version 3
name "CosmicParticles"
domain "shader-library"
id_counter 1000000
description "Nebular volume, accretion disk, cellular bloom and sharp stellar currents share stable grains, real opacity and musical flow."
(array)graphs {
    - kind="event" name="Functions"
    - {
        id 110
        kind "function"
        name "ParticleRandom"
        description "Stable particle identity; no random values depend on frame time."
        entry_id 120
        return_id 130
        call_depth_limit 64
        (array)nodes {
            - {
                id 120
                type "Function Entry"
                (array)outputs {
                    - id=190 name="Index" type="float" kind="data"
                    - id=200 name="Seed" type="float" kind="data"
                    - id=210 name="Variation" type="float" kind="data"
                }
            }
            - {
                id 130
                type "Return"
                (array)inputs {
                    - id=220 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 140
                type "Behavior Expression"
                reference_name "fract(sin(vec3(Index * 0.731 + Seed * 0.113 + Variation * 0.017, Index * 0.593 + Seed * 0.317 + Variation * 0.029, Index * 0.419 + Seed * 0.713 + Variation * 0.043)) * vec3(4375.585, 2257.145, 1964.267))"
                inputs {
                    Index id=150 type="float"
                    Seed id=160 type="float"
                    Variation id=170 type="float"
                }
                outputs {
                    Result id=180 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="120.Index" to="140.Index"
            - from="120.Seed" to="140.Seed"
            - from="120.Variation" to="140.Variation"
            - from="140.Result" to="130.Value"
        }
    }
    - {
        id 230
        kind "function"
        name "StageWeights"
        description "Four neighboring scene weights sum to one and join continuously at the wrap."
        entry_id 240
        return_id 250
        call_depth_limit 64
        (array)nodes {
            - {
                id 240
                type "Function Entry"
                (array)outputs {
                    - id=290 name="Style" type="float" kind="data"
                }
            }
            - {
                id 250
                type "Return"
                (array)inputs {
                    - id=300 name="Value" type="struct" type_name="ShaderVec4" kind="data"
                }
            }
            - {
                id 260
                type "Behavior Expression"
                reference_name "vec4(1 - smoothstep(0, 1, min(abs(Style), 4 - abs(Style))), 1 - smoothstep(0, 1, min(abs(Style - 1), 4 - abs(Style - 1))), 1 - smoothstep(0, 1, min(abs(Style - 2), 4 - abs(Style - 2))), 1 - smoothstep(0, 1, min(abs(Style - 3), 4 - abs(Style - 3))))"
                inputs {
                    Style id=270 type="float"
                }
                outputs {
                    Result id=280 type="struct" type_name="ShaderVec4"
                }
            }
        }
        (array)edges {
            - from="240.Style" to="260.Style"
            - from="260.Result" to="250.Value"
        }
    }
    - {
        id 310
        kind "function"
        name "NebulaCloud"
        description "Deep irregular wisps drift through nested low-frequency turbulence. This is an analytical volume of grains, not a fluid simulation."
        entry_id 320
        return_id 330
        call_depth_limit 64
        (array)nodes {
            - {
                id 320
                type "Function Entry"
                (array)outputs {
                    - id=480 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=490 name="Phase" type="float" kind="data"
                    - id=500 name="Bass" type="float" kind="data"
                    - id=510 name="Mid" type="float" kind="data"
                    - id=520 name="Reaction" type="float" kind="data"
                }
            }
            - {
                id 330
                type "Return"
                (array)inputs {
                    - id=530 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 340
                type "Behavior Expression"
                reference_name "vec3((Random.x - 0.5) * 4.6, (Random.y - 0.5) * 2, (Random.z - 0.5) * 2)"
                inputs {
                    Random id=350 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=360 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 370
                type "Behavior Expression"
                reference_name "vec3(sin(Domain.y * 2.4 + sin(Domain.z * 2.1 + Phase * 0.065)), sin(Domain.x * 1.8 + sin(Domain.z * 2.8 - Phase * 0.055)), cos(Domain.x * 1.4 + Domain.y * 1.9 + Phase * 0.045))"
                inputs {
                    Domain id=380 type="struct" type_name="ShaderVec3"
                    Phase id=390 type="float"
                }
                outputs {
                    Result id=400 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 410
                type "Behavior Expression"
                reference_name "vec3(Domain.x * 970 + Warp.x * (180 + Mid * 55), Domain.x * 215 + Warp.y * 280 + Domain.y * (230 + 210 * Warp.z * Warp.z + Bass * 75), -1550 + Domain.z * 440 + Warp.z * (210 + Reaction * 80))"
                inputs {
                    Domain id=420 type="struct" type_name="ShaderVec3"
                    Warp id=430 type="struct" type_name="ShaderVec3"
                    Bass id=440 type="float"
                    Mid id=450 type="float"
                    Reaction id=460 type="float"
                }
                outputs {
                    Result id=470 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="320.Random" to="340.Random"
            - from="320.Phase" to="370.Phase"
            - from="320.Bass" to="410.Bass"
            - from="320.Mid" to="410.Mid"
            - from="320.Reaction" to="410.Reaction"
            - from="340.Result" to="370.Domain"
            - from="340.Result" to="410.Domain"
            - from="370.Result" to="410.Warp"
            - from="410.Result" to="330.Value"
        }
    }
    - {
        id 540
        kind "function"
        name "AccretionDisk"
        description "Differential orbital motion carries grains around a tilted central void. Inner orbits travel faster; no particles respawn at the seam."
        entry_id 550
        return_id 560
        call_depth_limit 64
        (array)nodes {
            - {
                id 550
                type "Function Entry"
                (array)outputs {
                    - id=710 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=720 name="Phase" type="float" kind="data"
                    - id=730 name="Bass" type="float" kind="data"
                    - id=740 name="Mid" type="float" kind="data"
                    - id=750 name="Reaction" type="float" kind="data"
                }
            }
            - {
                id 560
                type "Return"
                (array)inputs {
                    - id=760 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 570
                type "Behavior Expression"
                reference_name "vec3(660 + pow(Random.y, 1.45) * 1600, Random.x * 6.2831853 + Phase * (0.035 + 0.2 / (0.32 + Random.y)), (Random.z - 0.5) * (42 + Random.y * 180 + Mid * 24))"
                inputs {
                    Random id=580 type="struct" type_name="ShaderVec3"
                    Phase id=590 type="float"
                    Mid id=600 type="float"
                }
                outputs {
                    Result id=610 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 620
                type "Behavior Expression"
                reference_name "vec3(cos(Orbit.y + sin(Orbit.x * 0.004 - Phase * 0.04) * 0.12) * Orbit.x, sin(Orbit.y + sin(Orbit.x * 0.004 - Phase * 0.04) * 0.12) * Orbit.x, Orbit.z + sin(Orbit.y * 3 + Orbit.x * 0.005 - Phase * 0.055) * (18 + Bass * 16 + Reaction * 14))"
                inputs {
                    Orbit id=630 type="struct" type_name="ShaderVec3"
                    Phase id=640 type="float"
                    Bass id=650 type="float"
                    Reaction id=660 type="float"
                }
                outputs {
                    Result id=670 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 680
                type "Behavior Expression"
                reference_name "vec3(Disk.x * 0.94 - Disk.y * 0.16, Disk.x * 0.23 + Disk.y * 0.43 + 90, -1700 + Disk.y * 0.33 + Disk.z)"
                inputs {
                    Disk id=690 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=700 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="550.Random" to="570.Random"
            - from="550.Phase" to="570.Phase"
            - from="550.Phase" to="620.Phase"
            - from="550.Bass" to="620.Bass"
            - from="550.Mid" to="570.Mid"
            - from="550.Reaction" to="620.Reaction"
            - from="570.Result" to="620.Orbit"
            - from="620.Result" to="680.Disk"
            - from="680.Result" to="560.Value"
        }
    }
    - {
        id 770
        kind "function"
        name "CellularBloom"
        description "Thirteen swelling, warped membranes resemble chemical colonies. Their continuous analytical growth is not a stored reaction-diffusion solver."
        entry_id 780
        return_id 790
        call_depth_limit 64
        (array)nodes {
            - {
                id 780
                type "Function Entry"
                (array)outputs {
                    - id=1010 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1020 name="Phase" type="float" kind="data"
                    - id=1030 name="Bass" type="float" kind="data"
                    - id=1040 name="Mid" type="float" kind="data"
                    - id=1050 name="Reaction" type="float" kind="data"
                }
            }
            - {
                id 790
                type "Return"
                (array)inputs {
                    - id=1060 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 800
                type "Behavior Expression"
                reference_name "vec3(floor(Random.z * 13), Random.x * 6.2831853 + Phase * 0.035, 235 + pow(Random.y, 0.25) * 180)"
                inputs {
                    Random id=810 type="struct" type_name="ShaderVec3"
                    Phase id=820 type="float"
                }
                outputs {
                    Result id=830 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 840
                type "Behavior Expression"
                reference_name "vec3(sin(Cell.x * 2.399963) * sqrt((Cell.x + 1) / 13) * 1940, cos(Cell.x * 2.399963) * sqrt((Cell.x + 1) / 13) * 1110, -1650 + sin(Cell.x * 4.13) * 300)"
                inputs {
                    Cell id=850 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=860 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 870
                type "Behavior Expression"
                reference_name "Cell.z * (1 + 0.17 * sin(Cell.y * 3 + Cell.x * 1.7 + Phase * 0.09) + 0.13 * sin(Cell.y * 5 - Phase * 0.06 + Cell.x) + 0.12 * sin(Phase * 0.075 + Cell.x * 2.1) + Bass * 0.08 + Reaction * 0.055)"
                inputs {
                    Cell id=880 type="struct" type_name="ShaderVec3"
                    Phase id=890 type="float"
                    Bass id=900 type="float"
                    Reaction id=910 type="float"
                }
                outputs {
                    Result id=920 type="float"
                }
            }
            - {
                id 930
                type "Behavior Expression"
                reference_name "Center + vec3(cos(Cell.y) * Radius, sin(Cell.y) * Radius * (0.8 + Mid * 0.08), cos(Cell.y * 2 + Cell.x + Phase * 0.06) * 120 + (fract(Random.z * 13) - 0.5) * 160)"
                inputs {
                    Center id=940 type="struct" type_name="ShaderVec3"
                    Cell id=950 type="struct" type_name="ShaderVec3"
                    Radius id=960 type="float"
                    Random id=970 type="struct" type_name="ShaderVec3"
                    Phase id=980 type="float"
                    Mid id=990 type="float"
                }
                outputs {
                    Result id=1000 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="780.Random" to="800.Random"
            - from="780.Random" to="930.Random"
            - from="780.Phase" to="800.Phase"
            - from="780.Phase" to="870.Phase"
            - from="780.Phase" to="930.Phase"
            - from="780.Bass" to="870.Bass"
            - from="780.Mid" to="930.Mid"
            - from="780.Reaction" to="870.Reaction"
            - from="800.Result" to="840.Cell"
            - from="800.Result" to="870.Cell"
            - from="800.Result" to="930.Cell"
            - from="840.Result" to="930.Center"
            - from="870.Result" to="930.Radius"
            - from="930.Result" to="790.Value"
        }
    }
    - {
        id 1070
        kind "function"
        name "StellarCurrent"
        description "Thin crossing streams carry sharp elongated grains through deep, slowly bending stellar lanes."
        entry_id 1080
        return_id 1090
        call_depth_limit 64
        (array)nodes {
            - {
                id 1080
                type "Function Entry"
                (array)outputs {
                    - id=1210 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1220 name="Phase" type="float" kind="data"
                    - id=1230 name="Bass" type="float" kind="data"
                    - id=1240 name="Mid" type="float" kind="data"
                    - id=1250 name="Reaction" type="float" kind="data"
                }
            }
            - {
                id 1090
                type "Return"
                (array)inputs {
                    - id=1260 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 1100
                type "Behavior Expression"
                reference_name "vec3((Random.x - 0.5) * 4400, floor(Random.y * 7), fract(Random.y * 7) - 0.5)"
                inputs {
                    Random id=1110 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=1120 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 1130
                type "Behavior Expression"
                reference_name "vec3(Lane.x + sin(Phase * 0.07 + Lane.y * 1.3) * 160, (Lane.y - 3) * 285 + Lane.x * 0.18 + sin(Lane.x * 0.0018 + Lane.y * 0.9 + Phase * 0.095) * (145 + Bass * 60) + Lane.z * (26 + Mid * 28), -1750 + sin(Lane.x * 0.0012 + Lane.y * 1.7 - Phase * 0.055) * 350 + (Random.z - 0.5) * (140 + Reaction * 90))"
                inputs {
                    Lane id=1140 type="struct" type_name="ShaderVec3"
                    Random id=1150 type="struct" type_name="ShaderVec3"
                    Phase id=1160 type="float"
                    Bass id=1170 type="float"
                    Mid id=1180 type="float"
                    Reaction id=1190 type="float"
                }
                outputs {
                    Result id=1200 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="1080.Random" to="1100.Random"
            - from="1080.Random" to="1130.Random"
            - from="1080.Phase" to="1130.Phase"
            - from="1080.Bass" to="1130.Bass"
            - from="1080.Mid" to="1130.Mid"
            - from="1080.Reaction" to="1130.Reaction"
            - from="1100.Result" to="1130.Lane"
            - from="1130.Result" to="1090.Value"
        }
    }
    - {
        id 1270
        kind "function"
        name "BlendStage"
        description "One stable grain travels continuously between the four compositions."
        entry_id 1280
        return_id 1290
        call_depth_limit 64
        (array)nodes {
            - {
                id 1280
                type "Function Entry"
                (array)outputs {
                    - id=1370 name="Nebula" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1380 name="Disk" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1390 name="Cells" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1400 name="Current" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1410 name="Weights" type="struct" type_name="ShaderVec4" kind="data"
                }
            }
            - {
                id 1290
                type "Return"
                (array)inputs {
                    - id=1420 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 1300
                type "Behavior Expression"
                reference_name "Nebula * Weights.x + Disk * Weights.y + Cells * Weights.z + Current * Weights.w"
                inputs {
                    Nebula id=1310 type="struct" type_name="ShaderVec3"
                    Disk id=1320 type="struct" type_name="ShaderVec3"
                    Cells id=1330 type="struct" type_name="ShaderVec3"
                    Current id=1340 type="struct" type_name="ShaderVec3"
                    Weights id=1350 type="struct" type_name="ShaderVec4"
                }
                outputs {
                    Result id=1360 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="1280.Nebula" to="1300.Nebula"
            - from="1280.Disk" to="1300.Disk"
            - from="1280.Cells" to="1300.Cells"
            - from="1280.Current" to="1300.Current"
            - from="1280.Weights" to="1300.Weights"
            - from="1300.Result" to="1290.Value"
        }
    }
    - {
        id 1430
        kind "function"
        name "BoardProjection"
        description "Project distant grains onto the authored board plane before attenuating the field."
        entry_id 1440
        return_id 1450
        call_depth_limit 64
        (array)nodes {
            - {
                id 1440
                type "Function Entry"
                (array)outputs {
                    - id=1490 name="Position" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 1450
                type "Return"
                (array)inputs {
                    - id=1500 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 1460
                type "Behavior Expression"
                reference_name "vec3((Position.x - 90) * 1080 / max(1080 - Position.z, 1) + 90, (Position.y - 50) * 1080 / max(1080 - Position.z, 1) + 50, 0)"
                inputs {
                    Position id=1470 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=1480 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="1440.Position" to="1460.Position"
            - from="1460.Result" to="1450.Value"
        }
    }
    - {
        id 1510
        kind "function"
        name "BoardQuiet"
        description "Keep both Solo and Duet wells readable while retaining a faint field behind them."
        entry_id 1520
        return_id 1530
        call_depth_limit 64
        (array)nodes {
            - {
                id 1520
                type "Function Entry"
                (array)outputs {
                    - id=1580 name="Position" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1590 name="Duet" type="float" kind="data"
                }
            }
            - {
                id 1530
                type "Return"
                (array)inputs {
                    - id=1600 name="Value" type="float" kind="data"
                }
            }
            - {
                id 1540
                type "Behavior Expression"
                reference_name "mix(0.075, 1, smoothstep(0.78, 1.65, max(mix(abs(Position.x), abs(abs(Position.x) - 254), Duet) / 148, abs(Position.y - 20) / 268)))"
                inputs {
                    Position id=1550 type="struct" type_name="ShaderVec3"
                    Duet id=1560 type="float"
                }
                outputs {
                    Result id=1570 type="float"
                }
            }
        }
        (array)edges {
            - from="1520.Position" to="1540.Position"
            - from="1520.Duet" to="1540.Duet"
            - from="1540.Result" to="1530.Value"
        }
    }
    - {
        id 1610
        kind "function"
        name "StagePalette"
        description "Nebula violet/cyan, incandescent copper disk, green/pink membranes and cold silver stellar streams."
        entry_id 1620
        return_id 1630
        call_depth_limit 64
        (array)nodes {
            - {
                id 1620
                type "Function Entry"
                (array)outputs {
                    - id=1680 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1690 name="Weights" type="struct" type_name="ShaderVec4" kind="data"
                }
            }
            - {
                id 1630
                type "Return"
                (array)inputs {
                    - id=1700 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 1640
                type "Behavior Expression"
                reference_name "mix(vec3(0.2, 0.10, 0.85), vec3(0.20, 0.88, 1.12), Random.z) * Weights.x + mix(vec3(1.25, 0.84, 0.30), vec3(0.72, 0.15, 0.07), Random.y) * Weights.y + mix(vec3(0.12, 0.95, 0.57), vec3(0.90, 0.19, 0.54), Random.y) * Weights.z + mix(vec3(0.25, 0.52, 1.10), vec3(0.94, 1.02, 1.18), Random.z) * Weights.w"
                inputs {
                    Random id=1650 type="struct" type_name="ShaderVec3"
                    Weights id=1660 type="struct" type_name="ShaderVec4"
                }
                outputs {
                    Result id=1670 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="1620.Random" to="1640.Random"
            - from="1620.Weights" to="1640.Weights"
            - from="1640.Result" to="1630.Value"
        }
    }
    - {
        id 1710
        kind "function"
        name "CloudDensity"
        description "A slowly advected 3D density field opens dark pockets inside the nebula."
        entry_id 1720
        return_id 1730
        call_depth_limit 64
        (array)nodes {
            - {
                id 1720
                type "Function Entry"
                (array)outputs {
                    - id=1780 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1790 name="Phase" type="float" kind="data"
                }
            }
            - {
                id 1730
                type "Return"
                (array)inputs {
                    - id=1800 name="Value" type="float" kind="data"
                }
            }
            - {
                id 1740
                type "Behavior Expression"
                reference_name "smoothstep(0.18, 0.78, noise(Random * vec3(7, 4, 5) + vec3(Phase * 0.019, Phase * 0.013, 0), 1))"
                inputs {
                    Random id=1750 type="struct" type_name="ShaderVec3"
                    Phase id=1760 type="float"
                }
                outputs {
                    Result id=1770 type="float"
                }
            }
        }
        (array)edges {
            - from="1720.Random" to="1740.Random"
            - from="1720.Phase" to="1740.Phase"
            - from="1740.Result" to="1730.Value"
        }
    }
    - {
        id 1810
        kind "function"
        name "ParticleSize"
        description "A broad fixed size distribution preserves tiny grains and a few larger glints through depth."
        entry_id 1820
        return_id 1830
        call_depth_limit 64
        (array)nodes {
            - {
                id 1820
                type "Function Entry"
                (array)outputs {
                    - id=1890 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1900 name="Position" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1910 name="Weights" type="struct" type_name="ShaderVec4" kind="data"
                }
            }
            - {
                id 1830
                type "Return"
                (array)inputs {
                    - id=1920 name="Value" type="float" kind="data"
                }
            }
            - {
                id 1840
                type "Behavior Expression"
                reference_name "(0.3 + 1.9 * pow(Random.z, 5)) * max(0.7, (1080 - Position.z) / 2300) * (Weights.x * 1.18 + Weights.y * 0.8 + Weights.z * 0.92 + Weights.w * 0.64)"
                inputs {
                    Random id=1850 type="struct" type_name="ShaderVec3"
                    Position id=1860 type="struct" type_name="ShaderVec3"
                    Weights id=1870 type="struct" type_name="ShaderVec4"
                }
                outputs {
                    Result id=1880 type="float"
                }
            }
        }
        (array)edges {
            - from="1820.Random" to="1840.Random"
            - from="1820.Position" to="1840.Position"
            - from="1820.Weights" to="1840.Weights"
            - from="1840.Result" to="1830.Value"
