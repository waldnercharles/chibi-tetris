    - {
        id 1450
        kind "function"
        name "StagePalette"
        description "Turquoise/plum, copper/rose, blue/ice and violet/mint follow the same stage blend."
        entry_id 1460
        return_id 1470
        call_depth_limit 64
        (array)nodes {
            - {
                id 1460
                type "Function Entry"
                (array)outputs {
                    - id=1480 name="Random" type="struct" type_name="ShaderVec3" kind="data"
                    - id=1490 name="Weights" type="struct" type_name="ShaderVec4" kind="data"
