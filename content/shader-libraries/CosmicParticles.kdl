    - {
        id 1270
        kind "function"
        name "BoardProjection"
        description "Project distant particles onto the board plane from the authored camera."
        entry_id 1280
        return_id 1290
        call_depth_limit 64
        (array)nodes {
            - {
                id 1280
                type "Function Entry"
                (array)outputs {
                    - id=1300 name="Position" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 1290
                type "Return"
                (array)inputs {
                    - id=1310 name="Value" type="struct" type_name="ShaderVec3" kind="data"
                }
            }
            - {
                id 1320
                type "Behavior Expression"
                reference_name "vec3((Position.x - 90) * 1080 / max(1080 - Position.z, 1) + 90, (Position.y - 50) * 1080 / max(1080 - Position.z, 1) + 50, 0)"
                inputs {
                    Position id=1330 type="struct" type_name="ShaderVec3"
                }
