version 3
name "ReactionParticles"
domain "shader-library"
id_counter 200000
description "Layered instanced solids at captured block surfaces. Logarithmic burst timing, drag, ballistic contact flecks and compact descending packets share continuous birth and death envelopes."
(array)graphs {
    - kind="event" name="Functions"
    - {
        id 10
        kind "function"
        name "Cue"
        entry_id 11
        return_id 12
        (array)nodes {
            - {
                id 11
                type "Function Entry"
                (array)outputs {
                    - id=100 name="Index" type="float" kind="data"
