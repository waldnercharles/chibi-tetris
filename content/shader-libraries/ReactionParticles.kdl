version 3
name "ReactionParticles"
domain "shader-library"
id_counter 1000000
description "Captured 3D contact cues and independent clear releases. Fracture fronts, lit tumbling fragments, flowing microembers and expanding energy use fixed instanced fields with continuous envelopes and analytic drag."
(array)graphs {
    - kind="event" name="Functions"
    - {
        id 10
        kind "function"
        name "Cue"
        entry_id 11
        return_id 12
        (array)nodes {
            - {
                id 11
