                inputs {
                    cell id=1201 type="float"
                    p0 id=1202 type="struct" type_name="ShaderVec3"
                    p1 id=1203 type="struct" type_name="ShaderVec3"
                    p2 id=1204 type="struct" type_name="ShaderVec3"
                    p3 id=1205 type="struct" type_name="ShaderVec3"
