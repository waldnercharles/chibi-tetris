// Immutable until the queue wraps. Payload is captured at the action site.
component ReactionEvent {
    next: entity
    serial: int
    kind: int
    result: int
    x: number
    y: number
    direction: int
    amount: int
    detail: int
    // Occupied horizontal span at the action, before a drop spawns its successor.
    width: number
    // Offset from the recorded action pivot to the occupied horizontal center.
    center_offset: number
    // Occupied cell centers in world XY and rendered front-face Z, captured at the action.
    point0: CF_V3
    point1: CF_V3
    point2: CF_V3
    point3: CF_V3
}
