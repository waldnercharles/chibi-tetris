// Music analysis shared with the authored environment. Values are normalized.
component VisualState {
    energy: number
    bass: number
    mid: number
    treble: number
    beat: number
    // Measured onset spacing in seconds; .5 until repeated intervals agree.
    beat_period: number
    beat_confidence: number
    // Host-tracked phase is valid only while beat_tracking is true.
    beat_phase: number
    beat_tracking: bool
    // Integrated field motion remains continuous across audio and input changes.
    flow_phase: number
    flow_velocity: number
    flow_energy: number
    flow_turn: number
    // Exact bass, mid and treble controls sent to both particle shaders.
    field_bands: CF_V3
    // Exact energy, beat and chapter controls sent to both particle shaders.
    field_response: CF_V3
    // Four captured event positions/ages and their radial, swirl and lift forces.
    field_impulse0: CF_V3
    field_impulse1: CF_V3
    field_impulse2: CF_V3
    field_impulse3: CF_V3
    field_motion0: CF_V3
    field_motion1: CF_V3
    field_motion2: CF_V3
    field_motion3: CF_V3
    // Exact landing centers, ages and strengths sent to every particle field.
    field_wave0: CF_V3
    field_wave1: CF_V3
    field_wave2: CF_V3
    field_wave3: CF_V3
    field_wave_power01: CF_V2
    field_wave_power23: CF_V2
    // Continuous musical phase sent to both particle shaders.
    field_pulse: number
    // Cosmetic pool saturation; event queue loss is tracked separately.
    cue_overwrites: int
    // Rejected new cues when every pooled field is still visibly fading.
    cue_dropped: int
}
