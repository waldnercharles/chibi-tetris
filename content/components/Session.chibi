// Shared session and user settings. Screen: 0 music, 1 play, 2 pause, 3 completed run.
component Session {
    screen: int
    mode: int
    won: bool
    disconnected: bool
    save_failed: bool
    goal: int
    chapter_lines: int
    audio_source: int
    audio_status: int
    // Commands: 0 none, 1 play with game score, 2 connect audio.
    audio_request: int
    audio_return_screen: int
    // Ready after the host connects a stream or an explicit game-score choice.
    audio_ready: bool
    audio_signal: bool
    audio_quiet: bool
    run: int
    seed: int
    stage: int
    elapsed: number
    sprint_best: number
    rescue1: int
    rescue2: int
    charge: int
    das: number
    arr: number
    effects: int
    reduced_motion: bool
    ghost: bool
    master: number
    music: number
    sound: number
}
