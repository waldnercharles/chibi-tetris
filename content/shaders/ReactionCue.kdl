version 1
name "ReactionParticles.Cue"
kind "particle"
source "ReactionCue.glsl"
entry "cue"
update "advect"
(array)includes "ReactionCommon.glsl" "ParticleFlow.glsl"
parameters {
    Timing {
        type "vec3"
        (array)default 0.0 1.0 0.0
    }
    Character {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Action {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Pattern type="float" default=0.0
    Life type="float" default=0.0
    Hue type="float" default=0.0
    Pivot {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Point0 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Point1 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Point2 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Point3 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Origin {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Current {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Source0 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Source1 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Source2 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Source3 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Drive0 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Drive1 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Drive2 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Drive3 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Eye {
        type "vec3"
        (array)default 90.0 50.0 1080.0
    }
    Wave0 {
        type "vec3"
        (array)default 0.0 0.0 1.6
    }
    Wave1 {
        type "vec3"
        (array)default 0.0 0.0 1.6
    }
    Wave2 {
        type "vec3"
        (array)default 0.0 0.0 1.6
    }
    Wave3 {
        type "vec3"
        (array)default 0.0 0.0 1.6
    }
    WavePower01 {
        type "vec2"
        (array)default 0.0 0.0
    }
    WavePower23 {
        type "vec2"
        (array)default 0.0 0.0
    }
}
