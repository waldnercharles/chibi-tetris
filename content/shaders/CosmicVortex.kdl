version 1
name "CosmicParticles.Vortex"
kind "particle"
source "CosmicVortex.glsl"
entry "vortex"
update "advect"
(array)includes "CosmicForms.glsl" "CosmicCommon.glsl" "ParticleFlow.glsl"
parameters {
    Character {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Energy type="float" default=0.0
    Bass type="float" default=0.0
    Mid type="float" default=0.0
    Treble type="float" default=0.0
    Beat type="float" default=0.0
    Reaction type="float" default=0.0
    Section type="float" default=0.0
    Flow type="float" default=0.0
    Style type="float" default=0.0
    Variation type="float" default=0.0
    Duet type="float" default=0.0
    Pulse type="float" default=0.0
    Wind type="float" default=0.0
    Source0 {
        type "vec3"
        (array)default 0.0 0.0 2.6
    }
    Source1 {
        type "vec3"
        (array)default 0.0 0.0 2.6
    }
    Source2 {
        type "vec3"
        (array)default 0.0 0.0 2.6
    }
    Source3 {
        type "vec3"
        (array)default 0.0 0.0 2.6
    }
    Drive0 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Drive1 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Drive2 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Drive3 {
        type "vec3"
        (array)default 0.0 0.0 0.0
    }
    Eye {
        type "vec3"
        (array)default 90.0 50.0 1080.0
    }
    Wave0 {
        type "vec3"
        (array)default 0.0 0.0 1.6
    }
    Wave1 {
        type "vec3"
        (array)default 0.0 0.0 1.6
    }
    Wave2 {
        type "vec3"
        (array)default 0.0 0.0 1.6
    }
    Wave3 {
        type "vec3"
        (array)default 0.0 0.0 1.6
    }
    WavePower01 {
        type "vec2"
        (array)default 0.0 0.0
    }
    WavePower23 {
        type "vec2"
        (array)default 0.0 0.0
    }
}
