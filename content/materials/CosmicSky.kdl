    }
    - id=10000 kind="function" math_expression="mix(vec3(0.00012, 0.00015, 0.00055), mix(vec3(0.0005, 0.0016, 0.0037), vec3(0.0031, 0.0005, 0.0068), smoothstep(-1700, 1800, Position.x)), smoothstep(500, 2400, length(Position.xy * vec2(0.72, 1))))" expression_mode=1 entry_id=11000
