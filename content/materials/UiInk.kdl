version 3
name "UiInk"
domain "material"
id_counter 20000
description "Neutral unlit 3D interface lettering with controlled opacity."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 100
                type "Shader Surface Output"
                inputs Roughness=1.0 Unlit=#true
            }
            - {
                id 300
                type "Behavior Expression"
                reference_name "vec3(Shade, Shade, Shade)"
                inputs {
                    Shade id=303 type="float"
                }
                outputs {
                    Result id=302 type="struct" type_name="ShaderVec3"
                }
            }
            - {
                id 400
                type "Shader Parameter"
                reference_id 1
                reference_name "Shade"
                outputs Value=0.75
            }
            - {
                id 500
                type "Shader Parameter"
                reference_id 2
                reference_name "Opacity"
                outputs Value=1.0
            }
        }
        (array)edges {
            - from="300.Result" to="100.Base Color"
            - from="400.Value" to="300.Shade"
            - from="500.Value" to="100.Opacity"
        }
    }
    - id=10000 kind="function" math_expression="vec3(Shade, Shade, Shade)" expression_mode=1 entry_id=11000
}
