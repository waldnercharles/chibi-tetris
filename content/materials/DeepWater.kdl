version 3
name "DeepWater"
domain "material"
id_counter 200000
description "A quiet depth gradient and broad caustic wisps live on the enclosing 3D water volume. World-space patterns remain still when motion is reduced."
(array)graphs {
    - {
        kind "event"
        name ""
        (array)nodes {
            - {
                id 100
                type "Shader Surface Output"
                inputs Roughness=1.0 Unlit=#true "Alpha Mode"=1
            }
            - id=200 type="Shader WorldPosition"
            - {
                id 1000
                type "Behavior Expression"
                reference_name "smoothstep(-700, 900, position.y)"
                inputs {
                    position id=1100 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=1200 type="float"
                }
            }
            - {
                id 2000
                type "Behavior Expression"
                reference_name "noise(position * vec3(0.002, 0.004, 0.001), 1)"
                inputs {
                    position id=2100 type="struct" type_name="ShaderVec3"
                }
                outputs {
                    Result id=2200 type="float"
                }
            }
            - {
                id 3000
                type "Behavior Expression"
                reference_name "smoothstep(0.76, 0.98, 0.5 + 0.5 * sin(position.y * 0.015 + broad * 7 + position.x * 0.0015)) * smoothstep(300, 1200, abs(position.x))"
                inputs {
                    position id=3100 type="struct" type_name="ShaderVec3"
                    broad id=3200 type="float"
                }
                outputs {
                    Result id=3300 type="float"
                }
            }
            - {
                id 4000
                type "Behavior Expression"
                reference_name "mix(vec3(0.0006, 0.0018, 0.008), mix(vec3(0.003, 0.028, 0.046), vec3(0.020, 0.008, 0.037), smoothstep(-700, 1300, position.x)), altitude) + vec3(0.002, 0.014, 0.022) * wisp * altitude"
                inputs {
                    position id=4100 type="struct" type_name="ShaderVec3"
                    altitude id=4200 type="float"
                    wisp id=4300 type="float"
                }
                outputs {
                    Result id=4400 type="struct" type_name="ShaderVec3"
                }
            }
        }
        (array)edges {
            - from="200.Value" to="1000.position"
            - from="200.Value" to="2000.position"
            - from="200.Value" to="3000.position"
            - from="200.Value" to="4000.position"
            - from="1000.Result" to="4000.altitude"
            - from="2000.Result" to="3000.broad"
            - from="3000.Result" to="4000.wisp"
            - from="4000.Result" to="100.Base Color"
        }
    }
    - id=101000 kind="function" math_expression="smoothstep(-700, 900, position.y)" expression_mode=1 entry_id=151000
    - id=102000 kind="function" math_expression="noise(position * vec3(0.002, 0.004, 0.001), 1)" expression_mode=1 entry_id=152000
    - id=103000 kind="function" math_expression="smoothstep(0.76, 0.98, 0.5 + 0.5 * sin(position.y * 0.015 + broad * 7 + position.x * 0.0015)) * smoothstep(300, 1200, abs(position.x))" expression_mode=1 entry_id=153000
    - id=104000 kind="function" math_expression="mix(vec3(0.0006, 0.0018, 0.008), mix(vec3(0.003, 0.028, 0.046), vec3(0.020, 0.008, 0.037), smoothstep(-700, 1300, position.x)), altitude) + vec3(0.002, 0.014, 0.022) * wisp * altitude" expression_mode=1 entry_id=154000
}
