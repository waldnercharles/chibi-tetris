// Authored 3D light currents. Transform places X/Z; elevation supplies Y.
// Fixed entity pools keep chapter changes and input responses allocation-free.
behavior Environment {
    world: entity
    boards: entity[]
    motes: entity[]
    ribbons: entity[]
    comets: entity[]
    streams: entity[]
    bursts: entity[]
    clear_serial: int[] = [0, 0]
    drop_serial: int[] = [0, 0]
    rotate_serial: int[] = [0, 0]
    hold_serial: int[] = [0, 0]
    move_serial: int[] = [0, 0]
    pieces: int[] = [0, 0]
    run: int = -1
    burst_slot: int = 0
    streams_started := false
    ready := false
    time := 0
    mood := 0
    homeward := 0
    reaction := 0
    red := 0.008
    green := 0.37
    blue := 0.72
    energy := 0
    bass := 0
    treble := 0
    beat := 0

    function Color(r: number, g: number, b: number, a: number) -> (value: uint) {
        rr := cast<uint>(cast<int>(round(clamp(r, 0, 1) * 255)))
        gg := cast<uint>(cast<int>(round(clamp(g, 0, 1) * 255)))
        bb := cast<uint>(cast<int>(round(clamp(b, 0, 1) * 255)))
        aa := cast<uint>(cast<int>(round(clamp(a, 0, 1) * 255)))
        return rr << 24 | gg << 16 | bb << 8 | aa
    }

    function Sample(index: int, salt: number) -> (value: number) {
        return fract(sin(cast<number>(index) * 127.1 + salt * 311.7) * 43758.5453)
    }

    // Ocean crests become interwoven currents, a polar curtain, then a star orbit.
    function Path(fraction: number, lane: number) -> (x: number, y: number, z: number) {
        ocean := clamp(1 - mood, 0, 1)
        polar := clamp(mood - 1, 0, 1)
        current := 1 - ocean - polar
        angle := fraction * pi * 2 + time * 0.12 + lane * 0.7
        wave := fraction * pi * 3 + time * 0.16 + lane * 0.6
        x = (fraction - 0.5) * 2200 * ocean
        x += cos(angle) * (490 + lane * 54) * current
        x += (fraction - 0.5) * 2050 * polar
        y = (-170 + lane * 70 + sin(wave) * 105) * ocean
        y += (sin(angle) * (360 + lane * 22) - 30) * current
        y += (200 + lane * 48 + sin(wave * 1.6) * 110) * polar
        z = -430 - lane * 110 + cos(wave * 0.6) * 95
        z += sin(angle) * 180 * current
        x += (cos(angle) * (680 + lane * 74) - x) * homeward
        y += (sin(angle) * (420 + lane * 28) - y) * homeward
        z += (-570 - lane * 120 + sin(angle * 2) * 220 - z) * homeward
        return (x, y, z)
    }

    function Tint(item: entity, alpha: number, glow: number, warm: number) {
        r := red + (0.42 - red) * warm
        g := green + (0.016 - green) * warm
        b := blue + (0.8 - blue) * warm
        if warm > 0.48 {
            r = 0.85
            g = 0.36
            b = 0.018
        }
        item.Material.scene = Color(r * 0.18, g * 0.18, b * 0.18, alpha)
        item.Material.emission_color = Color(r, g, b, 1)
        item.Material.emission_intensity = glow
    }

    on Begin {
        world = get_global_variable("World")
        boards = [get_global_variable("Board1"), get_global_variable("Board2")]
        for i in 0..143 {
            mote := await spawn(EnvMote)
            motes = array_add(motes, mote)
        }
        for i in 0..71 {
            ribbon := await spawn(EnvRibbon)
            ribbons = array_add(ribbons, ribbon)
        }
        for i in 0..11 {
            comet := await spawn(EnvComet)
            comets = array_add(comets, comet)
        }
        for i in 0..7 {
            stream := await spawn(EnvStream)
            streams = array_add(streams, stream)
            burst := await spawn(EnvBurst)
            bursts = array_add(bursts, burst)
        }
        mood = clamp(cast<number>(world.Session.stage) / 2, 0, 2)
        homeward = clamp(cast<number>(world.Session.stage) - 4, 0, 1)
        ready = true
    }

    function Burst(board: entity, count: int, strength: number) {
        reaction = min(1, reaction + strength)
        if world.Session.effects == 0 || world.Session.reduced_motion {
            return
        }
        burst := get(bursts, burst_slot)
        burst_slot = (burst_slot + 1) % 8
        burst.Transform = vec2(board.BoardState.impact_x, 22)
        burst.ParticleEmitter.offset = vec3(0, board.BoardState.impact_y, 0)
        burst.ParticleEmitter.color = Color(red * 0.6 + 0.015, green * 0.8 + 0.08, 1, 1)
        burst.ParticleEmitter.end_color = Color(red, green, blue, 0)
        if world.Session.effects == 1 {
            count = max(3, count / 3)
        }
        burst.ParticleEmitter.burst_count = count
        burst.ParticleEmitter.active = true
        burst.PointLight.color = Color(red, green, blue, 1)
        burst.PointLight.elevation = board.BoardState.impact_y
        burst.PointLight.intensity = min(2.5, strength * 5)
    }

    function Events(dt: number) {
        fresh := run != world.Session.run
        for i in 0..7 {
            burst := get(bursts, i)
            burst.ParticleEmitter.active = false
            burst.PointLight.intensity = max(0, burst.PointLight.intensity - dt * 7)
            if fresh || world.Session.effects == 0 || world.Session.reduced_motion {
                burst.PointLight.intensity = 0
            }
        }
        for i in 0..1 {
            board := get(boards, i)
            playing := (world.Session.screen == 1 || world.Session.screen == 3) && !fresh
            if i == 1 && world.Session.mode != 3 {
                playing = false
            }
            if playing {
                if board.BoardState.clear_serial > get(clear_serial, i) {
                    Burst(board, 28 + board.BoardState.last_clear * 16, 0.35 + cast<number>(board.BoardState.last_clear) * 0.14)
                }
                if board.BoardState.drop_serial > get(drop_serial, i) {
                    Burst(board, 12 + cast<int>(min(board.BoardState.drop_distance, 20)), 0.24)
                }
                if board.BoardState.rotate_serial > get(rotate_serial, i) {
                    Burst(board, 5, 0.025)
                }
                if board.BoardState.hold_serial > get(hold_serial, i) {
                    Burst(board, 12, 0.08)
                }
                if board.BoardState.move_serial > get(move_serial, i) {
                    Burst(board, 3, 0.01)
                }
                if board.BoardState.pieces > get(pieces, i) && board.BoardState.drop_serial == get(drop_serial, i) && board.BoardState.clear_serial == get(clear_serial, i) {
                    Burst(board, 10, 0.07)
                }
            }
            clear_serial[i] = board.BoardState.clear_serial
            drop_serial[i] = board.BoardState.drop_serial
            rotate_serial[i] = board.BoardState.rotate_serial
            hold_serial[i] = board.BoardState.hold_serial
            move_serial[i] = board.BoardState.move_serial
            pieces[i] = board.BoardState.pieces
        }
        run = world.Session.run
    }

    function DrawMotes(effects: int) {
        for i in 0..143 {
            mote := get(motes, i)
            mote.RenderState.hidden = effects < 2 && i >= 72
            fraction := Sample(i, 1)
            lane := Sample(i, 2) * 3
            path := Path(fraction, lane)
            drift := sin(time * (0.08 + Sample(i, 3) * 0.12) + fraction * 24)
            mote.Transform = vec2(path.x + drift * 52, path.z - Sample(i, 4) * 560)
            mote.Geometry3D.elevation = path.y + (Sample(i, 5) - 0.5) * 410
            size := 1.1 + Sample(i, 6) * 2.6
            mote.VisualTransform.scale = size * (1 + beat * 0.14)
            mote.VisualTransform.pitch = time * 0.15 + fraction * pi
            Tint(mote, 0.68 + Sample(i, 7) * 0.28, 1.55 + treble * 0.85, Sample(i, 8) * 0.6)
        }
    }

    function DrawRibbons(effects: int) {
        for i in 0..71 {
            ribbon := get(ribbons, i)
            lane := cast<number>(i / 24)
            fraction := cast<number>(i % 24) / 23
            path := Path(fraction, lane)
            next := Path(fraction + 0.01, lane)
            ribbon.Transform = vec2(path.x, path.z)
            ribbon.Geometry3D.elevation = path.y
            ribbon.VisualTransform.pitch = atan2(next.y - path.y, next.x - path.x)
            ribbon.Geometry3D.width = sqrt((next.x - path.x) * (next.x - path.x) + (next.y - path.y) * (next.y - path.y)) * 4.8
            curtain := clamp(mood - 1, 0, 1) * (1 - homeward)
            ribbon.Geometry3D.height = 6 + curtain * (18 + 34 * sin(fraction * pi))
            ribbon.Geometry3D.depth = 12 + curtain * 9
            ribbon.RenderState.hidden = effects == 0 && lane > 0
            taper := sin(fraction * pi)
            Tint(ribbon, (0.2 + taper * 0.25) * (1 + energy * 0.12), 0.95 + bass * 0.35 + reaction * 0.4, lane * 0.22)
        }
    }

    function DrawComets(moving: bool, effects: int) {
        for i in 0..11 {
            comet := get(comets, i)
            angle := time * (0.1 + cast<number>(i % 3) * 0.017) + cast<number>(i) * pi / 6
            radius := 420 + cast<number>(i % 4) * 92
            comet.Transform = vec2(cos(angle) * radius, -240 - cast<number>(i % 3) * 170 + sin(angle) * 80)
            comet.Geometry3D.elevation = sin(angle) * (radius * 0.7) + cos(angle * 2) * 65
            comet.Trail.color = Color(red, green, blue, 0.42)
            comet.Trail.width = 1.2 + bass * 0.7
            comet.Trail.emission = 0.85 + energy * 0.7
            if !moving {
                comet.Trail.width = 0
            }
            comet.RenderState.hidden = effects == 0 || effects == 1 && i >= 4
            Tint(comet, 0.75, 1.3 + beat * 0.4, cast<number>(i % 3) * 0.2)
        }
    }

    function DrawStreams(moving: bool, effects: int) {
        for i in 0..7 {
            stream := get(streams, i)
            // Closed easing keeps source velocity finite at each end of an open current.
            fraction := 0.5 - 0.5 * cos(time * 0.026 + cast<number>(i) * pi / 4)
            lane := cast<number>(i % 3)
            path := Path(fraction, lane)
            next := Path(fraction + 0.025, lane)
            stream.Transform = vec2(path.x, path.z - 65)
            stream.ParticleEmitter.offset = vec3(0, path.y, 0)
            stream.ParticleEmitter.direction = vec3(next.x - path.x, next.y - path.y + 16, next.z - path.z)
            stream.ParticleEmitter.color = Color(red, green, blue, 0.88)
            stream.ParticleEmitter.end_color = Color(red * 0.5, green * 0.6, blue, 0)
            // Leave room under the engine's 2,048-particle cap for input bursts.
            stream.ParticleEmitter.rate = 30 + energy * 6 + reaction * 6
            stream.ParticleEmitter.burst_count = 0
            if !streams_started {
                stream.ParticleEmitter.burst_count = 64
            }
            stream.ParticleEmitter.active = moving
            if effects == 1 {
                stream.ParticleEmitter.rate = 12
            }
        }
        streams_started = true
    }

    on Tick(dt) {
        if !ready {
            return
        }
        delta := min(dt, 0.05)
        effects := world.Session.effects
        moving := !world.Session.reduced_motion && effects > 0
        paused := world.Session.screen == 2
        if moving && !paused {
            time += delta * (0.7 + energy * 0.25)
        }
        target := clamp(cast<number>(world.Session.stage) / 2, 0, 2)
        home := clamp(cast<number>(world.Session.stage) - 4, 0, 1)
        mood += clamp(target - mood, -delta * 0.35, delta * 0.35)
        homeward += clamp(home - homeward, -delta * 0.35, delta * 0.35)
        if !moving {
            mood = target
            homeward = home
        }
        blend := min(1, delta * 2)
        red += (0.008 + clamp(mood - 0.5, 0, 1.5) * 0.25 - red) * blend
        green += (0.37 - clamp(mood - 1, 0, 1) * 0.22 + homeward * 0.15 - green) * blend
        blue += (0.72 - blue) * blend
        energy += (clamp(world.VisualState.energy, 0, 1) - energy) * min(1, delta * 8)
        bass += (clamp(world.VisualState.bass, 0, 1) - bass) * min(1, delta * 9)
        treble += (clamp(world.VisualState.treble, 0, 1) - treble) * min(1, delta * 7)
        beat += (clamp(world.VisualState.beat, 0, 1) - beat) * min(1, delta * 12)
        if !moving {
            energy = 0
            bass = 0
            treble = 0
            beat = 0
        }
        reaction = max(0, reaction - delta * 1.8)
        Events(delta)
        self.Environment.bloom_strength = 0.3 + energy * 0.035 + reaction * 0.05
        if effects == 0 || world.Session.reduced_motion {
            self.Environment.bloom_strength = 0.22
        }
        DrawMotes(effects)
        DrawRibbons(effects)
        DrawComets(moving && !paused, effects)
        DrawStreams(moving && !paused, effects)
    }
}
