// Two GPU fields carry the scenery. Small fixed pools hold record geometry and
// local lights; no particle creates an entity or runs a behavior of its own.
behavior Environment {
    world: entity
    vortex: entity
    stars: entity
    boards: entity[]
    fields: entity[]
    lights: entity[]
    lives: number[]
    retires: number[]
    light_ages: number[]
    light_peaks: number[]
    light_delays: number[]
    cursors: entity[]
    sequences: int[] = [0, 0, 0]
    runs: int[] = [-1, -1, -1]
    slot: int = 0
    light_slot: int = 0
    ready := false
    time := 0
    reaction := 0
    impulse := 0
    flow := 0
    flow_velocity := 0.16
    turn := 0
    turn_velocity := 0
    energy := 0
    bass := 0
    mid := 0
    treble := 0
    beat := 0
    chapter := 0
    onset_ready := true
    onset_cooldown := 0
    visual_run: int = -1
    quality: int = -1
    was_moving := true
    cue_point0 := vec3(0, 0, 10.5)
    cue_point1 := vec3(0, 0, 10.5)
    cue_point2 := vec3(0, 0, 10.5)
    cue_point3 := vec3(0, 0, 10.5)
    cue_delay := 0
    cue_depth := 0

    on Begin {
        world = get_global_variable("World")
        vortex = get_global_variable("Vortex")
        stars = get_global_variable("Stars")
        boards = [get_global_variable("Board1"), get_global_variable("Board2"), world]
        cursors = [world, world, world]
        for i in 0..95 {
            field := await spawn(ReactionField)
            fields = array_add(fields, field)
            lives = array_add(lives, 0)
            retires = array_add(retires, -1)
        }
        for i in 0..7 {
            light := await spawn(ReactionLight)
            lights = array_add(lights, light)
            light_ages = array_add(light_ages, 1)
            light_peaks = array_add(light_peaks, 0)
            light_delays = array_add(light_delays, 0)
        }
        ready = true
    }

    // Lights use the same delayed arrival as contact geometry. A live light is
    // never moved to another impact; its intensity reaches zero before reuse.
    function Glow(position: CF_V3, strength: number, hue: number, delay: number) {
        if world.Session.effects == 0 || world.Session.reduced_motion {
            return
        }
        available := false
        for offset in 0..7 {
            candidate := (light_slot + offset) % 8
            if get(light_ages, candidate) >= 0.3 + get(light_delays, candidate) {
                light_slot = candidate
                available = true
                break
            }
        }
        if !available {
            return
        }
        light := get(lights, light_slot)
        light.Transform = vec2(position.x, position.z)
        light.PointLight.elevation = position.y
        light.PointLight.radius = 64 + strength * 40
        light.PointLight.intensity = 0
        light.PointLight.color = cast<uint>(102) << 24 | cast<uint>(198) << 16 | cast<uint>(230) << 8 | cast<uint>(255)
        if hue > 0.5 {
            light.PointLight.color = cast<uint>(171) << 24 | cast<uint>(110) << 16 | cast<uint>(222) << 8 | cast<uint>(255)
        }
        if hue > 1.5 {
            light.PointLight.color = cast<uint>(246) << 24 | cast<uint>(147) << 16 | cast<uint>(69) << 8 | cast<uint>(255)
        }
        light_ages[light_slot] = 0
        light_delays[light_slot] = delay
        light_peaks[light_slot] = min(1.2, strength)
        light_slot = (light_slot + 1) % 8
    }

    function Light(x: number, y: number, strength: number, hue: number) {
        Glow(vec3(x, y, 8), strength, hue, 0)
    }

    // A mode change releases existing grains over 60ms instead of hiding them.
    function Retire() {
        for i in 0..95 {
            field := get(fields, i)
            if field.ParticleField3D.count > 0 && get(retires, i) < 0 {
                retires[i] = 0.06
            }
        }
    }

    // Events add velocity; the shared flow retains position and momentum.
    function Push(strength: number, direction: number) {
        if world.Session.effects == 0 || world.Session.reduced_motion {
            return
        }
        impulse = min(1, impulse + strength)
        flow_velocity = min(3, flow_velocity + strength * 1.2)
        turn_velocity = clamp(turn_velocity + direction * strength, -0.8, 0.8)
    }

    // Patterns: fracture, move edge, tangential turn, soft fall, contact,
    // fracture front, hold, blocked edge, descending packets, clear debris,
    // microembers and expanding energy. These are fixed instanced fields.
    function Cue(pattern: int, x: number, y: number, direction: int, travel: int, strength: number, life: number, hue: number) {
        available := false
        for offset in 0..95 {
            candidate := (slot + offset) % 96
            item := get(fields, candidate)
            if item.ParticleField3D.count == 0 {
                slot = candidate
                available = true
                break
            }
        }
        if !available {
            world.VisualState.cue_dropped += 1
            return
        }
        field := get(fields, slot)
        quiet := world.Session.reduced_motion || world.Session.effects == 0
        count: int = 24
        match (pattern) {
            case 0 {
                count = 80
            }
            case 1 {
                count = 16
            }
            case 2 {
                count = 48
            }
            case 3 {
                count = 20
            }
            case 4 {
                count = 56
            }
            case 5 {
                count = 320
            }
            case 6 {
                count = 32
            }
            case 7 {
                count = 12
            }
            case 8 {
                count = 112
            }
            case 9 {
                count = 96
            }
            case 10 {
                count = 2048
            }
            case 11 {
                count = 192
            }
        }
        if world.Session.effects == 1 {
            count = max(8, count / 2)
        }
        if quiet {
            count = 8
            life = 0.14
            cue_delay = 0
        }
        field.Transform3D.position = vec3(x, y, cue_depth)
        field.ParticleField3D.count = count
        field.ParticleField3D.additive = pattern != 9 || quiet
        field.ParticleField3D.seed += 37
        field.ParticleField3D.time = 0
        field.Shader.material = "ReactionParticles.Cue"
        if pattern == 5 || pattern >= 9 {
            field.Shader.material = "ReactionParticles.Release"
        }
        field.Geometry3D = { primitive: 5, width: 1, height: 1, depth: 0.8 }
        if pattern == 8 && !quiet {
            field.Geometry3D.height = 2.4
        }
        set_material_parameter(field, "Pattern", cast<number>(pattern))
        set_material_parameter(field, "Direction", cast<number>(direction))
        set_material_parameter(field, "Travel", cast<number>(travel))
        set_material_parameter(field, "Strength", strength)
        set_material_parameter(field, "Life", life)
        set_material_parameter(field, "Quiet", cast<number>(ReactionRules.Flag(quiet)))
        set_material_parameter(field, "Hue", hue)
        set_material_parameter(field, "Point0", cue_point0)
        set_material_parameter(field, "Point1", cue_point1)
        set_material_parameter(field, "Point2", cue_point2)
        set_material_parameter(field, "Point3", cue_point3)
        set_material_parameter(field, "Delay", cue_delay)
        set_material_parameter(field, "Fade", 1)
        lives[slot] = cue_delay + life
        retires[slot] = -1
        slot = (slot + 1) % 96
    }

    // The immutable row mask survives board collapse. Each row starts at its
    // captured block front, and owns independent clocks, fragments and light.
    function ClearRow(center: number, row: int, amount: int, front: number) {
        row_y := 276 - row * 24
        cue_point0 = vec3(0, 0, 0)
        cue_point1 = cue_point0
        cue_point2 = cue_point0
        cue_point3 = cue_point0
        cue_depth = front
        cue_delay = 0
        strength := 0.65 + cast<number>(amount) * 0.1
        Cue(5, center, row_y, 1, 0, strength, 0.24, 0.05)
        if world.Session.reduced_motion || world.Session.effects == 0 {
            return
        }
        cue_delay = 0.035
        Cue(9, center, row_y, 1, 0, strength, 0.95, 0.25)
        cue_delay = 0.055
        Cue(10, center, row_y, 1, 0, strength, 1.4, 0.1)
        cue_delay = 0.02
        Cue(11, center, row_y, 1, 0, strength, 0.6, 0.2)
        Glow(vec3(center, row_y, front + 2), 0.82 + cast<number>(amount) * 0.07, 0, 0.02)
    }

    function BoardEvent(board: entity, record: entity) {
        kind := record.ReactionEvent.kind
        x := record.ReactionEvent.x
        piece_x := x + record.ReactionEvent.center_offset
        y := record.ReactionEvent.y
        amount := record.ReactionEvent.amount
        direction := record.ReactionEvent.direction
        origin := vec3(x, y, 0)
        cue_point0 = record.ReactionEvent.point0 - origin
        cue_point1 = record.ReactionEvent.point1 - origin
        cue_point2 = record.ReactionEvent.point2 - origin
        cue_point3 = record.ReactionEvent.point3 - origin
        cue_delay = 0
        cue_depth = 0
        if record.ReactionEvent.result == 0 {
            Cue(7, x, y, direction, 0, 0.06, 0.16, 2)
            return
        }
        match (kind) {
            case 1 {
                Cue(1, x, y, direction, 0, 0.04, 0.18, 0)
                Push(0.12, cast<number>(direction))
            }
            case 2 {
                Cue(2, x, y, direction, 0, 0.16, 0.28, 0.25)
                Push(0.22, cast<number>(direction) * 1.5)
            }
            case 3 {
                Cue(3, x, y, 1, 0, 0.06, 0.18, 0)
                Push(0.1, 0)
            }
            case 4 {
                Cue(3, x, y, 1, amount, 0.04, 0.18, 0)
                Push(0.07, 0)
            }
            case 5 {
                Cue(4, x, y, 1, 0, 0.06, 0.18, 0)
            }
            case 6 {
                quiet := world.Session.reduced_motion || world.Session.effects == 0
                if !quiet && amount > 0 {
                    Cue(8, x, y, 1, amount, 0.5, 0.26, 0)
                    cue_delay = 0.095
                }
                Cue(4, x, y - amount * 24, 1, 0, 0.45, 0.34, 0.1)
                low := min(min(cue_point0.y, cue_point1.y), min(cue_point2.y, cue_point3.y))
                front := (cue_point0.z + cue_point1.z + cue_point2.z + cue_point3.z) * 0.25
                Glow(vec3(piece_x, y + low - amount * 24 - 10.7, front + 2), 0.75, 0, cue_delay)
                Push(0.68, 0.22)
            }
            case 7 {
                Cue(6, x, y, -1, 0, 0.13, 0.24, 0.4)
                Push(0.2, -1)
            }
            case 8 {
                Cue(4, x, y, 1, 0, 0.14, 0.24, 0.1)
                Push(0.14, 0)
            }
            case 9 {
                center := 0
                if world.Session.mode == 3 {
                    center = -254 + board.BoardState.index * 508
                }
                mask := record.ReactionEvent.detail
                front := (record.ReactionEvent.point0.z + record.ReactionEvent.point1.z + record.ReactionEvent.point2.z + record.ReactionEvent.point3.z) * 0.25
                for row in 0..21 {
                    if (mask >> row & 1) != 0 {
                        ClearRow(center, row, amount, front)
                    }
                }
                Push(0.4 + cast<number>(amount) * 0.12, 0.4)
            }
            case 10 {
                // The row already owns its release. Combo adds light and force.
                Glow(vec3(piece_x, y, 10.5), 0.35, 0.4, 0.04)
                Push(0.25, 0.5)
            }
            case 11 {
                Cue(0, x, y, -1, 0, 0.65, 0.42, 2)
                Glow(vec3(piece_x, y, 10.5), 0.6, 2, 0)
                Push(0.7, -0.4)
            }
            case 12 {
                Cue(0, x, y, 1, 0, 0.7, 0.46, 0.2)
                Glow(vec3(piece_x, y, 10.5), 0.65, 0, 0)
                Push(1, 0.6)
            }
        }
    }

    function SessionEvent(record: entity) {
        cue_point0 = vec3(-6, 0, 10.5)
        cue_point1 = vec3(-2, 0, 10.5)
        cue_point2 = vec3(2, 0, 10.5)
        cue_point3 = vec3(6, 0, 10.5)
        cue_delay = 0
        cue_depth = 0
        kind := record.ReactionEvent.kind
        if record.ReactionEvent.result == 0 {
            Cue(7, 180, 270, 1, 0, 0.04, 0.16, 2)
            return
        }
        if kind == 15 || kind == 16 || kind == 17 || kind == 19 {
            Cue(4, -140, -228, 1, 0, 0.3, 0.3, 0.2)
            Cue(4, 140, -228, -1, 0, 0.3, 0.3, 0)
            Push(0.7, 0.3)
            return
        }
        Cue(1, 180, 270, 1, 0, 0.05, 0.18, 0.2)
    }

    function Events() {
        for i in 0..2 {
            source := get(boards, i)
            // A board publishes its new run before its first input record.
            if i < 2 && source.ReactionQueue.run != world.Session.run {
                continue
            }
            if get(runs, i) != source.ReactionQueue.run && i < 2 || get(runs, i) == -1 {
                sequences[i] = 0
                cursors[i] = source.ReactionQueue.first
                runs[i] = source.ReactionQueue.run
            }
            serial := get(sequences, i)
            newest := source.ReactionQueue.serial
            if newest - serial > 32 {
                source.ReactionQueue.dropped += newest - serial - 32
                serial = newest - 32
                cursors[i] = source.ReactionQueue.write
            }
            while serial < newest {
                record := get(cursors, i)
                if i == 2 {
                    SessionEvent(record)
                } else {
                    if i == 0 || world.Session.mode == 3 {
                        BoardEvent(source, record)
                    }
                }
                cursors[i] = record.ReactionEvent.next
                serial += 1
            }
            sequences[i] = newest
        }
    }

    function FieldAudio(field: entity) {
        field.ParticleField3D.time = time
        set_material_parameter(field, "Energy", world.VisualState.field_response.x)
        set_material_parameter(field, "Bass", world.VisualState.field_bands.x)
        set_material_parameter(field, "Mid", world.VisualState.field_bands.y)
        set_material_parameter(field, "Treble", world.VisualState.field_bands.z)
        set_material_parameter(field, "Beat", world.VisualState.field_response.y)
        set_material_parameter(field, "Reaction", world.VisualState.flow_energy)
        set_material_parameter(field, "Flow", flow)
        set_material_parameter(field, "Turn", turn)
    }

    on Tick(dt) {
        if !ready {
            return
        }
        delta := min(dt, 0.05)
        if visual_run != world.Session.run {
            visual_run = world.Session.run
            Retire()
            impulse = 0
        }
        effects := world.Session.effects
        moving := effects > 0 && !world.Session.reduced_motion
        advancing := moving && world.Session.screen < 2
        if advancing {
            time += delta
        }
        if !moving && was_moving {
            Retire()
        }
        was_moving = moving
        if quality != effects {
            quality = effects
            vortex.ParticleField3D.count = 131072
            stars.ParticleField3D.count = 16384
            if effects == 1 {
                vortex.ParticleField3D.count = 16384
                stars.ParticleField3D.count = 2048
            }
            if effects == 0 {
                vortex.ParticleField3D.count = 0
                stars.ParticleField3D.count = 512
            }
        }
        // Retain the entire shape when stopped, including musical deformation.
        if advancing {
            blend := 1 - exp(-delta * 4)
            energy += (world.VisualState.energy - energy) * blend
            bass += (world.VisualState.bass - bass) * blend
            mid += (world.VisualState.mid - mid) * blend
            treble += (world.VisualState.treble - treble) * blend
            beat += (world.VisualState.beat - beat) * (1 - exp(-delta * 5))
            chapter += (cast<number>(world.Session.stage) - chapter) * min(1, delta * 1.8)
        }
        impulse *= exp(-delta * 1.8)
        if !moving {
            impulse = 0
            turn_velocity = 0
        }
        for i in 0..95 {
            field := get(fields, i)
            if field.ParticleField3D.count > 0 {
                field.ParticleField3D.time += delta
                if get(retires, i) >= 0 {
                    retires[i] = max(0, get(retires, i) - delta)
                    fade := get(retires, i) / 0.06
                    set_material_parameter(field, "Fade", fade * fade * (3 - 2 * fade))
                    if get(retires, i) == 0 {
                        field.ParticleField3D.count = 0
                    }
                }
                if field.ParticleField3D.time >= get(lives, i) {
                    field.ParticleField3D.count = 0
                }
            }
        }
        for i in 0..7 {
            light := get(lights, i)
            light_ages[i] += delta
            age := max(0, get(light_ages, i) - get(light_delays, i))
            attack := clamp(age / 0.025, 0, 1)
            release := clamp((0.3 - age) / 0.275, 0, 1)
            intensity := get(light_peaks, i) * attack * attack * (3 - 2 * attack) * release * release * (3 - 2 * release)
            if !moving {
                light_peaks[i] = max(0, get(light_peaks, i) - delta * 10)
            }
            light.PointLight.intensity = intensity
        }
        Events()
        // Audio onsets release one pulse, then rearm after the envelope falls.
        onset_cooldown = max(0, onset_cooldown - delta)
        if world.VisualState.beat < 0.12 {
            onset_ready = true
        }
        if advancing && onset_ready && onset_cooldown == 0 && world.VisualState.beat > 0.25 {
            onset_ready = false
            onset_cooldown = 0.16
            Push(0.15 + bass * 0.18, 0)
            Light(-160, -40, bass * 0.35, 0)
            Light(160, 70, treble * 0.3, 1)
        }
        if advancing {
            reaction += (impulse - reaction) * (1 - exp(-delta * 5))
            flow_velocity += (0.16 + energy * 0.5 + bass * 0.65 + beat * 0.35 - flow_velocity) * (1 - exp(-delta * 1.6))
            turn_velocity *= exp(-delta * 1.4)
            flow += flow_velocity * delta
            turn += turn_velocity * delta
        }
        world.VisualState.flow_phase = flow
        world.VisualState.flow_velocity = flow_velocity
        world.VisualState.flow_energy = reaction
        world.VisualState.flow_turn = turn
        world.VisualState.field_bands = vec3(bass, mid, treble)
        world.VisualState.field_response = vec3(energy, beat, chapter)
        FieldAudio(vortex)
        FieldAudio(stars)
        self.Environment.bloom_strength = 0.3 + energy * 0.045 + reaction * 0.05
        if !moving {
            self.Environment.bloom_strength = 0.22
        }
    }
}
