// Two GPU fields carry the scenery. Small fixed pools hold record geometry and
// local lights; no particle creates an entity or runs a behavior of its own.
behavior Environment {
    world: entity
    vortex: entity
    stars: entity
    boards: entity[]
    fields: entity[]
    lights: entity[]
    lives: number[]
    cursors: entity[]
    sequences: int[] = [0, 0, 0]
    runs: int[] = [-1, -1, -1]
    slot: int = 0
    light_slot: int = 0
    ready := false
    time := 0
    reaction := 0
    energy := 0
    bass := 0
    mid := 0
    treble := 0
    beat := 0
    chapter := 0
    onset_ready := true
    onset_cooldown := 0
    visual_run: int = -1
    quality: int = -1
    was_moving := true

    on Begin {
        world = get_global_variable("World")
        vortex = get_global_variable("Vortex")
        stars = get_global_variable("Stars")
        boards = [get_global_variable("Board1"), get_global_variable("Board2"), world]
        cursors = [world, world, world]
        for i in 0..95 {
            field := await spawn(ReactionField)
            fields = array_add(fields, field)
            lives = array_add(lives, 0)
        }
        for i in 0..7 {
            light := await spawn(ReactionLight)
            lights = array_add(lights, light)
        }
        ready = true
    }

    function Light(x: number, y: number, strength: number, hue: number) {
        if world.Session.effects == 0 || world.Session.reduced_motion {
            return
        }
        light := get(lights, light_slot)
        light_slot = (light_slot + 1) % 8
        light.Transform = vec2(x, 35)
        light.PointLight.elevation = y
        light.PointLight.intensity = min(2.4, strength * 2)
        light.PointLight.color = cast<uint>(69) << 24 | cast<uint>(186) << 16 | cast<uint>(255) << 8 | cast<uint>(255)
        if hue > 0.5 {
            light.PointLight.color = cast<uint>(184) << 24 | cast<uint>(65) << 16 | cast<uint>(255) << 8 | cast<uint>(255)
        }
        if hue > 1.5 {
            light.PointLight.color = cast<uint>(255) << 24 | cast<uint>(146) << 16 | cast<uint>(43) << 8 | cast<uint>(255)
        }
    }

    // Patterns: sparks, dash, crescent, corridor, halo, row, hold, brackets.
    function Cue(pattern: int, x: number, y: number, direction: int, travel: int, strength: number, life: number, hue: number) {
        // Reuse expired cues first; only retire the oldest visible cue if full.
        oldest := slot
        oldest_age := -1
        available := false
        for offset in 0..95 {
            candidate := (slot + offset) % 96
            item := get(fields, candidate)
            if item.ParticleField3D.count == 0 {
                slot = candidate
                available = true
                break
            }
            age := item.ParticleField3D.time / max(get(lives, candidate), 0.01)
            if age > oldest_age {
                oldest = candidate
                oldest_age = age
            }
        }
        if !available {
            slot = oldest
            world.VisualState.cue_overwrites += 1
        }
        field := get(fields, slot)
        quiet := world.Session.reduced_motion || world.Session.effects == 0
        count: int = 64
        if strength >= 0.4 {
            count = 256
        }
        if strength >= 0.8 {
            count = 768
        }
        if world.Session.effects == 1 {
            count = max(24, count / 2)
        }
        if quiet {
            count = 24
            life = 0.08
        }
        field.Transform3D.position = vec3(x, y, 22)
        field.ParticleField3D.count = count
        field.ParticleField3D.seed += 37
        field.ParticleField3D.time = 0
        set_material_parameter(field, "Pattern", cast<number>(pattern))
        set_material_parameter(field, "Direction", cast<number>(direction))
        set_material_parameter(field, "Travel", cast<number>(travel))
        set_material_parameter(field, "Strength", strength)
        set_material_parameter(field, "Life", life)
        set_material_parameter(field, "Quiet", cast<number>(ReactionRules.Flag(quiet)))
        set_material_parameter(field, "Hue", hue)
        lives[slot] = life
        slot = (slot + 1) % 96
    }

    function BoardEvent(board: entity, record: entity) {
        kind := record.ReactionEvent.kind
        x := record.ReactionEvent.x
        y := record.ReactionEvent.y
        amount := record.ReactionEvent.amount
        direction := record.ReactionEvent.direction
        if record.ReactionEvent.result == 0 {
            Cue(7, x, y, direction, 0, 0.08, 0.1, 2)
            return
        }
        match (kind) {
            case 1 {
                Cue(1, x, y, direction, 0, 0.03, 0.1, 0)
            }
            case 2 {
                Cue(2, x, y, direction, 0, 0.1, 0.12, 1)
            }
            case 3 {
                Cue(3, x, y, 1, 2, 0.03, 0.1, 0)
            }
            case 4 {
                Cue(3, x, y, 1, max(1, amount), 0.05, 0.1, 0)
            }
            case 5 {
                Cue(4, x, y, 1, 0, 0.03, 0.08, 0)
            }
            case 6 {
                Cue(3, x, y, 1, amount, 0.45, 0.16, 0)
                Cue(4, x, y - amount * 24, 1, 0, 0.6, 0.2, 0.2)
                Light(x, y - amount * 24, 0.7, 0)
                reaction = min(1, reaction + 0.18)
            }
            case 7 {
                Cue(6, x, y, -1, 0, 0.2, 0.14, 1)
            }
            case 8 {
                Cue(4, x, y, 1, 0, 0.2, 0.12, 0.2)
                Light(x, y, 0.2, 0)
            }
            case 9 {
                center := 0
                if world.Session.mode == 3 {
                    center = -254 + board.BoardState.index * 508
                }
                mask := record.ReactionEvent.detail
                for row in 0..21 {
                    if (mask >> row & 1) != 0 {
                        Cue(5, center, 228 - (row - 2) * 24, 1, 0, 0.5 + cast<number>(amount) * 0.12, 0.22, 0.25)
                    }
                }
                Light(x, y, 0.5 + cast<number>(amount) * 0.2, 0)
                reaction = min(1, reaction + 0.3 + cast<number>(amount) * 0.1)
            }
            case 10 {
                for arc in 0..3 {
                    if arc < amount {
                        Cue(4, x, y + arc * 16, 1, 0, 0.4, 0.24, 1)
                    }
                }
                reaction = min(1, reaction + 0.2)
            }
            case 11 {
                Cue(0, x, y, -1, 0, 0.85, 0.3, 2)
                Light(x, y, 0.9, 2)
                reaction = 0.7
            }
            case 12 {
                Cue(0, x, 0, 1, 0, 1, 0.4, 0.4)
                Light(x, 0, 1, 0)
                reaction = 1
            }
        }
    }

    function SessionEvent(record: entity) {
        kind := record.ReactionEvent.kind
        hue := 0.2
        if record.ReactionEvent.result == 0 {
            Cue(7, 180, 270, 1, 0, 0.12, 0.1, 2)
            return
        }
        if kind == 15 || kind == 16 || kind == 17 || kind == 19 {
            Cue(4, -170, 0, 1, 0, 0.85, 0.28, 1)
            Cue(4, 170, 0, -1, 0, 0.85, 0.28, 0)
            reaction = 0.7
            return
        }
        Cue(2, 180, 270, 1, 0, 0.16, 0.12, hue)
    }

    function Events() {
        for i in 0..2 {
            source := get(boards, i)
            // A board publishes its new run before its first input record.
            if i < 2 && source.ReactionQueue.run != world.Session.run {
                continue
            }
            if get(runs, i) != source.ReactionQueue.run && i < 2 || get(runs, i) == -1 {
                sequences[i] = 0
                cursors[i] = source.ReactionQueue.first
                runs[i] = source.ReactionQueue.run
            }
            serial := get(sequences, i)
            newest := source.ReactionQueue.serial
            if newest - serial > 32 {
                source.ReactionQueue.dropped += newest - serial - 32
                serial = newest - 32
                cursors[i] = source.ReactionQueue.write
            }
            while serial < newest {
                record := get(cursors, i)
                if i == 2 {
                    SessionEvent(record)
                } else {
                    if i == 0 || world.Session.mode == 3 {
                        BoardEvent(source, record)
                    }
                }
                cursors[i] = record.ReactionEvent.next
                serial += 1
            }
            sequences[i] = newest
        }
    }

    function FieldAudio(field: entity) {
        field.ParticleField3D.time = time
        set_material_parameter(field, "Energy", energy)
        set_material_parameter(field, "Bass", bass)
        set_material_parameter(field, "Mid", mid)
        set_material_parameter(field, "Treble", treble)
        set_material_parameter(field, "Beat", beat)
        set_material_parameter(field, "Reaction", reaction)
        set_material_parameter(field, "Chapter", chapter)
    }

    on Tick(dt) {
        if !ready {
            return
        }
        delta := min(dt, 0.05)
        if visual_run != world.Session.run {
            visual_run = world.Session.run
            for i in 0..95 {
                field := get(fields, i)
                field.ParticleField3D.count = 0
                lives[i] = 0
            }
            for i in 0..7 {
                light := get(lights, i)
                light.PointLight.intensity = 0
            }
            reaction = 0
        }
        effects := world.Session.effects
        moving := effects > 0 && !world.Session.reduced_motion
        if moving && world.Session.screen != 2 {
            time += delta * (0.8 + energy * 0.28)
        }
        if !moving && was_moving {
            for i in 0..95 {
                field := get(fields, i)
                field.ParticleField3D.count = 0
            }
        }
        was_moving = moving
        if quality != effects {
            quality = effects
            vortex.ParticleField3D.count = 131072
            stars.ParticleField3D.count = 16384
            if effects == 1 {
                vortex.ParticleField3D.count = 16384
                stars.ParticleField3D.count = 2048
            }
            if effects == 0 {
                vortex.ParticleField3D.count = 0
                stars.ParticleField3D.count = 512
            }
        }
        blend := min(1, delta * 12)
        energy += (world.VisualState.energy - energy) * blend
        bass += (world.VisualState.bass - bass) * blend
        mid += (world.VisualState.mid - mid) * blend
        treble += (world.VisualState.treble - treble) * blend
        beat = max(world.VisualState.beat, beat - delta * 5.5)
        chapter += (cast<number>(world.Session.stage) - chapter) * min(1, delta * 1.8)
        reaction = max(0, reaction - delta * 2.8)
        if !moving {
            energy = 0
            bass = 0
            mid = 0
            treble = 0
            beat = 0
            reaction = 0
        }
        for i in 0..95 {
            field := get(fields, i)
            if field.ParticleField3D.count > 0 {
                field.ParticleField3D.time += delta
                if field.ParticleField3D.time >= get(lives, i) {
                    field.ParticleField3D.count = 0
                }
            }
        }
        for i in 0..7 {
            light := get(lights, i)
            light.PointLight.intensity = max(0, light.PointLight.intensity - delta * 9)
            if !moving {
                light.PointLight.intensity = 0
            }
        }
        Events()
        // Audio onsets release one pulse, then rearm after the envelope falls.
        onset_cooldown = max(0, onset_cooldown - delta)
        if world.VisualState.beat < 0.12 {
            onset_ready = true
        }
        if moving && world.Session.screen != 2 && onset_ready && onset_cooldown == 0 && world.VisualState.beat > 0.25 {
            onset_ready = false
            onset_cooldown = 0.16
            reaction = max(reaction, 0.14 + bass * 0.2)
            Light(-160, -40, bass * 0.35, 0)
            Light(160, 70, treble * 0.3, 1)
        }
        if !moving {
            reaction = 0
        }
        FieldAudio(vortex)
        FieldAudio(stars)
        self.Environment.bloom_strength = 0.3 + energy * 0.045 + reaction * 0.05
        if !moving {
            self.Environment.bloom_strength = 0.22
        }
    }
}
