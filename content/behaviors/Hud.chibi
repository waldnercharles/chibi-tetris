// Labels and numerals are extruded meshes in the same world as the board.
behavior Hud {
    world: entity
    board1: entity
    board2: entity
    labels: entity[] = []
    backings: entity[] = []
    timer_backing: entity
    panel: entity
    ready := false
    refresh := 0
    audio_source: int = -1
    audio_status: int = -1
    audio_signal := false
    audio_quiet := false
    hover_choice: int = -1
    pointer_choice: int = -1
    screen: int = -1
    world_serial: int = -1
    setting_serial: int = 0
    setting_kind: int = 0
    setting_value: int = 0
    setting_time := 0
    modes := ["journey", "endless", "sprint", "duet"]

    on Begin {
        world = get_global_variable("World")
        board1 = get_global_variable("Board1")
        board2 = get_global_variable("Board2")
        for i in 0..96 {
            label := await spawn(HudText)
            labels = array_add(labels, label)
        }
        for i in 0..1 {
            backing := await spawn(HudBacking)
            backings = array_add(backings, backing)
        }
        timer_backing = await spawn(HudBacking)
        timer_backing.Geometry3D.height = 140
        timer_backing.Transform3D.position = vec3(-205, -149, 42)
        panel = await spawn(HudPanel)
        ready = true
        Draw()
    }

    function Hide(slot: int) {
        label := get(labels, slot)
        label.RenderState.hidden = true
    }

    function Label(slot: int, name: string, x: number, y: number, size: number) {
        label := get(labels, slot)
        label.MeshAsset.source = format_text("content/meshes/text/{}.mesh", name)
        label.Transform3D.position = vec3(x, y, 46)
        label.Transform3D.scale = vec3(size, size, size)
        label.Material.scene = 0xdbe4e7ff
        label.Material.emission_intensity = 0.16
        label.RenderState.hidden = false
    }

    function ModalLabel(slot: int, name: string, x: number, y: number, size: number) {
        Label(slot, name, x, y, size)
        label := get(labels, slot)
        label.Transform3D.position = vec3(x, y, 70)
    }

    function Number(first: int, count: int, value: int, x: number, y: number, size: number) {
        value = max(0, value)
        divisor: int = 1
        digits: int = 1
        for i in 1..count - 1 {
            divisor *= 10
            if value >= divisor {
                digits = i + 1
            }
        }
        size = min(size, 140 / (cast<number>(digits) * 0.8))
        for i in 0..count - 1 {
            Hide(first + i)
            if value >= divisor || i == count - 1 {
                digit := value / divisor % 10
                Label(first + i, format_text("digit_{}", digit), x + (cast<number>(i - count + digits) - cast<number>(digits - 1) * 0.5) * size * 0.8, y, size)
            }
            divisor /= 10
        }
    }

    function BoardLabels(index: int, board: entity) {
        center := 0
        if world.Session.mode == 3 {
            center = -254 + index * 508
        }
        backing := get(backings, index)
        backing.Transform3D.position = vec3(center - 205, 2, 42)
        backing.RenderState.hidden = false
        offset := index * 4
        Label(3 + offset, "hold", center - 205, 235, 12)
        Label(4 + offset, "next", center + 190, 235, 12)
        Label(5 + offset, "score", center - 205, 45, 12)
        Label(6 + offset, "lines", center - 205, -12, 12)
        first := 20 + index * 20
        Number(first, 10, board.BoardState.score, center - 205, 18, 24)
        Number(first + 10, 10, board.BoardState.lines, center - 205, -40, 20)
    }

    function Time(first: int, seconds: number, x: number, y: number, size: number) {
        tenths := cast<int>(floor(max(0, seconds) * 10))
        minutes := tenths / 600
        digits: int = 1
        divisor: int = 10
        for i in 1..5 {
            if minutes >= divisor {
                digits = i + 1
            }
            divisor *= 10
        }
        size = min(size, 140 / (cast<number>(digits + 5) * 0.8))
        left := x - cast<number>(digits + 4) * size * 0.4
        Number(first, 6, minutes, left + cast<number>(digits - 1) * size * 0.4, y, size)
        Label(first + 6, "time_colon", left + cast<number>(digits) * size * 0.8, y, size)
        Label(first + 7, format_text("digit_{}", tenths / 100 % 6), left + cast<number>(digits + 1) * size * 0.8, y, size)
        Label(first + 8, format_text("digit_{}", tenths / 10 % 10), left + cast<number>(digits + 2) * size * 0.8, y, size)
        Label(first + 9, "time_decimal", left + cast<number>(digits + 3) * size * 0.8, y, size)
        Label(first + 10, format_text("digit_{}", tenths % 10), left + cast<number>(digits + 4) * size * 0.8, y, size)
    }

    function Choice(slot: int, name: string, choice: int, x: number, y: number, size: number) {
        ModalLabel(slot, name, x, y, size)
        label := get(labels, slot)
        label.Material.scene = 0xaebec7ff
        if hover_choice == choice {
            label.Material.scene = 0xd2edf5ff
            label.Material.emission_intensity = 0.28
        }
    }

    function DrawConnection() {
        panel.Geometry3D.width = 610
        panel.Geometry3D.height = 330
        ModalLabel(0, "stillwater", 0, 110, 36)
        Choice(12, "music_score", 0, 0, 32, 22)
        action_label := "music_listen"
        if world.Session.audio_status >= 3 {
            action_label = "music_retry"
        }
        Choice(13, action_label, 1, 0, -25, 14)
        hint := ""
        match (world.Session.audio_status) {
            case 1 {
                hint = "audio_share_hint"
            }
            case 2 {
                hint = "audio_connected"
                if world.Session.audio_quiet {
                    hint = "audio_quiet"
                }
            }
            case 3 {
                hint = "audio_no_source"
            }
            case 4 {
                hint = "audio_cancelled"
            }
            case 5 {
                hint = "audio_ended"
            }
        }
        if hint != "" {
            ModalLabel(16, hint, 0, -83, 10)
        }
        if world.Session.audio_status >= 3 && world.Session.audio_status != 3 {
            ModalLabel(17, "audio_share_hint", 0, -115, 9)
        }
    }

    function ReadPointer() {
        hover_choice = -1
        if world.Session.screen != 0 {
            return
        }
        ray := get_pointer_ray()
        if !ray.Active || abs(ray.Direction.z) < 0.0001 {
            return
        }
        distance := (70 - ray.Origin.z) / ray.Direction.z
        if distance < 0 {
            return
        }
        point := ray.Origin + ray.Direction * distance
        choice: int = -1
        if abs(point.x) < 150 && abs(point.y - 32) < 22 {
            choice = 0
        }
        if abs(point.x) < 165 && abs(point.y + 25) < 21 {
            choice = 1
        }
        if choice < 0 {
            return
        }
        hover_choice = choice
        if input.Select.pressed {
            world.Session.audio_request = choice + 1
        }
    }

    function DrawPause() {
        panel.Geometry3D.width = 580
        panel.Geometry3D.height = 296
        title := "paused"
        if world.Session.disconnected {
            title = "controller_lost"
        }
        ModalLabel(11, title, 0, 90, 24)
        ModalLabel(12, "press_enter", 0, 47, 12)
        ModalLabel(13, "play_controls", 0, -10, 9)
        ModalLabel(14, "settings_controls", 0, -48, 8)
        if world.Session.mode == 0 {
            ModalLabel(19, "chapter_controls", 0, -83, 9)
        }
        ModalLabel(15, "music", 0, -117, 9)
    }

    function DrawResult() {
        panel.Geometry3D.width = 580
        panel.Geometry3D.height = 360
        title := "game_over"
        if world.Session.won {
            title = "complete"
        }
        ModalLabel(11, title, 0, 124, 24)
        if world.Session.mode == 2 {
            ModalLabel(64, "elapsed", -140, 58, 11)
            Time(66, world.Session.elapsed, -140, 20, 22)
            ModalLabel(65, "best", 140, 58, 11)
            if world.Session.sprint_best > 0 {
                Time(77, world.Session.sprint_best, 140, 20, 22)
            } else {
                ModalLabel(77, "no_best", 140, 20, 12)
            }
        } else {
            if world.Session.mode == 3 {
                ModalLabel(3, "score", -145, 58, 11)
                ModalLabel(4, "score", 145, 58, 11)
                Number(20, 10, board1.BoardState.score, -145, 24, 24)
                Number(40, 10, board2.BoardState.score, 145, 24, 24)
                ModalLabel(5, "lines", -145, -18, 10)
                ModalLabel(6, "lines", 145, -18, 10)
                Number(30, 10, board1.BoardState.lines, -145, -46, 20)
                Number(50, 10, board2.BoardState.lines, 145, -46, 20)
            } else {
                ModalLabel(3, "score", -130, 58, 11)
                Number(20, 10, board1.BoardState.score, -130, 18, 26)
                ModalLabel(4, "lines", 130, 58, 11)
                Number(30, 10, board1.BoardState.lines, 130, 18, 26)
            }
        }
        for i in 20..87 {
            label := get(labels, i)
            label.Transform3D.position.z = 70
        }
        ModalLabel(12, "press_enter", 0, -90, 12)
        if world.Session.mode == 0 {
            ModalLabel(19, "chapter_controls", 0, -122, 9)
        }
        ModalLabel(15, "music", 0, -154, 9)
    }

    function Draw() {
        for i in 0..96 {
            Hide(i)
        }
        for backing in backings {
            backing.RenderState.hidden = true
        }
        timer_backing.RenderState.hidden = world.Session.mode != 2 || world.Session.screen == 0
        panel.RenderState.hidden = world.Session.screen == 1
        if world.Session.screen == 0 {
            DrawConnection()
            RememberState()
            return
        }
        Label(0, "stillwater", 0, 296, 24)
        Label(1, get(modes, world.Session.mode), -40, 264, 9)
        Label(2, "chapter", 34, 264, 7)
        Number(60, 1, world.Session.stage + 1, 64, 264, 10)
        BoardLabels(0, board1)
        if world.Session.mode == 2 {
            Label(64, "elapsed", -205, -98, 10)
            Time(66, world.Session.elapsed, -205, -126, 20)
            Label(65, "best", -205, -167, 10)
            if world.Session.sprint_best > 0 {
                Time(77, world.Session.sprint_best, -205, -195, 18)
            } else {
                Label(77, "no_best", -205, -195, 10)
            }
        }
        if world.Session.mode != 3 && world.Session.goal > 0 {
            Label(17, "remaining", 14, -258, 8)
            Number(62, 2, max(0, world.Session.goal - world.Session.chapter_lines), -45, -258, 12)
        }
        if world.Session.mode == 3 {
            BoardLabels(1, board2)
            Label(18, "rescue", 0, -258, 9)
            Number(61, 1, world.Session.charge, 42, -258, 12)
        }
        if world.Session.screen == 1 {
            Label(13, "pause_hint", 0, -294, 8)
        }
        if world.Session.screen >= 2 {
            for i in 1..96 {
                Hide(i)
            }
            for backing in backings {
                backing.RenderState.hidden = true
            }
            timer_backing.RenderState.hidden = true
            if world.Session.screen == 3 {
                DrawResult()
            } else {
                DrawPause()
            }
        }
        if world.Session.save_failed {
            Label(16, "saving_failed", -375, 287, 9)
        }
        if setting_time > 0 {
            DrawSetting()
        }
        RememberState()
    }

    function RememberState() {
        audio_source = world.Session.audio_source
        audio_status = world.Session.audio_status
        audio_signal = world.Session.audio_signal
        audio_quiet = world.Session.audio_quiet
        pointer_choice = hover_choice
        screen = world.Session.screen
        world_serial = world.ReactionQueue.serial
    }

    function DrawSetting() {
        label := ""
        match (setting_kind) {
            case 1 {
                label = get(["setting_effects_off", "setting_effects_low", "setting_effects_full"], cast<int>(clamp(setting_value, 0, 2)))
            }
            case 2 {
                label = "setting_motion_off"
                if setting_value != 0 {
                    label = "setting_motion_on"
                }
            }
            case 3 {
                label = "setting_ghost_off"
                if setting_value != 0 {
                    label = "setting_ghost_on"
                }
            }
            case 4 {
                label = "setting_volume"
            }
            case 5 {
                label = "setting_das"
            }
            case 6 {
                label = "setting_arr"
            }
        }
        if label == "" {
            return
        }
        if setting_kind < 4 {
            Label(92, label, -375, 267, 8)
            return
        }
        Label(92, label, -399, 267, 8)
        Number(93, 3, setting_value, -330, 267, 9)
        unit := "setting_ms"
        if setting_kind == 4 {
            unit = "setting_percent"
        }
        Label(96, unit, -302, 267, 7)
    }

    function ReadSettings(dt: number) -> (updated: bool) {
        visible := setting_time > 0
        setting_time = max(0, setting_time - dt)
        changed := visible && setting_time == 0
        serial := world.ReactionQueue.serial
        if serial < setting_serial {
            setting_serial = 0
        }
        if serial == setting_serial {
            return changed
        }
        first := cast<int>(max(setting_serial + 1, serial - 31))
        for i in first..serial {
            slot := ReactionRules.Read(world, i)
            if slot.ReactionEvent.kind == 18 {
                setting_kind = slot.ReactionEvent.detail
                setting_value = slot.ReactionEvent.amount
                setting_time = 2.5
                changed = true
            }
        }
        setting_serial = serial
        return changed
    }

    on Tick(dt) {
        if !ready {
            return
        }
        ReadPointer()
        refresh += dt
        changed := ReadSettings(dt)
        changed = changed || pointer_choice != hover_choice || audio_source != world.Session.audio_source || audio_status != world.Session.audio_status || audio_signal != world.Session.audio_signal || audio_quiet != world.Session.audio_quiet || screen != world.Session.screen || world_serial != world.ReactionQueue.serial
        if refresh < 0.1 && !changed {
            return
        }
        refresh = 0
        Draw()
    }
}
