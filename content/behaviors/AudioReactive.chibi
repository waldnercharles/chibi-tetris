// The host measures the game score or audio from a user-selected source.
behavior AudioReactive {
    signal_time := 0
    quiet_time := 0

    on Begin {
        set_audio_source(0)
    }

    function PauseForConnection() {
        if self.Session.screen != 0 {
            self.Session.audio_return_screen = self.Session.screen
        }
        self.Session.screen = 0
        self.Session.audio_ready = false
        set_music_volume(0)
    }

    function ClearSignal() {
        self.Session.audio_signal = false
        self.Session.audio_quiet = false
        signal_time = 0
        quiet_time = 0
    }

    function Listen() {
        PauseForConnection()
        previous := self.Session.audio_source
        // Re-selecting a source is a host no-op. Reset it so every retry opens
        // a fresh browser audio chooser and cancels the previous request.
        set_audio_source(0)
        set_audio_source(1)
        self.Session.audio_source = 1
        self.Session.audio_status = 1
        ClearSignal()
        ReactionRules.Emit(self, 20, 1, previous, 1, 1 - previous, 1, 0)
    }

    function UseGameScore() {
        PauseForConnection()
        previous := self.Session.audio_source
        set_audio_source(0)
        self.Session.audio_source = 0
        self.Session.audio_status = 0
        self.Session.audio_ready = true
        set_music_volume(self.Session.music)
        ClearSignal()
        ReactionRules.Emit(self, 20, 1, previous, 0, -previous, 0, 0)
    }

    function Controls() {
        request := self.Session.audio_request
        self.Session.audio_request = 0
        if self.Session.screen == 0 && input.Confirm.pressed {
            request = 1
        }
        if input.AudioSource.pressed {
            request = 2
        }
        match (request) {
            case 1 {
                UseGameScore()
            }
            case 2 {
                Listen()
            }
        }
    }

    on Tick(dt) {
        previous_status := self.Session.audio_status
        Controls()
        audio := get_audio_analysis()
        current_source := audio.Source == self.Session.audio_source
        self.Session.audio_status = 0
        if self.Session.audio_source == 1 {
            self.Session.audio_status = 1
            if current_source {
                self.Session.audio_status = audio.Status
            }
        }
        if self.Session.audio_source == 1 && self.Session.audio_status >= 3 {
            PauseForConnection()
        }
        if previous_status != self.Session.audio_status {
            ReactionRules.Emit(self, 21, 1, previous_status, self.Session.audio_status, 0, self.Session.audio_status, 0)
        }
        if !current_source {
            ClearSignal()
            self.VisualState.energy = 0
            self.VisualState.bass = 0
            self.VisualState.mid = 0
            self.VisualState.treble = 0
            self.VisualState.beat = 0
            return
        }
        if self.Session.audio_source == 1 && audio.Status == 2 {
            // Ready means the host connected an audio stream. Quiet passages
            // remain playable; Active and Level describe its measured sound.
            self.Session.audio_ready = true
            quiet_time = min(2, quiet_time + dt)
            signal_time = max(0, signal_time - dt)
            if audio.Active && audio.Level > 0.001 {
                quiet_time = 0
                signal_time = 0.5
            }
        } else {
            quiet_time = 0
            signal_time = 0
        }
        self.Session.audio_signal = signal_time > 0
        self.Session.audio_quiet = quiet_time >= 2
        self.VisualState.energy = clamp(audio.Level * 6, 0, 1)
        self.VisualState.bass = clamp(audio.Bass * 9, 0, 1)
        self.VisualState.mid = clamp(audio.Mid * 8, 0, 1)
        self.VisualState.treble = clamp(audio.Treble * 15, 0, 1)
        self.VisualState.beat = audio.Onset
    }
}
