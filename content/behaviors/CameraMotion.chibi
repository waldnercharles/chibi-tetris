// Slow parallax around the upright well. Motion never changes the board grid.
behavior CameraMotion {
    world: entity
    time := 0
    was_attract := true
    was_entering := false
    intro_pan := -240
    intro_width := 1208.8889
    intro_fov := 0.61086524
    return_time := 1
    return_pan := -240
    return_width := 1208.8889
    return_fov := 0.61086524
    pan_value := -240
    width_value := 1208.8889
    fov_value := 0.61086524

    on Begin {
        world = get_global_variable("World")
        was_attract = world.Session.attract
    }

    on Tick(dt) {
        moving := !world.Session.reduced_motion && world.Session.effects > 0
        if world.Session.screen == 2 {
            return
        }
        pan := 0
        width := 1000
        fov := 0.88
        if world.Session.mode == 3 {
            width = 1208.8889
            fov = 0.61086524
        }
        if world.Session.attract {
            pan = -240
            width = 1208.8889
            fov = 0.61086524
        }
        if world.Session.entering && !was_entering {
            intro_pan = pan_value
            intro_width = width_value
            intro_fov = fov_value
        }
        was_entering = world.Session.entering
        if world.Session.entering && world.Session.attract && !world.Session.reduced_motion {
            progress := clamp((world.Session.intro_time - 0.2) / 2.45, 0, 1)
            eased := progress * progress * progress * (progress * (progress * 6 - 15) + 10)
            pan = intro_pan * (1 - eased)
            width = intro_width + (1000 - intro_width) * eased
            fov = intro_fov + (0.88 - intro_fov) * eased
        }
        if world.Session.attract && !was_attract {
            return_time = 0
            return_pan = pan_value
            return_width = width_value
            return_fov = fov_value
        }
        was_attract = world.Session.attract
        if world.Session.attract && !world.Session.entering && return_time < 0.9 {
            return_time = min(0.9, return_time + min(dt, 0.05))
            if world.Session.reduced_motion {
                return_time = 0.9
            }
            progress := return_time / 0.9
            eased := progress * progress * progress * (progress * (progress * 6 - 15) + 10)
            pan = return_pan + (pan - return_pan) * eased
            width = return_width + (width - return_width) * eased
            fov = return_fov + (fov - return_fov) * eased
        }
        pan_value = pan
        width_value = width
        fov_value = fov
        self.Camera.width = width
        self.Camera.fov = fov
        x := 90
        y := 50
        z := 1080
        if moving {
            time += min(dt, 0.05)
            x += sin(time * 0.13) * 7
            y += sin(time * 0.09) * 5
            z -= world.VisualState.bass * 4
            if world.Session.journey {
                passage := sin(clamp(world.Session.journey_time / 2.6, 0, 1) * 3.14159265)
                passage *= passage
                x += passage * 28
                z += passage * 650
            }
        }
        yaw := atan2(x, z)
        pitch := -atan2(y, sqrt(x * x + z * z))
        sy := sin(yaw * 0.5)
        cy := cos(yaw * 0.5)
        sx := sin(pitch * 0.5)
        cx := cos(pitch * 0.5)
        self.Transform3D.position = vec3(x + pan, y, z)
        self.Transform3D.rotation = { x: cy * sx, y: sy * cx, z: -sy * sx, w: cy * cx }
    }
}
