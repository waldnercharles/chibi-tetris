// Screen 0 offers Play or Connect audio; 1 plays, 2 pauses, 3 holds a result.
behavior Shell {
    board1: entity
    board2: entity
    chapter: int = 0
    startingChapter: int = 0
    unlocked: int = 0
    stageStart: int = 0
    lastLines: int = 0
    bestEndless: int = 0
    bestJourney: int = 0
    bestDuet: int = 0
    clock: number = 0
    settle: number = 0
    pad1 := false
    pad2 := false
    initialized := false
    action writer = commit_save()

    on Begin {
        ReactionRules.Initialize(self, self.Session.run)
        board1 = get_global_variable("Board1")
        board2 = get_global_variable("Board2")
        unlocked = cast<int>(clamp(read_saved_number("chapter", 0).Number, 0, 5))
        chapter = unlocked
        bestEndless = cast<int>(max(0, read_saved_number("endless", 0).Number))
        bestJourney = cast<int>(max(0, read_saved_number("journey", 0).Number))
        bestDuet = cast<int>(max(0, read_saved_number("duet", 0).Number))
        self.Session.sprint_best = max(0, read_saved_number("sprint", 0).Number)
        self.Session.master = clamp(read_saved_number("master", 0.8).Number, 0, 1)
        self.Session.music = clamp(read_saved_number("music", 0.65).Number, 0, 1)
        self.Session.sound = clamp(read_saved_number("sound", 0.75).Number, 0, 1)
        self.Session.das = clamp(read_saved_number("das", 0.15).Number, 0.08, 0.3)
        self.Session.arr = clamp(read_saved_number("arr", 0.035).Number, 0.01, 0.08)
        self.Session.effects = cast<int>(clamp(read_saved_number("effects", 2).Number, 0, 2))
        self.Session.reduced_motion = read_saved_number("reduced_motion", 0).Number != 0
        self.Session.ghost = read_saved_number("ghost", 1).Number != 0
        Mix()
        initialized = true
        if self.Session.audio_ready {
            self.Session.hud_alpha = 1
            Start(0)
            return
        }
        self.Session.attract = true
        self.Session.hud_alpha = 0
        self.Session.stage = chapter
        self.Session.screen = 0
        set_music_volume(0)
    }

    after writer.Failed {
        self.Session.save_failed = true
    }

    function Mix() {
        set_master_volume(self.Session.master)
        set_sound_volume(self.Session.sound)
        if self.Session.audio_ready && self.Session.audio_source == 0 {
            set_music_volume(self.Session.music)
        }
    }

    function SaveSettings() {
        set_saved_number("master", self.Session.master)
        set_saved_number("music", self.Session.music)
        set_saved_number("sound", self.Session.sound)
        set_saved_number("das", self.Session.das)
        set_saved_number("arr", self.Session.arr)
        set_saved_number("effects", self.Session.effects)
        motion: number = 0
        if self.Session.reduced_motion {
            motion = 1
        }
        set_saved_number("reduced_motion", motion)
        ghost: number = 0
        if self.Session.ghost {
            ghost = 1
        }
        set_saved_number("ghost", ghost)
        self.Session.save_failed = false
        writer.Exec()
    }

    function Music() {
        if self.Session.stage < 2 {
            play_music("shore", 2)
            return
        }
        if self.Session.stage < 4 {
            play_music("current", 2)
            return
        }
        play_music("aurora", 2)
    }

    function Start(mode: int) {
        if !self.Session.audio_ready {
            self.Session.screen = 0
            return
        }
        old_mode := self.Session.mode
        self.Session.mode = mode
        self.Session.stage = 0
        if mode == 0 {
            self.Session.stage = chapter
        }
        startingChapter = self.Session.stage
        self.Session.seed = 40040
        if mode != 2 {
            self.Session.seed = 73129 + cast<int>(clock * 1000) % 1000000
        }
        RestartRun()
        ReactionRules.Emit(self, 16, 1, old_mode, mode, 0, mode, mode)
    }

    function EnterPlay() {
        if !self.Session.audio_ready || self.Session.entering {
            return
        }
        if !self.Session.attract {
            self.Session.screen = cast<int>(clamp(self.Session.audio_return_screen, 1, 3))
            pad1 = controller_connected(0)
            pad2 = controller_connected(1)
            return
        }
        self.Session.entering = true
        self.Session.intro_time = 0
    }

    function Intro() {
        if !self.Session.audio_ready {
            self.Session.entering = false
            self.Session.hud_alpha = 1
            return
        }
        self.Session.intro_time += min(dt, 0.1)
        clear_time := 1.6
        duration := 2.4
        if self.Session.reduced_motion {
            clear_time = 0.18
            duration = 0.36
        }
        if self.Session.attract && self.Session.intro_time >= clear_time {
            self.Session.attract = false
            Start(self.Session.selected_mode)
        }
        self.Session.hud_alpha = clamp((self.Session.intro_time - clear_time) / (duration - clear_time), 0, 1)
        if self.Session.intro_time >= duration {
            self.Session.entering = false
            self.Session.hud_alpha = 1
        }
    }

    function SelectMode(mode: int) {
        if self.Session.attract {
            previous := self.Session.selected_mode
            self.Session.selected_mode = mode
            ReactionRules.Emit(self, 16, 1, previous, mode, 0, mode, mode)
            return
        }
        Start(mode)
    }

    function RestartRun() {
        if !self.Session.audio_ready {
            self.Session.screen = 0
            return
        }
        self.Session.stage = startingChapter
        self.Session.run += 1
        self.ReactionQueue.run = self.Session.run
        ReactionRules.Emit(self, 15, 1, self.Session.run - 1, self.Session.run, 0, self.Session.mode, 0)
        self.Session.elapsed = 0
        self.Session.rescue1 = 0
        self.Session.rescue2 = 0
        self.Session.charge = 0
        self.Session.screen = 1
        self.Session.won = false
        self.Session.disconnected = false
        self.Session.chapter_lines = 0
        self.Session.goal = 12
        if self.Session.mode == 1 {
            self.Session.goal = 0
        }
        if self.Session.mode == 2 {
            self.Session.goal = 40
        }
        if self.Session.mode == 3 {
            self.Session.goal = 20
        }
        lastLines = 0
        stageStart = 0
        settle = 0.15
        pad1 = controller_connected(0)
        pad2 = controller_connected(1)
        Music()
    }

    function ResumePlay() {
        if !self.Session.audio_ready {
            self.Session.screen = 0
            return
        }
        ReactionRules.Emit(self, 14, 1, self.Session.screen, 1, 0, 1, 0)
        self.Session.screen = 1
        self.Session.disconnected = false
        pad1 = controller_connected(0)
        pad2 = controller_connected(1)
    }

    function ChangeChapter(direction: int) {
        if !self.Session.audio_ready || self.Session.mode != 0 || self.Session.screen == 1 {
            ReactionRules.Emit(self, 17, 0, self.Session.stage, self.Session.stage, direction, self.Session.stage, 0)
            return
        }
        selected := cast<int>(clamp(self.Session.stage + direction, 0, unlocked))
        if selected == self.Session.stage {
            ReactionRules.Emit(self, 17, 0, selected, selected, direction, selected, 0)
            return
        }
        previous := self.Session.stage
        chapter = selected
        Start(0)
        self.Session.screen = 2
        ReactionRules.Emit(self, 17, 1, previous, selected, direction, selected, 0)
    }

    function Finish(success: bool) {
        ReactionRules.Emit(self, 19, ReactionRules.Flag(success), self.Session.stage, self.Session.stage, 0, self.Session.mode, 0)
        self.Session.won = success
        self.Session.screen = 3
        score := board1.BoardState.score
        if self.Session.mode == 3 {
            score += board2.BoardState.score
        }
        if success {
            play_sound("complete", 0.7)
        }
        if self.Session.mode == 2 && success {
            if self.Session.sprint_best == 0 || self.Session.elapsed < self.Session.sprint_best {
                self.Session.sprint_best = self.Session.elapsed
                set_saved_number("sprint", self.Session.sprint_best)
            }
        }
        if self.Session.mode == 1 && score > bestEndless {
            bestEndless = score
            set_saved_number("endless", score)
        }
        if self.Session.mode == 0 && score > bestJourney {
            bestJourney = score
            set_saved_number("journey", score)
        }
        if self.Session.mode == 3 && score > bestDuet {
            bestDuet = score
            set_saved_number("duet", score)
        }
        writer.Exec()
    }

    function Progress() {
        lines := board1.BoardState.lines
        goal: int = 12
        if self.Session.mode == 3 {
            lines += board2.BoardState.lines
            goal = 20
        }
        if self.Session.mode == 2 && lines >= 40 {
            Finish(true)
            return
        }
        if (self.Session.mode == 0 || self.Session.mode == 3) && self.Session.stage == 5 && lines - stageStart >= goal {
            lastLines = lines
            Finish(true)
            return
        }
        if self.Session.mode == 3 {
            self.Session.charge = cast<int>(min(8, self.Session.charge + lines - lastLines))
            if board1.BoardState.topout && self.Session.charge >= 4 {
                self.Session.charge -= 4
                self.Session.rescue1 += 1
                settle = 0.1
            }
            if board2.BoardState.topout && self.Session.charge >= 4 {
                self.Session.charge -= 4
                self.Session.rescue2 += 1
                settle = 0.1
            }
            if settle == 0 && board1.BoardState.topout && board2.BoardState.topout {
                Finish(false)
                return
            }
        } else {
            if board1.BoardState.topout {
                Finish(false)
                return
            }
        }
        lastLines = lines
        if self.Session.mode == 0 || self.Session.mode == 3 {
            if lines - stageStart >= goal {
                stageStart += goal
                self.Session.stage += 1
                ReactionRules.Emit(self, 17, 1, self.Session.stage - 1, self.Session.stage, 1, self.Session.stage, 1)
                if self.Session.mode == 0 && self.Session.stage > unlocked {
                    unlocked = self.Session.stage
                    set_saved_number("chapter", unlocked)
                    writer.Exec()
                }
                play_sound("complete", 0.45)
                Music()
            }
        }
        if self.Session.mode == 1 {
            newStage := cast<int>(min(5, lines / 20))
            if newStage != self.Session.stage {
                ReactionRules.Emit(self, 17, 1, self.Session.stage, newStage, 1, newStage, 1)
                self.Session.stage = newStage
                Music()
            }
        }
    }

    function Preferences() {
        changed := false
        if input.Effects.pressed {
            previous := self.Session.effects
            self.Session.effects = (self.Session.effects + 1) % 3
            ReactionRules.Emit(self, 18, 1, previous, self.Session.effects, 1, self.Session.effects, 1)
            changed = true
        }
        if input.Motion.pressed {
            previous := ReactionRules.Flag(self.Session.reduced_motion)
            self.Session.reduced_motion = !self.Session.reduced_motion
            value := ReactionRules.Flag(self.Session.reduced_motion)
            ReactionRules.Emit(self, 18, 1, previous, value, 0, value, 2)
            changed = true
        }
        if input.Ghost.pressed {
            previous := ReactionRules.Flag(self.Session.ghost)
            self.Session.ghost = !self.Session.ghost
            value := ReactionRules.Flag(self.Session.ghost)
            ReactionRules.Emit(self, 18, 1, previous, value, 0, value, 3)
            changed = true
        }
        if input.VolumeDown.pressed {
            previous := self.Session.master
            self.Session.master = max(0, self.Session.master - 0.1)
            ReactionRules.Emit(self, 18, ReactionRules.Flag(previous != self.Session.master), previous, self.Session.master, -1, cast<int>(round(self.Session.master * 100)), 4)
            changed = true
        }
        if input.VolumeUp.pressed {
            previous := self.Session.master
            self.Session.master = min(1, self.Session.master + 0.1)
            ReactionRules.Emit(self, 18, ReactionRules.Flag(previous != self.Session.master), previous, self.Session.master, 1, cast<int>(round(self.Session.master * 100)), 4)
            changed = true
        }
        if changed {
            Mix()
            SaveSettings()
        }
    }

    on Tick {
        if !initialized {
            return
        }
        clock += dt
        Preferences()
        if self.Session.entering {
            self.Session.play_request = false
            Intro()
            return
        }
        if self.Session.mode_request > 0 {
            mode := self.Session.mode_request - 1
            self.Session.mode_request = 0
            SelectMode(mode)
        }
        if input.JourneyMode.pressed {
            SelectMode(0)
            return
        }
        if input.EndlessMode.pressed {
            SelectMode(1)
            return
        }
        if input.SprintMode.pressed {
            SelectMode(2)
            return
        }
        if input.DuetMode.pressed {
            SelectMode(3)
            return
        }
        if self.Session.screen == 0 {
            if self.Session.play_request {
                self.Session.play_request = false
                EnterPlay()
            }
            return
        }
        if self.Session.screen == 1 {
            if input.PreviousChapter.pressed {
                ChangeChapter(-1)
            }
            if input.NextChapter.pressed {
                ChangeChapter(1)
            }
            if (pad1 && !controller_connected(0)) || (self.Session.mode == 3 && pad2 && !controller_connected(1)) {
                self.Session.disconnected = true
                ReactionRules.Emit(self, 13, 1, 1, 2, 0, 2, 1)
                self.Session.screen = 2
                return
            }
            pad1 = controller_connected(0)
            pad2 = controller_connected(1)
            if input.Pause.pressed || input.Pause2.pressed {
                ReactionRules.Emit(self, 13, 1, 1, 2, 0, 2, 0)
                self.Session.screen = 2
                return
            }
            if settle > 0 {
                settle = max(0, settle - dt)
            } else {
                self.Session.elapsed += dt
                Progress()
            }
            lines := board1.BoardState.lines
            if self.Session.mode == 3 {
                lines += board2.BoardState.lines
            }
            self.Session.chapter_lines = lines - stageStart
            return
        }
        if input.PreviousChapter.pressed {
            ChangeChapter(-1)
            return
        }
        if input.NextChapter.pressed {
            ChangeChapter(1)
            return
        }
        if input.Back.pressed {
            RestartRun()
            return
        }
        if self.Session.screen == 2 && (input.Pause.pressed || input.Pause2.pressed || input.Confirm.pressed) {
            ResumePlay()
            return
        }
        if self.Session.screen == 3 && input.Confirm.pressed {
            RestartRun()
        }
    }

    on Journey {
        SelectMode(0)
    }
    on Endless {
        SelectMode(1)
    }
    on Sprint {
        SelectMode(2)
    }
    on Duet {
        SelectMode(3)
    }
    on Resume {
        ResumePlay()
    }
    on Restart {
        RestartRun()
    }
    on ChapterPrevious {
        ChangeChapter(-1)
    }
    on ChapterNext {
        ChangeChapter(1)
    }
}
