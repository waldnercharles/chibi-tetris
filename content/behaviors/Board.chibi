behavior Board {
    world: entity
    tiles: entity[] = []
    settled_tiles: entity[] = []
    preview_tiles: entity[] = []
    grid: int[] = []
    queue: int[] = []
    seed: int64 = 1
    seen_run: int = -1
    seen_rescue: int = 0
    current: int = 0
    held: int = 0
    column: int = 3
    row: int = 1
    rotation: int = 0
    last_kick: int = 0
    rotated := false
    hold_used := false
    fall_clock := 0
    lock_clock := 0
    lock_started := false
    lock_resets: int = 0
    repeat_blocked := false
    soft_held := false
    repeat_direction: int = 0
    repeat_clock := 0
    next_repeat := 0
    visible := false
    old_mode: int = -1
    old_screen: int = 0
    old_entering := false
    old_ghost := false
    old_effects: int = -1
    stack_dirty := true
    piece_dirty := true
    preview_dirty := true
    motion_dirty := false
    finish_dirty := false
    origin := -120
    style_clock := 0
    music_clock := 0
    finish_clock := 0
    drawn_style := -1
    style := 0
    block_depth := 0.6
    block_roughness := 0.54
    block_metallic := 0.06
    block_emission := 0.025
    block_opacity := 0.9
    base_finish: CF_V3 = { x: 0.54, y: 0.06, z: 0.025 }
    base_opacity := 0.9
    finish_signal: CF_V3 = { x: 0, y: 0, z: 0 }
    finish_character: CF_V3 = { x: 0, y: 0, z: 0 }
    finish_structure: CF_V3 = { x: 0, y: 0, z: 0 }
    impact_gain := 1
    music_lift := 0
    music_scale := 0
    action_drive := 0
    action_flash := 0
    move_drive := 0
    move_lean := 0
    turn_drive := 0
    turn_lean := 0
    well_sink := 0
    well_velocity := 0
    piece_targets: CF_V3[] = []
    piece_snap := true
    piece_moving := false
    ripple_sources: CF_V3[] = []
    ripple_strengths: number[] = []
    rippling := false
    contact_tiles: entity[] = []
    contact_drives: number[] = []
    contact_flashes: number[] = []
    demo_piece: int = -1
    demo_candidate: int = 0
    demo_column: int = 3
    demo_rotation: int = 0
    demo_quality := -1000000
    demo_clock := 0
    demo_wait := 0
    loss_started := false
    loss_finished := false
    loss_row: int = 2

    on Begin {
        world = get_global_variable("World")
        for (i in 0..231) {
            if i >= 204 && i < 208 {
                ghost := await spawn(BlockRim)
                tiles = array_add(tiles, ghost)
            } else {
                tile := await spawn(Block)
                tiles = array_add(tiles, tile)
            }
        }
        for i in 0..3 {
            piece_targets = array_add(piece_targets, vec3(0, 0, 0))
            ripple_sources = array_add(ripple_sources, vec3(0, 0, 1.4))
            ripple_strengths = array_add(ripple_strengths, 0)
        }
        self.BoardState.ready = true
    }

    function FillQueue() {
        if length(queue) < 6 {
            queue = append(queue, Pieces.Bag(seed))
        }
    }

    function Next() -> (kind: int) {
        FillQueue()
        kind = get(queue, 0)
        queue = remove_index(queue, 0)
        FillQueue()
        preview_dirty = true
        return kind
    }

    function TopOut() {
        if self.BoardState.topout {
            return
        }
        Emit(11, 1, 0, 0, current)
        if soft_held {
            Emit(5, 1, 0, 0, current)
            soft_held = false
        }
        self.BoardState.topout = true
        piece_dirty = true
        play_sound("topout", 0.45)
    }

    function SpawnPiece(kind: int) {
        piece_snap = true
        piece_moving = false
        action_drive = 0
        action_flash = 0
        move_drive = 0
        move_lean = 0
        turn_drive = 0
        turn_lean = 0
        current = kind
        column = 3
        row = 1
        rotation = 0
        rotated = false
        last_kick = 0
        fall_clock = 0
        lock_clock = 0
        lock_started = false
        lock_resets = 0
        piece_dirty = true
        if !Rules.Fits(grid, current, rotation, column, row) {
            TopOut()
        }
    }

    function Reset() {
        if seen_run != world.Session.run {
            ReactionRules.Initialize(self, world.Session.run)
        }
        seen_run = world.Session.run
        well_sink = 0
        well_velocity = 0
        ClearRipples()
        ClearContacts()
        grid = Rules.Empty()
        loss_started = false
        loss_finished = false
        loss_row = 2
        queue = []
        seed = cast<int64>(world.Session.seed) % 2147483646
        if seed < 0 {
            seed = -seed
        }
        seed += 1
        held = 0
        hold_used = false
        repeat_blocked = false
        soft_held = false
        repeat_direction = 0
        repeat_clock = 0
        seen_rescue = world.Session.rescue1
        if self.BoardState.index == 1 {
            seen_rescue = world.Session.rescue2
        }
        self.BoardState.score = 0
        self.BoardState.lines = 0
        self.BoardState.level = 1
        self.BoardState.topout = false
        self.BoardState.pieces = 0
        self.BoardState.combo = -1
        self.BoardState.last_clear = 0
        self.BoardState.clear_serial = 0
        self.BoardState.back_to_back = false
        self.BoardState.spin = 0
        self.BoardState.move_serial = 0
        self.BoardState.rotate_serial = 0
        self.BoardState.hold_serial = 0
        self.BoardState.drop_serial = 0
        self.BoardState.drop_distance = 0
        stack_dirty = true
        preview_dirty = true
        SpawnPiece(Next())
    }

    function Rescue() {
        Emit(12, 1, 0, 6, current)
        ClearContacts()
        ClearRipples()
        Rules.Rescue(grid)
        self.BoardState.topout = false
        self.BoardState.combo = -1
        hold_used = false
        stack_dirty = true
        preview_dirty = true
        SpawnPiece(current)
        play_sound("rescue", 0.5)
    }

    function ResetLock(grounded: bool) {
        if !grounded || lock_resets >= 15 {
            return
        }
        lock_clock = 0
        lock_resets += 1
    }

    function Shift(direction: int, explicit: bool) -> (moved: bool) {
        if !Rules.Fits(grid, current, rotation, column + direction, row) {
            if explicit || !repeat_blocked {
                Emit(1, 0, direction, 0, current)
            }
            repeat_blocked = true
            return false
        }
        grounded := !Rules.Fits(grid, current, rotation, column, row + 1)
        column += direction
        repeat_blocked = false
        rotated = false
        ResetLock(grounded)
        piece_dirty = true
        Emit(1, 1, direction, 1, current)
        Action(0.45, cast<number>(direction) * 0.65, 0)
        self.BoardState.move_serial += 1
        Impact()
        return true
    }

    function Rotate(direction: int) {
        result := Rules.Rotate(grid, current, rotation, column, row, direction)
        if !result.success {
            Emit(2, 0, direction, 0, current)
            return
        }
        grounded := !Rules.Fits(grid, current, rotation, column, row + 1)
        column = result.column
        row = result.row
        rotation = result.facing
        last_kick = result.kick
        rotated = true
        ResetLock(grounded)
        piece_dirty = true
        Emit(2, 1, direction, result.kick, current)
        Action(0.85, 0, cast<number>(direction) * 0.85)
        self.BoardState.rotate_serial += 1
        Impact()
        play_sound("rotate", 0.2)
    }

    function Hold() {
        if hold_used {
            Emit(7, 0, 0, 0, current)
            return
        }
        Emit(7, 1, 0, held, current)
        replacement := held
        held = current
        if replacement == 0 {
            replacement = Next()
        }
        SpawnPiece(replacement)
        Action(0.6, 0, 0)
        hold_used = true
        preview_dirty = true
        self.BoardState.hold_serial += 1
        Impact()
        play_sound("hold", 0.3)
    }

    function Lock() {
        Impact()
        spin := Rules.Spin(grid, current, rotation, column, row, rotated, last_kick)
        any_visible := Rules.Place(grid, current, rotation, column, row)
        clear_rows := Rules.FullRows(grid)
        count := length(clear_rows)
        Emit(8, 1, 0, spin, current)
        Rules.Award(self, count, spin)
        if count > 0 {
            ClearContacts()
            mask: int = 0
            for (cleared in clear_rows) {
                mask = mask | 1 << cleared
            }
            Emit(9, 1, 0, count, mask)
            if self.BoardState.combo > 0 {
                Emit(10, 1, 0, self.BoardState.combo, mask)
            }
            Rules.Collapse(grid, clear_rows)
            match (count) {
                case 1 {
                    play_sound("clear1", 0.42)
                }
                case 2 {
                    play_sound("clear2", 0.48)
                }
                case 3 {
                    play_sound("clear2", 0.55)
                }
                case 4 {
                    play_sound("clear4", 0.6)
                }
            }
        }
        if count == 0 {
            for block in 0..3 {
                cell := Pieces.Cell(current, rotation, block)
                if row + cell.y >= 2 {
                    Contact(get(tiles, (row + cell.y - 2) * 10 + column + cell.x))
                }
            }
            play_sound("lock", 0.25)
        }
        stack_dirty = true
        hold_used = false
        if !any_visible && count == 0 {
            TopOut()
            return
        }
        SpawnPiece(Next())
    }

    function HardDrop() {
        landing := Rules.Landing(grid, current, rotation, column, row)
        distance := landing - row
        Emit(6, 1, 0, distance, current)
        self.BoardState.score += distance * 2
        if distance > 0 {
            rotated = false
        }
        row = landing
        self.BoardState.drop_serial += 1
        self.BoardState.drop_distance = distance
        if !world.Session.reduced_motion && world.Session.effects > 0 {
            well_velocity = max(-270, well_velocity - 210 - cast<number>(min(distance, 20)) * 2)
            Ripple()
        }
        Impact()
        play_sound("hard_drop", 0.35)
        Lock()
    }

    // One candidate per tick bounds planning work. Execution uses the same
    // rotation, translation, gravity, lock and clear paths as player input.
    function Demo(seconds: number) {
        if self.BoardState.topout {
            Reset()
            demo_piece = -1
        }
        if demo_piece != self.BoardState.pieces {
            demo_piece = self.BoardState.pieces
            demo_candidate = 0
            demo_quality = -1000000
            demo_column = column
            demo_rotation = rotation
            demo_clock = 0
            demo_wait = 0
        }
        if demo_candidate < 44 {
            facing := demo_candidate / 11
            x := demo_candidate % 11 - 2
            candidate := AttractRules.Evaluate(grid, current, facing, x)
            if candidate.valid && candidate.quality > demo_quality {
                demo_quality = candidate.quality
                demo_column = x
                demo_rotation = facing
            }
            demo_candidate += 1
            return
        }
        demo_clock += seconds
        if demo_clock < 0.1 {
            return
        }
        demo_clock = 0
        if rotation != demo_rotation {
            direction := 1
            if (demo_rotation - rotation + 4) % 4 == 3 {
                direction = -1
            }
            previous := rotation
            Rotate(direction)
            if rotation == previous {
                demo_rotation = rotation
            }
            return
        }
        if column != demo_column {
            direction := 1
            if demo_column < column {
                direction = -1
            }
            if !Shift(direction, true) {
                demo_column = column
            }
            return
        }
        demo_wait += 0.1
        if demo_wait < 0.4 {
            Fall(0.1, false)
            return
        }
        HardDrop()
    }

    function BeginDeparture() {
        // Preserve the falling piece as an ordinary body in the release.
        if !self.BoardState.topout {
            Rules.Place(grid, current, rotation, column, row)
        }
        self.BoardState.topout = true
        stack_dirty = true
        piece_dirty = true
        loss_started = true
        ClearRipples()
        ClearContacts()
    }

    function Horizontal(left: bool, right: bool, left_pressed: bool, right_pressed: bool, seconds: number) {
        direction: int = 0
        if left {
            direction = -1
        }
        if right {
            direction = 1
        }
        if left && right {
            direction = repeat_direction
            if left_pressed {
                direction = -1
            }
            if right_pressed {
                direction = 1
            }
        }
        if left_pressed && right_pressed {
            Emit(1, 0, -1, 0, current)
        }
        if direction == 0 {
            repeat_blocked = false
            repeat_direction = 0
            repeat_clock = 0
            return
        }
        if direction != repeat_direction || left_pressed || right_pressed {
            repeat_blocked = false
            repeat_direction = direction
            repeat_clock = 0
            next_repeat = max(0, world.Session.das)
            if Shift(direction, true) {
                play_sound("move", 0.15)
            }
            return
        }
        repeat_clock += seconds
        if repeat_clock < next_repeat {
            return
        }
        arr := max(0, world.Session.arr)
        moved := false
        for (step in 0..9) {
            if arr > 0 && repeat_clock < next_repeat {
                break
            }
            if !Shift(direction, false) {
                next_repeat = repeat_clock + arr
                break
            }
            moved = true
            next_repeat += arr
        }
        if moved {
            play_sound("move", 0.15)
        }
    }

    function Fall(seconds: number, soft: bool) {
        interval := Rules.Gravity(self.BoardState.level)
        if soft {
            // Ten cells per second stays controllable. Faster gravity still wins.
            interval = min(0.1, interval)
        }
        start_row := row
        fall_clock += seconds
        for (step in 0..21) {
            if fall_clock < interval {
                break
            }
            if !Rules.Fits(grid, current, rotation, column, row + 1) {
                fall_clock = 0
                break
            }
            row += 1
            fall_clock -= interval
            rotated = false
            piece_dirty = true
            if soft {
                self.BoardState.score += 1
            }
        }
        if soft && row > start_row {
            Impact()
            record := self.ReactionQueue.write
            ReactionRules.Emit(self, 4, 1, self.BoardState.impact_x, 228 - (start_row - 1) * 24, 1, row - start_row, current)
            CapturePiece(record, start_row)
            Action(0.18, 0, 0)
        }
        grounded := !Rules.Fits(grid, current, rotation, column, row + 1)
        if grounded {
            lock_started = true
        }
        if lock_started {
            lock_clock += seconds
        }
        if grounded && lock_clock >= 0.5 {
            Lock()
        }
    }

    function Controls(seconds: number) {
        left := input.P1Left.held
        right := input.P1Right.held
        left_pressed := input.P1Left.pressed
        right_pressed := input.P1Right.pressed
        soft := input.P1Soft.held
        drop := input.P1Drop.pressed
        cw := input.P1CW.pressed
        ccw := input.P1CCW.pressed
        hold := input.P1Hold.pressed
        if self.BoardState.index == 1 {
            left = input.P2Left.held
            right = input.P2Right.held
            left_pressed = input.P2Left.pressed
            right_pressed = input.P2Right.pressed
            soft = input.P2Soft.held
            drop = input.P2Drop.pressed
            cw = input.P2CW.pressed
            ccw = input.P2CCW.pressed
            hold = input.P2Hold.pressed
        }
        soft_pressed := soft && !soft_held
        if soft != soft_held {
            soft_held = soft
            // Time collected at the old speed must not become a burst of rows.
            fall_clock = 0
            if soft {
                accepted := ReactionRules.Flag(Rules.Fits(grid, current, rotation, column, row + 1))
                Emit(3, accepted, 1, 0, current)
            } else {
                Emit(5, 1, 0, 0, current)
            }
        }
        if hold {
            Hold()
        }
        if self.BoardState.topout {
            return
        }
        Horizontal(left, right, left_pressed, right_pressed, seconds)
        if cw {
            Rotate(1)
        }
        if ccw {
            if cw {
                Emit(2, 0, -1, 0, current)
            } else {
                Rotate(-1)
            }
        }
        if drop {
            HardDrop()
            return
        }
        if soft_pressed {
            // A short tap advances one cell. Holding continues at ten per
            // second, or the current gravity speed when that is faster.
            fall_clock = min(0.1, Rules.Gravity(self.BoardState.level))
        }
        Fall(seconds, soft)
    }

    function Emit(kind: int, result: int, direction: int, amount: int, detail: int) {
        Impact()
        record := self.ReactionQueue.write
        ReactionRules.Emit(self, kind, result, self.BoardState.impact_x, self.BoardState.impact_y, direction, amount, detail)
        CapturePiece(record, row)
    }

    function CapturePiece(record: entity, action_row: int) {
        minimum: int = 4
        maximum: int = 0
        for block in 0..3 {
            cell := Pieces.Cell(current, rotation, block)
            minimum = min(minimum, cell.x)
            maximum = max(maximum, cell.x)
            scale := PieceScale()
            face_z := PieceDepth() + 11 * block_depth * scale.z * cos(move_lean * 0.06)
            point := vec3(record.ReactionEvent.x + (cell.x - 1) * 24, 276 - (action_row + cell.y) * 24, face_z)
            match (block) {
                case 0 {
                    record.ReactionEvent.point0 = point
                }
                case 1 {
                    record.ReactionEvent.point1 = point
                }
                case 2 {
                    record.ReactionEvent.point2 = point
                }
                case 3 {
                    record.ReactionEvent.point3 = point
                }
            }
        }
        record.ReactionEvent.width = (maximum - minimum + 1) * 24
        record.ReactionEvent.center_offset = (minimum + maximum - 2) * 12
    }

    // Gameplay rows grow downward. The well stands in the world's XY plane.
    function Impact() {
        center := 0
        if world.Session.mode == 3 {
            center = -254 + self.BoardState.index * 508
        }
        self.BoardState.impact_x = center - 120 + (cast<number>(column) + 1.5) * 24
        self.BoardState.impact_y = 228 - (row - 1) * 24
    }

    function Hide(slot: int) {
        tile := get(tiles, slot)
        tile.RenderState.hidden = true
    }

    function Finish(tile: entity, active: bool) {
        emission := block_emission
        if active {
            emission += 0.035 + music_scale * 0.5 + action_flash * 0.1 * impact_gain
        }
        // The coat changes alpha; the mesh's inner BlockCore always writes depth.
        alpha := cast<uint>(cast<int>(floor(block_opacity * 255)))
        tile.Material.scene = (tile.Material.scene & 4294967040) | alpha
        tile.Material.emission_intensity = emission
        set_material_parameter(tile, "Opacity", block_opacity)
        set_material_parameter(tile, "Finish", vec3(block_roughness, block_metallic, emission))
    }

    function Tile(slot: int, x: number, y: number, size: number, color: uint, ghost: bool) {
        tile := get(tiles, slot)
        depth := size * block_depth
        z := 0
        scale := vec3(1, 1, 1)
        if slot >= 200 && slot < 204 {
            z = PieceDepth()
            scale = PieceScale()
        }
        target := vec3(x, 8 - y + well_sink, z)
        active := slot >= 200 && slot < 204
        if active {
            piece_targets[slot - 200] = target
        }
        if !active || tile.RenderState.hidden || piece_snap || world.Session.reduced_motion || world.Session.effects == 0 {
            tile.Transform3D.position = target
        } else {
            piece_moving = true
        }
        tile.RenderState.hidden = false
        tile.Transform3D.scale = scale
        tile.Transform3D.rotation = { x: 0, y: 0, z: 0, w: 1 }
        if slot >= 200 && slot < 204 {
            PieceRotation(tile)
        }
        tile.Geometry3D = { width: size, height: size, depth: depth }
        tile.Material.scene = color
        tile.Material.emission_color = color
        if ghost {
            tile.Geometry3D.primitive = 0
            tile.Geometry3D.width = 24
            tile.Geometry3D.height = 24
            tile.Geometry3D.depth = 0.2
            tile.Transform3D.position = { x: x, y: 8 - y + well_sink, z: -7 }
            tile.Material.scene = (color & 4294967040) | 112
            tile.Material.emission_intensity = 0.2
            return
        }
        tile.MeshAsset.source = "content/meshes/Block.mesh"
        rgba := cast<number>(color)
        red := floor(rgba / 16777216)
        green := floor(rgba / 65536) - red * 256
        blue := floor(rgba / 256) - floor(rgba / 65536) * 256
        // A spent hold preview dims its hue while retaining a solid body.
        brightness := 0.4 + 0.6 * (rgba - floor(rgba / 256) * 256) / 255
        tint := vec3(red / 255, green / 255, blue / 255) * brightness
        set_material_parameter(tile, "Tint", tint)
        set_material_parameter(tile, "Impact", 0)
        Finish(tile, slot >= 200 && slot < 204)
    }

    function StyleWeight(index: number) -> (weight: number) {
        distance := abs(style - index)
        distance = clamp(min(distance, 4 - distance), 0, 1)
        return 1 - distance * distance * (3 - 2 * distance)
    }

    function UpdateAppearance(seconds: number) {
        style_clock += seconds
        music_clock += seconds
        style = world.StageState.style
        if style_clock >= 0.25 || drawn_style < 0 {
            style_clock = 0
            if abs(style - drawn_style) > 0.004 {
                aurora := StyleWeight(0)
                petal := StyleWeight(1)
                dune := StyleWeight(2)
                orbit := StyleWeight(3)
                block_depth = aurora * 0.6 + petal * 0.82 + dune * 0.42 + orbit * 0.74
                base_finish = vec3(aurora * 0.54 + petal * 0.62 + dune * 0.66 + orbit * 0.5, aurora * 0.06 + petal * 0.1 + dune * 0.02 + orbit * 0.12, aurora * 0.025 + petal * 0.02 + dune * 0.018 + orbit * 0.03)
                base_opacity = aurora * 0.9 + petal * 0.92 + dune * 0.94 + orbit * 0.88
                drawn_style = style
                stack_dirty = true
                piece_dirty = true
                preview_dirty = true
                UpdateFinish()
            }
        }
        quiet := world.Session.reduced_motion || world.Session.effects == 0
        if quiet {
            if finish_signal.x + finish_signal.y + finish_signal.z + finish_character.x + finish_character.y + finish_character.z + finish_structure.x + finish_structure.y + finish_structure.z > 0 {
                finish_signal = vec3(0, 0, 0)
                finish_character = vec3(0, 0, 0)
                finish_structure = vec3(0, 0, 0)
                UpdateFinish()
            }
            if music_lift != 0 || music_scale != 0 {
                music_lift = 0
                music_scale = 0
                motion_dirty = true
            }
            return
        }
        if world.Session.screen == 1 {
            finish_clock += seconds
            if finish_clock >= 0.125 {
                signal := vec3(clamp(world.VisualState.bass, 0, 1), clamp(world.VisualState.energy * 0.6 + world.VisualState.mid * 0.4, 0, 1), clamp(world.VisualState.treble, 0, 1))
                blend := 1 - exp(-min(finish_clock, 0.25) * 6)
                activity := clamp(world.VisualState.energy * 2 + world.VisualState.bass * 0.4, 0, 1)
                finish_signal += (signal - finish_signal) * blend
                finish_character += (world.StageState.character * activity - finish_character) * blend
                finish_structure += (world.StageState.structure * activity - finish_structure) * blend
                finish_clock = 0
                UpdateFinish()
            }
        }
        if world.Session.screen != 1 || music_clock < 0.033333333 {
            return
        }
        elapsed := min(music_clock, 0.1)
        music_clock = 0
        pulse := clamp(world.VisualState.beat * 0.7 + world.VisualState.bass * 0.2 + world.VisualState.energy * 0.1, 0, 1)
        energy := clamp(world.VisualState.energy, 0, 1)
        lift := pulse * (2.6 + finish_character.x * 0.45) + energy * (finish_character.y * 0.75 + finish_character.z * 0.25)
        depth := pulse * 0.075 + energy * (finish_character.y * 0.018 + finish_character.z * 0.008)
        blend := 1 - exp(-elapsed * (18 + finish_character.x * 4 - finish_character.y * 8))
        music_lift += (lift - music_lift) * blend
        music_scale += (min(depth, 0.095) - music_scale) * blend
        motion_dirty = true
    }

    function UpdateFinish() {
        roughness := clamp(base_finish.x - finish_signal.y * 0.08 + finish_signal.z * 0.035 + finish_character.x * 0.035 - finish_character.y * 0.14 + finish_character.z * 0.09 + finish_structure.x * 0.02, 0.14, 0.78)
        metallic := clamp(base_finish.y + finish_signal.x * 0.07 + finish_signal.z * 0.04 + finish_character.x * 0.02 + finish_character.y * 0.14 - finish_character.z * 0.035 + finish_structure.y * 0.025, 0, 0.72)
        emission := base_finish.z + finish_signal.y * 0.025 + finish_signal.x * 0.015 + finish_character.y * 0.018 + finish_character.z * 0.006 + finish_structure.x * 0.004 + finish_structure.z * 0.004
        impact := clamp(1 + finish_character.x * 0.18 - finish_character.y * 0.14 - finish_character.z * 0.04 + finish_structure.x * 0.04 + finish_structure.y * 0.03 + finish_structure.z * 0.05, 0.8, 1.24)
        opacity := clamp(base_opacity + finish_signal.x * 0.015 - finish_signal.z * 0.01, 0.84, 0.96)
        if abs(roughness - block_roughness) + abs(metallic - block_metallic) + abs(emission - block_emission) + abs(opacity - block_opacity) + abs(impact - impact_gain) < 0.0001 {
            return
        }
        block_roughness = roughness
        block_metallic = metallic
        block_emission = emission
        block_opacity = opacity
        impact_gain = impact
        finish_dirty = true
    }

    // Eight finish updates per second touch visible meshes, without grid or landing queries.
    function FinishStillBlocks() {
        for tile in settled_tiles {
            Finish(tile, false)
        }
        for tile in preview_tiles {
            Finish(tile, false)
        }
        finish_dirty = false
    }

    // Input impulses retain their current value when another action arrives.
    function Action(flash: number, move: number, turn: number) {
        if world.Session.reduced_motion || world.Session.effects == 0 {
            return
        }
        action_drive = min(1, action_drive + flash)
        move_drive = clamp(move_drive + move, -1, 1)
        turn_drive = clamp(turn_drive + turn, -1, 1)
    }

    function AdvanceAction(seconds: number) {
        if world.Session.screen == 2 || world.Session.screen == 3 {
            return
        }
        old := action_flash + abs(move_lean) + abs(turn_lean)
        if world.Session.reduced_motion || world.Session.effects == 0 {
            action_drive = 0
            action_flash = 0
            move_drive = 0
            move_lean = 0
            turn_drive = 0
            turn_lean = 0
        } else {
            action_flash += (action_drive - action_flash) * (1 - exp(-seconds * 70))
            move_lean += (move_drive - move_lean) * (1 - exp(-seconds * 75))
            turn_lean += (turn_drive - turn_lean) * (1 - exp(-seconds * 55))
            action_drive *= exp(-seconds * 32)
            move_drive *= exp(-seconds * 48)
            turn_drive *= exp(-seconds * 28)
        }
        if old > 0.00001 || action_flash + abs(move_lean) + abs(turn_lean) > 0.00001 {
            motion_dirty = true
        }
    }

    // One render offset carries the well, cells, ghost and previews together.
    // Game coordinates stay fixed; exact critical damping retains overlapping weight.
    function AdvanceWell(seconds: number) {
        if world.Session.screen == 2 || world.Session.screen == 3 {
            return
        }
        previous := well_sink
        if world.Session.reduced_motion || world.Session.effects == 0 {
            well_sink = 0
            well_velocity = 0
        } else {
            decay := exp(-seconds * 12)
            step := (well_velocity + well_sink * 12) * seconds
            well_sink = (well_sink + step) * decay
            well_velocity = (well_velocity - step * 12) * decay
        }
        if visible {
            self.Transform3D.position = vec3(origin + 120, well_sink, -16)
        }
        shift := well_sink - previous
        if shift == 0 {
            return
        }
        for tile in tiles {
            if !tile.RenderState.hidden {
                position := tile.Transform3D.position
                position.y += shift
                tile.Transform3D.position = position
            }
        }
        for i in 0..3 {
            target := get(piece_targets, i)
            target.y += shift
            piece_targets[i] = target
        }
    }

    function PieceDepth() -> (depth: number) {
        return 3 + music_lift + action_flash * 0.6
    }

    function PieceScale() -> (scale: CF_V3) {
        return vec3(1 + music_scale * 0.25 + action_flash * 0.018,
        1 - music_scale * 0.4 - action_flash * 0.012,
        1 + music_scale - action_flash * 0.09)
    }

    function PieceRotation(tile: entity) {
        yaw := move_lean * 0.03
        roll := turn_lean * 0.0225
        tile.Transform3D.rotation = { x: -sin(yaw) * sin(roll), y: sin(yaw) * cos(roll), z: cos(yaw) * sin(roll), w: cos(yaw) * cos(roll) }
    }

    function Contact(tile: entity) {
        if world.Session.reduced_motion || world.Session.effects == 0 {
            return
        }
        contact_tiles = array_add(contact_tiles, tile)
        contact_drives = array_add(contact_drives, 1)
        contact_flashes = array_add(contact_flashes, 0)
    }

    function ClearContacts() {
        for tile in contact_tiles {
            tile.Transform3D.scale = vec3(1, 1, 1)
            Finish(tile, false)
        }
        contact_tiles = []
        contact_drives = []
        contact_flashes = []
    }

    function AdvanceContacts(seconds: number) {
        if world.Session.screen == 2 || world.Session.screen == 3 {
            return
        }
        if world.Session.reduced_motion || world.Session.effects == 0 {
            ClearContacts()
            return
        }
        index := length(contact_tiles) - 1
        while index >= 0 {
            tile := get(contact_tiles, index)
            drive := get(contact_drives, index)
            flash := get(contact_flashes, index)
            flash += (drive - flash) * (1 - exp(-seconds * 80))
            drive *= exp(-seconds * 35)
            contact_drives[index] = drive
            contact_flashes[index] = flash
            Finish(tile, false)
            tile.Transform3D.scale = vec3(1 + flash * 0.015, 1, 1 - flash * 0.1)
            emission := block_emission + flash * 0.11 * impact_gain
            tile.Material.emission_intensity = emission
            set_material_parameter(tile, "Finish", vec3(block_roughness, block_metallic, emission))
            if flash < 0.0001 {
                tile.Transform3D.scale = vec3(1, 1, 1)
                Finish(tile, false)
                contact_tiles = remove_index(contact_tiles, index)
                contact_drives = remove_index(contact_drives, index)
                contact_flashes = remove_index(contact_flashes, index)
            }
            index -= 1
        }
    }

    function ClearRipples() {
        for i in 0..3 {
            ripple_sources[i] = vec3(0, 0, 1.4)
            ripple_strengths[i] = 0
        }
        for tile in settled_tiles {
            set_material_parameter(tile, "Impact", 0)
            Finish(tile, false)
        }
        rippling = false
    }

    // The center uses the landed cells, independent of the next piece or recoil.
    function Ripple() {
        center := vec3(0, 0, 0)
        for i in 0..3 {
            cell := Pieces.Cell(current, rotation, i)
            center += vec3(origin + (column + cell.x) * 24 + 12, 276 - (row + cell.y) * 24, 0) * 0.25
        }
        chosen: int = -1
        nearest: int = 0
        distance := 1000000
        for i in 0..3 {
            source := get(ripple_sources, i)
            if source.z >= 1.4 && chosen < 0 {
                chosen = i
            }
            squared := (source.x - center.x) * (source.x - center.x) + (source.y - center.y) * (source.y - center.y)
            if squared < distance {
                distance = squared
                nearest = i
            }
        }
        if chosen < 0 {
            ripple_strengths[nearest] = min(1.5, get(ripple_strengths, nearest) + 0.4)
        } else {
            ripple_sources[chosen] = center
            ripple_strengths[chosen] = 1
        }
        rippling = true
    }

    function AdvanceRipples(seconds: number) {
        if !rippling || world.Session.screen == 2 {
            return
        }
        if world.Session.reduced_motion || world.Session.effects == 0 {
            ClearRipples()
            return
        }
        alive := false
        for i in 0..3 {
            source := get(ripple_sources, i)
            source.z = min(1.4, source.z + seconds)
            ripple_sources[i] = source
            alive = alive || source.z < 1.4
        }
        for tile in settled_tiles {
            position := tile.Transform3D.position
            position.y -= well_sink
            light := 0
            for i in 0..3 {
                source := get(ripple_sources, i)
                if source.z >= 1.4 {
                    continue
                }
                x := position.x - source.x
                y := position.y - source.y
                age := source.z - sqrt(x * x + y * y) / 650
                attack := clamp(age / 0.055, 0, 1)
                light += get(ripple_strengths, i) * attack * attack * (3 - 2 * attack) * exp(-max(0, age - 0.055) * 7)
            }
            flash := light / (1 + light * 0.35) * impact_gain
            set_material_parameter(tile, "Impact", flash)
            tile.Material.emission_intensity = block_emission + flash * 0.9
        }
        rippling = alive
    }

    // Ease accepted cell endpoints without delaying collision, scoring or the ghost.
    function AnimatePiece(seconds: number) {
        if world.Session.screen == 2 || world.Session.screen == 3 {
            return
        }
        piece_moving = false
        for slot in 200..203 {
            tile := get(tiles, slot)
            if tile.RenderState.hidden {
                continue
            }
            position := tile.Transform3D.position
            target := get(piece_targets, slot - 200)
            blend := 1 - exp(-seconds * 48)
            if world.Session.reduced_motion || world.Session.effects == 0 {
                blend = 1
            }
            position += (target - position) * blend
            if abs(target.x - position.x) + abs(target.y - position.y) < 0.02 {
                position = target
            } else {
                piece_moving = true
            }
            position.z = PieceDepth()
            tile.Transform3D.position = position
            tile.Transform3D.scale = PieceScale()
            PieceRotation(tile)
            Finish(tile, true)
        }
        motion_dirty = false
    }

    function DrawStack() {
        settled_tiles = []
        for (i in 0..199) {
            y := i / 10 + 2
            kind := get(grid, i + 20)
            // Loss preserves the scoring grid after its visible bodies retire.
            if kind == 0 || loss_finished {
                Hide(i)
                continue
            }
            color := Pieces.Color(kind)
            Tile(i, origin + i % 10 * 24 + 12, -232 + (y - 2) * 24 + 12, 22, color, false)
            settled_tiles = array_add(settled_tiles, get(tiles, i))
        }
        stack_dirty = false
    }

    function DrawPiece() {
        ghost_row := Rules.Landing(grid, current, rotation, column, row)
        self.BoardState.ghost_row = ghost_row
        for (i in 0..3) {
            Hide(204 + i)
            if self.BoardState.topout {
                Hide(200 + i)
            } else {
                cell := Pieces.Cell(current, rotation, i)
                x := origin + (column + cell.x) * 24 + 12
                if row + cell.y >= 2 {
                    Tile(200 + i, x, -232 + (row + cell.y - 2) * 24 + 12, 22, Pieces.Color(current), false)
                } else {
                    Hide(200 + i)
                }
                if world.Session.ghost && ghost_row > row && ghost_row + cell.y >= 2 {
                    Tile(204 + i, x, -232 + (ghost_row + cell.y - 2) * 24 + 12, 22, Pieces.Color(current), true)
                    set_material_parameter(get(tiles, 204 + i), "Edges", Pieces.ExposedEdges(current, rotation, i))
                }
            }
        }
        piece_dirty = false
        motion_dirty = false
        piece_snap = false
    }

    function Preview(first: int, kind: int, x: number, y: number, dim: bool) {
        for (i in 0..3) {
            Hide(first + i)
            if kind > 0 {
                cell := Pieces.Cell(kind, 0, i)
                center_x := 1
                center_y := 0.5
                if kind == 1 || kind == 2 {
                    center_x = 1.5
                }
                if kind == 1 {
                    center_y = 1
                }
                color := Pieces.Color(kind)
                if dim {
                    color = (color & 4294967040) | 100
                }
                Tile(first + i, x + (cell.x - center_x) * 18, y + (cell.y - center_y) * 18, 16, color, false)
                preview_tiles = array_add(preview_tiles, get(tiles, first + i))
            }
        }
    }

    function DrawPreviews() {
        preview_tiles = []
        if (world.Session.screen != 1 && world.Session.screen != 4) || world.Session.entering {
            for i in 208..231 {
                Hide(i)
            }
            preview_dirty = false
            return
        }
        Preview(208, held, origin - 70, -186, hold_used)
        for (i in 0..4) {
            Preview(212 + i * 4, get(queue, i), origin + 310, -182 + i * 78, false)
        }
        preview_dirty = false
    }

    // Keep the scoring grid and each block's material intact. Released bodies
    // use their grid position as an analytic base, never last frame's offset.
    function Loss(age: number) {
        if loss_finished {
            return
        }
        quiet := world.Session.reduced_motion || world.Session.effects == 0
        if quiet {
            loss_row = 22
        }
        if !quiet {
            while loss_row <= 21 && age >= 0.7 + cast<number>(loss_row - 2) * 0.0125 {
                mask: int = 0
                for x in 0..9 {
                    if get(grid, loss_row * 10 + x) != 0 {
                        mask = mask | 1 << x
                    }
                }
                if mask != 0 {
                    record := self.ReactionQueue.write
                    ReactionRules.Emit(self, 22, 1, origin + 120, 276 - loss_row * 24, 0, loss_row, mask)
                    record.ReactionEvent.point0 = vec3(0, 0, 11 * block_depth)
                }
                loss_row += 1
            }
        }
        remaining := false
        for i in 0..199 {
            tile := get(tiles, i)
            if tile.RenderState.hidden {
                continue
            }
            start := 0.7 + cast<number>(i / 10) * 0.0125
            flight := max(0, age - start)
            index := cast<number>(i + self.BoardState.index * 200)
            base := vec3(origin + i % 10 * 24 + 12, 228 - i / 10 * 24 + well_sink, 0)
            radial := vec3((base.x - origin - 120) / 120, (base.y - well_sink) / 240, 0)
            radial = radial * (1 / sqrt(radial.x * radial.x + radial.y * radial.y))
            curl := sin(index * 1.91) * 0.18
            velocity := vec3((radial.x - radial.y * curl) * 260, (radial.y + radial.x * curl) * 150, sin(index * 2.37 + 0.7) * 145)
            // Expand across and through the well, with no shared upward drift.
            tile.Transform3D.position = base + velocity * (flight + flight * flight * 0.45)
            yaw := flight * (0.7 + sin(index * 1.7) * 0.5)
            roll := flight * (0.45 + cos(index * 1.3) * 0.7)
            tile.Transform3D.rotation = { x: -sin(yaw) * sin(roll), y: sin(yaw) * cos(roll), z: cos(yaw) * sin(roll), w: cos(yaw) * cos(roll) }
            retired := flight >= 1.8
            if quiet {
                tile.Transform3D.position = base
                tile.Transform3D.rotation = { x: 0, y: 0, z: 0, w: 1 }
                retired = age >= 0.3
            }
            tile.Transform3D.scale = vec3(1, 1, 1)
            if retired {
                tile.RenderState.hidden = true
                continue
            }
            remaining = true
        }
        loss_finished = !remaining
    }

    function Render(seconds: number) {
        show := world.Session.attract || world.Session.screen >= 1 && world.Session.screen <= 4
        if world.Session.journey && world.Session.journey_time >= 0.8 && world.Session.journey_time <= 1.8 {
            show = false
        }
        if self.BoardState.index == 1 && world.Session.mode != 3 {
            show = false
        }
        if !show {
            if visible {
                for (i in 0..231) {
                    Hide(i)
                }
            }
            self.RenderState.hidden = true
            self.Transform3D.scale = vec3(0, 0, 0)
            visible = false
            return
        }
        if !visible || old_mode != world.Session.mode {
            origin = -120
            if world.Session.mode == 3 {
                origin = -374 + self.BoardState.index * 508
            }
            self.Transform3D.position = { x: origin + 120, y: 0, z: -16 }
            self.RenderState.hidden = false
            self.Transform3D.scale = vec3(1, 1, 1)
            stack_dirty = true
            piece_dirty = true
            preview_dirty = true
        }
        if old_ghost != world.Session.ghost || old_effects != world.Session.effects {
            piece_dirty = true
        }
        visible = true
        old_mode = world.Session.mode
        old_ghost = world.Session.ghost
        old_effects = world.Session.effects
        if stack_dirty {
            DrawStack()
        }
        if piece_dirty {
            DrawPiece()
        }
        if motion_dirty || finish_dirty || piece_moving {
            AnimatePiece(seconds)
        }
        if preview_dirty {
            DrawPreviews()
        }
        if finish_dirty {
            FinishStillBlocks()
        }
    }

    on Tick(dt) {
        if !self.BoardState.ready {
            return
        }
        restarted := seen_run != world.Session.run
        if restarted {
            Reset()
        }
        request := world.Session.rescue1
        if self.BoardState.index == 1 {
            request = world.Session.rescue2
        }
        if request != seen_rescue {
            seen_rescue = request
            Rescue()
        }
        level := 1 + self.BoardState.lines / 10
        if world.Session.mode == 0 {
            level = max(1, world.Session.stage + 1)
        }
        self.BoardState.level = level
        enabled := self.BoardState.index == 0 || world.Session.mode == 3
        if world.Session.departing && enabled && !loss_started {
            BeginDeparture()
        }
        if world.Session.attract && !world.Session.entering && self.BoardState.index == 0 {
            Demo(min(dt, 0.1))
        }
        if world.Session.screen == 1 && old_screen == 1 && !world.Session.entering && !world.Session.journey && !restarted && enabled && !self.BoardState.topout {
            Controls(min(dt, 0.1))
        }
        if world.Session.screen != 1 {
            if soft_held {
                Emit(5, 1, 0, 0, current)
                soft_held = false
                fall_clock = 0
            }
            repeat_blocked = false
            repeat_direction = 0
            repeat_clock = 0
        }
        if old_screen != world.Session.screen || old_entering != world.Session.entering {
            preview_dirty = true
        }
        old_screen = world.Session.screen
        old_entering = world.Session.entering
        self.BoardState.current = current
        self.BoardState.held = held
        self.BoardState.can_hold = !hold_used
        self.BoardState.column = column
        self.BoardState.row = row
        self.BoardState.rotation = rotation
        AdvanceAction(min(dt, 0.05))
        if !loss_started && world.Session.screen != 4 {
            UpdateAppearance(min(dt, 0.1))
        }
        Render(min(dt, 0.05))
        AdvanceWell(min(dt, 0.05))
        AdvanceContacts(min(dt, 0.05))
        AdvanceRipples(min(dt, 0.05))
        if world.Session.screen == 4 {
            loss_started = true
        }
        if loss_started {
            age := world.Session.loss_time
            if world.Session.departing {
                age = world.Session.intro_time
            }
            Loss(age)
        }
    }
}
