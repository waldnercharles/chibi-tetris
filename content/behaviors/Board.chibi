behavior Board {
    world: entity
    tiles: entity[] = []
    grid: int[] = []
    queue: int[] = []
    clear_rows: int[] = []
    seed: int64 = 1
    seen_run: int = -1
    seen_rescue: int = 0
    current: int = 0
    held: int = 0
    column: int = 3
    row: int = 1
    rotation: int = 0
    last_kick: int = 0
    rotated := false
    hold_used := false
    fall_clock := 0
    lock_clock := 0
    lock_started := false
    lock_resets: int = 0
    repeat_blocked := false
    soft_held := false
    repeat_direction: int = 0
    repeat_clock := 0
    next_repeat := 0
    flash := 0
    visible := false
    old_mode: int = -1
    old_screen: int = 0
    old_ghost := false
    old_effects: int = -1
    stack_dirty := true
    piece_dirty := true
    preview_dirty := true
    origin := -120

    on Begin {
        world = get_global_variable("World")
        for (i in 0..231) {
            if i >= 204 && i < 208 {
                ghost := await spawn(BlockRim)
                tiles = array_add(tiles, ghost)
            } else {
                tile := await spawn(Block)
                tiles = array_add(tiles, tile)
            }
        }
        self.BoardState.ready = true
    }

    function FillQueue() {
        if length(queue) < 6 {
            queue = append(queue, Pieces.Bag(seed))
        }
    }

    function Next() -> (kind: int) {
        FillQueue()
        kind = get(queue, 0)
        queue = remove_index(queue, 0)
        FillQueue()
        preview_dirty = true
        return kind
    }

    function TopOut() {
        if self.BoardState.topout {
            return
        }
        Emit(11, 1, 0, 0, current)
        if soft_held {
            Emit(5, 1, 0, 0, current)
            soft_held = false
        }
        self.BoardState.topout = true
        piece_dirty = true
        play_sound("topout", 0.45)
    }

    function SpawnPiece(kind: int) {
        current = kind
        column = 3
        row = 1
        rotation = 0
        rotated = false
        last_kick = 0
        fall_clock = 0
        lock_clock = 0
        lock_started = false
        lock_resets = 0
        piece_dirty = true
        if !Rules.Fits(grid, current, rotation, column, row) {
            TopOut()
        }
    }

    function Reset() {
        seen_run = world.Session.run
        ReactionRules.Initialize(self, seen_run)
        grid = Rules.Empty()
        queue = []
        clear_rows = []
        seed = cast<int64>(world.Session.seed) % 2147483646
        if seed < 0 {
            seed = -seed
        }
        seed += 1
        held = 0
        hold_used = false
        repeat_blocked = false
        soft_held = false
        repeat_direction = 0
        repeat_clock = 0
        flash = 0
        seen_rescue = world.Session.rescue1
        if self.BoardState.index == 1 {
            seen_rescue = world.Session.rescue2
        }
        self.BoardState.score = 0
        self.BoardState.lines = 0
        self.BoardState.level = 1
        self.BoardState.topout = false
        self.BoardState.pieces = 0
        self.BoardState.combo = -1
        self.BoardState.last_clear = 0
        self.BoardState.clear_serial = 0
        self.BoardState.back_to_back = false
        self.BoardState.spin = 0
        self.BoardState.move_serial = 0
        self.BoardState.rotate_serial = 0
        self.BoardState.hold_serial = 0
        self.BoardState.drop_serial = 0
        self.BoardState.drop_distance = 0
        stack_dirty = true
        preview_dirty = true
        SpawnPiece(Next())
    }

    function Rescue() {
        Emit(12, 1, 0, 6, current)
        Rules.Rescue(grid)
        self.BoardState.topout = false
        self.BoardState.combo = -1
        hold_used = false
        flash = 0
        clear_rows = []
        stack_dirty = true
        preview_dirty = true
        SpawnPiece(current)
        play_sound("rescue", 0.5)
    }

    function ResetLock(grounded: bool) {
        if !grounded || lock_resets >= 15 {
            return
        }
        lock_clock = 0
        lock_resets += 1
    }

    function Shift(direction: int, explicit: bool) -> (moved: bool) {
        if !Rules.Fits(grid, current, rotation, column + direction, row) {
            if explicit || !repeat_blocked {
                Emit(1, 0, direction, 0, current)
            }
            repeat_blocked = true
            return false
        }
        grounded := !Rules.Fits(grid, current, rotation, column, row + 1)
        column += direction
        repeat_blocked = false
        rotated = false
        ResetLock(grounded)
        piece_dirty = true
        Emit(1, 1, direction, 1, current)
        self.BoardState.move_serial += 1
        Impact()
        return true
    }

    function Rotate(direction: int) {
        result := Rules.Rotate(grid, current, rotation, column, row, direction)
        if !result.success {
            Emit(2, 0, direction, 0, current)
            return
        }
        grounded := !Rules.Fits(grid, current, rotation, column, row + 1)
        column = result.column
        row = result.row
        rotation = result.facing
        last_kick = result.kick
        rotated = true
        ResetLock(grounded)
        piece_dirty = true
        Emit(2, 1, direction, result.kick, current)
        self.BoardState.rotate_serial += 1
        Impact()
        play_sound("rotate", 0.2)
    }

    function Hold() {
        if hold_used {
            Emit(7, 0, 0, 0, current)
            return
        }
        Emit(7, 1, 0, held, current)
        replacement := held
        held = current
        if replacement == 0 {
            replacement = Next()
        }
        SpawnPiece(replacement)
        hold_used = true
        preview_dirty = true
        self.BoardState.hold_serial += 1
        Impact()
        play_sound("hold", 0.3)
    }

    function Lock() {
        Impact()
        spin := Rules.Spin(grid, current, rotation, column, row, rotated, last_kick)
        any_visible := Rules.Place(grid, current, rotation, column, row)
        clear_rows = Rules.FullRows(grid)
        count := length(clear_rows)
        Emit(8, 1, 0, spin, current)
        Rules.Award(self, count, spin)
        if count > 0 {
            mask: int = 0
            for (cleared in clear_rows) {
                mask = mask | 1 << cleared
            }
            Emit(9, 1, 0, count, mask)
            if self.BoardState.combo > 0 {
                Emit(10, 1, 0, self.BoardState.combo, mask)
            }
            Rules.Collapse(grid, clear_rows)
            flash = 0.14
            if world.Session.reduced_motion || world.Session.effects == 0 {
                flash = 0
            }
            match (count) {
                case 1 {
                    play_sound("clear1", 0.42)
                }
                case 2 {
                    play_sound("clear2", 0.48)
                }
                case 3 {
                    play_sound("clear2", 0.55)
                }
                case 4 {
                    play_sound("clear4", 0.6)
                }
            }
        }
        if count == 0 {
            play_sound("lock", 0.25)
        }
        stack_dirty = true
        hold_used = false
        if !any_visible && count == 0 {
            TopOut()
            return
        }
        SpawnPiece(Next())
    }

    function HardDrop() {
        landing := Rules.Landing(grid, current, rotation, column, row)
        distance := landing - row
        Emit(6, 1, 0, distance, current)
        self.BoardState.score += distance * 2
        if distance > 0 {
            rotated = false
        }
        row = landing
        self.BoardState.drop_serial += 1
        self.BoardState.drop_distance = distance
        Impact()
        play_sound("hard_drop", 0.35)
        Lock()
    }

    function Horizontal(left: bool, right: bool, left_pressed: bool, right_pressed: bool, seconds: number) {
        direction: int = 0
        if left {
            direction = -1
        }
        if right {
            direction = 1
        }
        if left && right {
            direction = repeat_direction
            if left_pressed {
                direction = -1
            }
            if right_pressed {
                direction = 1
            }
        }
        if left_pressed && right_pressed {
            Emit(1, 0, -1, 0, current)
        }
        if direction == 0 {
            repeat_blocked = false
            repeat_direction = 0
            repeat_clock = 0
            return
        }
        if direction != repeat_direction || left_pressed || right_pressed {
            repeat_blocked = false
            repeat_direction = direction
            repeat_clock = 0
            next_repeat = max(0, world.Session.das)
            if Shift(direction, true) {
                play_sound("move", 0.15)
            }
            return
        }
        repeat_clock += seconds
        if repeat_clock < next_repeat {
            return
        }
        arr := max(0, world.Session.arr)
        moved := false
        for (step in 0..9) {
            if arr > 0 && repeat_clock < next_repeat {
                break
            }
            if !Shift(direction, false) {
                next_repeat = repeat_clock + arr
                break
            }
            moved = true
            next_repeat += arr
        }
        if moved {
            play_sound("move", 0.15)
        }
    }

    function Fall(seconds: number, soft: bool) {
        interval := Rules.Gravity(self.BoardState.level)
        if soft {
            interval = min(0.02, interval / 20)
        }
        start_row := row
        fall_clock += seconds
        for (step in 0..21) {
            if fall_clock < interval {
                break
            }
            if !Rules.Fits(grid, current, rotation, column, row + 1) {
                fall_clock = 0
                break
            }
            row += 1
            fall_clock -= interval
            rotated = false
            piece_dirty = true
            if soft {
                self.BoardState.score += 1
            }
        }
        if soft && row > start_row {
            Impact()
            record := self.ReactionQueue.write
            ReactionRules.Emit(self, 4, 1, self.BoardState.impact_x, 228 - (start_row - 1) * 24, 1, row - start_row, current)
            CaptureSpan(record)
        }
        grounded := !Rules.Fits(grid, current, rotation, column, row + 1)
        if grounded {
            lock_started = true
        }
        if lock_started {
            lock_clock += seconds
        }
        if grounded && lock_clock >= 0.5 {
            Lock()
        }
    }

    function Controls(seconds: number) {
        left := input.P1Left.held
        right := input.P1Right.held
        left_pressed := input.P1Left.pressed
        right_pressed := input.P1Right.pressed
        soft := input.P1Soft.held
        drop := input.P1Drop.pressed
        cw := input.P1CW.pressed
        ccw := input.P1CCW.pressed
        hold := input.P1Hold.pressed
        if self.BoardState.index == 1 {
            left = input.P2Left.held
            right = input.P2Right.held
            left_pressed = input.P2Left.pressed
            right_pressed = input.P2Right.pressed
            soft = input.P2Soft.held
            drop = input.P2Drop.pressed
            cw = input.P2CW.pressed
            ccw = input.P2CCW.pressed
            hold = input.P2Hold.pressed
        }
        if soft != soft_held {
            soft_held = soft
            if soft {
                accepted := ReactionRules.Flag(Rules.Fits(grid, current, rotation, column, row + 1))
                Emit(3, accepted, 1, 0, current)
            } else {
                Emit(5, 1, 0, 0, current)
            }
        }
        if hold {
            Hold()
        }
        if self.BoardState.topout {
            return
        }
        Horizontal(left, right, left_pressed, right_pressed, seconds)
        if cw {
            Rotate(1)
        }
        if ccw {
            if cw {
                Emit(2, 0, -1, 0, current)
            } else {
                Rotate(-1)
            }
        }
        if drop {
            HardDrop()
            return
        }
        Fall(seconds, soft)
    }

    function Emit(kind: int, result: int, direction: int, amount: int, detail: int) {
        Impact()
        record := self.ReactionQueue.write
        ReactionRules.Emit(self, kind, result, self.BoardState.impact_x, self.BoardState.impact_y, direction, amount, detail)
        CaptureSpan(record)
    }

    function CaptureSpan(record: entity) {
        minimum: int = 4
        maximum: int = 0
        for block in 0..3 {
            cell := Pieces.Cell(current, rotation, block)
            minimum = min(minimum, cell.x)
            maximum = max(maximum, cell.x)
        }
        record.ReactionEvent.width = (maximum - minimum + 1) * 24
        record.ReactionEvent.center_offset = (minimum + maximum - 2) * 12
    }

    // Gameplay rows grow downward. The well stands in the world's XY plane.
    function Impact() {
        center := 0
        if world.Session.mode == 3 {
            center = -254 + self.BoardState.index * 508
        }
        self.BoardState.impact_x = center - 120 + (cast<number>(column) + 1.5) * 24
        self.BoardState.impact_y = 228 - (row - 1) * 24
    }

    function Hide(slot: int) {
        tile := get(tiles, slot)
        tile.RenderState.hidden = true
    }

    function Tile(slot: int, x: number, y: number, size: number, color: uint, ghost: bool) {
        tile := get(tiles, slot)
        depth := size * 0.68
        z := 0
        emission := 0.22
        if slot >= 200 && slot < 204 {
            z = 3
            emission = 0.46
        }
        tile.RenderState.hidden = false
        tile.Transform3D.position = { x: x, y: 8 - y, z: z }
        tile.Geometry3D = { width: size, height: size, depth: depth }
        tile.Material.scene = color
        tile.Material.emission_color = color
        tile.Material.emission_intensity = emission
        if ghost {
            tile.Geometry3D.primitive = 8
            tile.Geometry3D.depth = 1.2
            tile.Transform3D.position = { x: x, y: 8 - y, z: -7 }
            tile.Material.scene = (color & 4294967040) | 112
            tile.Material.emission_intensity = 0.2
        }
    }

    function DrawStack() {
        for (i in 0..199) {
            y := i / 10 + 2
            kind := get(grid, i + 20)
            clearing := flash > 0 && contains(clear_rows, y)
            if kind == 0 && !clearing {
                Hide(i)
                continue
            }
            color := Pieces.Color(kind)
            if clearing {
                color = 3824283391
            }
            Tile(i, origin + i % 10 * 24 + 12, -232 + (y - 2) * 24 + 12, 22, color, false)
        }
        stack_dirty = false
    }

    function DrawPiece() {
        ghost_row := Rules.Landing(grid, current, rotation, column, row)
        self.BoardState.ghost_row = ghost_row
        for (i in 0..3) {
            Hide(200 + i)
            Hide(204 + i)
            if !self.BoardState.topout {
                cell := Pieces.Cell(current, rotation, i)
                x := origin + (column + cell.x) * 24 + 12
                if row + cell.y >= 2 {
                    Tile(200 + i, x, -232 + (row + cell.y - 2) * 24 + 12, 22, Pieces.Color(current), false)
                }
                if world.Session.ghost && ghost_row > row && ghost_row + cell.y >= 2 {
                    Tile(204 + i, x, -232 + (ghost_row + cell.y - 2) * 24 + 12, 22, Pieces.Color(current), true)
                }
            }
        }
        piece_dirty = false
    }

    function Preview(first: int, kind: int, x: number, y: number, dim: bool) {
        for (i in 0..3) {
            Hide(first + i)
            if kind > 0 {
                cell := Pieces.Cell(kind, 0, i)
                center_x := 1
                center_y := 0.5
                if kind == 1 || kind == 2 {
                    center_x = 1.5
                }
                if kind == 1 {
                    center_y = 1
                }
                color := Pieces.Color(kind)
                if dim {
                    color = (color & 4294967040) | 100
                }
                Tile(first + i, x + (cell.x - center_x) * 18, y + (cell.y - center_y) * 18, 16, color, false)
            }
        }
    }

    function DrawPreviews() {
        if world.Session.screen != 1 {
            for i in 208..231 {
                Hide(i)
            }
            preview_dirty = false
            return
        }
        Preview(208, held, origin - 70, -186, hold_used)
        for (i in 0..4) {
            Preview(212 + i * 4, get(queue, i), origin + 310, -182 + i * 78, false)
        }
        preview_dirty = false
    }

    function Render() {
        show := world.Session.screen >= 1 && world.Session.screen <= 3
        if self.BoardState.index == 1 && world.Session.mode != 3 {
            show = false
        }
        if !show {
            if visible {
                for (i in 0..231) {
                    Hide(i)
                }
            }
            self.RenderState.hidden = true
            self.Transform3D.scale = vec3(0, 0, 0)
            visible = false
            return
        }
        if !visible || old_mode != world.Session.mode {
            origin = -120
            if world.Session.mode == 3 {
                origin = -374 + self.BoardState.index * 508
            }
            self.Transform3D.position = { x: origin + 120, y: 0, z: -16 }
            self.RenderState.hidden = false
            self.Transform3D.scale = vec3(1, 1, 1)
            stack_dirty = true
            piece_dirty = true
            preview_dirty = true
        }
        if old_ghost != world.Session.ghost || old_effects != world.Session.effects {
            piece_dirty = true
        }
        visible = true
        old_mode = world.Session.mode
        old_ghost = world.Session.ghost
        old_effects = world.Session.effects
        if stack_dirty {
            DrawStack()
        }
        if piece_dirty {
            DrawPiece()
        }
        if preview_dirty {
            DrawPreviews()
        }
    }

    on Tick(dt) {
        if !self.BoardState.ready {
            return
        }
        restarted := seen_run != world.Session.run
        if restarted {
            Reset()
        }
        request := world.Session.rescue1
        if self.BoardState.index == 1 {
            request = world.Session.rescue2
        }
        if request != seen_rescue {
            seen_rescue = request
            Rescue()
        }
        if flash > 0 {
            flash -= min(dt, 0.1)
            if flash <= 0 {
                stack_dirty = true
            }
        }
        level := 1 + self.BoardState.lines / 10
        if world.Session.mode == 0 {
            level = max(1, world.Session.stage + 1)
        }
        self.BoardState.level = level
        enabled := self.BoardState.index == 0 || world.Session.mode == 3
        if world.Session.screen == 1 && old_screen == 1 && !restarted && enabled && !self.BoardState.topout {
            Controls(min(dt, 0.1))
        }
        if world.Session.screen != 1 {
            if soft_held {
                Emit(5, 1, 0, 0, current)
                soft_held = false
            }
            repeat_blocked = false
            repeat_direction = 0
            repeat_clock = 0
        }
        if old_screen != world.Session.screen {
            preview_dirty = true
        }
        old_screen = world.Session.screen
        self.BoardState.current = current
        self.BoardState.held = held
        self.BoardState.can_hold = !hold_used
        self.BoardState.column = column
        self.BoardState.row = row
        self.BoardState.rotation = rotation
        Render()
    }
}
