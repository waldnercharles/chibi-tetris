version 1
name "Stillwater"
(array)entities {
    - name="World" prototype="World"
    - name="Camera" prototype="Camera"
    - name="Environment" prototype="Environment"
    - {
        name "Board1"
        prototype "Board"
        components {
            GlobalBinding name="Board1"
            BoardState index=0
        }
    }
    - {
        name "Board2"
        prototype "Board"
        components {
            GlobalBinding name="Board2"
            BoardState index=1
        }
    }
}
