version 1
name "Stillwater"
presentation "3d"
(array)entities {
    - name="World" prototype="World"
    - name="Camera" prototype="Camera"
    - name="Environment" prototype="Environment"
    - name="Vortex" prototype="VortexField"
    - name="Stars" prototype="StarField"
    - name="Atmosphere" prototype="Atmosphere"
    - name="Hud" prototype="Hud"
    - {
        name "Board1"
        prototype "Board"
        components {
            GlobalBinding name="Board1"
            BoardState index=0
        }
    }
    - {
        name "Board2"
        prototype "Board"
        components {
            GlobalBinding name="Board2"
            BoardState index=1
        }
    }
}
