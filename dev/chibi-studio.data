version 1
name "Studio"
(array)entities {
    - {
        name "Settings"
        prototype "Settings"
        (array)behaviors "NavKeys" "Dismiss"
    }
    - name="Data" prototype="Data"
    - name="Theme" prototype="Theme"
    - name="Inspector" prototype="Inspector"
    - name="StatusBar" prototype="StatusBar"
    - name="TopBar" prototype="TopBar"
    - name="Workspace" prototype="Workspace"
    - {
        name "Collaboration"
        prototype "Collaboration"
        (array)behaviors "NavKeys" "Dismiss"
    }
    - {
        name "Shortcuts"
        prototype "Shortcuts"
        (array)behaviors "Dismiss"
    }
    - {
        name "NewProject"
        prototype "NewProject"
        (array)behaviors "NewProjectKeys"
    }
    - name="AreaHeader" prototype="AreaHeader"
    - name="Properties" prototype="Properties"
    - name="PropertiesHeader" prototype="PropertiesHeader"
    - {
        name "Outliner"
        prototype "Outliner"
        (array)behaviors "OutlinerInput" "OutlinerMenu" "OutlinerRename" "OutlinerRows"
    }
    - {
        name "OutlinerHeader"
        prototype "OutlinerHeader"
        (array)behaviors "OutlinerHeaderInput"
    }
    - {
        name "Widgets"
        prototype "Widgets"
        (array)behaviors "VirtualList" "WidgetGallery"
    }
    - name="Assets" prototype="Assets"
    - name="AssetsHeader" prototype="AssetsHeader"
    - name="NewAsset" prototype="NewAsset"
    - name="Output" prototype="Output"
    - name="OutputHeader" prototype="OutputHeader"
    - name="Members" prototype="Members"
    - name="MembersHeader" prototype="MembersHeader"
    - name="Scene" prototype="Scene"
    - name="SceneHeader" prototype="SceneHeader"
    - name="Canvas" prototype="Canvas"
    - name="Performance" prototype="Performance"
    - name="PerformanceHeader" prototype="PerformanceHeader"
    - name="BehaviorHeader" prototype="BehaviorHeader"
    - name="GraphFind" prototype="GraphFind"
    - name="CodeHeader" prototype="CodeHeader"
    - name="CodeFind" prototype="CodeFind"
    - name="CodeMenu" prototype="CodeMenu"
    - name="Details" prototype="Details"
    - name="DetailsHeader" prototype="DetailsHeader"
    - name="Hierarchy" prototype="Hierarchy"
    - name="HierarchyHeader" prototype="HierarchyHeader"
    - name="Library" prototype="Library"
    - name="LibraryHeader" prototype="LibraryHeader"
    - name="Palette" prototype="Palette"
    - name="Picker" prototype="Picker"
    - name="Refactor" prototype="Refactor"
    - name="GraphMenu" prototype="GraphMenu"
}
/* An area's header, as Blender's (studio_shell.c hosts one per area and
   binds `area`, its item of editor.areas): the editor type menu, a Menu over
   choices.editors and choices.panels that draws above the other areas, the
   editor's own controls, native in the #controls slot, then Maximize, which
   turns to Restore while its area fills the workspace, and the drawer's
   Close. */
body { flex: 0 0 auto; }
.area-head {
  height: var(--header-h); display: flex; align-items: center; gap: 3dp; padding: 0dp 6dp;
  background-color: var(--background); border-bottom: 1dp var(--line);
}
.btn { height: var(--h); }
#editor-type { display: flex; flex: 0 0 auto; }
.editor-type { gap: 2dp; padding: 0dp 3dp 0dp 5dp; }
#controls { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
/* Actions keep their hit targets; document names consume the remaining width. */
.area-head > .btn, #controls > .btn, #controls > .readout { flex: 0 0 auto; }
#controls > .segmented, #controls > .segmented .seg { flex: 0 0 auto; }
// Maximize stays quiet until it is hovered or its area fills the workspace.
.maximize .icon { color: var(--faint-foreground); }
.maximize:hover .icon, .area-head.maximized .maximize .icon { color: var(--foreground); }
.close { margin-left: 2dp; }

/* ---------- Live values ---------- */
/* While the scene runs, a Properties area edits its running world
   (studio_properties_live): its header takes a primary wash and rule, as
   Unity tints its editor in Play Mode. */
.area-head.live { background-color: color-mix(in srgb, var(--primary) 9%, var(--muted)); border-bottom: 1dp var(--primary-edge); }
<header class="area-head" data-class-maximized="area.maximized" data-class-live="area.live">
  <div id="editor-type">
    <button class="btn icon-only editor-type" popovertarget="editor-types" aria-haspopup="menu" data-attr-data-tip="area.title"><span class="icon">{{ area.icon }}</span></button>
    <use ui="Menu" id="editor-types">
      <div data-for="group, g : choices.editors.groups">
        <use ui="MenuSeparator" data-if="g > 0"/>
        <use ui="MenuGroup" data-alias-group="group"/>
        <use ui="MenuItem" data-for="type : group.options" data-if="!area.drawer || type.drawer" data-alias-item="type" data-attrif-data-current="area.editor == type.value" data-event-click="emit('editor.type', area.index, type.value)"/>
        <use ui="MenuItem" data-for="panel : choices.panels.tools" data-if="group.tools" data-alias-item="panel" data-attrif-data-current="area.panel == panel.value" data-event-click="emit('editor.panel', area.index, panel.value)"/>
      </div>
      <use ui="MenuSeparator" data-if="choices.panels.others.size > 0"/>
      <use ui="Submenu" data-if="choices.panels.others.size > 0" data-alias-item="choices.panels">
        <use ui="MenuItem" data-for="panel : choices.panels.others" data-alias-item="panel" data-attrif-data-current="area.panel == panel.value" data-event-click="emit('editor.panel', area.index, panel.value)"/>
      </use>
    </use>
  </div>
  <div id="controls"/>
  <button class="btn icon-only maximize" data-attr-data-tip="area.maximized ? 'Restore Area' : commands.maximize.label" data-attr-data-kbd="commands.maximize.shortcut" data-event-click="emit('studio.maximize', area.index)"><span class="icon" data-if="!area.maximized">&#xeb4c;</span><span class="icon" data-if="area.maximized">&#xeb4d;</span></button>
  <button class="btn icon-only close" data-if="area.drawer" data-attr-data-tip="commands.closeDrawer.label" data-event-click="emit('studio.closeDrawer')"><span class="icon">&#xea76;</span></button>
</header>
/* A reference to an asset as a field that opens Studio's asset picker
   (Picker.rml) under it, as the kit's asset picker did: none, then the
   project's assets of a kind, ranked as typed. Alias the kind's table as
   data-alias-table, such as choices.assets.prototype ({ label, icon, none
   }), where none labels choosing none, and the asset's name as
   data-alias-value; open the picker on click with
   emit('palette.pick', kind, value, none[, 'typed']), where 'typed' offers
   a name no asset has yet, and choosing sends the field change with
   ev.value, the name, or "" for none. As a drop target (data-drop,
   ui/drag.h) it lights up while an asset of its kind drags and shows
   data-drop-preview's name in primary; data-readonly keeps it shut and
   data-invalid marks a name no asset has. */
body { display: flex; flex: 1 1 0dp; }
.asset-field { display: flex; flex: 1 1 0dp; min-width: 0dp; }
.asset-field[data-drop-over] { background-color: transparent; }
.asset-field[data-drop-accept] .field.picker { border-color: var(--primary-edge); }
.asset-field[data-drop-over] .field.picker { border-color: var(--primary); background-color: var(--primary-soft); }
.asset-field[data-drop-preview] .field.picker .value { color: var(--primary); }
.asset-field[data-readonly] .field { background-color: transparent; border-color: var(--border); pointer-events: none; tab-index: none; }
.asset-field[data-invalid] .field { border-color: var(--destructive); }
<div class="asset-field" attrs>
  <button class="field select picker" aria-haspopup="listbox" data-attrif-data-placeholder="value == ''"><span class="icon lead">{{ table.icon }}</span><span class="part value">{{ value == '' ? table.none : value }}</span><span class="icon caret">&#xeab4;</span></button>
</div>
/* Assets (studio_assets.c, the `assets` source), after Unity's Project
   window and Unreal's Content Browser: every indexed asset as a grid of
   Tiles as wide as the area or as TreeRows, either grouped by kind under a
   TreeRow header. One List windows either; C sizes the tiles
   (--tile-width, --tile-height) and places each row or line of tiles it
   shows in the List's spacer, keeping one where it is while it stays in
   view, so a scroll changes only those entering. A click selects, a double
   click opens, a right press opens the asset's menu, and draggable assets
   carry their kind and name. */
body { padding: 0dp; overflow: hidden; }
.assets { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; }
#assets-list { padding: 3dp 4dp 8dp; }
#assets-list [data-ui=TreeRow] { position: absolute; left: 0dp; right: 0dp; }
.assets-line { position: absolute; left: 0dp; right: 0dp; display: flex; gap: 4dp; }
.assets-line > [data-ui=TreeRow] { flex: 1 1 0dp; }
.assets-line > [data-ui=Tile] { flex: 0 0 auto; width: var(--tile-width, 104dp); height: var(--tile-height, 122dp); }
.tree-row { tab-index: none; }
[data-unused] .tree-row .meta { color: var(--disabled-foreground); }
[data-unresolved] .tree-row .icon { color: var(--warning); }
/* Nothing to show: why, and the one action that changes it (Settings'
   empty search). */
.assets-empty { position: absolute; left: 0dp; right: 0dp; top: 30%; display: flex; flex-direction: column; align-items: center; gap: 6dp; padding: 0dp 16dp; text-align: center; }
.assets-empty .empty-icon { font-size: var(--studio-font-28, 28dp); line-height: var(--studio-line-32, 32dp); width: var(--studio-height-32, 32dp); color: var(--disabled-foreground); }
.assets-empty .empty-title { font-weight: 600; color: var(--foreground); }
.assets-empty .empty-hint { color: var(--muted-foreground); margin-bottom: 8dp; }
<div class="assets" data-attrif-data-grid="assets.grid">
  <use ui="List" id="assets-list" data-event-scroll="emit('assets.scroll')" data-style---tile-width="assets.tileWidth" data-style---tile-height="assets.tileHeight">
    <use ui="TreeRow" data-for="row : assets.rows" data-if="row.shown" data-alias-item="row" data-style-top="row.top" data-alias-selection="asset_view.selected" data-attr-data-asset="row.key" data-attrif-data-unused="row.unused" data-attrif-data-unresolved="row.unresolved" data-attr-data-drag="row.drag" data-attr-data-drag-payload="row.label" data-attr-data-drag-icon="row.icon" data-event-click="emit('assets.click', row.key, row.kind)" data-event-dblclick="emit('assets.open', row.key)" data-event-contextmenu="emit('assets.menu', row.key)"></use>
    <div class="assets-line" data-for="line : assets.lines" data-if="line.shown" data-style-top="line.top">
      <use ui="TreeRow" data-if="line.head.shown" data-alias-item="line.head" data-alias-selection="asset_view.selected" data-attr-data-asset="line.head.key" data-event-click="emit('assets.click', -1, line.head.kind)"></use>
      <use ui="Tile" data-for="cell : line.tiles" data-if="cell.shown" data-alias-tile="cell" data-alias-selection="asset_view.selected" data-attr-data-asset="cell.key" data-attr-data-tip="cell.label" data-attr-data-tip-about="cell.about" data-attr-data-tip-image="asset_view.preview.id == cell.key ? asset_view.preview.image : cell.image" data-attr-data-drag="cell.drag" data-attr-data-drag-payload="cell.label" data-attr-data-drag-icon="cell.icon" data-event-click="emit('assets.click', cell.key, -1)" data-event-dblclick="emit('assets.open', cell.key)" data-event-contextmenu="emit('assets.menu', cell.key)"></use>
    </div>
  </use>
  <div class="assets-empty" data-if="assets.empty != ''">
    <span class="icon empty-icon">&#xea6d;</span>
    <div class="empty-title">{{ assets.empty }}</div>
    <div class="empty-hint">Clear the filters to see every asset.</div>
    <button class="btn outline" data-event-click="emit('assets.clearFilter')"><span class="label">Clear Filters</span></button>
  </div>
  <use ui="Menu" id="asset-menu">
    <use ui="MenuGroup" data-alias-group="asset_menus.row"/>
    <div data-for="entry : asset_menus.row.items">
      <use ui="MenuSeparator" data-if="entry.separator"/>
      <use ui="MenuItem" data-alias-item="entry" data-event-click="emit('assets.' + entry.action, asset_menus.row.key)"/>
    </div>
  </use>
</div>
/* Assets' header controls, in its area header's #controls: the kind filter,
   the name filter, the grid or list view, Unity's thumbnail size slider,
   which the grid alone has, and New, a Menu of every kind Studio makes, grouped
   as Blender's Add and Unity's Create menus group theirs, with the filter's
   kind first. Choosing one asks for its name (NewAsset). */
body { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.assets-kind { width: 140dp; display: flex; }
.assets-view { flex: 0 0 auto; width: 56dp; margin-left: 4dp; }
.assets-view .seg { padding: 0dp; }
.assets-view .seg .icon { line-height: var(--h); }
.assets-view .seg:hover .icon { color: var(--foreground); }
.assets-view .seg[data-pressed] .icon { color: var(--primary-foreground); }
.assets-size { width: 96dp; display: flex; margin-left: 4dp; }
body > .btn { flex: 0 0 auto; }
<div class="assets-kind"><use ui="EnumField" data-alias-table="assets.kinds" data-alias-value="assets.kind" data-event-change="emit('assets.kind', ev.value)"/></div>
<div class="assets-filter"><div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" id="assets-filter" class="part value" placeholder="Filter" data-value="assets.filter"/></div></div>
<div class="segmented assets-view">
  <button class="seg" data-tip="Grid" data-attrif-data-pressed="assets.grid" data-event-click="emit('assets.view', 0)"><span class="icon">&#xf0570;</span></button>
  <button class="seg" data-tip="List" data-attrif-data-pressed="!assets.grid" data-event-click="emit('assets.view', 1)"><span class="icon">&#xf0572;</span></button>
</div>
<div class="assets-size" data-if="assets.grid"><number-field class="field number" min="48" max="160" step="8" precision="0" integer="" slider="" addon="Size" data-tip="Thumbnail Size" data-attr-value="assets.tile" data-event-input="emit('assets.tile', ev.value)" data-event-change="emit('assets.tile', ev.value)"></number-field></div>
<button class="btn icon-only" id="asset-new-button" popovertarget="asset-new" aria-haspopup="menu" data-tip="New Asset"><span class="icon">&#xea60;</span></button>
<use ui="Menu" id="asset-new">
  <div data-for="entry : asset_menus.create">
    <use ui="MenuSeparator" data-if="entry.separator"/>
    <use ui="MenuGroup" data-if="entry.heading.label != ''" data-alias-group="entry.heading"/>
    <use ui="MenuItem" data-alias-item="entry" data-event-click="emit('studio.' + entry.id)"/>
  </div>
</use>
/* The Behavior header (studio_graph_header.c), in its AreaHeader's
   controls, as Unreal's graph editor toolbar: Back and Forward through the
   graphs visited, breadcrumbs of the behavior and the calls entered to reach
   the open graph, whose crumb picks another graph or renames it in place;
   then the debug target while the game runs (a ChoiceList of its instances,
   Follow newest and Break when spawned), the zoom, the Graph menu, Arrange,
   Find, Frame all and the View menu (GraphView). The crumbs shrink first,
   ellipsizing their labels. */
body, .graph-head { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.graph-head > .btn, .graph-head > .segmented, .graph-head > .segmented .seg { flex: 0 0 auto; }
/* The zoom readout resets to 100% when clicked; it reads as plain text
   until hovered. */
.graph-head > .zoom { padding: 0dp 2dp; }
.graph-head > .zoom:hover .readout { color: var(--foreground); }
/* A call entered and its separator, in the crumbs' row. */
.caller { display: flex; align-items: center; gap: 2dp; flex: 0 1 auto; min-width: 0dp; }
.rename { flex: 0 1 160dp; min-width: 60dp; }
/* Rows 8 dp wider than their content, which the list's scrollbar takes,
   as the kit's dropdowns size them. */
#debug-targets .menu-item { padding-right: 16dp; }
<span class="dim" data-if="!graph_header.open">No behavior open</span>
<div class="graph-head" data-if="graph_header.open">
  <button class="btn icon-only" data-tip="Back" data-attr-data-kbd="graph_header.backKbd" data-attrif-data-disabled="!graph_header.back" data-event-click="emit('graph_header.back')"><span class="icon">&#xea9b;</span></button>
  <button class="btn icon-only" data-tip="Forward" data-attr-data-kbd="graph_header.forwardKbd" data-attrif-data-disabled="!graph_header.forward" data-event-click="emit('graph_header.forward')"><span class="icon">&#xea9c;</span></button>
  <div class="crumbs">
    <button class="btn crumb" popovertarget="crumb-asset" aria-haspopup="menu"><span class="icon">{{ graph_header.asset.icon }}</span><span class="label">{{ graph_header.asset.label }}</span></button>
    <span class="icon crumb-sep">&#xeab6;</span>
    <div class="caller" data-for="caller : graph_header.callers">
      <button class="btn crumb" data-event-click="emit('graph_header.caller', caller.id)"><span class="label">{{ caller.label }}</span></button>
      <span class="icon crumb-sep">&#xeab6;</span>
    </div>
    <button class="btn crumb current" data-if="!graph_header.renaming" popovertarget="graph-picker" aria-haspopup="menu" data-tip="Graphs"><span class="icon">{{ graph_header.graph.icon }}</span><span class="label">{{ graph_header.graph.label }}</span></button>
    <div class="field text rename" data-when="graph_header.renaming"><input type="text" class="part value" autofocus="" data-attr-value="graph_header.graph.label" data-keys="Escape:graph_header.cancel" data-event-change="emit('graph_header.renamed', ev.value)" data-event-blur="emit('graph_header.cancel')"/></div>
  </div>
  <div class="segmented" data-if="graph_header.sourceView" data-tip="Behavior view">
    <button class="seg" data-attrif-data-pressed="graph_header.view == 0" data-event-click="emit('graph_header.view', 0)">Graph</button>
    <button class="seg" data-attrif-data-pressed="graph_header.view == 1" data-event-click="emit('graph_header.view', 1)">Code</button>
    <button class="seg" data-attrif-data-pressed="graph_header.view == 2" data-event-click="emit('graph_header.view', 2)">Both</button>
  </div>
  <span class="badge" data-if="graph_header.readonlyAbout != ''" data-tip="Read-only" data-attr-data-tip-about="graph_header.readonlyAbout">Read-only</span>
  <div class="spacer"></div>
  <button class="btn subtle sm debug-target" data-if="graph_header.debug" popovertarget="debug-targets" aria-haspopup="listbox" data-tip="Debug target" data-attr-data-tip-about="graph_header.targetAbout"><span class="icon">&#xebf8;</span><morph-text class="label">{{ graph_header.target }}</morph-text></button>
  <button class="btn sm zoom" data-if="graph_view.zoomShown" data-tip="Zoom to 100%" data-event-click="emit('graph_header.zoomActual')"><number-flow class="number-flow readout" data-if="!graph_view.zooming" data-attr-value="graph_view.zoom" precision="0" prefix="" suffix="%"></number-flow><span class="readout" data-if="graph_view.zooming">{{ graph_view.zoom }}%</span></button>
  <button class="btn icon-only" popovertarget="graph-actions" aria-haspopup="menu" data-tip="Graph"><span class="icon">&#xea7c;</span></button>
  <button class="btn icon-only" data-tip="Arrange" data-attr-data-kbd="graph_header.arrangeKbd" data-attrif-data-disabled="graph_header.readonly" data-event-click="emit('graph_header.arrange')"><span class="icon">&#xebeb;</span></button>
  <button class="btn icon-only" data-tip="Find" data-attr-data-kbd="commands.find.shortcut" data-attr-data-state="graph_header.find ? 'on' : ''" data-event-click="emit('graph_header.find')"><span class="icon">&#xea6d;</span></button>
  <button class="btn icon-only" data-tip="Frame all" data-kbd="Home" data-event-click="emit('graph_header.frame')"><span class="icon">&#xf004c;</span></button>
  <use ui="GraphView"/>
  <use ui="Menu" id="crumb-asset">
    <use ui="MenuItem" data-alias-item="graph_menus.refs" data-event-click="emit('graph_header.assetRefs')"/>
    <use ui="Submenu" data-if="graph_menus.kinds" data-alias-item="graph_menus.kind">
      <use ui="MenuItem" data-for="asset : graph_menus.assets" data-alias-item="asset" data-attrif-data-current="asset.current" data-event-click="emit('graph_header.asset', asset.label)"></use>
    </use>
  </use>
  <use ui="Menu" id="graph-picker">
    <use ui="MenuGroup">Graphs</use>
    <use ui="MenuItem" data-for="g : graph_menus.graphs" data-alias-item="g" data-attrif-data-current="g.current" data-event-click="emit('graph_header.graph', g.id)"></use>
    <use ui="MenuSeparator"/>
    <use ui="MenuItem" data-alias-item="graph_menus.newFunction" data-event-click="emit('graph_header.newFunction')"/>
    <use ui="MenuItem" data-alias-item="graph_menus.newMacro" data-event-click="emit('graph_header.newMacro')"/>
    <use ui="MenuSeparator" data-if="graph_menus.named"/>
    <use ui="MenuItem" data-if="graph_menus.named" data-alias-item="graph_menus.rename" data-event-click="emit('graph_header.rename')"/>
    <use ui="MenuItem" data-if="graph_menus.named" data-alias-item="graph_menus.graphRefs" data-event-click="emit('graph_header.graphRefs')"/>
    <use ui="MenuItem" data-if="graph_menus.named" data-alias-item="graph_menus.graphCalls" data-event-click="emit('graph_header.graphCalls')"/>
    <use ui="MenuItem" data-if="graph_menus.named" data-alias-item="graph_menus.remove" data-event-click="emit('graph_header.remove')"/>
  </use>
  <use ui="Menu" id="graph-actions">
    <use ui="MenuItem" data-alias-item="graph_view.optimize" data-event-click="emit('graph_header.optimize')"/>
    <use ui="MenuItem" data-alias-item="graph_view.collapse" data-event-click="emit('graph_header.collapse')"/>
    <use ui="MenuSeparator"/>
    <use ui="Submenu" data-if="graph_view.align" data-alias-item="graph_view.alignment">
      <use ui="MenuItem" data-for="edge : graph_view.edges" data-alias-item="edge" data-event-click="emit('graph_header.align', edge.id)"></use>
      <use ui="MenuSeparator"/>
      <use ui="MenuItem" data-alias-item="graph_view.horizontal" data-event-click="emit('graph_header.distribute', 0)"/>
      <use ui="MenuItem" data-alias-item="graph_view.vertical" data-event-click="emit('graph_header.distribute', 1)"/>
    </use>
    <use ui="MenuItem" data-alias-item="graph_view.straighten" data-event-click="emit('graph_header.straighten')"/>
  </use>
  <div class="popup dropdown" popover id="debug-targets">
    <use ui="ChoiceList" placeholder="Search instances" data-event-change="emit('graph_header.target', ev.value)">
      <div role="group" data-for="group : graph_targets.groups">
        <use ui="MenuGroup" data-if="group.label != ''" data-alias-group="group"/>
        <div class="menu-item" role="option" data-for="option : group.options" data-attr-value="option.id" data-attr-data-label="option.label" data-attr-data-keywords="option.keywords" data-attrif-data-current="option.current"><span class="icon lead">{{ option.icon }}</span><span class="text"><span class="label">{{ option.label }}</span></span></div>
      </div>
    </use>
  </div>
</div>
/* DevTools' box model: the selection's margin, border and padding in dp
   around its content size, in the colors its highlight uses. */
body { display: block; margin-top: 8dp; font-size: var(--studio-font-10, 10dp); line-height: var(--studio-line-16, 16dp); color: var(--foreground); }
.box { position: relative; display: block; border: 1dp var(--line); border-radius: 3dp; padding: 0dp 2dp; }
.caption { position: absolute; left: 4dp; top: 0dp; font-size: var(--studio-font-9, 9dp); color: var(--muted-foreground); }
.edge { display: block; height: var(--studio-height-16, 16dp); text-align: center; }
.middle { display: flex; align-items: center; }
.side { flex: 0 0 auto; width: 30dp; text-align: center; }
.middle .box, .content { flex: 1 1 0dp; }
.margin { background-color: #f6b26b38; }
.border { background-color: #ffe59944; }
.padding { background-color: #93c47d3d; }
.content { display: block; height: var(--studio-height-20, 20dp); line-height: var(--studio-line-20, 20dp); text-align: center; border-radius: 2dp; background-color: #6fa8dc55; white-space: nowrap; }
<div class="box margin">
  <span class="caption">margin</span>
  <div class="edge">{{ inspector.box.margin.top }}</div>
  <div class="middle">
    <div class="side">{{ inspector.box.margin.left }}</div>
    <div class="box border">
      <span class="caption">border</span>
      <div class="edge">{{ inspector.box.border.top }}</div>
      <div class="middle">
        <div class="side">{{ inspector.box.border.left }}</div>
        <div class="box padding">
          <span class="caption">padding</span>
          <div class="edge">{{ inspector.box.padding.top }}</div>
          <div class="middle">
            <div class="side">{{ inspector.box.padding.left }}</div>
            <div class="content">{{ inspector.size }}</div>
            <div class="side">{{ inspector.box.padding.right }}</div>
          </div>
          <div class="edge">{{ inspector.box.padding.bottom }}</div>
        </div>
        <div class="side">{{ inspector.box.border.right }}</div>
      </div>
      <div class="edge">{{ inspector.box.border.bottom }}</div>
    </div>
    <div class="side">{{ inspector.box.margin.right }}</div>
  </div>
  <div class="edge">{{ inspector.box.margin.bottom }}</div>
</div>
/* The Canvas (studio_canvas.c's `canvas` source): a ui asset alone on a
   stage, as Storybook shows a story. Its frame, native in
   #canvas-frame-slot, sits at the screen size the header chooses, centered
   with room around it; the size and what uses the asset label the stage's
   bottom left, over the game UI's error. Storybook's Actions log lists each
   event the asset emitted, newest last, in a column beside the stage so it
   never covers the asset; it follows new rows while at its end. Density
   sets an action's height, and the stage keeps dark roles in every theme
   (theme/viewport.rcss). */
@import "theme/viewport.rcss";
body.area-panel { padding: 0dp; overflow: hidden; }
.viewport { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; background-color: var(--viewport); }
.canvas-stage { position: relative; flex: 1 1 0dp; overflow: hidden; background-color: #121214; }
.viewport.light .canvas-stage { background-color: #d4d4d8; }
.canvas-frame-slot { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; }
.surface { position: absolute; }
.view-label { position: absolute; left: 12dp; right: 12dp; bottom: 10dp; color: var(--foreground); font-size: var(--studio-font-11, 11dp); pointer-events: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.view-label .dim { display: block; overflow: hidden; text-overflow: ellipsis; }
.viewport.light .view-label { color: #3f3f46; }
.viewport.light .view-label .dim { color: #71717a; }
.notice { position: absolute; left: 12dp; right: 12dp; bottom: 36dp; padding: 6dp 8dp; border-radius: var(--r); background-color: var(--notice); color: var(--notice-fg); white-space: normal; }
.canvas-actions { flex: 0 0 240dp; display: flex; flex-direction: column; border-left: 1dp var(--line); background-color: var(--floating); }
.canvas-actions-head { display: flex; align-items: center; gap: 6dp; height: var(--header-h); flex: 0 0 auto; padding: 0dp 4dp 0dp 10dp; font-size: var(--studio-font-11, 11dp); border-bottom: 1dp var(--line); }
.canvas-actions-head .icon { color: var(--faint-foreground); font-size: 12dp; width: 14dp; }
.canvas-actions-head .title { font-weight: 600; color: var(--foreground); }
.canvas-actions > [data-ui=List] { flex: 1 1 0dp; min-height: 0dp; }
#canvas-actions-list { box-sizing: border-box; padding: 2dp 4dp; font-family: var(--font-numeric); }
.canvas-action { display: flex; align-items: center; gap: 6dp; height: var(--studio-height-20, 20dp); padding: 0dp 6dp; border-radius: var(--r); white-space: nowrap; overflow: hidden; }
body.comfortable .canvas-action { height: var(--studio-height-24, 24dp); }
.canvas-action:hover { background-color: var(--accent); }
.canvas-action .event { color: var(--primary-text); font-weight: 600; flex: 0 1 auto; overflow: hidden; text-overflow: ellipsis; }
.canvas-action .element { color: var(--muted-foreground); flex: 0 1 auto; overflow: hidden; text-overflow: ellipsis; }
.canvas-action .value { color: var(--foreground); flex: 0 0 auto; }
.canvas-action .count { color: var(--faint-foreground); flex: 0 0 auto; }
.canvas-action .time { margin-left: auto; color: var(--faint-foreground); flex: 0 0 auto; }
.canvas-actions-empty { display: block; padding: 16dp 10dp; text-align: center; color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); pointer-events: none; }
<div class="viewport canvas" data-class-light="canvas.light">
  <div class="canvas-stage">
    <div class="canvas-frame-slot" id="canvas-frame-slot"></div>
    <div class="view-label canvas-label"><span>{{ canvas.frame }}</span><span class="dim">{{ canvas.usedBy }}</span></div>
    <span class="notice" data-if="canvas.error != ''">{{ canvas.error }}</span>
  </div>
  <div class="canvas-actions" data-if="canvas.open">
    <div class="canvas-actions-head">
      <span class="icon">&#xea86;</span>
      <span class="title">Actions</span>
      <div class="spacer"></div>
      <button class="btn sm icon-only" data-tip="Clear" data-attrif-data-disabled="canvas.total == 0" data-event-click="emit('canvas.clear')"><span class="icon">&#xea81;</span></button>
    </div>
    <span class="canvas-actions-empty" data-if="canvas.total == 0">No actions yet</span>
    <use ui="List" id="canvas-actions-list" data-if="canvas.total > 0" data-event-scroll="emit('canvas.scroll')">
      <div class="canvas-action" data-for="row : canvas.rows"><span class="event">{{ row.event }}</span><span class="element">{{ row.element }}</span><span class="value">{{ row.value }}</span><span class="count">{{ row.count }}</span><span class="time">{{ row.time }}</span></div>
    </use>
  </div>
</div>
/* Base UI Checkbox over RmlUi's checkbox input, in the field theme's box:
   the input takes focus and clicks, and data-mixed on it shows a dash. Bind
   it as a checkbox, data-checked="save.grid", or one way with
   data-attrif-checked and an emit on change that carries ev.value ("on" or
   ""): RmlUi sends change when the binding sets checked too, so the emit
   sets the state rather than flipping it. Its children are its label.
   It lays out as a flex item, so a row keeps the control's height. */
body { display: flex; }
.check { position: relative; display: inline-flex; cursor: pointer; tab-index: none; }
.check input { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; opacity: 0; nav: auto; cursor: pointer; }
.check input:checked ~ .box, .check input[data-mixed] ~ .box { background-color: var(--primary); border-color: var(--primary); }
.check input:checked ~ .box .icon { opacity: 1; }
.check input[data-mixed] ~ .box .icon { display: none; }
.check input[data-mixed] ~ .box .icon.dash { display: block; opacity: 1; }
.check input:focus-visible ~ .box { border-color: var(--ring); }
.check input:disabled ~ .box { opacity: 0.5; }
<label class="check"><input type="checkbox" attrs/><span class="box"><span class="icon">&#xeab2;</span><span class="icon dash">&#xeacc;</span></span><slot/></label>
/* A search field over a list of choices (the native <choice-list>, as Base
   UI's Combobox list and cmdk): typing filters the use's role="option"
   children by their data-label or .label, Up, Down and the pointer move the
   highlight, and Enter or a click chooses one, sending change with its
   value. Wrap options in role="group" with a MenuGroup heading to group
   them. The palette, pickers, Add Component, editor types and EnumField
   build on it. */
body { display: block; }
<choice-list class="choice-list" attrs><div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" class="part value" placeholder="Search options"/></div><div class="choice-results"><slot/></div><div class="choice-empty">No matching options</div></choice-list>
/* Find in the Text Editor (studio_code.c), over the text's top right in
   the theme's .find-widget, as VS Code's find widget: the query, which
   shows its first match from the cursor as it is typed, the match count,
   Previous and Next (Shift+Enter and Enter, Up and Down) and Close
   (Escape, back to the text). */
body { display: flex; flex-direction: column; gap: 4dp; }
/* A focused query shows as the kit's field did while editing. */
.field.search:focus-within { background-color: var(--field-edit); }
<div class="find-widget-bar">
  <div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" class="part value" id="code-find-query" placeholder="Find" autofocus="" data-value="code_find.query" data-keys="Enter:code_find.enter Escape:code_find.close Up:code_find.previous Down:code_find.next"/></div>
  <span class="find-widget-count">{{ code_find.count }}</span>
  <button class="btn icon-only" data-tip="Previous" data-kbd="&#x21e7;&#x21b5;" data-attrif-data-disabled="code_find.total == 0" data-event-click="emit('code_find.previous')"><span class="icon">&#xeab7;</span></button>
  <button class="btn icon-only" data-tip="Next" data-kbd="&#x21b5;" data-attrif-data-disabled="code_find.total == 0" data-event-click="emit('code_find.next')"><span class="icon">&#xeab4;</span></button>
  <button class="btn icon-only" data-tip="Close" data-kbd="Esc" data-event-click="emit('code_find.close')"><span class="icon">&#xea76;</span></button>
</div>
/* The Text Editor's header (studio_code.c), in its AreaHeader's controls.
   For a UI document: Back and Forward through Go to Definition's jumps and
   the graphs visited, the part (RML or RCSS), the file with its unsaved
   dot, an Invalid chip while the text keeps its last valid version, Find,
   Vim's mode, the problems' count, which steps to the next (F8), and the
   apply mode. For an asset's Code source: its name, Unsaved, its runtime or
   Invalid chip, Find, Rename Symbol and Show Call Hierarchy (disabled
   without a symbol at the caret), the problems, Save and the apply mode.
   Controls keep their places as the caret moves. */
body, .code-head { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.code-head > .btn, .code-head > .segmented, .code-head > .segmented .seg { flex: 0 0 auto; }
.code-parts, .code-apply { display: flex; flex: 0 0 auto; }
.code-history { display: flex; flex: 0 0 auto; align-items: center; gap: 1dp; margin-right: 4dp; }
.code-parts .segmented, .code-apply .segmented { flex: 0 0 auto; }
.code-parts .seg, .code-apply .seg { flex: 0 0 auto; }
.code-file { display: flex; align-items: center; gap: 6dp; padding: 0dp 6dp; flex: 0 1 auto; min-width: 0dp; white-space: nowrap; color: var(--foreground); }
.code-file .icon { color: var(--muted-foreground); }
.code-file .icon, .code-file .dirty-dot { flex: 0 0 auto; }
.code-file .name { min-width: 0dp; overflow: hidden; text-overflow: ellipsis; }
.code-runtime, .code-mode { flex: 0 0 auto; white-space: nowrap; }
.code-runtime { max-width: 100dp; overflow: hidden; text-overflow: ellipsis; }
/* An asset's source names it in one span, not the UI document's file group. */
span.code-file { display: block; overflow: hidden; text-overflow: ellipsis; }
.code-problem { display: flex; align-items: center; gap: 4dp; padding: 0dp 6dp; flex: 0 0 auto; color: var(--destructive); }
.seg { tab-index: auto; }
<span class="dim" data-if="code_header.mode == 0">No file open</span>
<div class="code-head" data-if="code_header.mode == 1">
  <div class="code-history">
    <button class="btn sm icon-only" data-tip="Back" data-attr-data-kbd="code_header.backKbd" data-attrif-data-disabled="!code_header.back" data-event-click="emit('code_header.back')"><span class="icon">&#xea9b;</span></button>
    <button class="btn sm icon-only" data-tip="Forward" data-attr-data-kbd="code_header.forwardKbd" data-attrif-data-disabled="!code_header.forward" data-event-click="emit('code_header.forward')"><span class="icon">&#xea9c;</span></button>
  </div>
  <div class="code-file">
    <span class="name">{{ code_header.title }}</span>
    <div class="dirty-dot" data-if="code_header.dirty" data-tip="Unsaved" data-attr-data-kbd="commands.save.shortcut"></div>
  </div>
  <div class="segmented" data-if="code_header.behavior && (code_header.view != 2 || code_header.sourceOnly)" data-tip="Behavior view">
    <button class="seg" data-attrif-data-pressed="code_header.view == 0" data-attrif-data-disabled="code_header.sourceOnly" data-event-click="emit('code_header.view', 0)">Graph</button>
    <button class="seg" data-attrif-data-pressed="code_header.view == 1" data-event-click="emit('code_header.view', 1)">Code</button>
    <button class="seg" data-attrif-data-pressed="code_header.view == 2" data-attrif-data-disabled="code_header.sourceOnly" data-event-click="emit('code_header.view', 2)">Both</button>
  </div>
  <span class="dim code-runtime" data-if="code_header.runtimeLabel != '' && code_header.error == ''" data-tip="Runtime status" data-attr-data-tip-about="code_header.runtime">{{ code_header.runtimeLabel }}</span>
  <div class="code-problem" data-if="code_header.error != ''"><span class="icon">&#xea87;</span><span data-tip="Keeps the last valid version" data-attr-data-tip-about="code_header.error">Invalid</span></div>
  <div class="spacer"></div>
  <button class="btn icon-only" data-tip="Find" data-attr-data-kbd="commands.find.shortcut" data-attr-data-state="code_header.find ? 'on' : ''" data-event-click="emit('code_header.find')"><span class="icon">&#xea6d;</span></button>
  <button class="btn icon-only" data-tip="Rename Symbol" data-attr-data-kbd="commands.renameSymbol.shortcut" data-attrif-data-disabled="!code_header.rename" data-event-click="emit('studio.renameSymbol')"><span class="icon">&#xea73;</span></button>
  <button class="btn icon-only" data-tip="Show Call Hierarchy" data-attr-data-kbd="commands.callHierarchy.shortcut" data-attrif-data-disabled="!code_header.calls" data-event-click="emit('studio.callHierarchy')"><span class="icon">&#xeb92;</span></button>
  <span class="code-mode" data-if="code_header.vim != ''" data-tip="Vim mode">{{ code_header.vim }}</span>
  <button class="btn sm code-problems" data-class-errors="code_header.errors > 0" data-class-clear="code_header.problems == 0" data-attr-data-tip="code_header.problemsTip" data-attr-data-kbd="commands.nextProblem.shortcut" data-attrif-data-disabled="code_header.problems == 0" data-event-click="emit('studio.nextProblem')"><span class="icon" data-if="code_header.problems == 0">&#xeab2;</span><span class="icon" data-if="code_header.errors > 0">&#xea87;</span><span class="icon" data-if="code_header.problems > code_header.errors && code_header.errors == 0">&#xea6c;</span><span class="label">{{ code_header.problems }}</span></button>
  <button class="btn icon-only" data-tip="Save" data-attr-data-kbd="commands.save.shortcut" data-event-click="emit('code_header.save')"><span class="icon">&#xeb4b;</span></button>
  <div class="segmented" data-tip="Apply edits" data-tip-about="Live applies each valid edit as you type; On Save waits for the file">
    <button class="seg" data-attrif-data-pressed="code_header.live" data-event-click="emit('code_header.apply', 0)">Live</button>
    <button class="seg" data-attrif-data-pressed="!code_header.live" data-event-click="emit('code_header.apply', 1)">On Save</button>
  </div>
</div>
<div class="code-head" data-if="code_header.mode == 2">
  <div class="code-history">
    <button class="btn sm icon-only" data-tip="Back" data-attr-data-kbd="code_header.backKbd" data-attrif-data-disabled="!code_header.back" data-event-click="emit('code_header.back')"><span class="icon">&#xea9b;</span></button>
    <button class="btn sm icon-only" data-tip="Forward" data-attr-data-kbd="code_header.forwardKbd" data-attrif-data-disabled="!code_header.forward" data-event-click="emit('code_header.forward')"><span class="icon">&#xea9c;</span></button>
  </div>
  <div class="code-parts" data-if="code_header.parts">
    <div class="segmented">
      <button class="seg" data-attrif-data-pressed="code_header.part == 0" data-event-click="emit('code_header.part', 0)">RML</button>
      <button class="seg" data-attrif-data-pressed="code_header.part == 1" data-event-click="emit('code_header.part', 1)">RCSS</button>
    </div>
  </div>
  <div class="code-file">
    <span class="icon">{{ code_header.icon }}</span>
    <span class="name" data-attr-data-tip="code_header.path">{{ code_header.name }}</span>
    <div class="dirty-dot" data-if="code_header.dirty" data-tip="Unsaved" data-attr-data-kbd="commands.save.shortcut"></div>
  </div>
  <div class="code-problem" data-if="code_header.error != ''"><span class="icon">&#xea87;</span><span data-tip="Keeps the last valid version" data-attr-data-tip-about="code_header.error">Invalid</span></div>
  <div class="spacer"></div>
  <button class="btn icon-only" data-tip="Find" data-attr-data-kbd="commands.find.shortcut" data-attr-data-state="code_header.find ? 'on' : ''" data-event-click="emit('code_header.find')"><span class="icon">&#xea6d;</span></button>
  <span class="code-mode" data-if="code_header.vim != ''" data-tip="Vim mode">{{ code_header.vim }}</span>
  <button class="btn sm code-problems" data-class-errors="code_header.errors > 0" data-class-clear="code_header.problems == 0" data-attr-data-tip="code_header.problemsTip" data-attr-data-kbd="commands.nextProblem.shortcut" data-attrif-data-disabled="code_header.problems == 0" data-event-click="emit('studio.nextProblem')"><span class="icon" data-if="code_header.problems == 0">&#xeab2;</span><span class="icon" data-if="code_header.errors > 0">&#xea87;</span><span class="icon" data-if="code_header.problems > code_header.errors && code_header.errors == 0">&#xea6c;</span><span class="label">{{ code_header.problems }}</span></button>
  <div class="code-apply">
    <div class="segmented" data-tip="Apply edits" data-tip-about="Live applies each valid edit as you type; On Save waits for the file">
      <button class="seg" data-attrif-data-pressed="code_header.live" data-event-click="emit('code_header.apply', 0)">Live</button>
      <button class="seg" data-attrif-data-pressed="!code_header.live" data-event-click="emit('code_header.apply', 1)">On Save</button>
    </div>
  </div>
</div>
/* The Text Editor's context menu (studio_code.c), at the secondary click
   in a document of its own shown only while it is open, as VS Code's
   editor context menu: Go to Definition and Find References, Rename Symbol
   and Show Call Hierarchy, then Toggle Line Comment and Find. Each item is
   a command, so it shows its shortcut and greys out where it cannot act. */
body { display: block; }
.menu-item { height: var(--menu-row-h); }
<use ui="Menu" id="code-menu">
  <use ui="MenuCommand" data-alias-command="commands.goToDefinition"/>
  <use ui="MenuCommand" data-alias-command="commands.findReferences"/>
  <use ui="MenuSeparator"/>
  <use ui="MenuCommand" data-alias-command="commands.renameSymbol"/>
  <use ui="MenuCommand" data-alias-command="commands.callHierarchy"/>
  <use ui="MenuSeparator"/>
  <use ui="MenuCommand" data-alias-command="commands.toggleLineComment"/>
  <use ui="MenuCommand" data-alias-command="commands.find"/>
</use>
.collab-dialog .dialog-panel {
    width: 520dp; max-width: 94%; padding: 0dp; overflow: hidden;
}
.collaboration {
    display: flex; flex-direction: column; width: 100%; color: var(--foreground);
    font-family: var(--font-ui); font-size: var(--studio-font-13, 13dp); line-height: var(--studio-line-18, 18dp);
}
.collab-head {
    display: flex; align-items: center; justify-content: space-between; gap: 16dp;
    padding: 16dp 20dp; border-bottom: 1dp var(--line); background-color: var(--card);
}
.collab-heading { display: flex; align-items: center; gap: 12dp; min-width: 0dp; }
.collab-icon { width: var(--studio-height-28, 28dp); height: var(--studio-height-28, 28dp); line-height: var(--studio-line-28, 28dp); color: var(--primary-text); }
.collab-title { color: var(--foreground); font-size: var(--studio-font-16, 16dp); line-height: var(--studio-line-20, 20dp); font-weight: 600; }
.collab-subtitle { margin-top: 2dp; color: var(--muted-foreground); }
.collab-head .close { flex: 0 0 auto; }
.collab-body { display: flex; flex-direction: column; gap: 14dp; padding: 18dp 20dp 20dp; }
.collab-status {
    display: flex; align-items: flex-start; gap: 9dp; padding: 10dp 12dp;
    border: 1dp var(--line); border-radius: var(--r-lg); background-color: var(--muted);
}
.status-mark { width: 8dp; height: 8dp; margin-top: 5dp; border-radius: 4dp; background-color: var(--muted-foreground); flex: 0 0 auto; }
.status-mark[data-state=on] { background-color: var(--primary); }
.status-text { color: var(--foreground); white-space: normal; }
.collab-status.error { border-color: var(--destructive); background-color: color-mix(in srgb, var(--destructive) 8%, var(--muted)); }
.collab-status.error .status-mark { background-color: var(--destructive); }
.collab-status.error .status-text { color: var(--destructive); }
.unavailable { display: flex; align-items: flex-start; gap: 8dp; padding: 10dp 12dp; color: var(--muted-foreground); }
.unavailable .icon { flex: 0 0 auto; }
.collab-actions { display: flex; flex-direction: column; gap: 14dp; }
.action-section { display: flex; flex-direction: column; gap: 8dp; padding-bottom: 14dp; border-bottom: 1dp var(--line); }
.section-copy { display: flex; flex-direction: column; gap: 2dp; }
.section-title { color: var(--foreground); font-weight: 600; }
.section-hint { color: var(--muted-foreground); white-space: normal; }
.input-row { display: flex; align-items: center; gap: 8dp; }
.collab-input {
    flex: 1 1 0dp; min-width: 0dp; height: var(--h); padding: var(--input-pad) 9dp; border: 1dp var(--input);
    border-radius: var(--r); background-color: var(--field-edit); color: var(--foreground);
    font-family: var(--font-ui); font-size: var(--studio-font-13, 13dp); line-height: var(--input-line); white-space: normal;
}
.collab-input:focus-visible { border-color: var(--ring); }
.collab-input:placeholder-shown { color: var(--faint-foreground); }
.action-button { height: var(--h); flex: 0 0 auto; }
.session-actions { display: flex; justify-content: flex-end; }
.invite-section { padding-bottom: 0dp; border-bottom: 0dp transparent; }
.invite-actions { display: flex; gap: 8dp; }
.invite-actions .btn { height: var(--h); }
.token-field { display: flex; flex-direction: column; gap: 6dp; }
.token-field label { color: var(--muted-foreground); }
.token-field .collab-input { flex: 0 0 auto; width: 100%; }
.participant-list { display: flex; flex-direction: column; gap: 4dp; max-height: 180dp; overflow-y: auto; }
.participant { display: flex; align-items: center; gap: 8dp; min-height: var(--h); }
.avatar { width: var(--studio-height-18, 18dp); height: var(--studio-height-18, 18dp); border-radius: 9dp; flex: 0 0 auto; }
.participant-name { flex: 1 1 0dp; min-width: 0dp; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
<use ui="Dialog" class="collab-dialog" data-keys="Escape:Close">
  <div class="collaboration">
    <header class="collab-head">
      <div class="collab-heading">
        <span class="icon collab-icon">{{ commands.collaboration.icon }}</span>
        <div><div class="collab-title">Collaboration</div><div class="collab-subtitle">Share this workspace with an invite.</div></div>
      </div>
      <button class="btn icon-only close" data-tip="Close" aria-label="Close collaboration" autofocus data-event-click="emit('Close')"><span class="icon">&#xea76;</span></button>
    </header>
    <div class="collab-body">
      <div class="collab-status" role="status" aria-live="polite" data-class-error="collaboration.error">
        <span class="status-mark" data-attr-data-state="collaboration.connected ? 'on' : 'off'"/>
        <span class="status-text">{{ collaboration.status }}</span>
      </div>
      <div class="unavailable" data-if="!collaboration.available"><span class="icon">&#xea74;</span><span>Room collaboration is available in the web editor.</span></div>
      <div class="collab-actions" data-if="collaboration.available &amp;&amp; !collaboration.connected">
        <section class="action-section">
          <div class="section-copy"><div class="section-title">Join a room</div><div class="section-hint">Paste an editor or viewer invite link.</div></div>
          <div class="input-row">
            <input id="collab-invite" class="collab-input" type="text" autocomplete="off" placeholder="Paste an invite link" aria-label="Room invite link" data-value="collaboration.invite" data-keys="Enter:studio.collaborationJoin" data-attrif-disabled="collaboration.busy"/>
            <button class="btn primary action-button join" data-attrif-data-disabled="!commands.collaborationJoin.enabled" data-event-click="emit('studio.collaborationJoin')">Join room</button>
          </div>
        </section>
        <section class="action-section">
          <div class="section-copy"><div class="section-title">Create a room</div><div class="section-hint">Create an isolated shared workspace.</div></div>
          <div class="input-row"><button class="btn primary action-button host" data-attrif-data-disabled="!commands.collaborationHost.enabled" data-event-click="emit('studio.collaborationHost')">Create room</button><button class="btn ghost token-toggle" data-attrif-data-disabled="collaboration.busy" data-event-click="emit('studio.collaborationToken')">{{ collaboration.token_expanded ? 'Hide admin token' : 'Use admin token' }}</button></div>
          <div class="token-field" data-if="collaboration.token_expanded"><label for="collab-token">Admin token · optional</label><input id="collab-token" class="collab-input" type="password" autocomplete="off" placeholder="Enter token if required" aria-label="Admin token" data-value="collaboration.token" data-keys="Enter:studio.collaborationHost" data-attrif-disabled="collaboration.busy"/></div>
        </section>
      </div>
      <div class="collab-actions" data-if="collaboration.connected">
        <section class="participants action-section">
          <div class="section-title">Participants</div>
          <div class="section-hint" data-if="!collaboration.has_peers">Just you. Invite someone to work together.</div>
          <div class="participant-list">
            <div class="participant" data-for="peer, i : collaboration.peers"><span class="avatar" data-attr-style="'background-color: ' + peer.color"/><span class="participant-name">{{ peer.name }}</span><button class="btn ghost sm follow" data-if="!peer.following" data-event-click="emit('studio.collaborationFollow', i)">Follow</button><button class="btn ghost sm unfollow" data-if="peer.following" data-event-click="emit('studio.collaborationUnfollow')">Stop following</button></div>
          </div>
        </section>
        <section class="action-section invite-section" data-if="collaboration.host">
          <div class="section-copy"><div class="section-title">Invite people</div><div class="section-hint">Copy a role-specific link to the clipboard.</div></div>
          <div class="invite-actions"><button class="btn outline" data-attrif-data-disabled="!commands.collaborationInviteEditor.enabled" data-event-click="emit('studio.collaborationInviteEditor')">Copy editor invite</button><button class="btn outline" data-attrif-data-disabled="!commands.collaborationInviteViewer.enabled" data-event-click="emit('studio.collaborationInviteViewer')">Copy viewer invite</button></div>
        </section>
        <div class="session-actions"><button class="btn outline leave" data-attrif-data-disabled="!commands.collaborationLeave.enabled" data-event-click="emit('studio.collaborationLeave')">Leave room</button></div>
      </div>
    </div>
  </div>
</use>
/* The native <color-field>: a swatch whose picker (plane, hue, RGBA hex and
   Opacity) opens as <input type=color>'s would. Bind data-attr-value to a
   "#rrggbbaa" value; input runs while the picker is open and change once
   when it closes. */
body { display: flex; flex: 1 1 0dp; }
<color-field class="field color" attrs></color-field>
/* Details (studio_designer_details.c), as Unity UI Builder's Inspector and
   UMG's Details: the selected element's identity, then a collapsible panel
   for its attributes, its data bindings, its inline style and each rule of
   the document's RCSS that matches it, a row a property, each value in the
   control its type calls for. With nothing selected it lists every rule.
   The `details` source writes the panels; the Add popover is shared by every
   Add button and takes its text from `details_add`. */
body, body.area-panel { width: 100%; height: 100%; margin: 0dp; padding: 0dp; overflow: hidden; }
.designer-details { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; }
.prop-scroll { flex: 1 1 0dp; overflow-y: auto; padding: 8dp 8dp 16dp; }
/* A row's one control, as its kind builds it. */
.kind { display: flex; flex: 1 1 0dp; }
/* RmlUi gives :focus to a focused element's ancestors too, as :focus-within. */
.field.text:focus { background-color: var(--field-edit); border-color: var(--ring); }
/* A panel's head folds it. */
.panel-fold { display: flex; align-items: center; gap: 6dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.prop .remove { flex: 0 0 auto; opacity: 0; transition: opacity 0.11s cubic-out; }
.prop:hover .remove { opacity: 1; }
.designer-chips { display: flex; flex: 1 1 0dp; flex-wrap: wrap; align-items: center; gap: 4dp; min-height: var(--h); }
.designer-chip { display: flex; align-items: center; height: var(--studio-height-20, 20dp); padding: 0dp 1dp 0dp 7dp; border-radius: 10dp; background-color: var(--secondary); color: var(--foreground); white-space: nowrap; }
.designer-chip .btn { height: 16dp; border-radius: 8dp; }
.designer-chip .btn .icon { font-size: 10dp; color: var(--muted-foreground); }
.designer-chips .designer-add { height: 20dp; border-radius: 10dp; }
/* Data bindings are code, small and in the link color. The theme's rule also
   set the mono font family, which a later field rule always overrode, so it
   is left out to keep what the panel always showed. */
[data-bindings] .field .value { font-size: var(--studio-mono-font-11, 11dp); color: var(--link); }
.designer-more { display: flex; margin-top: 6dp; }
.designer-more .btn { flex: 1 1 0dp; justify-content: center; color: var(--muted-foreground); }
.designer-origin { display: flex; align-items: center; gap: 6dp; height: var(--studio-height-20, 20dp); font-size: var(--studio-font-11, 11dp); color: var(--faint-foreground); }
.designer-origin .within { color: var(--muted-foreground); white-space: nowrap; }
.designer-origin .spacer { flex: 1 1 0dp; }
.designer-origin .btn { height: var(--studio-height-18, 18dp); padding: 0dp 4dp; gap: 3dp; font-size: var(--studio-font-11, 11dp); color: var(--muted-foreground); font-family: var(--font-numeric); }
.designer-origin .btn .icon { font-size: 10dp; width: 11dp; }
/* data-for leaves its template last among the segments, so :last-child
   names none of them: the options say which is the last. */
.segmented .seg[data-last] { border-radius: 0dp 4dp 4dp 0dp; }
.designer-none, .designer-hint { display: block; padding: 6dp 4dp; font-size: var(--studio-font-11, 11dp); color: var(--faint-foreground); }
#details-add { width: 240dp; }
.designer-add-field { display: block; padding: 2dp 4dp 4dp; }
.designer-add-field .field { height: var(--studio-height-24, 24dp); }
<div class="designer-details">
  <div class="prop-scroll">
    <div class="identity">
      <div class="glyph"><span class="icon">{{ details.identity.icon }}</span></div>
      <div class="who">
        <span class="title">{{ details.identity.title }}</span>
        <div class="lineage"><span>{{ details.identity.kind }}</span><button class="btn" data-if="details.identity.source != ''" data-tip="Edit Source" data-event-click="emit('details.source')"><span class="icon">&#xea73;</span><span class="label">{{ details.identity.source }}</span></button></div>
      </div>
    </div>
    <span class="designer-hint" data-if="details.hint != ''">{{ details.hint }}</span>
    <section class="panel" data-for="section : details.sections" data-attr-data-key="section.key" data-attrif-data-open="section.open" data-attrif-data-bindings="section.kind == 'bindings'">
      <div class="panel-head">
        <div class="panel-fold" data-event-click="emit('details.fold', section.key)">
          <span class="icon chev">&#xeab4;</span>
          <span class="title">{{ section.title }}</span>
          <span class="spacer"></span>
        </div>
      </div>
      <div class="panel-body" data-if="section.open">
        <div class="designer-origin" data-if="section.origin != ''">
          <span class="within" data-if="section.within != ''">{{ section.within }}</span>
          <span class="spacer"></span>
          <button class="btn sm" data-tip="Edit Source" data-event-click="emit('details.openRule', section.rule)"><span class="icon">&#xeb14;</span><span class="label">{{ section.origin }}</span></button>
        </div>
        <use ui="PropertyRow" data-for="row : section.rows" data-alias-property="row">
          <div class="kind" data-when="row.control == 'text'">
            <div class="field text"><input type="text" class="part value" data-attr-id="row.id" data-attr-aria-label="row.label" data-attr-value="row.text" data-attr-placeholder="row.placeholder" data-keys="Escape:details.cancel" data-event-change="emit('details.text', row.id)"/></div>
          </div>
          <div class="kind" data-when="row.control == 'number'"><use ui="NumberField" data-attr-id="row.id" data-attr-aria-label="row.label" data-attr-value="row.number" data-attr-min="row.min" data-attr-max="row.max" data-attr-step="row.step" data-attr-precision="row.precision" data-attr-unit="row.unit" data-attrif-integer="row.integer" data-attrif-slider="row.slider" data-event-input="emit('details.input', row.id, ev.value)" data-event-change="emit('details.change', row.id, ev.value, ev.canceled)"/></div>
          <div class="kind" data-when="row.control == 'color'"><use ui="ColorField" data-attr-id="row.id" data-attr-aria-label="row.label" data-attr-value="row.color" data-event-input="emit('details.input', row.id, ev.value)" data-event-change="emit('details.change', row.id, ev.value, ev.canceled)"/></div>
          <div class="kind" data-when="row.control == 'choice'"><use ui="EnumField" data-alias-table="row.table" data-alias-value="row.value" data-event-click="emit('details.choices', row.id)" data-event-change="emit('details.change', row.id, ev.value)"/></div>
          <div class="kind" data-when="row.control == 'toggle'">
            <div class="segmented"><button class="seg" data-for="option : row.options" data-attrif-data-pressed="option.pressed" data-attrif-data-last="option.last" data-event-click="emit('details.change', row.id, option.label)">{{ option.label }}</button></div>
          </div>
          <div class="kind" data-when="row.control == 'asset'"><use ui="AssetField" data-alias-table="choices.assets.ui" data-alias-value="row.text" data-event-change="emit('details.change', row.id, ev.value)"/></div>
          <div class="designer-chips" data-when="row.control == 'chips'">
            <div class="designer-chip" data-for="chip : row.chips"><span class="name">{{ chip.name }}</span><button class="btn sm icon-only" data-tip="Remove class" data-event-click="emit('details.removeClass', chip.name)"><span class="icon">&#xea76;</span></button></div>
            <button class="btn sm icon-only designer-add" data-event-click="emit('details.add', 'class', section.addTarget)"><span class="icon">&#xea60;</span></button>
          </div>
          <button class="btn sm icon-only remove" data-if="row.remove" data-tip="Remove" data-event-click="emit('details.remove', row.id)"><span class="icon">&#xea76;</span></button>
        </use>
        <span class="designer-none" data-if="section.none != ''">{{ section.none }}</span>
        <div class="designer-more" data-if="section.addLabel != ''">
          <button class="btn sm designer-add" data-event-click="emit('details.add', section.addKind, section.addTarget)"><span class="icon">&#xea60;</span><span class="label">{{ section.addLabel }}</span></button>
          <button class="btn sm designer-add" data-if="section.extract" data-tip="Move the inline style into a new class rule" data-event-click="emit('details.add', 'extract', section.addTarget)"><span class="icon">&#xeb14;</span><span class="label">Extract to Class</span></button>
        </div>
      </div>
    </section>
    <span class="designer-none" data-if="details.note != ''">{{ details.note }}</span>
  </div>
  <use ui="Menu" id="details-add">
    <div class="menu-group">{{ details_add.title }}</div>
    <div class="designer-add-field"><div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" id="details-add-field" class="part value" data-attr-placeholder="details_add.hint" data-value="details_add.text" data-keys="Enter:details.addEnter"/></div></div>
    <use ui="MenuSeparator" data-if="details_add.suggestions.size > 0"/>
    <div class="menu-item" role="menuitem" data-for="entry : details_add.suggestions" data-event-click="emit('details.addPick', entry.label)"><span class="icon lead"></span><span class="text"><span class="label">{{ entry.label }}</span></span></div>
  </use>
</div>
/* Details' header controls (studio_designer_details.c), in its AreaHeader:
   the search, two-way bound to details.query, which filters the rows of
   every panel as Properties' search does. */
body { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.field.search { min-width: 0dp; }
/* RmlUi gives :focus to a focused element's ancestors too, as :focus-within. */
.field.search:focus { background-color: var(--field-edit); border-color: var(--ring); }
<span class="designer-mode">Details</span>
<div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" class="part value" id="details-search" placeholder="Search properties" aria-label="Search properties" data-value="details.query"/></div>
/* A modal dialog: a backdrop whose press emits Close, and a panel holding
   the use's children. class="window" makes it nearly window-sized, as a
   preferences window, with the children filling it. The backdrop fades in;
   the panel fades and grows from 96%, never from nothing, so it arrives
   from where it sits (Emil: modals enter with scale 0.95 to 1 and opacity,
   ease-out, under 200 ms). */
body {
  position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp;
  display: flex; overflow: auto;
}
.dialog-backdrop {
  position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; background-color: #0000008c;
  animation: 0.14s cubic-out 1 dialog-fade;
}
.dialog-panel {
  position: relative; margin: auto; padding: 12dp; color: var(--foreground); background-color: var(--popover);
  border: 1dp var(--popover-edge); border-radius: var(--r-lg); box-shadow: var(--shadow-overlay);
  animation: 0.16s cubic-out 1 dialog-enter;
}
body.window .dialog-panel {
  display: flex; flex-direction: column; width: 88%; max-width: 1000dp; height: 86%; max-height: 720dp;
  min-width: 560dp; min-height: 360dp; padding: 0dp; overflow: hidden;
}
@keyframes dialog-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes dialog-enter {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}
@media (theme: reduced-motion) {
  .dialog-backdrop, .dialog-panel { animation: none; }
}
<div class="dialog-backdrop" data-event-click="emit('Close')"/>
<div class="dialog-panel"><slot/></div>
/* A named choice as a searchable dropdown anchored to the field, every
   value listed (Base UI's Select over a Combobox list). Alias the choices
   as data-alias-table, a table { groups: [{ label, options: [{ value,
   label, icon }] }] } such as choices.fields.Body.type, and the value
   as data-alias-value; choosing sends change with ev.value, the option's
   value, as data-event-change="emit('properties.change', row.id, ev.value)".
   data-mixed shows a dash for several objects' differing values, and
   data-readonly keeps it shut. */
body { display: flex; flex: 1 1 0dp; }
.enum-field { display: flex; flex: 1 1 0dp; min-width: 0dp; }
.dropdown { min-width: var(--anchor-width, 180dp); }
.mixed { display: none; }
.enum-field[data-mixed] .mixed { display: inline; }
.enum-field[data-mixed] .current { display: none; }
.enum-field[data-mixed] .field > .value { color: var(--muted-foreground); }
.enum-field[data-readonly] .field { background-color: transparent; border-color: var(--border); pointer-events: none; tab-index: none; }
<div class="enum-field" attrs>
  <button class="field select" popovertarget="choices" aria-haspopup="listbox"><span class="part value"><span class="mixed">&#x2014;</span><span class="current" data-for="group : table.groups"><span data-for="option : group.options" data-if="option.value == value">{{ option.label }}</span></span></span><span class="icon caret">&#xeab4;</span></button>
  <div class="popup dropdown" popover data-template id="choices">
    <use ui="ChoiceList">
      <div role="group" data-for="group : table.groups">
        <use ui="MenuGroup" data-if="group.label != ''" data-alias-group="group"/>
        <div class="menu-item" role="option" data-for="option : group.options" data-attr-value="option.value" data-attr-data-label="option.label" data-attrif-data-current="option.value == value"><span class="icon lead">{{ option.icon }}</span><span class="text"><span class="label">{{ option.label }}</span></span></div>
      </div>
    </use>
  </div>
</div>
/* One value of a graph row in Properties' Node and Member tabs
   (studio_graph_details.c): the control its kind names, aliased as
   data-alias-kind, over the row aliased as data-alias-field. A source field
   (kind source) is one editable field with type-aware completion, Base UI's
   Combobox: typing a literal offers it as a constant, typing a property path
   browses the fields that fit, and the list under the field is the palette's
   rows, which C ranks and windows (studio_graph_values.c). Its controls send
   graph_details.input and change with the row's id. */
body { display: flex; flex: 1 1 0dp; min-width: 0dp; }
.graph-field { display: flex; flex: 1 1 0dp; min-width: 0dp; align-items: center; gap: 4dp; }
/* A kind's one control, as its row's kind builds it. */
.kind { display: flex; flex: 1 1 0dp; min-width: 0dp; }
.source-field { display: flex; flex: 1 1 0dp; min-width: 0dp; }
.source-field .field { flex: 1 1 0dp; }
.popup.autocomplete { min-width: var(--anchor-width, 180dp); }
.source-list { display: block; }
.source-row { display: block; }
#palette-list {
    height: auto; max-height: 140dp;
    --row: var(--autocomplete-row-h); --row-heading: var(--autocomplete-row-h); --row-about: var(--autocomplete-row-h);
}
.source-field [data-ui=List] { height: auto; }
<div class="graph-field" attrs>
  <span class="dim" data-when="kind == 'label'">{{ field.text }}</span>
  <span class="chip graph-source-context" data-when="kind == 'chip'">{{ field.text }}</span>
  <div class="field text" data-when="kind == 'text'" data-attrif-data-readonly="field.readonly">
    <input type="text" class="part value" data-attr-id="field.id" data-attr-aria-label="field.label" data-attr-value="field.text" data-attr-placeholder="field.placeholder" data-attrif-readonly="field.readonly" data-keys="Escape:graph_details.cancel" data-event-change="emit('graph_details.change', field.id, ev.value)"/>
  </div>
  <div class="field text" data-when="kind == 'edit'">
    <input type="text" class="part value" autofocus data-attr-id="field.id" data-attr-aria-label="field.label" data-attr-value="field.text" data-attr-placeholder="field.placeholder" data-keys="Escape:graph_details.cancel" data-event-change="emit('graph_details.change', field.id, ev.value)"/>
  </div>
  <div class="field text area" data-when="kind == 'area'" data-attrif-data-readonly="field.readonly">
    <textarea class="part value" data-attr-id="field.id" data-attr-aria-label="field.label" data-attr-rows="field.precision" data-attr-value="field.text" data-attrif-readonly="field.readonly" data-keys="Escape:graph_details.cancel" data-event-change="emit('graph_details.change', field.id, ev.value)"></textarea>
  </div>
  <div class="kind" data-when="kind == 'bool'"><use ui="Checkbox" data-attr-id="field.id" data-attr-aria-label="field.label" data-attrif-checked="field.checked" data-attrif-disabled="field.readonly" data-event-change="emit('graph_details.check', field.id, ev.value)"><span class="label" data-if="field.check != ''">{{ field.check }}</span></use></div>
  <div class="kind" data-when="kind == 'number'"><use ui="NumberField" data-attr-id="field.id" data-attr-aria-label="field.label" data-attr-value="graph_values[field.slot]" data-attr-min="field.min" data-attr-max="field.max" data-attr-step="field.step" data-attr-precision="field.precision" data-attrif-integer="field.integer" data-attrif-float="field.float" data-attrif-readonly="field.readonly" data-event-input="emit('graph_details.input', field.id, ev.value)" data-event-change="emit('graph_details.change', field.id, ev.value, ev.canceled)"></use></div>
  <div class="kind" data-when="kind == 'vector'"><use ui="VectorField" data-alias-axes="field.axes" data-alias-values="graph_values" data-alias-field="field" data-event-input="emit('graph_details.input', field.id, ev.value, '', ev.name)" data-event-change="emit('graph_details.change', field.id, ev.value, ev.canceled, ev.name)"></use></div>
  <div class="kind" data-when="kind == 'choice'"><use ui="EnumField" data-alias-table="field.table" data-alias-value="field.value" data-attrif-data-readonly="field.readonly" data-event-click="emit('graph_details.choices', field.id)" data-event-change="emit('graph_details.change', field.id, ev.value)"></use></div>
  <div class="kind" data-when="kind == 'container'"><use ui="EnumField" data-alias-table="graph_details.containers.table" data-alias-value="field.container" data-attrif-data-readonly="field.readonly" data-event-change="emit('graph_details.change', field.id, ev.value)"></use></div>
  <div class="color-alpha-row" data-when="kind == 'color'">
    <use ui="ColorField" data-attr-id="field.id" data-attr-aria-label="field.label" data-attr-value="field.value" data-attrif-readonly="field.readonly" data-event-input="emit('graph_details.input', field.id, ev.value)" data-event-change="emit('graph_details.change', field.id, ev.value, ev.canceled)"></use>
    <use ui="NumberField" data-if="field.alpha" data-attr-value="graph_values[field.alphaSlot]" min="0" max="1" step="0.01" precision="3" addon="Alpha" data-attrif-readonly="field.readonly" data-event-input="emit('graph_details.input', field.id, ev.value, '', 'alpha')" data-event-change="emit('graph_details.change', field.id, ev.value, ev.canceled, 'alpha')"></use>
  </div>
  <div class="kind" data-when="kind == 'asset'"><use ui="AssetField" data-alias-table="field.table" data-alias-value="field.text" data-attr-data-drop="field.drop" data-drop-hint="Assign" data-attr-data-tip="field.problem" data-attrif-data-readonly="field.readonly" data-attrif-data-invalid="field.invalid" data-event-click="emit('palette.pick', field.kind, field.text, field.table.none, 'typed')" data-event-change="emit('graph_details.change', field.id, ev.value)"></use></div>
  <choice-list virtualized class="source-field" data-when="kind == 'source'" data-attr-aria-setsize="palette.count" data-attr-highlight="palette_ui.highlight" data-event-highlight="emit('palette.highlight', ev.value, ev.pointer)" data-event-change="emit('palette.choose', ev.value)">
    <div class="field autocomplete" data-attrif-data-open="graph_details_ui.source == field.id">
      <input type="text" class="part value" role="combobox" aria-autocomplete="list" data-attr-id="field.id" data-attr-aria-label="field.label" data-attr-aria-expanded="graph_details_ui.source == field.id ? 'true' : 'false'" data-attr-value="field.text" data-attr-placeholder="field.placeholder" data-keys="Escape:graph_details.escape Tab:graph_details.tab" data-event-focus="emit('graph_details.source', field.id)" data-event-input="emit('graph_details.query', field.id, ev.value)"/>
    </div>
    <div class="popup autocomplete" popover role="listbox">
      <div class="source-list" data-when="graph_details_ui.source == field.id">
        <use ui="List" id="palette-list" data-event-scroll="emit('palette.scroll')">
          <div class="source-row" data-for="row : palette.rows">
            <div class="menu-group" data-if="row.heading">{{ row.label }}</div>
            <div class="menu-item" role="option" data-if="!row.heading" data-attr-value="row.place" data-attr-aria-posinset="row.place" data-attrif-data-current="row.current" data-attr-data-tip="row.about == '' ? '' : row.tip" data-attr-data-tip-about="row.about"><span class="icon lead" aria-hidden="true">{{ row.icon }}</span><span class="text"><span class="label" data-rml="row.label"></span></span><span class="detail" data-attrif-data-empty="row.meta == ''">{{ row.meta }}</span></div>
          </div>
        </use>
        <span class="dropdown-empty" data-if="palette.count == 0">No matching options</span>
      </div>
    </div>
  </choice-list>
</div>
/* Find in graph (studio_graph_find.c), over the canvas's top right in the
   theme's .find-widget, as VS Code's find widget: the query, the match
   count, Previous, Next and Close, and below them the matches, eight rows
   tall at most, each naming its node and, when the match is in a pin,
   value or another graph, where. */
body { display: flex; flex-direction: column; gap: 4dp; }
/* A focused query shows as the kit's field did while editing. */
.field.search:focus-within { background-color: var(--field-edit); }
.graph-find-list { position: relative; }
.graph-find-list .tree-row .meta { display: block; flex: 0 1 auto; max-width: 60%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
<div class="find-widget-bar">
  <div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" class="part value" id="graph-find-query" placeholder="Find" autofocus="" data-value="graph_find.query" data-keys="Enter:graph_find.enter Escape:graph_find.close Up:graph_find.previous Down:graph_find.next"/></div>
  <span class="find-widget-count">{{ graph_find.count }}</span>
  <button class="btn icon-only" data-tip="Previous" data-kbd="&#x2191;" data-attrif-data-disabled="graph_find.total == 0" data-event-click="emit('graph_find.previous')"><span class="icon">&#xeab7;</span></button>
  <button class="btn icon-only" data-tip="Next" data-kbd="&#x2193;" data-attrif-data-disabled="graph_find.total == 0" data-event-click="emit('graph_find.next')"><span class="icon">&#xeab4;</span></button>
  <button class="btn icon-only" data-tip="Close" data-kbd="Esc" data-event-click="emit('graph_find.close')"><span class="icon">&#xea76;</span></button>
</div>
<div class="graph-find-list" data-if="graph_find.total > 0" data-style-height="graph_find.height">
  <use ui="List" id="graph-find-list" data-event-scroll="emit('graph_find.scroll')">
    <use ui="TreeRow" data-for="row : graph_find.rows" data-alias-item="row" data-alias-selection="graph_find.none" data-alias-active="graph_find.none" data-event-click="emit('graph_find.jump', row.key)"></use>
  </use>
</div>
/* The graph canvas's context menus (studio_graph_menu.c, the `graph_menu`
   source): a node's, a pin's, a wire's or a comment frame's, at the right
   click, in a document of its own shown only while it is open, as Unreal's
   graph context menus are. Its entries are MenuItems with a separator above
   where one is marked; Select, Alignment, Break Link To and Color open
   beside their rows. A comment frame's colors are dots in their color, the
   frame's own in primary. */
body { display: block; }
.graph-menu-entry { display: block; }
.menu-item { height: var(--menu-row-h); }
<use ui="Menu" id="graph-menu">
  <use ui="MenuGroup" data-if="graph_menu.group.label != ''" data-alias-group="graph_menu.group"/>
  <div class="graph-menu-entry" data-for="entry : graph_menu.items">
    <use ui="MenuSeparator" data-if="entry.sep"/>
    <use ui="MenuItem" data-when="!entry.sub" data-alias-item="entry" data-attrif-data-current="entry.current" data-event-click="emit('graph_menu.run', entry.key)"></use>
    <use ui="Submenu" data-when="entry.sub" data-alias-item="entry">
      <div class="graph-menu-entry" data-for="child : entry.items">
        <use ui="MenuSeparator" data-if="child.sep"/>
        <use ui="MenuItem" data-when="child.swatch == ''" data-alias-item="child" data-attrif-data-current="child.current" data-event-click="emit('graph_menu.run', child.key)"></use>
        <div class="menu-item" role="menuitem" data-when="child.swatch != ''" data-attrif-data-disabled="child.disabled" data-attrif-data-current="child.current" data-event-click="emit('graph_menu.run', child.key)"><span class="icon lead" data-style-color="child.swatch">{{ child.icon }}</span><span class="text"><span class="label">{{ child.label }}</span></span></div>
      </div>
    </use>
  </div>
</use>
/* The Behavior header's View menu: the button opens a Menu of the graph's
   view preferences, bound to Studio's saved keys. */
body { display: flex; flex: 0 0 auto; }
<button class="btn icon-only" popovertarget="graph-view" aria-haspopup="menu" data-tip="View"><span class="icon">&#xeb2f;</span></button>
<use ui="Menu" id="graph-view">
  <use ui="MenuGroup">Wires</use>
  <use ui="MenuOption" data-checked="save.wires" value="curved">Curved</use>
  <use ui="MenuOption" data-checked="save.wires" value="orthogonal">Orthogonal</use>
  <use ui="MenuOption" data-checked="save.wires" value="straight">Straight</use>
  <use ui="MenuOption" data-checked="save.wires" value="subway">Subway</use>
  <use ui="MenuSeparator"/>
  <use ui="MenuGroup">Nodes</use>
  <use ui="MenuCheck" data-checked="save.shortBindings">Short Bindings</use>
  <use ui="MenuCheck" data-checked="save.titleFlow">Flow in Titles</use>
  <use ui="MenuCheck" data-checked="save.compactNodes">Compact Nodes</use>
  <use ui="MenuSeparator"/>
  <use ui="MenuGroup">Debugging</use>
  <use ui="MenuCheck" data-checked="save.liveValues">Live Values</use>
</use>
/* The Hierarchy (studio_designer_hierarchy.c), as Unity UI Builder's and
   UMG's: a UI document as a row, then a row per element its filter shows,
   in a List whose window the `hierarchy` source fills for this area's
   `view`. A row selects on click, folds with its twisty, opens its source
   (or its widget) on a double click and its menu on a right press, and
   drags to reorder or reparent: its top and bottom quarters drop before and
   after it and its middle inside it (data-drop-zones="tree"); an element
   that holds nothing takes halves ("list"). A row carried with the keyboard
   marks the slot it would drop in as a pointer drag does, by
   data-carry-zone. The list is one Tab stop, and while the keyboard holds
   it the active row shows the focus ring. */
body { overflow: hidden; padding: 0dp; }
.hierarchy-panel { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; }
.list {
  position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; height: auto; padding: 3dp 4dp 8dp;
  tab-index: auto;
}
.hierarchy-row { display: block; }
.tree-row { tab-index: none; }
.tree-row .name { flex: 0 1 auto; }
.tree-row .meta { flex: 1 1 0dp; margin-left: 2dp; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tree-row .bound { font-size: 12dp; width: 14dp; color: var(--link); pointer-events: none; }
.list:focus-visible .tree-row[data-active] { border-color: var(--ring); }
/* Where a carried row would drop: a line above or below the row, or the row
   itself. */
[data-carry-zone=before] .tree-row { border-color: transparent; border-top-color: var(--primary); background-color: transparent; }
[data-carry-zone=after] .tree-row { border-color: transparent; border-bottom-color: var(--primary); background-color: transparent; }
[data-carry-zone=inside] .tree-row { border-color: var(--primary); background-color: var(--primary-soft); }
/* With a filter that hides every element, the notice names the query and
   offers the way back. */
.outliner-empty { display: flex; flex-direction: column; align-items: center; gap: 8dp; padding: 0dp 16dp; }
.outliner-empty .btn { pointer-events: auto; }
<div class="hierarchy-panel">
  <use ui="List" id="hierarchy-list" data-drop="ui" data-event-drop="emit('hierarchy.drop', '', ev.payload, ev.zone)" data-event-scroll="emit('hierarchy.scroll')">
    <use ui="TreeRow" class="hierarchy-root" data-if="view.root" data-alias-item="hierarchy.root" data-alias-selection="hierarchy_ui.selected" data-alias-active="hierarchy_ui.selected" data-drop="ui" data-attr-data-element="hierarchy.root.key" data-attr-data-carry-zone="hierarchy_carry.target == hierarchy.root.key ? hierarchy_carry.place : ''" data-event-drop="emit('hierarchy.drop', hierarchy.root.key, ev.payload, ev.zone); stop()" data-event-click="emit('hierarchy.click', hierarchy.root.key)" data-event-contextmenu="emit('hierarchy.menu', hierarchy.root.key)"></use>
    <div class="hierarchy-row" data-for="row : view.rows">
      <use ui="TreeRow" data-alias-item="row" data-alias-selection="hierarchy_ui.selected" data-alias-active="hierarchy_ui.selected" data-drag="ui" data-drop="ui" data-attr-data-drop-zones="row.zones" data-attr-data-element="row.key" data-attr-data-drag-payload="row.payload" data-attr-data-drag-label="row.label" data-attr-data-drag-icon="row.icon" data-attr-data-carry-zone="hierarchy_carry.target == row.key ? hierarchy_carry.place : ''" data-attrif-data-dragging="hierarchy_carry.element == row.key" data-event-drop="emit('hierarchy.drop', row.key, ev.payload, ev.zone); stop()" data-event-click="emit('hierarchy.click', row.key)" data-event-dblclick="emit('hierarchy.open', row.key)" data-event-contextmenu="emit('hierarchy.menu', row.key)"><span class="icon bound" data-if="row.bound" data-tip="Bound to data">&#xf0339;</span></use>
    </div>
  </use>
  <div class="outliner-empty" data-if="hierarchy.empty != ''">
    <span class="notice">{{ hierarchy.empty }}</span>
    <button class="btn sm outline" data-event-click="hierarchy.query = ''"><span class="label">Clear Filter</span></button>
  </div>
  <use ui="Menu" id="hierarchy-menu">
    <div class="menu-group">{{ hierarchy_ui.menu.label }}</div>
    <use ui="Submenu" data-alias-item="hierarchy_ui.menu.add">
      <use ui="MenuItem" data-for="element : library.elements" data-alias-item="element" data-event-click="emit('library.add', element.markup, element.label)"/>
      <use ui="MenuSeparator" data-if="!library.none"/>
      <use ui="Submenu" data-if="!library.none" data-alias-item="library.widget">
        <use ui="MenuItem" data-for="widget : library.widgets" data-alias-item="widget" data-event-click="emit('library.add', widget.markup, widget.label)"/>
      </use>
    </use>
    <use ui="MenuItem" data-if="hierarchy_ui.menu.element" data-alias-item="hierarchy_ui.menu.duplicate" data-event-click="emit('hierarchy.duplicate')"/>
    <use ui="MenuItem" data-if="hierarchy_ui.menu.element" data-alias-item="hierarchy_ui.menu.wrap" data-event-click="emit('hierarchy.wrap')"/>
    <use ui="MenuSeparator" data-if="hierarchy_ui.menu.element"/>
    <use ui="MenuItem" data-if="hierarchy_ui.menu.element" data-alias-item="hierarchy_ui.menu.source" data-event-click="emit('hierarchy.source')"/>
    <use ui="MenuItem" data-if="hierarchy_ui.menu.widget" data-alias-item="hierarchy_ui.menu.openWidget" data-event-click="emit('hierarchy.widget')"/>
    <use ui="MenuSeparator" data-if="hierarchy_ui.menu.element"/>
    <use ui="MenuItem" data-if="hierarchy_ui.menu.element" data-alias-item="hierarchy_ui.menu.delete" data-event-click="emit('hierarchy.delete')"/>
  </use>
</div>
/* The Hierarchy's header controls (studio_designer_hierarchy.c), in its
   AreaHeader: the filter, two-way bound to hierarchy.query as the area's
   view state, and Add, a menu of the Library's elements and widgets that adds
   into the selection or after it. */
body { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.add { flex: 0 0 auto; }
<span class="designer-mode">Hierarchy</span>
<div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" class="part value" id="hierarchy-filter" placeholder="Filter" data-value="hierarchy.query"/></div>
<button class="btn icon-only add" popovertarget="hierarchy-add" aria-haspopup="menu" data-tip="Add" data-attr-data-tip-about="hierarchy_header.about"><span class="icon">&#xea60;</span></button>
<use ui="Menu" id="hierarchy-add">
  <div class="menu-group">Add</div>
  <use ui="MenuItem" data-for="element : library.elements" data-alias-item="element" data-event-click="emit('library.add', element.markup, element.label)"/>
  <use ui="MenuSeparator" data-if="!library.none"/>
  <use ui="Submenu" data-if="!library.none" data-alias-item="library.widget">
    <use ui="MenuItem" data-for="widget : library.widgets" data-alias-item="widget" data-event-click="emit('library.add', widget.markup, widget.label)"/>
  </use>
</use>
/* The UI Inspector (studio_inspect.c; studio_sources.c binds `inspector`).
   The tree, a List of TreeRows over the window the source shows of every
   element, and the details scroll apart, side by side in a wide area. */
body { overflow: hidden; padding: 0dp; }
.inspector { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; flex-direction: column; }
.toolbar {
  flex: 0 0 auto; display: flex; align-items: center; gap: 6dp; height: var(--studio-height-30, 30dp); padding: 0dp 6dp;
  border-bottom: 1dp var(--line);
}
.toolbar .targets { flex: 0 0 auto; margin-left: auto; }
.toolbar .targets .seg { flex: 0 0 auto; }
.segmented .seg.on { background-color: var(--primary); color: var(--primary-foreground); }
.panes { flex: 1 1 0dp; display: flex; flex-direction: column; }
.inspector.wide .panes { flex-direction: row; }
.inspect-tree { position: relative; flex: 1 1 0dp; }
.inspect-tree .list { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; height: auto; padding: 0dp 0dp 4dp; }
.inspect-host { display: block; }
.details { flex: 1 1 0dp; overflow-y: auto; padding: 6dp 8dp 10dp; border-top: 1dp var(--line); }
.inspector.wide .details { border-top-width: 0dp; border-left: 1dp var(--line); }
.note { display: block; padding: 10dp 8dp; color: var(--faint-foreground); text-align: center; }
.heading { display: flex; align-items: center; gap: 6dp; }
.heading .title { color: var(--tok-keyword); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.path { display: block; margin-top: 2dp; font-size: var(--studio-font-11, 11dp); color: var(--faint-foreground); word-break: break-all; }
.source { display: flex; align-items: center; gap: 6dp; margin-top: 6dp; }
.force { display: flex; align-items: center; gap: 4dp; margin-top: 8dp; }
.force-label { color: var(--muted-foreground); margin-right: 4dp; }
.chip { position: relative; display: block; height: var(--studio-height-20, 20dp); }
.chip input { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; opacity: 0; }
.chip span {
  display: block; height: var(--studio-height-20, 20dp); line-height: var(--studio-line-20, 20dp); padding: 0dp 6dp; border-radius: var(--r); font-size: var(--studio-font-11, 11dp);
  color: var(--muted-foreground); background-color: var(--secondary);
}
.chip:hover span { background-color: var(--field-hover); color: var(--foreground); }
.chip input:checked ~ span { background-color: var(--primary); color: var(--primary-foreground); }
.pseudo { display: block; margin-top: 4dp; font-size: var(--studio-font-11, 11dp); color: var(--faint-foreground); }
.tabs { margin-top: 10dp; }
.pane { display: block; margin-top: 6dp; }
.pair { display: flex; gap: 8dp; min-height: 18dp; line-height: var(--studio-line-18, 18dp); }
.pair .name { flex: 0 0 40%; color: var(--tok-name); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pair .value { flex: 1 1 0dp; color: var(--foreground); word-break: break-all; }

/* An Elements tree row: tag#id.class, the ui asset or widget it shows, and
   its text, in TreeRow's anatomy without an icon or meta. The tree marks
   the selected row and, while picking, the row the pointer is over in the
   app. */
.inspect-row .tree-row { gap: 0dp; border-radius: 0dp; padding-right: 8dp; }
.inspect-row .icon, .inspect-row .meta { display: none; }
.inspect-row .twisty { display: block; flex: 0 0 auto; width: 14dp; margin-right: 2dp; text-align: center; }
.inspect-row .name { flex: 0 0 auto; color: var(--tok-keyword); }
.inspect-row .trail { flex: 1 1 0dp; min-width: 0dp; overflow: hidden; gap: 0dp; }
.inspect-row[data-picked] .tree-row { background-color: var(--primary-soft); }
.inspect-row .tree-row[data-hidden] { opacity: 0.5; }
.inspect-row .ident { flex: 0 0 auto; color: var(--tok-number); }
.inspect-row .cls { flex: 0 0 auto; color: var(--tok-name); }
.inspect-row .widget {
  flex: 0 0 auto; height: var(--studio-height-14, 14dp); line-height: var(--studio-line-14, 14dp); margin-left: 6dp; padding: 0dp 4dp; border-radius: 3dp;
  font-size: var(--studio-font-10, 10dp); color: var(--primary-text); background-color: var(--primary-soft);
}
.inspect-row .text { flex: 0 1 auto; min-width: 0dp; margin-left: 6dp; color: var(--muted-foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
<div class="inspector" data-class-wide="inspector.wide">
  <div class="toolbar">
    <button class="btn sm pick" data-attr-data-state="inspector.picking ? 'on' : 'off'" data-event-click="emit('studio.inspectElement')"><span class="icon sm">&#xf01bf;</span><span class="label">Pick</span></button>
    <span class="kbd">{{ inspector.shortcut }}</span>
    <div class="segmented targets">
      <span class="seg" data-class-on="inspector.target == 'studio'" data-event-click="inspector.target = 'studio'">Studio</span>
      <span class="seg" data-if="inspector.graph" data-class-on="inspector.target == 'graph'" data-event-click="inspector.target = 'graph'">Graph</span>
      <span class="seg" data-if="inspector.game" data-class-on="inspector.target == 'game'" data-event-click="inspector.target = 'game'">Game</span>
    </div>
  </div>
  <div class="panes">
    <div class="inspect-tree">
      <use ui="List" id="inspector-list" data-event-scroll="emit('inspector.scroll')">
        <div class="inspect-host" data-for="row : inspector_tree.rows">
          <use ui="TreeRow" class="inspect-row" data-alias-item="row" data-alias-selection="inspector_ui.selected" data-attr-data-inspect-row="row.key" data-attrif-data-picked="row.key != '' && row.key == inspector_ui.picked" data-event-click="emit('inspector.click', row.key, row.open ? 1 : 0)">
            <span class="ident" data-if="row.id != ''">{{ row.id }}</span>
            <span class="cls" data-if="row.classes != ''">{{ row.classes }}</span>
            <span class="widget" data-if="row.widget != ''">{{ row.widget }}</span>
            <span class="text" data-if="row.text != ''">"{{ row.text }}"</span>
          </use>
        </div>
      </use>
    </div>
    <div class="details">
      <div class="note" data-if="!inspector.selection">Pick an element ({{ inspector.shortcut }}) or choose one in the tree.</div>
      <div data-if="inspector.selection">
        <div class="heading">
          <span class="title">{{ inspector.title }}</span>
          <span class="badge" data-if="inspector.detached">Removed</span>
        </div>
        <div class="path">{{ inspector.path }}</div>
        <div class="source" data-if="inspector.source != ''">
          <span class="badge" data-class-accent="!inspector.native">{{ inspector.source }}</span>
          <button class="btn sm" data-if="inspector.editable" data-event-click="inspector.action = 'source'"><span class="icon sm">&#xea73;</span><span class="label">Edit Source</span></button>
        </div>
        <use ui="BoxModel"/>
        <div class="force">
          <span class="force-label">Force</span>
          <label class="chip"><input type="checkbox" data-checked="inspector.force.hover"/><span>:hover</span></label>
          <label class="chip"><input type="checkbox" data-checked="inspector.force.active"/><span>:active</span></label>
          <label class="chip"><input type="checkbox" data-checked="inspector.force.focus"/><span>:focus</span></label>
          <label class="chip"><input type="checkbox" data-checked="inspector.force.checked"/><span>:checked</span></label>
        </div>
        <div class="pseudo" data-if="inspector.pseudo != ''">Set: {{ inspector.pseudo }}</div>
        <div class="segmented tabs">
          <span class="seg" data-class-on="inspector.tab == 'styles'" data-event-click="inspector.tab = 'styles'">Styles</span>
          <span class="seg" data-class-on="inspector.tab == 'computed'" data-event-click="inspector.tab = 'computed'">Computed</span>
          <span class="seg" data-class-on="inspector.tab == 'attributes'" data-event-click="inspector.tab = 'attributes'">Attributes</span>
        </div>
        <div class="pane" data-if="inspector.tab == 'styles'">
          <use ui="StyleRule" data-for="line, i : inspector.styles"/>
          <div class="note" data-if="inspector.styles.size == 0">No styles</div>
        </div>
        <div class="pane" data-if="inspector.tab == 'computed'">
          <div class="pair" data-for="p : inspector.computed"><span class="name">{{ p.name }}</span><span class="value">{{ p.value }}</span></div>
        </div>
        <div class="pane" data-if="inspector.tab == 'attributes'">
          <div class="pair" data-for="p : inspector.attributes"><span class="name">{{ p.name }}</span><span class="value">{{ p.value }}</span></div>
          <div class="note" data-if="inspector.attributes.size == 0">No attributes</div>
        </div>
      </div>
    </div>
  </div>
</div>
/* A key hint, as a status bar or a game's button prompt shows one: a mouse
   icon or a key, and what it does. Repeat it over items with an icon, a key
   and a label: <use ui="KeyHint" data-for="hint : hints"/>. */
body { display: flex; align-items: center; gap: 4dp; flex: 0 0 auto; }
.icon, .kbd-key, .label { flex-shrink: 0; }
.icon { font-size: 13dp; width: 14dp; color: var(--faint-foreground); }
.kbd-key { height: var(--studio-height-16, 16dp); min-width: 16dp; }
<span class="icon" data-if="hint.icon != ''">{{ hint.icon }}</span><span class="kbd-key" data-if="hint.key != ''">{{ hint.key }}</span><span class="label">{{ hint.label }}</span>
/* The Library (studio_designer_library.c), as Unity UI Builder's and UMG's:
   the elements a UI document can hold, then the project's ui assets as
   widgets, as tiles. A tile drags its markup to the Hierarchy or the Canvas
   (data-drag="ui"), and a click adds it to the selection. The `library`
   source marks the tiles its filter keeps (`shown`). Comfortable tiles are
   larger, by a rule of the theme's workspace.rcss, which sees the body. */
body { width: 100%; height: 100%; margin: 0dp; padding: 0dp; overflow: hidden; }
.designer-library { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; overflow-y: auto; padding: 4dp 8dp 10dp; }
.designer-section { display: block; padding: 8dp 2dp 5dp; }
.designer-section .title { font-size: var(--studio-font-11, 11dp); font-weight: 600; color: var(--muted-foreground); }
.designer-tiles { display: flex; flex-wrap: wrap; gap: 6dp; }
.designer-tile {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5dp; width: 78dp; height: 56dp;
    border-radius: var(--r-lg); border: 1dp var(--line); background-color: var(--card); cursor: pointer;
    transition: background-color border-color 0.11s cubic-out;
}
body.comfortable .designer-tile { width: 86dp; height: 62dp; }
.designer-tile:hover { background-color: var(--accent); border-color: var(--border); }
.designer-tile:active { background-color: var(--press); }
.designer-tile .glyph { font-size: 18dp; color: var(--muted-foreground); pointer-events: none; }
.designer-tile:hover .glyph { color: var(--primary-text); }
.designer-tile .label { pointer-events: none; max-width: 70dp; font-size: var(--studio-font-11, 11dp); color: var(--foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.designer-none { display: block; padding: 6dp 4dp; font-size: var(--studio-font-11, 11dp); color: var(--faint-foreground); }
<div class="designer-library">
  <div class="designer-section"><span class="title">Elements</span></div>
  <div class="designer-tiles">
    <div class="designer-tile" data-for="item : library.elements" data-if="item.shown" data-drag="ui" data-attr-data-drag-payload="item.markup" data-attr-data-drag-label="item.label" data-attr-data-drag-icon="item.icon" data-attr-data-tip="item.label" data-attr-data-tip-about="item.markup" data-event-click="emit('library.add', item.markup, item.label)"><span class="icon glyph">{{ item.icon }}</span><span class="label">{{ item.label }}</span></div>
  </div>
  <div class="designer-section"><span class="title">Widgets</span></div>
  <div class="designer-tiles">
    <div class="designer-tile" data-for="item : library.widgets" data-if="item.shown" data-drag="ui" data-attr-data-drag-payload="item.markup" data-attr-data-drag-label="item.label" data-attr-data-drag-icon="item.icon" data-attr-data-tip="item.label" data-attr-data-tip-about="item.markup" data-event-click="emit('library.add', item.markup, item.label)"><span class="icon glyph">{{ item.icon }}</span><span class="label">{{ item.label }}</span></div>
    <span class="designer-none" data-if="library.none">No other ui assets yet</span>
  </div>
</div>
/* The Library's header controls, in its AreaHeader: the filter, two-way
   bound to library.filter as the area's view state, as Assets' name
   filter is. */
body { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
<span class="designer-mode">Library</span>
<div class="assets-filter"><div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" id="library-filter" class="part value" placeholder="Filter" data-value="library.filter"/></div></div>
/* A virtualized list for a C panel source, as react-virtuoso draws one: a
   scroller, a spacer as tall as every row, and in it the window of rows
   the source shows, after the padding ui_list_window (src/ui/list.h) gives
   the spacer. Give it an id, so the source finds it, and
   data-event-scroll, so a scroll wakes the source; its rows are one
   data-for over an array the source keeps at one length, each row --row
   tall, so scrolling only changes their values. */
body { display: block; height: 100%; }
.list { display: block; overflow-y: auto; height: 100%; }
.list-spacer { display: block; position: relative; box-sizing: border-box; }
<div class="list" attrs><div class="list-spacer"><slot/></div></div>
/* Members (Unreal's My Blueprint): the open behavior's sections and their
   members as rows of a List the `members` source windows
   (studio_members.c). Rows are TreeRows keyed by member, with the
   selected and the active key aliased from `members_ui`, which also names
   the row being renamed: a selection re-evaluates those views alone; the
   open graph's row is active by its own flag. A section row has its
   count and an add button; a member row its type swatch (the theme's
   .member-swatch) and use count; F2 or a double click puts a name field
   in a row's place. */
body { width: 100%; height: 100%; margin: 0dp; padding: 0dp; overflow: hidden; }
.members { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; }
.members > [data-ui=List] { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; }
#members-list { box-sizing: border-box; padding: 3dp 4dp 8dp; }
.member-row { display: block; }
.member-row .tree-row { tab-index: none; }
[data-section] .name { font-weight: 600; }
/* A member's use count, which lists its uses in Find. */
.tree-row .member-uses { height: var(--studio-height-18, 18dp); min-width: 20dp; padding: 0dp 4dp; justify-content: center; color: var(--faint-foreground); font-family: var(--font-numeric); }
.tree-row .member-uses[data-unused] { color: var(--disabled-foreground); }
.member-rename .field { height: var(--studio-height-20, 20dp); margin-right: 4dp; }
<div class="members">
  <div class="output-empty" data-if="!members.shown">No behavior open</div>
  <use ui="List" id="members-list" data-if="members.shown" data-event-scroll="emit('members.scroll')">
    <div class="member-row" data-for="row : members.rows">
      <use ui="TreeRow" data-if="row.key != members_ui.renaming" data-alias-item="row" data-alias-selection="members_ui.selected" data-alias-active="members_ui.active" data-attrif-data-section="row.parent" data-attr-data-drag="row.drag" data-attr-data-drag-payload="row.key" data-attr-data-drag-label="row.label" data-attr-data-drag-icon="row.icon" data-event-click="emit('members.click', row.key)" data-event-dblclick="emit('members.edit', row.key)" data-event-contextmenu="emit('members.menu', row.key)">
        <kit-dot class="member-swatch" data-if="row.swatch != ''" data-attr-shape="row.swatch" data-attr-fill="row.color"></kit-dot>
        <button class="btn sm member-uses" data-if="row.uses != ''" data-attr-data-tip="row.usesTip" data-attrif-data-unused="row.unused" data-event-click="stop(); emit('members.uses', row.key)"><span class="label">{{ row.uses }}</span></button>
        <button class="btn icon-only toggle" data-if="row.add != ''" data-attr-data-tip="row.add" data-attrif-data-disabled="members.locked" data-event-click="stop(); emit('members.add', row.key)"><span class="icon">&#xea60;</span></button>
      </use>
      <div class="tree-row member-rename" data-when="row.key == members_ui.renaming" data-style-padding-left="(24 + row.depth * 14) + 'dp'">
        <span class="icon">{{ row.icon }}</span>
        <div class="field text"><input type="text" class="part value" autofocus data-attr-value="row.label" data-keys="Escape:members.cancel" data-event-change="emit('members.renamed', ev.value)" data-event-blur="emit('members.cancel')"/></div>
      </div>
    </div>
  </use>
  <use ui="Menu" id="member-menu">
    <use ui="MenuItem" data-for="entry : members_ui.menu" data-alias-item="entry" data-event-click="emit('members.' + entry.id)"></use>
    <use ui="MenuSeparator"/>
    <use ui="MenuItem" data-alias-item="members_ui.remove" data-event-click="emit('members.delete')"></use>
  </use>
</div>
/* The Members header's filter, in its AreaHeader's controls: typing
   filters the members by name or category. Focused, it shows its ring, as
   the kit's fields do while editing. */
body { display: flex; flex: 1 1 0dp; max-width: 240dp; }
.field:focus { border-color: var(--ring); }
<div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" id="members-filter" class="part value" placeholder="Filter" data-value="members.filter"/></div>
/* Base UI's Menu as a popover (ui/popover.c): give it an id and open it with
   <button popovertarget="id">. Its items are MenuItem, MenuCommand,
   MenuCheck and MenuOption, with Submenu, MenuGroup and MenuSeparator; the
   pointer, the arrow keys and typeahead highlight them, and Enter or a click
   runs one. Where it is written it takes no room. RmlUi places a fixed box
   against its nearest positioned ancestor, so this one is as wide as a menu
   may grow, and the menu fits its widest row. Its items are built when it
   opens and removed once it has closed (data-template, ui/popover.c), so a
   closed menu holds no elements and binds nothing; data-* bindings written on
   its use element are cancelled, so put them on an element around it. */
body { position: absolute; width: 480dp; height: 0dp; }
<div class="popup menu" popover data-template role="menu" attrs><slot/></div>
/* A menu item bound as a checkbox (Base UI's Menu.CheckboxItem), as
   data-checked="save.key": a click or Enter toggles it and its menu stays
   open; the menu highlights it (data-highlighted). */
.menu-check { position: relative; tab-index: auto; }
.menu-check input { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; tab-index: none; }
.menu-check .lead { opacity: 0; }
.menu-check input:checked ~ .lead { opacity: 1; }
<label class="menu-item menu-check" role="menuitemcheckbox"><input type="checkbox" attrs/><span class="icon lead">&#xeab2;</span><span class="label"><slot/></span></label>
/* A Studio command as a menu item, as the menubar lists them: alias it as
   data-alias-command="commands.<id>". It shows the command's menu label,
   its icon, or a check for a toggle, and its shortcut; it is disabled while
   the command is, and runs it with emit('studio.<id>'). */
body { display: block; }
.menu-item { height: var(--menu-row-h); }
<div class="menu-item" role="menuitem" attrs data-attrif-data-disabled="!command.enabled" data-attrif-data-checked="command.checked" data-event-click="emit('studio.' + command.id)"><span class="icon lead" data-if="!command.checkable">{{ command.icon }}</span><span class="icon lead" data-if="command.checkable && command.checked">&#xeab2;</span><span class="icon lead" data-if="command.checkable && !command.checked"/><span class="text"><span class="label">{{ command.menu }}</span></span><span class="kbd" data-if="command.shortcut != ''">{{ command.shortcut }}</span></div>
/* A heading over a group of menu items: the use's children, or the label of
   data-alias-group. */
body { display: block; }
<div class="menu-group" attrs>{{ group.label }}<slot/></div>
/* A menu's item (Base UI's Menu.Item). Alias it as data-alias-item: an
   object with icon, label, shortcut, checked and disabled; the use's
   children add to its label. Its data-event-click runs it, and the click
   closes its menu. data-current marks the current choice among several;
   with aria-haspopup and popovertarget it opens a submenu, with a chevron. */
body { display: block; }
.menu-item { height: var(--menu-row-h); }
/* The label keeps its width, so a menu grows to its widest row, as the kit's
   menus measure theirs. */
.text { flex: 1 0 auto; }
.lead { flex: 0 0 auto; }
.chev { display: none; color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); }
.menu-item[aria-haspopup] .chev { display: block; }
.menu-item[aria-haspopup] .kbd { display: none; }
<div class="menu-item" role="menuitem" attrs data-attrif-data-disabled="item.disabled" data-attrif-data-checked="item.checked"><span class="icon lead" data-if="!item.checked">{{ item.icon }}</span><span class="icon lead" data-if="item.checked">&#xeab2;</span><span class="text"><span class="label">{{ item.label }}<slot/></span></span><span class="kbd" data-if="item.shortcut != ''">{{ item.shortcut }}</span><span class="icon chev">&#xeab6;</span></div>
/* A menu item bound as a radio (Base UI's Menu.RadioItem), as
   data-checked="save.key" value="v": a click or Enter chooses it and its
   menu stays open; the menu highlights it (data-highlighted). */
.menu-option { position: relative; tab-index: auto; }
.menu-option input { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; tab-index: none; }
.menu-option .lead { opacity: 0; }
.menu-option input:checked ~ .lead { opacity: 1; }
<label class="menu-item menu-option" role="menuitemradio"><input type="radio" attrs/><span class="icon lead">&#xeab2;</span><span class="label"><slot/></span></label>
/* A line between groups of menu items. */
body { display: block; }
<div class="menu-sep" role="separator" attrs/>
/* The name a New asset command asks for (studio_assets.c, the
   `asset_menus` source's naming): a popover under Assets' New button, or
   at the pointer when no Assets header shows, with the kind's free default
   name selected. Enter or Create makes the asset and opens it; a name that
   is invalid or taken says why and asks again. Its look is the theme's
   .new-asset. */
body { display: block; }
<div class="popup menu new-asset" popover id="new-asset-name">
  <use ui="MenuGroup" data-alias-group="asset_menus.naming"/>
  <div class="new-asset-field"><div class="field text"><input type="text" class="part value" placeholder="Name" data-value="asset_menus.naming.name" data-keys="Enter:asset_menus.create" data-event-focus="emit('asset_menus.select')"/></div></div>
  <div class="new-asset-error" data-if="asset_menus.naming.error != ''"><span class="icon">&#xea6c;</span><span class="label">{{ asset_menus.naming.error }}</span></div>
  <use ui="MenuSeparator"/>
  <use ui="MenuItem" data-alias-item="asset_menus.naming.button" data-event-click="emit('asset_menus.create')"/>
</div>
.new-project .dialog-panel { width: 420dp; max-width: 94%; padding: 0dp; overflow: hidden; }
.project-form { display: flex; flex-direction: column; color: var(--foreground); }
.project-head { padding: 18dp 20dp 14dp; border-bottom: 1dp var(--line); }
.project-title { font-size: var(--studio-font-16, 16dp); line-height: var(--studio-line-22, 22dp); font-weight: 600; }
.project-description { margin-top: 4dp; color: var(--muted-foreground); white-space: normal; }
.project-body { display: flex; flex-direction: column; gap: 12dp; padding: 18dp 20dp; }
.project-name { display: flex; flex-direction: column; gap: 7dp; }
.project-name label { display: block; font-weight: 500; }
.project-name .field { flex: 0 0 auto; }
.project-name .field[data-invalid] { border-color: var(--destructive); }
.project-location { display: flex; align-items: center; gap: 6dp; color: var(--muted-foreground); }
.project-location .icon { flex: 0 0 auto; color: var(--faint-foreground); }
.project-location .path { flex: 1 1 0dp; min-width: 0dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.project-location .btn { flex: 0 0 auto; margin-right: -6dp; }
.project-error { color: var(--destructive); white-space: normal; }
.project-pending { color: var(--muted-foreground); }
.project-confirmation { display: flex; flex-direction: column; gap: 4dp; padding: 12dp; border: 1dp var(--border); border-radius: var(--r); background-color: var(--muted); white-space: normal; }
.confirmation-title { font-weight: 600; color: var(--foreground); }
.project-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 8dp; padding: 14dp 20dp; border-top: 1dp var(--line); }
<use ui="Dialog" class="new-project" data-keys="Escape:Close">
  <section class="project-form" role="dialog" aria-modal="true" aria-labelledby="new-project-title">
    <header class="project-head"><div id="new-project-title" class="project-title">Create a project</div><div class="project-description">Creates an empty project with a Start scene.</div></header>
    <div class="project-body">
      <div class="project-name"><label for="new-project-name">Project name</label><div class="field text" data-attrif-data-invalid="new_project.error != ''" data-attrif-data-readonly="new_project.waiting || new_project.confirm_save"><input id="new-project-name" class="value" type="text" maxlength="127" placeholder="e.g. Sample Project" autofocus data-value="new_project.name" data-keys="Enter:newProject.create" data-attrif-disabled="new_project.waiting || new_project.confirm_save" aria-describedby="new-project-error"/></div><div class="project-location" data-if="new_project.location != ''"><span class="icon">&#xea83;</span><span class="path" data-attr-data-tip="new_project.folder">{{ new_project.location }}</span><button class="btn sm" data-attrif-data-disabled="new_project.waiting || new_project.confirm_save" data-event-click="emit('newProject.location')">Change&#x2026;</button></div></div>
      <div id="new-project-error" class="project-error" role="alert" data-if="new_project.error != ''" data-rml="new_project.error_markup"/>
      <div class="project-pending" role="status" data-if="new_project.waiting">Saving project…</div>
      <div class="project-confirmation" role="alert" data-if="new_project.confirm_save"><div class="confirmation-title">{{ new_project.confirm }}</div><div>Your changes will be lost if you don't save them.</div></div>
    </div>
    <footer class="project-actions">
      <button id="new-project-cancel" class="btn outline cancel" data-attrif-data-disabled="new_project.waiting" data-event-click="emit('newProject.cancel')">Cancel</button>
      <button class="btn primary create" data-if="!new_project.confirm_save" data-attrif-data-disabled="new_project.waiting" data-event-click="emit('newProject.create')">Create project</button>
      <button class="btn danger outline discard" data-if="new_project.confirm_save" data-attrif-data-disabled="new_project.waiting" data-event-click="emit('newProject.discard')">Discard</button>
      <button class="btn primary save" data-if="new_project.confirm_save" data-attrif-data-disabled="new_project.waiting" data-event-click="emit('newProject.save')">Save</button>
    </footer>
  </section>
</use>
/* The native <number-field> (src/ui/controls/controls.h) in the field theme:
   drag to scrub, click to type a value or an expression, arrows and steppers
   step. Bind it one way and send intents from its events:
   data-attr-value="n.value" data-event-input="emit('panel.input', ev.value)"
   data-event-change="emit('panel.change', ev.value)". Input runs while a
   gesture does and change once when it commits, with ev.canceled after
   Escape. */
body { display: flex; flex: 1 1 0dp; }
<number-field class="field number" attrs></number-field>
/* The Outliner, as Blender's Outliner and Unity's Hierarchy: the scene as a
   root row with its object count, then a row per object the object filter
   shows, in a List the host windows (data-list-rows) and whose rows the
   Outliner's behaviors fill as self.rows (OutlinerRows, over the editor
   nodes of studio_nodes.c). A row selects on click, with Mod and Shift
   for several; double-click or F2 renames it in place; its eye and lock show
   while it is hovered or while they are on; it takes behaviors and the
   assets its fields name, and the list takes prototypes. The list is one
   Tab stop, and while the keyboard holds it the active row shows the focus
   ring and Studio's keys act on it. */
body { overflow: hidden; padding: 0dp; }
.outliner-panel { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; }
.list {
  position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; height: auto; padding: 3dp 4dp 8dp;
  tab-index: auto;
}
.outliner-row { display: block; }
/* The eye and lock take the row's whole height, so a press anywhere in
   their column toggles instead of selecting the row. */
.tree-row .trail, .view-toggles { align-self: stretch; }
.view-toggles .toggle { align-self: stretch; height: auto; tab-index: none; }
.list:focus-visible .tree-row[data-active] { border-color: var(--ring); }
/* The name's field starts where a row's icon does, past the twisty's room. */
.object-rename { padding-left: 38dp; }
/* With a filter that hides every object, the notice names the query and
   offers the way back, as the Assets panel's empty state does. */
.outliner-empty { display: flex; flex-direction: column; align-items: center; gap: 8dp; padding: 0dp 16dp; }
.outliner-empty .btn { pointer-events: auto; }
<div class="outliner-panel">
  <use ui="List" id="outliner-list" data-attr-data-list-rows="self.total" data-drop="prototype" data-event-window="emit('ShowRows', ev.first, ev.count)" data-event-drop="emit('ListDropped', ev.type, ev.payload)" data-area-keys="Left:FoldRoot Right:UnfoldRoot">
    <use ui="TreeRow" class="outliner-root" data-if="self.rootShown" data-alias-item="self.root" data-event-click="emit('RootClicked', self.root.open)" data-event-dblclick="emit('ToggleRoot')"><span class="meta">{{ self.count }}</span><div class="view-toggles"></div></use>
    <div class="outliner-row" data-for="row : self.rows">
      <use ui="TreeRow" data-when="!row.renaming" data-alias-item="row" data-attr-data-object="row.key" data-attr-data-drop="row.drop" data-event-drop="emit('RowDropped', row.key, ev.type, ev.payload); stop()" data-event-click="emit('RowClicked', row.key)" data-event-dblclick="emit('studio.rename')" data-event-contextmenu="emit('RowMenu', row.key)">
        <div class="inline row" data-if="row.behaviors > 0"><span class="icon">&#xebb9;</span><span class="meta">{{ row.behaviors }}</span></div>
        <div class="view-toggles">
          <button class="btn icon-only toggle" data-attr-data-state="row.hidden ? 'on' : ''" data-attr-data-tip="row.hidden ? 'Show in Editor' : 'Hide in Editor'" data-attr-data-kbd="row.hidden ? commands.showAll.shortcut : commands.hideSelected.shortcut" data-attr-data-tip-about="self.isolateTip" data-event-click="emit('EyeClicked', row.key, row.hidden); stop()" data-event-dblclick="stop()"><span class="icon">{{ row.hidden ? '&#xeae7;' : '&#xea70;' }}</span></button>
          <button class="btn icon-only toggle" data-attr-data-state="row.locked ? 'on' : ''" data-attr-data-tip="row.locked ? 'Unlock' : 'Lock'" data-tip-about="A locked object can't be picked in the Scene" data-event-click="emit('LockClicked', row.key, row.locked); stop()" data-event-dblclick="stop()"><span class="icon">{{ row.locked ? '&#xea75;' : '&#xeb74;' }}</span></button>
        </div>
      </use>
      <div class="tree-row object-rename" data-when="row.renaming">
        <span class="icon">{{ row.icon }}</span>
        <div class="field text"><input type="text" class="part value" autofocus="" data-value-lazy="row.label" data-event-change="emit('RenameCommitted', row.key, ev.value)" data-event-blur="emit('RenameLeft', row.key)" data-keys="Enter:RenameEnter Escape:RenameCancel"/></div>
      </div>
    </div>
  </use>
  <div class="outliner-empty" data-if="self.notice != ''">
    <span class="notice">{{ self.notice }}</span>
    <button class="btn sm outline" data-if="self.filtered" data-event-click="emit('ClearFilter')"><span class="label">Clear Filter</span></button>
  </div>
  <use ui="Menu" id="outliner-menu">
    <use ui="MenuGroup" data-alias-group="self.menu"/>
    <use ui="MenuCommand" data-alias-command="commands.frame"/>
    <use ui="MenuCommand" data-alias-command="commands.duplicate"/>
    <use ui="MenuCommand" data-alias-command="commands.rename"/>
    <use ui="MenuSeparator"/>
    <use ui="MenuCommand" data-alias-command="commands.cut"/>
    <use ui="MenuCommand" data-alias-command="commands.copy"/>
    <use ui="MenuCommand" data-alias-command="commands.paste"/>
    <use ui="MenuSeparator"/>
    <use ui="MenuCommand" data-alias-command="commands.openPrototype"/>
    <use ui="MenuItem" data-if="self.menu.actor" data-alias-item="self.menu.spawnBreak" data-event-click="emit('SpawnBreak')"/>
    <use ui="MenuCommand" data-if="self.menu.live" data-alias-command="commands.keepChanges"/>
    <use ui="MenuCommand" data-if="!self.menu.live" data-alias-command="commands.applyOverrides"/>
    <use ui="MenuCommand" data-if="!self.menu.live" data-alias-command="commands.saveAsPrototype"/>
    <use ui="MenuCommand" data-alias-command="commands.hideSelected"/>
    <use ui="MenuSeparator"/>
    <use ui="MenuCommand" data-alias-command="commands.delete"/>
  </use>
</div>
/* The Outliner's header controls, in its AreaHeader, driven by the
   OutlinerHeaderInput behavior: the filter, which sets the object filter
   (FilterTyped) and shows it as self.filter, and Add, which searches the
   scene's prototypes in a ChoiceList, as Unity's Add Component and
   Blender's Shift+A search do. */
body { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.add { flex: 0 0 auto; }
/* Rows 8 dp wider than their content, which the list's scrollbar takes,
   as the kit's dropdowns size them. */
#outliner-add .menu-item { padding-right: 16dp; }
<div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" class="part value" id="outliner-filter" placeholder="Filter" data-value="self.filter" data-event-input="emit('FilterTyped', ev.value)"/></div>
<button class="btn icon-only add" popovertarget="outliner-add" aria-haspopup="listbox" data-tip="Add object" data-attrif-data-disabled="!self.editable"><span class="icon">&#xea60;</span></button>
<div class="popup dropdown" popover id="outliner-add">
  <use ui="ChoiceList" placeholder="Add object" data-event-change="emit('AddObject', ev.value)">
    <div class="menu-item" role="option" data-for="option : self.prototypes" data-attr-value="option.value" data-attr-data-label="option.label"><span class="icon lead">{{ option.icon }}</span><span class="text"><span class="label">{{ option.label }}</span></span></div>
  </use>
</div>
/* Output's views (studio_output.c): Find's and Calls' head, then a List of
   the view's rows, all at the list's top and each moved to its row by a
   translateY the source writes, so a row keeps its element and markup while
   the window scrolls or the log's oldest lines drop, and moving one lays
   nothing out. The rows' look is below, with the height density sets;
   .tree-row is the theme's (theme/tree.rcss). */
/* The area's panel host scrolls and pads; Output's List scrolls instead. */
body.area-panel { padding: 0dp; overflow: hidden; }
.output { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; }
.output-list { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; font-family: var(--font-numeric); }
.output-list.find-list { top: 24dp; }
.output-list .list { box-sizing: border-box; padding: 2dp 0dp 6dp; }
.output-list.find-list .list { padding: 2dp 4dp 6dp; }
.output-row, .output-log, .output-item { position: absolute; left: 0dp; top: 0dp; right: 0dp; }
/* A log line, or a row with its kind's icon, where it happened, the message
   and a repeat count. Density sets their height, which the lines' List takes
   as its --row. */
.output-list.lines { --row: var(--studio-height-20, 20dp); }
body.comfortable .output-list.lines { --row: var(--studio-height-24, 24dp); }
.output-row, .output-log { display: block; height: var(--studio-height-20, 20dp); line-height: var(--studio-line-20, 20dp); padding: 0dp 10dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.output-row { display: flex; align-items: center; gap: 6dp; }
body.comfortable .output-row, body.comfortable .output-log { height: var(--studio-height-24, 24dp); line-height: var(--studio-line-24, 24dp); }
.output-row .kind { font-size: var(--studio-font-12, 12dp); width: 14dp; flex: 0 0 auto; }
.output-row .output-line { display: block; flex: 1 1 0dp; padding: 0dp; overflow: hidden; text-overflow: ellipsis; }
.output-row[data-kind=error] .kind { color: var(--destructive); }
.output-row[data-kind=warning] .kind { color: var(--warning); }
.output-row[data-kind=success] .kind { color: var(--success); }
.output-row[data-kind=info] .kind { color: var(--faint-foreground); }
.output-row:hover, .output-log:hover { background-color: var(--accent); }
/* Rows at a node open it: where, muted, then the message and a repeat count. */
.output-row.located { cursor: pointer; }
.output-row .output-at { display: block; flex: 0 0 auto; color: var(--faint-foreground); white-space: nowrap; }
.output-row .output-count { flex: 0 0 auto; font-family: var(--font-numeric); }
.output-empty { position: absolute; left: 0dp; right: 0dp; top: 45%; text-align: center; color: var(--faint-foreground); pointer-events: none; }
/* What the references are to, or what the calls trace from; Calls' direction trails. */
.find-head { position: absolute; left: 0dp; top: 0dp; right: 0dp; height: var(--studio-height-24, 24dp); display: flex; align-items: center; gap: 6dp; padding: 0dp 10dp; border-bottom: 1dp var(--line); }
.find-head .icon { color: var(--faint-foreground); font-size: 12dp; width: 14dp; }
.find-title { display: block; line-height: var(--studio-line-16, 16dp); color: var(--foreground); font-weight: 600; white-space: nowrap; }
.find-count { display: block; line-height: var(--studio-line-16, 16dp); color: var(--faint-foreground); font-family: var(--font-numeric); }
.output-scope { display: flex; flex: 0 0 auto; margin-left: 6dp; }
.output-scope .segmented, .output-scope .seg { flex: 0 0 auto; }
.seg { tab-index: auto; }
<div class="output">
  <div class="find-head" data-if="output.head.title != ''">
    <span class="icon">{{ output.head.icon }}</span>
    <span class="find-title">{{ output.head.title }}</span>
    <span class="find-count" data-if="output.view == 4">{{ output.head.count }}</span>
    <span class="spacer" data-if="output.view == 5"></span>
    <div class="output-scope" data-if="output.view == 5">
      <div class="segmented">
        <button class="seg" data-attrif-data-pressed="!output.callees" data-event-click="emit('output.direction', 0)">Callers</button>
        <button class="seg" data-attrif-data-pressed="output.callees" data-event-click="emit('output.direction', 1)">Callees</button>
      </div>
    </div>
  </div>
  <div class="output-list" data-class-find-list="output.view >= 4" data-class-lines="output.view < 4">
    <use ui="List" id="output-list" data-event-scroll="emit('output.scroll')">
      <div class="output-log" data-for="row : output_rows.lines" data-style-transform="row.offset" data-rml="row.rml"></div>
      <div class="output-row" data-for="row : output_rows.entries" data-style-transform="row.offset" data-attr-data-kind="row.kind" data-class-located="row.at != ''" data-event-click="emit('output.click', row.key)">
        <span class="icon kind">{{ row.icon }}</span>
        <span class="output-at" data-if="row.at != ''">{{ row.at }}</span>
        <span class="output-line" data-rml="row.rml"></span>
        <span class="badge output-count" data-if="row.count != ''">{{ row.count }}</span>
      </div>
      <use ui="TreeRow" class="output-item" data-for="row : output_rows.items" data-alias-item="row" data-style-transform="row.offset" data-event-click="emit('output.click', row.key)" data-event-dblclick="emit('output.open', row.key)"></use>
    </use>
  </div>
  <div class="output-empty" data-if="output_rows.empty != ''">{{ output_rows.empty }}</div>
</div>
/* Output's controls in its area header (studio_output.c): the views, whose
   labels carry counts, so segments fit their labels; Problems' scope and
   Refresh; the filter; Clear. */
body { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.output-views, .output-scope { display: flex; flex: 0 0 auto; }
.segmented, .seg { flex: 0 0 auto; }
.seg { tab-index: auto; }
.output-scope { margin-left: 6dp; }
.output-filter { width: 160dp; display: flex; }
.btn { flex: 0 0 auto; }
<div class="output-views">
  <div class="segmented">
    <button class="seg" data-attrif-data-pressed="output.view == 0" data-event-click="emit('output.view', 0)">Log</button>
    <button class="seg" data-attrif-data-pressed="output.view == 1" data-event-click="emit('output.view', 1)">Problems{{ output.problems > 0 ? ' ' + output.problems : '' }}</button>
    <button class="seg" data-attrif-data-pressed="output.view == 2" data-event-click="emit('output.view', 2)">Runtime{{ output.runtime > 0 ? ' ' + output.runtime : '' }}</button>
    <button class="seg" data-attrif-data-pressed="output.view == 3" data-event-click="emit('output.view', 3)">Info</button>
    <button class="seg" data-attrif-data-pressed="output.view == 4" data-event-click="emit('output.view', 4)">Find</button>
    <button class="seg" data-attrif-data-pressed="output.view == 5" data-event-click="emit('output.view', 5)">Calls</button>
  </div>
</div>
<div class="output-scope" data-if="output.view == 1">
  <div class="segmented">
    <button class="seg" data-attrif-data-pressed="output.scope == 0" data-event-click="emit('output.scope', 0)">Asset</button>
    <button class="seg" data-attrif-data-pressed="output.scope == 1" data-event-click="emit('output.scope', 1)">Project</button>
  </div>
</div>
<button class="btn icon-only" data-if="output.view == 1 &amp;&amp; output.scope == 1" data-tip="Refresh" data-event-click="emit('output.refresh')"><span class="icon">&#xeb37;</span></button>
<div class="spacer"></div>
<div class="output-filter">
  <div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" class="part value" id="output-filter" placeholder="Filter" data-value="output.filter"/></div>
</div>
<button class="btn icon-only" data-attrif-data-disabled="!output.clearable" data-tip="Clear" data-event-click="emit('output.clear')"><span class="icon">&#xea81;</span></button>
/* The command palette (cmdk's Command.Dialog), mounted over the editor
   while it is open (studio_palette_view.c, the `palette` source): a search
   field, a List the source windows over the ranked results, grouped under
   headings, and the keys' footer. The virtualized <choice-list> sends
   palette.highlight as Up, Down, PageUp, PageDown, Home, End or the pointer
   move it (palette_ui.highlight, a variable of its own) and palette.choose
   as Enter or a click chooses; Escape or a press outside closes it. A
   result's label marks the query's letters in bold; an asset shows the
   thumbnail Assets made of it, once cached. Rows are --row-heading, --row
   or --row-about tall, as the source windows them. */
body { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: block; }
.command-backdrop { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; background-color: var(--backdrop); }
.command {
    position: absolute; left: 50%; top: 88dp; width: 600dp; margin-left: -300dp; background-color: var(--popover);
    border: 1dp var(--popover-edge); border-radius: 8dp; display: block; box-shadow: var(--shadow-overlay);
}
.palette-choices { display: block; }
.cmd-input { display: flex; align-items: center; gap: 8dp; height: 44dp; padding: 0dp 12dp; border-bottom: 1dp var(--border); }
.cmd-input .icon { font-size: 15dp; color: var(--faint-foreground); }
.cmd-input input { flex: 1 1 0dp; font-size: var(--studio-font-14, 14dp); height: var(--studio-height-20, 20dp); color: var(--foreground); }
.command [data-ui=List] { height: auto; }
#palette-list {
    height: auto; max-height: 360dp; padding: 4dp 6dp 6dp;
    --row: var(--studio-height-32, 32dp); --row-heading: var(--studio-height-26, 26dp); --row-about: 42dp;
}
.palette-row { display: block; }
.cmd-group { height: var(--studio-height-26, 26dp); display: block; padding: 10dp 6dp 0dp; font-size: var(--studio-font-11, 11dp); color: var(--faint-foreground); }
.cmd-item { display: flex; align-items: center; gap: 10dp; height: var(--studio-height-32, 32dp); padding: 0dp 8dp; border-radius: 5dp; color: var(--foreground); }
.cmd-item .text { display: block; flex: 1 1 0dp; overflow: hidden; }
.cmd-item .label { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* A description is a muted second line under the label. */
.cmd-item .about { display: none; font-size: var(--studio-font-11, 11dp); line-height: var(--studio-line-14, 14dp); color: var(--faint-foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cmd-item[data-described] { height: 42dp; }
.cmd-item[data-described] .about { display: block; }
.cmd-item .label b { font-weight: 600; color: var(--strong); }
.cmd-item .meta { color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); white-space: nowrap; }
.cmd-item[data-highlighted] { background-color: var(--item-selected); }
.cmd-item .picture { display: none; }
.cmd-item[data-picture] > .icon { width: 22dp; height: 22dp; }
.cmd-item[data-picture] .picture { display: block; width: 22dp; height: 22dp; border-radius: 3dp; }
/* Between the empty List's paddings, as when the rows held it. */
.cmd-empty { height: 64dp; margin: -6dp 0dp 6dp; line-height: var(--studio-line-64, 64dp); display: block; text-align: center; color: var(--faint-foreground); }
.cmd-footer { display: flex; align-items: center; gap: 4dp; height: var(--studio-height-32, 32dp); padding: 0dp 12dp; border-top: 1dp var(--border); color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); }
.cmd-footer .hint { margin-right: 10dp; }
<div class="command-backdrop" data-event-mousedown="emit('palette.close')"></div>
<div class="command">
  <choice-list virtualized class="palette-choices" data-attr-aria-setsize="palette.count" data-attr-highlight="palette_ui.highlight" data-event-highlight="emit('palette.highlight', ev.value, ev.pointer)" data-event-change="emit('palette.choose', ev.value)">
    <div class="cmd-input"><span class="icon">&#xea6d;</span><input type="text" id="palette-search" data-attr-placeholder="palette.placeholder" data-keys="Escape:palette.close" data-event-input="emit('palette.query', ev.value)"/></div>
    <use ui="List" id="palette-list" data-event-scroll="emit('palette.scroll')">
      <div class="palette-row" data-for="row : palette.rows">
        <div class="cmd-group" data-if="row.heading">{{ row.label }}</div>
        <div class="cmd-item" role="option" data-if="!row.heading" data-attr-value="row.place" data-attr-aria-posinset="row.place" data-attrif-data-described="row.about != ''" data-attrif-data-picture="row.image != ''">
          <span class="icon">{{ row.image == '' ? row.icon : '' }}<span class="picture" data-style-decorator="row.image == '' ? 'none' : 'image(' + row.image + ')'"></span></span>
          <div class="text"><span class="label" data-rml="row.label"></span><span class="about">{{ row.about }}</span></div>
          <span class="meta">{{ row.meta }}</span>
          <span class="kbd">{{ row.shortcut }}</span>
        </div>
      </div>
    </use>
    <div class="cmd-empty" data-if="palette.count == 0">{{ palette.empty }}</div>
  </choice-list>
  <div class="cmd-footer"><span class="kbd-key">&#x2191;</span><span class="kbd-key">&#x2193;</span><span class="hint">Navigate</span><span class="kbd-key" data-if="palette.count > 0">&#x21b5;</span><span class="hint" data-if="palette.count > 0">{{ palette.verb }}</span><span class="spacer"></span><span class="kbd-key">esc</span><span class="hint">Close</span></div>
</div>
/* A collapsible section, as Properties' components: its head folds it. Alias
   the panel as data-alias-panel: an object with title, badge and open, which
   is UI-local, so the head writes it. Its children are its body. */
body { display: block; }
<section class="panel" data-attrif-data-open="panel.open">
  <div class="panel-head" data-event-click="panel.open = !panel.open">
    <span class="icon chev">&#xeab4;</span>
    <span class="title">{{ panel.title }}</span>
    <span class="badge override" data-if="panel.badge != ''">{{ panel.badge }}</span>
  </div>
  <div class="panel-body" data-if="panel.open"><slot/></div>
</section>
/* Performance (studio_performance.c): live charts of the last 30 seconds,
   Liveline's <line-chart>s over the series C publishes (perf:frame, the
   four simulation phases and perf:gpu), with Recharts' legend. New samples
   redraw the charts and lay nothing out. */
.perf { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; flex-direction: column; padding: 6dp 10dp 8dp; gap: 4dp; overflow-y: auto; }
.perf-heading { display: block; line-height: var(--studio-line-16, 16dp); color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); }
.perf-chart { flex: 1 1 0dp; min-height: 60dp; }
.perf-legend { display: flex; gap: 14dp; flex: 0 0 auto; height: var(--studio-height-18, 18dp); align-items: center; }
.perf-key { display: flex; align-items: center; gap: 5dp; }
.perf-key span { display: block; line-height: var(--studio-line-16, 16dp); color: var(--muted-foreground); font-size: var(--studio-font-11, 11dp); }
.perf-dot { width: 8dp; height: 8dp; border-radius: 4dp; }
/* The series' colors, as studio_performance.c publishes them. */
.perf-dot.behavior { background-color: #6f9fe8; }
.perf-dot.physics { background-color: #57ab5a; }
.perf-dot.systems { background-color: #d9a53d; }
.perf-dot.rendering { background-color: #c586c0; }
.perf-idle { flex: 1 1 0dp; display: block; line-height: var(--studio-line-40, 40dp); text-align: center; color: var(--faint-foreground); }
.perf-status { flex: 0 0 auto; display: block; line-height: var(--studio-line-16, 16dp); color: var(--muted-foreground); font-size: var(--studio-font-11, 11dp); }
<div class="perf">
  <span class="perf-heading">Frame</span>
  <line-chart class="perf-chart" series="perf:frame" reference="16.7" unit="ms" precision="1" fill="" data-attrif-live="performance.live"></line-chart>
  <span class="perf-heading">Simulation</span>
  <line-chart class="perf-chart" data-if="performance.running" series="perf:behavior perf:physics perf:systems perf:rendering" unit="ms" precision="2" data-attrif-live="performance.live"></line-chart>
  <div class="perf-legend" data-if="performance.running">
    <div class="perf-key"><div class="perf-dot behavior"></div><span>Behavior</span></div>
    <div class="perf-key"><div class="perf-dot physics"></div><span>Physics</span></div>
    <div class="perf-key"><div class="perf-dot systems"></div><span>Systems</span></div>
    <div class="perf-key"><div class="perf-dot rendering"></div><span>Rendering</span></div>
  </div>
  <span class="perf-idle" data-if="!performance.running">Not running</span>
  <span class="perf-heading" data-if="performance.lighting">Scene GPU and lighting</span>
  <span class="perf-status" data-if="performance.lighting">{{ performance.lightingText }}</span>
  <line-chart class="perf-chart" data-if="performance.lighting &amp;&amp; performance.gpu" series="perf:gpu" unit="ms" precision="2" data-attr-reference="performance.budget" data-attrif-live="performance.live"></line-chart>
  <span class="perf-status" data-if="performance.lighting &amp;&amp; !performance.gpu">This GPU reports no timestamps</span>
</div>
/* Performance's header (studio_performance.c): its title, and the frame
   rate and times of the last two seconds, refreshed four times a second
   as a <live-text>, so they change without layout. */
body { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.perf-title { display: block; line-height: var(--studio-line-16, 16dp); color: var(--foreground); font-weight: 500; margin-left: 2dp; }
.perf-readout { display: block; line-height: var(--studio-line-16, 16dp); color: var(--muted-foreground); font-family: var(--font-numeric); margin-right: 6dp; }
<span class="perf-title">Performance</span>
<div class="spacer"></div>
<live-text class="perf-readout" data-attr-value="performance.readout"></live-text>
/* An asset picker (studio_pick.c over the `palette` source,
   studio_palette_view.c): a searchable list under the field that opened
   it, as the kit's asset picker hung, in a document of its own shown only
   while it is open. It lists none, the kind's assets and, where a field
   takes a name no asset has yet, the name typed; the current asset is in
   primary and highlighted as it opens. The List the source windows holds
   group headings, rows and described rows, --row-heading, --row and
   --row-about tall; keys and the pointer move the highlight through the
   virtualized <choice-list>, and the field hears change with the name
   chosen. Escape, a press outside or the field again closes it. */
body { display: block; }
.dropdown { min-width: var(--anchor-width, 180dp); }
.asset-picker [data-ui=List] { height: auto; }
#palette-list {
    height: auto; max-height: var(--dropdown-list-h);
    --row: var(--h); --row-heading: var(--studio-height-22, 22dp); --row-about: 44dp;
}
.picker-row { display: block; }
.picker-empty { display: block; padding: 8dp; color: var(--muted-foreground); }
<div class="popup dropdown asset-picker" popover id="picker">
  <choice-list virtualized class="choice-list" data-attr-aria-setsize="palette.count" data-attr-highlight="palette_ui.highlight" data-event-highlight="emit('palette.highlight', ev.value, ev.pointer)" data-event-change="emit('palette.choose', ev.value)">
    <div class="field search"><span class="part addon"><span class="icon sm">&#xea6d;</span></span><input type="text" class="part value" id="palette-search" data-attr-placeholder="palette.placeholder" data-event-input="emit('palette.query', ev.value)"/></div>
    <use ui="List" id="palette-list" data-event-scroll="emit('palette.scroll')">
      <div class="picker-row" data-for="row : palette.rows">
        <div class="menu-group" data-if="row.heading">{{ row.label }}</div>
        <div class="menu-item" role="option" data-if="!row.heading" data-attr-value="row.place" data-attr-aria-posinset="row.place" data-attrif-data-current="row.current" data-attrif-data-described="row.about != ''"><span class="icon lead">{{ row.icon }}</span><span class="text"><span class="label" data-rml="row.label"></span><span class="about">{{ row.about }}</span></span></div>
      </div>
    </use>
    <div class="picker-empty" data-if="palette.count == 0">{{ palette.empty }}</div>
  </choice-list>
</div>
/* Properties (studio_properties.c's `properties` source): the context tabs,
   then the selection's identity, a collapsible panel per component with a
   row per field, its behaviors, and the Scene tab's settings; the Node and
   Member tabs are graph_details' rows (studio_graph_details.c). */
body, body.area-panel { width: 100%; height: 100%; margin: 0dp; padding: 0dp; overflow: hidden; }
.properties { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; }
.prop-tabs {
  width: var(--studio-height-34, 34dp); flex: 0 0 auto; display: flex; flex-direction: column; align-items: center;
  gap: 2dp; padding: 5dp 0dp; background-color: var(--rail); border-right: 1dp var(--edge);
}
.prop-tabs .tab { display: flex; flex-direction: column; align-items: center; gap: 2dp; }
.prop-tabs .btn { width: var(--h-sm); height: var(--h-sm); padding: 0dp; }
.prop-tabs .btn .icon { font-size: var(--studio-font-14, 14dp); line-height: var(--studio-line-18, 18dp); width: var(--studio-height-18, 18dp); color: var(--faint-foreground); }
.prop-tabs .btn[data-state=on] { background-color: var(--selected); }
.prop-tabs .btn[data-state=on] .icon { color: var(--primary-text); }
.prop-tabs .tab-sep { width: var(--studio-height-18, 18dp); height: 1dp; background-color: var(--line); margin: 4dp 0dp; }
.prop-scroll { flex: 1 1 0dp; overflow-y: auto; padding: 8dp 8dp 16dp; }
/* Labels follow the center of the value they describe, including tall values. */
.prop { align-items: center; }
/* A row's one control, as its kind builds it. */
.kind { display: flex; flex: 1 1 0dp; min-width: 0dp; }
/* RmlUi gives :focus to a focused element's ancestors too, as :focus-within. */
.field.text:focus { background-color: var(--field-edit); border-color: var(--ring); }
.identity .name-field .field.text:focus { background-color: var(--field-edit); border-color: var(--ring); }
/* An object a handle names (studio_properties_view.c): a click selects it,
   so it reads as a field with a locate mark, and None, a removed object or
   several objects' different ones (a dash) rest like a read-only field. */
.entity-field[data-placeholder] .value, .entity-field[data-mixed] .value, .entity-field[data-readonly] .lead { color: var(--muted-foreground); }
.entity-field[data-readonly] { cursor: arrow; }
/* A panel's head folds it, but for its menu. A long title ends in an
   ellipsis on one line, so every head keeps one height. */
.panel-fold { display: flex; align-items: center; gap: 6dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.panel-fold .title { flex: 0 1 auto; min-width: 0dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.panel-fold .badge { flex: 0 0 auto; }
/* Why a scene setting is read-only while the scene runs. */
.prop-note { padding: 0dp 4dp 8dp; color: var(--faint-foreground); }
/* Several selected objects: a chip per prototype among them, wrapping. */
.identity .lineage.prototypes { flex-wrap: wrap; white-space: normal; gap: 2dp 4dp; }
/* A behavior row opens its graph, but for its Detach. */
.behavior-open { display: flex; align-items: center; gap: 6dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
/* The Node and Member tabs: an expression's field and its error, a
   signature pin's block and a compound value's popover rows. */
.graph-row { display: block; }
.graph-expression { display: block; }
.graph-expression .notice { display: block; margin-top: 4dp; }
.graph-sub { display: block; }
.graph-sub-heading { display: block; margin-top: var(--gap); }
.graph-inline-part { display: block; }
.param-settings [data-ui=EnumField] { flex: 1 1 78dp; min-width: 0dp; }
<div class="properties">
  <nav class="prop-tabs">
    <div class="tab" data-for="tab : properties.tabs">
      <div class="tab-sep" data-if="tab.sep"></div>
      <button class="btn icon-only" data-attr-data-state="tab.on ? 'on' : 'off'" data-attr-data-tip="tab.tip" data-tip-side="right" data-event-click="emit('properties.tab', tab.id)"><span class="icon">{{ tab.icon }}</span></button>
    </div>
  </nav>
  <div class="prop-scroll" data-if="properties.view != 'graph'">
    <div class="identity" data-when="properties.identity.kind == 'object'">
      <div class="glyph"><span class="icon">{{ properties.identity.icon }}</span></div>
      <div class="who">
        <div class="name-field">
          <div class="field text" data-attrif-data-readonly="properties.identity.locked" data-tip="Name" data-attr-data-kbd="properties.identity.kbd" data-attr-data-tip-about="properties.identity.why">
            <input type="text" class="part value" id="name" aria-label="Name" data-attr-value="properties.identity.name" data-attrif-readonly="properties.identity.locked" data-keys="Escape:properties.cancel" data-event-change="emit('properties.rename', ev.value)"/>
          </div>
        </div>
        <div class="lineage">
          <span>{{ properties.identity.of }}</span>
          <button class="btn" data-tip="Open prototype" data-event-click="emit('properties.openPrototype')"><span class="icon">&#xf01a7;</span><span class="label">{{ properties.identity.prototype }}</span></button>
          <button class="btn icon-only" data-if="properties.identity.placed" popovertarget="prototype-actions" aria-haspopup="menu" data-tip="Prototype actions" data-attrif-data-disabled="!properties.identity.actions"><span class="icon">&#xea7c;</span></button>
          <use ui="Menu" id="prototype-actions">
            <use ui="MenuCommand" data-alias-command="commands.applyOverrides"/>
            <use ui="MenuCommand" data-alias-command="commands.saveAsPrototype"/>
          </use>
        </div>
      </div>
    </div>
    <div class="identity" data-when="properties.identity.kind == 'selection'">
      <div class="glyph"><span class="icon">&#xf0135;</span></div>
      <div class="who">
        <span class="title">{{ properties.identity.name }}</span>
        <div class="lineage prototypes">
          <button class="btn" data-for="chip : properties.identity.chips" data-tip="Select only these" data-event-click="emit('properties.narrow', chip.name)"><span class="icon">{{ chip.icon }}</span><span class="label">{{ chip.label }}</span></button>
        </div>
      </div>
    </div>
    <div class="identity" data-when="properties.identity.kind == 'prototype'">
      <div class="glyph"><span class="icon">{{ properties.identity.icon }}</span></div>
      <div class="who">
        <div class="row"><span class="title">{{ properties.identity.name }}</span><span class="badge accent">Prototype</span></div>
        <span class="lineage">{{ properties.identity.of }}</span>
      </div>
    </div>
    <span class="prop-note" data-if="properties.note != ''">{{ properties.note }}</span>
    <section class="panel" data-for="panel : properties.panels" data-if="panel.shown" data-attr-data-key="panel.key" data-attrif-data-open="panel.open" data-attrif-data-menu="panel.menu">
      <div class="panel-head" data-event-contextmenu="emit('properties.panelMenu', panel.key)">
        <div class="panel-fold" data-event-click="emit('properties.fold', panel.key)">
          <span class="icon chev">&#xeab4;</span>
          <span class="title">{{ panel.title }}</span>
          <span class="badge override" data-if="panel.badge != ''">{{ panel.badge }}</span>
          <span class="spacer"></span>
        </div>
        <button class="btn sm icon-only menu" data-if="panel.menu" aria-haspopup="menu" data-tip="More" data-event-click="emit('properties.panelMenu', panel.key)"><span class="icon">&#xea7c;</span></button>
      </div>
      <div class="panel-body" data-if="panel.open">
        <use ui="PropertyRow" data-for="row : panel.rows" data-if="row.shown" data-alias-property="row" data-event-contextmenu="emit('properties.menu', row.id)">
          <div class="kind" data-when="row.control == 'number'"><use ui="NumberField" data-attr-id="row.id" data-attr-aria-label="row.label" data-attr-value="propertyValues[row.slot]" data-attr-min="row.min" data-attr-max="row.max" data-attr-step="row.step" data-attr-precision="row.precision" data-attr-unit="row.unit" data-attrif-integer="row.integer" data-attrif-float="row.float" data-attrif-slider="row.slider" data-attrif-mixed="row.mixed" data-attrif-readonly="row.readonly" data-attrif-invalid="row.invalid" data-attrif-data-overridden="row.overridden" data-event-input="emit('properties.input', row.id, ev.value)" data-event-change="emit('properties.change', row.id, ev.value, ev.canceled)"/></div>
          <div class="kind" data-when="row.control == 'vector'"><use ui="VectorField" data-alias-axes="row.axes" data-alias-values="propertyValues" data-alias-field="row" data-event-input="emit('properties.input', row.id, ev.value, ev.name)" data-event-change="emit('properties.change', row.id, ev.value, ev.canceled, ev.name)"/></div>
          <div class="kind" data-when="row.control == 'bool'"><use ui="Checkbox" data-attr-id="row.id" data-attr-aria-label="row.label" data-attrif-checked="row.checked" data-attrif-data-mixed="row.mixed" data-attrif-disabled="row.readonly" data-event-change="emit('properties.check', row.id, ev.value)"/></div>
          <div class="kind" data-when="row.control == 'choice'"><use ui="EnumField" data-alias-table="row.table" data-alias-value="row.value" data-attrif-data-mixed="row.mixed" data-attrif-data-readonly="row.readonly" data-event-click="emit('properties.choices', row.id)" data-event-change="emit('properties.change', row.id, ev.value)"/></div>
          <div class="kind" data-when="row.control == 'color'"><use ui="ColorField" data-attr-id="row.id" data-attr-aria-label="row.label" data-attr-value="row.value" data-attrif-mixed="row.mixed" data-attrif-readonly="row.readonly" data-attrif-data-overridden="row.overridden" data-event-input="emit('properties.input', row.id, ev.value)" data-event-change="emit('properties.change', row.id, ev.value, ev.canceled)"/></div>
          <div class="kind" data-when="row.control == 'text'">
            <div class="field text" data-attrif-data-readonly="row.readonly" data-attrif-data-mixed="row.mixed" data-attrif-data-overridden="row.overridden">
              <input type="text" class="part value" data-attr-id="row.id" data-attr-aria-label="row.label" data-attr-value="row.text" data-attr-placeholder="row.mixed ? '&#x2014;' : ''" data-attrif-readonly="row.readonly" data-keys="Escape:properties.cancel" data-event-change="emit('properties.change', row.id, ev.value)"/>
            </div>
          </div>
          <div class="kind" data-when="row.control == 'asset'"><use ui="AssetField" data-alias-table="row.table" data-alias-value="row.text" data-attr-data-row="row.id" data-attr-data-drop="row.drop" data-drop-hint="Assign" data-attr-data-tip="row.problem" data-attrif-data-drop-preview="row.preview" data-attrif-data-readonly="row.readonly" data-attrif-data-invalid="row.invalid" data-event-click="emit('palette.pick', row.kind, row.text, row.table.none, 'typed')" data-event-change="emit('properties.change', row.id, ev.value)" data-event-drop="emit('properties.drop', row.id, ev.payload)"/></div>
          <div class="kind" data-when="row.control == 'entity'"><button class="field select entity-field" data-attr-id="row.id" data-attr-aria-label="row.label" data-attrif-data-placeholder="row.text == ''" data-attrif-data-mixed="row.mixed" data-attrif-data-readonly="row.hint == ''" data-attrif-data-invalid="row.invalid" data-attr-data-tip="row.hint != '' ? row.hint : row.problem" data-attr-data-tip-about="row.hint != '' ? row.problem : ''" data-event-click="emit('properties.reveal', row.id)"><span class="icon lead">{{ row.table.icon }}</span><span class="part value">{{ row.text == '' ? row.table.none : row.text }}</span><span class="icon caret" data-if="row.hint != ''">&#xebf8;</span></button></div>
          <span class="muted" data-when="row.control == 'label'">{{ row.text }}</span>
        </use>
      </div>
    </section>
    <section class="panel" data-when="properties.behaviors.shown" data-attrif-data-open="properties.behaviors.open">
      <div class="panel-head">
        <div class="panel-fold" data-event-click="emit('properties.fold', 'behaviors')">
          <span class="icon chev">&#xeab4;</span>
          <span class="title">Behaviors</span>
          <span class="spacer"></span>
        </div>
      </div>
      <div class="panel-body" data-if="properties.behaviors.open">
        <div class="behavior-row" data-for="behavior : properties.behaviors.rows" data-attrif-data-current="behavior.open">
          <div class="behavior-open" data-event-click="emit('properties.openBehavior', behavior.name)"><span class="icon">&#xebb9;</span><span class="name">{{ behavior.name }}</span></div>
          <button class="btn sm icon-only" data-tip="Detach" data-attr-data-tip-about="properties.behaviors.why" data-attrif-data-disabled="properties.behaviors.locked" data-event-click="emit('properties.detach', behavior.name)"><span class="icon">&#xea76;</span></button>
        </div>
        <div class="add-row">
          <button class="btn subtle" popovertarget="attach-behavior" aria-haspopup="menu" data-attr-data-tip="properties.behaviors.why" data-attrif-data-disabled="properties.behaviors.locked"><span class="icon">&#xea60;</span><span class="label">Attach Behavior</span></button>
          <use ui="Menu" id="attach-behavior">
            <use ui="MenuItem" data-for="asset : properties.behaviors.assets" data-alias-item="asset" data-event-click="emit('properties.attach', asset.label)"/>
          </use>
        </div>
      </div>
    </section>
    <div class="add-row" data-if="properties.add.shown">
      <button class="btn subtle" data-attr-data-tip="properties.add.why" data-attrif-data-disabled="properties.add.locked" data-event-click="emit('studio.addComponent')"><span class="icon">&#xea60;</span><span class="label">Add Component</span></button>
    </div>
    <span class="prop-empty" data-if="properties.view == 'empty'">Select an object to edit its properties</span>
  </div>
  <div class="prop-scroll" data-if="properties.view == 'graph'">
    <div id="graph-native"></div>
    <div class="identity" data-if="graph_details.identity.name != ''">
      <div class="glyph"><span class="icon">{{ graph_details.identity.icon }}</span></div>
      <div class="who"><span class="title">{{ graph_details.identity.name }}</span><div class="lineage"><span>{{ graph_details.identity.of }}</span></div></div>
    </div>
    <span class="prop-empty" data-if="graph_details.empty != ''">{{ graph_details.empty }}</span>
    <section class="panel" data-for="panel : graph_details.panels" data-if="panel.shown" data-attrif-data-open="panel.open">
      <div class="panel-head">
        <div class="panel-fold" data-event-click="emit('graph_details.fold', panel.key)">
          <span class="icon chev">&#xeab4;</span>
          <span class="title">{{ panel.title }}</span>
          <span class="spacer"></span>
        </div>
      </div>
      <div class="panel-body" data-if="panel.open">
        <div class="graph-row" data-for="row : panel.rows" data-if="row.shown">
          <use ui="PropertyRow" data-when="row.control != 'expression' && row.control != 'param'" data-alias-property="row">
            <div class="kind" data-when="row.control != 'type' && row.control != 'struct' && row.control != 'array'"><use ui="GraphField" data-alias-field="row" data-alias-kind="row.control"></use></div>
            <div class="type-pick" data-when="row.control == 'type'"><kit-dot class="member-swatch" data-attr-shape="row.swatch" data-attr-fill="row.color"></kit-dot><button class="btn subtle type-button" data-attrif-data-disabled="row.readonly" data-event-click="emit('graph_details.type', row.id)"><span class="label">{{ row.type }}</span></button></div>
            <div class="kind" data-when="row.control == 'struct' || row.control == 'array'">
              <button class="btn sm" popovertarget="values" data-attr-data-tip="row.control == 'struct' ? row.name : ''" data-attrif-data-disabled="row.readonly"><span class="icon">{{ row.control == 'struct' ? '&#xf0a66;' : '&#xeb86;' }}</span><span class="label">{{ row.text }}</span></button>
              <div class="popup popover menu" popover data-template id="values">
                <span class="muted" data-if="row.control == 'struct'">{{ row.name }}</span>
                <div class="graph-sub" data-for="sub : row.sub">
                  <span class="muted graph-sub-heading" data-if="sub.heading">{{ sub.label }}</span>
                  <use ui="PropertyRow" data-if="!sub.heading" data-alias-property="sub">
                    <use ui="GraphField" data-alias-field="sub" data-alias-kind="sub.control"></use>
                    <button class="btn sm icon-only" data-if="sub.removable" data-tip="Remove item" data-attrif-data-disabled="row.readonly" data-event-click="emit('graph_details.remove', sub.id)"><span class="icon">&#xea81;</span></button>
                  </use>
                  <button class="btn sm icon-only graph-sub-remove" data-if="sub.heading && sub.removable" data-tip="Remove item" data-attrif-data-disabled="row.readonly" data-event-click="emit('graph_details.remove', sub.id)"><span class="icon">&#xea81;</span></button>
                </div>
                <button class="btn subtle sm" data-if="row.control == 'array'" data-attrif-data-disabled="row.readonly || !row.removable" data-event-click="emit('graph_details.add', row.id)"><span class="icon">&#xea60;</span><span class="label">Add item</span></button>
              </div>
            </div>
            <button class="btn sm icon-only" data-if="row.bindable" data-attrif-data-disabled="row.readonly" data-tip="Bind to Source" data-tip-about="Type a property path, or choose a value for this input to read." data-event-click="emit('graph_details.bind', row.id)"><span class="icon">&#xf0339;</span></button>
            <div class="popup popover graph-inline-values" popover data-template>
              <span class="graph-inline-heading">Inline inputs</span>
              <div class="graph-inline-part" data-for="sub : row.sub">
                <span class="graph-inline-title" data-if="sub.heading">{{ sub.label }}</span>
                <div class="graph-inline-row" data-if="!sub.heading"><span class="graph-inline-label">{{ sub.label }}</span><use ui="GraphField" data-alias-field="sub" data-alias-kind="sub.control"></use></div>
              </div>
            </div>
          </use>
          <div class="graph-expression" data-when="row.control == 'expression'">
            <div class="field text" data-attrif-data-readonly="row.readonly"><input type="text" class="part value" data-attr-id="row.id" aria-label="Expression" data-attr-value="row.text" data-attr-placeholder="row.placeholder" data-attrif-readonly="row.readonly" data-keys="Escape:graph_details.cancel" data-event-change="emit('graph_details.change', row.id, ev.value)"/></div>
            <span class="notice" data-if="row.error != ''">{{ row.error }}</span>
          </div>
          <div class="param" data-when="row.control == 'param'" data-attr-data-drop="row.drop" data-event-drop="emit('graph_details.reorder', row.id, ev.payload)">
            <div class="param-row">
              <div class="param-name">
                <span class="icon param-grip" data-attr-data-drag="row.drop" data-attr-data-drag-payload="row.id" data-attr-data-drag-label="row.name">&#xeb04;</span>
                <div class="field text" data-attrif-data-readonly="row.readonly"><input type="text" class="part value" aria-label="Name" data-attr-value="row.name" data-attrif-readonly="row.readonly" data-keys="Escape:graph_details.cancel" data-event-change="emit('graph_details.rename', row.id, ev.value)"/></div>
                <button class="btn icon-only" data-tip="Remove" data-attrif-data-disabled="row.readonly" data-event-click="emit('graph_details.remove', row.id)"><span class="icon">&#xea81;</span></button>
              </div>
              <div class="param-settings">
                <div class="type-pick"><kit-dot class="member-swatch" data-attr-shape="row.swatch" data-attr-fill="row.color"></kit-dot><button class="btn subtle type-button" data-attrif-data-disabled="row.readonly" data-event-click="emit('graph_details.type', row.id)"><span class="label">{{ row.type }}</span></button></div>
                <use ui="EnumField" data-alias-table="graph_details.containers.table" data-alias-value="row.container" data-attrif-data-readonly="row.readonly || row.fixed" data-event-change="emit('graph_details.container', row.id, ev.value)"></use>
              </div>
            </div>
            <div class="prop" data-when="row.def != ''">
              <label class="label"><span>Default</span></label>
              <div class="control"><use ui="GraphField" data-alias-field="row" data-alias-kind="row.def"></use></div>
            </div>
          </div>
        </div>
        <div class="add-row" data-if="panel.add != ''"><button class="btn subtle" data-attrif-data-disabled="panel.addOff" data-event-click="emit('graph_details.addPin', panel.addId)"><span class="icon">&#xea60;</span><span class="label">{{ panel.add }}</span></button></div>
      </div>
    </section>
  </div>
  <use ui="Menu" id="field-menu">
    <use ui="MenuItem" data-alias-item="properties.fieldMenu.reset" data-event-click="emit('properties.reset')"/>
    <use ui="MenuItem" data-alias-item="properties.fieldMenu.apply" data-event-click="emit('properties.apply')"/>
  </use>
  <use ui="Menu" id="component-menu">
    <div class="menu-group">{{ properties.componentMenu.title }}</div>
    <div class="menu-item" role="menuitem" data-attrif-data-disabled="properties.componentMenu.disabled" data-attrif-data-described="properties.componentMenu.about != ''" data-event-click="emit('properties.componentAction')"><span class="icon lead">{{ properties.componentMenu.icon }}</span><span class="text"><span class="label">{{ properties.componentMenu.label }}</span><span class="about">{{ properties.componentMenu.about }}</span></span></div>
  </use>
</div>
/* Properties' header controls, in its area header (studio_properties.c
   mounts it there): the search, which filters fields across every panel
   and Escape clears, and while the scene runs a Live badge and Keep
   (Unreal's Keep Simulation Changes), or Read-only for a prototype. */
body { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.field.search { min-width: 0dp; }
/* RmlUi gives :focus to a focused element's ancestors too, as :focus-within. */
.field.search:focus { background-color: var(--field-edit); border-color: var(--ring); }
.badge, .btn { flex: 0 0 auto; }
<div class="field search">
  <span class="part addon"><span class="icon sm">&#xea6d;</span></span>
  <input type="text" class="part value" id="search" placeholder="Search properties" aria-label="Search properties" data-value="properties.query" data-keys="Escape:properties.clear"/>
</div>
<span class="badge" data-if="properties.readonly" data-tip="Stop playing to edit prototypes">Read-only</span>
<span class="badge accent" data-if="properties.live" data-tip="Changes made while playing revert when you stop">Live</span>
<button class="btn" data-if="properties.live" data-attrif-data-disabled="!commands.keepChanges.enabled" data-attr-data-tip="commands.keepChanges.label" data-attr-data-kbd="commands.keepChanges.shortcut" data-attr-data-tip-about="properties.keepTip" data-event-click="emit('studio.keepChanges')"><span class="icon">&#xf0931;</span><span class="label">Keep</span></button>
/* One property, as Properties lays it out: its label, which focuses the
   control whose id is the property's, and its controls, the use's
   children. Alias the property as data-alias-property: an object with id,
   label, tip (its label when it has a description, else empty), about
   (the description) and overridden. */
body { display: block; }
<div class="prop" data-attr-data-tip="property.tip" data-attr-data-tip-about="property.about" data-attrif-data-overridden="property.overridden">
  <label class="label" data-attr-for="property.id"><span data-tip-clipped="">{{ property.label }}</span></label>
  <div class="control"><slot/></div>
</div>
/* Rename across uses and safe delete (studio_refactor.c, the `refactor`
   source), a popover at the pointer in a document of its own shown only
   while it asks, as JetBrains' Rename and Safe Delete ask. A rename names
   the symbol anew: Enter shows each asset it rewrites with the name it
   takes or how many changes, and how often prose mentions it; Enter again,
   or Rename, applies it and a toast offers Undo. A delete of what is still
   used lists the uses and asks. Its look is the theme's .refactor. */
body { display: block; }
<div class="popup menu refactor" popover role="menu" id="refactor">
  <div class="menu-group">{{ refactor.title }}</div>
  <div class="refactor-field" data-if="refactor.rename"><div class="field text"><input type="text" class="part value" id="refactor-name" data-keys="Enter:refactor.enter" data-event-input="emit('refactor.name', ev.value)"/></div></div>
  <div class="refactor-row" data-if="refactor.error != ''"><span class="icon lead">&#xea6c;</span><span class="label">{{ refactor.error }}</span></div>
  <div class="refactor-row" data-for="row : refactor.rows"><span class="icon lead">{{ row.icon }}</span><span class="label">{{ row.label }}</span><span class="kbd" data-if="row.meta != ''">{{ row.meta }}</span></div>
  <use ui="MenuSeparator"/>
  <use ui="MenuItem" data-alias-item="refactor.apply" data-event-click="emit('refactor.apply')"/>
</div>
.caption { display: block; height: var(--h); line-height: var(--h); color: var(--muted-foreground); }
.empty { display: block; padding: 12dp 0dp; color: var(--faint-foreground); text-align: center; }
<div class="caption">{{ world.title }}</div>
<div class="prop" data-for="row : world.saved">
  <div class="label">{{ row.key }}</div>
  <div class="control"><use ui="TextField" data-alias-text="row.value"/></div>
</div>
<div class="empty" data-if="world.saved.size == 0">No saved keys</div>
/* The Scene area (studio_scene.c): the scene's surface, native in
   #scene-surface, where the pointer, gizmos and camera stay in C, and over
   it what the `scene_view` source shows: each camera frame's name over its
   top-left corner and each undrawn object's icon over its place, moved by a
   transform as the camera pans so nothing lays out; why the tool's gizmo is
   grey, below it; a gesture's change by the pointer; the camera's zoom; Live
   while a session runs; the generated world's progress and the notice line.
   The status bar names the scene and selection. A guest Studio fills the
   surface and shows none of them. The scene keeps dark roles in every theme
   (theme/viewport.rcss). */
@import "theme/viewport.rcss";
body.area-panel { padding: 0dp; overflow: hidden; }
.viewport { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; background-color: var(--viewport); }
.scene-surface { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; }
.surface { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
.camera-label {
    position: absolute; left: 0dp; top: 0dp; margin: 4dp 0dp 0dp 6dp; padding: 0dp 5dp; border-radius: var(--r);
    background-color: var(--floating); color: var(--muted-foreground);
    font-size: var(--studio-font-11, 11dp); line-height: var(--studio-line-16, 16dp);
    white-space: nowrap; pointer-events: none;
}
.camera-label[data-active], .camera-label[data-selected] { color: var(--foreground); }
.camera-label[data-disabled] { opacity: 0.6; }
/* An undrawn object's icon centered on its place, in a chip that reads on
   any backdrop; the Scene picks it within MARKER_RADIUS_DP (10dp), and it
   takes the selection's orange (scene_gizmo.h) as the outline would. */
.marker {
    position: absolute; left: 0dp; top: 0dp; width: 20dp; height: 20dp; margin: -10dp 0dp 0dp -10dp;
    border-radius: 10dp; border: 1dp var(--line); background-color: var(--floating);
    color: var(--muted-foreground); font-size: 13dp; line-height: 18dp; text-align: center;
    pointer-events: none;
}
.marker[data-hovered] { color: var(--foreground); border-color: #ffa53a80; }
.marker[data-selected] { color: #e0701c; border-color: #e0701c; }
.marker[data-active] { color: #ffa53a; border-color: #ffa53a; }
.marker[data-locked] { opacity: 0.5; }
/* Why the tool's gizmo is grey, centered below it, with its one-click fix.
   It fades in and out (presence) as the selection gains or loses what the
   tool needs. */
.tool-hint { position: absolute; left: 0dp; top: 0dp; width: 0dp; height: 0dp; opacity: 1; transition: opacity 0.14s cubic-out; }
.tool-hint[data-starting-style], .tool-hint[data-ending-style] { opacity: 0; }
.tool-hint-box {
    position: absolute; left: 0dp; top: 0dp; display: flex; justify-content: center;
    pointer-events: none;
}
.tool-hint-pill {
    display: flex; align-items: center; gap: 6dp; box-sizing: border-box; min-width: 0dp; max-width: 100%; padding: 2dp 2dp 2dp 8dp; border-radius: var(--r);
    border: 1dp var(--line); background-color: var(--floating); pointer-events: auto;
}
.tool-hint-pill > .icon { color: var(--muted-foreground); font-size: 13dp; }
.tool-hint-pill > .icon, .tool-hint-pill > .btn { flex: 0 0 auto; }
.tool-hint-pill > .text { flex: 0 1 auto; min-width: 0dp; overflow: hidden; text-overflow: ellipsis; color: var(--foreground); font-size: var(--studio-font-11, 11dp); white-space: nowrap; }
/* A gesture's change by the pointer. */
.delta-label {
    position: absolute; left: 0dp; top: 0dp; padding: 1dp 6dp; border-radius: var(--r);
    background-color: var(--floating); color: var(--foreground);
    font-family: var(--font-numeric); font-size: var(--studio-font-11, 11dp); line-height: var(--studio-line-16, 16dp);
    white-space: nowrap; pointer-events: none;
}
.readout { position: absolute; right: 10dp; bottom: 8dp; color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); font-family: var(--font-numeric); pointer-events: none; }
.live-badge { position: absolute; left: 12dp; bottom: 10dp; }
.model-preview { position: absolute; top: 8dp; left: 12dp; display: flex; align-items: center; gap: 6dp; }
.notice { position: absolute; left: 12dp; right: 12dp; bottom: 36dp; padding: 6dp 8dp; border-radius: var(--r); background-color: var(--notice); color: var(--notice-fg); white-space: normal; }
.world-pending {
    position: absolute; right: 10dp; top: 8dp; display: flex; align-items: center; gap: 5dp;
    height: var(--studio-height-20, 20dp); padding: 0dp 8dp; border-radius: var(--r);
    background-color: var(--floating); color: var(--muted-foreground);
    font-size: var(--studio-font-11, 11dp); white-space: nowrap; pointer-events: none;
    opacity: 1; transition: opacity 0.14s cubic-out;
}
.world-pending[data-starting-style], .world-pending[data-ending-style] { opacity: 0; }
.world-pending .spin { font-size: 12dp; animation: 0.9s linear infinite world-spin; }
@keyframes world-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
<div class="viewport">
  <div class="scene-surface" id="scene-surface"></div>
  <span class="camera-label" data-for="camera : scene_view.cameras" data-style-transform="camera.at" data-attrif-data-active="camera.active" data-attrif-data-disabled="camera.disabled" data-attrif-data-selected="camera.selected">{{ camera.name }}</span>
  <span class="marker icon" data-for="marker : scene_view.markers" data-style-transform="marker.at" data-attrif-data-active="marker.active" data-attrif-data-selected="marker.selected" data-attrif-data-hovered="marker.hovered" data-attrif-data-locked="marker.locked">{{ marker.icon }}</span>
  <div class="tool-hint" data-if="scene_view.hinted" presence data-style-transform="scene_view.hintAt"><div class="tool-hint-box" data-style-width="scene_view.hintWidth"><div class="tool-hint-pill"><span class="icon">&#xea74;</span><span class="text">{{ scene_view.hint }}</span><button class="btn sm" data-if="scene_view.hintAddable" data-event-click="emit('scene.addMissing')"><span class="icon">&#xea60;</span><span class="label">{{ scene_view.hintAction }}</span></button></div></div></div>
  <span class="delta-label" data-if="scene_view.delta != ''" data-style-transform="scene_view.deltaAt">{{ scene_view.delta }}</span>
  <number-flow class="number-flow readout" data-when="scene_view.readout &amp;&amp; !scene_view.zooming" data-attr-value="scene_view.zoom" grouping="" suffix="%"></number-flow>
  <span class="readout" data-if="scene_view.readout &amp;&amp; scene_view.zooming">{{ scene_view.zoomText }}</span>
  <span class="badge accent live-badge" data-if="scene_view.session">Live</span>
  <div class="model-preview" data-if="scene_view.modelPreview">
    <span class="badge accent">Model · {{ scene_view.model }}</span>
    <button class="btn sm" data-tip="Frame model" data-event-click="emit('scene.frameModel')"><span class="icon">&#xeb90;</span><span class="label">Frame</span></button>
  </div>
  <div class="world-pending" data-if="scene_view.pending" presence><span class="icon spin">&#xeb19;</span><span>Generating world</span></div>
  <span class="notice" data-if="scene_view.modelError != ''">{{ scene_view.modelError }}</span>
  <span class="notice" data-if="scene_view.modelSourceError != ''">{{ scene_view.modelSourceError }}</span>
  <span class="notice" data-if="scene_view.modelParameterError != ''">{{ scene_view.modelParameterError }}</span>
  <span class="notice" data-if="scene_view.error != ''">{{ scene_view.error }}</span>
  <span class="notice" data-if="scene_view.error == '' &amp;&amp; scene_view.warning != ''" data-tip="Lighting adjusted" data-attr-data-tip-about="scene_view.warning">Lighting adjusted</span>
</div>
/* The Scene's controls in its area header (studio_scene.c's `scene`
   source). Editing a scene: the View menu, then the transform tools and,
   at the end, snapping joined to its grid increment and Frame, each group a
   pill of icon buttons as Unreal's and Godot's viewport toolbars group
   theirs; the active tool is filled, as Blender's toolbar marks it. In the
   Canvas: Scene › asset crumbs, the screen sizes, the backdrop and the
   Actions toggle. View Zoom shows only while it magnifies, and always in
   the Canvas. A guest Studio names what runs. */
body { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; min-width: 0dp; height: 100%; }
.scene-tools, .canvas-tools, .scene-guest { display: flex; align-items: center; gap: 2dp; flex: 0 1 auto; min-width: 0dp; height: 100%; }
.scene-guest { gap: 6dp; white-space: nowrap; }
.btn, .canvas-sizes, .canvas-sizes .segmented, .canvas-sizes .seg { flex: 0 0 auto; }
.crumbs .btn.crumb { flex: 0 1 auto; }
.seg { tab-index: auto; }

.tool-group, .snap-controls {
    display: flex; align-items: center; flex: 0 0 auto; gap: 1dp; padding: 1dp;
    border-radius: var(--r); background-color: var(--secondary);
}
.tool-group { margin-left: 4dp; }
/* The area header's buttons keep its control height (AreaHeader.rcss). */
.tool-group .btn { width: var(--h-sm); padding: 0dp; }
.tool-group .btn[data-state=on] { background-color: var(--primary); }
.tool-group .btn[data-state=on] .icon { color: var(--primary-foreground); }
.snap-controls .btn { min-width: var(--h-sm); padding: 0dp 6dp; }
.snap-controls .btn.icon-only { width: var(--h-sm); padding: 0dp; }
.snap-controls .menu-btn { font-family: var(--font-numeric); }
.snap-controls .btn[data-state=on] { background-color: var(--primary); }
.snap-controls .btn[data-state=on] .icon { color: var(--primary-foreground); }

.canvas-sizes { display: flex; margin-left: 6dp; }
.canvas-actions-toggle { display: flex; align-items: center; gap: 4dp; flex: 0 0 auto; padding: 0dp 6dp 0dp 2dp; }
.canvas-actions-toggle .btn { gap: 4dp; padding: 0dp 6dp; }
.canvas-actions-toggle .btn .icon { font-size: 13dp; width: 14dp; }
.canvas-actions-toggle .count { color: var(--faint-foreground); font-size: 11dp; }
<div class="scene-guest" data-when="scene.mode == 1"><span>Studio</span><span class="dim">Running this project's working copy</span></div>
<div class="scene-tools" data-when="scene.mode == 0">
  <button class="btn menu-btn" popovertarget="scene-view" aria-haspopup="menu"><span class="label">View</span></button>
  <use ui="Menu" id="scene-view">
    <use ui="MenuCommand" data-alias-command="commands.frame"/>
    <use ui="MenuCommand" data-alias-command="commands.frameAll"/>
    <use ui="MenuCommand" data-alias-command="commands.resetCamera"/>
    <use ui="MenuCommand" data-alias-command="commands.viewThroughCamera"/>
    <use ui="MenuSeparator"/>
    <use ui="MenuGroup">Show</use>
    <use ui="MenuCommand" data-alias-command="commands.toggleGrid"/>
    <use ui="MenuCommand" data-alias-command="commands.showGeneratedWorld"/>
    <use ui="MenuCommand" data-alias-command="commands.showLighting"/>
    <use ui="MenuCommand" data-alias-command="commands.showFog"/>
    <use ui="MenuCommand" data-alias-command="commands.showCameraFrames"/>
  </use>
  <div class="tool-group">
    <button class="btn icon-only" data-attr-data-state="commands.selectTool.checked ? 'on' : ''" data-attr-data-tip="commands.selectTool.menu" data-attr-data-kbd="commands.selectTool.shortcut" data-event-click="emit('studio.selectTool')"><span class="icon">{{ commands.selectTool.icon }}</span></button>
    <button class="btn icon-only" data-attr-data-state="commands.moveTool.checked ? 'on' : ''" data-attr-data-tip="commands.moveTool.menu" data-attr-data-kbd="commands.moveTool.shortcut" data-event-click="emit('studio.moveTool')"><span class="icon">{{ commands.moveTool.icon }}</span></button>
    <button class="btn icon-only" data-attr-data-state="commands.rotateTool.checked ? 'on' : ''" data-attr-data-tip="commands.rotateTool.menu" data-attr-data-kbd="commands.rotateTool.shortcut" data-event-click="emit('studio.rotateTool')"><span class="icon">{{ commands.rotateTool.icon }}</span></button>
    <button class="btn icon-only" data-attr-data-state="commands.scaleTool.checked ? 'on' : ''" data-attr-data-tip="commands.scaleTool.menu" data-attr-data-kbd="commands.scaleTool.shortcut" data-event-click="emit('studio.scaleTool')"><span class="icon">{{ commands.scaleTool.icon }}</span></button>
  </div>
</div>
<div class="canvas-tools" data-when="scene.mode == 2">
  <div class="crumbs">
    <button class="btn crumb" data-tip="Back to the scene" data-event-click="emit('canvas.back')"><span class="icon">&#xebd2;</span><span class="label">Scene</span></button>
    <span class="icon crumb-sep">&#xeab6;</span>
    <button class="btn crumb current" popovertarget="canvas-asset" aria-haspopup="menu"><span class="icon">&#xebeb;</span><span class="label">{{ canvas.asset }}</span></button>
    <use ui="Menu" id="canvas-asset">
      <use ui="MenuGroup">Used by</use>
      <use ui="MenuItem" data-for="user, i : canvas.used" data-alias-item="user" data-event-click="emit('canvas.used', i)"></use>
      <use ui="MenuItem" data-if="canvas.used.size == 0" data-alias-item="canvas.unused"/>
      <use ui="MenuSeparator"/>
      <use ui="Submenu" data-alias-item="canvas.preview">
        <use ui="MenuItem" data-for="ui, i : canvas.previews" data-alias-item="ui" data-attrif-data-current="ui.current" data-event-click="emit('canvas.preview', i)"></use>
      </use>
    </use>
  </div>
  <div class="canvas-sizes">
    <div class="segmented">
      <button class="seg" data-for="label, i : canvas.sizes" data-attrif-data-pressed="canvas.size == i" data-event-click="emit('canvas.size', i)">{{ label }}</button>
    </div>
  </div>
  <button class="btn icon-only" data-attr-data-tip="canvas.light ? 'Light backdrop' : 'Dark backdrop'" data-event-click="emit('canvas.backdrop')"><span class="icon" data-if="canvas.light">&#xf0599;</span><span class="icon" data-if="!canvas.light">&#xf0594;</span></button>
  <div class="canvas-actions-toggle">
    <button class="btn sm canvas-actions-button" data-tip="Show or hide UI events" data-attr-data-state="canvas.open ? 'on' : ''" data-event-click="emit('canvas.actions')"><span class="icon">&#xea86;</span><span class="label">Actions</span></button>
    <number-flow class="number-flow count" data-attr-value="canvas.total"></number-flow>
  </div>
</div>
<div class="spacer"></div>
<button class="btn menu-btn" data-if="scene.zoomShown" popovertarget="scene-zoom" aria-haspopup="menu" data-tip="View Zoom" data-attr-data-kbd="scene.zoomKbd"><span class="label">{{ scene.zoom }}</span></button>
<use ui="Menu" id="scene-zoom">
  <use ui="MenuGroup">View Zoom</use>
  <use ui="MenuItem" data-for="zoom, i : scene.zooms" data-alias-item="zoom" data-event-click="emit('scene.zoom', i)"></use>
</use>
<div class="snap-controls" data-if="scene.mode == 0">
  <button class="btn icon-only" data-attr-data-state="commands.toggleSnap.checked ? 'on' : ''" data-attr-data-tip="commands.toggleSnap.label" data-attr-data-kbd="commands.toggleSnap.shortcut" data-event-click="emit('studio.toggleSnap')"><span class="icon">{{ commands.toggleSnap.icon }}</span></button>
  <button class="btn menu-btn" popovertarget="scene-increment" aria-haspopup="menu" data-tip="Grid Increment"><span class="label">{{ scene.increment }}</span></button>
  <use ui="Menu" id="scene-increment">
    <use ui="MenuGroup">Grid Increment</use>
    <use ui="MenuItem" data-for="step, i : scene.increments" data-alias-item="step" data-event-click="emit('scene.increment', i)"></use>
  </use>
</div>
<button class="btn icon-only" data-if="scene.mode == 0" data-attr-data-tip="commands.frame.label" data-attr-data-kbd="commands.frame.shortcut" data-attrif-data-disabled="!commands.frame.enabled" data-event-click="emit('studio.frame')"><span class="icon">{{ commands.frame.icon }}</span></button>
/* Base UI Radio Group as a segmented control, Blender's expanded enum. Each
   option is <label><input type="radio" data-checked="save.key" value="v"/>
   <span class="face">Label</span></label>; the radio takes focus, Left and
   Right move between options, and Enter or Space chooses. */
body { display: flex; }
.segmented-control {
  display: flex; height: var(--h); padding: 2dp; gap: 2dp;
  background-color: var(--secondary); border-radius: var(--r);
}
label { position: relative; display: flex; flex: 1 1 auto; cursor: pointer; }
input { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; opacity: 0; nav: auto; cursor: pointer; }
.face {
  display: flex; align-items: center; justify-content: center; flex: 1 1 auto;
  padding: 0dp 10dp; border-radius: 3dp; border: 1dp transparent; white-space: nowrap;
  color: var(--muted-foreground); transition: background-color color 0.11s cubic-out;
}
label:hover .face { color: var(--foreground); background-color: var(--field-hover); }
input:checked ~ .face, label:hover input:checked ~ .face {
  background-color: var(--primary); color: var(--primary-foreground);
}
input:focus-visible ~ .face { border-color: var(--ring); }
input:checked:focus-visible ~ .face { border-color: var(--primary-foreground); }
<div class="segmented-control"><slot/></div>
/* Base UI Select over RmlUi's select, as shadcn's Native Select wraps the
   browser's: the use's child is the <select> with its options and binding,
   as <select data-value="save.quality"><option value="low">Low</option>.
   The trigger shows the chosen option, Enter opens the list, Up and Down
   choose in it, and a press outside closes it. */
body { display: flex; }
.select-root { position: relative; display: flex; min-width: 140dp; }
select {
  display: block; flex: 1 1 auto; height: var(--h); padding: 0dp 26dp 0dp 8dp;
  background-color: var(--secondary); border: 1dp var(--input); border-radius: var(--r);
  color: var(--foreground); nav: auto; cursor: pointer;
  transition: background-color 0.11s cubic-out;
}
select:hover { background-color: var(--field-hover); }
select:focus-visible { border-color: var(--ring); }
select selectvalue { height: var(--text-line); line-height: var(--text-line); white-space: nowrap; }
select selectarrow { width: 0dp; height: 0dp; }
.caret {
  position: absolute; right: 6dp; top: 0dp; height: var(--h); line-height: var(--h);
  font-size: var(--studio-font-12, 12dp); color: var(--faint-foreground); pointer-events: none;
}
select selectbox {
  margin-top: 4dp; padding: 4dp; max-height: var(--dropdown-box-h, 192dp); overflow-y: auto;
  background-color: var(--popover); border: 1dp var(--popover-edge); border-radius: var(--r-lg);
}
select selectbox option {
  display: block; height: var(--h); line-height: var(--h); padding: 0dp 8dp;
  border-radius: var(--r); color: var(--foreground); white-space: nowrap;
}
select selectbox option:checked { color: var(--primary-text); font-weight: 600; }
select selectbox option:hover { background-color: var(--primary); color: var(--primary-foreground); }
<div class="select-root"><slot/><span class="icon caret">&#xeab4;</span></div>
/* One setting, as a VS Code or macOS settings row: its label, a
   description, its control (the use's children) and Reset. Alias the
   setting as data-alias-setting: an object with label, description, value,
   default and modified. A modified setting shows the override mark and
   Reset, which puts its default back. */
.setting {
  position: relative; display: flex; align-items: center; gap: 16dp;
  padding: 7dp 8dp 7dp 16dp; border-bottom: 1dp var(--line);
}
.setting:hover { background-color: color-mix(in srgb, var(--foreground) 2%, transparent); }
.setting-text { flex: 1 1 0dp; display: flex; flex-direction: column; gap: 2dp; }
.setting-label { position: relative; color: var(--foreground); font-weight: 500; }
.setting-dot {
  position: absolute; left: -11dp; top: 5dp; width: 6dp; height: 6dp; border-radius: 3dp;
  background-color: var(--override); visibility: hidden;
}
.setting.modified .setting-dot { visibility: visible; }
.setting-description { color: var(--muted-foreground); font-size: var(--studio-font-11, 11dp); line-height: var(--studio-line-15, 15dp); }
.setting-control { flex: 0 0 auto; display: flex; align-items: center; justify-content: flex-end; gap: 8dp; }
.setting-control .select-root { min-width: 190dp; }
.setting-reset { visibility: hidden; nav: auto; }
.setting.modified .setting-reset { visibility: visible; }

@media (max-width: 1000dp) {
  .setting { flex-direction: column; align-items: stretch; gap: 8dp; }
  .setting-text { flex: 0 0 auto; }
  .setting-control { justify-content: flex-start; flex-wrap: wrap; }
}
<div class="setting" data-class-modified="setting.modified">
  <div class="setting-text">
    <div class="setting-label"><span class="setting-dot"/>{{ setting.label }}</div>
    <div class="setting-description">{{ setting.description }}</div>
  </div>
  <div class="setting-control"><slot/></div>
  <span class="btn icon-only sm setting-reset" data-event-click="setting.value = setting.default"><span class="icon">&#xeae2;</span></span>
</div>
/* The Settings page: Editor and Project tabs, a category sidebar with
   search, and a row per setting (studio_sources.c's `settings`). */
.settings { display: flex; flex-direction: column; flex: 1 1 auto; }
.head {
  display: flex; align-items: center; flex: 0 0 auto; height: var(--panel-h); padding: 0dp 12dp 0dp 16dp;
  border-bottom: 1dp var(--line);
}
.head-side { display: flex; align-items: center; gap: 8dp; flex: 1 1 0dp; }
.head-side.end { justify-content: flex-end; }
.head-title { font-size: var(--studio-font-13, 13dp); font-weight: 600; color: var(--foreground); }
.head input { nav: horizontal; }
.body { display: flex; flex: 1 1 0dp; }
.aside {
  display: flex; flex-direction: column; gap: 10dp; flex: 0 0 auto; width: 216dp; padding: 12dp 10dp;
  background-color: var(--rail); border-right: 1dp var(--line);
}
.search { position: relative; display: flex; }
.search .lead {
  position: absolute; left: 7dp; top: 0dp; height: var(--h); line-height: var(--h); font-size: var(--studio-font-13, 13dp);
  color: var(--faint-foreground); pointer-events: none;
}
.search-input {
  display: block; flex: 1 1 auto; height: var(--h); padding: var(--input-pad) 24dp var(--input-pad) 27dp;
  line-height: var(--input-line); color: var(--foreground); cursor: text; nav: vertical;
  background-color: var(--field-edit); border: 1dp var(--border); border-radius: var(--r);
}
.search-input:hover { background-color: var(--input-hover); }
.search-input:focus { border-color: var(--ring); }
.search-input:placeholder-shown { color: var(--faint-foreground); }
.search-input selection { background-color: var(--primary); color: var(--primary-foreground); }
.search .clear {
  position: absolute; right: 3dp; top: 50%; width: 16dp; height: 16dp; line-height: 16dp;
  text-align: center; border-radius: 3dp; cursor: pointer;
  transform: translateY(-50%);
}
.search .clear .icon { font-size: 12dp; width: 16dp; line-height: 16dp; }
.search .clear:hover { background-color: var(--press); }
.searching .nav-item input:checked ~ .nav-face { background-color: transparent; }
.aside-foot { margin-top: auto; padding: 0dp 8dp; font-size: var(--studio-font-12, 12dp); line-height: var(--studio-line-18, 18dp); color: var(--muted-foreground); }
.main { flex: 1 1 0dp; overflow-y: auto; padding: 16dp 24dp 24dp 24dp; }
.page-head { display: flex; align-items: center; gap: 8dp; height: var(--panel-h); margin: 0dp 0dp 6dp 16dp; }
.page-title { font-size: var(--studio-font-16, 16dp); line-height: var(--studio-line-20, 20dp); font-weight: 600; color: var(--foreground); }
.row-slot { display: block; }
.group {
  margin: 18dp 0dp 4dp 16dp; padding-bottom: 4dp; font-size: var(--studio-font-12, 12dp); line-height: var(--studio-line-18, 18dp);
  font-weight: 600; color: var(--muted-foreground); border-bottom: 1dp var(--line);
}
.range { display: flex; align-items: center; gap: 10dp; }
/* A text setting is outlined as the search is, on the page's own fill, and
   has a width a select's content gives it. */
.text-control { display: flex; width: 180dp; }
.text-control .field { border-color: var(--border); }
/* The number sits before its slider, so controls end in one column and
   Up and Down move straight between them. */
.readout { width: 24dp; text-align: right; font-family: var(--font-numeric); color: var(--muted-foreground); }
.keys { display: flex; align-items: center; gap: 4dp; }
.key {
  min-width: 20dp; height: var(--studio-height-20, 20dp); line-height: var(--studio-line-19, 19dp); padding: 0dp 6dp; text-align: center; font-size: var(--studio-font-11, 11dp);
  color: var(--foreground); background-color: var(--secondary); border-radius: 4dp;
  border-bottom: 1dp color-mix(in srgb, var(--foreground) 14%, transparent); font-family: "JetBrains Mono";
}
.keys .none { color: var(--faint-foreground); }
.empty { display: flex; flex-direction: column; align-items: center; gap: 6dp; padding: 56dp 0dp; }
.empty-icon { font-size: var(--studio-font-28, 28dp); line-height: var(--studio-line-32, 32dp); width: var(--studio-height-32, 32dp); color: var(--disabled-foreground); }
.empty-title { font-size: var(--studio-font-13, 13dp); font-weight: 600; color: var(--foreground); }
.empty-hint { color: var(--muted-foreground); margin-bottom: 8dp; }

.shortcut { display: flex; flex-direction: column; align-items: flex-end; gap: 4dp; max-width: 300dp; }
.shortcut .keys { flex-wrap: wrap; justify-content: flex-end; }
.shortcut-context, .shortcut-aliases { font-size: var(--studio-font-11, 11dp); color: var(--faint-foreground); }
.shortcut-aliases { font-family: var(--font-numeric); }
.shortcut-conflict { display: flex; align-items: center; gap: 4dp; font-size: var(--studio-font-11, 11dp); color: var(--warning); }
.shortcut-conflict .icon { font-size: var(--studio-font-12, 12dp); }
/* The conflict count searches for them. */
.badge.warning { color: var(--warning); background-color: color-mix(in srgb, var(--warning) 16%, transparent); cursor: pointer; }
.recording { color: var(--primary); }

/* Keep descriptions and controls readable in narrow or magnified windows. */
@media (max-width: 1000dp) {
  .aside { width: 180dp; }
  .main { padding: 12dp 16dp 20dp; }
}
<use ui="Dialog" class="window" data-keys="Escape:Close">
  <div class="settings">
    <div class="head">
      <div class="head-side">
        <span class="icon">&#xeaf8;</span>
        <span class="head-title">Settings</span>
      </div>
      <use ui="Segmented" class="scope">
        <label><input type="radio" data-checked="settings.scope" value="editor"/><span class="face">Editor</span></label>
        <label><input type="radio" data-checked="settings.scope" value="project"/><span class="face">Project</span></label>
      </use>
      <div class="head-side end">
        <span class="btn icon-only close" data-event-click="emit('Close')"><span class="icon">&#xea76;</span></span>
      </div>
    </div>
    <div class="body">
      <div class="aside">
        <div class="search">
          <span class="icon lead">&#xea6d;</span>
          <input type="text" class="search-input" placeholder="Search settings" data-value="settings.query" autofocus/>
          <span class="clear" data-if="settings.query != ''" data-event-click="settings.query = ''"><span class="icon">&#xea76;</span></span>
        </div>
        <use ui="SidebarNav" data-keys="Up:NavPrevious Down:NavNext" data-event-click="settings.query = ''" data-class-searching="settings.query != ''">
          <label class="nav-item" data-for="item : settings.categories" data-if="!item.hidden" data-class-dim="item.dim">
            <input type="radio" data-checked="settings.category" data-attr-value="item.id"/>
            <span class="nav-face">
              <span class="icon">{{ item.icon }}</span>
              <span class="label">{{ item.label }}</span>
              <span class="count" data-if="item.badge != ''">{{ item.badge }}</span>
              <span class="dot" data-if="item.dot &amp;&amp; item.badge == ''"/>
            </span>
          </label>
        </use>
        <div class="aside-foot">Changes save as you make them.</div>
      </div>
      <div class="main">
        <div class="page-head">
          <span class="page-title" data-if="settings.query == ''">{{ settings.title }}</span>
          <span class="page-title" data-if="settings.query != ''">Search Results</span>
          <span class="badge accent" data-if="settings.query != ''">{{ settings.matches }}</span>
          <span class="badge" data-if="settings.scope == 'project'">{{ settings.project }}</span>
          <span class="badge warning conflicts" data-if="settings.category == 'keyboard' &amp;&amp; settings.query == '' &amp;&amp; settings.conflicts &gt; 0" data-event-click="settings.query = 'conflict'">{{ settings.conflicts }} conflicting</span>
        </div>
        <div class="row-slot" data-for="row : settings.rows" data-if="row.shown">
          <div class="group" data-if="row.head">{{ row.group }}</div>
          <use ui="SettingRow" data-alias-setting="row">
            <div data-when="row.control == 'bool'"><use ui="Switch" data-checked="row.value" value="true"/></div>
            <div data-when="row.control == 'choice'">
              <use ui="Segmented" data-when="row.type == 'choice' &amp;&amp; row.choices.size &lt;= 3">
                <label data-for="choice : row.choices"><input type="radio" data-checked="row.value" data-attr-value="choice.value"/><span class="face">{{ choice.label }}</span></label>
              </use>
              <div data-when="row.type != 'choice' || row.choices.size &gt; 3">
                <use ui="Select">
                  <select data-value="row.value">
                    <option data-for="choice : row.choices" data-attr-value="choice.value">{{ choice.label }}</option>
                  </select>
                </use>
              </div>
            </div>
            <div class="range" data-when="row.control == 'range'">
              <span class="readout">{{ row.value }}</span>
              <use ui="Slider" data-value="row.position" min="0" max="1" data-attr-step="row.tick"/>
            </div>
            <div class="text-control" data-when="row.control == 'text'"><use ui="TextField" data-alias-text="row.value"/></div>
            <div class="shortcut" data-if="row.type == 'shortcut'">
              <div class="keys">
                <span class="key" data-for="key : row.keys">{{ key }}</span>
                <span class="none" data-if="row.keys.size == 0">Unassigned</span>
                <button class="btn outline sm record-shortcut" data-if="!row.indexed &amp;&amp; !row.recording" data-event-click="emit('settings.record', row.key)">Record</button>
                <span class="recording" data-if="row.recording">Press a key combination. Esc cancels.</span>
              </div>
              <span class="shortcut-aliases" data-if="row.aliases != ''">{{ row.aliases }}</span>
              <span class="shortcut-context">{{ row.context }}</span>
              <span class="shortcut-conflict" data-if="row.conflict != ''"><span class="icon">&#xea6c;</span>{{ row.conflict }}</span>
            </div>
          </use>
        </div>
        <div class="empty" data-if="settings.matches == 0">
          <span class="icon empty-icon">&#xea6d;</span>
          <div class="empty-title">No settings found</div>
          <div class="empty-hint">Try another word, or clear the search.</div>
          <span class="btn outline" data-event-click="settings.query = ''">Clear Search</span>
        </div>
      </div>
    </div>
  </div>
</use>
/* Keyboard Shortcuts: a search over every key Studio takes, an area per
   group in two columns (studio_keymap.c's `shortcuts`). */
.shortcuts { display: flex; flex-direction: column; flex: 1 1 auto; }
.head {
  display: flex; align-items: center; gap: 12dp; flex: 0 0 auto; height: var(--panel-h); padding: 0dp 12dp 0dp 16dp;
  border-bottom: 1dp var(--line);
}
.head-side { display: flex; align-items: center; gap: 8dp; flex: 1 1 0dp; }
.head-side.end { justify-content: flex-end; }
.head-title { font-size: var(--studio-font-13, 13dp); font-weight: 600; color: var(--foreground); }
.search { position: relative; display: flex; flex: 0 0 auto; width: 320dp; }
.search .lead {
  position: absolute; left: 7dp; top: 0dp; height: var(--h); line-height: var(--h); font-size: var(--studio-font-13, 13dp);
  color: var(--faint-foreground); pointer-events: none;
}
.search-input {
  display: block; flex: 1 1 auto; height: var(--h); padding: var(--input-pad) 24dp var(--input-pad) 27dp;
  line-height: var(--input-line); color: var(--foreground); cursor: text;
  background-color: var(--field-edit); border: 1dp var(--border); border-radius: var(--r);
}
.search-input:hover { background-color: var(--input-hover); }
.search-input:focus { border-color: var(--ring); }
.search-input:placeholder-shown { color: var(--faint-foreground); }
.search-input selection { background-color: var(--primary); color: var(--primary-foreground); }
.search .clear {
  position: absolute; right: 3dp; top: 50%; width: 16dp; height: 16dp; line-height: 16dp;
  text-align: center; border-radius: 3dp; cursor: pointer; transform: translateY(-50%);
}
.search .clear .icon { font-size: 12dp; width: 16dp; line-height: 16dp; }
.search .clear:hover { background-color: var(--press); }
.sheet {
  display: flex; flex-wrap: wrap; align-content: flex-start; flex: 1 1 0dp; overflow-y: auto;
  padding: 8dp 12dp 16dp 12dp;
}
.section { box-sizing: border-box; width: 50%; padding: 8dp 12dp; }
.heading {
  margin-bottom: 4dp; padding-bottom: 4dp; font-size: var(--studio-font-12, 12dp); line-height: var(--studio-line-18, 18dp);
  font-weight: 600; color: var(--muted-foreground); border-bottom: 1dp var(--line);
}
.binding { display: flex; align-items: center; gap: 12dp; min-height: var(--row); }
.action { flex: 1 1 auto; color: var(--foreground); line-height: var(--studio-line-18, 18dp); }
.chords { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 4dp; flex: 0 0 auto; max-width: 60%; }
.chord {
  min-width: 20dp; height: var(--studio-height-20, 20dp); line-height: var(--studio-line-19, 19dp); padding: 0dp 6dp; text-align: center; font-size: var(--studio-font-11, 11dp);
  color: var(--foreground); background-color: var(--secondary); border-radius: 4dp;
  border-bottom: 1dp color-mix(in srgb, var(--foreground) 14%, transparent); font-family: "JetBrains Mono";
}
.empty { display: flex; flex-direction: column; align-items: center; gap: 6dp; width: 100%; padding: 56dp 0dp; }
.empty-icon { font-size: var(--studio-font-28, 28dp); line-height: var(--studio-line-32, 32dp); width: var(--studio-height-32, 32dp); color: var(--disabled-foreground); }
.empty-title { font-size: var(--studio-font-13, 13dp); font-weight: 600; color: var(--foreground); }
.empty-hint { color: var(--muted-foreground); }
.foot {
  display: flex; align-items: center; justify-content: space-between; flex: 0 0 auto; height: var(--panel-h);
  padding: 0dp 12dp 0dp 16dp; border-top: 1dp var(--line);
}
.foot .hint { color: var(--muted-foreground); }

/* One column where two would cramp the actions. */
@media (max-width: 900dp) {
  .section { width: 100%; }
  .search { width: 220dp; }
}
<use ui="Dialog" class="window" data-keys="Escape:Close">
  <div class="shortcuts">
    <div class="head">
      <div class="head-side">
        <span class="icon">&#xf097b;</span>
        <span class="head-title">Keyboard Shortcuts</span>
      </div>
      <div class="search">
        <span class="icon lead">&#xea6d;</span>
        <input type="text" class="search-input" placeholder="Search keys and actions" data-value="shortcuts.query" autofocus/>
        <span class="clear" data-if="shortcuts.query != ''" data-event-click="shortcuts.query = ''"><span class="icon">&#xea76;</span></span>
      </div>
      <div class="head-side end">
        <span class="btn icon-only close" data-event-click="emit('Close')"><span class="icon">&#xea76;</span></span>
      </div>
    </div>
    <div class="sheet">
      <div class="section" data-for="group : shortcuts.groups">
        <div class="heading">{{ group.label }}</div>
        <div class="binding" data-for="row : group.rows">
          <span class="action">{{ row.label }}</span>
          <span class="chords"><span class="chord" data-for="key : row.keys">{{ key }}</span></span>
        </div>
      </div>
      <div class="empty" data-if="shortcuts.matches == 0">
        <span class="icon empty-icon">&#xea6d;</span>
        <div class="empty-title">No shortcuts found</div>
        <div class="empty-hint">Try another word, or clear the search.</div>
      </div>
    </div>
    <div class="foot">
      <span class="hint">Keys act on the area under the pointer.</span>
      <span class="btn outline sm" data-event-click="emit('Close'); settings.scope = 'editor'; settings.category = 'keyboard'; settings.query = ''; emit('studio.settings')">Change Shortcuts…</span>
    </div>
  </div>
</use>
/* A settings sidebar, as VS Code's table of contents and macOS's Settings.
   Each item is <label class="nav-item"><input type="radio" .../><span
   class="nav-face">icon, label, count</span></label>; its radio takes
   focus. Bind data-keys="Up:NavPrevious Down:NavNext" on the use and give
   the entity NavKeys, so the arrows choose as they move. */
.sidebar-nav { display: flex; flex-direction: column; gap: 1dp; }
.nav-item { position: relative; display: flex; cursor: pointer; }
.nav-item input { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; opacity: 0; nav: none; cursor: pointer; }
.nav-face {
  display: flex; align-items: center; gap: 8dp; flex: 1 1 auto; height: var(--row); padding: 0dp 8dp;
  border-radius: var(--r); border: 1dp transparent; color: var(--muted-foreground); white-space: nowrap;
  transition: background-color color 0.11s cubic-out;
}
.nav-face .label { flex: 1 1 auto; }
.nav-item:hover .nav-face { background-color: var(--accent); color: var(--foreground); }
.nav-item input:checked ~ .nav-face { background-color: var(--selected); color: var(--foreground); }
.nav-item input:checked ~ .nav-face .icon { color: var(--primary-text); }
.nav-item input:focus-visible ~ .nav-face { border-color: var(--ring); }
.nav-item.dim .nav-face, .nav-item.dim input:checked ~ .nav-face { color: var(--disabled-foreground); }
.nav-item.dim .nav-face .icon, .nav-item.dim input:checked ~ .nav-face .icon { color: var(--disabled-foreground); }
.nav-face .count {
  height: var(--studio-height-16, 16dp); line-height: var(--studio-line-16, 16dp); padding: 0dp 5dp; border-radius: 8dp; font-size: var(--studio-font-10, 10dp);
  color: var(--primary-text); background-color: var(--primary-soft);
}
.nav-face .dot { width: 6dp; height: 6dp; border-radius: 3dp; background-color: var(--override); }
<nav class="sidebar-nav"><slot/></nav>
/* Base UI Slider over RmlUi's range input (shadcn's anatomy): a track, the
   range filled up to the value, and a thumb. Left and Right step it; bind it
   as an input: data-value="save.volume" min="0" max="1" step="0.1". Keep
   min and max fixed: a range input clamps its value when they change. */
body { display: flex; align-items: center; }
.slider { display: block; width: 140dp; height: 16dp; nav: auto; cursor: pointer; }
.slider slidertrack {
  margin-top: 6dp; height: 4dp; border-radius: 2dp;
  background-color: color-mix(in srgb, var(--foreground) 16%, transparent);
}
/* The range sits on the track: its height and offset follow the track's. */
.slider sliderprogress { border-radius: 2dp; background-color: var(--primary); }
.slider sliderbar {
  width: 14dp; height: 14dp; margin-top: 1dp; margin-left: -7dp; margin-right: -7dp;
  border-radius: 7dp; background-color: #ffffff; border: 1dp var(--primary);
  transition: border-color 0.11s cubic-out;
}
.slider sliderbar:hover, .slider sliderbar:active { border-color: var(--primary-hover); }
.slider:focus-visible sliderbar { border: 2dp var(--ring); }
.slider sliderarrowdec, .slider sliderarrowinc { width: 0dp; height: 0dp; }
<input type="range" class="slider" attrs/>
/* The native <splitter>: dragging moves its value along axis="x" or "y",
   within min and max (invert moves it against the pointer); input runs
   while it drags and change once when it is released. */
.splitter { display: block; flex: 0 0 auto; width: 6dp; border-radius: 3dp; }
.splitter[axis=y] { width: auto; height: 6dp; }
.splitter:hover, .splitter[data-dragging] { background-color: var(--primary-wash); }
<splitter class="splitter" attrs></splitter>
/* Studio's status bar (studio_shell.c hosts it; studio_sources.c binds
   `editor` and `commands`): the hovered area's key hints, the last
   operation's report (a warning when it kept something from happening), the drawer toggles, which run and read their
   commands, the scene's stats and UI Scale's menu (`shell.scale`). The report comes and goes with presence and morphs with
   <morph-text>; the counts roll with <number-flow>. */
body { flex: 0 0 auto; }
.statusbar {
  height: var(--status-h); display: flex; align-items: center; gap: 12dp; padding: 0dp 10dp;
  background-color: var(--app); color: var(--muted-foreground);
  font-size: var(--studio-font-12, 12dp); white-space: nowrap;
}
.statusbar.live { background-color: color-mix(in srgb, var(--primary) 14%, var(--app)); }
// Hints give way first when the window narrows.
.hints { display: flex; align-items: center; gap: 10dp; flex: 0 1 auto; min-width: 0dp; overflow: hidden; }
// The report's area takes the free space, so a report coming or going moves nothing.
.report-area {
  flex: 1 1 0dp; min-width: 0dp; overflow: hidden; display: flex; align-items: center; justify-content: center;
}
.report {
  display: flex; align-items: center; gap: 6dp; color: var(--foreground); transition: opacity 0.2s cubic-out;
  &[data-starting-style], &[data-ending-style] { opacity: 0; }
  .icon { color: var(--success); font-size: 12dp; }
  &.warning .icon { color: var(--warning); }
}
.drawers { display: flex; align-items: center; gap: 2dp; flex-shrink: 0; }
.toggle-drawer {
  color: var(--faint-foreground);
  .icon { font-size: 12dp; width: 14dp; }
  &[data-state=on] { background-color: var(--selected); color: var(--foreground); }
  &[data-state=on] .icon { color: var(--primary-text); }
}
.stats { display: flex; gap: 10dp; flex-shrink: 0; color: var(--faint-foreground); font-family: var(--font-numeric); }
.stats .strong { color: var(--muted-foreground); }
.count { display: block; white-space: nowrap; line-height: var(--studio-line-16, 16dp); }
#ui-scale { display: flex; flex-shrink: 0; }
.ui-scale { color: var(--faint-foreground); font-family: var(--font-numeric); }

@media (max-width: 900dp) {
  .toggle-drawer .label { display: none; }
}
<div class="statusbar" data-class-live="editor.playing">
  <div class="hints"><use ui="KeyHint" data-for="hint : editor.hints"/></div>
  <div class="report-area"><div class="report" data-if="editor.reporting" data-class-warning="editor.warning" presence><span class="icon" data-if="!editor.warning">&#xeab2;</span><span class="icon" data-if="editor.warning">&#xea6c;</span><morph-text>{{ editor.report }}</morph-text></div></div>
  <div class="drawers">
    <button class="btn sm toggle-drawer" data-attr-data-tip="commands.toggleAssets.menu" data-attr-data-kbd="commands.toggleAssets.shortcut" data-attr-data-state="commands.toggleAssets.checked ? 'on' : 'off'" data-event-click="emit('studio.toggleAssets')"><span class="icon">{{ commands.toggleAssets.icon }}</span><span class="label">{{ commands.toggleAssets.menu }}</span></button>
    <button class="btn sm toggle-drawer" data-attr-data-tip="commands.toggleOutput.menu" data-attr-data-kbd="commands.toggleOutput.shortcut" data-attr-data-state="commands.toggleOutput.checked ? 'on' : 'off'" data-event-click="emit('studio.toggleOutput')"><span class="icon">{{ commands.toggleOutput.icon }}</span><span class="label">{{ commands.toggleOutput.menu }}</span></button>
    <button class="btn sm toggle-drawer" data-attr-data-tip="commands.togglePerformance.menu" data-attr-data-kbd="commands.togglePerformance.shortcut" data-attr-data-state="commands.togglePerformance.checked ? 'on' : 'off'" data-event-click="emit('studio.togglePerformance')"><span class="icon">{{ commands.togglePerformance.icon }}</span><span class="label">{{ commands.togglePerformance.menu }}</span></button>
  </div>
  <div class="stats">
    <span class="strong">{{ editor.scene }}</span>
    <span data-class-strong="editor.selection != ''">{{ editor.selection != '' ? editor.selection : 'No selection' }}</span>
    <span class="count objects">Objects <number-flow data-attr-value="editor.selected"/>/<number-flow data-attr-value="editor.objects"/></span>
    <span class="count speed strong" data-if="editor.speed != ''" data-attr-data-tip="commands.normalSpeed.label" data-attr-data-kbd="commands.normalSpeed.shortcut" data-event-click="emit('studio.normalSpeed')">{{ editor.speed }}</span>
    <span class="count hidden-objects" data-if="editor.hidden > 0" data-attr-data-tip="commands.showAll.label" data-attr-data-kbd="commands.showAll.shortcut" data-event-click="emit('studio.showAll')"><number-flow data-attr-value="editor.hidden"/> hidden</span>
  </div>
  <div id="ui-scale">
    <button class="btn sm ui-scale" popovertarget="scale-menu" aria-haspopup="menu" data-tip="UI Scale"><span class="label">{{ shell.scale.label }}</span></button>
    <use ui="Menu" id="scale-menu">
      <use ui="MenuGroup">UI Scale</use>
      <use ui="MenuCommand" data-alias-command="commands.zoomIn"/>
      <use ui="MenuCommand" data-alias-command="commands.zoomOut"/>
      <use ui="MenuCommand" data-alias-command="commands.zoomReset"/>
      <use ui="MenuSeparator"/>
      <use ui="MenuItem" data-for="preset, i : shell.scale.presets" data-alias-item="preset" data-event-click="emit('shell.scale', i)"/>
    </use>
  </div>
</div>
/* The Studio scene's page, and so the editor's theme: shadcn/ui's tokens,
   the editor's roles derived from them, and the control styles every Studio
   document shares, in import order. Ported from
   docs/prototypes/studio/kit.css; differences from the web source: dp units,
   seconds for durations, named tweens, borders without a style keyword, and
   no outline. Documents size and paint their own body. */
@import "theme/base.rcss";
@import "theme/tokens.rcss";
@import "theme/roles.rcss";
@import "theme/presets.rcss";
@import "theme/button.rcss";
@import "theme/field.rcss";
@import "theme/panel.rcss";
@import "theme/popup.rcss";
@import "theme/command.rcss";
@import "theme/tree.rcss";
@import "theme/toast.rcss";
@import "theme/motion.rcss";
@import "theme/list.rcss";
@import "theme/code.rcss";
@import "theme/drag.rcss";
@import "theme/chart.rcss";
@import "theme/inspect.rcss";
@import "theme/workspace.rcss";
@import "theme/assets.rcss";
@import "Properties.rcss";
@import "theme/graph.rcss";
<body data-class-dark="(save.theme == 'system' &amp;&amp; system.dark) || (save.theme != 'system' &amp;&amp; save.theme != 'light' &amp;&amp; save.theme != 'solarized-light' &amp;&amp; save.theme != 'tokyo-day' &amp;&amp; save.theme != 'catppuccin-latte' &amp;&amp; save.theme != 'rose-pine-dawn' &amp;&amp; save.theme != 'gruvbox-light')"
      data-class-comfortable="save.density == 'comfortable'"
      data-class-theme-dracula="save.theme == 'dracula'"
      data-class-theme-solarized-light="save.theme == 'solarized-light'"
      data-class-theme-solarized-dark="save.theme == 'solarized-dark'"
      data-class-theme-tokyo-night="save.theme == 'tokyo-night'"
      data-class-theme-tokyo-storm="save.theme == 'tokyo-storm'"
      data-class-theme-tokyo-day="save.theme == 'tokyo-day'"
      data-class-theme-catppuccin-latte="save.theme == 'catppuccin-latte'"
      data-class-theme-catppuccin-frappe="save.theme == 'catppuccin-frappe'"
      data-class-theme-catppuccin-macchiato="save.theme == 'catppuccin-macchiato'"
      data-class-theme-catppuccin-mocha="save.theme == 'catppuccin-mocha'"
      data-class-theme-rose-pine="save.theme == 'rose-pine'"
      data-class-theme-rose-pine-moon="save.theme == 'rose-pine-moon'"
      data-class-theme-rose-pine-dawn="save.theme == 'rose-pine-dawn'"
      data-class-theme-gruvbox-light="save.theme == 'gruvbox-light'"
      data-class-theme-gruvbox-dark="save.theme == 'gruvbox-dark'"><slot/></body>
/* A line of the Styles pane: an ancestor whose rules follow, a rule with
   where it was declared, or one of its declarations. */
body { display: block; }
.ancestor { display: block; margin-top: 12dp; font-size: var(--studio-font-11, 11dp); color: var(--muted-foreground); }
.rule { display: flex; align-items: center; gap: 8dp; margin-top: 6dp; padding-top: 4dp; border-top: 1dp var(--line); }
.selector { flex: 1 1 0dp; color: var(--foreground); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.origin { flex: 0 0 auto; font-size: var(--studio-font-10, 10dp); color: var(--faint-foreground); }
.origin.link { color: var(--link); cursor: pointer; }
.origin.link:hover { text-decoration: underline; }
.declaration { display: block; padding-left: 12dp; min-height: 18dp; line-height: var(--studio-line-18, 18dp); word-break: break-all; }
.declaration .name { color: var(--tok-name); }
.declaration .colon { margin-right: 4dp; color: var(--faint-foreground); }
.declaration .value { color: var(--foreground); }
<div class="ancestor" data-if="line.ancestor">{{ line.selector }}</div>
<div class="rule" data-if="line.heading && !line.ancestor">
  <span class="selector">{{ line.selector }}</span>
  <span class="origin" data-class-link="line.linked" data-event-click="inspector.rule = i">{{ line.origin }}</span>
</div>
<div class="declaration" data-if="!line.heading">
  <span class="name">{{ line.name }}</span><span class="colon">:</span><span class="value">{{ line.value }}</span>
</div>
/* A menu row that opens the use's children as a menu beside it, after a
   100 ms hover, a click or Right (Base UI's SubmenuTrigger); Left closes
   it. Alias the row as data-alias-item: an object with label and icon.
   RmlUi places a fixed box against its nearest positioned ancestor, so the
   submenu sits in a room as wide as a menu may grow, as Menu does, and fits
   its widest row rather than its parent menu's width. Its items are built
   when it opens, as Menu's are. */
body { display: block; }
.menu-item { height: var(--menu-row-h); }
.chev { color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); }
.room { position: absolute; width: 480dp; height: 0dp; }
<div class="submenu" attrs><div class="menu-item" role="menuitem" aria-haspopup="menu" popovertarget="submenu"><span class="icon lead">{{ item.icon }}</span><span class="text"><span class="label">{{ item.label }}</span></span><span class="icon chev">&#xeab6;</span></div><div class="room"><div class="popup menu" popover data-template role="menu" id="submenu"><slot/></div></div></div>
/* Base UI Switch: the checkbox takes focus and clicks; the track and thumb
   follow its checked state. Bind it as a checkbox: data-checked="save.sound". */
.switch { position: relative; display: inline-block; width: 28dp; height: 16dp; cursor: pointer; }
.switch input { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; opacity: 0; nav: auto; cursor: pointer; }
.track {
  position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; border-radius: 8dp;
  background-color: color-mix(in srgb, var(--foreground) 20%, transparent); border: 1dp transparent;
  transition: background-color border-color 0.14s cubic-out;
}
.thumb {
  position: absolute; left: 1dp; top: 1dp; width: 12dp; height: 12dp; border-radius: 6dp;
  background-color: #ffffff; transition: transform 0.14s cubic-out;
}
.switch:hover .track { background-color: color-mix(in srgb, var(--foreground) 28%, transparent); }
.switch input:checked ~ .track { background-color: var(--primary); }
.switch:hover input:checked ~ .track { background-color: var(--primary-hover); }
.switch input:checked ~ .track .thumb { transform: translateX(12dp); }
.switch input:focus-visible ~ .track { border-color: var(--ring); }
.switch input:disabled ~ .track { opacity: 0.45; }
<label class="switch"><input type="checkbox" attrs/><span class="track"><span class="thumb"/></span></label>
body { display: flex; flex: 1 1 0dp; }
<div class="field text"><input type="text" class="value" data-value-lazy="text"/></div>
.panel-head .badge { margin-left: auto; }
.empty { display: block; padding: 12dp 0dp; color: var(--faint-foreground); text-align: center; }
/* A color token is text, any CSS color, beside a swatch of it. */
.swatched .swatch {
  flex: 0 0 auto; width: 14dp; height: 14dp; margin-left: 4dp;
  border-radius: 3dp; border: 1dp var(--border);
}
.swatched input.value { padding-left: 5dp; }
<div class="panel" data-open="" data-for="section : theme.sections">
  <div class="panel-head">
    <span class="title">{{ section.file }}</span>
    <span class="badge">{{ section.selector }}</span>
  </div>
  <div class="panel-body">
    <div class="prop" data-for="row : section.rows">
      <div class="label">{{ row.name }}</div>
      <div class="control">
        <div class="field text swatched" data-if="row.color">
          <span class="swatch" data-style-background-color="row.value"/>
          <input type="text" class="value" data-value-lazy="row.value"/>
        </div>
        <use ui="TextField" data-if="!row.color" data-alias-text="row.value"/>
      </div>
    </div>
  </div>
</div>
<div class="empty" data-if="theme.sections.size == 0">No theme</div>
/* An asset's tile, as Assets' grid shows one: its picture over its name,
   its kind badged in the picture's corner, and until the picture is ready
   its kind's icon as a skeleton, with a spinner while more of it loads.
   Alias it as data-alias-tile: an object with key, label, icon and badge
   (glyphs), image (a texture source such as kit:thumb:..., "" until one is
   ready, drawn as a decorator so its arrival lays nothing out), loading,
   selected and unresolved. A panel whose selection changes often keeps it
   out of its tiles, as TreeRow's do: alias the selected key as
   data-alias-selection, from a variable of its own, which the tile
   compares with tile.key. Size the use; the tile fills it. Its look is the
   theme's .tile (theme/assets.rcss). */
body { display: block; }
.tile { width: 100%; height: 100%; }
<div class="tile" data-attrif-data-ready="tile.image != ''" data-attrif-data-loading="tile.loading" data-attrif-data-selected="tile.selected || (tile.key + '' != '' && tile.key + '' == selection + '')" data-attrif-data-unresolved="tile.unresolved">
  <div class="tile-art">
    <span class="icon glyph">{{ tile.icon }}</span>
    <span class="picture" data-style-decorator="tile.image == '' ? 'none' : 'image(' + tile.image + ')'"/>
    <span class="icon badge">{{ tile.badge }}</span>
    <span class="icon spin">&#xeb19;</span>
  </div>
  <span class="name">{{ tile.label }}</span>
</div>
/* Studio's top bar (studio_shell.c hosts it; studio_sources.c binds
   `editor` and `commands`, and studio_shell.c `menubar` and `shell`): the
   brand, the menubar, the document tabs, the transport with the play
   target's menu, a paused run's steps and the playback speed's menu,
   Collaboration, the layout menu and side pane, Settings and Search. Each
   button runs its command with emit('studio.<id>'), and a tab's with the
   tab's index. */
body { flex: 0 0 auto; }
.app-chrome { display: flex; flex-direction: column; flex: 0 0 auto; }
// The transport stays clear of the tabs as the window narrows.
.spacer { min-width: 12dp; }
.topbar {
  height: var(--topbar-h); display: flex; align-items: center; gap: 3dp; padding: 0dp 8dp;
  background-color: var(--app);
}
.brand {
  width: 22dp; height: 22dp; display: flex; align-items: center; justify-content: center;
  margin-right: 4dp; flex-shrink: 0;
}
.mark { width: 11dp; height: 11dp; border-radius: 3dp; background-color: var(--primary); transform: rotate(45deg); }
.menus { display: flex; flex: 0 0 auto; }
// A menubar trigger stays pressed while its menu is open.
.menus .trigger[data-popup-open] { background-color: var(--press); color: var(--foreground); transition: none; }
.btn { flex-shrink: 0; }
.trigger { color: var(--foreground); padding: 0dp 7dp; }
#layout { display: flex; align-items: center; flex: 0 0 auto; }
// The side pane's toggle shows its state by the icon alone, as VS Code's layout toggles do.
.btn.side-pane[data-state=on] { background-color: transparent; }
.btn.side-pane[data-state=on] .icon { color: var(--foreground); }
.btn.side-pane[data-state=off] .icon { color: var(--muted-foreground); }
.sep { width: 1dp; height: 14dp; background-color: var(--border); margin: 0dp 6dp; flex-shrink: 0; }
// Documents occupy their own row so the toolbar keeps every action in reach.
.doc-tabs {
  --tab-hover: color-mix(in srgb, var(--foreground) 5%, var(--app));
  --tab-close-hover: color-mix(in srgb, var(--foreground) 9%, var(--app));
  --tab-active-close-hover: color-mix(in srgb, var(--foreground) 9%, var(--background));
  display: flex; align-items: center; gap: 4dp; height: var(--header-h); flex: 0 0 auto;
  padding: 0dp 6dp 4dp;
  background-color: var(--app);
}
.doc-tab-list {
  display: flex; align-items: center; gap: 2dp; height: 100%; flex: 1 1 0dp;
  min-width: 0dp; overflow-x: auto; overflow-y: hidden;
}
.doc-tab-list scrollbarhorizontal { height: 0dp; }
// Equal tab widths keep document names and hover actions in predictable places.
.doc-tab {
  position: relative; display: flex; align-items: center; flex: 0 0 180dp;
  box-sizing: border-box; width: 180dp;
  height: 100%; padding: 0dp 2dp 0dp 0dp; color: var(--muted-foreground);
  border-radius: var(--r-lg);
  &:hover { color: var(--foreground); background-color: var(--tab-hover); }
  &[data-state=on] { background-color: var(--background); color: var(--foreground); }
  &[data-state=on] .face .icon { color: var(--primary-text); }
  &[data-pinned] .doc-pin { color: var(--primary-text); opacity: 1; }
}
.doc-tab .face {
  position: relative; flex: 1 1 0dp; min-width: 0dp; justify-content: flex-start;
  gap: 6dp; height: 100%; padding: 0dp 6dp 0dp 8dp;
  transition: none;
}
.doc-tab .face > .icon { flex: 0 0 auto; }
// A tab is pressed to select or drag it, so it keeps its size.
.doc-tab .face:active { transform: none; }
.doc-tab .face:hover { background-color: transparent; }
.doc-tab .face:focus-visible { background-color: transparent; }
.doc-tab[data-state=on] .face { color: var(--foreground); }
.face .label {
  position: relative; display: block; flex: 1 1 0dp; min-width: 0dp;
  overflow: hidden; white-space: nowrap;
}
.doc-title-fade {
  position: absolute; right: 0dp; top: 0dp; width: 16dp; height: 100%;
  pointer-events: none; decorator: horizontal-gradient(#00000000 var(--app));
}
.doc-tab:hover .doc-title-fade { decorator: horizontal-gradient(#00000000 var(--tab-hover)); }
.doc-tab[data-state=on] .doc-title-fade { decorator: horizontal-gradient(#00000000 var(--background)); }
.dirty-dot { flex: 0 0 auto; width: 6dp; height: 6dp; border-radius: 3dp; background-color: var(--muted-foreground); }
.doc-tab .doc-pin, .doc-tab .doc-close { width: 22dp; height: 22dp; flex: 0 0 auto; }
.doc-tab .doc-close {
  position: absolute; right: 2dp; top: 50%; margin-top: -11dp;
  opacity: 0; pointer-events: none; background-color: transparent; transition: none;
}
.doc-tab .doc-close[data-disabled] { opacity: 0; }
.doc-close > .icon { position: relative; z-index: 1; }
// Cover the title through the button's transparent border and rounded corners.
.doc-close-cover {
  position: absolute; left: -1dp; right: -1dp; top: -1dp; bottom: -1dp;
  pointer-events: none; background-color: var(--app);
}
.doc-tab:hover .doc-close-cover { background-color: var(--tab-hover); }
.doc-tab[data-state=on] .doc-close-cover { background-color: var(--background); }
.doc-close-highlight {
  position: absolute; left: -1dp; right: -1dp; top: -1dp; bottom: -1dp;
  box-sizing: border-box; border: 1dp transparent; border-radius: var(--r);
  pointer-events: none;
}
.doc-close:focus-visible .doc-close-highlight { border-color: var(--ring); }
.doc-close-fade {
  position: absolute; left: -16dp; top: 0dp; width: 16dp; height: 100%;
  pointer-events: none; decorator: horizontal-gradient(#00000000 var(--app));
}
.doc-tab:hover .doc-close-fade { decorator: horizontal-gradient(#00000000 var(--tab-hover)); }
.doc-tab[data-state=on] .doc-close-fade { decorator: horizontal-gradient(#00000000 var(--background)); }
.doc-tab:hover .doc-close, .doc-tab .doc-close:focus-visible { opacity: 1; pointer-events: auto; }
.doc-tab .doc-close:hover { background-color: transparent; }
.doc-tab .doc-close:hover .doc-close-highlight { background-color: var(--tab-close-hover); }
.doc-tab[data-state=on] .doc-close:hover .doc-close-highlight { background-color: var(--tab-active-close-hover); }
.doc-tab:hover .doc-close[data-disabled] { opacity: 1; }
.doc-close[data-disabled] .icon { opacity: 0; }
.doc-tab:hover .doc-close[data-disabled] .icon, .doc-close[data-disabled]:focus-visible .icon { opacity: 0.38; }
.open-tabs { flex: 0 0 auto; }
#open-tabs-menu { min-width: 220dp; max-width: 360dp; }
#open-tabs-menu .label { display: block; overflow: hidden; text-overflow: ellipsis; }
.transport { display: flex; align-items: center; gap: 4dp; flex: 0 0 auto; }
#play-target { display: flex; flex: 0 0 auto; }
.target { width: 168dp; overflow: hidden; }
.target .label { display: block; flex: 1 1 0dp; min-width: 0dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.target .icon { flex: 0 0 auto; }
.group { display: flex; background-color: var(--secondary); border-radius: var(--r); }
.group .btn { border-radius: 0dp; width: var(--h); padding: 0dp; }
// A running scene fills Play, as the Scene header's active tool, so play mode reads at a glance.
.group .btn[data-state=on] { background-color: var(--primary); color: var(--primary-foreground); }
.group .btn[data-state=on] .icon { color: var(--primary-foreground); }
#debug-steps { display: flex; }
#speed { display: flex; flex: 0 0 auto; }
// The speed keeps its width as it steps, so the centered transport stays put,
// and reads as on, as Play does, while it is not 1x.
.speed { min-width: 54dp; font-family: var(--font-numeric); }
.speed[data-state=on] { background-color: var(--selected); color: var(--primary-text); }
// Search narrows before anything else but the tabs.
.search-trigger {
  flex: 0 4 220dp; min-width: 28dp; width: 220dp; overflow: hidden; justify-content: flex-start;
  padding: 0dp 6dp 0dp 7dp; background-color: var(--field-edit); color: var(--faint-foreground);
  &:hover { background-color: var(--input-hover); color: var(--muted-foreground); }
  .label { flex: 1 1 0dp; }
}

@media (max-width: 1200dp) {
  .collaboration-trigger {
    width: var(--h); padding: 0dp; justify-content: center;
  }
  .collaboration-trigger .label { display: none; }
  .target { width: 140dp; }
  .search-trigger {
    flex: 0 0 auto; width: var(--h); min-width: var(--h);
    padding: 0dp; justify-content: center;
  }
  .search-trigger .label, .search-trigger .kbd { display: none; }
}

@media (max-width: 900dp) {
  #layout { display: none; }
  .target { width: 120dp; }
}
<div class="app-chrome">
  <header class="topbar">
    <div class="brand"><div class="mark"/></div>
    <!-- The menubar: each menu's MenuCommands run Studio's commands by id,
         and its lists (new project, projects, web projects, prototypes to
         add) come from the `menubar` source. -->
    <menubar class="menus">
      <button class="btn trigger" popovertarget="menu-file" aria-haspopup="menu"><span class="label">File</span></button>
      <use ui="Menu" id="menu-file">
        <use ui="Submenu" data-alias-item="menubar.items.newMenu">
          <use ui="MenuItem" data-alias-item="menubar.items.project" data-event-click="emit('menubar.newProject')"/>
          <use ui="MenuSeparator"/>
          <use ui="MenuCommand" data-alias-command="commands.newScene"/>
          <use ui="MenuCommand" data-alias-command="commands.newPrototype"/>
          <use ui="MenuSeparator"/>
          <use ui="MenuCommand" data-alias-command="commands.newBehavior"/>
          <use ui="MenuCommand" data-alias-command="commands.newEvent"/>
          <use ui="MenuCommand" data-alias-command="commands.newSystem"/>
          <use ui="MenuCommand" data-alias-command="commands.newLibrary"/>
          <use ui="MenuSeparator"/>
          <use ui="MenuCommand" data-alias-command="commands.newMaterial"/>
          <use ui="MenuCommand" data-alias-command="commands.newShape"/>
          <use ui="MenuCommand" data-alias-command="commands.newField"/>
          <use ui="MenuCommand" data-alias-command="commands.newShaderLibrary"/>
          <use ui="MenuCommand" data-alias-command="commands.newModel"/>
          <use ui="MenuSeparator"/>
          <use ui="MenuCommand" data-alias-command="commands.newUiWidget"/>
          <use ui="MenuCommand" data-alias-command="commands.newUiDocument"/>
          <use ui="MenuCommand" data-alias-command="commands.newStylesheet"/>
        </use>
        <use ui="MenuCommand" data-if="commands.openProject.enabled" data-alias-command="commands.openProject"/>
        <use ui="Submenu" data-if="menubar.projects.size > 0" data-alias-item="menubar.items.openRecent">
          <use ui="MenuItem" data-for="project, i : menubar.projects" data-alias-item="project" data-event-click="emit('menubar.openProject', i)"/>
        </use>
        <use ui="MenuSeparator"/>
        <use ui="MenuCommand" data-alias-command="commands.save"/>
        <use ui="MenuCommand" data-alias-command="commands.saveAll"/>
        <use ui="MenuCommand" data-alias-command="commands.revert"/>
        <use ui="MenuCommand" data-alias-command="commands.closeTab"/>
        <use ui="MenuItem" data-if="menubar.web" data-alias-item="menubar.items.importProject" data-event-click="emit('menubar.importProject')"/>
        <use ui="MenuItem" data-if="menubar.web" data-alias-item="menubar.items.exportProject" data-event-click="emit('menubar.exportProject')"/>
        <use ui="MenuCommand" data-if="!menubar.web" data-alias-command="commands.exportGame"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuCommand" data-alias-command="commands.settings"/>
        <use ui="MenuSeparator" data-if="commands.quit.enabled"/>
        <use ui="MenuCommand" data-if="commands.quit.enabled" data-alias-command="commands.quit"/>
      </use>
      <button class="btn trigger" popovertarget="menu-edit" aria-haspopup="menu"><span class="label">Edit</span></button>
      <use ui="Menu" id="menu-edit">
        <use ui="MenuCommand" data-alias-command="commands.undo"/>
        <use ui="MenuCommand" data-alias-command="commands.redo"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuCommand" data-alias-command="commands.cut"/>
        <use ui="MenuCommand" data-alias-command="commands.copy"/>
        <use ui="MenuCommand" data-alias-command="commands.paste"/>
        <use ui="MenuCommand" data-alias-command="commands.duplicate"/>
        <use ui="MenuCommand" data-alias-command="commands.rename"/>
        <use ui="MenuCommand" data-alias-command="commands.delete"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuCommand" data-alias-command="commands.selectAll"/>
        <use ui="MenuCommand" data-alias-command="commands.deselect"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuCommand" data-alias-command="commands.find"/>
        <use ui="MenuCommand" data-alias-command="commands.search"/>
      </use>
      <button class="btn trigger" popovertarget="menu-view" aria-haspopup="menu"><span class="label">View</span></button>
      <!-- Panels and layout first, as most editors' View menus lead; the
           tabs and the Scene view's camera follow. -->
      <use ui="Menu" id="menu-view">
        <use ui="MenuGroup">Panels</use>
        <use ui="MenuCommand" data-alias-command="commands.toggleAssets"/>
        <use ui="MenuCommand" data-alias-command="commands.toggleOutput"/>
        <use ui="MenuCommand" data-alias-command="commands.togglePerformance"/>
        <use ui="MenuCommand" data-alias-command="commands.toggleSidePane"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuGroup">Layout</use>
        <use ui="MenuCommand" data-alias-command="commands.workspaceHorizontalSplit"/>
        <use ui="MenuCommand" data-alias-command="commands.workspaceVerticalSplit"/>
        <use ui="MenuCommand" data-alias-command="commands.maximize"/>
        <use ui="MenuCommand" data-alias-command="commands.resetLayout"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuGroup">Tabs</use>
        <use ui="MenuCommand" data-alias-command="commands.previousTab"/>
        <use ui="MenuCommand" data-alias-command="commands.nextTab"/>
        <use ui="MenuCommand" data-alias-command="commands.togglePinTab"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuGroup">Scene</use>
        <use ui="MenuCommand" data-alias-command="commands.frame"/>
        <use ui="MenuCommand" data-alias-command="commands.frameAll"/>
        <use ui="MenuCommand" data-alias-command="commands.resetCamera"/>
        <use ui="MenuCommand" data-alias-command="commands.hideSelected"/>
        <use ui="MenuCommand" data-alias-command="commands.hideUnselected"/>
        <use ui="MenuCommand" data-alias-command="commands.showAll"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuGroup">UI Scale</use>
        <use ui="MenuCommand" data-alias-command="commands.zoomIn"/>
        <use ui="MenuCommand" data-alias-command="commands.zoomOut"/>
        <use ui="MenuCommand" data-alias-command="commands.zoomReset"/>
      </use>
      <button class="btn trigger" popovertarget="menu-object" aria-haspopup="menu"><span class="label">Object</span></button>
      <use ui="Menu" id="menu-object">
        <use ui="Submenu" data-alias-item="menubar.items.add">
          <use ui="MenuItem" data-for="prototype : menubar.prototypes" data-alias-item="prototype" data-event-click="emit('menubar.add', prototype.label)"/>
        </use>
        <use ui="MenuCommand" data-alias-command="commands.duplicate"/>
        <use ui="MenuCommand" data-alias-command="commands.rename"/>
        <use ui="MenuCommand" data-alias-command="commands.delete"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuCommand" data-alias-command="commands.openPrototype"/>
        <use ui="MenuCommand" data-alias-command="commands.applyOverrides"/>
        <use ui="MenuCommand" data-alias-command="commands.saveAsPrototype"/>
        <use ui="MenuCommand" data-alias-command="commands.addComponent"/>
        <use ui="MenuSeparator"/>
        <use ui="Submenu" data-alias-item="menubar.items.transform">
          <use ui="MenuCommand" data-alias-command="commands.selectTool"/>
          <use ui="MenuCommand" data-alias-command="commands.moveTool"/>
          <use ui="MenuCommand" data-alias-command="commands.rotateTool"/>
          <use ui="MenuCommand" data-alias-command="commands.scaleTool"/>
          <use ui="MenuSeparator"/>
          <use ui="MenuCommand" data-alias-command="commands.grab"/>
          <use ui="MenuCommand" data-alias-command="commands.toggleSnap"/>
          <use ui="MenuCommand" data-alias-command="commands.finerGrid"/>
          <use ui="MenuCommand" data-alias-command="commands.coarserGrid"/>
        </use>
        <use ui="MenuSeparator"/>
        <use ui="MenuCommand" data-alias-command="commands.keepChanges"/>
      </use>
      <button class="btn trigger" popovertarget="menu-play" aria-haspopup="menu"><span class="label">Play</span></button>
      <!-- F5 plays or resumes; while the game runs, Space's Pause takes
           its place, so the menu never lists Play twice. -->
      <use ui="Menu" id="menu-play">
        <use ui="MenuCommand" data-if="commands.resume.enabled" data-alias-command="commands.resume"/>
        <use ui="MenuCommand" data-if="!commands.resume.enabled" data-alias-command="commands.play"/>
        <use ui="MenuCommand" data-alias-command="commands.stop"/>
        <use ui="MenuCommand" data-alias-command="commands.step"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuGroup">Playback Speed</use>
        <use ui="MenuCommand" data-alias-command="commands.slower"/>
        <use ui="MenuCommand" data-alias-command="commands.faster"/>
        <use ui="MenuCommand" data-alias-command="commands.normalSpeed"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuGroup">Debugger</use>
        <use ui="MenuCommand" data-alias-command="commands.stepOver"/>
        <use ui="MenuCommand" data-alias-command="commands.stepInto"/>
        <use ui="MenuCommand" data-alias-command="commands.stepOut"/>
        <use ui="MenuCommand" data-alias-command="commands.showLiveValues"/>
      </use>
      <button class="btn trigger" popovertarget="menu-help" aria-haspopup="menu"><span class="label">Help</span></button>
      <use ui="Menu" id="menu-help">
        <use ui="MenuCommand" data-alias-command="commands.keyboardShortcuts"/>
        <use ui="MenuCommand" data-alias-command="commands.documentation"/>
        <use ui="MenuCommand" data-alias-command="commands.reportIssue"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuCommand" data-alias-command="commands.inspectElement"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuCommand" data-alias-command="commands.about"/>
      </use>
    </menubar>
    <div class="spacer"/>
    <div class="transport">
      <!-- A plain label: <morph-text> took its text in its first update,
           before the binding replaced the raw {{ }} text, and showed that
           text at startup. The target changes as scenes switch, often from
           the keyboard, so it needs no motion. -->
      <div id="play-target">
        <button class="btn subtle target" popovertarget="target-menu" aria-haspopup="menu" data-tip="Play target"><span class="icon">{{ shell.target.icon }}</span><span class="label">{{ shell.target.label }}</span></button>
        <use ui="Menu" id="target-menu">
          <use ui="MenuGroup">Play</use>
          <use ui="MenuItem" data-alias-item="shell.target.scene" data-event-click="emit('shell.target', 'scene')"/>
          <use ui="MenuItem" data-alias-item="shell.target.preview" data-event-click="emit('shell.target', 'preview')"/>
        </use>
      </div>
      <div class="group">
        <button class="btn icon-only" data-attr-data-tip="commands.play.label" data-attr-data-kbd="commands.play.shortcut" data-attr-data-state="editor.playing && !editor.paused ? 'on' : 'off'" data-event-click="emit('studio.play')" data-attrif-data-disabled="!commands.play.enabled"><span class="icon">{{ commands.play.icon }}</span></button>
        <button class="btn icon-only" data-attr-data-tip="commands.stop.label" data-attr-data-kbd="commands.stop.shortcut" data-attrif-data-disabled="!commands.stop.enabled" data-event-click="emit('studio.stop')"><span class="icon">{{ commands.stop.icon }}</span></button>
        <button class="btn icon-only" data-if="!editor.paused" data-attr-data-tip="commands.step.label" data-attr-data-kbd="commands.step.shortcut" data-event-click="emit('studio.step')" data-attrif-data-disabled="!commands.step.enabled"><span class="icon">{{ commands.step.icon }}</span></button>
        <div id="debug-steps" data-if="editor.paused">
          <button class="btn icon-only" data-attr-data-tip="commands.stepOver.label" data-attr-data-kbd="commands.stepOver.shortcut" data-event-click="emit('studio.stepOver')"><span class="icon">{{ commands.stepOver.icon }}</span></button>
          <button class="btn icon-only" data-attr-data-tip="commands.stepInto.label" data-attr-data-kbd="commands.stepInto.shortcut" data-event-click="emit('studio.stepInto')"><span class="icon">{{ commands.stepInto.icon }}</span></button>
          <button class="btn icon-only" data-attr-data-tip="commands.stepOut.label" data-attr-data-kbd="commands.stepOut.shortcut" data-event-click="emit('studio.stepOut')"><span class="icon">{{ commands.stepOut.icon }}</span></button>
        </div>
      </div>
      <div id="speed">
        <button class="btn subtle speed" popovertarget="speed-menu" aria-haspopup="menu" data-tip="Playback Speed" data-tip-about="Game time per second. Behaviors, physics and effects slow alike; Stop returns to 1&#xd7;." data-attr-data-state="shell.speed.on ? 'on' : 'off'"><span class="label">{{ shell.speed.label }}</span></button>
        <use ui="Menu" id="speed-menu">
          <use ui="MenuGroup">Playback Speed</use>
          <use ui="MenuCommand" data-alias-command="commands.slower"/>
          <use ui="MenuCommand" data-alias-command="commands.faster"/>
          <use ui="MenuCommand" data-alias-command="commands.normalSpeed"/>
          <use ui="MenuSeparator"/>
          <use ui="MenuItem" data-for="preset, i : shell.speed.presets" data-alias-item="preset" data-event-click="emit('shell.speed', i)"/>
        </use>
      </div>
    </div>
    <div class="spacer"/>
    <!-- Icon-only until a session exists, then labelled so the session reads at a glance. -->
    <button class="btn collaboration-trigger" data-attr-data-tip="commands.collaboration.label" data-attr-data-state="collaboration.connected ? 'on' : 'off'" data-class-icon-only="!collaboration.connected" data-event-click="emit('studio.collaboration')"><span class="icon">{{ commands.collaboration.icon }}</span><span class="label" data-if="collaboration.connected">Collab</span></button>
    <div class="sep"/>
    <!-- The layout controls sit together at the right, as VS Code's do. -->
    <div id="layout">
      <button class="btn icon-only" popovertarget="layout-menu" aria-haspopup="menu" data-tip="Layout"><span class="icon">&#xebeb;</span></button>
      <use ui="Menu" id="layout-menu">
        <use ui="MenuGroup">Layout</use>
        <use ui="MenuCommand" data-alias-command="commands.workspaceHorizontalSplit"/>
        <use ui="MenuCommand" data-alias-command="commands.workspaceVerticalSplit"/>
        <use ui="MenuCommand" data-alias-command="commands.maximize"/>
        <use ui="MenuSeparator"/>
        <use ui="MenuCommand" data-alias-command="commands.resetLayout"/>
      </use>
    </div>
    <button class="btn icon-only side-pane" data-attr-data-tip="commands.toggleSidePane.label" data-attr-data-state="commands.toggleSidePane.checked ? 'on' : 'off'" data-event-click="emit('studio.toggleSidePane')"><span class="icon">{{ commands.toggleSidePane.icon }}</span></button>
    <button class="btn icon-only" data-attr-data-tip="commands.settings.label" data-attr-data-kbd="commands.settings.shortcut" data-event-click="emit('studio.settings')"><span class="icon">{{ commands.settings.icon }}</span></button>
    <button class="btn search-trigger" data-attr-data-tip="commands.search.label" data-attr-data-kbd="commands.search.shortcut" data-event-click="emit('studio.search')"><span class="icon">{{ commands.search.icon }}</span><span class="label">{{ commands.search.label }}</span><span class="kbd">{{ commands.search.shortcut }}</span></button>
  </header>
  <nav class="doc-tabs" aria-label="Open documents">
    <tab-list class="doc-tab-list" role="tablist" aria-label="Open documents">
      <div class="doc-tab" role="presentation" data-for="tab, i : editor.tabs" data-attr-data-state="tab.active ? 'on' : 'off'" data-attrif-data-pinned="tab.pinned" data-event-contextmenu="emit('shell.tabMenu', i)">
        <button class="btn face" role="tab" data-attr-aria-selected="tab.active ? 'true' : 'false'" data-attr-aria-label="tab.label" data-attr-data-tip="tab.path != '' ? tab.path : tab.label" data-event-click="emit('studio.selectTab', i)"><span class="icon">{{ tab.icon }}</span><span class="label">{{ tab.label }}<span class="doc-title-fade" aria-hidden="true"/></span><span class="dirty-dot" data-if="tab.dirty" data-tip="Unsaved changes"/></button>
        <button class="btn icon-only doc-pin" data-when="tab.pinned" data-attr-data-tip="tab.pinLabel" data-attr-aria-label="tab.pinLabel" aria-pressed="true" data-event-click="emit('studio.togglePinTab', i)"><span class="icon">&#xf0931;</span></button>
        <button class="btn icon-only doc-close" data-when="!tab.pinned" data-tab-close data-attr-data-tip="tab.closeReason" data-attr-aria-label="tab.closeReason" data-attr-data-kbd="commands.closeTab.shortcut" data-attrif-data-disabled="!tab.closable" data-event-click="emit('studio.closeTab', i)"><span class="doc-close-cover" aria-hidden="true"/><span class="doc-close-fade" aria-hidden="true"/><span class="doc-close-highlight" aria-hidden="true"/><span class="icon">&#xea76;</span></button>
      </div>
    </tab-list>
    <button class="btn icon-only open-tabs" popovertarget="open-tabs-menu" aria-haspopup="menu" aria-label="Open tabs" data-tip="Open tabs"><span class="icon">&#xeab4;</span></button>
    <use ui="Menu" id="open-tabs-menu">
      <use ui="MenuGroup">Open tabs</use>
      <use ui="MenuItem" data-for="tab, i : editor.tabs" data-alias-item="tab" data-event-click="emit('studio.selectTab', i)"/>
    </use>
    <use ui="Menu" id="tab-menu">
      <use ui="MenuItem" data-alias-item="shell.tabMenu.pin" data-event-click="emit('shell.tabPin')"/>
      <use ui="MenuItem" data-alias-item="shell.tabMenu.close" data-event-click="emit('shell.tabClose')"/>
    </use>
  </nav>
</div>
/* A row of a tree or list, as the Outliner's and Assets' native rows: depth
   indent, twisty, icon, label, meta and the use's children trailing (the
   Outliner's eye and lock). Alias the row as data-alias-item: an object
   with label, icon (a glyph), meta, depth, parent (it has children), open,
   selected, active, marked and hidden; the twisty writes item.open, which
   is UI-local. A panel whose selection changes often keeps it out of its
   rows: give each item a key and alias the selected and the active key as
   data-alias-selection and data-alias-active, from a variable of their
   own, so a selection re-evaluates only the rows' two state views (the
   flags still mark rows the keys don't). Put data-drag, data-drop and
   data-drop-zones (src/ui/drag.h) on the use: the row's marks follow them
   here. The rows' own look is the theme's .tree-row (theme/tree.rcss). */
body { display: block; }
/* A drop target that takes the drag, then the one under the pointer, and
   where in it a drop lands: a line before or after it, or filled. */
body[data-drop-accept] .tree-row { border-color: var(--primary-edge); }
body[data-drop-over] { background-color: transparent; }
body[data-drop-over] .tree-row { border-color: var(--primary); background-color: var(--primary-soft); }
body[data-drop-zone=before] .tree-row { border-color: transparent; border-top-color: var(--primary); background-color: transparent; }
body[data-drop-zone=after] .tree-row { border-color: transparent; border-bottom-color: var(--primary); background-color: transparent; }
<div class="tree-row" data-attrif-data-selected="item.selected || (item.key + '' != '' && item.key + '' == selection + '')" data-attrif-data-active="item.active || (item.key + '' != '' && item.key + '' == active + '')" data-attrif-data-marked="item.marked" data-attrif-data-hidden="item.hidden" data-style-padding-left="(6 + item.depth * 14) + 'dp'">
  <span class="icon twisty sm" data-event-click="item.open = !item.open">{{ item.parent ? (item.open ? '&#xeab4;' : '&#xeab6;') : '' }}</span>
  <span class="icon">{{ item.icon }}</span>
  <span class="name">{{ item.label }}</span>
  <span class="meta">{{ item.meta }}</span>
  <span class="trail"><slot/></span>
</div>
/* Joined axes: one NumberField per axis, in one control, each addon colored
   by its key. Alias the axes as data-alias-axes, each with key, label,
   value, step, precision, min, max, unit, slider, mixed and overridden, and
   the field as data-alias-field for its id (the first axis's; the others
   add .key), label, readonly and float. Each axis's input and change carry
   its key as ev.name: data-event-change="emit('panel.change', row.id,
   ev.value, ev.canceled, ev.name)". */
body { display: flex; flex: 1 1 0dp; }
/* The data-for's template stays hidden after the last axis. */
.joined .field { border-radius: 0dp; }
.joined .field:first-child { border-radius: 4dp 0dp 0dp 4dp; }
.joined .field:nth-last-child(2) { border-radius: 0dp 4dp 4dp 0dp; }
<div class="joined" attrs>
  <number-field class="field number" data-for="axis : axes" data-attr-id="axis.key == 'x' ? field.id : field.id + '.' + axis.key" data-attr-aria-label="field.label + ' ' + axis.label" data-attr-name="axis.key" data-attr-value="values[axis.slot]" data-attr-addon="axis.label" data-attr-data-axis="axis.key" data-attr-step="axis.step" data-attr-precision="axis.precision" data-attr-min="axis.min" data-attr-max="axis.max" data-attr-unit="axis.unit" data-attrif-slider="axis.slider" data-attrif-float="field.float" data-attrif-mixed="axis.mixed" data-attrif-readonly="field.readonly" data-attrif-data-overridden="axis.overridden"></number-field>
</div>
/* A virtualized list, as react-virtuoso draws one: a scrolling view, a spacer
   as tall as every row, and only the rows in view, placed at their offset.
   Give it an id (id="list") and rows of one fixed height. The VirtualList
   behavior reads where the view is scrolled (Get UI Scroll) and sets
   self.first and self.row, then sends ShowRows with the rows to show; the
   entity's own behavior answers with self.rows and self.total. */
/* The list fills what holds it, and scrolls inside that height. */
body { display: block; height: 100%; }
.vlist { display: block; overflow-y: auto; height: 100%; }
.vlist-content { position: relative; }
.vlist-window { position: absolute; left: 0dp; right: 0dp; top: 0dp; }
<div class="vlist" attrs data-event-scroll="emit('ListScrolled')">
  <div class="vlist-content" data-style-height="self.total * self.row + 'dp'">
    <div class="vlist-window" data-style-top="self.first * self.row + 'dp'"><slot/></div>
  </div>
</div>
.gallery { display: block; width: 240dp; }
.sample { display: flex; align-items: center; gap: 8dp; padding: 2dp 6dp 8dp; color: var(--foreground); }
// Presence: in from its starting style, out through its ending style.
.shown {
  transition: opacity 0.14s cubic-out;
  &[data-starting-style], &[data-ending-style] { opacity: 0; }
}
// A splitter between two panes it resizes.
.split-sample { height: 40dp; gap: 0dp; }
.split-pane { display: block; height: 100%; border-radius: 4dp; background-color: var(--secondary); }
.split-pane.rest { flex: 1 1 0dp; }
// Ten thousand rows, of which only those in view exist (WidgetGallery).
.list-sample { display: block; height: 160dp; }
.list-row { height: var(--studio-height-24, 24dp); line-height: var(--studio-line-24, 24dp); padding: 0dp 6dp; color: var(--foreground); }
// The project's assets as a List of TreeRows a C source windows, dragged
// as Assets drags them; Collected takes drops before or after its rows, and
// shows them as Tiles too (studio_gallery.c).
.assets-sample { display: block; height: 160dp; padding: 0dp 2dp 8dp; }
.bin { display: block; min-height: 40dp; margin: 0dp 6dp 8dp; padding: 2dp; border: 1dp var(--edge); border-radius: var(--r); }
.bin[data-drop-accept] { border-color: var(--primary-edge); }
.bin[data-drop-over] { border-color: var(--primary); }
.bin-empty { display: block; padding: 8dp 6dp; color: var(--muted-foreground); text-align: center; }
.tiles { flex-wrap: wrap; align-items: flex-start; }
.tile-sample { width: 72dp; height: 90dp; }
<div class="gallery">
  <div class="menu-group">Menu</div>
  <div class="sample">
    <button class="btn" popovertarget="gallery-menu" aria-haspopup="menu"><span class="label">Edit</span></button>
    <use ui="Menu" id="gallery-menu">
      <use ui="MenuCommand" data-alias-command="commands.undo"/>
      <use ui="MenuCommand" data-alias-command="commands.redo"/>
      <use ui="MenuSeparator"/>
      <use ui="MenuCheck" data-checked="save.galleryChecked">Snap to grid</use>
      <use ui="MenuSeparator"/>
      <use ui="Submenu" data-alias-item="choices.panels">
        <use ui="MenuItem" data-for="panel : choices.panels.others" data-alias-item="panel"/>
      </use>
    </use>
  </div>
  <div class="menu-group">EnumField</div>
  <div class="sample"><use ui="EnumField" data-alias-table="choices.fields.Body.type" data-alias-value="save.galleryBody" data-event-change="save.galleryBody = ev.value * 1"/></div>
  <div class="menu-group">AssetField</div>
  <div class="sample"><use ui="AssetField" data-alias-table="choices.assets.prototype" data-alias-value="save.galleryAsset" data-event-click="emit('palette.pick', 'prototype', save.galleryAsset, 'None')" data-event-change="save.galleryAsset = ev.value"/></div>
  <div class="menu-group">MenuOption</div>
  <use ui="MenuOption" value="first">First</use>
  <use ui="MenuOption" value="second">Second</use>
  <div class="menu-sep"/>
  <div class="menu-group">MenuCheck</div>
  <use ui="MenuCheck">Check</use>
  <div class="menu-sep"/>
  <div class="menu-group">Switch</div>
  <div class="sample"><use ui="Switch"/><use ui="Switch" checked=""/></div>
  <div class="menu-group">Segmented</div>
  <div class="sample">
    <use ui="Segmented">
      <label><input type="radio" name="size" value="small"/><span class="face">Small</span></label>
      <label><input type="radio" name="size" value="medium" checked=""/><span class="face">Medium</span></label>
      <label><input type="radio" name="size" value="large"/><span class="face">Large</span></label>
    </use>
  </div>
  <div class="menu-group">Select</div>
  <div class="sample">
    <use ui="Select">
      <select>
        <option value="low">Low</option>
        <option value="high" selected="">High</option>
        <option value="ultra">Ultra</option>
      </select>
    </use>
  </div>
  <div class="menu-group">Slider</div>
  <div class="sample"><use ui="Slider" min="0" max="10" step="1" value="4"/></div>
  <div class="menu-group">NumberField</div>
  <div class="sample">
    <use ui="NumberField" step="0.5" precision="2" unit="m" data-attr-value="save.galleryNumber == '' ? 12.5 : save.galleryNumber" data-event-change="save.galleryNumber = ev.value"/>
    <use ui="NumberField" min="0" max="1" step="0.05" precision="2" slider="" data-attr-value="save.galleryRatio == '' ? 0.4 : save.galleryRatio" data-event-input="save.galleryRatio = ev.value"/>
  </div>
  <div class="menu-group">ColorField</div>
  <div class="sample">
    <use ui="ColorField" data-attr-value="save.galleryColor == '' ? '#3b82f6ff' : save.galleryColor" data-event-input="save.galleryColor = ev.value"/>
  </div>
  <div class="menu-group">Checkbox</div>
  <div class="sample"><use ui="Checkbox" data-checked="save.galleryChecked">Snap to grid</use></div>
  <div class="menu-group">Splitter</div>
  <div class="sample split-sample">
    <span class="split-pane" data-style-width="(save.gallerySplit == '' ? 90 : save.gallerySplit) + 'dp'"/>
    <use ui="Splitter" axis="x" min="40" max="180" data-attr-value="save.gallerySplit == '' ? 90 : save.gallerySplit" data-event-input="save.gallerySplit = ev.value"/>
    <span class="split-pane rest"/>
  </div>
  <div class="menu-group">SidebarNav</div>
  <use ui="SidebarNav">
    <label class="nav-item"><input type="radio" name="page" value="audio" checked=""/><span class="nav-face"><span class="icon">&#xf03d8;</span><span class="label">Display</span></span></label>
    <label class="nav-item"><input type="radio" name="page" value="video"/><span class="nav-face"><span class="icon">&#xf097b;</span><span class="label">Controls</span><span class="dot"/></span></label>
    <label class="nav-item"><input type="radio" name="page" value="game"/><span class="nav-face"><span class="icon">&#xf0297;</span><span class="label">Gameplay</span><span class="count">3</span></span></label>
  </use>
  <div class="menu-group">NumberFlow</div>
  <div class="sample">
    <use ui="Slider" min="0" max="2000" step="125" data-value="save.galleryCount"/>
    <number-flow data-attr-value="save.galleryCount == '' ? 0 : save.galleryCount" grouping=""/>
  </div>
  <div class="menu-group">MorphText</div>
  <div class="sample">
    <use ui="Segmented">
      <label><input type="radio" data-checked="save.galleryWord" value="Play"/><span class="face">Play</span></label>
      <label><input type="radio" data-checked="save.galleryWord" value="Pause"/><span class="face">Pause</span></label>
      <label><input type="radio" data-checked="save.galleryWord" value="Stop"/><span class="face">Stop</span></label>
    </use>
    <morph-text>{{ save.galleryWord == '' ? 'Play' : save.galleryWord }}</morph-text>
  </div>
  <div class="menu-group">VirtualList</div>
  <div class="sample list-sample">
    <use ui="VirtualList" id="list">
      <div class="list-row" data-for="row, i : self.rows">Row {{ self.first + i + 1 }} of {{ self.total }}</div>
    </use>
  </div>
  <div class="menu-group">List</div>
  <div class="sample assets-sample">
    <use ui="List" id="gallery-assets" data-event-scroll="emit('gallery.scroll')">
      <use ui="TreeRow" data-for="row : gallery.assets" data-alias-item="row" data-attr-data-drag="row.drag" data-attr-data-drag-payload="row.name" data-attr-data-drag-icon="row.icon"></use>
    </use>
  </div>
  <div class="menu-group">TreeRow drop zones</div>
  <div class="bin" data-drop="prototype behavior material shape field system ui" data-drop-hint="Collect" data-event-drop="emit('gallery.drop', ev.type, ev.payload, -1, ev.zone)">
    <div class="bin-empty" data-if="gallery.bin.size == 0">Drop assets here</div>
    <use ui="TreeRow" data-for="row, i : gallery.bin" data-alias-item="row" data-drop="prototype behavior material shape field system ui" data-drop-zones="list" data-drop-hint="Insert" data-event-drop="emit('gallery.drop', ev.type, ev.payload, i, ev.zone)"></use>
  </div>
  <div class="menu-group">Tile</div>
  <div class="sample tiles">
    <use ui="Tile" class="tile-sample" data-for="row : gallery.bin" data-alias-tile="row" data-attr-data-drag="row.drag" data-attr-data-drag-payload="row.name" data-attr-data-drag-icon="row.icon"></use>
    <span class="bin-empty" data-if="gallery.bin.size == 0">Collected assets show here</span>
  </div>
  <div class="menu-group">Presence</div>
  <div class="sample"><use ui="Switch" data-checked="save.galleryShown"/><span class="shown" data-if="save.galleryShown" presence>Shown</span></div>
</div>
/* Studio's workspace (studio_shell.c hosts it and binds `workspace`):
   Blender-style areas as floating panels on the app's backdrop with 6 dp
   gutters, the splitters between them, the drawer under the main areas and
   the side column, and a maximized area filling it all. Each area is a
   document of its own shown over its place (#area-<key>), so a change
   inside one lays out only that one, and the places here stay empty. This document lies over the areas and passes the
   pointer through everywhere but its splitters, so their hit areas reach
   past the gutters onto the areas beside them. */
body { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; pointer-events: none; }
.workspace { flex: 1 1 0dp; display: flex; min-width: 0dp; padding: 0dp 6dp 4dp 6dp; }
.column { display: flex; flex-direction: column; }
.column.main { flex: 1 1 0dp; min-width: 0dp; }
// The top and bottom areas, stacked or side by side.
.editors { display: flex; flex-direction: column; flex: 1 1 0dp; min-width: 0dp; min-height: 0dp; }
.across .editors { flex-direction: row; }
.place { position: relative; flex: 0 0 auto; }
.place.fill { flex: 1 1 0dp; min-width: 0dp; min-height: 0dp; }
// The kit's box an area's document takes.
.area-doc { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; }

/* The drawer and the side column keep their last size and open and shut at
   once, as VS Code's panels do, clipping what they hold; their splitters
   move them directly. They toggle from the keyboard many times a session,
   and easing their size would lay out every area and resize the viewport on
   each frame of it (Emil: no motion for frequent, keyboard-driven changes;
   animate transform and opacity only). Each area is a document of its own
   placed over its place, so a transform here could not move it. */
.drawer { display: flex; flex-direction: column; flex: 0 0 auto; height: 0dp; overflow: hidden; }
.drawer[data-open] { height: var(--drawer, 0dp); }
.side { display: flex; flex: 0 0 auto; width: 0dp; overflow: hidden; }
.side[data-open] { width: var(--side, 0dp); }
.side .column { flex: 1 1 0dp; min-width: 0dp; }
// A maximized area fills the workspace.
.workspace[data-max=drawer] .drawer, .workspace[data-max=outliner] .side, .workspace[data-max=properties] .side {
  flex: 1 1 0dp; width: auto; height: auto;
}

/* Splitters: the 6 dp gutters between areas, which tint while hovered or
   dragged. Each takes the pointer 2 dp onto the areas beside it, a hit area
   of 10 dp (8 dp where the drawer and the side column clip it). */
.split { display: block; flex: 0 0 auto; position: relative; width: 10dp; margin: 0dp -2dp; pointer-events: auto; }
.split[axis=y] { width: auto; height: 10dp; margin: -2dp 0dp; }
.grip { position: absolute; left: 2dp; right: 2dp; top: 0dp; bottom: 0dp; border-radius: 3dp; pointer-events: none; }
.split[axis=y] .grip { left: 0dp; right: 0dp; top: 2dp; bottom: 2dp; }
.split:hover .grip, .split[data-dragging] .grip { background-color: var(--primary-wash); }

<div class="workspace" data-attr-data-max="workspace.max" data-class-across="workspace.across" data-style---drawer="(workspace.drawer + 6) + 'dp'" data-style---side="(workspace.side + 6) + 'dp'">
  <div class="column main" data-if="workspace.max == '' || workspace.max == 'top' || workspace.max == 'bottom' || workspace.max == 'drawer'">
    <div class="editors" data-if="workspace.max != 'drawer'">
      <div id="area-top" class="place" data-if="workspace.max != 'bottom'" data-class-fill="workspace.max == 'top'" data-style-width="workspace.top > 0 && workspace.across && workspace.max == '' ? workspace.top + 'dp' : ''" data-style-height="workspace.top > 0 && !workspace.across && workspace.max == '' ? workspace.top + 'dp' : ''"></div>
      <splitter class="split" data-if="workspace.max == ''" data-attr-axis="workspace.across ? 'x' : 'y'" data-attr-min="workspace.topMin" data-attr-max="workspace.topMax" data-attr-value="workspace.top" data-event-input="emit('workspace.resize', 'main', ev.value)"><div class="grip"></div></splitter>
      <div id="area-bottom" class="place fill" data-if="workspace.max != 'top'"></div>
    </div>
    <div class="drawer" data-if="workspace.max != 'top' && workspace.max != 'bottom'" data-attrif-data-open="workspace.drawerOpen">
      <splitter class="split" axis="y" min="80" invert data-if="workspace.max == ''" data-attr-max="workspace.drawerMax" data-attr-value="workspace.drawerHeight" data-event-input="emit('workspace.resize', 'drawer', ev.value)"><div class="grip"></div></splitter>
      <div id="area-drawer" class="place fill"></div>
    </div>
  </div>
  <div class="side" data-if="workspace.max == '' || workspace.max == 'outliner' || workspace.max == 'properties'" data-attrif-data-open="workspace.sideOpen">
    <splitter class="split" axis="x" min="260" invert data-if="workspace.max == ''" data-attr-max="workspace.sideMax" data-attr-value="workspace.side" data-event-input="emit('workspace.resize', 'side', ev.value)"><div class="grip"></div></splitter>
    <div class="column">
      <div id="area-outliner" class="place" data-if="workspace.max != 'properties'" data-class-fill="workspace.max == 'outliner'" data-style-height="workspace.outliner > 0 && workspace.max == '' ? workspace.outliner + 'dp' : ''"></div>
      <splitter class="split" axis="y" min="80" data-if="workspace.max == ''" data-attr-max="workspace.outlinerMax" data-attr-value="workspace.outliner" data-event-input="emit('workspace.resize', 'outliner', ev.value)"><div class="grip"></div></splitter>
      <div id="area-properties" class="place fill" data-if="workspace.max != 'outliner'"></div>
    </div>
  </div>
</div>
/* The ui bench's List of TreeRows over ten thousand rows
   (test/editor/ui_bench.c, case 8); Studio never shows it. */
body { display: block; height: 100%; }
<use ui="List" id="bench-list">
  <use ui="TreeRow" data-for="row : bench.rows" data-alias-item="row" data-attr-data-drag="row.drag" data-attr-data-drag-payload="row.name" data-attr-data-drag-icon="row.icon"></use>
</use>
/* S0 spike (docs/studio-rml-migration.md): the Properties Object tab
   authored over a `properties` variable, measured by test/editor/ui_bench.c
   and not shown by Studio. The theme and Properties.rcss style its rows. */
body { width: 100%; height: 100%; margin: 0dp; padding: 0dp; overflow: hidden; }
.identity { display: flex; align-items: center; gap: 6dp; padding: 0dp 2dp 8dp; }
.identity .name { font-weight: 600; }
<div class="properties spike">
  <nav class="prop-tabs">
    <span class="btn icon-only" data-for="tab : properties.tabs" data-attr-data-state="tab.on ? 'on' : 'off'" data-attr-data-tip="tab.tip" data-event-click="emit('properties.tab', tab.id)"><span class="icon">{{ tab.icon }}</span></span>
  </nav>
  <div class="prop-scroll">
    <div class="identity">
      <span class="name">{{ properties.identity.name }}</span>
      <span class="badge" data-if="properties.identity.prototype != ''">{{ properties.identity.prototype }}</span>
    </div>
    <section class="panel" data-for="panel : properties.panels" data-attrif-data-open="panel.open">
      <div class="panel-head" data-event-click="emit('properties.panel', panel.key)">
        <span class="icon chev">&#xeab4;</span>
        <span class="title">{{ panel.title }}</span>
        <span class="badge override" data-if="panel.badge != ''">{{ panel.badge }}</span>
        <span class="spacer"/>
        <span class="icon grip">&#xeb04;</span>
      </div>
      <div class="panel-body" data-if="panel.open">
        <div class="prop" data-for="row : panel.rows" data-attrif-data-overridden="row.overridden">
          <label class="label" data-attr-data-tip="row.about"><span>{{ row.label }}</span></label>
          <div class="control">
            <number-field class="field number" data-for="n : row.number" data-attr-value="n.value" data-attr-step="n.step" data-attr-precision="n.precision" data-attrif-integer="n.integer" data-attr-unit="n.unit" data-attrif-data-overridden="row.overridden" data-attrif-readonly="row.readonly" data-attrif-mixed="row.mixed" data-attrif-invalid="row.invalid" data-event-change="emit('properties.change', row.id)"></number-field>
            <div class="joined" data-for="v : row.vector">
              <number-field class="field number" data-for="a : v.axes" data-attr-value="a.value" data-attr-step="a.step" data-attr-precision="a.precision" data-attr-addon="a.label" data-attr-data-axis="a.key" data-attrif-data-overridden="row.overridden" data-attrif-readonly="row.readonly" data-attrif-mixed="row.mixed" data-event-change="emit('properties.change', row.id)"></number-field>
            </div>
            <div class="check" data-for="b : row.bool" data-attrif-data-checked="b.value" data-attrif-data-readonly="row.readonly" data-attrif-data-mixed="row.mixed" data-event-click="emit('properties.toggle', row.id)">
              <span class="box"><span class="icon">&#xeab2;</span><span class="icon dash">&#xeacc;</span></span>
            </div>
            <div class="field select" data-for="c : row.choice" data-attrif-data-readonly="row.readonly" data-attrif-data-mixed="row.mixed" data-event-click="emit('properties.choose', row.id)">
              <span class="part value">{{ c.label }}</span>
              <span class="icon caret">&#xeab4;</span>
            </div>
            <div class="field color" data-for="c : row.color" data-attrif-data-readonly="row.readonly" data-attrif-data-mixed="row.mixed" data-event-click="emit('properties.color', row.id)">
              <div class="mark"/>
              <div class="swatch" data-style-background-color="c.css"/>
            </div>
            <div class="field text" data-for="t : row.text" data-attrif-data-readonly="row.readonly">
              <span class="part value">{{ t.value }}</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
/* An asset's tile (projects/studio's Tile, in Assets' grid), after Unity's
   Project window and Unreal's Content Browser: a thumbnail over a name,
   with the asset's kind badged in the picture's corner. Until a thumbnail
   is ready the tile shows its kind's icon, as a skeleton; while a partly
   loaded one shows, a spinner marks the other corner. The picture is a
   decorator and the skeleton hides by visibility, so a thumbnail arriving
   lays nothing out. */

.tile {
    display: flex; flex-direction: column; box-sizing: border-box; padding: 3dp;
    border: 1dp transparent; border-radius: var(--r-lg); tab-index: none;
    transition: background-color 0.11s cubic-out;
}
.tile:hover { background-color: var(--accent); }
.tile[data-selected] { background-color: var(--selected); }
.tile-art {
    position: relative; display: block; flex: 1 1 0dp; overflow: hidden;
    border-radius: var(--r); background-color: var(--muted); pointer-events: none;
}
.tile .glyph {
    position: absolute; left: 0dp; top: 50%; width: 100%; height: 24dp; margin-top: -12dp;
    line-height: 24dp; text-align: center; font-size: 20dp; color: var(--faint-foreground);
}
.tile[data-unresolved] .glyph { color: var(--warning); }
.tile .picture { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
.tile[data-ready] .glyph { visibility: hidden; }
.tile .badge {
    position: absolute; right: 3dp; bottom: 3dp; padding: 2dp; border-radius: 3dp;
    font-size: 10dp; line-height: 10dp; color: #ffffffd9; background-color: #0000008c;
}
.tile:not([data-ready]) .badge { visibility: hidden; }
/* More of the picture is loading, as a scene's streamed terrain: a spinner
   on a round chip like the badge's, in the opposite corner. */
.tile .spin {
    position: absolute; left: 3dp; bottom: 3dp; width: 14dp; height: 14dp; border-radius: 7dp;
    font-size: 10dp; line-height: 14dp; text-align: center;
    color: #ffffffd9; background-color: #0000008c;
    animation: 0.9s linear infinite tile-spin;
}
.tile:not([data-loading]) .spin { display: none; }
@keyframes tile-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.tile .name {
    display: block; height: 18dp; line-height: 18dp; padding: 0dp 2dp; text-align: center;
    font-size: var(--studio-font-11, 11dp); color: var(--foreground); pointer-events: none;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tile[data-selected] .name { color: var(--strong); }

/* Unreal's hover thumbnail: the large preview above the tooltip's text,
   which keeps to its width. */
.tooltip[data-image] { width: 256dp; }
.tooltip .tip-image { display: block; width: 256dp; height: 256dp; margin: 0.28em 0em 0.5em; border-radius: var(--r); }
.tooltip[data-image] .tip-head span { overflow: hidden; text-overflow: ellipsis; }
/* Resets, text helpers and scrollbars. */
* { box-sizing: border-box; }
div, section, header, nav, main, footer, p { display: block; }
body { font-family: var(--studio-standard-font-family, geist); font-size: var(--studio-font-13, 13dp); line-height: var(--studio-line-18, 18dp); color: var(--foreground); }

.icon { font-family: Symbols; font-size: 14dp; line-height: var(--studio-line-16, 16dp); width: 16dp; text-align: center; display: inline-block; color: var(--muted-foreground); }
.icon.sm { font-size: 12dp; width: 12dp; }
.dim { color: var(--faint-foreground); }
.muted { color: var(--muted-foreground); }
.spacer { flex: 1 1 0dp; }
.row { display: flex; align-items: center; gap: 6dp; }

scrollbarvertical { width: 10dp; margin-left: 0dp; }
scrollbarvertical slidertrack { background-color: transparent; }
scrollbarvertical sliderbar { margin: 2dp; border-radius: 3dp; background-color: var(--scrollbar); }
scrollbarvertical sliderbar:hover { background-color: var(--scrollbar-hover); }
scrollbarhorizontal { height: 10dp; }
scrollbarhorizontal sliderbar { margin: 2dp; border-radius: 3dp; background-color: var(--scrollbar); }
scrollbarcorner { background-color: transparent; }
/* Button: ghost, subtle, primary, outline and danger. Press feedback is
   immediate in color and a quick ease-out shrink in size, so a press feels
   heard (Emil: scale 0.97 on :active, transform only, under 160 ms). */
.btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6dp;
    height: var(--h); padding: 0dp 8dp; border-radius: var(--r); white-space: nowrap;
    color: var(--muted-foreground); background-color: transparent; border: 1dp transparent;
    tab-index: auto;
    transition: background-color color 0.11s cubic-out, transform 0.14s cubic-out;
}
.btn .label { white-space: nowrap; }
.btn:hover { background-color: var(--accent); color: var(--foreground); }
.btn:hover .icon { color: var(--foreground); }
.btn:active, .btn[data-pressed] {
    background-color: var(--press); color: var(--foreground);
    transform: scale(0.97); transition: transform 0.14s cubic-out;
}
.btn[data-disabled] { opacity: 0.38; }
.btn[data-disabled]:active { transform: none; }
.btn:focus-visible { border-color: var(--ring); background-color: var(--accent); color: var(--foreground); }
.btn.subtle { background-color: var(--secondary); color: var(--foreground); }
.btn.subtle:hover { background-color: var(--field-hover); }
.btn.primary { background-color: var(--primary); color: var(--primary-foreground); }
.btn.primary .icon { color: var(--primary-foreground); }
.btn.primary:hover, .btn.primary:active, .btn.primary[data-pressed] { background-color: var(--primary-hover); color: var(--primary-foreground); }
.btn.outline { border-color: var(--border); color: var(--foreground); }
.btn.danger { color: var(--destructive); }
.btn.icon-only { width: var(--h); padding: 0dp; }
.btn.sm { height: var(--h-sm); font-size: var(--studio-font-11, 11dp); padding: 0dp 6dp; }
.btn.sm.icon-only { width: var(--h-sm); padding: 0dp; }
.btn[data-state=on] { background-color: var(--primary-soft); color: var(--foreground); }
.btn[data-state=on] .icon { color: var(--primary-text); }

/* Toggle group — Blender's expanded enum. */
.segmented { display: flex; height: var(--h); background-color: var(--secondary); border-radius: var(--r); flex: 1 1 0dp; }
.segmented .seg {
    display: block; text-align: center; line-height: var(--h); flex: 1 1 0dp;
    padding: 0dp 8dp; color: var(--muted-foreground); border: 1dp transparent; border-left-color: var(--edge); white-space: nowrap;
    transition: background-color 0.11s cubic-out;
}
.segmented .seg:first-child { border-left: 0dp; border-radius: 4dp 0dp 0dp 4dp; }
.segmented .seg:last-child { border-radius: 0dp 4dp 4dp 0dp; }
.segmented .seg:hover { background-color: var(--field-hover); color: var(--foreground); }
.segmented .seg[data-pressed] { background-color: var(--primary); color: var(--primary-foreground); }
.segmented .seg[data-state=on] { background-color: var(--primary); color: var(--primary-foreground); }
.segmented[data-readonly] { opacity: 0.6; }
.segmented[data-disabled] { opacity: 0.45; }
.segmented .seg:focus-visible { border-color: var(--ring); background-color: var(--field-hover); color: var(--foreground); }
.segmented .seg[data-pressed]:focus-visible { background-color: var(--primary); color: var(--primary-foreground); }

@media (theme: reduced-motion) {
  .btn:active, .btn[data-pressed] { transform: none; }
}
/* Charts (Liveline): <line-chart> (src/ui/controls) draws its first series
   in `color` and the grid in `border-color`, and places its labels. */
line-chart { display: block; position: relative; color: var(--primary-text); border-color: var(--line); border-width: 0dp; }
.chart-tick { position: absolute; left: 4dp; font-size: var(--studio-font-10, 10dp); line-height: var(--studio-line-14, 14dp); color: var(--faint-foreground); pointer-events: none; font-family: var(--font-numeric); }
.chart-badge { position: absolute; right: 4dp; height: var(--studio-height-18, 18dp); line-height: var(--studio-line-18, 18dp); padding: 0dp 6dp; border-radius: 9dp; background-color: var(--primary); color: var(--primary-foreground); font-size: var(--studio-font-10, 10dp); font-family: var(--font-numeric); pointer-events: none; }
.chart-hover { position: absolute; top: 4dp; height: var(--studio-height-18, 18dp); line-height: var(--studio-line-18, 18dp); padding: 0dp 6dp; border-radius: var(--r); background-color: var(--tooltip); border: 1dp var(--tooltip-edge); color: var(--foreground); font-size: var(--studio-font-10, 10dp); font-family: var(--font-numeric); pointer-events: none; }
body:not(.dark) .chart-hover { color: #fafafa; }
/* Code tokens (Shiki classes). */
.tok-number { color: var(--tok-number); }
.tok-string { color: var(--tok-string); }
.tok-keyword { color: var(--tok-keyword); }
.tok-name { color: var(--tok-name); }
.tok-path { color: var(--tok-path); }
.tok-punct { color: var(--tok-punct); }
.tok-muted { color: var(--faint-foreground); }
.tok-error { color: var(--destructive); }
.tok-warning { color: var(--warning); }

/* Refined ui tokens (ui_source_kind_class): a span's second class overrides
   its first, so these follow the base classes. After VS Code's Light+ and
   Dark+. */
body {
    --tok-tag: #800000; --tok-attribute: #e50000; --tok-selector: #800000;
    --tok-property: #e50000; --tok-variable: #001080; --tok-binding: #795e26;
}
.dark {
    --tok-tag: #569cd6; --tok-attribute: #9cdcfe; --tok-selector: #d7ba7d;
    --tok-property: #9cdcfe; --tok-variable: #4fc1ff; --tok-binding: #dcdcaa;
}
.tok-tag { color: var(--tok-tag); }
.tok-attribute { color: var(--tok-attribute); }
.tok-selector { color: var(--tok-selector); }
.tok-property { color: var(--tok-property); }
.tok-variable { color: var(--tok-variable); }
.tok-binding { color: var(--tok-binding); }

/* The code editor (kit_code). Zep draws it; each hidden swatch hands one of
   its roles the color set here, and the tok-* classes above color the tokens. */
kit-code {
    display: block; position: relative; overflow: hidden; cursor: text;
    tab-index: auto; drag: drag; font-family: var(--studio-code-font-family, jetbrains mono);
}
kit-code > span { visibility: hidden; position: absolute; width: 0dp; height: 0dp; }
kit-code .zep-text { color: var(--foreground); }
kit-code .zep-background { color: var(--canvas); }
kit-code .zep-gutter { color: var(--canvas); }
kit-code .zep-line-number { color: var(--faint-foreground); }
kit-code .zep-line-number-active { color: var(--muted-foreground); }
kit-code .zep-cursor { color: var(--foreground); }
kit-code .zep-cursor-insert { color: var(--foreground); }
kit-code .zep-selection { color: var(--primary-wash); }
kit-code .zep-cursor-line { color: var(--item-selected); }
/* Zep also marks the glyph under the pointer in the status color. */
kit-code .zep-status { color: transparent; }
kit-code .zep-mode { color: var(--primary); }
kit-code .zep-whitespace { color: var(--line); }
kit-code .zep-scrollbar-track { color: transparent; }
kit-code .zep-scrollbar { color: var(--scrollbar); }
kit-code .zep-scrollbar-hover { color: var(--scrollbar-hover); }
kit-code .zep-tip-border { color: var(--tooltip-edge); }
kit-code .zep-flash { color: var(--highlight); }
kit-code .zep-info { color: var(--primary); }
kit-code .zep-breakpoint { color: var(--destructive); }
/* The primary modifier over a symbol with a definition: a link to it. */
kit-code[data-link] { cursor: pointer; }

/* Completion surfaces share compact rows and keep names, types and matches distinct. */
body { --autocomplete-row-h: var(--studio-mono-line-20, 20dp); }
.code-completions {
    position: absolute; pointer-events: auto; background-color: var(--popover); border: 1dp var(--popover-edge);
    width: 420dp; max-width: 420dp; display: block; z-index: 20;
    overflow-x: hidden; overflow-y: auto; box-shadow: var(--shadow-overlay);
}
.code-completions, .popup.autocomplete {
    padding: 3dp; border-radius: var(--r-lg);
    border-color: color-mix(in srgb, var(--foreground) 16%, var(--popover));
    font-family: var(--studio-code-font-family, jetbrains mono);
    font-size: var(--studio-mono-font-12, 12dp);
}
.code-completion, .popup.autocomplete .menu-item {
    display: flex; align-items: center; height: var(--autocomplete-row-h);
    gap: 6dp; padding: 0dp 5dp; border-radius: var(--r);
    white-space: nowrap; color: var(--foreground);
}
.code-completion .detail, .popup.autocomplete .detail {
    margin-left: auto; padding-left: 8dp; flex: 1 1 0dp; min-width: 0dp;
    overflow: hidden; text-overflow: ellipsis;
    font-family: var(--studio-code-font-family, jetbrains mono); color: var(--tok-keyword);
}
.popup.autocomplete .menu-group { height: var(--autocomplete-row-h); line-height: var(--autocomplete-row-h); font-family: var(--studio-standard-font-family, inter); }
.code-completion[data-highlighted],
.popup.autocomplete .menu-item[data-highlighted] { background-color: var(--accent); color: var(--foreground); }
.popup.autocomplete .menu-item .lead,
.popup.autocomplete .menu-item[data-highlighted] .lead { color: var(--primary-text); }
.code-completion[data-highlighted] .detail,
.popup.autocomplete .menu-item[data-highlighted] .detail { color: var(--tok-keyword); }
.code-completion .lead { color: var(--primary-text); flex: 0 0 auto; }
.code-completion .label, .popup.autocomplete .label {
    display: block; flex: 0 0 auto; min-width: 0dp; max-width: 260dp;
    overflow: hidden; text-overflow: ellipsis;
}
.code-completion .detail[data-empty], .popup.autocomplete .detail[data-empty] { display: none; }
.popup.autocomplete { transition: none; overflow-y: auto; }
.code-completion b, .code-completion[data-highlighted] b,
.popup.autocomplete .label b,
.popup.autocomplete .menu-item[data-highlighted] .label b { color: var(--primary-text); }
/* Graph field completion keeps wheel and keyboard scrolling without scrollbar chrome. */
.popup.autocomplete scrollbarvertical { width: 0dp; margin-left: 0dp; visibility: hidden; }
.popup.autocomplete scrollbarhorizontal { height: 0dp; visibility: hidden; }
.field.autocomplete[data-open] .value { font-family: var(--studio-code-font-family, jetbrains mono); }

/* The hover card: the diagnostics of the line under the resting pointer, then
   what the pointer rests on. It lives in the overlay layer, so it never clips
   at the editor's edge, and fades as the kit's tooltips do. */
.code-hover {
    position: absolute; pointer-events: none; display: block; z-index: 30; max-width: 520dp;
    background-color: var(--popover); border: 1dp var(--popover-edge); border-radius: var(--r-lg);
    box-shadow: var(--shadow-overlay); padding: 6dp 8dp; color: var(--foreground); font-size: var(--studio-mono-font-12, 12dp); line-height: var(--studio-mono-line-17, 17dp);
}
.code-hover { opacity: 1; transition: opacity 0.1s cubic-out; }
.code-hover[data-starting-style], .code-hover[data-ending-style] { opacity: 0; }
.code-hover-problem { display: flex; align-items: flex-start; gap: 6dp; }
.code-hover-problem + .code-hover-problem { margin-top: 4dp; }
.code-hover-problem .icon { flex: 0 0 auto; line-height: var(--studio-mono-line-17, 17dp); color: var(--primary); }
.code-hover-problem[data-severity="error"] .icon { color: var(--destructive); }
.code-hover-problem[data-severity="warning"] .icon { color: var(--warning); }
.code-hover-problem .message { flex: 1 1 auto; white-space: normal; }
.code-hover-title { display: block; font-family: var(--studio-code-font-family, jetbrains mono); white-space: nowrap; }
.code-hover-problem + .code-hover-title { margin-top: 6dp; padding-top: 6dp; border-top: 1dp var(--line); }
.code-hover-line { display: block; font-family: var(--studio-code-font-family, jetbrains mono); font-size: var(--studio-mono-font-11, 11dp); color: var(--muted-foreground); white-space: nowrap; }

/* Find floats over the text as the other overlays do. */
.code-editor .find-widget { box-shadow: var(--shadow-overlay); }

/* The Text Editor's header: Vim's mode, and the count of problems, which
   steps to the next. */
.code-mode {
    flex: 0 0 auto; margin-right: 4dp; padding: 0dp 5dp; border: 1dp var(--line); border-radius: var(--r);
    font-family: var(--studio-code-font-family, jetbrains mono); font-size: var(--studio-mono-font-10, 10dp); line-height: var(--studio-mono-line-16, 16dp); color: var(--muted-foreground);
}
.code-problems .icon { color: var(--warning); }
.code-problems.errors .icon { color: var(--destructive); }
.code-problems.clear .icon { color: var(--muted-foreground); }
/* Color picker popover: vertex gradients need no shader support. */
.popup.picker { width: 232dp; padding: 8dp; }
.picker .sv { position: relative; height: 150dp; border-radius: 4dp; drag: drag; cursor: crosshair; }
.picker .sv-white { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; border-radius: 4dp; decorator: horizontal-gradient(#ffffffff #ffffff00); }
.picker .sv-black { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; border-radius: 4dp; decorator: vertical-gradient(#00000000 #000000ff); }
.picker .sv .puck { position: absolute; width: 10dp; height: 10dp; margin: -5dp 0dp 0dp -5dp; border-radius: 5dp; border: 2dp #ffffff; }
.picker .hue { position: relative; display: flex; height: 12dp; border-radius: 3dp; margin-top: 8dp; drag: drag; }
.picker .hue-seg { flex: 1 1 0dp; height: 100%; }
.picker .hue .puck { position: absolute; top: 0dp; bottom: 0dp; width: 4dp; margin-left: -2dp; background-color: #ffffff; border-radius: 1dp; }
.picker .hexrow { margin-top: 8dp; }
.picker .hexrow input.value { width: 100%; font-family: var(--font-numeric); }
.picker .hexrow[data-invalid] { border-color: var(--destructive); }
.picker .prop { margin-top: 8dp; }
.picker .prop .label { width: 60dp; justify-content: flex-start; }
/* Drag and drop (dnd-kit): the overlay follows the pointer; targets light up. */
.drag-overlay {
    position: absolute; display: flex; align-items: center; gap: 6dp; height: var(--studio-height-24, 24dp); padding: 0dp 8dp;
    background-color: var(--popover); border: 1dp var(--popover-edge); border-radius: var(--r); color: var(--foreground);
    pointer-events: none; z-index: 45; white-space: nowrap; opacity: 0.92;
    transition: opacity 0.12s cubic-out;
}
.drag-overlay[data-starting-style], .drag-overlay[data-ending-style] { opacity: 0; }
.drag-overlay .text { display: flex; flex-direction: column; }
.drag-overlay .label { display: block; line-height: var(--studio-line-16, 16dp); }
/* What a drop does where the pointer is: a second line. */
.drag-overlay .hint { display: none; font-size: var(--studio-font-11, 11dp); line-height: var(--studio-line-14, 14dp); color: var(--muted-foreground); }
.drag-overlay[data-hint] { height: auto; padding: 4dp 8dp; }
.drag-overlay[data-hint] .hint { display: block; }
.drag-overlay[data-over] { border-color: var(--primary); }
[data-dragging] { opacity: 0.5; }
/* Fields and rows that take the dragged asset (studio_drop.c), then the one
   under the pointer. */
.field.picker[data-drop-accept], .tree-row[data-drop-accept] { border-color: var(--primary-edge); }
[data-drop-over] { background-color: var(--primary-soft); }
.tree-row[data-drop-over] { border-color: var(--primary); }
.field.picker[data-drop-over] { border-color: var(--primary); background-color: var(--primary-soft); }
.field.select.picker[data-drop-preview] .value { color: var(--primary); }
/* Field shell (shadcn Input Group): addon, value, unit, stepper arrows. The
   native <number-field> and <color-field> (src/ui/controls/controls.h) build
   their parts and reflect their state as data-*; a color field's picker lives
   inside it, so part rules use child combinators to stay off the picker's. */
.field {
    position: relative; display: flex; align-items: center; height: var(--h); flex: 1 1 0dp;
    background-color: var(--secondary); border-radius: var(--r); color: var(--foreground); overflow: hidden;
    border: 1dp var(--input);
    transition: background-color 0.11s cubic-out;
}
.field:hover { background-color: var(--field-hover); }
.field[data-disabled] { opacity: 0.45; }
.field[data-readonly] { background-color: transparent; border-color: var(--border); }
.field[data-readonly] > .step { display: none; }
.field[data-editing] { background-color: var(--field-edit); border-color: var(--ring); }
.field[data-invalid] { border-color: var(--destructive); }
.field[data-scrubbing] { background-color: var(--field-press); }
.field:focus-visible { border-color: var(--ring); }
.field.number { tab-index: auto; drag: drag; cursor: ew-resize; }
.field.number[data-readonly], .field.number[data-disabled] { cursor: arrow; }
.field.number[data-disabled] { tab-index: none; }
.field > .fill { position: absolute; left: 0dp; top: 0dp; bottom: 0dp; background-color: var(--fill); pointer-events: none; }
.field:hover > .fill, .field[data-scrubbing] > .fill { background-color: var(--fill-hover); }
.field > .mark { position: absolute; left: 0dp; top: 3dp; bottom: 3dp; width: 2dp; border-radius: 1dp; background-color: transparent; }
.field[data-overridden] > .mark { background-color: var(--override); }
.field[data-mixed] > .value { color: var(--muted-foreground); }
.field.color[data-mixed] > .swatch { opacity: 0.35; }
.field .part { position: relative; display: block; height: var(--text-line); line-height: var(--text-line); }
.field .addon { padding-left: 7dp; color: var(--faint-foreground); flex: 0 0 auto; }
.field[data-axis=x] > .addon { color: var(--axis-x); }
.field[data-axis=y] > .addon { color: var(--axis-y); }
.field .value {
    flex: 1 1 0dp; padding: 0dp 7dp; text-align: right;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: var(--font-numeric);
}
.field .unit { padding-right: 7dp; color: var(--faint-foreground); flex: 0 0 auto; margin-left: -4dp; }
/* RmlUi sizes the insertion caret from line-height. Keep the input hit box
   full-height and center the shorter text line inside it with padding. */
.field input.value {
    height: var(--text-line); line-height: var(--input-line); padding-top: var(--input-pad); padding-bottom: var(--input-pad);
    cursor: text; font-family: var(--studio-standard-font-family, inter); color: var(--foreground);
}
.field.number input.value { font-family: var(--font-numeric); }
.field input.value selection { background-color: var(--primary); color: var(--primary-foreground); }
.field .step {
    position: absolute; top: 0dp; bottom: 0dp; width: 14dp; display: flex; align-items: center; justify-content: center;
    color: var(--muted-foreground); opacity: 0; transition: opacity 0.11s cubic-out; cursor: arrow;
}
.field .step .icon { font-size: 10dp; width: 10dp; }
.field .step.dec { left: 0dp; }
.field .step.inc { right: 0dp; }
.field:hover > .step { opacity: 1; }
.field[data-slider] > .step, .field[data-editing] > .step, .field[data-scrubbing] > .step { opacity: 0; }
.field .step:hover { background-color: var(--press); }
.field.text:focus-within, .field.search:focus-within, .field.autocomplete:focus-within { border-color: var(--ring); }
.field.text, .field.search, .field.autocomplete { background-color: var(--field-edit); cursor: text; }
.field.text:hover, .field.search:hover, .field.autocomplete:hover { background-color: var(--input-hover); }
.field.text .value, .field.search .value, .field.autocomplete .value { text-align: left; font-family: var(--studio-standard-font-family, inter); }
.field.text input.value, .field.search input.value, .field.autocomplete input.value { width: 100%; padding: var(--input-pad) 7dp; }
.field.search .addon { padding-left: 6dp; }
.field.search .addon .icon { color: var(--faint-foreground); }
.field.search input.value { padding-left: 5dp; }
.field.area { display: block; height: auto; }
.field.area textarea.value {
    display: block; width: 100%; height: auto; padding: 2dp 7dp; line-height: var(--studio-line-16, 16dp); cursor: text;
    font-family: var(--studio-standard-font-family, inter); color: var(--foreground); text-align: left; white-space: pre-wrap; overflow-y: auto;
}
.field.area textarea.value selection { background-color: var(--primary); color: var(--primary-foreground); }

/* Joined vector: components share one control. */
.joined { display: flex; flex: 1 1 0dp; gap: 1dp; }
.joined .field { border-radius: 0dp; }
.joined .field:first-child { border-radius: 4dp 0dp 0dp 4dp; }
.joined .field:last-child { border-radius: 0dp 4dp 4dp 0dp; }

/* Select trigger. */
.field.select { justify-content: flex-start; padding: 0dp 4dp 0dp 8dp; gap: 6dp; cursor: arrow; tab-index: auto; }
.field.select .value { padding: 0dp; text-align: left; font-family: var(--studio-standard-font-family, inter); }
.field.select .caret { color: var(--faint-foreground); width: 14dp; }
.field.select[data-open] { background-color: var(--field-edit); }

/* Color field. */
.field.color { cursor: arrow; tab-index: auto; }
.field.color:focus-visible { border-color: var(--ring); }
.field.color[data-disabled] { tab-index: none; }
.field.color > .swatch { position: absolute; left: 3dp; right: 3dp; top: 3dp; bottom: 3dp; border-radius: 2dp; }
/* No color (zero alpha, which reflected fields read as their default): the
   "no fill" slash of Figma and Photoshop, so it never reads as an empty box. */
.field.color > .swatch.none {
    border: 1dp var(--border);
    decorator: linear-gradient(to bottom right, #00000000 46%, var(--faint-foreground) 47%, var(--faint-foreground) 53%, #00000000 54%);
}
.color-alpha-row { display: flex; align-items: center; gap: 4dp; width: 100%; }
.color-alpha-row .field.color { flex: 0 0 48dp; }

/* Checkbox. */
.check { display: inline-flex; align-items: center; gap: 7dp; height: var(--h); color: var(--foreground); tab-index: auto; }
.check .box {
    width: 14dp; height: 14dp; border-radius: 3dp; background-color: var(--secondary); border: 1dp var(--input);
    display: flex; align-items: center; justify-content: center;
    transition: background-color 0.11s cubic-out;
}
.check:hover .box { background-color: var(--field-hover); }
.check:focus-visible .box { border-color: var(--ring); }
.check .box .icon { font-size: 11dp; width: 12dp; color: var(--primary-foreground); opacity: 0; }
.check[data-checked] .box { background-color: var(--primary); border-color: var(--primary); }
.check[data-checked] .box .icon { opacity: 1; }
/* Mixed values (Unity's): a dash for several objects' differing values. */
.check .box .icon.dash { display: none; }
.check[data-mixed] .box { background-color: var(--primary); border-color: var(--primary); }
.check[data-mixed] .box .icon { display: none; }
.check[data-mixed] .box .icon.dash { display: block; opacity: 1; }
.check[data-disabled], .check[data-readonly] { opacity: 0.5; }
.check[data-disabled] { tab-index: none; }

/* Asset field (kit_picker): a select trigger that opens a search over assets. */
.field.select.picker { tab-index: auto; }
.field.select.picker .lead { color: var(--muted-foreground); width: 14dp; font-size: var(--studio-font-12, 12dp); }
.field.select.picker[data-placeholder] .value { color: var(--faint-foreground); }

/* The shadcn Input anatomy applies to editable fields in the reusable popover. */
.popover .field.text, .popover .field.search {
    height: var(--studio-height-36, 36dp); flex: 0 0 auto; background-color: transparent; border-color: var(--input);
    border-radius: var(--r, 4dp);
}
body.comfortable .popover .field.text, body.comfortable .popover .field.search {
    height: var(--studio-height-40, 40dp);
}
.dark .popover .field.text, .dark .popover .field.search {
    background-color: color-mix(in srgb, var(--input) 30%, transparent);
}
.popover .field.text:hover, .popover .field.search:hover { background-color: var(--input-hover); }
.dark .popover .field.text:hover, .dark .popover .field.search:hover {
    background-color: color-mix(in srgb, var(--input) 42%, transparent);
}
.popover .field.text input.value, .popover .field.search input.value {
    width: 100%; height: var(--studio-line-20, 20dp); padding: 0dp var(--studio-height-12, 12dp);
    background-color: transparent; color: var(--foreground); font-size: var(--studio-font-14, 14dp);
    line-height: var(--studio-line-20, 20dp); border-radius: var(--r, 4dp);
}
.popover .field.text[data-editing], .popover .field.text:focus-within,
.popover .field.search[data-editing], .popover .field.search:focus-within {
    background-color: var(--popover); border-color: var(--ring);
    box-shadow: 0dp 0dp 0dp 3dp color-mix(in srgb, var(--ring) 50%, transparent);
}
.dark .popover .field.text[data-editing], .dark .popover .field.text:focus-within,
.dark .popover .field.search[data-editing], .dark .popover .field.search:focus-within {
    background-color: color-mix(in srgb, var(--input) 30%, transparent);
}
/* The behavior graph canvas (studio_graph.c, the kit's graph.rml), ported
   from the Studio prototype's graph styles. This document lives in its own
   context whose dp ratio is the zoom, so every length here is in graph units
   and scales with the view. */

body.graph-canvas {
    width: 100%; height: 100%; margin: 0dp; padding: 0dp; overflow: hidden;
    background-color: var(--canvas);
    /* Graph geometry keeps its own fixed pitch at every application density. */
    --h: 22dp; --text-line: 20dp; --input-line: 16dp; --input-pad: 2dp; --h-sm: 18dp; --row: 22dp; --gap: 2dp;
    /* Node categories. */
    --n-event: #7a2f42;
    --n-flow: #46464e;
    --n-pure: #2f4a36;
    --n-function: #2d4f7a;
    --n-variable: #5a3a2c;
    --n-literal: #6b5530;
    --n-expr: #245e6c;
    --n-call: #2d5a3c;
    --node: var(--card);
    --node-edge: var(--border);
    --chip: var(--muted);
    --chip-fg: var(--tok-keyword);
    --conversion: var(--popover);
    --selected-object: #e0701c;
    --active-object: #ffa53a;
    --bubble: #e6e2cbf2;
    --bubble-fg: #1f1f22;
    /* The debug target's activity: the running rim takes the execution
       wire's color, and live value chips sit on the canvas. */
    --flow-running: #e8e8ea8c;
    --live-chip: #1d1d21e6;
}
/* Light canvases keep full-color titles in lighter tints (Blender's light theme). */
body.graph-canvas:not(.dark) {
    --n-event: #e8cbd4;
    --n-flow: #d7dce5;
    --n-pure: #d0e4d6;
    --n-function: #cadbf0;
    --n-variable: #e8d7cb;
    --n-literal: #ebdfbd;
    --n-expr: #c8e2e6;
    --n-call: #cce1d1;
    --bubble: #fff6ccf2;
    --flow-running: #52525b8c;
    --live-chip: #ffffffe6;
}

#back, #front { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: none; }
#world { position: absolute; left: 0dp; top: 0dp; width: 0dp; height: 0dp; }
.wires { display: block; position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: none; }
.stage { position: absolute; left: 0dp; top: 0dp; width: 0dp; height: 0dp; }

/* measure_node sizes nodes; widths come from C. */
.gnode {
    position: absolute;
    background-color: var(--node); border: 1dp var(--node-edge); border-radius: var(--r-lg);
    color: var(--foreground); font-size: var(--studio-font-12, 12dp);
}
.gnode[data-error] { border-color: var(--destructive); }
.gnode[data-warning] { border-color: var(--warning); }
.gnode[data-selected] { border-color: var(--selected-object); z-index: 2; }
.gnode[data-active] { border-color: var(--active-object); }
.gnode[data-dim] { opacity: 0.45; }
.gnode[data-breakpoint] .gnode-head { border-left: 4dp #e5534b; }
/* A disabled (muted) node reads apart from an unused, dimmed one: its title
   greys and is struck through, and its wires draw red (Blender). */
.gnode[data-disabled] { opacity: 0.6; }

.gnode-head {
    position: relative; display: flex; align-items: center; gap: 6dp; height: var(--studio-height-24, 24dp); padding: 0dp 10dp;
    border-radius: 5dp 5dp 0dp 0dp; color: #ffffff; background-color: var(--n-pure);
}
.gnode-head:last-child { border-radius: 5dp; }
/* Unlabeled execution pins sit on the title's edges (Unity Visual Scripting). */
.hpin { position: absolute; top: 0dp; width: 0dp; height: var(--studio-height-24, 24dp); }
/* The pins sit on the node's outer edge, past its 1 dp border. */
.hpin.in { left: -1dp; }
.hpin.out { right: -1dp; }
.hpin > .socket { top: 4dp; }
.gnode-head .icon { color: #ffffffcc; font-size: 12dp; width: 14dp; }
.gnode-head .title { display: block; flex: 1 1 auto; white-space: nowrap; overflow: hidden; font-weight: 600; line-height: var(--studio-line-24, 24dp); }
.gnode-head .symbol { display: block; font-weight: 700; font-size: var(--studio-font-14, 14dp); line-height: var(--studio-line-24, 24dp); }
.gnode[data-kind=event] .gnode-head { background-color: var(--n-event); }
.gnode[data-kind=flow] .gnode-head { background-color: var(--n-flow); }
.gnode[data-kind=function] .gnode-head { background-color: var(--n-function); }
.gnode[data-kind=variable] .gnode-head { background-color: var(--n-variable); }
.gnode[data-kind=literal] .gnode-head { background-color: var(--n-literal); }
.gnode[data-kind=call] .gnode-head { background-color: var(--n-call); }
.gnode[data-kind=expression] .gnode-head { background-color: var(--n-expr); }

body.graph-canvas:not(.dark) .gnode-head, body.graph-canvas:not(.dark) .gnode-head .icon { color: #28313e; }
.gnode[data-disabled] .gnode-head { background-color: var(--muted); }
.gnode[data-disabled] .gnode-head, .gnode[data-disabled] .gnode-head .icon { color: var(--muted-foreground); }
.gnode[data-disabled] .gnode-head .title { text-decoration: line-through; }

/* Rows sit on a fixed pitch, which pin_y assumes: row i's socket is at head (24)
   + pad (4) + (i + 0.5) * 22 below the node's border, after any code. Execution
   pins pair up first, then data outputs, then data inputs (Blender's order). */
.gnode-body { display: block; padding: 4dp 0dp 6dp; }
.grow { position: relative; display: flex; align-items: center; gap: 6dp; height: var(--studio-height-22, 22dp); padding: 0dp 10dp; }
.grow.out { justify-content: flex-end; }
.grow.exec { padding: 0dp; gap: 12dp; }
.ghalf { position: relative; display: flex; align-items: center; gap: 6dp; height: var(--studio-height-22, 22dp); }
.ghalf.in { padding-left: 10dp; }
.ghalf.out { padding-right: 10dp; margin-left: auto; justify-content: flex-end; }
/* Labels and fields stay inside the node; the full label remains in its tooltip. */
.gpin-label { display: block; flex: 0 1 auto; min-width: 0dp; max-width: 100%; overflow: hidden; text-overflow: ellipsis; color: var(--muted-foreground); white-space: nowrap; line-height: var(--studio-line-22, 22dp); }
.gpin-label[data-fits] { overflow: visible; text-overflow: clip; }
.out > .gpin-label { text-align: right; }
/* A half row sizes to its label, which a percentage cap would collapse. */
.ghalf > .gpin-label { flex-shrink: 0; max-width: none; }
[data-hover] > .gpin-label { color: var(--foreground); }
.grow .field { flex: 1 1 auto; min-width: 0dp; height: var(--studio-height-18, 18dp); }
/* A refused entry stays red while focused (field.rcss rings a focused one). */
.grow .field.autocomplete[data-invalid] { border-color: var(--destructive); }
.grow.out .field { flex: 0 0 64dp; }
.grow .field .part { height: var(--studio-height-16, 16dp); line-height: var(--studio-line-16, 16dp); }
/* Compact graph fields have a 16 dp inner box. Shell input padding would
   clip the glyphs and caret inside that box. */
.grow .field input.value { padding-top: 0dp; padding-bottom: 0dp; }
.grow .segmented { height: var(--studio-height-18, 18dp); }
.grow .check { flex: 0 0 auto; }
/* Editors and chips fill the row to the node's edge, so their right edges align. */
.grow .chip {
    display: flex; align-items: center; gap: 4dp; flex: 1 1 auto; min-width: 0dp; height: var(--studio-height-18, 18dp);
    padding: 0dp 6dp; border-radius: 3dp; background-color: var(--chip); color: var(--chip-fg);
    font-size: var(--studio-font-11, 11dp); line-height: var(--studio-line-18, 18dp); overflow: hidden;
}
.grow .chip .icon { flex: 0 0 auto; width: 12dp; font-size: 11dp; line-height: var(--studio-line-18, 18dp); color: var(--faint-foreground); }
.grow .chip.source { color: var(--tok-name); }
.graph-inline-values { min-width: 320dp; max-width: 480dp; max-height: 460dp; overflow-y: auto; }
.graph-inline-heading { display: block; margin: 2dp 4dp 6dp; color: var(--muted-foreground); font-size: var(--studio-font-11, 11dp); font-weight: 600; }
.graph-inline-node { display: block; padding: 2dp 0dp 4dp; border-top: 1dp var(--border); }
.graph-inline-title { display: block; padding: 4dp 6dp 2dp; color: var(--foreground); font-weight: 600; }
.graph-inline-row { display: flex; align-items: center; gap: 8dp; min-height: 26dp; padding: 2dp 4dp; }
.graph-inline-label { display: block; flex: 0 0 104dp; overflow: hidden; color: var(--muted-foreground); white-space: nowrap; }
.graph-inline-row .field { flex: 1 1 auto; min-width: 0dp; }
/* Bind to Source sits after a compound value's editor, quiet until hovered. */
.grow .gbind { flex: 0 0 auto; color: var(--faint-foreground); }
.grow .gbind:hover { color: var(--foreground); }
/* A variadic node's last row adds a pin on its side (Unreal's Add pin). */
.gadd .btn { color: var(--faint-foreground); }

/* An expression's source, lines wrapped by measure_node: 16 dp lines, 12 dp of
   padding and margin below, 48 dp across, which keeps its edit button clear. */
.gcode {
    position: relative; display: block; margin: 0dp 8dp 4dp; padding: 4dp 26dp 4dp 6dp; border-radius: 4dp; cursor: text;
    background-color: var(--chip); font-size: var(--studio-font-11, 11dp); line-height: var(--studio-line-16, 16dp);
}
.graph-expression-editor { flex: 0 1 auto; max-width: 100%; min-width: 0dp; }
.graph-expression-editor.standalone { margin: 0dp 8dp 4dp; }
.graph-expression-editor.standalone .field { height: var(--studio-height-24, 24dp); }
.graph-expression-editor .field { width: 100%; min-width: 0dp; }
/* Lines may run 6 dp past their measured room, as glyphs hint wider at small
   zooms, and stop short of the edit button. */
.gcode-line { display: block; height: var(--studio-height-16, 16dp); margin-right: -6dp; white-space: pre; overflow: hidden; }
.gcode-edit { position: absolute; top: 2dp; right: 2dp; z-index: 1; width: 18dp; height: 18dp; padding: 0dp; opacity: 0.55; }
.gcode:hover .gcode-edit { opacity: 1; }

/* Compact nodes (Unreal): an operator's symbol sits between its inputs and its
   centered output; a one-output read is a pill with its socket on the title. */
.gnode[data-form=operator] { border-radius: 10dp; }
.gnode[data-form=operator] .gnode-body { position: relative; padding: 4dp 0dp; }
.gnode[data-form=operator] .grow.in { padding-right: 0dp; }
.gsymbol {
    position: absolute; top: 0dp; bottom: 0dp; text-align: center; white-space: nowrap;
    font-size: var(--studio-font-18, 18dp); font-weight: 700; color: var(--muted-foreground);
}
.gout { position: absolute; right: 0dp; width: 12dp; height: var(--studio-height-22, 22dp); }
.gnode[data-form=getter] { border-radius: 13dp; }
.gnode[data-form=getter] .gnode-head { border-radius: 12dp; }

/* A socket is a 16 dp hit area centered on the node edge; kit_dot draws it. */
.socket { position: absolute; top: 3dp; width: 16dp; height: var(--studio-height-16, 16dp); }
.in > .socket { left: -8dp; }
.out > .socket { right: -8dp; }
/* Row containers end at the node's inner border edge; sockets target its outer edge. */
.grow.in > .socket, .ghalf.in > .socket { left: -9dp; }
.grow.out > .socket, .ghalf.out > .socket, .gout > .socket { right: -9dp; }
.socket kit-dot { position: absolute; left: 3dp; top: 3dp; width: 10dp; height: 10dp; }

/* Level of detail: far out, pins and values give way to titles. */
body.far .gpin-label, body.far .grow .field, body.far .grow .chip, body.far .grow .check, body.far .grow .segmented, body.far .gcode, body.far .gadd, body.far .gbind { visibility: hidden; }
body.far .gnode-head .title { font-size: var(--studio-font-16, 16dp); }

/* Comment frames (studio_graph_comment.c): a tint layer keyed by the frame's
   color, the title, and grips on the edges and corners that resize it. */
.gcomment { position: absolute; }
.gcomment[data-selected] { margin: -2dp 0dp 0dp -2dp; border: 2dp var(--selected-object); border-radius: var(--r-lg); }
.gcomment-tint {
    position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp;
    border: 1dp #8a8a9666; border-radius: var(--r-lg); background-color: #8a8a961f;
}
.gcomment-title {
    position: relative; display: block; height: var(--studio-height-28, 28dp); padding: 0dp 10dp; line-height: var(--studio-line-28, 28dp); font-size: var(--studio-font-14, 14dp); font-weight: 600;
    color: var(--foreground); white-space: nowrap; overflow: hidden; cursor: move;
}
.gcomment-edit { position: relative; display: block; padding: 3dp 4dp; }
.gcomment-edit .field { font-size: var(--studio-font-14, 14dp); font-weight: 600; }
body.far .gcomment-title { font-size: var(--studio-font-28, 28dp); height: 44dp; line-height: var(--studio-line-44, 44dp); }
.grip { position: absolute; }
.grip.n, .grip.s { left: 8dp; right: 8dp; height: 8dp; cursor: ns-resize; }
.grip.w, .grip.e { top: 8dp; bottom: 8dp; width: 8dp; cursor: ew-resize; }
.grip.n { top: -4dp; }
.grip.s { bottom: -4dp; }
.grip.w { left: -4dp; }
.grip.e { right: -4dp; }
.grip.nw, .grip.ne, .grip.sw, .grip.se { width: 12dp; height: 12dp; }
.grip.nw { left: -4dp; top: -4dp; cursor: nwse-resize; }
.grip.se { right: -4dp; bottom: -4dp; cursor: nwse-resize; }
.grip.ne { right: -4dp; top: -4dp; cursor: nesw-resize; }
.grip.sw { left: -4dp; bottom: -4dp; cursor: nesw-resize; }

/* A node's comment floats above it (Unreal's comment bubble). */
.gbubble {
    position: absolute; left: 0dp; bottom: 100%; margin-bottom: 6dp;
    padding: 3dp 8dp; border-radius: 6dp; background-color: var(--bubble); border: 1dp var(--node-edge);
    color: var(--bubble-fg); font-size: var(--studio-font-12, 12dp); line-height: var(--studio-line-16, 16dp);
}
.gbubble-text { display: block; white-space: pre-wrap; }
body.far .gbubble { visibility: hidden; }

/* Centered on the wire's middle by a negative margin (emit_conversions). */
.gconversion {
    position: absolute; display: block; height: var(--studio-height-16, 16dp); margin-top: -8dp;
    border-radius: 8dp; background-color: var(--conversion); border: 1dp var(--border);
    color: var(--muted-foreground); font-size: var(--studio-font-10, 10dp); line-height: var(--studio-line-14, 14dp); text-align: center; white-space: nowrap; overflow: hidden;
}

.marquee { position: absolute; border: 1dp var(--primary-edge); background-color: var(--primary-soft); }

/* A wire's reroute point: a 14 dp hit area centered on the point. */
.greroute { position: absolute; width: 14dp; height: var(--studio-height-14, 14dp); margin-left: -7dp; margin-top: -7dp; cursor: move; }
.greroute kit-dot { position: absolute; left: 2dp; top: 2dp; width: 10dp; height: 10dp; }

/* A problem sits on the node's top edge by its right corner, clear of the
   title's socket (Blender's node warnings); a paused run's node takes a 3 dp
   accent ring outside its border. */
.gproblem {
    position: absolute; top: -10dp; right: 14dp; width: 18dp; height: var(--studio-height-18, 18dp); border-radius: 9dp;
    background-color: var(--node); text-align: center; z-index: 3;
}
.gproblem .icon { width: 18dp; font-size: 14dp; line-height: var(--studio-line-18, 18dp); color: var(--warning); }
.gnode[data-error] .gproblem .icon { color: var(--destructive); }
.gpaused {
    position: absolute; left: -5dp; top: -5dp; right: -5dp; bottom: -5dp;
    border: 3dp var(--primary); border-radius: 10dp; pointer-events: none;
    opacity: 1; transition: opacity 0.14s cubic-out;
}
.gpaused[data-starting-style] { opacity: 0; }
.gnode[data-paused] { z-index: 3; }
/* A node the debug target is running wears a rim in the execution wire's
   color; once it stops the rim fades over 0.4 s, as its wires' pulses do. */
.grunning {
    position: absolute; left: -3dp; top: -3dp; right: -3dp; bottom: -3dp;
    border: 1.5dp var(--flow-running); border-radius: 9dp; pointer-events: none;
    opacity: 1; transition: opacity 0.4s cubic-in-out;
}
.grunning[data-ending-style] { opacity: 0; }
.gnode[data-form=operator] .grunning { border-radius: 13dp; }
.gnode[data-form=getter] .grunning { border-radius: 16dp; }

/* A watched pin's value floats outside the node beside its socket (Unreal);
   Show Live Values gives every data output a quieter chip. */
.gwatch {
    position: absolute; top: -9dp; height: var(--studio-height-16, 16dp); padding: 0dp 6dp; border-radius: 8dp;
    background-color: var(--primary); color: var(--primary-foreground); font-size: var(--studio-font-10, 10dp); line-height: var(--studio-line-16, 16dp);
    font-family: var(--font-numeric); white-space: nowrap; pointer-events: none;
    display: flex; align-items: center;
}
.gwatch[data-live] {
    top: -10dp; height: var(--studio-height-16, 16dp); padding: 0dp 5dp; border-radius: 4dp;
    background-color: var(--live-chip); color: var(--foreground); border: 1dp var(--node-edge);
    line-height: var(--studio-line-14, 14dp);
}
.gwatch-swatch {
    width: 8dp; height: 8dp; margin-right: 4dp; border-radius: 2dp;
    border: 1dp var(--node-edge);
}
.in > .gwatch { right: 100%; margin-right: 10dp; }
.out > .gwatch { left: 100%; margin-left: 10dp; }
/* The UI Inspector's overlay (kit_inspect.c): DevTools' highlight colors for
   the margin, border, padding and content boxes, and a label naming the
   element and its size. While picking, the overlay takes the pointer. */
.inspect-overlay { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: none; z-index: 40; }
.inspect-overlay.guides { z-index: 0; }
.inspect-overlay[data-picking] { pointer-events: auto; cursor: crosshair; }
/* RmlUi clips only overflowing content unless told always. */
.inspect-highlight { position: absolute; overflow: hidden; clip: always; pointer-events: none; }
.inspect-highlight .band { position: absolute; border-color: transparent; }
.inspect-highlight .band.margin { border-color: #f6b26ba8; }
.inspect-highlight .band.border { border-color: #ffe599a8; }
.inspect-highlight .band.padding { border-color: #93c47d8c; }
.inspect-highlight .band.content { background-color: #6fa8dca8; }
/* The selection keeps an outline while the Inspector shows it. */
.inspect-highlight.selected .band.content { background-color: transparent; border: 1dp var(--primary); }
.inspect-highlight .label {
    position: absolute; height: var(--studio-height-18, 18dp); line-height: var(--studio-line-16, 16dp); padding: 0dp 6dp; border-radius: 3dp; white-space: nowrap;
    font-size: var(--studio-font-11, 11dp); color: var(--popover-foreground); background-color: var(--popover); border: 1dp var(--popover-edge);
}
/* Virtualized list: the content is as tall as every row; padding places the first
   emitted row. */
.vlist { overflow-y: auto; }
.vlist-content { display: block; position: relative; }
/* NumberFlow and Torph are native elements that lay themselves out
   (src/ui/motion.h): the theme sets only the digits' face and line. */
number-flow { font-family: var(--font-numeric); line-height: var(--studio-line-16, 16dp); }
/* Property rows (Blender property split). Child combinators keep these off
   a row's popovers, whose items have labels too. */
.prop { display: flex; align-items: center; gap: 10dp; margin-top: var(--gap); }
.prop > .label {
    width: 40%; max-width: var(--studio-property-label-max, 160dp); flex: 0 0 auto; height: var(--h); display: flex; align-items: center; justify-content: flex-end;
    color: var(--muted-foreground); white-space: nowrap; overflow: hidden;
}
/* A label longer than its column ends in an ellipsis, and its tooltip
   then holds all of it (data-tip-clipped, kit_popup.c). */
.prop > .label > span { flex: 0 1 auto; min-width: 0dp; overflow: hidden; text-overflow: ellipsis; }
.prop > .control { flex: 1 1 0dp; display: flex; align-items: center; gap: 4dp; }
.prop > .label .hl { background-color: var(--highlight); color: var(--strong); border-radius: 2dp; }

/* Collapsible panel (Blender panel). */
.panel { display: block; background-color: var(--card); border-radius: var(--r-lg); margin-bottom: 8dp; border: 1dp var(--line); }
.panel-head {
    display: flex; align-items: center; gap: 6dp; height: var(--panel-h); padding: 0dp 6dp 0dp 8dp;
    background-color: var(--panel-head); border-radius: var(--r-lg); color: var(--foreground);
}
.panel[data-open] .panel-head { border-radius: 6dp 6dp 0dp 0dp; }
.panel-head:hover { background-color: var(--panel-head-hover); }
.panel-head .chev { color: var(--faint-foreground); width: 12dp; font-size: var(--studio-font-11, 11dp); transform: rotate(-90deg); transition: transform 0.14s cubic-out; }
.panel[data-open] .panel-head .chev { transform: rotate(0deg); }
.panel-head .title { font-weight: 600; }
/* The panel's menu (kit_panel_menu): faint until the header is hovered or
   the menu has the keyboard focus, so it is found without hunting. */
.panel-head .menu { width: 18dp; line-height: var(--studio-line-18, 18dp); border-radius: var(--r); opacity: 0.4; cursor: pointer; }
.panel-head:hover .menu, .panel-head .menu:focus-visible { opacity: 1; }
.panel-head .menu:hover { background-color: var(--press); color: var(--foreground); }
.panel-body { display: block; padding: 4dp 10dp 10dp 8dp; }

/* Badge and kbd. */
.badge { display: inline-block; height: var(--studio-height-16, 16dp); line-height: var(--studio-line-16, 16dp); padding: 0dp 5dp; border-radius: 3dp; font-size: var(--studio-font-10, 10dp); color: var(--muted-foreground); background-color: var(--line); white-space: nowrap; }
.badge.override { color: var(--override-fg); background-color: var(--override-soft); }
.badge.accent { color: var(--primary-text); background-color: var(--primary-soft); }
.kbd { font-size: var(--studio-font-11, 11dp); color: var(--faint-foreground); white-space: nowrap; }
.kbd-key { display: inline-block; text-align: center; min-width: 18dp; height: var(--studio-height-18, 18dp); line-height: var(--studio-line-18, 18dp); padding: 0dp 4dp; border-radius: 3dp; background-color: var(--line); color: var(--muted-foreground); font-size: var(--studio-font-10, 10dp); }
/* Overlay layer: popups, tooltips, toasts, dialogs and the command palette,
   a document over the others whose body has the page's classes but paints
   nothing itself. */
#layer { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: none; z-index: 10; background-color: transparent; }
.modal-host { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; pointer-events: auto; z-index: 15; }
.popup {
    position: absolute; pointer-events: auto; background-color: var(--popover); border: 1dp var(--popover-edge);
        border-radius: var(--r-lg); padding: 4dp; min-width: 180dp; max-width: 480dp; color: var(--foreground);
    display: block; z-index: 20; box-shadow: var(--shadow-overlay);
}
.popup.struct-editor { min-width: 320dp; }
.popover {
    width: 288dp; min-width: 180dp; max-width: 480dp; padding: var(--studio-height-16, 16dp);
    border: 1dp var(--border); border-radius: var(--radius, 6dp);
    color: var(--foreground); font-size: var(--studio-font-14, 14dp); line-height: var(--studio-line-20, 20dp);
}
.popover .btn { height: var(--studio-height-36, 36dp); padding: 0dp var(--studio-height-16, 16dp); border-radius: var(--r, 4dp); font-size: var(--studio-font-14, 14dp); }
.popover .btn.sm { height: var(--studio-height-32, 32dp); padding: 0dp var(--studio-height-12, 12dp); font-size: var(--studio-font-14, 14dp); }
.popover .btn.icon-only { width: var(--studio-height-36, 36dp); padding: 0dp; }
.popover .btn.sm.icon-only { width: var(--studio-height-32, 32dp); padding: 0dp; }
.popover .row { gap: 6dp; }
body.comfortable .popover .btn { height: var(--studio-height-40, 40dp); }
body.comfortable .popover .btn.sm { height: var(--studio-height-36, 36dp); }
.popover .btn:focus-visible {
    border-color: var(--ring);
    box-shadow: 0dp 0dp 0dp 3dp color-mix(in srgb, var(--ring) 50%, transparent);
}
.popup[data-unplaced] { visibility: hidden; }
/* Authored popovers (ui/popover.c): a closed one lays out and draws nothing;
   a shown one waits unseen until it is placed. */
[popover]:not([data-open]) { display: none; }
[popover][data-unplaced] { visibility: hidden; }
/* An authored menu taller than the window scrolls, as the kit's do. */
.popup.menu[popover] { max-height: var(--available-height, none); overflow-y: auto; }
/* A list's search, as the kit's dropdown has it, and what it filtered out. */
.choice-list { display: block; }
.choice-list .field.search { margin: 2dp 2dp 6dp; }
.choice-results { max-height: var(--dropdown-list-h); overflow-y: auto; }
.choice-list [data-filtered] { display: none; }
.choice-empty { display: none; padding: 8dp; color: var(--muted-foreground); }
.choice-list[data-empty] .choice-empty { display: block; }
/* A short fade bridges an occasional overlay change without moving its
   anchor or scroll clip. Exits are faster and input stays available. */
.popup { opacity: 1; transition: opacity 0.14s cubic-out; }
.popup[data-starting-style], .popup[data-ending-style] { opacity: 0; }
.popup[data-ending-style] { transition: opacity 0.1s cubic-out; }
.menu-item {
    display: flex; align-items: center; gap: 8dp; height: var(--h); padding: 0dp 8dp 0dp 6dp; border-radius: var(--r);
    white-space: nowrap; color: var(--foreground);
}
.popup.menu > .menu-item, .menu-option, .menu-check { height: var(--menu-row-h); }
.menu-item .lead { color: var(--muted-foreground); }
.menu-item .text { display: block; flex: 1 1 auto; overflow: hidden; }
.menu-item .label { display: block; overflow: hidden; }
.menu-item .about { display: none; font-size: 12dp; line-height: 16dp; color: var(--faint-foreground); }
.menu-item[data-described] { height: 44dp; }
.menu-item[data-described] .about { display: block; }
.menu-item .kbd { margin-left: 24dp; flex: 0 0 auto; }
.menu-item .kbd[data-empty] { display: none; }
.menu-item .chev { color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); }
.menu-item[data-highlighted] { background-color: var(--primary); color: var(--primary-foreground); }
.menu-item[data-highlighted] .lead, .menu-item[data-highlighted] .kbd, .menu-item[data-highlighted] .chev,
.menu-item[data-highlighted] .about { color: var(--primary-foreground); }
.menu-item[data-disabled] { color: var(--disabled-foreground); }
.menu-item[data-current] .label, .menu-item[data-current] .lead { color: var(--primary-text); }
.menu-item[data-current][data-highlighted] .label, .menu-item[data-current][data-highlighted] .lead { color: var(--primary-foreground); }
.menu-item[data-disabled] .lead, .menu-item[data-disabled] .kbd { color: var(--disabled-foreground); }
.menu-sep { height: 1dp; margin: 4dp 2dp; background-color: var(--border); }
.menu-group { height: var(--studio-height-22, 22dp); line-height: var(--studio-line-22, 22dp); display: block; padding: 0dp 6dp; font-size: var(--studio-font-11, 11dp); color: var(--faint-foreground); }
.menu-note { display: block; padding: 0dp 8dp 6dp; font-size: var(--studio-font-11, 11dp); color: var(--muted-foreground); white-space: nowrap; }
.dropdown .field.search { margin: 2dp 2dp 6dp; }
/* Field choices show seven rows. Action menus use compact, font-scaled rows
   and grow to their content until the viewport requires scrolling. */
body { --menu-row-h: var(--studio-line-22, 22dp); --dropdown-list-h: 182dp; --dropdown-box-h: 192dp; }
body.comfortable { --dropdown-list-h: 210dp; --dropdown-box-h: 220dp; }
body.graph-canvas, body.graph-canvas.comfortable { --dropdown-list-h: 154dp; --dropdown-box-h: 164dp; }
.dropdown-results, .autocomplete-results { max-height: var(--dropdown-list-h); overflow-y: auto; }
.popup.menu { overflow-y: auto; }
.dropdown-empty { display: block; padding: 8dp; color: var(--muted-foreground); }

/* The label and shortcut stay on one line; a description wraps beneath them.
   The kit sets the font size (kit_popup.c), undoing a canvas's zoom, so the
   other lengths are in em. */
.tooltip {
    position: absolute; pointer-events: none; background-color: var(--tooltip); border: 1dp var(--tooltip-edge); border-radius: 0.36em;
    padding: 0.36em 0.64em; display: block; color: var(--foreground); line-height: 1.45em;
    z-index: 40; box-shadow: var(--shadow-tooltip);
}
.tip-head { display: flex; align-items: center; gap: 0.73em; white-space: nowrap; }
.tip-about { display: block; max-width: 23.6em; margin-top: 0.18em; line-height: 1.36em; color: var(--muted-foreground); white-space: normal; }
.tooltip .kbd { font-size: 1em; color: var(--faint-foreground); }
.tooltip { opacity: 1; transition: opacity 0.1s cubic-out; }
.tooltip[data-starting-style] { opacity: 0; }
.tooltip[data-instant] { transition: none; }
/* Studio palettes from their authors' published values.
   https://draculatheme.com/contribute
   https://ethanschoonover.com/solarized/
   https://github.com/folke/tokyonight.nvim
   https://catppuccin.com/palette/
   https://rosepinetheme.com/palette/
   https://github.com/morhetz/gruvbox
   Subdued text, links and status roles are adjusted to at least 4.5:1.
   Selection is an explicit palette tint so subdued text remains readable. */

body.theme-dracula {
    --background: #282a36;
    --foreground: #f8f8f2;
    --card: #282a36;
    --card-foreground: #f8f8f2;
    --popover: #282a36;
    --popover-foreground: #f8f8f2;
    --primary: #bd93f9;
    --primary-foreground: #000000;
    --secondary: #44475a;
    --secondary-foreground: #f8f8f2;
    --muted: #282a36;
    --muted-foreground: #ced3e3;
    --accent: #343641;
    --accent-foreground: #f8f8f2;
    --border: #6272a4;
    --input: #6272a4;
    --ring: #dfcafc;
    --app: #21222c;
    --primary-text: #dfcafc;
    --link: #dfcafc;
    --selected: #3a374d;
    --active-row: var(--selected);
    --faint-foreground: var(--muted-foreground);
    --destructive: #ffc4c4;
    --warning: #f1fa8c;
    --success: #50fa7b;
    --override: #8be9fd;
    --override-fg: #8be9fd;
    --notice-fg: #f1fa8c;
    --axis-x: #ffc4c4;
    --axis-y: #50fa7b;
    --tok-number: #ffc98f;
    --tok-string: #50fa7b;
    --tok-keyword: #dfcafc;
    --tok-name: #8be9fd;
    --tok-path: #dfcafc;
    --tok-punct: #ced3e3;
    --override-soft: #8be9fd1f;
    --highlight: #f1fa8c44;
    --notice: #282a36f0;
}

body.theme-solarized-light {
    --background: #fdf6e3;
    --foreground: #4e6268;
    --card: #fdf6e3;
    --card-foreground: #4e6268;
    --popover: #fdf6e3;
    --popover-foreground: #4e6268;
    --primary: #268bd2;
    --primary-foreground: #000000;
    --secondary: #eee8d5;
    --secondary-foreground: #4e6268;
    --muted: #eee8d5;
    --muted-foreground: #516269;
    --accent: #f3eedc;
    --accent-foreground: #4e6268;
    --border: #93a1a1;
    --input: #93a1a1;
    --ring: #1b6395;
    --app: #eee8d5;
    --primary-text: #1b6395;
    --link: #1b6395;
    --selected: #ecede2;
    --active-row: var(--selected);
    --faint-foreground: var(--muted-foreground);
    --destructive: #b42927;
    --warning: #775a00;
    --success: #586500;
    --override: #1c6a64;
    --override-fg: #1c6a64;
    --notice-fg: #775a00;
    --axis-x: #b42927;
    --axis-y: #586500;
    --tok-number: #a43d12;
    --tok-string: #586500;
    --tok-keyword: #55599b;
    --tok-name: #1c6a64;
    --tok-path: #1b6395;
    --tok-punct: #516269;
    --override-soft: #1c6a641f;
    --highlight: #b5890044;
    --notice: #eee8d5f0;
}

body.theme-solarized-dark {
    --background: #002b36;
    --foreground: #9eaaaa;
    --card: #073642;
    --card-foreground: #9eaaaa;
    --popover: #073642;
    --popover-foreground: #9eaaaa;
    --primary: #268bd2;
    --primary-foreground: #000000;
    --secondary: #073642;
    --secondary-foreground: #9eaaaa;
    --muted: #002b36;
    --muted-foreground: #9daaac;
    --accent: #0f3c48;
    --accent-foreground: #9eaaaa;
    --border: #586e75;
    --input: #586e75;
    --ring: #67aee0;
    --app: #00212b;
