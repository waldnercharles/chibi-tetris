e":"Add Object","x":0.0,"y":0.0,"inputs":[{"id":44,"name":"Exec"},{"id":45,"name":"Prototype"}],"outputs":[{"id":46,"name":"Then"}]}],"edges":[],"comments":[]}],"anchors":[{"start":67,"id":3,"kind":"node"},{"start":108,"id":7,"kind":"node"},{"start":146,"id":11,"kind":"node"},{"start":215,"id":1,"kind":"node"},{"start":609,"id":33,"kind":"node"},{"start":725,"id":40,"kind":"node"},{"start":215,"id":1,"kind":"node"},{"start":146,"id":11,"kind":"node"},{"start":300,"id":15,"kind":"node"},{"start":361,"id":3,"kind":"producer"},{"start":393,"id":21,"kind":"node"},{"start":454,"id":7,"kind":"producer"},{"start":482,"id":27,"kind":"node"},{"start":553,"id":11,"kind":"producer"},{"start":609,"id":33,"kind":"node"},{"start":652,"id":36,"kind":"node"},{"start":678,"id":33,"kind":"producer"},{"start":725,"id":40,"kind":"node"},{"start":769,"id":43,"kind":"node"},{"start":791,"id":40,"kind":"producer"}],"source_hash":"f083f16bb7dc9ff5"}behavior "OutlinerInput" {
    owner "ecs.entity";
    action show_ui_popover = engine["Show UI Popover"](Entity: 0, Element: "#outliner-menu", At: rowmenu.Pointer);
    on RowClicked as rowclicked(Key: string = "", Shift: bool = false, Mod: bool = false) {
        select_object(Object: rowclicked.Key, Toggle: rowclicked.Mod, Extend: rowclicked.Shift);
    }
    on RowMenu as rowmenu(Key: string = "", Pointer: struct<"CF_V2"> = null) {
        if (object_selected(Object: rowmenu.Key)) {
            show_ui_popover();
        } else {
            await select_object(Object: rowmenu.Key, Toggle: false, Extend: false);
            show_ui_popover();
        }
    }
    on EyeClicked as eyeclicked(Key: string = "", Hidden: bool = false, Alt: bool = false) {
        if (eyeclicked.Alt) {
            isolate_object(Object: eyeclicked.Key);
        } else {
            set_object_hidden(Object: eyeclicked.Key, Hidden: not(Value: eyeclicked.Hidden));
        }
    }
    on LockClicked as lockclicked(Key: string = "", Locked: bool = false) {
        set_object_locked(Object: lockclicked.Key, Locked: not(Value: lockclicked.Locked));
    }
    on RowDropped as rowdropped(Key: string = "", Type: string = "", Payload: string = "") {
        drop_on_object(Object: rowdropped.Key, Type: rowdropped.Type, Payload: rowdropped.Payload);
    }
    on ListDropped as listdropped(Type: string = "", Payload: string = "") {
        if (text_equal(A: listdropped.Type, B: "prototype")) {
            add_object(Prototype: listdropped.Payload);
        } else {
        }
    }
    on ClearFilter as clearfilter() {
        set_object_filter(Filter: "");
    }
    on SpawnBreak as spawnbreak() {
        toggle_spawn_break(Prototype: selection().Prototype);
    }
}
