"},{"start":1331,"id":62,"kind":"producer"},{"start":1366,"id":70,"kind":"node"},{"start":1446,"id":75,"kind":"node"},{"start":1469,"id":70,"kind":"producer"},{"start":1491,"id":70,"kind":"producer"},{"start":1517,"id":70,"kind":"producer"},{"start":1566,"id":81,"kind":"node"},{"start":1629,"id":89,"kind":"node"},{"start":1659,"id":94,"kind":"node"},{"start":1681,"id":81,"kind":"producer"},{"start":1757,"id":98,"kind":"node"},{"start":1780,"id":105,"kind":"node"},{"start":1810,"id":100,"kind":"producer"}],"source_hash":"dd1e63a34c9142f1"}behavior "OutlinerMenu" {
    owner "ecs.entity";
    action set_ui_data_8 = set_ui_data(Entity: 0, Name: "menu.actor", Value: bool = (convert<"To Real">(selection().Count) > 0));
    on Begin as begin() {
        await set_ui_data(Entity: 0, Name: "menu.spawnBreak.label", Value: string = engine["String"](Value: "Break When Spawned"));
        await set_ui_data(Entity: 0, Name: "menu.spawnBreak.icon", Value: string = engine["String"](Value: ""));
        await set_ui_data(Entity: 0, Name: "menu.spawnBreak.shortcut", Value: string = engine["String"](Value: ""));
        if (editor_state().Mac) {
            set_ui_data(Entity: 0, Name: "isolateTip", Value: string = engine["String"](Value: "⌥-click shows only this object"));
        } else {
            set_ui_data(Entity: 0, Name: "isolateTip", Value: string = engine["String"](Value: "Alt+click shows only this object"));
        }
    }
    on Refresh as refresh() {
        Count := selection().Count
        if ((convert<"To Real">(Count) == 1)) {
            await set_ui_data(Entity: 0, Name: "menu.label", Value: string = selection().Name);
            set_ui_data_8();
        } else {
            await set_ui_data(Entity: 0, Name: "menu.label", Value: string = format_text(Format: "{} objects", Arg0: int = Count));
            set_ui_data_8();
        }
    }
    after set_ui_data_8 {
        await set_ui_data(Entity: 0, Name: "menu.live", Value: bool = editor_state().Live);
        set_ui_data(Entity: 0, Name: "menu.spawnBreak.checked", Value: bool = breaks_when_spawned(Prototype: selection().Prototype));
    }
}
