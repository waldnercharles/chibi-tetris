    owner "ecs.entity";
    state Left: string = "";
    action left_3 = set_variable<"Left">(Value: string = "");
    on RenameCommitted as renamecommitted(Key: string = "", Name: string = "") {
        if (text_equal(A: renaming_object(), B: renamecommitted.Key)) {
            await rename_object(Object: renamecommitted.Key, Name: renamecommitted.Name);
            end_rename();
        } else {
        }
    }
    on RenameCancel as renamecancel() {
        await end_rename();
        focus_ui_element(Entity: 0, Element: "#outliner-list");
    }
    on RenameEnter as renameenter() {
        focus_ui_element(Entity: 0, Element: "#outliner-list");
    }
    on RenameLeft as renameleft(Key: string = "") {
        set_variable<"Left">(Value: string = renameleft.Key);
    }
    on Refresh as refresh() {
        if (text_equal(A: get_variable<"Left">(), B: renaming_object())) {
            await end_rename();
            left_3();
        } else {
            left_3();
        }
    }
}
{"version":2,"id_counter":73,"description":"Renames an object in its Outliner row: a committed name renames it as one Undo step and closes the field; Escape closes it first, so nothing commits; Enter and Escape return the keyboard to the list; a field left without a commit closes at the refresh after its events.","variables":[{"name":"Left","id":1,"category":"Rename"}],"graphs":[{"id":0,"kind":0,"caller":0,"name":"","description":"","locals":[],"nodes":[{"id":6,"owner":12,"type":"Renaming Object","x":0.0,"y":0.0,"outputs":[{"id":7,"name":"Object"}]},{"id":2,"owner":2,"type":"Event","reference":"RenameCommitted","x":0.0,"y":0.0,"comment":"Commits only while this row still renames: Escape ended the rename before its field's blur commits.","outputs":[{"id":3,"name":"Then"},{"id":4,"name":"Key"},{"id":5,"name":"Name"}]},{"id":8,"owner":12,"type":"Text Equal","x":0.0,"y":0.0,"inputs":[{"id":9,"name":"A"},{"id":10,"name":"B"}],"outputs":[{"id":11,"name":"Result"}]},{"id":52,"owner":60,"type":"Get Variable","reference":"Left","x":0.0,"y":0.0,"outputs":[{"id":53,"name":"Value"}]},{"id":54,"owner":60,"type":"Renaming Object","x":0.0,"y":0.0,"outputs":[{"id":55,"name":"Object"}]},{"id":56,"owner":60,"type":"Text Equal","x":0.0,"y":0.0,"inputs":[{"id":57,"name":"A"},{"id":58,"name":"B"}],"outputs":[{"id":59,"name":"Result"}]},{"id":68,"owner":68,"type":"Set Variable","reference":"Left","x":0.0,"y":0.0,"inputs":[{"id":69,"name":"Exec"},{"id":70,"name":"Value"}],"outputs":[{"id":71,"name":"Then"},{"id":72,"name":"Value"}]},{"id":25,"owner":25,"type":"Event","reference":"RenameCancel","x":0.0,"y":0.0,"outputs":[{"id":26,"name":"Then"}]},{"id":35,"owner":35,"type":"Event","reference":"RenameEnter","x":0.0,"y":0.0,"outputs":[{"id":36,"name":"Then"}]},{"id":42,"owner":42,"type":"Event","reference":"RenameLeft","x":0.0,"y":0.0,"outputs":[{"id":43,"name":"Then"},{"id":44,"name":"Key"}]},{"id":50,"owner":50,"type":"Event","reference":"Refresh","x":0.0,"y":0.0,"comment":"A field left without a commit closes here, after the commit its blur may also send.","outputs":[{"id":51,"name":"Then"}]},{"id":12,"owner":12,"type":"Branch","x":0.0,"y":0.0,"inputs":[{"id":13,"name":"Exec"},{"id":14,"name":"Condition"}],"outputs":[{"id":15,"name":"True"},{"id":16,"name":"False"}]},{"id":17,"owner":17,"type":"Rename Object","x":0.0,"y":0.0,"inputs":[{"id":18,"name":"Exec"},{"id":19,"name":"Object"},{"id":20,"name":"Name"}],"outputs":[{"id":21,"name":"Then"}]},{"id":22,"owner":22,"type":"End Rename","x":0.0,"y":0.0,"inputs":[{"id":23,"name":"Exec"}],"outputs":[{"id":24,"name":"Then"}]},{"id":27,"owner":27,"type":"End Rename","x":0.0,"y":0.0,"inputs":[{"id":28,"name":"Exec"}],"outputs":[{"id":29,"name":"Then"}]},{"id":30,"owner":30,"type":"Focus UI Element","x":0.0,"y":0.0,"inputs":[{"id":31,"name":"Exec"},{"id":32,"name":"Entity"},{"id":33,"name":"Element"}],"outputs":[{"id":34,"name":"Then"}]},{"id":37,"owner":37,"type":"Focus UI Element","x":0.0,"y":0.0,"inputs":[{"id":38,"name":"Exec"},{"id":39,"name":"Entity"},{"id":40,"name":"Element"}],"outputs":[{"id":41,"name":"Then"}]},{"id":45,"owner":45,"type":"Set Variable","reference":"Left","x":0.0,"y":0.0,"inputs":[{"id":46,"name":"Exec"},{"id":47,"name":"Value"}],"outputs":[{"id":48,"name":"Then"},{"id":49,"name":"Value"}]},{"id":60,"owner":60,"type":"Branch","x":0.0,"y":0.0,"inputs":[{"id":61,"name":"Exec"},{"id":62,"name":"Condition"}],"outputs":[{"id":63,"name":"True"},{"id":64,"name":"False"}]},{"id":65,"owner":65,"type":"End Rename","x":0.0,"y":0.0,"inputs":[{"id":66,"name":"Exec"}],"outputs":[{"id":67,"name":"Then"}]}],"edges":[],"comments":[]}],"anchors":[{"start":62,"id":1,"kind":"value"},{"start":91,"id":6,"kind":"node"},{"start":138,"id":8,"kind":"node"},{"start":217,"id":52,"kind":"node"},{"start":260,"id":54,"kind":"node"},{"start":309,"id":56,"kind":"node"},{"start":380,"id":68,"kind":"node"},{"start":457,"id":2,"kind":"node"},{"start":710,"id":25,"kind":"node"},{"start":847,"id":35,"kind":"node"},{"start":954,"id":42,"kind":"node"},{"start":1071,"id":50,"kind":"node"},{"start":457,"id":2,"kind":"node"},{"start":520,"id":12,"kind":"node"},{"start":550,"id":17,"kind":"node"},{"start":578,"id":2,"kind":"producer"},{"start":605,"id":2,"kind":"producer"},{"start":640,"id":22,"kind":"node"},{"start":710,"id":25,"kind":"node"},{"start":735,"id":27,"kind":"node"},{"start":763,"id":30,"kind":"node"},{"start":847,"id":35,"kind":"node"},{"start":871,"id":37,"kind":"node"},{"start":954,"id":42,"kind":"node"},{"start":993,"id":45,"kind":"node"},{"start":1030,"id":42,"kind":"producer"},{"start":1071,"id":50,"kind":"node"},{"start":1091,"id":60,"kind":"node"},{"start":1123,"id":65,"kind":"node"}],"source_hash":"b11187034371ee62"}behavior "OutlinerRows" {
    owner "ecs.entity";
    state First: int = 0;
    state Count: int = 0;
    state Collapsed: bool = false;
    state ShownOpen: bool = true;
    action scene_objects = engine["Scene Objects"](First: convert<"To Integer">("max(First - 1, 0)"(First: int = state.First)), Count: convert<"To Integer">("Count - 1 + step(1, First)"(Count: int = state.Count, First: int = state.First)));
    action branch_3 = engine["Branch"](Condition: (convert<"To Real">(scene_objects.Shown) > 0));
    on Begin as begin() {
        await set_ui_data(Entity: 0, Name: "root.icon", Value: string = engine["String"](Value: ""));
        await set_ui_data(Entity: 0, Name: "root.parent", Value: bool = engine["Bool"](Value: true));
        set_ui_data(Entity: 0, Name: "root.depth", Value: int = integer(Value: 0));
    }
    on ShowRows as showrows(First: int = 0, Count: int = 0) {
        await set_variable<"First">(Value: showrows.First);
        set_variable<"Count">(Value: showrows.Count);
    }
    on Refresh as refresh() {
        scene_objects();
    }
    after scene_objects {
        await set_ui_data(Entity: 0, Name: "rootShown", Value: bool = (cast<double>(state.First) == 0));
        Shown := scene_objects.Shown
        await set_ui_data(Entity: 0, Name: "count", Value: int = Shown);
        await set_ui_data(Entity: 0, Name: "root.label", Value: string = scene_info().Title);
        await set_ui_data(Entity: 0, Name: "root.open", Value: bool = not(Value: state.Collapsed));
        await set_variable<"ShownOpen">(Value: bool = not(Value: state.Collapsed));
        if (state.Collapsed) {
            await set_ui_data(Entity: 0, Name: "rows", Value: struct<"SceneObjectRow">[] = clear(Array: struct<"SceneObjectRow">[] = scene_objects.Rows));
            await set_ui_data(Entity: 0, Name: "total", Value: int = integer(Value: 1));
            branch_3();
        } else {
            await set_ui_data(Entity: 0, Name: "rows", Value: struct<"SceneObjectRow">[] = scene_objects.Rows);
            await set_ui_data(Entity: 0, Name: "total", Value: double = "1 + Shown"(Shown: int = Shown));
            branch_3();
        }
    }
    after branch_3.True {
        await set_ui_data(Entity: 0, Name: "filtered", Value: bool = engine["Bool"](Value: false));
        set_ui_data(Entity: 0, Name: "notice", Value: string = engine["String"](Value: ""));
    }
    after branch_3.False {
        if (text_equal(A: scene_info().Filter, B: "")) {
            await set_ui_data(Entity: 0, Name: "filtered", Value: bool = engine["Bool"](Value: false));
            set_ui_data(Entity: 0, Name: "notice", Value: string = engine["String"](Value: "No objects. Add a prototype to start."));
        } else {
            await set_ui_data(Entity: 0, Name: "filtered", Value: bool = engine["Bool"](Value: true));
            set_ui_data(Entity: 0, Name: "notice", Value: string = format_text(Format: "No objects match “{}”", Arg0: string = scene_info().Filter));
        }
    }
    on FoldRoot as foldroot() {
        set_variable<"Collapsed">(Value: bool = true);
    }
    on UnfoldRoot as unfoldroot() {
        set_variable<"Collapsed">(Value: bool = false);
    }
    on ToggleRoot as toggleroot() {
        set_variable<"Collapsed">(Value: bool = not(Value: state.Collapsed));
    }
    on RootClicked as rootclicked(Open: bool = false) {
        if (((rootclicked.Open && !state.ShownOpen) || (!rootclicked.Open && state.ShownOpen))) {
            set_variable<"Collapsed">(Value: bool = not(Value: rootclicked.Open));
        } else {
        }
    }
    on RevealObject as revealobject(Object: string = "") {
        await set_variable<"Collapsed">(Value: bool = false);
        if ((convert<"To Real">(object_row(Object: revealobject.Object)) >= 0)) {
            reveal_ui_list_row(Entity: 0, Element: "#outliner-list", Row: convert<"To Integer">("Row + 1"(Row: int = object_row(Object: revealobject.Object))));
        } else {
        }
    }
    pure function "max(First - 1, 0)"<T0: int, T1: double>(First: T0 = 0) -> (Result: T1 = 0.0) {
        depth_limit 64;
        return max(A: double = subtract(A: double = convert<"To Real">(entry), B: double = real(Value: 1.0)), B: double = real(Value: 0.0))
    }
    pure function "Count - 1 + step(1, First)"<T0: int, T1: int, T2: double>(Count: T0 = 0, First: T1 = 0) -> (Result: T2 = 0.0) {
        depth_limit 64;
        return add(A: double = subtract(A: double = convert<"To Real">(entry.Count), B: double = real(Value: 1.0)), B: double = step(Value: convert<"To Real">(entry.First), Edge: real(Value: 1.0)))
    }
    pure function "1 + Shown"<T0: int, T1: double>(Shown: T0 = 0) -> (Result: T1 = 0.0) {
        depth_limit 64;
        return add(A: double = real(Value: 1.0), B: double = convert<"To Real">(entry))
    }
    pure function "Row + 1"<T0: int, T1: double>(Row: T0 = 0) -> (Result: T1 = 0.0) {
        depth_limit 64;
        return add(A: double = convert<"To Real">(entry), B: double = real(Value: 1.0))
    }
}
