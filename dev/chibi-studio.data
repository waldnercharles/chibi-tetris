    --warning: #fabd2f;
    --success: #bdc035;
    --override: #98c688;
    --override-fg: #98c688;
    --notice-fg: #fabd2f;
    --axis-x: #fda297;
    --axis-y: #bdc035;
    --tok-number: #fea55c;
    --tok-string: #bdc035;
    --tok-keyword: #e1acba;
    --tok-name: #98c688;
    --tok-path: #fea55c;
    --tok-punct: #c1b8b0;
    --override-soft: #98c6881f;
    --highlight: #fabd2f44;
    --notice: #1d2021f0;
}
/* The editor's roles beyond shadcn's, derived from the palette so a pasted
   theme carries through. Mixes that differ in the dark palette repeat under
   .dark; status, override and code colors are the editor's own. */
body, .dark {
    /* Surfaces: quiet chrome, clear content, opaque fields and overlays. */
    --font-ui: var(--studio-standard-font-family, geist);
    --font-numeric: var(--studio-numeric-font-family, GeistNumeric);
    --font-code: var(--studio-code-font-family, jetbrains mono);
    /* The backdrop the areas float on, a step darker than them. */
    --app: #e2e5ea;
    --edge: var(--border);
    --rail: var(--muted);
    --panel-head: var(--card);
    --panel-head-hover: var(--muted);
    --field-hover: color-mix(in srgb, var(--foreground) 5%, var(--secondary));
    --field-press: color-mix(in srgb, var(--secondary) 92%, #000);
    --field-edit: var(--popover);
    --input-hover: color-mix(in srgb, var(--foreground) 3%, var(--popover));
    --canvas: var(--popover);
    --viewport: #1e1e20;
    --floating: color-mix(in srgb, var(--popover) 90%, transparent);
    --tooltip: var(--foreground);
    --tooltip-edge: var(--foreground);
    --backdrop: #00000033;
    /* Elevation: a soft drop and a tight contact shadow lift overlays off
       the areas; tooltips sit lower. */
    --shadow-overlay: 0dp 8dp 24dp -4dp #0000002e, 0dp 1dp 2dp 0dp #0000001f;
    --shadow-tooltip: 0dp 2dp 8dp -2dp #00000029, 0dp 1dp 1dp 0dp #0000001a;
    /* Lines. */
    --line: color-mix(in srgb, var(--border) 72%, transparent);
    --popover-edge: var(--border);
    /* Text. */
    --faint-foreground: var(--muted-foreground);
    --disabled-foreground: color-mix(in srgb, var(--muted-foreground) 50%, var(--background));
    --strong: var(--foreground);
    --primary-text: var(--primary);
    --link: var(--primary);
    /* Primary-tinted states. */
    --primary-hover: color-mix(in srgb, #000 12%, var(--primary));
    --primary-soft: color-mix(in srgb, var(--primary) 15%, transparent);
    --primary-edge: color-mix(in srgb, var(--primary) 67%, transparent);
    --primary-wash: color-mix(in srgb, var(--primary) 27%, transparent);
    /* A fill bar tints the field behind its value, not a selection. */
    --fill: color-mix(in srgb, var(--primary) 16%, var(--secondary));
    --fill-hover: color-mix(in srgb, var(--primary) 26%, var(--secondary));
    --selected: color-mix(in oklab, var(--primary) 19%, var(--popover));
    --active-row: var(--selected);
    /* Foreground-tinted states. */
    --press: color-mix(in srgb, var(--foreground) 9%, transparent);
    --item-selected: color-mix(in srgb, var(--foreground) 5%, transparent);
    --scrollbar: color-mix(in srgb, var(--foreground) 15%, transparent);
    --scrollbar-hover: color-mix(in srgb, var(--foreground) 25%, transparent);
    /* Status, overrides and search. */
    --warning: #915b0c;
    --success: #28733b;
    --override: #0e9494;
    --override-fg: #086e68;
    --override-soft: #0e94941f;
    --highlight: #e8b64a66;
    --notice: #fff4e5f0;
    --notice-fg: #9a4d00;
    --axis-x: #c2413b;
    --axis-y: #3f8f2f;
    /* Code tokens (highlight.c). */
    --tok-number: #08754d;
    --tok-string: #a31515;
    --tok-keyword: #9900bd;
    --tok-name: #0451a5;
    --tok-path: #2f5fa8;
    --tok-punct: #606673;
    /* Metrics; body.comfortable scales controls, not text. */
    --h: 26dp;
    --topbar-h: 40dp;
    --text-line: 24dp; /* inner hit height of a bordered control */
    --input-line: 16dp; --input-pad: 4dp;
    --h-sm: 22dp;
    --row: 26dp;
    --gap: 2dp;
    --header-h: 32dp;
    --status-h: var(--studio-height-28, 28dp);
    --panel-h: var(--studio-height-30, 30dp);
    --r: 4dp;
    --r-lg: var(--radius);
}
.dark {
    --app: #121316;
    --edge: var(--border);
    --floating: color-mix(in srgb, var(--card) 90%, transparent);
    --tooltip: color-mix(in srgb, var(--popover) 60%, #000);
    --tooltip-edge: #333338;
    --backdrop: #0000004d;
    --shadow-overlay: 0dp 8dp 24dp -4dp #00000073, 0dp 1dp 2dp 0dp #00000059;
    --shadow-tooltip: 0dp 2dp 8dp -2dp #00000066, 0dp 1dp 1dp 0dp #0000004d;
    --faint-foreground: var(--muted-foreground);
    --disabled-foreground: color-mix(in srgb, var(--muted-foreground) 37%, var(--background));
    --strong: var(--foreground);
    --primary-text: #a8c6f5;
    --link: #a8c6f5;
    --primary-soft: color-mix(in srgb, var(--primary) 23%, transparent);
    --primary-wash: color-mix(in srgb, var(--primary) 33%, transparent);
    --fill: color-mix(in srgb, var(--primary) 26%, var(--secondary));
    --fill-hover: color-mix(in srgb, var(--primary) 38%, var(--secondary));
    --selected: color-mix(in oklab, var(--primary) 27%, var(--popover));
    --active-row: var(--selected);
    --press: color-mix(in srgb, var(--foreground) 10%, transparent);
    --item-selected: color-mix(in srgb, var(--foreground) 7%, transparent);
    --scrollbar: color-mix(in srgb, var(--foreground) 12%, transparent);
    --scrollbar-hover: color-mix(in srgb, var(--foreground) 20%, transparent);
    --warning: #d9a53d;
    --success: #75bd78;
    --override: #19b6b6;
    --override-fg: #7fe0d4;
    --override-soft: #3db4a61f;
    --highlight: #d9a53d44;
    --notice: #1a1612f0;
    --notice-fg: #ffad66;
    --axis-x: #e0727a;
    --axis-y: #82c46b;
    --tok-number: #b5cea8;
    --tok-string: #dfaa91;
    --tok-keyword: #daa3d5;
    --tok-name: #9cdcfe;
    --tok-path: #8fb4ee;
    --tok-punct: var(--muted-foreground);
}
body.comfortable { --h: 30dp; --topbar-h: 44dp; --text-line: 28dp; --input-line: 16dp; --input-pad: 6dp; --h-sm: 26dp; --row: 30dp; --gap: 3dp; --header-h: 36dp; --status-h: var(--studio-height-30, 30dp); --panel-h: var(--studio-height-34, 34dp); }
body:not(.dark) .tooltip { color: #fafafa; }
body:not(.dark) .tooltip .kbd { color: #a1a1aa; }
body:not(.dark) .tooltip .tip-about { color: #d4d4d8; }
/* next-themes: a palette change must not animate element by element. */
body.theme-switching * { transition: none; }

@media (theme: reduced-motion) {
    * { transition: none; }
}
/* Toasts (Sonner): 356 dp wide, 14 dp gap, bottom-right above the status bar. The
   kit drives transform, opacity and height with springs. */
.toaster { position: absolute; right: 16dp; bottom: 36dp; width: 356dp; height: 0dp; z-index: 35; pointer-events: none; }
.toast {
    position: absolute; left: 0dp; right: 0dp; bottom: 0dp; display: flex; align-items: flex-start; gap: 9dp;
    padding: 10dp 10dp 10dp 12dp; background-color: var(--popover); border: 1dp var(--popover-edge); border-radius: 8dp;
    transform-origin: 50% 0%; color: var(--foreground); overflow: hidden; box-shadow: var(--shadow-overlay);
}
.toast .lead { font-size: var(--studio-font-15, 15dp); width: 16dp; line-height: var(--studio-line-18, 18dp); flex: 0 0 auto; }
.toast[data-type=success] .lead { color: var(--success); }
.toast[data-type=info] .lead { color: var(--primary-text); }
.toast[data-type=warning] .lead { color: var(--warning); }
.toast[data-type=error] .lead { color: var(--destructive); }
.toast[data-type=loading] .lead { color: var(--muted-foreground); animation: 0.9s linear infinite toast-spin; }
@keyframes toast-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.toast .content { flex: 1 1 0dp; display: block; }
.toast .title { display: block; line-height: var(--studio-line-18, 18dp); font-weight: 500; }
.toast .description { display: block; line-height: var(--studio-line-16, 16dp); margin-top: 1dp; color: var(--muted-foreground); font-size: var(--studio-font-11, 11dp); white-space: normal; }
.toast .toast-action, .toast .toast-close { flex: 0 0 auto; }
.toast[data-behind] .lead, .toast[data-behind] .content, .toast[data-behind] .btn { opacity: 0; }
/* The palette, in shadcn/ui's tokens: light on :root, dark on .dark. A shadcn
   theme's two variable blocks paste over these, and the editor's roles
   (roles.rcss) follow them. */
:root {
    --radius: 6dp;
    --background: #fafbfc;
    --foreground: #1f2228;
    --card: #ffffff;
    --card-foreground: #1f2228;
    --popover: #ffffff;
    --popover-foreground: #1f2228;
    --primary: #2f62c0;
    --primary-foreground: #fcfdff;
    --secondary: #ebeef2;
    --secondary-foreground: #1f2228;
    --muted: #f1f3f6;
    --muted-foreground: #535d6c;
    --accent: #0000000a;
    --accent-foreground: #1f2228;
    --destructive: #b42332;
    --border: #d0d5dd;
    --input: #d0d5dd;
    --ring: #2f62c0;
}
.dark {
    --background: #1c1d21;
    --foreground: #e6e8ec;
    --card: #24262b;
    --card-foreground: #e6e8ec;
    --popover: #222428;
    --popover-foreground: #e6e8ec;
    --primary: #4471c4;
    --primary-foreground: #fcfdff;
    --secondary: #2c2f35;
    --secondary-foreground: #e6e8ec;
    --muted: #18191c;
    --muted-foreground: #a6acb7;
    --accent: #ffffff0d;
    --accent-foreground: #e6e8ec;
    --destructive: #ff9aa3;
    --border: #3a3e46;
    --input: #3a3e46;
    --ring: #8fb0ec;
}
/* Tree rows (Outliner, lists). */
.tree-row {
    display: flex; align-items: center; gap: 4dp; height: var(--row); padding-right: 4dp; border-radius: var(--r);
    color: var(--foreground); white-space: nowrap; border: 1dp transparent;
}
.tree-row:hover { background-color: var(--accent); }
.tree-row[data-selected] { background-color: var(--selected); }
.tree-row[data-active] { background-color: var(--active-row); }
.tree-row[data-active] .name { color: var(--strong); }
/* The rest of a multi-selection sits a step under the active row (Blender's
   Outliner). */
.tree-row[data-marked] { background-color: color-mix(in srgb, var(--selected) 55%, transparent); }
.tree-row:focus-visible { border-color: var(--ring); }
.tree-row .twisty { width: 14dp; font-size: 11dp; color: var(--faint-foreground); }
.tree-row .name { flex: 1 1 0dp; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tree-row .meta { color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); }
.tree-row .trail { display: flex; align-items: center; gap: 1dp; }
.tree-row .toggle { width: 20dp; height: var(--studio-height-18, 18dp); padding: 0dp; }
.tree-row .toggle .icon { color: var(--faint-foreground); font-size: 13dp; }
.tree-row .toggle[data-state=off] .icon { color: var(--disabled-foreground); }
.tree-row .toggle[data-state=on] { background-color: transparent; }
.tree-row .inline .icon { font-size: 12dp; width: 14dp; color: var(--link); }
/* The Outliner's eye and lock (Blender's restriction toggles) show while their
   row is hovered or while they are on; a hidden object's row recedes. */
.tree-row .view-toggles { display: flex; align-items: center; gap: 1dp; width: 41dp; flex-shrink: 0; }
.tree-row .view-toggles .toggle { visibility: hidden; }
.tree-row:hover .view-toggles .toggle, .tree-row .view-toggles .toggle[data-state=on] { visibility: visible; }
.tree-row .view-toggles .toggle[data-state=on] .icon { color: var(--muted-foreground); }
.tree-row[data-hidden] > .icon, .tree-row[data-hidden] .name, .tree-row[data-hidden] .inline { opacity: 0.5; }
/* The scene renders on a dark canvas in every theme, so the chrome over it
   keeps dark roles in the light themes. Scene.rcss and Canvas.rcss import
   this; `body:not(.dark)` reads the page body's theme class, which a panel's
   own rules see as a web page's do. */
body:not(.dark) .viewport {
    --foreground: #e8edf5; --muted-foreground: #aeb9ca; --faint-foreground: #aeb9ca; --line: #ffffff10; --accent: #ffffff0f; --press: #ffffff1a;
    --floating: #282c33ee; --primary-text: #9dbef5; --notice: #1a1612f0; --notice-fg: #ffad66;
}
/* Studio workspace (the kit's studio.rml), ported from
   docs/prototypes/studio/studio.css. Areas are Blender-style splits, each with
   a header and an editor type. */

body.studio { width: 100%; height: 100%; margin: 0dp; padding: 0dp; background-color: var(--app); overflow: hidden; }

#app { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; flex-direction: column; }

/* The top bar is projects/studio's TopBar, and each area's header its
   AreaHeader. A modified document's dot, as the Text Editor shows it. */
.dirty-dot { width: 6dp; height: 6dp; border-radius: 3dp; background-color: var(--muted-foreground); }

/* The top bar, the workspace (projects/studio's Workspace) and the status
   bar are documents of their own over their places in this one
   (kit_document_begin), and so is each area over its place in the
   workspace, so a change inside one lays out only that one. A bar's place
   takes its document's height; an area fills its document. */
.workspace-place { flex: 1 1 0dp; min-height: 0dp; }
.bar-place { flex: 0 0 auto; }
.area { position: relative; display: flex; flex-direction: column; background-color: var(--background); border-radius: var(--r-lg); overflow: hidden; }
body > .area { height: 100%; }
/* Editors' controls in their area's header. */
.area-head .menu-btn { color: var(--foreground); padding: 0dp 6dp; }
/* Breadcrumbs (studio_graph_nav.c): the behavior, the calls entered and the open graph. */
.area-head .crumbs { display: flex; align-items: center; gap: 2dp; color: var(--muted-foreground); white-space: nowrap; overflow: hidden; flex: 0 1 auto; min-width: 0dp; }
.area-head .crumbs .crumb { padding: 0dp 4dp; color: var(--muted-foreground); flex: 0 1 auto; min-width: 0dp; }
.area-head .crumbs .crumb .icon { flex: 0 0 auto; }
.area-head .crumbs .crumb .label { min-width: 0dp; overflow: hidden; text-overflow: ellipsis; }
.area-head .crumbs .crumb.current { color: var(--foreground); }
.area-head .crumbs .crumb-sep { color: var(--disabled-foreground); font-size: var(--studio-font-10, 10dp); width: 10dp; flex: 0 0 auto; }
.area-body { flex: 1 1 0dp; position: relative; overflow: hidden; }
.area-panel { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; overflow-y: auto; padding: 8dp; }

/* Outliner. */
.outliner { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; overflow-y: auto; padding: 3dp 4dp 8dp; }
.outliner-empty { position: absolute; left: 0dp; right: 0dp; top: 40dp; color: var(--faint-foreground); text-align: center; pointer-events: none; }

/* The Properties pane's authored shell is styled in Properties.rcss. */
.identity { display: flex; align-items: center; gap: 8dp; padding: 6dp 4dp 12dp; }
.identity .glyph { width: 30dp; height: 30dp; flex: 0 0 auto; border-radius: var(--r-lg); background-color: var(--panel-head); display: flex; align-items: center; justify-content: center; }
.identity .glyph .icon { font-size: 16dp; color: var(--foreground); }
.identity .who { flex: 1 1 0dp; display: flex; flex-direction: column; gap: 3dp; }
.identity .who .title { font-size: var(--studio-font-13, 13dp); font-weight: 600; }
/* The name, a field that reads as the title until hovered or edited (Unity's Inspector). */
.identity .name-field { display: flex; margin-left: -8dp; }
.identity .name-field .field.text { height: var(--studio-height-20, 20dp); background-color: transparent; border-color: transparent; }
.identity .name-field .field.text:hover { background-color: var(--input-hover); border-color: var(--input); }
.identity .name-field .field.text[data-editing] { background-color: var(--field-edit); border-color: var(--ring); }
.identity .name-field .field[data-readonly] { border-color: transparent; }
.identity .name-field input.value { font-size: var(--studio-font-13, 13dp); font-weight: 600; }
.identity .lineage { display: flex; align-items: center; gap: 4dp; color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); white-space: nowrap; }
.identity .lineage .btn { height: var(--studio-height-16, 16dp); padding: 0dp 3dp; font-size: var(--studio-font-11, 11dp); color: var(--muted-foreground); gap: 3dp; }
.identity .lineage .btn .icon { font-size: 10dp; width: 11dp; }
.prop-empty { padding: 20dp 8dp; color: var(--faint-foreground); text-align: center; }
.behavior-row { display: flex; align-items: center; gap: 6dp; height: var(--studio-height-26, 26dp); padding: 0dp 4dp 0dp 6dp; border-radius: var(--r); margin-top: 2dp; background-color: var(--secondary); }
.behavior-row { cursor: pointer; transition: background-color 0.11s cubic-out; }
.behavior-row:hover { background-color: var(--field-hover); }
.behavior-row[data-current] { background-color: var(--primary-soft); }
.behavior-row[data-current] .icon { color: var(--primary-text); }
.behavior-row .name { flex: 1 1 0dp; }
.behavior-row .graphs { color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); }
.add-row { margin-top: 6dp; display: flex; }
.add-row .btn { flex: 1 1 0dp; }

/* Behavior graph: the canvas is its own zoomed document (graph.rml), shown here. */
.graph-surface { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
.area-head .readout { color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); font-family: var(--font-numeric); padding: 0dp 4dp; }
/* A paused run's call stack floats over the canvas's bottom-left corner. */
.call-stack {
    position: absolute; left: 8dp; bottom: 8dp; width: 280dp; padding: 4dp; display: flex; flex-direction: column;
    background-color: var(--floating); border: 1dp var(--line); border-radius: var(--r-lg);
    opacity: 1; margin-top: 0dp; transition: opacity 0.14s cubic-out;
}
.call-stack[data-starting-style], .call-stack[data-ending-style] { opacity: 0; }
.call-stack[data-ending-style] { transition: opacity 0.1s cubic-out; }
.call-stack-head { display: flex; align-items: center; gap: 6dp; height: var(--studio-height-20, 20dp); padding: 0dp 6dp; font-size: var(--studio-font-12, 12dp); font-weight: 600; white-space: nowrap; overflow: hidden; }
.call-stack-head .dim { font-weight: 400; overflow: hidden; text-overflow: ellipsis; }
.call-stack .tree-row .icon { color: var(--faint-foreground); }
.call-stack .tree-row[data-selected] .icon { color: var(--warning); }

/* A source that feeds a pin, in Properties (the graph draws its own). */
.prop .chip { display: block; height: var(--studio-height-18, 18dp); padding: 0dp 6dp; border-radius: 3dp; background-color: var(--field-edit); color: var(--tok-name); font-size: var(--studio-font-11, 11dp); line-height: var(--studio-line-18, 18dp); white-space: nowrap; overflow: hidden; }

/* Editors without content yet. */
/* An empty graph's hint, over the canvas's middle; the canvas keeps the pointer. */
.graph-empty { position: absolute; left: 0dp; right: 0dp; top: 50%; text-align: center; color: var(--faint-foreground); pointer-events: none; }
.pending-editor { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; align-items: center; justify-content: center; color: var(--faint-foreground); background-color: var(--canvas); }
/* The Behavior area with no graph: the selected object's behaviors to open. */
.behavior-empty { flex-direction: column; gap: 6dp; padding: 16dp; }
.behavior-empty .glyph { font-size: 22dp; width: 28dp; line-height: 28dp; color: var(--disabled-foreground); }
.behavior-empty .title { color: var(--foreground); font-weight: 600; }
.behavior-choices { display: flex; flex-wrap: wrap; justify-content: center; gap: 6dp; max-width: 480dp; margin-top: 4dp; }

/* Find in the graph (GraphFind) and in the Text Editor (CodeFind): floats
   over the canvas's or the text's top right, as VS Code's find widget
   does. */
.find-widget {
    position: absolute; top: 8dp; right: 8dp; width: 340dp; display: flex; flex-direction: column; gap: 4dp;
    padding: 4dp; background-color: var(--popover); border: 1dp var(--popover-edge); border-radius: var(--r-lg);
    z-index: 5;
}
.find-widget-bar { display: flex; align-items: center; gap: 2dp; }
.find-widget-bar .search { flex: 1 1 0dp; min-width: 0dp; }
.find-widget-count { display: block; flex: 0 0 auto; padding: 0dp 4dp; line-height: var(--studio-line-16, 16dp); color: var(--faint-foreground); font-size: var(--studio-font-11, 11dp); font-family: var(--font-numeric); white-space: nowrap; }

/* The name filter of Assets (AssetsHeader) and of a UI document's Library. */
.assets-filter { flex: 1 1 0dp; display: flex; max-width: 220dp; margin-left: 4dp; }

/* A member's type swatch, in Members (Members.rcss) and its Properties. */
.member-swatch { width: 9dp; height: 9dp; flex: 0 0 auto; margin: 0dp 5dp 0dp 3dp; }
.object-rename .field { height: var(--studio-height-20, 20dp); margin-right: 4dp; }
/* Apply Overrides to Prototype: a checkbox per overridden field, its value
   beside it, as the refactor popover's rows. */
.popup.prototype-apply { width: 320dp; }
.prototype-field { display: flex; align-items: center; gap: 8dp; height: var(--h); padding: 0dp 8dp 0dp 6dp; white-space: nowrap; }
.prototype-field .check { flex: 1 1 auto; min-width: 0dp; overflow: hidden; }
.prototype-field .kbd { flex: 0 0 auto; margin-left: 16dp; color: var(--faint-foreground); font-family: var(--font-numeric); }
/* Rename and safe delete: the new name, then the assets it rewrites or the
   uses a delete leaves, as rows shaped like the menu's items. */
.popup.refactor { width: 300dp; }
.refactor-field { display: block; padding: 2dp 4dp 4dp; }
.refactor-field .field { height: var(--studio-height-24, 24dp); }
.refactor-row { display: flex; align-items: center; gap: 8dp; height: var(--h); padding: 0dp 8dp 0dp 6dp; white-space: nowrap; color: var(--foreground); }
.refactor-row .lead { color: var(--muted-foreground); }
.refactor-row .label { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; }
.refactor-row .kbd { margin-left: 16dp; flex: 0 0 auto; color: var(--faint-foreground); }
.type-pick { display: flex; align-items: center; gap: 2dp; flex: 1 1 0dp; }
.type-pick .member-swatch { margin: 0dp 4dp; }
.type-pick .type-button { flex: 1 1 0dp; justify-content: flex-start; overflow: hidden; }
.param-row { display: flex; flex-wrap: wrap; align-items: center; gap: 4dp; margin-top: var(--gap); }
.param-name { display: flex; align-items: center; gap: 4dp; flex: 1 0 160dp; min-width: 0dp; }
.param-name .btn { flex: 0 0 auto; }
.param-settings { display: flex; align-items: center; gap: 4dp; flex: 1 1 190dp; min-width: 0dp; }
.param-row .field { flex: 1 1 0dp; }
.param-settings .type-pick { flex: 1 1 104dp; min-width: 0dp; }
.param-settings .select { flex: 1 1 78dp; min-width: 0dp; }
.param-row .param-grip { flex: 0 0 12dp; width: 12dp; font-size: var(--studio-font-12, 12dp); color: var(--disabled-foreground); cursor: grab; }
.param-row .param-grip:hover { color: var(--muted-foreground); }
.param { border-radius: 4dp; }

/* UI documents (workstream D). The Text Editor: the part's code editor
   (kit_code) filling the body; its header is CodeHeader, whose Invalid chip
   says when the text does not read. */
.code-editor { position: absolute; left: 0dp; top: 0dp; right: 0dp; bottom: 0dp; display: flex; flex-direction: column; background-color: var(--background); }
.code-editor kit-code { flex: 1 1 0dp; min-height: 0dp; }
/* Assets ▸ New: the name of the new asset. */
.popup.new-asset { width: 260dp; }
.new-asset-field { display: block; padding: 2dp 4dp 4dp; }
.new-asset-field .field { height: var(--studio-height-24, 24dp); }
.new-asset-error { display: flex; align-items: center; gap: 8dp; min-height: var(--h); padding: 0dp 8dp 0dp 6dp; color: var(--destructive); }

/* Visual designer (workstream H): the Hierarchy, Details and Library are
   authored (Hierarchy.rcss, Details.rcss, Library.rcss); the theme keeps
   their headers' label and the Canvas's outlines. */
.designer-mode { display: block; flex: 0 0 auto; padding: 0dp 6dp 0dp 2dp; font-weight: 600; color: var(--foreground); white-space: nowrap; }
/* The Canvas: the element under the pointer, a drop's target and the
   selection, labeled as UMG labels its selected widget. */
.inspect-highlight.designer-hover .band.content { background-color: transparent; border: 1dp var(--primary-edge); }
.inspect-highlight.designer-target .band.content { background-color: var(--primary-soft); border: 1dp var(--primary); }
.inspect-highlight.selected .label { color: var(--primary-foreground); background-color: var(--primary); border-color: var(--primary); }
.designer-drop { position: absolute; pointer-events: none; }
.designer-drop[data-active] { pointer-events: auto; }
.designer-drop[data-drop-over] { background-color: transparent; }
/* Workstream Q: where a Canvas drop lands between siblings. */
.designer-drop-line { position: absolute; pointer-events: none; background-color: var(--primary); border-radius: 1dp; }
/* The selection's resize handles (Unity UI Builder's): its right and bottom
   edges and corner. */
.designer-handle { position: absolute; pointer-events: auto; background-color: var(--primary-foreground); border: 1dp var(--primary); border-radius: 2dp; }
.designer-handle:hover, .designer-handle[data-active] { background-color: var(--primary); }
.designer-handle.e { cursor: ew-resize; }
.designer-handle.s { cursor: ns-resize; }
.designer-handle.se { cursor: nwse-resize; }
version 22
name "Studio"
content "content"
start_scene "scenes/Studio.kdl"
ui "StudioShell"
// From Neon-Swarm shaders/color.shd.
// Shared color and blending utilities.

vec4 alpha_over(vec4 front, vec4 back)
{
    return front + back * (1.0 - front.a);
}

vec3 linear_to_srgb(vec3 c)
{
    return pow(c, vec3(1.0 / 2.2));
}

float dither8bit_ign(vec2 pixel, float frame)
{
    pixel += frame * 5.588238;
    float t = fract(52.9829189 * fract(dot(pixel, vec2(0.06711056, 0.00583715))));
    return (t - 0.5) / 255.0;
}
// Adapted from the user-supplied Neon-Swarm shaders. Original shader equations retained.
// Shared std430 layout; must match render_material_entity in material_raster.h.

#define SHAPE_CIRCLE   0
#define SHAPE_BOX      1
#define SHAPE_CAPSULE  2
#define SHAPE_LINE     3
#define SHAPE_TRI      4
#define SHAPE_POLY     5
#define SHAPE_DIAMOND    6
#define SHAPE_POLY_FILL  7
#define SHAPE_SPRITE     8

struct Entity {
    vec4 inv_rot;       // inv_xx, inv_xy, inv_yx, inv_yy
    vec2 pos;           // pos_x, pos_y
    vec2 extent;       // conservative world-space half extents
    uint shape_type;
    float radius;
    float thickness;
    float chubbiness;
    float aa;
    uint point_count;
    uint metaball_group;
    float metaball_blend;
    float border_thickness;
    float reserved0; float reserved1; float reserved2;
    vec4 points_01;     // points[0..3]
    vec4 points_23;     // points[4..7]
    vec4 points_45;     // points[8..11]
    vec4 points_67;     // points[12..15]
    vec4 scene;
    vec4 emission;
    vec4 absorption;
    vec4 albedo;
    vec4 border_scene;
    vec4 border_emission;
    vec4 border_absorption;
    vec4 border_albedo;
    vec3 simulation_time; // .x = time, .y = parameter block, .z = emission scale
    float tile_group;   // nonzero: adds coverage with neighbors sharing it
    vec4 material_frame; // laid-out position (Y up), cos, sin; zero cos and sin = none
};
layout(set = 2, binding = 1) uniform sampler2D visibility_mask;
layout(set = 3, binding = 1) uniform shd_uniforms {
    mat4 eye_rays;
    vec3 eye;
    vec4 fog_color;
    vec2 grid_origin;
    vec2 grid_extent;
    vec2 view_center;
    vec2 view_span;
    float fog_time;
    int perspective;
};

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 ndc = params.screen_uv * vec2(2, -2) + vec2(-1, 1);
    vec2 world = view_center + ndc * view_span * vec2(0.5, -0.5);
    bool ground = true;
    if (perspective != 0) {
        // Unprojected about the eye, so a distant eye keeps its rays precise.
        vec4 near_h = eye_rays * vec4(ndc, 0, 1);
        vec4 far_h = eye_rays * vec4(ndc, 1, 1);
        vec3 start = near_h.xyz / near_h.w;
        vec3 origin = eye + start;
        vec3 direction = far_h.xyz / far_h.w - start;
        // A ray that never reaches the ground ahead sees past the grid.
        ground = origin.y * direction.y < 0;
        world = (origin + direction * (ground ? -origin.y / direction.y : 1)).xz;
    }
    vec2 uv = (world - grid_origin) / grid_extent;
    float sight = texture(visibility_mask, clamp(uv, vec2(0), vec2(1))).r;
    if (!ground || any(lessThan(uv, vec2(0))) || any(greaterThanEqual(uv, vec2(1)))) sight = 0;
    float opacity = 1 - smoothstep(0.15, 0.85, sight);
    float clouds = sin(world.x * 0.018 + fog_time * 0.2) * sin(world.y * 0.023 - fog_time * 0.13);
    vec3 tint = fog_color.rgb * (1 + clouds * 0.12);
    return vec4(tint, opacity);
}
// Adapted from Neon-Swarm shaders/hrc/bounce.shd; original source comments retained.
// Reflected light for the next frame's transport: albedo times this frame's
// received far light. Alpha blending with u_hysteresis as alpha mixes it into
// the previous result in place.

layout(set = 2, binding = 0) uniform sampler2D u_radiance;
layout(set = 2, binding = 1) uniform sampler2D u_albedo;

layout(location = 0) out vec4 out_value;

layout(set = 3, binding = 0) uniform uniform_block
{
	float u_hysteresis;
};

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	vec2 size = vec2(textureSize(u_radiance, 0));
	ivec2 albedo_p = ivec2((vec2(p) + 0.5) * vec2(textureSize(u_albedo, 0)) / size);
	vec3 bounce = texelFetch(u_albedo, albedo_p, 0).rgb * texelFetch(u_radiance, p, 0).rgb;
	out_value = vec4(bounce, u_hysteresis);
}
// GGX distribution, height-correlated Smith visibility and Schlick Fresnel for
// a dielectric, viewed straight down the camera axis.
float highlight(vec3 n, vec3 l, float roughness)
{
    float nl = dot(n, l);
    if (nl <= 0.0) return 0.0;
    vec3 h = normalize(l + vec3(0, 0, 1));
    float nv = max(n.z, 0.0001);
    float nh = max(dot(n, h), 0.0);
    float alpha = max(roughness * roughness, 0.0025);
    float a2 = alpha * alpha;
    float d = nh * nh * (a2 - 1.0) + 1.0;
    float distribution = a2 / max(3.14159265 * d * d, 0.00000001);
    float visibility = 0.5 / max(nl * sqrt(nv * nv * (1.0 - a2) + a2) +
                                 nv * sqrt(nl * nl * (1.0 - a2) + a2), 0.0001);
    float fresnel = 0.04 + 0.96 * pow(1.0 - max(h.z, 0.0), 5.0);
    return fresnel * distribution * visibility * nl;
}
// Material targets; see render_material_textures.
layout(set = 2, binding = 1) uniform sampler2D scene_tex;
layout(set = 2, binding = 2) uniform sampler2D fluence_tex;
layout(set = 2, binding = 3) uniform sampler2D source_tex;
layout(set = 2, binding = 4) uniform sampler2D albedo_tex;
layout(set = 2, binding = 5) uniform sampler2D normal_tex;

layout(set = 2, binding = 6) uniform sampler2D background_tex;
layout(set = 2, binding = 7) uniform sampler2D visibility_tex;
layout(set = 2, binding = 8) uniform sampler2D surface_q0;
layout(set = 2, binding = 9) uniform sampler2D surface_q1;
layout(set = 2, binding = 10) uniform sampler2D surface_q2;
layout(set = 2, binding = 11) uniform sampler2D surface_q3;
layout(set = 2, binding = 12) uniform sampler2D cover_tex;
layout(set = 2, binding = 13) uniform sampler2D horizon_cardinal;
layout(set = 2, binding = 14) uniform sampler2D horizon_diagonal;

layout(set = 3, binding = 1) uniform shd_uniforms
{
    float ambient;
    float intensity;
    float debug_view;
    float shadow_floor;
    float fog;
    float dither_phase;
    vec4 crop_uv;
    float surface_sigma;
    // x enabled, y relief, z bevel, w specular gain.
    vec4 surface_params;
    // xy canvas uv to surface uv scale, zw one surface texel in uv.
    vec4 surface_map;
    int linear_output;
    float world_per_px;
    float reconstruction_threshold;
    int horizon_directions;
    int surface_mode;
    float surface_thickness;
    float surface_depth_gain;
    float surface_depth_shadow_softness;
    vec4 surface_projection;
    vec2 surface_world_per_px;
};

#include "color.shd"
#include "hrc/brdf.shd"
#include "hrc/surface_geometry.shd"

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float reconstruction_transmittance(ivec2 p, ivec2 sample_size, ivec2 full_size)
{
    vec2 uv = (vec2(p) + 0.5) / vec2(sample_size);
    ivec2 absorption_p = clamp(ivec2(uv * vec2(full_size)), ivec2(0), full_size - 1);
    float tau = texelFetch(source_tex, absorption_p, 0).a;
    return exp(-max(tau, 0.0));
}

vec4 reconstruction_weights(vec2 uv, ivec2 sample_size, ivec2 full_size,
                            out ivec2 p00, out ivec2 p10,
                            out ivec2 p01, out ivec2 p11)
{
    vec2 grid = uv * vec2(sample_size) - 0.5;
    ivec2 base = ivec2(floor(grid));
    vec2 f = fract(grid);
    ivec2 last = sample_size - 1;
    p00 = clamp(base, ivec2(0), last);
    p10 = clamp(base + ivec2(1, 0), ivec2(0), last);
    p01 = clamp(base + ivec2(0, 1), ivec2(0), last);
    p11 = clamp(base + ivec2(1, 1), ivec2(0), last);

    ivec2 center = clamp(ivec2(uv * vec2(full_size)), ivec2(0), full_size - 1);
    float target = exp(-max(texelFetch(source_tex, center, 0).a, 0.0));
    float t00 = reconstruction_transmittance(p00, sample_size, full_size) - target;
    float t10 = reconstruction_transmittance(p10, sample_size, full_size) - target;
    float t01 = reconstruction_transmittance(p01, sample_size, full_size) - target;
    float t11 = reconstruction_transmittance(p11, sample_size, full_size) - target;
    float sigma = max(reconstruction_threshold, 0.02);
    float sigma2 = 2.0 * sigma * sigma;
    return vec4((1.0 - f.x) * (1.0 - f.y) * exp(-(t00 * t00) / sigma2),
                f.x * (1.0 - f.y) * exp(-(t10 * t10) / sigma2),
                (1.0 - f.x) * f.y * exp(-(t01 * t01) / sigma2),
                f.x * f.y * exp(-(t11 * t11) / sigma2));
}

// Height and geometry coverage. Fog's display coverage does not change relief.
// Mesh samples retain a real face plane through subpixel shadow queries.
vec2 relief_at(vec2 uv)
{
    ivec2 size = textureSize(albedo_tex, 0);
    ivec2 p = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
    vec4 geometry = texelFetch(cover_tex, p, 0);
    if (geometry.g <= 1e-6) return vec2(0);
    float height = texelFetch(albedo_tex, p, 0).a / geometry.g;
    if (geometry.b > geometry.g * 0.5) {
        vec2 tilt = texelFetch(normal_tex, p, 0).xy / geometry.g;
        float nz = sqrt(max(1.0 - dot(tilt, tilt), 0.0));
        vec2 offset = (uv * vec2(size) - (vec2(p) + 0.5)) * world_per_px;
        if (nz > 0.05) height -= dot(tilt, vec2(offset.x, -offset.y)) / nz;
    }
    return vec2(height, geometry.g);
}

vec4 quadrant_at(int i, vec2 uv)
{
    if (i == 0) return texture(surface_q0, uv);
    if (i == 1) return texture(surface_q1, uv);
    if (i == 2) return texture(surface_q2, uv);
    return texture(surface_q3, uv);
}

float horizon_angle(ivec2 p, int direction)
{
    if (horizon_directions == 4) return texelFetch(horizon_cardinal, p, 0)[direction];
    if ((direction & 1) == 0) return texelFetch(horizon_cardinal, p, 0)[direction / 2];
    return texelFetch(horizon_diagonal, p, 0)[direction / 2];
}

float horizon_shadow(vec2 uv, vec2 toward)
{
    const float TAU = 6.283185307179586;
    float azimuth = mod(atan(-toward.y, toward.x) + TAU, TAU);
    float sector = azimuth * float(horizon_directions) / TAU;
    int first = int(floor(sector)) % horizon_directions;
    int next = (first + 1) % horizon_directions;
    ivec2 size = textureSize(horizon_cardinal, 0);
    ivec2 p = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
    float angle = mix(horizon_angle(p, first), horizon_angle(p, next), fract(sector));
    float elevation = atan(1.0 / surface_params.y);
    // A small angular transition avoids a hard threshold. This is explicitly
    // an alternative to the reference's height-penetration softness.
    return smoothstep(angle - 0.03, angle + 0.03, elevation);
}

float surface_shadow(vec2 uv, vec2 toward, vec2 relief)
{
    if (surface_params.y <= 0.0 || relief.y <= 0.5) return 1.0;
    if (horizon_directions > 0) return horizon_shadow(uv, toward);
    const float STEP = 0.6;
    vec2 pixel_uv = 1.0 / vec2(textureSize(albedo_tex, 0));
    vec2 step_uv = vec2(toward.x, -toward.y) * (STEP / world_per_px) * pixel_uv;
    float rise = STEP / surface_params.y;
    float shadow = 1.0;
    for (int i = 1; i <= 10; i++) {
        vec2 r = relief_at(uv + step_uv * float(i));
        if (r.y < 0.5) break;
        // Half-float height storage requires a bias that follows its precision.
        float bias = max(0.002, max(abs(relief.x), abs(r.x)) * 0.001);
        shadow = min(shadow, clamp(1.0 - (r.x - relief.x - rise * float(i) - bias), 0.0, 1.0));
    }
    return shadow;
}

vec3 sample_fluence(vec2 uv)
{
    ivec2 sample_size = textureSize(fluence_tex, 0);
    ivec2 full_size = textureSize(source_tex, 0);
    if (all(equal(sample_size, full_size))) return texture(fluence_tex, uv).rgb;

    ivec2 p00, p10, p01, p11;
    vec4 weights = reconstruction_weights(uv, sample_size, full_size, p00, p10, p01, p11);
    float total = dot(weights, vec4(1));
    if (total <= 1e-6) return vec3(0);
    vec3 sum = texelFetch(fluence_tex, p00, 0).rgb * weights.x +
               texelFetch(fluence_tex, p10, 0).rgb * weights.y +
               texelFetch(fluence_tex, p01, 0).rgb * weights.z +
               texelFetch(fluence_tex, p11, 0).rgb * weights.w;
    return max(sum / total, vec3(0));
}

// Geometry remains an exact sample and rejects faces across depth or normal
// boundaries. The low-resolution pass has already denoised the radiance.
void depth_surface_sample(ivec2 p, float spatial, vec3 n,
                          vec3 origin, float sigma, float gloss,
                          inout vec3 light, inout vec3 specular,
                          inout float total, inout float specular_total)
{
    ivec2 size = textureSize(surface_q0, 0);
    if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, size))) return;
    if (spatial <= 0.0) return;
    vec4 geometry = texelFetch(surface_q2, p, 0);
    if (geometry.a < 0.5) return;
    float agreement = dot(n, geometry.xyz);
    if (agreement < 0.5) return;
    vec4 sample_light = texelFetch(surface_q0, p, 0);
    vec2 canvas_size = vec2(textureSize(cover_tex, 0));
    vec3 position = surface_position(surface_receiver_pixel(p, canvas_size, surface_projection.w),
                                     sample_light.a, surface_projection, surface_world_per_px);
    float dz = surface_plane_distance(position - origin, n, geometry.xyz) / sigma;
    if (abs(dz) > 1.0) return;
    float weight = spatial * pow(agreement, 8.0) * exp(-dz * dz);
    float boundary = smoothstep(0.5, 0.7, agreement) * (1.0 - smoothstep(0.6, 1.0, abs(dz)));
    weight *= mix(1.0, boundary, surface_depth_shadow_softness);
    light += max(sample_light.rgb, vec3(0)) * weight;
    if (gloss > 0.0 && surface_params.w > 0.0) {
        vec4 sample_specular = texelFetch(surface_q1, p, 0);
        float specular_weight = weight * max(1.0 - abs(gloss - sample_specular.a) * 10.0, 0.0);
        specular += max(sample_specular.rgb, vec3(0)) * specular_weight;
        specular_total += specular_weight;
    }
    total += weight;
}

vec3 depth_surface_light(vec2 uv, vec3 n, float height, float gloss, out vec3 specular)
{
    ivec2 size = textureSize(surface_q0, 0);
    vec2 grid = uv * vec2(size) - 0.5;
    ivec2 base = ivec2(floor(grid));
    vec2 fraction = fract(grid);
    float sigma = max(max(surface_thickness * 0.25, world_per_px * 8.0), 0.001);
    vec2 pixel = uv / surface_map.xy * vec2(textureSize(cover_tex, 0));
    vec3 origin = surface_position(pixel, height, surface_projection, surface_world_per_px);
    vec3 light = vec3(0);
    specular = vec3(0);
    float total = 0.0, specular_total = 0.0;
    for (int y = 0; y < 2; y++) {
        for (int x = 0; x < 2; x++) {
            vec2 w = mix(vec2(1.0) - fraction, fraction, vec2(x, y));
            depth_surface_sample(base + ivec2(x, y), w.x * w.y,
                                 n, origin, sigma, gloss, light, specular, total, specular_total);
        }
    }
    if (total > 1e-6) {
        specular /= max(specular_total, 1e-6);
        return light / total;
    }
    // Thin silhouettes may miss all four receiver cells. Borrow only from
    // compatible nearby geometry, never because valid samples are dark.
    ivec2 center = ivec2(floor(grid + 0.5));
    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            ivec2 p = center + ivec2(x, y);
            if (all(greaterThanEqual(p, base)) && all(lessThanEqual(p, base + 1))) continue;
            vec2 offset = vec2(p) - grid;
            float spatial = max(1.0 - dot(offset, offset) / 6.25, 0.0);
            depth_surface_sample(p, spatial * spatial,
                                 n, origin, sigma, gloss, light, specular, total, specular_total);
        }
    }
    specular /= max(specular_total, 1e-6);
    return total > 1e-6 ? light / total : vec3(0);
}



// Emission as display shows it: each texel's light scaled back by its cover,
// then filtered, so partly covered edges keep their coverage.
vec3 display_emission(vec2 uv)
{
    ivec2 size = textureSize(source_tex, 0);
    vec2 p = uv * vec2(size) - 0.5;
    ivec2 lo = clamp(ivec2(floor(p)), ivec2(0), size - 1);
    ivec2 hi = min(lo + 1, size - 1);
    vec2 f = clamp(p - floor(p), 0.0, 1.0);
    vec3 e00 = texelFetch(source_tex, lo, 0).rgb * texelFetch(cover_tex, lo, 0).r;
    vec3 e10 = texelFetch(source_tex, ivec2(hi.x, lo.y), 0).rgb * texelFetch(cover_tex, ivec2(hi.x, lo.y), 0).r;
    vec3 e01 = texelFetch(source_tex, ivec2(lo.x, hi.y), 0).rgb * texelFetch(cover_tex, ivec2(lo.x, hi.y), 0).r;
    vec3 e11 = texelFetch(source_tex, hi, 0).rgb * texelFetch(cover_tex, hi, 0).r;
    return mix(mix(e00, e10, f.x), mix(e01, e11, f.x), f.y);
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 source_uv = mix(crop_uv.xy, crop_uv.zw, screen_uv);
    vec4 scene = texture(scene_tex, source_uv);
    vec4 source = texture(source_tex, source_uv);
    vec3 emission = display_emission(source_uv);
    vec3 albedo = texture(albedo_tex, source_uv).rgb;
    vec3 fluence = sample_fluence(source_uv);
    vec4 normal = texture(normal_tex, source_uv);

    int mode = int(debug_view + 0.5);
    if (mode == 1) return scene;
    if (mode == 2) return vec4(emission, 1.0);
    if (mode == 3) return vec4(vec3(exp(-source.a)), 1.0);
    if (mode == 4) return vec4(albedo, 1.0);
    if (mode == 5) return vec4(fluence * 5.0, 1.0);
    if (mode == 6) return vec4(normal.xyz * 0.5 + 0.5, normal.a);

    // Screen-space liquid distortion samples the background and incident light.
    // Foreground opaque objects remain in front; this is not a depth/Snell solve.
    vec2 pixel_uv = 1.0 / vec2(textureSize(normal_tex, 0));
    vec2 distortion = normal.z < 0.0 ? normal.xy * (-normal.z) * pixel_uv : vec2(0);
    vec2 fluence_uv = source_uv + distortion;
    if (normal.z < 0.0) fluence = sample_fluence(fluence_uv);
    vec4 visibility = texture(visibility_tex, source_uv);
    // The same exposure as visible emitters reveals light received by fluid.
    // Coverage blends this artistic gain; it never feeds the transport solver.
    float volume_exposure = mix(1.0, intensity, visibility.a);
    vec3 incident = fluence * volume_exposure;
    if (normal.z < 0.0) {
        // Liquid edges brighten from light received just outside them.
        vec2 reach = 8.0 * pixel_uv;
        vec3 outside = .25 * (sample_fluence(source_uv + vec2(reach.x, 0)) +
                              sample_fluence(source_uv - vec2(reach.x, 0)) +
                              sample_fluence(source_uv + vec2(0, reach.y)) +
                              sample_fluence(source_uv - vec2(0, reach.y)));
        incident += outside * normal.a * 2.0 * intensity;
    }

    // Each quadrant keeps its RGB energy through the BRDF and visibility.
    // The four evaluations are independent of the number of emitters.
    vec4 geometry = texture(cover_tex, source_uv);
    bool mesh = geometry.b > geometry.g * 0.5 && geometry.g > 0.0;
    if (normal.z >= 0.0 && geometry.g > 1e-6) normal /= geometry.g;
    bool solid = normal.z > 0.0 || (normal.z == 0.0 && (normal.w > 0.0 || dot(normal.xy, normal.xy) > 0.0));
    vec2 tilt = solid ? normal.xy : vec2(0);
    vec2 suv = source_uv * surface_map.xy;
    vec2 dx = vec2(surface_map.z, 0), dy = vec2(0, surface_map.w);
    float open = max(quadrant_at(0, suv).a, 0.0);
    if (solid && !mesh && surface_params.x > 0.0 && surface_mode == 0) {
        vec2 outward = 0.5 * surface_sigma * vec2(
            quadrant_at(0, suv + dx).a - quadrant_at(0, suv - dx).a,
            quadrant_at(0, suv - dy).a - quadrant_at(0, suv + dy).a);
        tilt += outward * surface_params.z * step(1e-4, normal.z);
    }
    vec3 n = solid ? normalize(vec3(tilt, sqrt(max(1.0 - dot(normal.xy, normal.xy), 0.0)))) : vec3(0, 0, 1);
    vec3 surface_light = vec3(0), surface_shaded = vec3(0);
    vec2 dominant = vec2(0);
    float energy = 0.0, shadow_sum = 0.0;
    vec2 axes[4] = vec2[4](vec2(1, 0), vec2(0, -1), vec2(-1, 0), vec2(0, 1));
    vec2 relief = relief_at(source_uv);
    if (solid && surface_params.x > 0.0 && surface_mode == 2) {
        vec3 specular;
        float gain = intensity * surface_depth_gain;
        surface_light = depth_surface_light(suv, n, relief.x, normal.w, specular) * gain;
        surface_shaded = (surface_light * albedo +
            specular * gain * surface_params.w * geometry.g) * normal.z;
        vec4 direction = texture(surface_q3, suv);
        dominant = direction.xy;
        energy = 1.0;
        shadow_sum = direction.z;
    }
    if (solid && surface_params.x > 0.0 && surface_mode != 2) {
        float reach = clamp((2.0 * open - 0.05) / 0.95, 0.0, 1.0);
        float gain = reach * normal.z * intensity / max(open, 1e-4);
        float gloss = clamp(normal.w, 0.0, 1.0);
        for (int i = 0; i < 4; i++) {
            vec3 q = max(quadrant_at(i, suv).rgb, vec3(0));
            float power = dot(q, LUMA);
            if (power <= 1e-8) continue;
            // Gather's visibility changes are not light-source gradients.
            // Its probes already follow these four axes; bending directions
            // from sparse visibility would create false specular highlights.
            vec2 toward = axes[i];
            if (surface_mode == 0) {
                vec2 gradient = vec2(
                    dot(quadrant_at(i, suv + dx).rgb - quadrant_at(i, suv - dx).rgb, LUMA),
                    dot(quadrant_at(i, suv - dy).rgb - quadrant_at(i, suv + dy).rgb, LUMA));
                vec2 slope = 0.5 * surface_sigma * gradient / power;
                toward += slope / max(1.0, length(slope));
                toward -= axes[i] * min(dot(toward, axes[i]) - 0.2, 0.0);
                toward = normalize(toward);
            }
            vec3 l = normalize(vec3(toward * surface_params.y, 1.0));
            float shadow = surface_shadow(source_uv, toward, relief);
            float diffuse = max(dot(n, l), 0.0) / l.z;
            float specular = gloss > 0.0
                ? 3.14159265 * highlight(n, l, 1.0 - gloss) / l.z * surface_params.w : 0.0;
            vec3 received = q * gain;
            surface_light += received;
            surface_shaded += received * (albedo * diffuse + vec3(specular * geometry.g)) * shadow;
            dominant += toward * power;
            shadow_sum += shadow * power;
            energy += power;
        }
    }
    dominant /= max(energy, 1e-8);
    if (mode == 7) return vec4(surface_light, 1.0);
    if (mode == 8) return vec4(dominant * 0.5 + 0.5, energy > 0.0 ? shadow_sum / energy : 1.0, 1.0);
    if (mode == 9) return vec4(n * 0.5 + 0.5, 1.0);

    // Surface light is an artistic addition to HRC. Depth gain controls its
    // direct-light overlap; it never replaces HRC or feeds temporal bounce.
    vec3 lit = incident * albedo + surface_shaded;
    lit += max(albedo * shadow_floor, visibility.rgb);
    vec3 out_linear = fluence * fog + emission * intensity + scene.rgb * ambient + lit;
    vec2 background_uv = clamp(screen_uv + distortion / (crop_uv.zw - crop_uv.xy), vec2(0), vec2(1));
    out_linear += texture(background_tex, background_uv).rgb * (1.0 - scene.a);
    if (linear_output != 0) return vec4(max(out_linear, vec3(0.0)), 1.0);
    vec3 out_srgb = linear_to_srgb(max(out_linear, vec3(0.0)));
    float dither = dither8bit_ign(gl_FragCoord.xy, dither_phase);
    return vec4(clamp(out_srgb + vec3(dither), vec3(0.0), vec3(1.0)), 1.0);
}
// Separable dilation at tile resolution includes the complete shadow reach.
layout(set = 2, binding = 0) uniform sampler2D u_dirty;
layout(set = 3, binding = 0) uniform uniform_block
{
    ivec2 u_axis;
    int u_radius;
};
layout(location = 0) out vec4 out_dirty;
void main()
{
    ivec2 p = ivec2(gl_FragCoord.xy);
    ivec2 size = textureSize(u_dirty, 0);
    out_dirty = vec4(0);
    for (int i = -u_radius; i <= u_radius; i++) {
        ivec2 q = p + u_axis * i;
        if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
        if (texelFetch(u_dirty, q, 0).r > 0.5) { out_dirty = vec4(1); return; }
    }
}
// Averages prefiltered transport inputs over square blocks of u_factor fine
// cells for color transport under a finer luminance transport. The view snaps
// to whole coarse cells, so blocks stay world-aligned; blocks past a
// dimension's end cover what remains.
// Light and transmittance average over a step of the coarse cell's length, in
// canvas pixels, as hrc/source_average.shd describes.

#include "hrc/source_average.shd"

layout(set = 2, binding = 0) uniform sampler2D u_source;
layout(set = 2, binding = 1) uniform sampler2D u_bounce;

layout(location = 0) out vec4 out_source;
layout(location = 1) out vec4 out_bounce;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_fine_w;
	int u_fine_h;
	int u_factor;
	float u_coarse_step;
};

void main()
{
	ivec2 gid = ivec2(gl_FragCoord.xy);

	ivec2 lo = gid * u_factor;
	ivec2 hi = min(lo + u_factor, ivec2(u_fine_w, u_fine_h));

	vec4 part = vec4(0.0), bounce = vec4(0.0);
	for (int y = lo.y; y < hi.y; y++) {
		for (int x = lo.x; x < hi.x; x++) {
			part += source_step(texelFetch(u_source, ivec2(x, y), 0), u_coarse_step);
			bounce += texelFetch(u_bounce, ivec2(x, y), 0);
		}
	}
	float inv_count = 1.0 / float((hi.x - lo.x) * (hi.y - lo.y));
	out_source = source_resolve(part * inv_count, u_coarse_step);
	out_bounce = bounce * inv_count;
}
// Uniform source proxies survive camera occlusion. Additive blending preserves
// overlapping sources' energy, but their weighted position is an approximation.
#include "hrc/emitter_encoding.shd"
layout(location = 0) in vec2 uv;
layout(location = 1) in vec3 center;
layout(location = 2) in vec3 emission;
layout(location = 3) in float density;
layout(location = 4) in float source_radius;
layout(set = 3, binding = 0) uniform uniform_block
{
    vec2 u_capture_size;
};
layout(location = 0) out vec4 out_source;
layout(location = 1) out vec4 out_moments;
void main()
{
    float distance = length(uv);
    float width = max(fwidth(distance), 1e-5);
    float coverage = 1.0 - smoothstep(1.0 - width * 0.5, 1.0 + width * 0.5, distance);
    if (density < 0.0) {
        vec2 weight = max(vec2(1.0) - abs(gl_FragCoord.xy - center.xy * u_capture_size), vec2(0));
        coverage = weight.x * weight.y;
    }
    vec3 light = max(emission, vec3(0)) * abs(density) * coverage;
    float power = dot(light, vec3(0.2126, 0.7152, 0.0722));
    float depth = center.z / 1024.0;
    out_source = vec4(light / EMITTER_STORAGE_SCALE, coverage * abs(density));
    out_moments = vec4(center.xy, depth, source_radius) * power / EMITTER_STORAGE_SCALE;
}
layout(location = 0) in vec2 in_pos;
layout(location = 1) in vec2 in_uv;
layout(location = 2) in vec3 in_center;
layout(location = 3) in vec3 in_emission;
layout(location = 4) in float in_scale;
layout(location = 5) in float in_radius;
layout(location = 0) out vec2 uv;
layout(location = 1) out vec3 center;
layout(location = 2) out vec3 emission;
layout(location = 3) out float density;
layout(location = 4) out float source_radius;
void main()
{
    gl_Position = vec4(in_pos.x, -in_pos.y, 0.0, 1.0);
    uv = in_uv;
    center = in_center;
    emission = in_emission;
    density = in_scale;
    source_radius = in_radius;
}
// Both RGB density and weighted moments use this storage scale in the
// independent RGBA16F additive capture. Decode RGB at its first reduction;
// divide moments by encoded luminance before restoring depth world units.
const float EMITTER_STORAGE_SCALE = 1024.0;
// Adapted from the user-supplied Neon-Swarm shaders. Original shader equations retained.
// Entity tile rasterization pass.
//
// A full-screen fragment pass. Each pixel iterates its 16x16 tile's entity
// list, transforms to entity local space, evaluates the shape SDF, and blends
// the results into render targets, which the GPU compresses:
//   scene:  premultiplied color, A coverage
//   source: RGB emission, A optical depth (mean absorption) for the transport
//   albedo: RGB albedo, A material height times coverage; the coverage is
//           scene's alpha, which the same over-recurrence accumulates
//   normal: see render_material_textures
//   visibility: zero; fluid adds it
//   cover: R, the scale that returns source's emission to display's
// Later batches start from the previous batch's targets.

#include "entity.shd"
#ifdef SG_MESH_LAYER
layout(set = 2, binding = 5) uniform sampler2D u_mesh_scene;
layout(set = 2, binding = 6) uniform sampler2D u_mesh_emission;
layout(set = 2, binding = 7) uniform sampler2D u_mesh_absorption;
layout(set = 2, binding = 8) uniform sampler2D u_mesh_albedo;
layout(set = 2, binding = 9) uniform sampler2D u_mesh_normal;
#endif
#ifndef SG_ENTITY_BINDING
#define SG_PREVIOUS_SCENE_BINDING 0
#define SG_PREVIOUS_SOURCE_BINDING 1
#define SG_PREVIOUS_ALBEDO_BINDING 2
#define SG_PREVIOUS_NORMAL_BINDING 3
#define SG_PREVIOUS_COVER_BINDING 4
#define SG_ENTITY_BINDING 0
#define SG_COUNTS_BINDING 1
#define SG_INDICES_BINDING 2
#define SG_PARAMETERS_BINDING 3
#endif
#ifndef SG_GRAPHS
#define SG_OUTPUTS 9
void sg_dispatch_2d(int id,vec2 p,vec2 wp,vec2 half_size,vec4 object_frame,float time,vec4 values[32],out vec4 result[SG_OUTPUTS]) {
 for(int i=0;i<SG_OUTPUTS;i++) result[i]=vec4(0);
}
vec4 sg_image_sample(int id,vec2 uv) { return vec4(0); }
layout(set = 3, binding = 0) uniform uniform_block {
    float u_world_min_x;
    float u_world_max_y;
    vec2 u_unit_per_px;
    vec4 u_plane_right;
    vec4 u_plane_down;
    vec4 u_plane_target;
    int u_tiles_x;
    int u_has_previous;
    int u_first_entity;
    int u_last_entity;
    int u_metaball_group;
};
#endif
// GLSL ES emulates each storage buffer as texel fetches of a single vec4 or
// uvec4 array, so entities and tile lists are read through uvec4 arrays.
layout(set = 2, binding = SG_ENTITY_BINDING) readonly buffer EntityBuf { uvec4 entity_data[]; };
layout(set = 2, binding = SG_COUNTS_BINDING) readonly buffer TileOffsets { uvec4 tile_offsets[]; };
layout(set = 2, binding = SG_INDICES_BINDING) readonly buffer TileEntities { uvec4 tile_entities[]; };
layout(set = 2, binding = SG_PARAMETERS_BINDING) readonly buffer ShaderParameters { vec4 shader_parameters[]; };

#define ENTITY_VEC4S 19u

uint tile_offset(uint i) { return tile_offsets[i >> 2u][i & 3u]; }
uint tile_entity(uint i) { return tile_entities[i >> 2u][i & 3u]; }
vec4 entity_vec4(uint i) { return uintBitsToFloat(entity_data[i]); }

Entity entity_at(uint index)
{
    uint b = index * ENTITY_VEC4S;
    Entity e;
    e.inv_rot = entity_vec4(b);
    vec4 v = entity_vec4(b + 1u);
    e.pos = v.xy;
    e.extent = v.zw;
    uvec4 u = entity_data[b + 2u];
    e.shape_type = u.x;
    e.radius = uintBitsToFloat(u.y);
    e.thickness = uintBitsToFloat(u.z);
    e.chubbiness = uintBitsToFloat(u.w);
    u = entity_data[b + 3u];
    e.aa = uintBitsToFloat(u.x);
    e.point_count = u.y;
    e.metaball_group = u.z;
    e.metaball_blend = uintBitsToFloat(u.w);
    v = entity_vec4(b + 4u);
    e.border_thickness = v.x;
    e.reserved0 = v.y;
    e.reserved1 = v.z;
    e.reserved2 = v.w;
    e.points_01 = entity_vec4(b + 5u);
    e.points_23 = entity_vec4(b + 6u);
    e.points_45 = entity_vec4(b + 7u);
    e.points_67 = entity_vec4(b + 8u);
    e.scene = entity_vec4(b + 9u);
    e.emission = entity_vec4(b + 10u);
    e.absorption = entity_vec4(b + 11u);
    e.albedo = entity_vec4(b + 12u);
    e.border_scene = entity_vec4(b + 13u);
    e.border_emission = entity_vec4(b + 14u);
    e.border_absorption = entity_vec4(b + 15u);
    e.border_albedo = entity_vec4(b + 16u);
    v = entity_vec4(b + 17u);
    e.simulation_time = v.xyz;
    e.tile_group = v.w;
    e.material_frame = entity_vec4(b + 18u);
    return e;
}

#ifdef SG_ACCUMULATE
layout(set = 2, binding = SG_PREVIOUS_SCENE_BINDING) uniform sampler2D u_prev_scene;
layout(set = 2, binding = SG_PREVIOUS_SOURCE_BINDING) uniform sampler2D u_prev_source;
layout(set = 2, binding = SG_PREVIOUS_ALBEDO_BINDING) uniform sampler2D u_prev_albedo;
layout(set = 2, binding = SG_PREVIOUS_NORMAL_BINDING) uniform sampler2D u_prev_normal;
layout(set = 2, binding = SG_PREVIOUS_COVER_BINDING) uniform sampler2D u_prev_cover;
#endif

layout(location = 0) out vec4 out_scene;
layout(location = 1) out vec4 out_source;
layout(location = 2) out vec4 out_albedo;
layout(location = 3) out vec4 out_normal;
layout(location = 4) out vec4 out_visibility;
layout(location = 5) out vec4 out_cover;

// Tile lists are already ordered by stable CPU sort and deterministic binning.

#include "sdf.shd"
#include "noise.shd"

float sdf_polyline(vec2 p, Entity e)
{
    int count = int(e.point_count);
    if (count < 3) count = 3;
    if (count > 8) count = 8;

    // Extract points.
    vec2 pts[8];
    pts[0] = e.points_01.xy;
    pts[1] = e.points_01.zw;
    pts[2] = e.points_23.xy;
    pts[3] = e.points_23.zw;
    pts[4] = e.points_45.xy;
    pts[5] = e.points_45.zw;
    pts[6] = e.points_67.xy;
    pts[7] = e.points_67.zw;

    // Min distance to any closed polyline segment.
    float min_d = 1e30;
    for (int i = 0; i < count; i++) {
        int j = (i + 1) % count;
        // Manually index to avoid dynamic indexing issues.
        vec2 a, b;
        // Use ternary chain for compile-time indexable access.
        a = (i == 0) ? pts[0] : (i == 1) ? pts[1] : (i == 2) ? pts[2] : (i == 3) ? pts[3] :
            (i == 4) ? pts[4] : (i == 5) ? pts[5] : (i == 6) ? pts[6] : pts[7];
        b = (j == 0) ? pts[0] : (j == 1) ? pts[1] : (j == 2) ? pts[2] : (j == 3) ? pts[3] :
            (j == 4) ? pts[4] : (j == 5) ? pts[5] : (j == 6) ? pts[6] : pts[7];
        float d = sdf_segment(p, a, b);
        min_d = min(min_d, d);
    }
    return min_d - e.thickness * 0.5;
}

float sdf_polygon_filled(vec2 p, Entity e)
{
    int count = int(e.point_count);
    if (count < 3) count = 3;
    if (count > 8) count = 8;

    // Extract points.
    vec2 pts[8];
    pts[0] = e.points_01.xy;
    pts[1] = e.points_01.zw;
    pts[2] = e.points_23.xy;
    pts[3] = e.points_23.zw;
    pts[4] = e.points_45.xy;
    pts[5] = e.points_45.zw;
    pts[6] = e.points_67.xy;
    pts[7] = e.points_67.zw;

    // Winding-number SDF for filled polygon.
    float min_d = 1e30;
    float winding = 0.0;
    for (int i = 0; i < count; i++) {
        int j = (i + 1) % count;
        vec2 a = (i == 0) ? pts[0] : (i == 1) ? pts[1] : (i == 2) ? pts[2] : (i == 3) ? pts[3] :
                 (i == 4) ? pts[4] : (i == 5) ? pts[5] : (i == 6) ? pts[6] : pts[7];
        vec2 b = (j == 0) ? pts[0] : (j == 1) ? pts[1] : (j == 2) ? pts[2] : (j == 3) ? pts[3] :
                 (j == 4) ? pts[4] : (j == 5) ? pts[5] : (j == 6) ? pts[6] : pts[7];

        vec2 edge = b - a;
        vec2 pa = p - a;
        float t = clamp(dot(pa, edge) / max(dot(edge, edge), 1e-20), 0.0, 1.0);
        float d = length(pa - edge * t);
        min_d = min(min_d, d);

        // Winding number contribution.
        bvec3 cond = bvec3(a.y <= p.y, b.y > p.y, edge.x * pa.y - edge.y * pa.x > 0.0);
        if (all(cond)) winding += 1.0;
        cond = bvec3(a.y > p.y, b.y <= p.y, edge.x * pa.y - edge.y * pa.x < 0.0);
        if (all(cond)) winding -= 1.0;
    }
    return (winding != 0.0) ? -min_d : min_d;
}

// Where a material samples the world: the laid-out frame when the entity
// carries one, so patterns stay attached to moving fragments.
vec2 material_position(Entity e, vec2 local_p, vec2 world_pos)
{
    vec4 f = e.material_frame;
    if (f.z == 0.0 && f.w == 0.0) return world_pos;
    return f.xy + vec2(f.z * local_p.x - f.w * local_p.y, f.w * local_p.x + f.z * local_p.y);
}

vec2 shader_half_size(Entity e)
{
    if (e.shape_type == SHAPE_CIRCLE)
        return vec2(e.radius + e.thickness * 0.5);
    if (e.shape_type == SHAPE_DIAMOND)
        return vec2(e.radius + e.chubbiness + e.thickness * 0.5);
    if (e.shape_type == SHAPE_BOX || e.shape_type == SHAPE_SPRITE)
        return abs(e.points_01.xy) + e.thickness * 0.5;
    vec2 bounds = max(abs(e.points_01.xy), abs(e.points_01.zw));
    if (e.shape_type == SHAPE_CAPSULE) return bounds + e.radius + e.thickness * 0.5;
    if (e.shape_type == SHAPE_LINE) return bounds + e.thickness * 0.5;
    vec2 points[6] = vec2[6](e.points_23.xy,e.points_23.zw,e.points_45.xy,
                            e.points_45.zw,e.points_67.xy,e.points_67.zw);
    int count = e.shape_type == SHAPE_TRI ? 3 : clamp(int(e.point_count),3,8);
    for (int i = 2; i < count; i++) bounds = max(bounds, abs(points[i-2]));
    return bounds + e.chubbiness + e.thickness * 0.5;
}

float evaluate_sdf(vec2 local_p, Entity e)
{
    uint shape = e.shape_type;
    float d;

    // LINE and POLY: inherently stroked, thickness built into SDF.
    if (shape == SHAPE_LINE) {
        return sdf_line(local_p, e.points_01.xy, e.points_01.zw, e.thickness);
    }
    if (shape == SHAPE_POLY) {
        return sdf_polyline(local_p, e);
    }

    // All other shapes: compute filled SDF, then optionally stroke.
    if (shape == SHAPE_CIRCLE) {
        d = sdf_circle(local_p, e.radius);
    } else if (shape == SHAPE_BOX || shape == SHAPE_SPRITE) {
        d = sdf_box(local_p, abs(e.points_01.xy), e.chubbiness);
        if (e.points_23.w > 0.0) d = max(d, dot(e.points_23.xy, local_p) - e.points_23.z);
    } else if (shape == SHAPE_CAPSULE) {
        d = sdf_capsule(local_p, e.points_01.xy, e.points_01.zw, e.radius);
    } else if (shape == SHAPE_TRI) {
        d = sdf_triangle(local_p, e.points_01.xy, e.points_01.zw, e.points_23.xy, e.chubbiness);
    } else if (shape == SHAPE_DIAMOND) {
        d = sdf_diamond(local_p, e.radius) - e.chubbiness;
    } else if (shape == SHAPE_POLY_FILL) {
        d = sdf_polygon_filled(local_p, e) - e.chubbiness;
    } else {
        d = sdf_circle(local_p, e.radius);
    }

    // Unified stroke: thickness > 0 converts filled shape to outline.
    if (e.thickness > 0.0)
        d = abs(d) - e.thickness * 0.5;

    return d;
}

// The sprite's texel under a point inside its box. points_45 is the frame's
// uv rect and points_67.x its image variant. The top clamp keeps an edge
// pixel inside the frame rather than on its neighbour.
vec4 sprite_texel(vec2 local_p, Entity e)
{
    vec2 t = vec2(local_p.x, -local_p.y) / (2.0 * abs(e.points_01.xy)) + 0.5;
    t = clamp(t, vec2(0.0), vec2(0.9999));
    return sg_image_sample(int(e.points_67.x), mix(e.points_45.xy, e.points_45.zw, t));
}

#include "color.shd"

vec4 unpack_color(vec4 p) { return p; }

// Ordinary authored shapes live on world Y=0. Mesh resolve coordinates stay
// in the camera plane and never use this inverse mapping.
vec2 plane_pixel;
float plane_height;
bool plane_position(vec2 screen, out vec3 hit)
{
    vec3 right = u_plane_right.xyz, down = u_plane_down.xyz;
    vec3 up = cross(down, right), target = u_plane_target.xyz;
    vec3 offset = right * (screen.x - target.x) + down * (-screen.y - target.z);
    float focal = u_plane_right.w;
    if (focal > 0.0) {
        vec3 eye = target + up * focal;
        vec3 ray = offset - up * focal;
        if (abs(ray.y) < 1e-5) return false;
        float t = -eye.y / ray.y;
        if (t * focal < 1.0) return false;
        hit = eye + ray * t;
    } else {
        if (abs(up.y) < 1e-5) return false;
        vec3 origin = target + offset;
        hit = origin - up * (origin.y / up.y);
    }
    return !any(isnan(hit)) && !any(isinf(hit)) && all(lessThan(abs(hit),vec3(1e20)));
}

void plane_surface(inout vec4 surface, inout float height)
{
    if (u_plane_target.w == 0.0) return;
    vec3 right = u_plane_right.xyz, down = u_plane_down.xyz;
    vec3 up = cross(down, right);
    vec2 tilt = surface.xy;
    vec3 normal = normalize(vec3(tilt.x, sqrt(max(1.0-dot(tilt,tilt), 1e-6)), -tilt.y));
    surface.xy = vec2(dot(normal,right), -dot(normal,down));
    float t2 = dot(surface.xy,surface.xy);
    if (dot(normal,up) <= 0.0 && t2 > 1e-8) surface.xy *= 0.999 * inversesqrt(t2);
    height = clamp(plane_height + height * up.y, -65504.0, 65504.0);
}

float circle_emission_half_width(Entity e)
{
    float max_pixel = max(plane_pixel.x, plane_pixel.y);
    return max(1.5 * max_pixel, max(e.aa, 0.0) * 0.5);
}

float circle_emission_coverage(float sdf, float half_width)
{
    return 1.0 - smoothstep(-half_width, half_width, sdf);
}

// Area of the rectangle [lo, hi] where dot(n, q) <= d, for a box's cut.
// Corners' clamped squared distances give the exact area by inclusion and
// exclusion.
float cut_area(vec2 lo, vec2 hi, vec2 n, float d)
{
    // Mirror so both normal components are positive.
    vec2 m = vec2(n.x < 0.0 ? -1.0 : 1.0, n.y < 0.0 ? -1.0 : 1.0);
    vec2 a = min(lo * m, hi * m), b = max(lo * m, hi * m);
    n = max(abs(n), vec2(1e-3));
    vec4 f = max(vec4(d) - vec4(dot(n, a), dot(n, vec2(b.x, a.y)), dot(n, vec2(a.x, b.y)), dot(n, b)), 0.0);
    f *= f;
    return max((f.x - f.y - f.z + f.w) / (2.0 * n.x * n.y), 0.0);
}

// The fraction of a square footprint of half size r around local point p
// that a tile group box, cut or not, covers. Boxes tiling a shape cover each
// footprint exactly once between them.
float footprint_coverage(Entity e, vec2 p, float r)
{
    vec2 h = abs(e.points_01.xy);
    vec2 lo = max(p - r, -h), hi = min(p + r, h);
    if (any(lessThanEqual(hi, lo))) return 0.0;
    float area = e.points_23.w > 0.0 ? cut_area(lo, hi, e.points_23.xy, e.points_23.z)
                                     : (hi.x - lo.x) * (hi.y - lo.y);
    return clamp(area / (4.0 * r * r), 0.0, 1.0);
}

// Material accumulated at this pixel. Emission and albedo alpha never reach
// their color. Absorption blends under earlier absorbers by its own alpha;
// only its mean, the optical depth, is kept.
vec4 scene_acc;
vec4 emission_acc;
// The part of emission_acc from absorbing layers. The transport reads it as
// radiance and the rest as density; see hrc/source_average.shd.
vec3 absorber_emission;
vec4 albedo_acc;
vec4 normal_acc;
float tau_acc;
float absorption_cover;
float relief_acc;
float relief_cover;
float mesh_cover;

void emission_over(vec4 em, bool absorbs)
{
    absorber_emission = (absorbs ? em.rgb : vec3(0.0)) + absorber_emission * (1.0 - em.a);
    emission_acc = alpha_over(em, emission_acc);
}

// Composites one layer of premultiplied channels over the accumulated material.
void layer_over(vec4 sc, vec4 em, vec4 tr, vec4 al, vec4 surface, float height)
{
    scene_acc = alpha_over(sc, scene_acc);
    normal_acc = mix(normal_acc, surface, sc.a);
    relief_acc = mix(relief_acc, height, sc.a);
    relief_cover = sc.a + relief_cover * (1.0 - sc.a);
    mesh_cover = (u_plane_target.w != 0.0 ? sc.a : 0.0) + mesh_cover * (1.0 - sc.a);
    emission_over(em, tr.a > 0.0);
    tau_acc += dot(tr.rgb, vec3(1.0 / 3.0)) * (1.0 - absorption_cover);
    absorption_cover += tr.a * (1.0 - absorption_cover);
    albedo_acc = alpha_over(al, albedo_acc);
}

// A layer of premultiplied channels and the footprint coverage behind them.
// Surface and height are weighted by scene alpha until it is composited.
struct Layer
{
    vec4 scene;
    vec4 emission;
    vec4 absorption;
    vec4 albedo;
    vec4 surface;
    float height;
    float cover;
};

Layer layer_empty()
{
    return Layer(vec4(0), vec4(0), vec4(0), vec4(0), vec4(0), 0.0, 0.0);
}

Layer layer_scaled(Layer l, float k)
{
    return Layer(l.scene * k, l.emission * k, l.absorption * k, l.albedo * k,
                 l.surface * k, l.height * k, l.cover * k);
}

Layer layer_sum(Layer a, Layer b)
{
    return Layer(a.scene + b.scene, a.emission + b.emission, a.absorption + b.absorption,
                 a.albedo + b.albedo, a.surface + b.surface, a.height + b.height,
                 a.cover + b.cover);
}

// Pieces that overlap by float error still cover a footprint once.
// Pieces that overlap by float error still cover a footprint once.
void layer_composite(Layer l)
{
    l = layer_scaled(l, 1.0 / max(l.cover, 1.0));
    float a = max(l.scene.a, 1e-6);
    layer_over(l.scene, l.emission, l.absorption, l.albedo, l.surface / a, l.height / a);
}

// The pieces of a tile group composite as one layer: their footprint
// coverages add, so edges they share stay covered wherever the shape sits
// against the pixels. Layering each piece would dim those edges by an amount
// that follows the shape's subpixel position, which flickers as it moves.
//
// A group whose id has a half, a mask's border, comes before the group with
// its whole part, the mask's fill, and lies over it. Both share the
// silhouette, so the border hides as much fill as it can: fill pieces add
// only where they cover more than the border. Layering them independently
// would count partly covered silhouette pixels twice.
float group_id;
Layer group_layer;
float border_cover;

void group_flush()
{
    if (group_id == 0.0) return;
    layer_composite(group_layer);
    group_id = 0.0;
    group_layer = layer_empty();
}

void group_add(float id, float cover, vec4 sc, vec4 em, vec4 tr, vec4 al, vec4 surface, float height)
{
    if (id != group_id) {
        bool fill = fract(group_id) > 0.0 && id == floor(group_id);
        border_cover = fill ? group_layer.cover : 0.0;
        if (!fill) group_flush();
        group_id = id;
    }
    float k = border_cover > 0.0 ? max(cover - border_cover, 0.0) / max(cover, 1e-6) : 1.0;
    Layer piece = Layer(sc, em, tr, al, surface * sc.a, height * sc.a, cover);
    group_layer = layer_sum(group_layer, layer_scaled(piece, k));
}

void main()
{
    ivec2 pixel = ivec2(gl_FragCoord.xy);
    ivec2 tile_id = pixel / 16;
    uint tile_idx = uint(tile_id.y * u_tiles_x + tile_id.x);
    uint tile_begin = tile_offset(tile_idx);
    uint tile_end = tile_offset(tile_idx + 1u);

    // Pixel center -> world position (Y flipped: pixel 0 = world max Y).
    vec2 world_pos = vec2(
        u_world_min_x + (float(pixel.x) + 0.5) * u_unit_per_px.x,
        u_world_max_y - (float(pixel.y) + 0.5) * u_unit_per_px.y
    );

    plane_pixel = u_unit_per_px;
    plane_height = 0.0;
    bool plane_valid = true;
    if (u_plane_target.w != 0.0) {
        vec3 hit, hx, hy;
        plane_valid = plane_position(world_pos, hit);
        if (plane_valid) {
            // Compute the authored-space pixel footprint before divergent work.
            bool vx = plane_position(world_pos + vec2(u_unit_per_px.x,0.0), hx);
            bool vy = plane_position(world_pos - vec2(0.0,u_unit_per_px.y), hy);
            if (vx) plane_pixel.x = length(hx.xz-hit.xz);
            if (vy) plane_pixel.y = length(hy.xz-hit.xz);
            plane_height = dot(hit-u_plane_target.xyz, cross(u_plane_down.xyz,u_plane_right.xyz));
            world_pos = vec2(hit.x,-hit.z);
        }
    }

    // Tile entity list.
    uint total = plane_valid ? tile_end - tile_begin : 0u;
    uint base = tile_begin;

    scene_acc = vec4(0);
    emission_acc = vec4(0, 0, 0, 1);
    absorber_emission = vec3(0.0);
    tau_acc = 0.0;
    absorption_cover = 0.0;
    albedo_acc = vec4(0, 0, 0, 1);
    normal_acc = vec4(0);
    relief_acc = 0.0;
    relief_cover = 0.0;
    mesh_cover = 0.0;
    group_id = 0.0;
    border_cover = 0.0;
    group_layer = layer_empty();
#ifdef SG_ACCUMULATE
    // Earlier batches continue as displayed emission, absorbing wherever they
    // absorbed, over the whole pixel.
    // A leading mesh batch has no previous material layer.
    if (u_has_previous != 0) {
        scene_acc = texelFetch(u_prev_scene, pixel, 0);
        vec4 prev_source = texelFetch(u_prev_source, pixel, 0);
        emission_acc.rgb = prev_source.rgb * texelFetch(u_prev_cover, pixel, 0).r;
        absorber_emission = prev_source.a > 0.0 ? emission_acc.rgb : vec3(0.0);
        absorption_cover = prev_source.a > 0.0 ? 1.0 : 0.0;
        tau_acc = prev_source.a;
        vec4 prev_albedo = texelFetch(u_prev_albedo, pixel, 0);
        albedo_acc.rgb = prev_albedo.rgb;
        relief_acc = prev_albedo.a;
        normal_acc = texelFetch(u_prev_normal, pixel, 0);
        vec4 previous_cover = texelFetch(u_prev_cover, pixel, 0);
        relief_cover = previous_cover.g;
        mesh_cover = previous_cover.b;
    }
#endif

#ifdef SG_MESH_LAYER
    // Color and coverage resolve the configured subpixels; geometry retains one
    // visible face. Averaging unrelated heights invents a sloping surface.
    vec2 mesh_uv = (gl_FragCoord.xy - u_mesh_rect.xy) / u_mesh_rect.zw;
    if (all(greaterThanEqual(mesh_uv, vec2(0))) && all(lessThan(mesh_uv, vec2(1)))) {
        ivec2 size = ivec2(u_mesh_extent);
        int samples = int(round(float(size.x) / u_mesh_rect.z));
        float sample_scale = 1.0 / float(samples);
        float weight = sample_scale * sample_scale;
        ivec2 first = ivec2(floor(mesh_uv * vec2(size) - (samples == 2 ? 0.5 : 0.0)));
        vec4 sc = vec4(0), em = vec4(0), tr = vec4(0), al = vec4(0);
        vec4 selected_normal = vec4(0);
        float selected_height = 0.0;
        bool selected = false;
        vec4 raw_normal=vec4(0);
        float raw_height=0.0, first_plane_height=0.0;
        vec3 first_normal=vec3(0);
        int covered_samples=0;
        bool coherent_plane=true;
        for (int y = 0; y < samples; y++) {
            for (int x = 0; x < samples; x++) {
                ivec2 p = clamp(first + ivec2(x, y), ivec2(0), size - 1);
                vec4 scene = texelFetch(u_mesh_scene, p, 0);
                vec4 sample_albedo = texelFetch(u_mesh_albedo, p, 0);
                sc += scene * weight;
                em += texelFetch(u_mesh_emission, p, 0) * weight;
                tr += texelFetch(u_mesh_absorption, p, 0) * weight;
                al += sample_albedo * weight;
                if (scene.a <= 0.0) continue;
                vec4 normal = texelFetch(u_mesh_normal, p, 0);
                float height = sample_albedo.a;
                float ny = sqrt(max(1.0 - dot(normal.xy, normal.xy), 0.0));
                if(covered_samples==0||height>raw_height) {
                    raw_height=height; raw_normal=normal;
                }
                // Evaluate this face at the output pixel's center, so a tilted
                // plane does not acquire a quarter-pixel height offset.
                vec2 offset = (vec2(p) + 0.5 - mesh_uv * vec2(size)) * sample_scale * u_unit_per_px;
                if (ny > 0.01) height += dot(normal.xy, vec2(offset.x, -offset.y)) / ny;
                else coherent_plane=false;
                vec3 face_normal=vec3(normal.x,ny,normal.y);
                if(covered_samples==0) {
                    first_normal=face_normal; first_plane_height=height;
                } else {
                    // A 0.01 chord (about 0.57 degrees) distinguishes a plane
                    // from curved/creased samples. Height agreement also rejects
                    // parallel adjacent layers; 0.2% covers RGBA16F quantization.
                    float height_tolerance=max(0.002*max(abs(height),abs(first_plane_height)),
                        0.02*max(u_unit_per_px.x,u_unit_per_px.y));
                    vec3 normal_delta=face_normal-first_normal;
                    if(dot(normal_delta,normal_delta)>0.0001||abs(height-first_plane_height)>height_tolerance)
                        coherent_plane=false;
                }
                covered_samples++;
                // Strict comparison keeps ties deterministic in scan order.
                if (!selected || height > selected_height) {
                    selected = true;
                    selected_height = height;
                    selected_normal = normal;
                }
            }
        }
        if (sc.a > 0.0) {
            // Tangent extrapolation is safe only when multiple samples confirm
            // the same plane. Curvature, silhouettes and sharp adjacent faces
            // retain the raw frontmost sample instead of inventing a height.
            if(!coherent_plane||covered_samples<2) {
                selected_height=raw_height; selected_normal=raw_normal;
            }
            layer_over(sc, em, tr, vec4(al.rgb, sc.a), selected_normal, selected_height);
            // An active plane camera already marks this layer geometric.
            if (u_plane_target.w == 0.0) mesh_cover += sc.a;
        }
    }
#endif

    // Metaball group accumulators.
    #define MAX_METABALL_GROUPS 1
    float mb_sdf[MAX_METABALL_GROUPS];
    vec4 mb_scene[MAX_METABALL_GROUPS];
    vec4 mb_emission[MAX_METABALL_GROUPS];
    vec4 mb_absorption[MAX_METABALL_GROUPS];
    vec4 mb_albedo[MAX_METABALL_GROUPS];
    vec4 mb_border_scene[MAX_METABALL_GROUPS];
    vec4 mb_border_emission[MAX_METABALL_GROUPS];
    vec4 mb_border_absorption[MAX_METABALL_GROUPS];
    vec4 mb_border_albedo[MAX_METABALL_GROUPS];
    float mb_aa[MAX_METABALL_GROUPS];
    float mb_border_thickness[MAX_METABALL_GROUPS];
    // Solid surface: xy bump tilt (world axes, y up), z edge light, w gloss.
    vec4 mb_surface[MAX_METABALL_GROUPS];
    float mb_height[MAX_METABALL_GROUPS];
    bool mb_active[MAX_METABALL_GROUPS];
    for (int g = 0; g < MAX_METABALL_GROUPS; g++) {
        mb_sdf[g] = 1e30;
        mb_scene[g] = vec4(0);
        mb_emission[g] = vec4(0);
        mb_absorption[g] = vec4(0);
        mb_albedo[g] = vec4(0);
        mb_border_scene[g] = vec4(0);
        mb_border_emission[g] = vec4(0);
        mb_border_absorption[g] = vec4(0);
        mb_border_albedo[g] = vec4(0);
        mb_aa[g] = 0.0;
        mb_border_thickness[g] = 0.0;
        mb_surface[g] = vec4(0);
        mb_height[g] = 0.0;
        mb_active[g] = false;
    }

    for (uint i = 0u; i < total; i++) {
        uint eidx = tile_entity(base + i);
        if (eidx < uint(u_first_entity) || eidx >= uint(u_last_entity)) continue;
        Entity e = entity_at(eidx);
        if (e.metaball_group != uint(u_metaball_group)) continue;

        // Transform pixel to entity local space.
        vec2 dp = world_pos - e.pos;
        vec2 local_p = vec2(
            e.inv_rot.x * dp.x + e.inv_rot.y * dp.y,
            e.inv_rot.z * dp.x + e.inv_rot.w * dp.y
        );

        float sdf = evaluate_sdf(local_p, e);
        vec2 half_size = shader_half_size(e);
        vec2 material_pos = material_position(e, local_p, world_pos);
        // Pieces of one shape share a block of material and shape parameters.
        vec4 graph_output[SG_OUTPUTS];
        vec4 parameters[32];
        if (e.reserved1 > 0.0) {
            for(int p=0;p<32;p++) parameters[p]=shader_parameters[floatBitsToUint(e.simulation_time.y)+32u+uint(p)];
            sg_dispatch_2d(int(e.reserved1), local_p, material_pos, half_size, e.inv_rot, e.simulation_time.x, parameters, graph_output);
            sdf = graph_output[0].x;
        }
        float aa = e.aa > 0.0 ? e.aa : max(plane_pixel.x, plane_pixel.y) * 0.5;
        bool filtered_circle_emission = e.shape_type == SHAPE_CIRCLE &&
                                        e.thickness <= 0.0 && e.border_thickness <= 0.0 &&
                                        e.reserved0 <= 0.0 && e.reserved1 <= 0.0 &&
                                        e.metaball_group == 0u;
        bool may_emit = any(notEqual(e.emission.rgb, vec3(0.0)));
        float emission_half_width = filtered_circle_emission
                                      ? circle_emission_half_width(e)
                                      : aa;
        // Tile group pieces cover the pixel's footprint, at least a pixel wide.
        bool tiled = e.tile_group != 0.0 && e.shape_type == SHAPE_BOX;
        float footprint = 0.5 * max(aa, max(plane_pixel.x, plane_pixel.y));
        float reach = tiled ? 1.4143 * footprint : aa;
        // Uncovered pixels need no material; metaballs still blend beyond their edge.
        if (e.metaball_group == 0u && sdf >= reach &&
            (!filtered_circle_emission || !may_emit || sdf >= emission_half_width)) continue;
        // A sprite's texel alpha is its edge, so its box covers fully.
        if (e.shape_type == SHAPE_SPRITE) {
            vec4 texel = sprite_texel(local_p, e);
            if (sdf > 0.0 || texel.a <= 0.0) continue;
            sdf = -reach;
            e.scene *= texel;
            e.albedo *= texel;
            e.emission.a *= texel.a;
            e.absorption *= texel.a;
        }
        vec4 surface = vec4(0.0, 0.0, e.reserved2, 0.0);
        float height = 0.0;
        if (e.reserved0 > 0.0) {
            for(int p=0;p<32;p++) parameters[p]=shader_parameters[floatBitsToUint(e.simulation_time.y)+uint(p)];
            sg_dispatch_2d(int(e.reserved0), local_p, material_pos, half_size, e.inv_rot, e.simulation_time.x, parameters, graph_output);
            e.scene=graph_output[0]; e.emission=graph_output[1];
            e.albedo=graph_output[2]; e.absorption=graph_output[3];
            e.border_scene=graph_output[0]; e.border_emission=graph_output[1];
            e.border_albedo=graph_output[2]; e.border_absorption=graph_output[3];
            surface.xyw = graph_output[4].xyz;
            height = graph_output[4].w;
        }

        plane_surface(surface, height);

        if (e.metaball_group > 0u) {
            // Accumulate into metaball group.
            uint g = 0u; // Each dispatch processes one authored group.
            if (g < MAX_METABALL_GROUPS) {
                float k = e.metaball_blend;
                vec4 e_scene = unpack_color(e.scene);
                vec4 e_emission = unpack_color(e.emission);
                vec4 e_absorption = unpack_color(e.absorption);
                vec4 e_albedo = unpack_color(e.albedo);
                vec4 e_bscene = unpack_color(e.border_scene);
                vec4 e_bemission = unpack_color(e.border_emission);
                vec4 e_babsorption = unpack_color(e.border_absorption);
                vec4 e_balbedo = unpack_color(e.border_albedo);
                if (!mb_active[g] || k <= 0.0) {
                    // First entity in group or no blending: just take the closer one.
                    if (sdf < mb_sdf[g]) {
                        mb_sdf[g] = sdf;
                        mb_scene[g] = e_scene;
                        mb_emission[g] = e_emission;
                        mb_absorption[g] = e_absorption;
                        mb_albedo[g] = e_albedo;
                        mb_border_scene[g] = e_bscene;
                        mb_border_emission[g] = e_bemission;
                        mb_border_absorption[g] = e_babsorption;
                        mb_border_albedo[g] = e_balbedo;
                        mb_aa[g] = e.aa;
                        mb_border_thickness[g] = e.border_thickness;
                        mb_surface[g] = surface;
                        mb_height[g] = height;
                    }
                } else {
                    float h = clamp(0.5 + 0.5 * (sdf - mb_sdf[g]) / k, 0.0, 1.0);
                    mb_sdf[g] = mix(sdf, mb_sdf[g], h) - k * h * (1.0 - h);
                    mb_scene[g] = mix(e_scene, mb_scene[g], h);
                    mb_emission[g] = mix(e_emission, mb_emission[g], h);
                    mb_absorption[g] = mix(e_absorption, mb_absorption[g], h);
                    mb_albedo[g] = mix(e_albedo, mb_albedo[g], h);
                    mb_border_scene[g] = mix(e_bscene, mb_border_scene[g], h);
                    mb_border_emission[g] = mix(e_bemission, mb_border_emission[g], h);
                    mb_border_absorption[g] = mix(e_babsorption, mb_border_absorption[g], h);
                    mb_border_albedo[g] = mix(e_balbedo, mb_border_albedo[g], h);
                    mb_aa[g] = mix(e.aa, mb_aa[g], h);
                    mb_border_thickness[g] = mix(e.border_thickness, mb_border_thickness[g], h);
                    mb_surface[g] = mix(surface, mb_surface[g], h);
                    mb_height[g] = mix(height, mb_height[g], h);
                }
                mb_active[g] = true;
            }
            continue;
        }

        // Normal entity (metaball_group == 0).
        float bt = e.border_thickness;

        if (bt > 0.0) {
            group_flush();
            // Border rendering: fill is interior, border is edge band.
            float shape_coverage = 1.0 - smoothstep(0.0, aa, sdf);
            float fill_coverage = 1.0 - smoothstep(-bt, -bt + aa, sdf);
            float border_coverage = shape_coverage - fill_coverage;
            if (shape_coverage <= 0.0) continue;

            // Scene: border over fill, then onto canvas.
            vec4 sc = unpack_color(e.scene); sc.rgb *= sc.a; sc *= fill_coverage;
            vec4 bsc = unpack_color(e.border_scene); bsc.rgb *= bsc.a; bsc *= border_coverage;
            scene_acc = alpha_over(alpha_over(bsc, sc), scene_acc);
            float cover = bsc.a + sc.a * (1.0 - bsc.a);
            normal_acc = mix(normal_acc, surface, cover);
            relief_acc = mix(relief_acc, height, cover);
            if (u_plane_target.w != 0.0) {
                relief_cover = cover + relief_cover * (1.0-cover);
                mesh_cover = cover + mesh_cover * (1.0-cover);
            }

            // Emission and absorption.
            vec4 em = unpack_color(e.emission); em.rgb *= em.a;
            em *= fill_coverage;
            vec4 bem = unpack_color(e.border_emission); bem.rgb *= bem.a; bem *= border_coverage;
            vec4 tr = unpack_color(e.absorption); tr *= fill_coverage;
            vec4 btr = unpack_color(e.border_absorption); btr *= border_coverage;
            emission_over(em, tr.a > 0.0);
            emission_over(bem, btr.a > 0.0);
            vec4 combined_tr = tr + btr;
            tau_acc += dot(combined_tr.rgb, vec3(1.0 / 3.0)) * (1.0 - absorption_cover);
            absorption_cover += combined_tr.a * (1.0 - absorption_cover);

            // Albedo.
            vec4 al = unpack_color(e.albedo); al.rgb *= al.a; al *= fill_coverage;
            vec4 bal = unpack_color(e.border_albedo); bal.rgb *= bal.a; bal *= border_coverage;
            albedo_acc = alpha_over(alpha_over(bal, al), albedo_acc);
        } else {
            // No border: original path.
            float coverage = !tiled         ? 1.0 - smoothstep(0.0, aa, sdf)
                           : sdf <= -reach ? 1.0
                                           : footprint_coverage(e, local_p, footprint);
            float emission_coverage = filtered_circle_emission
                                        ? circle_emission_coverage(sdf, emission_half_width)
                                        : coverage;
            if (coverage <= 0.0 && emission_coverage <= 0.0) continue;

            vec4 sc = unpack_color(e.scene); sc.rgb *= sc.a; sc *= coverage;
            vec4 em = unpack_color(e.emission); em.rgb *= em.a;
            em.rgb *= e.simulation_time.z;
            em *= emission_coverage;
            vec4 tr = unpack_color(e.absorption); tr *= coverage;
            vec4 al = unpack_color(e.albedo); al.rgb *= al.a; al *= coverage;
            if (tiled) {
                group_add(e.tile_group, coverage, sc, em, tr, al, surface, height);
                continue;
            }
            group_flush();
            layer_over(sc, em, tr, al, surface, height);
        }
    }
    group_flush();


    // Composite metaball groups on top.
    for (int g = 0; g < MAX_METABALL_GROUPS; g++) {
        if (!mb_active[g]) continue;
        float aa = mb_aa[g] > 0.0 ? mb_aa[g] : max(plane_pixel.x, plane_pixel.y) * 0.5;
        float bt = mb_border_thickness[g];

        if (bt > 0.0) {
            float shape_coverage = 1.0 - smoothstep(0.0, aa, mb_sdf[g]);
            float fill_coverage = 1.0 - smoothstep(-bt, -bt + aa, mb_sdf[g]);
            float border_coverage = shape_coverage - fill_coverage;
            if (shape_coverage <= 0.0) continue;

            vec4 sc = mb_scene[g]; sc.rgb *= sc.a; sc *= fill_coverage;
            vec4 bsc = mb_border_scene[g]; bsc.rgb *= bsc.a; bsc *= border_coverage;
            scene_acc = alpha_over(alpha_over(bsc, sc), scene_acc);
            float cover = bsc.a + sc.a * (1.0 - bsc.a);
            normal_acc = mix(normal_acc, mb_surface[g], cover);
            relief_acc = mix(relief_acc, mb_height[g], cover);

            vec4 em = mb_emission[g]; em.rgb *= em.a; em *= fill_coverage;
            vec4 bem = mb_border_emission[g]; bem.rgb *= bem.a; bem *= border_coverage;
            vec4 tr = mb_absorption[g]; tr *= fill_coverage;
            vec4 btr = mb_border_absorption[g]; btr *= border_coverage;
            emission_over(em, tr.a > 0.0);
            emission_over(bem, btr.a > 0.0);
            vec4 combined_tr = tr + btr;
            tau_acc += dot(combined_tr.rgb, vec3(1.0 / 3.0)) * (1.0 - absorption_cover);
            absorption_cover += combined_tr.a * (1.0 - absorption_cover);

            vec4 al = mb_albedo[g]; al.rgb *= al.a; al *= fill_coverage;
            vec4 bal = mb_border_albedo[g]; bal.rgb *= bal.a; bal *= border_coverage;
            albedo_acc = alpha_over(alpha_over(bal, al), albedo_acc);
        } else {
            float coverage = 1.0 - smoothstep(0.0, aa, mb_sdf[g]);
            if (coverage <= 0.0) continue;

            vec4 sc = mb_scene[g]; sc.rgb *= sc.a; sc *= coverage;
            vec4 em = mb_emission[g]; em.rgb *= em.a; em *= coverage;
            vec4 al = mb_albedo[g]; al.rgb *= al.a; al *= coverage;
            layer_over(sc, em, mb_absorption[g] * coverage, al, mb_surface[g], mb_height[g]);
        }
    }

    // Transport sources are emission density; see hrc/source_average.shd.
    // Absorbers covering part of the pixel give the transmittance of a whole
    // pixel of them scaled by their coverage, so it follows coverage
    // linearly, and emit their radiance times the pixel's optical depth.
    // Clear emitters emit by density. Display scales the density back to
    // emission premultiplied by coverage.
    float tau = absorption_cover > 1e-4 ? tau_acc / absorption_cover : 0.0;
    float opacity = absorption_cover * (1.0 - exp(-tau));
    float depth = -log(max(1.0 - opacity, 1e-6));
    vec3 clear = max(emission_acc.rgb - absorber_emission, 0.0);
    vec3 density = clear + absorber_emission / max(absorption_cover, 1e-4) * depth;
    vec3 luma = vec3(.2126, .7152, .0722);
    float dense = dot(density, luma);
    float display = dense > 1e-8 ? min(dot(emission_acc.rgb, luma) / dense, 60000.0) : 1.0;
    out_scene = scene_acc;
    out_source = vec4(density, depth);
    out_cover = vec4(display, relief_cover, mesh_cover, 0.0);
    out_albedo = vec4(albedo_acc.rgb, relief_acc);
    out_normal = normal_acc;
    out_visibility = vec4(0);
}
// Adapted from Neon-Swarm shaders/hrc/extend.shd; original source comments retained.
// Builds the ray interval hierarchy T_0 .. T_N (Sec 4.1).
//
// Each level doubles ray length by chaining two T_{n-1} intervals end-to-end.
// Stores optical depth. Serial segments add depths; alternative paths average
// transmission (Sec 4.1, Eq 20), then convert back to optical depth.
//
// Level layout: element = probe_x * directions + slot of k, row = y; see
// hrc_slots.shd.

#include "hrc/hrc_pass.shd"

layout(set = 2, binding = 0) uniform sampler2D u_prev;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_cascade;
	int u_transposed;
	int u_world_w;
	int u_world_h;
};

Interval merge(Interval a, Interval b)
{
	return Interval(
		a.rad + exp(-a.tau) * b.rad,
		a.tau + b.tau
	);
}

float blend_depth(float a, float b)
{
	// -log((exp(-a) + exp(-b)) / 2), without underflow for opaque paths.
	// Equal depths also cover two half-float infinities without inf - inf.
	if (a == b) return a;
	return min(a, b) - log(0.5 + 0.5 * exp(-abs(a - b)));
}

vec2 blend_depth(vec2 a, vec2 b)
{
	return vec2(blend_depth(a.x, b.x), blend_depth(a.y, b.y));
}

Interval T_load_prev(int probe_x, int k, int y)
{
	int prev_n = u_cascade - 1;
	int directions = (1 << prev_n) + 1;
	int num_probes = probe_count(u_world_w, prev_n);

	if (probe_x < 0 || probe_x >= num_probes || k < 0 || k >= directions || y < 0 || y >= u_world_h) {
		return Interval(HRC_LIGHT(0.0), HRC_DEPTH(0.0));
	}

	int element = probe_x * directions + hrc_parity_slot(k, directions);
	return interval_fetch(u_prev, hrc_texel(element, y, u_transposed));
}

int far_y_offset(int k)
{
	int prev_pow2 = 1 << (u_cascade - 1);
	return 2 * k - prev_pow2;
}

Interval extend(int probe_x, int k, int y)
{
	int k_lo = k / 2;
	int k_hi = (k + 1) / 2;
	int prev_probe_x = probe_x * 2;
	int mid_probe_x = prev_probe_x + 1;

	// Candidate A: go k_lo then k_hi
	Interval near_a = T_load_prev(prev_probe_x, k_lo, y);
	int far_y_a = y + far_y_offset(k_lo);
	Interval far_a = T_load_prev(mid_probe_x, k_hi, far_y_a);
	Interval A = merge(near_a, far_a);
	// Even directions use the same two intervals for both candidates.
	if (k_lo == k_hi) return A;

	// Candidate B: go k_hi then k_lo
	Interval near_b = T_load_prev(prev_probe_x, k_hi, y);
	int far_y_b = y + far_y_offset(k_hi);
	Interval far_b = T_load_prev(mid_probe_x, k_lo, far_y_b);
	Interval B = merge(near_b, far_b);

	return Interval(
		(A.rad + B.rad) * 0.5,
		blend_depth(A.tau, B.tau)
	);
}

void main()
{
	int directions = (1 << u_cascade) + 1;
	ivec2 er = hrc_element_row(u_transposed);
	int probe_x = er.x / directions;
	int k = hrc_parity_item(er.x - probe_x * directions, directions);
	out_value = interval_texel(extend(probe_x, k, er.y));
}
#define HRC_SCALAR 1
#include "hrc/extend.frag"
// Adapted from Neon-Swarm shaders/hrc/blur.shd; original source comments retained.
// 3x3 edge-aware Gaussian blur for gather output, blended with the previous
// frame's result. Weights: [1 2 1]^2 / 16. Skips taps where transmittance
// differs from center by more than u_threshold (hard edge detection).

layout(set = 2, binding = 0) uniform sampler2D u_in_radiance;
// A holds optical depth; see render_material_textures.
layout(set = 2, binding = 1) uniform sampler2D u_source;
layout(set = 2, binding = 2) uniform sampler2D u_prev_radiance;

layout(location = 0) out vec4 out_value;

layout(set = 3, binding = 0) uniform uniform_block
{
	vec2 u_texel_size;
	float u_threshold;
	float u_hysteresis;
	vec2 u_history_offset;
	int u_history_valid;
};

vec3 input_radiance(vec2 uv)
{
	return texture(u_in_radiance, uv).rgb;
}

void main()
{
	vec2 uv = gl_FragCoord.xy * u_texel_size;

	float center_s = texture(u_source, uv).a;

	bool history_active = false;
	vec2 history_uv = uv;
	if (u_hysteresis < 1.0 && u_history_valid != 0) {
		history_uv += u_history_offset;
		vec2 inset = u_texel_size * 0.5;
		history_active = all(greaterThanEqual(history_uv, inset)) &&
		                 all(lessThanEqual(history_uv, vec2(1.0) - inset));
	}

	// 1D weights: [1 2 1] / 4
	const float w1d[3] = float[3](1.0/4.0, 2.0/4.0, 1.0/4.0);

	vec3 sum = vec3(0.0);
	float wsum = 0.0;
	vec3 lower = vec3(0.0), upper = vec3(0.0);
	if (history_active) {
		lower = input_radiance(uv);
		upper = lower;
	}

	for (int dy = -1; dy <= 1; ++dy) {
		for (int dx = -1; dx <= 1; ++dx) {
			vec2 uv_q = uv + vec2(float(dx), float(dy)) * u_texel_size;

			float s = texture(u_source, uv_q).a;
			float edge_w = 1.0 - smoothstep(0.0, u_threshold, abs(s - center_s));

			float w = w1d[dx + 1] * w1d[dy + 1] * edge_w;
			vec3 current = input_radiance(uv_q);
			sum += current * w;
			wsum += w;
			if (history_active && edge_w > 0.0) {
				lower = min(lower, current);
				upper = max(upper, current);
			}
		}
	}

	vec3 out_r = wsum > 0.0 ? sum / wsum : input_radiance(uv);
	if (history_active) {
		vec3 prev = texture(u_prev_radiance, history_uv).rgb;
		out_r = mix(clamp(prev, lower, upper), out_r, u_hysteresis);
	}
	out_value = vec4(out_r, 1.0);
}
// Compact density splats feed the same emission/absorption field as solids.
// Gas joins into a translucent density field. Liquid keeps a continuous surface.
// Authored exhaust uses smooth unions; combustion uses separate hot streaks.
//
// Each pixel reads its tile's particle list. Including passes define
// the storage buffer bindings, which follow their samplers. GLSL ES emulates
// each storage buffer as texel fetches of a single vec4 or uvec4 array.
struct Particle { vec4 position; vec4 color; vec4 optical; vec4 detail; };
layout(set = 2, binding = FLUID_PARTICLES_BINDING) readonly buffer Particles { vec4 particle_data[]; };
layout(set = 2, binding = FLUID_OFFSETS_BINDING) readonly buffer Offsets { uvec4 offset_data[]; };
layout(set = 2, binding = FLUID_INDICES_BINDING) readonly buffer Indices { uvec4 index_data[]; };

int tile_start(int i) { return int(offset_data[i >> 2][i & 3]); }

Particle particle_at(int i)
{
    int b = 4 * int(index_data[i >> 2][i & 3]);
    return Particle(particle_data[b], particle_data[b + 1], particle_data[b + 2], particle_data[b + 3]);
}
layout(set = 3, binding = 0) uniform uniform_block {
    vec4 u_view;
    int u_tiles_x;
    int u_tile_size;
    int u_debug;
};

struct FluidSample
{
    float gas, liquid, absorption;
    float gas_alpha, liquid_alpha, flame_alpha;
    vec4 gas_color, liquid_color, flame_color;
    vec3 emission, gas_visibility, liquid_visibility;
    float liquid_refraction;
    vec2 gradient;
    float aa;
    // Individual discs carry coverage and optical channels without a density
    // threshold. The shader composites them in stable particle order.
    vec4 grain_color;
    vec3 grain_emission, grain_source, grain_visibility;
    float grain_absorption, grain_refraction, grain_liquid;
    vec2 grain_normal;
};

const float FLUID_GRAIN_FIRST = 1.5;
const float FLUID_GRAIN_LIQUID = 2.5;

// False where no fluid covers the pixel.
bool fluid_sample(ivec2 pixel, out FluidSample f)
{
    int tile = (pixel.y / u_tile_size) * u_tiles_x + pixel.x / u_tile_size;
    f.gas = 0; f.liquid = 0; f.absorption = 0;
    f.gas_alpha = 0; f.liquid_alpha = 0; f.flame_alpha = 0;
    f.gas_color = vec4(0); f.liquid_color = vec4(0); f.flame_color = vec4(0);
    f.emission = vec3(0); f.gas_visibility = vec3(0); f.liquid_visibility = vec3(0);
    f.liquid_refraction = 0;
    f.gradient = vec2(0);
    f.grain_color = vec4(0);
    f.grain_emission = vec3(0); f.grain_source = vec3(0); f.grain_visibility = vec3(0);
    f.grain_absorption = 0; f.grain_refraction = 0; f.grain_liquid = 0;
    f.grain_normal = vec2(0);
    int first = tile_start(tile), last = tile_start(tile + 1);
    if (first == last) return false;
    vec2 world = u_view.xy + (vec2(pixel) + .5) * u_view.zw * vec2(1, -1);
    float liquid_absorption = 0;
    f.aa = max(u_view.z, u_view.w) * .5;
    float flame_distance = 1e20;
    vec2 flame_optical = vec2(0);
    vec3 hot_emission = vec3(0);
    for (int i = first; i < last; i++) {
        Particle p = particle_at(i);
        if (p.position.w > FLUID_GRAIN_FIRST) {
            vec2 offset = world - p.position.xy;
            float distance = length(offset);
            float alpha = (1.0 - smoothstep(-f.aa, f.aa, distance - p.position.z)) * p.color.a;
            float coverage = alpha * (1.0 - f.grain_color.a);
            f.grain_color += vec4(p.color.rgb * coverage, coverage);
            f.grain_emission += p.color.rgb * p.optical.y * coverage;
            // Each grain supplies its own source density; a neighboring
            // absorber must not amplify a transparent grain's emission.
            float optical_depth = p.optical.x > 0.0 ? p.optical.x : 1.0;
            f.grain_source += p.color.rgb * p.optical.y * optical_depth * coverage;
            f.grain_absorption += p.optical.x * coverage;
            f.grain_visibility += p.color.rgb * p.detail.w * coverage;
            if (p.position.w > FLUID_GRAIN_LIQUID) {
                f.grain_liquid += coverage;
                f.grain_refraction += p.detail.z * coverage;
                f.grain_normal += offset / max(distance, .00001) * coverage;
            }
            continue;
        }
        vec2 local = (world - p.position.xy) / p.position.z;
        if (p.optical.z > 0.0) {
            float d = length(world - p.position.xy) - p.position.z;
            float k = p.optical.z;
            float h = clamp(.5 + .5 * (d - flame_distance) / k, 0.0, 1.0);
            flame_distance = mix(d, flame_distance, h) - k * h * (1.0 - h);
            f.flame_color = mix(p.color, f.flame_color, h);
            flame_optical = mix(p.optical.xy, flame_optical, h);
            continue;
        }
        // Negative gas stretch marks a cold wisp. Area-preserving ellipses
        // follow velocity; the widened support connects neighboring parcels.
        bool wisp = p.position.w < .5 && p.detail.z < 0.0;
        if (wisp) {
            vec2 direction = p.detail.xy;
            local = vec2(dot(local, direction) / -p.detail.z,
                         dot(local, vec2(-direction.y, direction.x)) * -p.detail.z);
        }
        float q = max(0.0, 1.0 - dot(local, local));
        if (q <= 0.0) continue;
        float weight = q * q * q;
        if (wisp) weight /= 2.25;
        if (p.optical.w > .001) {
            vec2 offset = world - p.position.xy;
            float half_length = p.position.z * .12 * p.detail.z;
            offset -= p.detail.xy * clamp(dot(offset, p.detail.xy), -half_length, half_length);
            float radius = p.position.z * .16 * sqrt(p.optical.w);
            float core = (1.0 - smoothstep(-f.aa, f.aa, length(offset) - radius)) * p.color.a;
            // Overlapping burning samples cannot accumulate an unlimited glow.
            hot_emission = max(hot_emission, p.color.rgb * p.optical.y * core);
        } else {
            f.emission += p.color.rgb * p.optical.y * weight;
        }
        if (p.position.w < .5) {
            f.gas += weight;
            f.gas_color += p.color * weight;
            f.gas_visibility += p.color.rgb * p.detail.w * weight;
            f.absorption += p.optical.x * weight;
        } else {
            f.liquid += weight;
            f.liquid_color += p.color * weight;
            liquid_absorption += p.optical.x * weight;
            f.liquid_visibility += p.color.rgb * p.detail.w * weight;
            f.liquid_refraction += p.detail.z * weight;
            f.gradient -= 6.0 * q * q * local / p.position.z;
        }
    }
    f.flame_alpha = (1.0 - smoothstep(-f.aa, f.aa, flame_distance)) * f.flame_color.a;
    if (f.gas + f.liquid + f.flame_alpha + f.grain_color.a <= .00001) return false;
    f.gas_color /= max(f.gas, .00001);
    f.liquid_color /= max(f.liquid, .00001);
    // A single dispersed parcel is nearly invisible; overlapping parcels stay
    // continuous. Broad support replaces the old four-lobe beaded contour.
    f.gas_alpha = smoothstep(.25, 1.4, f.gas) * (1.0 - exp(-f.gas * .5)) * f.gas_color.a;
    // Convert one screen pixel to density units using the analytic gradient.
    float density_aa = max(.0001, f.aa * length(f.gradient));
    f.liquid_alpha = smoothstep(.6 - density_aa, .6 + density_aa, f.liquid) * f.liquid_color.a;
    f.absorption += liquid_absorption / max(f.liquid, .00001) * f.liquid_alpha;
    f.absorption += flame_optical.x * f.flame_alpha;
    f.emission += hot_emission + f.flame_color.rgb * flame_optical.y * f.flame_alpha;
    return true;
}
// Adds fluid to the material targets in the tiles it covers: reads a copy of
// the material raster's and writes the originals, including the camera-only
// visibility; see render_material_textures.

layout(set = 2, binding = 0) uniform sampler2D u_scene;
layout(set = 2, binding = 1) uniform sampler2D u_source;
layout(set = 2, binding = 2) uniform sampler2D u_albedo;
layout(set = 2, binding = 3) uniform sampler2D u_normal;
layout(set = 2, binding = 4) uniform sampler2D u_visibility;
layout(set = 2, binding = 5) uniform sampler2D u_cover;

#define FLUID_PARTICLES_BINDING 6
#define FLUID_OFFSETS_BINDING 7
#define FLUID_INDICES_BINDING 8
#include "hrc/fluid_common.shd"

layout(location = 0) out vec4 out_scene;
layout(location = 1) out vec4 out_source;
layout(location = 2) out vec4 out_albedo;
layout(location = 3) out vec4 out_normal;
layout(location = 4) out vec4 out_visibility;
layout(location = 5) out vec4 out_cover;

void main()
{
    ivec2 pixel = ivec2(gl_FragCoord.xy);
    vec4 old_scene = texelFetch(u_scene, pixel, 0);
    vec4 old_source = texelFetch(u_source, pixel, 0);
    vec4 old_albedo = texelFetch(u_albedo, pixel, 0);
    vec4 old_normal = texelFetch(u_normal, pixel, 0);
    out_scene = old_scene;
    out_source = old_source;
    out_albedo = old_albedo;
    out_normal = old_normal;
    out_visibility = texelFetch(u_visibility, pixel, 0);
    out_cover = texelFetch(u_cover, pixel, 0);
    FluidSample f;
    if (!fluid_sample(pixel, f)) return;
    vec4 surface = vec4(f.liquid_color.rgb * f.liquid_alpha, f.liquid_alpha);
    surface += vec4(f.gas_color.rgb * f.gas_alpha, f.gas_alpha) * (1.0 - surface.a);
    surface += vec4(f.flame_color.rgb * f.flame_alpha, f.flame_alpha) * (1.0 - surface.a);
    surface = f.grain_color + surface * (1.0 - f.grain_color.a);

    // Scalar diagnostics use camera visibility, independent of incident GI.
    // Existing solid coverage still occludes them and no light is emitted.
    if (u_debug != 0) {
        float alpha = surface.a * (1.0 - old_scene.a);
        vec3 color = surface.rgb / max(surface.a, .00001);
        out_scene = vec4(old_scene.rgb * (1.0 - alpha), old_scene.a + alpha);
        out_source = old_source * (1.0 - alpha);
        out_albedo = old_albedo * (1.0 - alpha);
        out_normal = old_normal * (1.0 - alpha);
        out_visibility = vec4(out_visibility.rgb * (1.0 - alpha) + color * alpha,
                              out_visibility.a * (1.0 - alpha));
        return;
    }

    // Gas overlaps the visible surface as a shallow volume. Preserve some
    // emissive detail for ship/projectile readability; AI never samples this.
    float visible = 1.0 - old_scene.a;
    vec4 liquid_surface = vec4(f.liquid_color.rgb * f.liquid_alpha, f.liquid_alpha);
    vec4 flame_surface = vec4(f.flame_color.rgb * f.flame_alpha, f.flame_alpha);
    vec4 under = old_scene + (f.grain_color + (flame_surface + liquid_surface * (1.0 - f.flame_alpha)) * (1.0 - f.grain_color.a)) * visible;
    float cover = f.gas_alpha * .8;
    out_scene = vec4(under.rgb * (1.0 - cover) + f.gas_color.rgb * f.gas_alpha,
                     under.a + f.gas_alpha * (1.0 - under.a));
    // Fluid absorbs evenly, and emits like absorbing solids: its radiance
    // times its optical depth, as density (see hrc/source_average.shd).
    float grain_depth = f.grain_absorption * visible;
    float depth = f.absorption * max(visible, cover);
    vec3 density = depth > 0.0 ? f.emission * depth : f.emission;
    vec3 grain_density = f.grain_source * visible;
    out_source = vec4(old_source.rgb * (1.0 - cover * .6) + density + grain_density, old_source.a + depth + grain_depth);
    // Display shows emission rather than density; see render_material_textures.
    vec3 luma = vec3(.2126, .7152, .0722);
    float shown = dot(old_source.rgb * texelFetch(u_cover, pixel, 0).r * (1.0 - cover * .6) + f.emission + f.grain_emission * visible, luma);
    float dense = dot(out_source.rgb, luma);
    out_cover = vec4(dense > 1e-8 ? min(shown / dense, 60000.0) : 1.0, out_cover.gba);
    // Albedo alpha is material relief, which fluid leaves.
    out_albedo = vec4(old_albedo.rgb * (1.0 - cover) + surface.rgb * max(visible, cover), old_albedo.a);
    vec3 readability = f.liquid_alpha * f.liquid_visibility / max(f.liquid, .00001);
    readability += f.gas_alpha * f.gas_visibility / max(f.gas, .00001) * (1.0 - f.liquid_alpha);
    readability = f.grain_visibility + readability * (1.0 - f.grain_color.a);
    // Alpha marks participating fluid for camera exposure, not radiance feedback.
    float volume = f.grain_color.a + (f.liquid_alpha + f.gas_alpha * (1.0 - f.liquid_alpha)) * (1.0 - f.grain_color.a);
    out_visibility = vec4(readability * visible, volume * visible);
    float gradient_length = length(f.gradient);
    if (f.liquid_alpha > 0.0 && visible > 0.0) {
        float inside_distance = max(0.0, f.liquid - .6) / max(gradient_length, .0001);
        float surface_band = 1.0 - smoothstep(f.aa, f.aa * 12.0, inside_distance);
        float confidence = f.liquid_alpha * surface_band * visible;
        vec4 surface_normal = old_normal + vec4(-f.gradient / max(gradient_length, .0001), 0, 1) * confidence * (1.0 - old_normal.a);
        // Planar normals need only XY. Positive Z is solid edge-light gain;
        // negative Z marks liquid and stores its coverage-weighted distortion.
        surface_normal.z = mix(old_normal.z, -max(.001, f.liquid_refraction / f.liquid) * f.liquid_alpha, visible);
        out_normal = surface_normal;
    }
    if (f.grain_liquid > 0.0 && visible > 0.0) {
        float confidence = f.grain_liquid * visible;
        vec2 normal = f.grain_normal / max(f.grain_liquid, .00001);
        out_normal.xy = mix(out_normal.xy, normal, confidence);
        out_normal.z = mix(out_normal.z, -max(.001, f.grain_refraction / f.grain_liquid), confidence);
        out_normal.w = max(out_normal.w, confidence);
    }
}
// Adapted from Neon-Swarm shaders/hrc/gather.shd; original source comments retained.
// C-1 gather: per-quadrant raymarching at canvas resolution.
//
// Samples each quadrant's resolved cascade-0 fluence (see resolve.frag) and
// traces c-1 intervals at full canvas resolution for per-pixel detail even
// when work_res < canvas_res.
//
// With split lighting, the work grid is a finer luminance transport's: its
// four directions arrive in one image (resolve_luminance.frag), and color
// comes from a coarser RGB transport on the color grid. Each quadrant keeps
// its color's proportions at the luminance's brightness.
//
// A fragment pass stores total light, far light for bounce, and the four RGB
// quadrant contributions. When the work grid is coarser than the canvas,
// near-field steps come from u_near, which holds each canvas pixel's step once;
// see near.frag.

// RGB emission, A optical depth per canvas pixel, mipmapped; see
// render_material_textures.
layout(set = 2, binding = 0) uniform sampler2D u_source;
// The same, prefiltered onto the work grid.
layout(set = 2, binding = 1) uniform sampler2D u_source_filtered;
layout(set = 2, binding = 2) uniform sampler2D u_bounce;

// Color transport quadrants on the color grid.
layout(set = 2, binding = 3) uniform sampler2D u_f0;
layout(set = 2, binding = 4) uniform sampler2D u_f1;
layout(set = 2, binding = 5) uniform sampler2D u_f2;
layout(set = 2, binding = 6) uniform sampler2D u_f3;
// Split lighting: each quadrant's luminance on the work grid.
layout(set = 2, binding = 7) uniform sampler2D u_luminance;
layout(set = 2, binding = 8) uniform sampler2D u_near;

layout(location = 0) out vec4 out_light;
layout(location = 1) out vec4 out_far;
// RGB contributions from +x, +y (down the texture), -x and -y. Each already
// includes its quarter weight; surface shading preserves their colors.
layout(location = 2) out vec4 out_q0;
layout(location = 3) out vec4 out_q1;
layout(location = 4) out vec4 out_q2;
layout(location = 5) out vec4 out_q3;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_canvas_w;
	int u_canvas_h;
	int u_work_w;
	int u_work_h;
	int u_color_w;
	int u_color_h;
	int u_out_w;
	int u_out_h;
	int u_split;
	int u_upscale_mode;
	float u_upscale_threshold;
	float u_bounce_intensity;
	vec2 u_history_offset;
	int u_history_valid;
	vec4 u_crop_uv;
};

#include "hrc_common.shd"
#include "hrc/near_step.shd"

void output_quadrant(int rot, vec3 light)
{
	vec4 value = vec4(light * 0.25, 1.0);
	if (rot == 0) out_q0 = value;
	else if (rot == 1) out_q1 = value;
	else if (rot == 2) out_q2 = value;
	else out_q3 = value;
}

// Quadrant fluence at a color pixel; nothing arrives from outside the domain.
vec3 F_load(int rot, ivec2 p)
{
	if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, ivec2(u_color_w, u_color_h)))) return vec3(0.0);
	if (rot == 0) return texelFetch(u_f0, p, 0).rgb;
	if (rot == 1) return texelFetch(u_f1, p, 0).rgb;
	if (rot == 2) return texelFetch(u_f2, p, 0).rgb;
	return texelFetch(u_f3, p, 0).rgb;
}

// Hardware-filtered quadrant fluence at a continuous color-pixel position.
// Textures may keep a larger capacity; filtering stays inside the domain.
vec3 F_filtered(int rot, vec2 grid)
{
	grid = clamp(grid, vec2(0.0), vec2(u_color_w - 1, u_color_h - 1));
	vec2 uv = (grid + 0.5) / vec2(textureSize(u_f0, 0));
	if (rot == 0) return textureLod(u_f0, uv, 0.0).rgb;
	if (rot == 1) return textureLod(u_f1, uv, 0.0).rgb;
	if (rot == 2) return textureLod(u_f2, uv, 0.0).rgb;
	return textureLod(u_f3, uv, 0.0).rgb;
}

vec3 F_world_load(int rot, ivec2 p)
{
	return F_load(rot, clamp(p, ivec2(0), ivec2(u_color_w - 1, u_color_h - 1)));
}

// Split lighting: color with this luminance, or grey where color has none.
vec3 with_luminance(vec3 color, float luminance)
{
	float l = dot(color, HRC_LUMA);
	return l > 1e-8 ? color * (luminance / l) : vec3(luminance);
}

// Color pixel position of a canvas pixel center.
vec2 color_grid(ivec2 canvas_pos)
{
	return (vec2(canvas_pos) + 0.5) * vec2(u_color_w, u_color_h) / vec2(u_canvas_w, u_canvas_h) - 0.5;
}

// Light, reflected light included, and transmittance of a step of length s
// at canvas pixel p, from its one-pixel step in u_near. A step's light
// follows its source length, as does its reflected light, which scales with
// its opacity; see hrc/source_average.shd.
vec4 stored_step(ivec2 p, float s)
{
	vec4 near = texelFetch(u_near, p, 0);
	float scale = s == 1.0 ? 1.0 : source_length(near.a, s) / source_length(near.a, 1.0);
	return vec4(near.rgb * scale, exp(-near.a * s));
}

// World-space march direction for each quadrant's rotated +x axis.
ivec2 quadrant_dir(int rot)
{
	if (rot == 1) return ivec2(0, 1);
	if (rot == 2) return ivec2(-1, 0);
	if (rot == 3) return ivec2(0, -1);
	return ivec2(1, 0);
}

// Raymarch c-1 interval from canvas pixel toward nearest c0 probe.
// Covers the gap between the pixel and the R_0 probe at +1 grid offset
// in the quadrant's +x direction, sampled at full canvas resolution.
// Starts from step 1 — step 0 (center pixel) is pre-accumulated by the caller.
Interval trace_cminus1(ivec2 canvas_pos, int rot, vec3 init_rad, float init_tau, float init_trn)
{
	ivec2 dir = quadrant_dir(rot);

	// Dimensions along march direction.
	int canvas_dim = (rot == 0 || rot == 2) ? u_canvas_w : u_canvas_h;
	int work_dim = (rot == 0 || rot == 2) ? u_work_w : u_work_h;

	// Position along march direction in canvas space.
	int pos_along;
	if      (rot == 0) pos_along = canvas_pos.x;
	else if (rot == 1) pos_along = canvas_pos.y;
	else if (rot == 2) pos_along = (u_canvas_w - 1) - canvas_pos.x;
	else               pos_along = (u_canvas_h - 1) - canvas_pos.y;

	// Grid cell this pixel maps to (must match R_0 bilinear grid in main()).
	float cell_f = (float(pos_along) + 0.5) * float(work_dim) / float(canvas_dim) - 0.5;
	int grid_cell = int(floor(cell_f));

	// First canvas pixel of the next cell (where grid_f = grid_cell + 1).
	int next_probe = int(ceil((float(grid_cell) + 1.5) * float(canvas_dim) / float(work_dim) - 0.5));
	int num_steps = max(next_probe - pos_along, 1);

	vec3 acc_rad = init_rad;
	float acc_trn = init_trn;
	float acc_tau = init_tau;

	// Bound full-resolution refinement work as adaptive resolution decreases.
	int samples = min(num_steps - 1, 2);
	float stride = float(num_steps - 1) / float(max(samples, 1));
	for (int i = 0; i < samples; i++) {
		int offset = int(ceil((float(i) + 0.5) * stride));
		ivec2 p = clamp(canvas_pos + dir * offset, ivec2(0), ivec2(u_canvas_w - 1, u_canvas_h - 1));

		vec4 near = stored_step(p, stride);
		float T = max(near.a, 1e-6);
		acc_rad += acc_trn * near.rgb;
		acc_trn *= T;
		acc_tau -= log(T);
	}

	return Interval(acc_rad, acc_tau);
}

void main()
{
	ivec2 gid = ivec2(gl_FragCoord.xy);
	ivec2 out_size = ivec2(u_out_w, u_out_h);
	ivec2 canvas_pos = gid;
	if (out_size.x != u_canvas_w || out_size.y != u_canvas_h) {
		canvas_pos = clamp(
			ivec2((vec2(gid) + 0.5) * vec2(u_canvas_w, u_canvas_h) / vec2(out_size)),
			ivec2(0),
			ivec2(u_canvas_w - 1, u_canvas_h - 1)
		);
	}

	// Matching grids need one probe per quadrant and only the center interval.
	// Keep the same accumulation order as the reconstruction path below.
	if (u_canvas_w == u_work_w && u_canvas_h == u_work_h) {
		vec3 bounce;
		vec4 near = near_step(canvas_pos, 1.0, bounce);
		float trn = near.a;
		vec3 near_rad = near.rgb + (1.0 - trn) * bounce;
		vec3 total = vec3(0.0), raw = vec3(0.0);
		vec4 luminance = u_split != 0 ? texelFetch(u_luminance, canvas_pos, 0) : vec4(0.0);
		for (int rot = 0; rot < 4; rot++) {
			vec3 far_rad = u_split != 0
			                 ? F_filtered(rot, color_grid(canvas_pos))
			                 : F_load(rot, canvas_pos);
			vec3 quadrant = near_rad + trn * far_rad;
			if (u_split != 0) {
				quadrant = with_luminance(quadrant, dot(near_rad, HRC_LUMA) + trn * luminance[rot]);
				far_rad = with_luminance(far_rad, luminance[rot]);
			}
			total += quadrant;
			output_quadrant(rot, quadrant);
			raw += far_rad;
		}
		out_light = vec4(total * 0.25, 1.0);
		out_far = vec4(raw * 0.25, 1.0);
		return;
	}

	// Floating-point grid position for bilinear R_0 interpolation.
	// At scale=1.0 this degenerates to nearest-neighbor (frac = 0).
	vec2 grid_f = (vec2(canvas_pos) + 0.5) * vec2(u_work_w, u_work_h) / vec2(u_canvas_w, u_canvas_h) - 0.5;
	ivec2 g0 = ivec2(floor(grid_f));
	vec2 frac = grid_f - vec2(g0);

	// Precompute edge factor for minmax mode (mode 1).
	float edge = 0.0;
	if (u_upscale_mode == 1) {
		ivec2 c00 = clamp(g0, ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		ivec2 c11 = clamp(g0 + ivec2(1, 1), ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		float t00 = texelFetch(u_source_filtered, c00, 0).a;
		float t10 = texelFetch(u_source_filtered, ivec2(c11.x, c00.y), 0).a;
		float t01 = texelFetch(u_source_filtered, ivec2(c00.x, c11.y), 0).a;
		float t11 = texelFetch(u_source_filtered, c11, 0).a;
		float mn = min(min(t00, t10), min(t01, t11));
		float mx = max(max(t00, t10), max(t01, t11));
		edge = smoothstep(0.0, u_upscale_threshold, mx - mn);
	}

	// Precompute bilateral weights (mode 2).
	float bw00 = 1.0, bw10 = 1.0, bw01 = 1.0, bw11 = 1.0;
	if (u_upscale_mode == 2) {
		vec2 uv_center = (vec2(canvas_pos) + 0.5) / vec2(u_canvas_w, u_canvas_h);
		float t_center = textureLod(u_source, uv_center, 0.0).a;
		ivec2 c00 = clamp(g0, ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		ivec2 c10 = clamp(g0 + ivec2(1, 0), ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		ivec2 c01 = clamp(g0 + ivec2(0, 1), ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		ivec2 c11 = clamp(g0 + ivec2(1, 1), ivec2(0), ivec2(u_work_w - 1, u_work_h - 1));
		float sigma2 = 2.0 * u_upscale_threshold * u_upscale_threshold;
		float d00 = texelFetch(u_source_filtered, c00, 0).a - t_center;
		float d10 = texelFetch(u_source_filtered, c10, 0).a - t_center;
		float d01 = texelFetch(u_source_filtered, c01, 0).a - t_center;
		float d11 = texelFetch(u_source_filtered, c11, 0).a - t_center;
		bw00 = exp(-(d00 * d00) / sigma2);
		bw10 = exp(-(d10 * d10) / sigma2);
		bw01 = exp(-(d01 * d01) / sigma2);
		bw11 = exp(-(d11 * d11) / sigma2);
	}

	// Sample center pixel once for all quadrants (step 0 of trace_cminus1).
	vec4 center = stored_step(canvas_pos, 1.0);
	float center_T = max(center.a, 1e-6);
	float center_tau = -log(center_T);
	vec3 center_rad = center.rgb;

	// Split lighting: every quadrant's luminance from one image, blended toward
	// the nearest work probe at absorption edges like color in mode 1.
	vec4 luminance = vec4(0.0);
	vec2 grid_c = grid_f;
	if (u_split != 0) {
		ivec2 last = ivec2(u_work_w - 1, u_work_h - 1);
		vec2 uv = (clamp(grid_f, vec2(0.0), vec2(last)) + 0.5) / vec2(textureSize(u_luminance, 0));
		luminance = textureLod(u_luminance, uv, 0.0);
		if (edge > 0.0) {
			ivec2 nearest = clamp(g0 + ivec2(step(vec2(0.5), frac)), ivec2(0), last);
			luminance = mix(luminance, texelFetch(u_luminance, nearest, 0), edge);
		}
		grid_c = color_grid(canvas_pos);
	}

	vec3 total = vec3(0.0);
	vec3 total_raw = vec3(0.0);
	for (int rot = 0; rot < 4; rot++) {
		ivec2 s0 = g0;
		vec3 r0;
		if (u_split != 0) {
			// Color supplies only proportions; bilinear on its coarser grid.
			r0 = F_filtered(rot, grid_c);
		} else if (u_upscale_mode == 1) {
			// Edge: blend bilinear -> nearest at absorption edges.
			r0 = F_filtered(rot, grid_f);
			if (edge > 0.0) {
				r0 = mix(r0, F_load(rot, s0 + ivec2(step(vec2(0.5), frac))), edge);
			}
		} else if (u_upscale_mode == 2) {
			vec3 v00 = F_load(rot, s0);
			vec3 v10 = F_load(rot, s0 + ivec2(1, 0));
			vec3 v01 = F_load(rot, s0 + ivec2(0, 1));
			vec3 v11 = F_load(rot, s0 + ivec2(1, 1));
			// Joint bilateral: bilinear weights modulated by transmittance similarity.
			float w00 = (1.0 - frac.x) * (1.0 - frac.y) * bw00;
			float w10 = frac.x          * (1.0 - frac.y) * bw10;
			float w01 = (1.0 - frac.x) * frac.y          * bw01;
			float w11 = frac.x          * frac.y          * bw11;
			float wsum = w00 + w10 + w01 + w11;
			if (wsum > 1e-6)
				r0 = (v00 * w00 + v10 * w10 + v01 * w01 + v11 * w11) / wsum;
			else
				r0 = (frac.x < 0.5 && frac.y < 0.5) ? v00
				   : (frac.x >= 0.5 && frac.y < 0.5) ? v10
				   : (frac.x < 0.5)                   ? v01
				   :                                     v11;
		} else if (u_upscale_mode == 3) {
			// Five-tap cross reconstruction. The nearest work probe is the center;
			// distance from it distributes weight to the four axial neighbors. This
			// keeps a single emissive probe from being diluted across four corners.
			ivec2 center_cell = ivec2(floor(grid_f + vec2(0.5)));
			vec2 center_delta = grid_f - vec2(center_cell);
			float wc = max(0.0, 1.0 - abs(center_delta.x) - abs(center_delta.y));
			float wl = max(0.0, -center_delta.x);
			float wr = max(0.0, center_delta.x);
			float wb = max(0.0, -center_delta.y);
			float wt = max(0.0, center_delta.y);
			vec3 vc = F_world_load(rot, center_cell);
			vec3 vl = F_world_load(rot, center_cell + ivec2(-1, 0));
			vec3 vr = F_world_load(rot, center_cell + ivec2(1, 0));
			vec3 vb = F_world_load(rot, center_cell + ivec2(0, -1));
			vec3 vt = F_world_load(rot, center_cell + ivec2(0, 1));
			float wsum = wc + wl + wr + wb + wt;
			r0 = wsum > 1e-6 ? (vc * wc + vl * wl + vr * wr + vb * wb + vt * wt) / wsum : vc;
		} else {
			// Mode 0: plain bilinear.
			r0 = F_filtered(rot, grid_f);
		}

		Interval cminus1 = trace_cminus1(canvas_pos, rot, center_rad, center_tau, center_T);
		float trn = exp(-cminus1.tau);
		vec3 quadrant = cminus1.rad + trn * r0;
		if (u_split != 0) {
			quadrant = with_luminance(quadrant, dot(cminus1.rad, HRC_LUMA) + trn * luminance[rot]);
			r0 = with_luminance(r0, luminance[rot]);
		}
		total += quadrant;
		output_quadrant(rot, quadrant);
		total_raw += r0;
	}

	out_light = vec4(total * 0.25, 1.0);
	out_far = vec4(total_raw * 0.25, 1.0);
}
// Bounded, lighting-independent horizons. Each direction uses ten normalized
// 0.6-world-unit steps, including diagonals. Empty coverage ends the local surface.
layout(set = 2, binding = 0) uniform sampler2D u_relief;
layout(set = 3, binding = 0) uniform uniform_block
{
    vec2 u_world_per_px;
    int u_directions;
    int u_cache_valid;
    ivec2 u_cache_offset;
    int u_cache_tile;
};
layout(location = 0) out vec4 out_cardinal;
#ifdef HRC_HORIZON_FOUR
vec4 out_diagonal;
#else
layout(location = 1) out vec4 out_diagonal;
#endif
#include "hrc/horizon_cache.shd"
const float PI = 3.141592653589793;
float horizon(vec2 uv, vec2 toward, float height)
{
    ivec2 size = textureSize(u_relief, 0);
    vec2 step_uv = toward * (0.6 / u_world_per_px) / vec2(size);
    float slope = 0.0;
    for (int i = 1; i <= 10; i++) {
        vec2 sample_uv = uv + step_uv * float(i);
        if (any(lessThan(sample_uv, vec2(0))) || any(greaterThanEqual(sample_uv, vec2(1)))) break;
        ivec2 p = ivec2(sample_uv * vec2(size));
        vec4 relief = texelFetch(u_relief, p, 0);
        if (relief.y < 0.5) break;
        float nz = sqrt(max(1.0 - dot(relief.zw, relief.zw), 0.0));
        vec2 offset = (sample_uv * vec2(size) - (vec2(p) + 0.5)) * u_world_per_px;
        float sample_height = relief.x;
        if (nz > 0.05) sample_height -= dot(relief.zw, vec2(offset.x, -offset.y)) / nz;
        float bias = max(0.002, max(abs(height), abs(sample_height)) * 0.001);
        slope = max(slope, (sample_height - height - bias) / (0.6 * float(i)));
    }
    return atan(slope);
}
void main()
{
    ivec2 p = ivec2(gl_FragCoord.xy);
    if (reuse_horizon(p)) return;
    vec4 center = texelFetch(u_relief, p, 0);
    out_cardinal = vec4(0);
    out_diagonal = vec4(0);
    if (center.y <= 0.5) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(textureSize(u_relief, 0));
    // GLSL ES requires constant indices when writing fragment outputs.
    vec4 cardinal = vec4(0), diagonal = vec4(0);
    // Stored in UV azimuth order: +X, +Y, -X, -Y, then their diagonals.
    for (int i = 0; i < 4; i++) {
        float angle = float(i) * PI * 0.5;
        cardinal[i] = horizon(uv, vec2(cos(angle), sin(angle)), center.x);
        if (u_directions == 8) {
            angle += PI * 0.25;
            diagonal[i] = horizon(uv, vec2(cos(angle), sin(angle)), center.x);
        }
    }
    out_cardinal = cardinal;
    out_diagonal = diagonal;
}
#define HRC_HORIZON_FOUR
#include "hrc/horizon.frag"
#ifdef HRC_CACHE_HIERARCHY
layout(set = 2, binding = 4) uniform sampler2D u_previous_cardinal;
#ifdef HRC_HORIZON_FOUR
layout(set = 2, binding = 5) uniform sampler2D u_dirty;
#else
layout(set = 2, binding = 5) uniform sampler2D u_previous_diagonal;
layout(set = 2, binding = 6) uniform sampler2D u_dirty;
#endif
#else
layout(set = 2, binding = 1) uniform sampler2D u_previous_cardinal;
#ifdef HRC_HORIZON_FOUR
layout(set = 2, binding = 2) uniform sampler2D u_dirty;
#else
layout(set = 2, binding = 2) uniform sampler2D u_previous_diagonal;
layout(set = 2, binding = 3) uniform sampler2D u_dirty;
#endif
#endif
bool reuse_horizon(ivec2 p)
{
    if (u_cache_valid == 0 || texelFetch(u_dirty, p / u_cache_tile, 0).r > 0.5) return false;
    ivec2 previous = p + u_cache_offset;
    ivec2 size = textureSize(u_previous_cardinal, 0);
    if (any(lessThan(previous, ivec2(0))) || any(greaterThanEqual(previous, size))) return false;
    out_cardinal = texelFetch(u_previous_cardinal, previous, 0);
#ifndef HRC_HORIZON_FOUR
    out_diagonal = texelFetch(u_previous_diagonal, previous, 0);
#endif
    return true;
}
// Conservative sample skipping over the reference ten 0.6-unit positions.
// Coarse maxima are bounds only: they never become a shading horizon. A fully
// covered group can skip only if its padded height cannot raise the current
// slope; mixed cells and potentially higher blockers keep the fine samples.
layout(set = 2, binding = 0) uniform sampler2D u_relief;
layout(set = 2, binding = 1) uniform sampler2D u_relief_half;
layout(set = 2, binding = 2) uniform sampler2D u_relief_quarter;
layout(set = 2, binding = 3) uniform sampler2D u_relief_eighth;
layout(set = 3, binding = 0) uniform uniform_block
{
    vec2 u_world_per_px;
    int u_directions;
    int u_levels;
    int u_cache_valid;
    ivec2 u_cache_offset;
    int u_cache_tile;
};
layout(location = 0) out vec4 out_cardinal;
#ifdef HRC_HORIZON_FOUR
vec4 out_diagonal;
#else
layout(location = 1) out vec4 out_diagonal;
#endif
#define HRC_CACHE_HIERARCHY
#include "hrc/horizon_cache.shd"
const float PI = 3.141592653589793;
vec4 bounds_at(int level, ivec2 p)
{
    if (level == 3) return texelFetch(u_relief_eighth, p, 0);
    if (level == 2) return texelFetch(u_relief_quarter, p, 0);
    return texelFetch(u_relief_half, p, 0);
}
float horizon(vec2 uv, vec2 toward, float height)
{
    ivec2 size = textureSize(u_relief, 0);
    // Keep the fine sample arithmetic identical to horizon.frag, including
    // UV rounding at texel boundaries.
    vec2 step_uv = toward * (0.6 / u_world_per_px) / vec2(size);
    float slope = 0.0;
    int i = 1;
    // One hierarchy lookup at most per iteration. A mixed cell falls straight
    // back to the reference sample rather than recursively fetching all levels.
    for (int walk = 0; walk < 10; walk++) {
        if (i > 10) break;
        vec2 sample_pos = (uv + step_uv * float(i)) * vec2(size);
        if (any(lessThan(sample_pos, vec2(0))) || any(greaterThanEqual(sample_pos, vec2(size)))) break;
        int selected = 0, chunk = 1;
        ivec2 cell = ivec2(0);
        for (int level = 3; level >= 1; level--) {
            if (level > u_levels) continue;
            int span = 1 << level;
            int count = min(span, 11 - i);
            if (count <= 1) continue;
            vec2 end = (uv + step_uv * float(i + count - 1)) * vec2(size);
            if (any(lessThan(end, vec2(0))) || any(greaterThanEqual(end, vec2(size)))) continue;
            ivec2 first_cell = ivec2(floor(sample_pos / float(span)));
            ivec2 last_cell = ivec2(floor(end / float(span)));
            if (any(notEqual(first_cell, last_cell))) continue;
            // The segment lies within one convex cell, so every scheduled
            // sample between its endpoints shares this coverage/height bound.
            selected = level;
            chunk = count;
            cell = first_cell;
            break;
        }
        if (selected != 0) {
            vec4 bounds = bounds_at(selected, cell);
            if (bounds.z < 0.5) break;
            if (bounds.y >= 0.5 && bounds.x < 65504.0) {
                // Only the first reduction rounds a newly calculated maximum;
                // later max operations preserve that half-float value. 0.05%
                // covers downward half rounding. The small float term also
                // bounds cancellation when a negative height gains a face-plane
                // extent (nz > .05 caps that extent at 10 * pixel-size sum).
                float pad = max(0.00001, abs(bounds.x) * 0.0005)
                    + (abs(bounds.x) + 20.0 * (u_world_per_px.x + u_world_per_px.y)) * 0.000001;
                // Actual bias may be larger for a high blocker; using only the
                // center term keeps this an upper bound on its candidate slope.
                float low_bias = max(0.002, abs(height) * 0.001);
                float upper_slope = (bounds.x + pad - height - low_bias) / (0.6 * float(i));
                // Positive numerator is largest at the closest sample. A
                // negative numerator cannot raise the nonnegative current slope.
                // Saturated maxima are excluded: their unclamped bound is lost.
                if (upper_slope <= slope) {
                    i += chunk;
                    continue;
                }
            }
        }
        ivec2 p = ivec2(sample_pos);
        vec4 relief = texelFetch(u_relief, p, 0);
        if (relief.y < 0.5) break;
        float nz = sqrt(max(1.0 - dot(relief.zw, relief.zw), 0.0));
        vec2 offset = (sample_pos - (vec2(p) + 0.5)) * u_world_per_px;
        float sample_height = relief.x;
        if (nz > 0.05) sample_height -= dot(relief.zw, vec2(offset.x, -offset.y)) / nz;
        float bias = max(0.002, max(abs(height), abs(sample_height)) * 0.001);
        slope = max(slope, (sample_height - height - bias) / (0.6 * float(i)));
        i++;
    }
    return atan(slope);
}
void main()
{
    ivec2 p = ivec2(gl_FragCoord.xy);
    if (reuse_horizon(p)) return;
    vec4 center = texelFetch(u_relief, p, 0);
    out_cardinal = vec4(0);
    out_diagonal = vec4(0);
    if (center.y <= 0.5) return;
    vec2 origin = (vec2(p) + 0.5) / vec2(textureSize(u_relief, 0));
    vec4 cardinal = vec4(0), diagonal = vec4(0);
    for (int i = 0; i < 4; i++) {
        float angle = float(i) * PI * 0.5;
        cardinal[i] = horizon(origin, vec2(cos(angle), sin(angle)), center.x);
        if (u_directions == 8) {
            angle += PI * 0.25;
            diagonal[i] = horizon(origin, vec2(cos(angle), sin(angle)), center.x);
        }
    }
    // WebGL requires output-vector indices to be constant, so assign whole vectors.
    out_cardinal = cardinal;
    out_diagonal = diagonal;
}
#define HRC_HORIZON_FOUR
#include "hrc/horizon_hierarchy.frag"
// Fade only the outer half of the lighting margin. The camera rectangle and
// nearby offscreen sources retain their full power; occluders are never faded.
float hrc_emission_weight(vec2 uv, vec4 crop)
{
    if (crop.z <= crop.x || crop.w <= crop.y) return 1.0;
    vec4 margin = vec4(crop.xy, vec2(1.0) - crop.zw);
    vec4 weight = smoothstep(vec4(0.0), max(margin * 0.5, vec4(1e-6)),
                             vec4(uv, vec2(1.0) - uv));
    return min(min(weight.x, weight.y), min(weight.z, weight.w));
}
// Hierarchy levels are render targets written by fragment passes, which the
// GPU compresses losslessly; empty space costs little bandwidth. In the RGB
// transport each pixel holds one element: an interval of T (light, optical
// depth) or a direction of R (light). Quadrants 1 and 3 run along world y, so
// their levels are stored transposed, rows along x, which gives every quadrant
// the same texture shape. Luminance pairs quadrants 0 and 2, then 1 and 3, in
// one set of levels: an interval texel holds both directions' (light, depth),
// a fluence texel both lights.

#include "hrc_common.shd"
#include "hrc/hrc_slots.shd"

layout(location = 0) out vec4 out_value;

ivec2 hrc_texel(int element, int row, int transposed)
{
	return transposed != 0 ? ivec2(row, element) : ivec2(element, row);
}

// This fragment's element and row.
ivec2 hrc_element_row(int transposed)
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	return transposed != 0 ? p.yx : p;
}

#ifdef HRC_SCALAR
Interval interval_fetch(sampler2D level, ivec2 p)
{
	vec4 v = texelFetch(level, p, 0);
	return Interval(v.xz, v.yw);
}

vec4 interval_texel(Interval v)
{
	vec2 rad = clamp(v.rad, vec2(0.0), vec2(65504.0));
	return vec4(rad.x, v.tau.x, rad.y, v.tau.y);
}

vec2 light_fetch(sampler2D level, ivec2 p)
{
	return texelFetch(level, p, 0).xy;
}

vec4 light_texel(vec2 v)
{
	return vec4(clamp(v, vec2(0.0), vec2(65504.0)), 0.0, 1.0);
}
#else
Interval interval_fetch(sampler2D level, ivec2 p)
{
	vec4 v = texelFetch(level, p, 0);
	return Interval(v.rgb, v.a);
}

vec4 interval_texel(Interval v)
{
	return vec4(clamp(v.rad, vec3(0.0), vec3(65504.0)), v.tau);
}

vec3 light_fetch(sampler2D level, ivec2 p)
{
	return texelFetch(level, p, 0).rgb;
}

vec4 light_texel(vec3 v)
{
	return vec4(clamp(v, vec3(0.0), vec3(65504.0)), 1.0);
}
#endif
// Levels store items in parity order, evens first and odds after, so fragments
// that run together take the same branch: fluence rows order their probes this
// way, and interval rows order each probe's directions. Slot s of count items
// holds item hrc_parity_item(s, count); item i sits in slot hrc_parity_slot.
int hrc_parity_item(int slot, int count)
{
	int evens = (count + 1) / 2;
	return slot < evens ? 2 * slot : 2 * (slot - evens) + 1;
}

int hrc_parity_slot(int item, int count)
{
	return (item & 1) != 0 ? (count + 1) / 2 + item / 2 : item / 2;
}
// DDA path-traces one interval of a level. The including shader declares the
// u_rotate, u_work_w, u_work_h and u_step_scale uniforms.
//
// For each interval, march along the ray from probe origin to target endpoint,
// stepping once per pixel boundary along the longest axis and accumulating
// radiance/optical-depth front-to-back. Stores τ (optical depth) instead of T.
// The luminance variant traces quadrant u_rotate and its opposite as
// brightness; see hrc_common.shd.

#include "hrc/source_average.shd"

// RGB emission density, A optical depth per canvas pixel.
layout(set = 2, binding = 0) uniform sampler2D u_source;
// Reflected light, already scaled by bounce intensity.
layout(set = 2, binding = 1) uniform sampler2D u_bounce;

vec2 rotate_pos(vec2 p, int rot, int w, int h)
{
	if (rot == 1)      return vec2(float(w - 1) - p.y, p.x);
	else if (rot == 2) return vec2(float(w - 1) - p.x, float(h - 1) - p.y);
	else if (rot == 3) return vec2(p.y, float(h - 1) - p.x);
	return p;
}

vec2 rotate_dir(vec2 d, int rot)
{
	if (rot == 1)      return vec2(-d.y, d.x);
	else if (rot == 2) return vec2(-d.x, -d.y);
	else if (rot == 3) return vec2(d.y, -d.x);
	return d;
}

// Light, optical depth and transmittance of one DDA step through the cell at
// a sample position in world work pixels; see hrc/source_average.shd.
void cell_step(vec2 sample_pos, float dda_step, out vec3 rad, out float tau_step, out float trn)
{
	vec2 uv = (clamp(sample_pos, vec2(0.0), vec2(u_work_w - 1, u_work_h - 1)) + vec2(0.5)) /
	          vec2(textureSize(u_source, 0));
	vec4 cell = texture(u_source, uv);
	tau_step = max(cell.a, 0.0) * dda_step;
	trn = exp(-tau_step);
	rad = cell.rgb * source_length(cell.a, dda_step);
	// Reflected light requires an interaction with matter, so it scales with
	// the step's opacity and never amplifies temporal bounce.
	rad += (1.0 - trn) * texture(u_bounce, uv).rgb;
}

// A level-0 interval of quadrant rot is one diagonal step through its probe's
// cell, the same for both of its directions.
void trace_cell_ray(int rot, int probe_x, int row, out vec3 rad, out float tau)
{
	float trn;
	vec2 cell = rotate_pos(vec2(float(probe_x), float(row)), rot, u_work_w, u_work_h);
	cell_step(cell, sqrt(2.0) * u_step_scale, rad, tau, trn);
}

void trace_ray(int rot, int level, int probe_x, int k, int row, out vec3 rad, out float tau)
{
	int step = 1 << level;

	// Ray endpoints in rotated cascade space.
	float y_offset = float(2 * k - step);
	vec2 ray_start = vec2(float(probe_x * step), float(row));
	vec2 ray_end = vec2(float(probe_x * step + step), float(row) + y_offset);

	// DDA: step once per pixel boundary along longest axis.
	vec2 segment = ray_end - ray_start;
	float intrv = max(max(abs(segment.x), abs(segment.y)), 1.0);
	vec2 delta = segment / intrv;
	float step_length = length(delta);

	// Pre-rotate start and delta to avoid per-step rotation.
	vec2 rot_start = rotate_pos(ray_start, rot, u_work_w, u_work_h);
	vec2 rot_delta = rotate_dir(delta, rot);

	// Clip iteration range to world bounds [-0.5, work_{w,h} - 0.5).
	float ii_lo = 0.0;
	float ii_hi = intrv;
	vec2 lo_bound = vec2(-0.5);
	vec2 hi_bound = vec2(float(u_work_w), float(u_work_h)) - 0.5;

	if (abs(rot_delta.x) > 1e-6) {
		float t0 = (lo_bound.x - rot_start.x) / rot_delta.x;
		float t1 = (hi_bound.x - rot_start.x) / rot_delta.x;
		ii_lo = max(ii_lo, min(t0, t1));
		ii_hi = min(ii_hi, max(t0, t1));
	} else if (rot_start.x < lo_bound.x || rot_start.x >= hi_bound.x) {
		ii_hi = -1.0;
	}

	if (abs(rot_delta.y) > 1e-6) {
		float t0 = (lo_bound.y - rot_start.y) / rot_delta.y;
		float t1 = (hi_bound.y - rot_start.y) / rot_delta.y;
		ii_lo = max(ii_lo, min(t0, t1));
		ii_hi = min(ii_hi, max(t0, t1));
	} else if (rot_start.y < lo_bound.y || rot_start.y >= hi_bound.y) {
		ii_hi = -1.0;
	}

	ii_lo = ceil(ii_lo);

	float eps = 1.0 / 512.0;
	float dda_step = step_length * u_step_scale;
	rad = vec3(0.0);
	tau = 0.0;
	float total_trn = 1.0;
	for (float ii = ii_lo; ii < ii_hi; ii += 1.0) {
		vec3 step_rad;
		float tau_step, trn;
		cell_step(rot_start + rot_delta * ii, dda_step, step_rad, tau_step, trn);
		rad += total_trn * step_rad;
		total_trn *= trn;
		tau += tau_step;
		if (total_trn < eps) break;
	}
}

#ifdef HRC_SCALAR
Interval trace_cell(int probe_x, int row)
{
	Interval paired = Interval(vec2(0.0), vec2(0.0));
	for (int lane = 0; lane < 2; lane++) {
		vec3 rad;
		float tau;
		trace_cell_ray(u_rotate + 2 * lane, probe_x, row, rad, tau);
		paired.rad[lane] = dot(rad, HRC_LUMA);
		paired.tau[lane] = tau;
	}
	return paired;
}

Interval trace_interval(int level, int probe_x, int k, int row)
{
	Interval paired = Interval(vec2(0.0), vec2(0.0));
	for (int lane = 0; lane < 2; lane++) {
		vec3 rad;
		float tau;
		trace_ray(u_rotate + 2 * lane, level, probe_x, k, row, rad, tau);
		paired.rad[lane] = dot(rad, HRC_LUMA);
		paired.tau[lane] = tau;
	}
	return paired;
}
#else
Interval trace_cell(int probe_x, int row)
{
	vec3 rad;
	float tau;
	trace_cell_ray(u_rotate, probe_x, row, rad, tau);
	return Interval(rad, tau);
}

Interval trace_interval(int level, int probe_x, int k, int row)
{
	vec3 rad;
	float tau;
	trace_ray(u_rotate, level, probe_x, k, row, rad, tau);
	return Interval(rad, tau);
}
#endif
// Copies the material targets; see render_material_textures.

layout(set = 2, binding = 0) uniform sampler2D u_scene;
layout(set = 2, binding = 1) uniform sampler2D u_source;
layout(set = 2, binding = 2) uniform sampler2D u_albedo;
layout(set = 2, binding = 3) uniform sampler2D u_normal;
layout(set = 2, binding = 4) uniform sampler2D u_visibility;
layout(set = 2, binding = 5) uniform sampler2D u_cover;

layout(location = 0) out vec4 out_scene;
layout(location = 1) out vec4 out_source;
layout(location = 2) out vec4 out_albedo;
layout(location = 3) out vec4 out_normal;
layout(location = 4) out vec4 out_visibility;
layout(location = 5) out vec4 out_cover;

void main()
{
	ivec2 pixel = ivec2(gl_FragCoord.xy);
	out_scene = texelFetch(u_scene, pixel, 0);
	out_source = texelFetch(u_source, pixel, 0);
	out_albedo = texelFetch(u_albedo, pixel, 0);
	out_normal = texelFetch(u_normal, pixel, 0);
	out_visibility = texelFetch(u_visibility, pixel, 0);
	out_cover = texelFetch(u_cover, pixel, 0);
}
// Adapted from Neon-Swarm shaders/hrc/merge.shd; original source comments retained.
// Builds angular fluence R_n from R_{n+1} (Sec 4, Eq 14-17).
//
// Odd probe x (Eq 14): trace one T_n step outward to reach R_{n+1} probes.
// Even probe x (Eq 15-17): average direct R_{n+1} lookup with traced T_{n+1} path.
//
// R_N is implicitly zero; the top merge never reads a previous fluence level.
//
// Level layout:
//   T: element = probe_x * (2^n + 1) + slot of k, row = y
//   R: element = slot * 2^n + i,          row = y; see hrc_parity_slot

#include "hrc/hrc_pass.shd"

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_cascade;
	int u_transposed;
	int u_world_w;
	int u_world_h;
	int u_cascade_count;
	float u_falloff;
	// Levels below this one are traced here rather than stored.
	int u_stored_from;
	int u_rotate;
	int u_work_w;
	int u_work_h;
	float u_step_scale;
};

#include "hrc/hrc_trace.shd"

layout(set = 2, binding = 2) uniform sampler2D u_t_curr;
layout(set = 2, binding = 3) uniform sampler2D u_t_next;
layout(set = 2, binding = 4) uniform sampler2D u_r_prev;
// Row n holds each level-n direction's shares of its sector in its upper (x)
// and lower (y) sub-cones.
layout(set = 2, binding = 5) uniform sampler2D u_weights;

HRC_LIGHT merge_r(Interval near, HRC_LIGHT far_rad)
{
	// Distance falloff: attenuate far light by this cascade's interval length.
	// Exponential compounding across levels gives total atten = exp(-falloff * dist).
	float atten = u_falloff > 0.0 ? exp(-u_falloff * float(1 << u_cascade)) : 1.0;
	return near.rad + exp(-near.tau) * far_rad * atten;
}

Interval T_load(sampler2D level_tex, int n, int probe_x, int k, int y)
{
	if (n >= u_cascade_count) return Interval(HRC_LIGHT(0.0), HRC_DEPTH(0.0));
	int directions = (1 << n) + 1;
	int num_probes = probe_count(u_world_w, n);
	if (probe_x < 0 || probe_x >= num_probes || k < 0 || k >= directions || y < 0 || y >= u_world_h) {
		return Interval(HRC_LIGHT(0.0), HRC_DEPTH(0.0));
	}
	// WebGL forbids ?: on structs.
	if (n < u_stored_from) {
		if (n == 0) return trace_cell(probe_x, y);
		return trace_interval(n, probe_x, k, y);
	}
	int element = probe_x * directions + hrc_parity_slot(k, directions);
	return interval_fetch(level_tex, hrc_texel(element, y, u_transposed));
}

HRC_LIGHT R_load(int probe_x, int i, int y)
{
	int n = u_cascade + 1;
	if (n >= u_cascade_count) return HRC_LIGHT(0.0);
	int directions = 1 << n;
	int num_probes = probe_count(u_world_w, n);
	if (probe_x < 0 || probe_x >= num_probes || i < 0 || i >= directions || y < 0 || y >= u_world_h) {
		return HRC_LIGHT(0.0);
	}
	int element = hrc_parity_slot(probe_x, num_probes) * directions + i;
	return light_fetch(u_r_prev, hrc_texel(element, y, u_transposed));
}

HRC_LIGHT merge_odd(int probe_x, int i, int y, vec2 w)
{
	int next_probe_x = (probe_x + 1) / 2;
	int pow2n = 1 << u_cascade;
	Interval upper = T_load(u_t_curr, u_cascade, probe_x, i + 1, y);
	// Both level-0 intervals of a probe cross only its cell.
	Interval lower = upper;
	if (u_cascade != 0) lower = T_load(u_t_curr, u_cascade, probe_x, i, y);
	return w.x * merge_r(upper, R_load(next_probe_x, 2 * i + 1, y + 2 * (i + 1) - pow2n)) +
	       w.y * merge_r(lower, R_load(next_probe_x, 2 * i, y + 2 * i - pow2n));
}

HRC_LIGHT merge_even(int probe_x, int i, int y, vec2 w)
{
	int next_probe_x = probe_x / 2;
	int far_probe_x = next_probe_x + 1;
	int pow2n1 = 1 << (u_cascade + 1);
	HRC_LIGHT far = w.x * merge_r(T_load(u_t_next, u_cascade + 1, next_probe_x, 2 * (i + 1), y),
	                              R_load(far_probe_x, 2 * i + 1, y + 2 * 2 * (i + 1) - pow2n1)) +
	                w.y * merge_r(T_load(u_t_next, u_cascade + 1, next_probe_x, 2 * i, y),
	                              R_load(far_probe_x, 2 * i, y + 2 * 2 * i - pow2n1));
	HRC_LIGHT near = w.x * R_load(next_probe_x, 2 * i + 1, y) + w.y * R_load(next_probe_x, 2 * i, y);
	return (near + far) * 0.5;
}

void main()
{
	int directions = 1 << u_cascade;
	int num_probes = probe_count(u_world_w, u_cascade);
	ivec2 er = hrc_element_row(u_transposed);
	int slot = er.x / directions;
	int i = er.x - slot * directions;
	int probe_x = hrc_parity_item(slot, num_probes);
	vec2 w = texelFetch(u_weights, ivec2(i, u_cascade), 0).xy;
	HRC_LIGHT light = (probe_x % 2 == 0) ? merge_even(probe_x, i, er.y, w)
	                                     : merge_odd(probe_x, i, er.y, w);
	out_value = light_texel(light);
}
#define HRC_SCALAR 1
#include "hrc/merge.frag"
// Each canvas pixel's one-pixel near-field step for gather: RGB its light,
// reflected light included, and A its optical depth. Gather reads a pixel's
// step for itself and for its neighbors on the way to each quadrant's probe,
// so computing it once here saves repeating it.

layout(set = 2, binding = 0) uniform sampler2D u_source;
layout(set = 2, binding = 1) uniform sampler2D u_bounce;

#ifdef HRC_PACK_RELIEF
#include "hrc/relief_sample.shd"
layout(location = 0) out vec4 out_relief;
layout(location = 1) out vec4 out_value;
#else
layout(location = 0) out vec4 out_value;
#endif

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_canvas_w;
	int u_canvas_h;
	int u_out_w;
	int u_out_h;
	float u_bounce_intensity;
	vec2 u_history_offset;
	int u_history_valid;
	vec4 u_crop_uv;
};

#include "hrc/near_step.shd"

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	#ifdef HRC_PACK_RELIEF
	out_relief = packed_relief(p);
	#endif
	vec3 bounce;
	vec4 step = near_step(p, 1.0, bounce);
	out_value = vec4(step.rgb + (1.0 - step.a) * bounce, max(texelFetch(u_source, p, 0).a, 0.0));
}
// Same near-field calculation, with relief written into a second target.
#define HRC_PACK_RELIEF
#include "hrc/near.frag"
// A near-field step through one canvas pixel, shared by gather and near.frag.
// The including shader declares the u_source and u_bounce samplers and the
// u_canvas_w, u_canvas_h, u_out_w, u_out_h, u_crop_uv, u_history_offset,
// u_history_valid and u_bounce_intensity uniforms.

#include "hrc/hrc_domain.shd"
#include "hrc/source_average.shd"

// Emission at canvas pixel p, whose full-resolution source texel is source.
vec3 emission_at(ivec2 p, vec4 source)
{
	ivec2 out_size = ivec2(u_out_w, u_out_h);
	vec2 uv = (vec2(p) + 0.5) / vec2(u_canvas_w, u_canvas_h);
	vec3 emission;
	if (all(equal(out_size, ivec2(u_canvas_w, u_canvas_h)))) {
		emission = source.rgb;
	} else {
		vec2 cell = floor(uv * vec2(out_size));
		uv = (cell + 0.5) / vec2(out_size);
		vec2 ratio = vec2(u_canvas_w, u_canvas_h) / vec2(out_size);
		float lod = log2(max(ratio.x, ratio.y));
		emission = textureLod(u_source, uv, lod).rgb;
	}
	return emission * hrc_emission_weight(uv, u_crop_uv);
}

vec3 bounce_at(ivec2 p)
{
	vec2 uv = (vec2(p) + 0.5) / vec2(u_canvas_w, u_canvas_h) + u_history_offset;
	if (u_history_valid == 0 || any(lessThan(uv, vec2(0.0))) ||
	    any(greaterThanEqual(uv, vec2(1.0)))) return vec3(0.0);
	return textureLod(u_bounce, uv, 0.0).rgb * u_bounce_intensity;
}

// Light and transmittance of a step of length s at a canvas pixel, and its
// reflected light.
vec4 near_step(ivec2 p, float s, out vec3 bounce)
{
	vec4 source = texelFetch(u_source, p, 0);
	bounce = bounce_at(p);
	return source_step(vec4(emission_at(p, source), source.a), s);
}
// A triangle covering the viewport; fragment passes address their target by
// gl_FragCoord.
layout(location = 0) in vec2 in_pos;

void main()
{
	gl_Position = vec4(in_pos, 0.0, 1.0);
}
// Adapted from Neon-Swarm shaders/hrc/prefilter.shd; original source comments retained.
// Prefilter for trace shader inputs.
//
// Averages each work cell's canvas-resolution footprint directly, so inputs
// need no mipmaps. Pixels count by the area they share with the cell, so
// cells that are not a whole number of pixels neither lose nor gain pixels:
//   Light:         box average up to 2x2 pixels, Gaussian-weighted beyond
//   Transmittance: area mean over a step of the cell's length
//   Bounce:        weighted like light, reprojected into the current view
// Light and transmittance average as hrc/source_average.shd describes.
//
// Emission and optical depth share one texture, which the trace samples at
// every step. Reflected light stays separate: it scales with the opacity a
// step meets even where emission does not.
//
// Drawn at work_w x work_h. Each fragment reads an S x S block of
// canvas-resolution pixels (S = canvas_dim / work_dim).

// RGB emission, A optical depth; see render_material_textures.
layout(set = 2, binding = 0) uniform sampler2D u_source;
layout(set = 2, binding = 1) uniform sampler2D u_bounce;

// RGB emission, A optical depth per canvas pixel.
layout(location = 0) out vec4 out_source;
layout(location = 1) out vec4 out_bounce;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_canvas_w;
	int u_canvas_h;
	int u_work_w;
	int u_work_h;
	float u_bounce_intensity;
	vec2 u_history_offset;
	int u_history_valid;
	vec4 u_crop_uv;
};

#include "hrc/hrc_domain.shd"
#include "hrc/source_average.shd"

vec3 bounce_sample(vec2 uv)
{
	uv += u_history_offset;
	if (u_history_valid == 0 || any(lessThan(uv, vec2(0.0))) ||
	    any(greaterThanEqual(uv, vec2(1.0)))) return vec3(0.0);
	return textureLod(u_bounce, uv, 0.0).rgb;
}

void main()
{
	ivec2 gid = ivec2(gl_FragCoord.xy);

	// Floating-point cell size (handles non-integer canvas/work ratios).
	vec2 canvas = vec2(u_canvas_w, u_canvas_h);
	vec2 cell = canvas / vec2(u_work_w, u_work_h);
	vec2 origin = vec2(gid) * cell;
	ivec2 lo = ivec2(floor(origin));
	ivec2 hi = min(ivec2(ceil(origin + cell)), ivec2(u_canvas_w, u_canvas_h));

	// Cells up to 2x2 pixels use a uniform average; larger cells use a Gaussian
	// with the Nyquist-correct sigma of half a cell.
	bool uniform_weights = all(lessThanEqual(cell, vec2(2.0)));
	vec2 center = origin + cell * 0.5;
	vec2 inv2s2 = 2.0 / (cell * cell);

	vec3 light_sum = vec3(0.0);
	vec3 bounce_sum = vec3(0.0);
	float transmittance_sum = 0.0;
	float area_sum = 0.0;
	float weight_sum = 0.0;
	for (int y = lo.y; y < hi.y; y++) {
		for (int x = lo.x; x < hi.x; x++) {
			ivec2 p = ivec2(x, y);
			vec2 pixel = vec2(p) + 0.5;
			vec2 overlap = min(vec2(p) + 1.0, origin + cell) - max(vec2(p), origin);
			float area = overlap.x * overlap.y;
			vec2 d = pixel - center;
			float w = area * (uniform_weights ? 1.0 : exp(-dot(d * d, inv2s2)));
			vec4 part = source_step(texelFetch(u_source, p, 0), cell.x);
			light_sum += part.rgb * w;
			bounce_sum += bounce_sample(pixel / canvas) * w;
			transmittance_sum += part.a * area;
			area_sum += area;
			weight_sum += w;
		}
	}
	vec2 uv = (vec2(gid) + 0.5) / vec2(u_work_w, u_work_h);
	vec4 source = source_resolve(vec4(light_sum / weight_sum, transmittance_sum / area_sum), cell.x);
	vec3 bounce = bounce_sum / weight_sum;
	out_source = vec4(source.rgb * hrc_emission_weight(uv, u_crop_uv), source.a);
	out_bounce = vec4(bounce * u_bounce_intensity, 1.0);
}
// Stylized 2D planar image mapping. HRC supplies the already-lit source.
// No recursive feedback, offscreen reconstruction, refraction or extra lights.
layout(set = 2, binding = 1) uniform sampler2D u_scene;
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec4 u_view;
    vec4 u_plane;
    vec4 u_tint;
    vec2 u_optics;
    vec2 u_pixel;
};
vec4 shader(vec4 color, ShaderParams params)
{
    vec2 world = u_view.xy + screen_uv * u_view.zw * vec2(1,-1);
    vec2 normal = vec2(-u_plane.w, u_plane.z);
    vec2 reflected = world - 2.0 * normal * dot(world-u_plane.xy,normal);
    vec2 uv = (reflected-u_view.xy) / (u_view.zw*vec2(1,-1));
    float edge = min(min(uv.x,uv.y),min(1.0-uv.x,1.0-uv.y));
    float weight = u_optics.x * smoothstep(0.0,.04,edge);
    vec3 base = texture(u_scene,screen_uv).rgb;
    vec2 spread = u_pixel*(1.0+u_optics.y*6.0);
    vec3 reflection = texture(u_scene,uv).rgb*.5;
    reflection += texture(u_scene,uv+spread).rgb*.125;
    reflection += texture(u_scene,uv-spread).rgb*.125;
    reflection += texture(u_scene,uv+vec2(spread.x,-spread.y)).rgb*.125;
    reflection += texture(u_scene,uv+vec2(-spread.x,spread.y)).rgb*.125;
    return vec4(mix(base,reflection*u_tint.rgb,weight),1);
}
// Compare geometry only. Changing illumination never invalidates a horizon.
layout(set = 2, binding = 0) uniform sampler2D u_relief;
layout(set = 2, binding = 1) uniform sampler2D u_previous;
layout(set = 3, binding = 0) uniform uniform_block
{
    ivec2 u_offset;
    int u_valid;
};
layout(location = 0) out vec4 out_dirty;
void main()
{
    ivec2 tile = ivec2(gl_FragCoord.xy);
    ivec2 size = textureSize(u_relief, 0);
    ivec2 tiles = (size + 15) / 16;
    out_dirty = vec4(1);
    if (u_valid == 0) return;
    // Reprojection changes both exposed and clipped edges of the domain.
    if (any(notEqual(u_offset, ivec2(0))) &&
        (any(equal(tile, ivec2(0))) || any(equal(tile, tiles - 1)))) return;
    for (int y = 0; y < 16; y++) {
        for (int x = 0; x < 16; x++) {
            ivec2 p = tile * 16 + ivec2(x, y);
            if (any(greaterThanEqual(p, size))) continue;
            ivec2 previous = p + u_offset;
            if (any(lessThan(previous, ivec2(0))) || any(greaterThanEqual(previous, size))) return;
            if (any(notEqual(texelFetch(u_relief, p, 0), texelFetch(u_previous, previous, 0)))) return;
        }
    }
    out_dirty = vec4(0);
}
#include "hrc/relief_sample.shd"
layout(location = 0) out vec4 out_relief;
void main()
{
    out_relief = packed_relief(ivec2(gl_FragCoord.xy));
}
// Conservative 2x height bounds, not filtered optical depth. First level reads
// relief(height, coverage, tiltXY); later levels read(maxHeight,minCover,maxCover,0).
// Allocate each output with ceil(sourceSize/2); absent odd-edge children are empty.
layout(set = 2, binding = 0) uniform sampler2D u_source;
layout(set = 3, binding = 0) uniform uniform_block
{
    vec2 u_world_per_px;
    int u_first_level;
};
layout(location = 0) out vec4 out_bounds;
void main()
{
    ivec2 origin = ivec2(gl_FragCoord.xy) * 2;
    ivec2 size = textureSize(u_source, 0);
    float height = -65504.0, minimum = 1.0, maximum = 0.0;
    for (int y = 0; y < 2; y++) {
        for (int x = 0; x < 2; x++) {
            ivec2 p = origin + ivec2(x, y);
            if (any(greaterThanEqual(p, size))) {
                minimum = 0.0;
                continue;
            }
            vec4 cell = texelFetch(u_source, p, 0);
            float lo = cell.y, hi = u_first_level != 0 ? cell.y : cell.z;
            minimum = min(minimum, lo);
            maximum = max(maximum, hi);
            if (hi < 0.5) continue;
            float bound = cell.x;
            if (u_first_level != 0) {
                // Bound the same local face plane used by the reference horizon
                // over the entire base texel, including negative world heights.
                float nz = sqrt(max(1.0 - dot(cell.zw, cell.zw), 0.0));
                if (nz > 0.05) bound += dot(abs(cell.zw), u_world_per_px) * 0.5 / nz;
            }
            height = max(height, bound);
        }
    }
    out_bounds = vec4(clamp(height, -65504.0, 65504.0), minimum, maximum, 0.0);
}
#ifdef HRC_PACK_RELIEF
layout(set = 2, binding = 2) uniform sampler2D u_albedo;
layout(set = 2, binding = 3) uniform sampler2D u_cover;
layout(set = 2, binding = 4) uniform sampler2D u_normal;
#else
layout(set = 2, binding = 0) uniform sampler2D u_albedo;
layout(set = 2, binding = 1) uniform sampler2D u_cover;
layout(set = 2, binding = 2) uniform sampler2D u_normal;
#endif
vec4 packed_relief(ivec2 p)
{
    vec4 geometry = texelFetch(u_cover, p, 0);
    if (geometry.g <= 1e-6) return vec4(0);
    float height = texelFetch(u_albedo, p, 0).a / geometry.g;
    vec2 tilt = geometry.b > geometry.g * 0.5
        ? texelFetch(u_normal, p, 0).xy / geometry.g : vec2(0);
    return vec4(height, geometry.g, tilt);
}
// Unrotates one quadrant's cascade-0 fluence into a filterable world-space
// image for gather. World pixel p holds the fluence arriving at the next probe
// along the quadrant's direction, where gather's near interval ends; probes
// past the domain receive nothing.

#include "hrc/hrc_pass.shd"

layout(set = 2, binding = 0) uniform sampler2D u_frustum;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_rotate;
	int u_work_w;
	int u_work_h;
};

// Fluence arriving at rotated probe rp; probes past the domain receive none.
vec3 probe_fluence(ivec2 rp, int rot_w, int rot_h)
{
	if (rp.x >= rot_w) return vec3(0.0);
	ivec2 texel = ivec2(hrc_parity_slot(rp.x, rot_w), clamp(rp.y, 0, rot_h - 1));
	return texelFetch(u_frustum, (u_rotate & 1) != 0 ? texel.yx : texel, 0).rgb;
}

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	int rot_w = (u_rotate & 1) != 0 ? u_work_h : u_work_w;
	int rot_h = (u_rotate & 1) != 0 ? u_work_w : u_work_h;
	ivec2 rp;
	if (u_rotate == 1)      rp = ivec2(p.y, u_work_w - 1 - p.x);
	else if (u_rotate == 2) rp = ivec2(u_work_w - 1 - p.x, u_work_h - 1 - p.y);
	else if (u_rotate == 3) rp = ivec2(u_work_h - 1 - p.y, p.x);
	else                    rp = p;
	rp.x += 1;
	// Even and odd probes merge differently, which leaves a checkerboard at
	// the probe grid's highest frequency. A 1-2-1 tent removes exactly it.
	vec3 fluence = vec3(0.0);
	for (int dy = -1; dy <= 1; dy++) {
		for (int dx = -1; dx <= 1; dx++) {
			float weight = float((2 - abs(dx)) * (2 - abs(dy)));
			fluence += weight * probe_fluence(rp + ivec2(dx, dy), rot_w, rot_h);
		}
	}
	out_value = vec4(fluence / 16.0, 1.0);
}
// Unrotates the luminance hierarchy's cascade-0 fluence into one filterable
// world-space image: channel r holds the luminance arriving from quadrant r
// (+x, +y, -x, -y). As in resolve.shd, world pixel p holds the fluence
// arriving at the next probe along each direction. u_pair0 holds quadrants 0
// and 2, u_pair1 quadrants 1 and 3, transposed; see hrc_common.shd.

#include "hrc/hrc_pass.shd"

layout(set = 2, binding = 0) uniform sampler2D u_pair0;
layout(set = 2, binding = 1) uniform sampler2D u_pair1;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_work_w;
	int u_work_h;
};

ivec2 world_to_rotated(ivec2 p, int rot)
{
	if (rot == 1) return ivec2(p.y, u_work_w - 1 - p.x);
	if (rot == 2) return ivec2(u_work_w - 1 - p.x, u_work_h - 1 - p.y);
	if (rot == 3) return ivec2(u_work_h - 1 - p.y, p.x);
	return p;
}

// Luminance arriving at a rotated probe; probes past the domain receive none.
float probe_luminance(int rot, ivec2 rp, int rot_w, int rot_h)
{
	if (rp.x >= rot_w) return 0.0;
	ivec2 texel = ivec2(hrc_parity_slot(rp.x, rot_w), clamp(rp.y, 0, rot_h - 1));
	vec2 pair = (rot & 1) != 0 ? texelFetch(u_pair1, texel.yx, 0).xy : texelFetch(u_pair0, texel, 0).xy;
	return pair[rot >> 1];
}

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	vec4 luminance = vec4(0.0);
	for (int rot = 0; rot < 4; rot++) {
		int rot_w = (rot & 1) != 0 ? u_work_h : u_work_w;
		int rot_h = (rot & 1) != 0 ? u_work_w : u_work_h;
		ivec2 rp = world_to_rotated(p, rot) + ivec2(1, 0);
		// The 1-2-1 tent of resolve.frag, against the probe checkerboard.
		for (int dy = -1; dy <= 1; dy++) {
			for (int dx = -1; dx <= 1; dx++) {
				float weight = float((2 - abs(dx)) * (2 - abs(dy)));
				luminance[rot] += weight * probe_luminance(rot, rp + ivec2(dx, dy), rot_w, rot_h);
			}
		}
		luminance[rot] /= 16.0;
	}
	out_value = luminance;
}
// Transport sources: RGB emission density λ, light per canvas pixel of path,
// and A optical depth τ per canvas pixel. A step of length L emits
// λ (1 - exp(-τ L)) / τ: λ L through clear cells, and λ / τ through opaque
// ones, whose radiance is therefore λ / τ. The law is continuous in τ, so
// faint absorbers such as thin gas or exhaust never switch between emitting
// by density and by radiance as they move.
//
// A cell's light and transmittance are the means of its parts' over one step
// of the cell's length, so both follow coverage linearly. Averaging optical
// depth instead turns a half-covered opaque cell nearly opaque and dims its
// light, by amounts that change as edges cross cells, so moving bodies flicker.

// The path length a step of length s emits for, after its own absorption.
float source_length(float tau, float s)
{
	float x = max(tau, 0.0) * s;
	return x > 1e-3 ? (1.0 - exp(-x)) / max(tau, 1e-20) : s * (1.0 - 0.5 * x);
}

// A source's light over a step of length s, and the step's transmittance.
vec4 source_step(vec4 source, float s)
{
	return vec4(source.rgb * source_length(source.a, s), exp(-max(source.a, 0.0) * s));
}

// The source whose step of length s gives a mean step's light and
// transmittance.
vec4 source_resolve(vec4 part, float s)
{
	float tau = -log(max(part.a, 1e-6)) / s;
	return vec4(part.rgb / source_length(tau, s), tau);
}
// Separable Gaussian blur of the four RGB surface seeds along one axis.
// Edges repeat their nearest texel.

layout(set = 2, binding = 0) uniform sampler2D u_q0;
layout(set = 2, binding = 1) uniform sampler2D u_q1;
layout(set = 2, binding = 2) uniform sampler2D u_q2;
layout(set = 2, binding = 3) uniform sampler2D u_q3;

layout(location = 0) out vec4 out_q0;
layout(location = 1) out vec4 out_q1;
layout(location = 2) out vec4 out_q2;
layout(location = 3) out vec4 out_q3;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_width;
	int u_height;
	int u_vertical;
	float u_sigma;
};

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	ivec2 axis = u_vertical != 0 ? ivec2(0, 1) : ivec2(1, 0);
	ivec2 last = ivec2(u_width - 1, u_height - 1);
	int radius = int(ceil(u_sigma * 3.0));
	float falloff = -0.5 / (u_sigma * u_sigma);
	vec4 q0 = vec4(0), q1 = vec4(0), q2 = vec4(0), q3 = vec4(0);
	float total = 0.0;
	for (int i = -radius; i <= radius; i++) {
		float weight = exp(float(i * i) * falloff);
		ivec2 q = clamp(p + axis * i, ivec2(0), last);
		q0 += texelFetch(u_q0, q, 0) * weight;
		q1 += texelFetch(u_q1, q, 0) * weight;
		q2 += texelFetch(u_q2, q, 0) * weight;
		q3 += texelFetch(u_q3, q, 0) * weight;
		total += weight;
	}
	out_q0 = q0 / total;
	out_q1 = q1 / total;
	out_q2 = q2 / total;
	out_q3 = q3 / total;
}
// Finite depth slabs with area-filtered emission. Aligned source tiles
// partition energy; bounded child estimates keep distinct sources separate.
layout(set = 2, binding = 0) uniform sampler2D u_albedo;
layout(set = 2, binding = 1) uniform sampler2D u_cover;
layout(set = 2, binding = 2) uniform sampler2D u_normal;
layout(set = 2, binding = 3) uniform sampler2D u_emission0;
layout(set = 2, binding = 4) uniform sampler2D u_emitter0;
layout(set = 2, binding = 5) uniform sampler2D u_emission1;
layout(set = 2, binding = 6) uniform sampler2D u_emitter1;
layout(set = 2, binding = 7) uniform sampler2D u_emission2;
layout(set = 2, binding = 8) uniform sampler2D u_emitter2;
layout(set = 2, binding = 9) uniform sampler2D u_emission3;
layout(set = 2, binding = 10) uniform sampler2D u_emitter3;
layout(set = 2, binding = 11) uniform sampler2D u_emission4;
layout(set = 2, binding = 12) uniform sampler2D u_emitter4;
layout(set = 2, binding = 13) uniform sampler2D u_emission5;
layout(set = 2, binding = 14) uniform sampler2D u_emitter5;
layout(set = 2, binding = 15) uniform sampler2D u_source;
layout(location = 0) out vec4 out_q0;
layout(location = 1) out vec4 out_q1;
layout(location = 2) out vec4 out_q2;
layout(location = 3) out vec4 out_q3;
layout(set = 3, binding = 0) uniform uniform_block
{
    vec2 u_world_per_px;
    vec4 u_projection;
    float u_radius;
    float u_thickness;
    float u_specular;
    int u_block;
    int u_base_block;
    int u_source_axis;
    int u_near_detail;
    float u_shadow_softness;
    int u_visibility_mode;
    int u_independent_emitters;
};
#include "hrc/brdf.shd"

const float PI = 3.141592653589793;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

bool inside(vec2 uv)
{
    return all(greaterThanEqual(uv, vec2(0))) && all(lessThan(uv, vec2(1)));
}
ivec2 pixel_at(vec2 uv)
{
    ivec2 size = textureSize(u_cover, 0);
    return clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
}
float projection_scale(float height)
{
    return u_projection.z > 0.0 ? max(1.0 - height / u_projection.z, 0.001) : 1.0;
}
vec3 position_at(vec2 uv, float height)
{
    vec2 pixel = uv * vec2(textureSize(u_cover, 0));
    vec2 plane = vec2(u_projection.x + pixel.x * u_world_per_px.x,
                      u_projection.y - pixel.y * u_world_per_px.y);
    // Invert x' = x*focal/(focal-height), with the camera at (0,0,focal).
    return vec3(plane * projection_scale(height), height);
}
vec2 geometry_at(vec2 uv)
{
    ivec2 p = pixel_at(uv);
    float cover = texelFetch(u_cover, p, 0).g;
    float height = cover > 1e-6 ? texelFetch(u_albedo, p, 0).a / cover : 0.0;
    return vec2(height, cover);
}
uint slab_mask(float lower, float upper)
{
    // Mark a sector only when its centre is inside the slab. Expanding every
    // touched bin falsely blocks rays grazing above or below a thin surface.
    float scale = 32.0 / PI;
    int first = max(int(ceil((min(lower, upper) + 0.5 * PI) * scale - 0.5)), 0);
    int last = min(int(floor((max(lower, upper) + 0.5 * PI) * scale - 0.5)), 31);
    if (first > last) return 0u;
    return (0xffffffffu << uint(first)) & (0xffffffffu >> uint(31 - last));
}
vec4 emission_at(int level, ivec2 p)
{
    if (level == 0) return texelFetch(u_emission0, p, 0);
    if (level == 1) return texelFetch(u_emission1, p, 0);
    if (level == 2) return texelFetch(u_emission2, p, 0);
    if (level == 3) return texelFetch(u_emission3, p, 0);
    if (level == 4) return texelFetch(u_emission4, p, 0);
    return texelFetch(u_emission5, p, 0);
}
vec4 emitter_at(int level, ivec2 p)
{
    if (level == 0) return texelFetch(u_emitter0, p, 0);
    if (level == 1) return texelFetch(u_emitter1, p, 0);
    if (level == 2) return texelFetch(u_emitter2, p, 0);
    if (level == 3) return texelFetch(u_emitter3, p, 0);
    if (level == 4) return texelFetch(u_emitter4, p, 0);
    return texelFetch(u_emitter5, p, 0);
}

vec3 receiver_origin;
vec3 receiver_normal;
float receiver_gloss;
float pixel_world;
float soft_distance;
float receiver_scale;
vec3 diffuse = vec3(0);
vec3 specular = vec3(0);
vec2 dominant = vec2(0);
float energy = 0.0;
vec2 receiver_uv;
float radial_step;
uint slab_prefix[96];
float sampling_rotation;
float tile_visibility;

float mask_visibility(uint mask, float elevation)
{
    int bin = clamp(int(floor(elevation + 0.5)), 0, 31);
    float hard = (mask & (1u << uint(bin))) == 0u ? 1.0 : 0.0;
    if (u_shadow_softness <= 0.0) return hard;
    int lower = clamp(int(floor(elevation)), 0, 31);
    int upper = clamp(int(floor(elevation)) + 1, 0, 31);
    float a = (mask & (1u << uint(lower))) == 0u ? 1.0 : 0.0;
    float b = (mask & (1u << uint(upper))) == 0u ? 1.0 : 0.0;
    return mix(hard, mix(a, b, fract(elevation)), u_shadow_softness);
}

float ray_visibility(int ray, float radial, float elevation)
{
    ray = int(mod(float(ray), 8.0));
    int previous = int(ceil(radial)) - 1;
    uint mask = previous >= 0 ? slab_prefix[ray * 12 + min(previous, 11)] : 0u;
    float hard = mask_visibility(mask, elevation);
    if (u_shadow_softness <= 0.0) return hard;
    int a = int(floor(radial - 0.5));
    int b = a + 1;
    uint lower = a >= 0 ? slab_prefix[ray * 12 + min(a, 11)] : 0u;
    uint upper = b >= 0 ? slab_prefix[ray * 12 + min(b, 11)] : 0u;
    float filtered = mix(mask_visibility(lower, elevation), mask_visibility(upper, elevation), fract(radial - 0.5));
    return mix(hard, filtered, u_shadow_softness);
}

float source_visibility(vec3 delta, float distance, float azimuth)
{
    float radial = max(distance - pixel_world, 0.0) / radial_step - 0.5;
    float elevation = (atan(delta.z, max(length(delta.xy), 1e-6)) + 0.5 * PI) * (32.0 / PI) - 0.5;
    float hard = ray_visibility(int(floor(azimuth + 0.5)), radial, elevation);
    if (u_shadow_softness <= 0.0) return hard;
    int ray = int(floor(azimuth));
    float filtered = mix(ray_visibility(ray, radial, elevation),
                         ray_visibility(ray + 1, radial, elevation), fract(azimuth));
    return mix(hard, filtered, u_shadow_softness);
}

// A single source-tile query is shared by all its refined energy estimates.
// The walk covers the complete segment with a fixed quality budget. When the
// footprint exceeds that budget this is explicit undersampling, never an
// unfinished walk declared clear. Screen-space slabs cannot see hidden layers.
float segment_visibility(vec4 emitter, float source_radius)
{
    vec2 size = vec2(textureSize(u_cover, 0));
    vec2 pixels = (emitter.xy - receiver_uv) * size;
    float extent = max(abs(pixels.x), abs(pixels.y));
    int budget = u_source_axis <= 4 ? 32 : (u_source_axis <= 6 ? 48 : 64);
    int steps = min(max(int(ceil(extent)), 1), budget);
    // Proxy sources radiate from a finite volume. Stop at that volume's
    // boundary so an opaque emitter's own front slab cannot eclipse its centre.
    // The radius belongs to the source, not its coarse tile or depth variance.
    float end = 1.0;
    if (source_radius > 0.0) {
        float distance = length(position_at(emitter.xy, emitter.z) - receiver_origin);
        end = max(1.0 - source_radius / max(distance, 1e-6), 0.0);
        if (u_projection.z > 0.0) {
            float d0 = max(u_projection.z - receiver_origin.z, 0.001);
            float d1 = max(u_projection.z - emitter.z, 0.001);
            end = end * d1 / max(mix(d0, d1, end), 0.001);
        }
    }
    float visible = 1.0;
    for (int i = 0; i < 64; i++) {
        if (i >= steps) break;
        float t = (float(i) + 0.5) / float(steps);
        if (t >= end) break;
        // Avoid testing the receiver and emitter's own rasterized footprint.
        if (t * extent < 1.0 || (1.0 - t) * extent < 1.0) continue;
        vec2 uv = mix(receiver_uv, emitter.xy, t);
        if (!inside(uv)) continue;
        vec2 obstacle = geometry_at(uv);
        if (obstacle.y <= 0.5 || texelFetch(u_source, pixel_at(uv), 0).a <= 0.01) continue;
        float height = mix(receiver_origin.z, emitter.z, t);
        if (u_projection.z > 0.0) {
            float q0 = 1.0 / max(u_projection.z - receiver_origin.z, 0.001);
            float q1 = 1.0 / max(u_projection.z - emitter.z, 0.001);
            height = u_projection.z - 1.0 / mix(q0, q1, t);
        }
        float bias = max(pixel_world * 0.05, 0.001);
        float interior = min(obstacle.x - height, height - (obstacle.x - u_thickness));
        float hard = interior > bias ? 0.0 : 1.0;
        float soft = 1.0 - smoothstep(bias, bias + pixel_world, interior);
        visible = min(visible, mix(hard, soft, u_shadow_softness));
        if (visible <= 0.0) break;
    }
    return visible;
}

void receive(vec3 emission, vec4 emitter, float area)
{
    vec3 delta = position_at(emitter.xy, emitter.z) - receiver_origin;
    float distance2 = dot(delta, delta);
    if (distance2 <= pixel_world * pixel_world * 0.0625) return;
    vec3 direction = delta * inversesqrt(max(distance2, 1e-12));
    float scale = projection_scale(emitter.z) / receiver_scale;
    float weight = min(0.25, area * scale * scale /
        (PI * max(distance2 + soft_distance * soft_distance, 1e-6)));
    float projected_distance = length((emitter.xy - receiver_uv) *
        vec2(textureSize(u_cover, 0)) * u_world_per_px) * receiver_scale;
    vec2 toward = (emitter.xy - receiver_uv) * vec2(textureSize(u_cover, 0)) * u_world_per_px;
    float azimuth = atan(-toward.y, toward.x) * (8.0 / (2.0 * PI)) - sampling_rotation;
    // Keep the cutoff wider than source-position quantization at small radii.
    float taper = min(u_radius, max(u_radius * 0.15, pixel_world * 2.0));
    float falloff = 1.0 - smoothstep(u_radius - taper, u_radius, projected_distance);
    float visibility = (u_visibility_mode == 1 ? tile_visibility
        : source_visibility(delta, projected_distance, azimuth)) * falloff;
    if (visibility <= 0.0) return;
    vec3 received = emission * weight * visibility;
    diffuse += received * max(dot(receiver_normal, direction), 0.0);
    if (receiver_gloss > 0.0) {
        specular += received * PI * highlight(receiver_normal, direction, 1.0 - receiver_gloss);
    }
    float power = dot(received, LUMA);
    dominant += direction.xy * power;
    energy += power;
}

// At the finest level, a source crossing the radius taper must not move
// all its energy by one texel when its brightest pixel changes. Integrate the
// actual covered pixels in that small cell; fractional coverage stays smooth.
void source_pixels(ivec2 cell, float area, float fraction)
{
    ivec2 size = textureSize(u_cover, 0);
    for (int y = 0; y < u_base_block; y++) {
        for (int x = 0; x < u_base_block; x++) {
            ivec2 p = cell * u_base_block + ivec2(x, y);
            if (any(greaterThanEqual(p, size))) continue;
            vec2 cover = texelFetch(u_cover, p, 0).rg;
            vec3 light = max(texelFetch(u_source, p, 0).rgb, vec3(0)) * max(cover.r, 0.0);
            if (dot(light, LUMA) <= 0.0) continue;
            float height = cover.g > 1e-6 ? texelFetch(u_albedo, p, 0).a / cover.g : 0.0;
            receive(light * fraction, vec4((vec2(p) + 0.5) / vec2(size), height, 0), area);
        }
    }
}

// Evaluate leaf pixels explicitly, so tiny sources retain their position and
// integrated power even when several fit into the first pyramid cell.
void source_value(int level, ivec2 p, float area, float fraction)
{
    if (fraction <= 0.0) return;
    int block = u_base_block << level;
    ivec2 size = (textureSize(u_cover, 0) + block - 1) / block;
    if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, size))) return;
    vec4 light = emission_at(level, p);
    if (light.a <= 0.0) return;
    if (level == 0 && u_independent_emitters == 0) {
        // The fractional estimate weight must be applied to emission, outside
        // receive's area clamp, so blending estimates never changes energy.
        source_pixels(p, area / float(block * block), fraction);
        return;
    }
    receive(light.rgb * fraction / light.a, emitter_at(level, p), area * light.a);
}

void source_children(int level, ivec2 p, float area, float fraction)
{
    if (fraction <= 0.0) return;
    if (level == 0) {
        source_value(level, p, area, fraction);
        return;
    }
    for (int y = 0; y < 2; y++) {
        for (int x = 0; x < 2; x++) {
            source_value(level - 1, p * 2 + ivec2(x, y), area * 0.25, fraction);
        }
    }
}

void source_estimate(int level, ivec2 p, float area, float fraction)
{
    if (fraction <= 0.0) return;
    int block = u_base_block << level;
    ivec2 size = (textureSize(u_cover, 0) + block - 1) / block;
    if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, size))) return;
    vec4 light = emission_at(level, p);
    if (light.a <= 0.0) return;
    if (level == 0) {
        source_value(level, p, area, fraction);
        return;
    }
    vec4 emitter = emitter_at(level, p);
    float distance = length(position_at(emitter.xy, emitter.z) - receiver_origin);
    float extent = float(block) * pixel_world * 1.4142135624;
    float depth_scale = max(u_thickness, pixel_world * 4.0);
    float depth_detail = u_independent_emitters != 0 ? 0.0
        : smoothstep(depth_scale * 0.5, depth_scale * 1.5, emitter.w);
    float power = max(dot(light.rgb, LUMA), 1e-12);
    vec3 chroma = light.rgb / power;
    float variation = 0.0;
    ivec2 child_size = (textureSize(u_cover, 0) + block / 2 - 1) / (block / 2);
    for (int y = 0; y < 2; y++) {
        for (int x = 0; x < 2; x++) {
            ivec2 child = p * 2 + ivec2(x, y);
            if (any(greaterThanEqual(child, child_size))) continue;
            vec3 rgb = emission_at(level - 1, child).rgb;
            float child_power = dot(rgb, LUMA);
            variation += length(rgb - chroma * child_power) / (4.0 * power);
        }
    }
    float angular_detail = smoothstep(0.15, 0.7, extent / max(distance, pixel_world));
    float color_detail = smoothstep(0.15, 0.8, variation) * angular_detail;
    float detail = max(depth_detail, color_detail);
    if (u_near_detail != 0) detail = max(detail, angular_detail);
    source_value(level, p, area, fraction * (1.0 - detail));
    source_children(level, p, area, fraction * detail);
}

void source_cell(int level, ivec2 p, float area, float lod_blend)
{
    source_estimate(level, p, area, 1.0 - lod_blend);
    if (level == 0 || lod_blend <= 0.0) return;
    // Blend complete estimates, including their refinement. At the boundary
    // both sides evaluate exactly the same child cells and preserve energy.
    for (int y = 0; y < 2; y++) {
        for (int x = 0; x < 2; x++) {
            source_estimate(level - 1, p * 2 + ivec2(x, y), area * 0.25, lod_blend);
        }
    }
}

void gather_sources(vec2 uv)
{
    vec2 size = vec2(textureSize(u_cover, 0));
    vec2 radius = u_radius / (u_world_per_px * receiver_scale);
    vec2 lower = max(uv * size - radius, vec2(0));
    vec2 upper = min(uv * size + radius, size);
    // Use the unclipped footprint for LOD. Passing a viewport edge must not
    // change the representation of every light still inside the viewport.
    float extent = min(max(radius.x, radius.y) * 2.0, max(size.x, size.y));
    // Segment visibility belongs to a tile, including all its child estimates.
    // Fix that tile grouping to the canvas so receiver height/radius cannot
    // switch the shared visibility at an integer LOD boundary. Several lights
    // in the same tile still share one representative visibility estimate.
    if (u_visibility_mode == 1) extent = max(size.x, size.y);
    float lod = max(log2(max(extent / float(u_base_block * u_source_axis), 1.0)), 0.0);
    int level = min(int(ceil(lod)), 5);
    int block = u_base_block << level;
    float blend = level > 0 ? 1.0 - smoothstep(float(level - 1), float(level), lod) : 0.0;
    ivec2 first = ivec2(floor(lower / float(block)));
    ivec2 last = ivec2(ceil(upper / float(block))) - 1;
    float area = float(block * block) * u_world_per_px.x * u_world_per_px.y * receiver_scale * receiver_scale;
    // At most (axis + 1)^2 tiles; each has a fixed refinement limit. More
    // emitters add source raster work but never lengthen this gather's loops.
    for (int y = 0; y < 9; y++) {
        for (int x = 0; x < 9; x++) {
            ivec2 p = first + ivec2(x, y);
            if (any(greaterThan(p, last))) continue;
            if (u_visibility_mode == 1) {
                vec4 light = emission_at(level, p);
                if (light.a <= 0.0) continue;
                vec4 emitter = emitter_at(level, p);
                tile_visibility = segment_visibility(emitter,
                    u_independent_emitters != 0 ? emitter.w : 0.0);
            }
            source_cell(level, p, area, blend);
        }
    }
}

void main()
{
    ivec2 size = textureSize(u_cover, 0);
    vec2 requested = gl_FragCoord.xy * float(u_block) / vec2(size);
    ivec2 receiver_pixel = pixel_at(requested);
    // Use an actual surface texel for receiver geometry; no depth averaging.
    vec2 uv = (vec2(receiver_pixel) + 0.5) / vec2(size);
    vec2 receiver = geometry_at(uv);
    float valid = receiver.y > 0.5 ? 1.0 : 0.0;
    vec2 tilt = valid > 0.5 ? texelFetch(u_normal, receiver_pixel, 0).xy / receiver.y : vec2(0);
    vec3 normal = normalize(vec3(tilt, sqrt(max(1.0 - dot(tilt, tilt), 0.0))));
    if (valid < 0.5 || u_radius <= 0.0) {
        out_q0 = vec4(0, 0, 0, receiver.x);
        out_q1 = vec4(0, 0, 0, 1);
        out_q2 = vec4(normal, 0);
        out_q3 = vec4(0, 0, 1, 1);
        return;
    }
    receiver_origin = position_at(uv, receiver.x);
    receiver_normal = normal;
    receiver_gloss = u_specular > 0.0
        ? clamp(texelFetch(u_normal, receiver_pixel, 0).w / receiver.y, 0.0, 1.0) : 0.0;
    receiver_scale = projection_scale(receiver.x);
    radial_step = u_radius / 12.0;
    receiver_uv = uv;
    pixel_world = max(u_world_per_px.x, u_world_per_px.y) * receiver_scale;
    soft_distance = max(pixel_world, max(u_thickness, 0.0) * 0.25);
    float blocked = 0.0;
    // Stable interleaved rotation distributes directions across neighboring
    // receivers; spatial reconstruction combines them without temporal trails.
    sampling_rotation = fract(52.9829189 * fract(dot(floor(gl_FragCoord.xy), vec2(0.06711056, 0.00583715))));
    for (int azimuth = 0; azimuth < 8; azimuth++) {
        if (u_visibility_mode == 1) break;
        float angle = (float(azimuth) + sampling_rotation) * (2.0 * PI / 8.0);
        vec2 axis = vec2(cos(angle), sin(angle));
        vec2 screen_axis = vec2(axis.x, -axis.y);
        uint mask = 0u;
        // Build radial prefix visibility first. A filtered footprint may find a
        // source nearer or farther than its centre, so use its actual distance.
        for (int radial = 0; radial < 12; radial++) {
            float radius = (float(radial) + 0.5) * radial_step;
            vec2 center = uv + screen_axis * radius / (u_world_per_px * vec2(size) * receiver_scale);
            if (inside(center)) {
                vec2 obstacle = geometry_at(center);
                if (obstacle.y > 0.5 && u_thickness > 0.0 &&
                    texelFetch(u_source, pixel_at(center), 0).a > 0.01) {
                    vec3 top = position_at(center, obstacle.x) - receiver_origin;
                    vec3 bottom = position_at(center, obstacle.x - u_thickness) - receiver_origin;
                    float upper = atan(top.z, max(length(top.xy), 1e-6));
                    float lower = atan(bottom.z, max(length(bottom.xy), 1e-6));
                    mask |= slab_mask(lower, upper);
                }
            }
            slab_prefix[azimuth * 12 + radial] = mask;
        }
        for (int bit = 16; bit < 32; bit++) {
            if ((mask & (1u << uint(bit))) != 0u) blocked += 1.0;
        }
    }
    gather_sources(uv);
    // Area weights integrate emission; do not renormalize by accepted samples.
    out_q0 = vec4(min(diffuse, vec3(65504)), receiver.x);
    out_q1 = vec4(min(specular, vec3(65504)), receiver_gloss);
    out_q2 = vec4(normal, valid);
    out_q3 = vec4(dominant / max(energy, 1e-8), 1.0 - blocked / 128.0, 1);
}
// Denoise the interleaved gather on its receiver grid. Keep each receiver's
// height and normal intact so reconstruction can still reject object edges.
layout(set = 2, binding = 0) uniform sampler2D u_q0;
layout(set = 2, binding = 1) uniform sampler2D u_q1;
layout(set = 2, binding = 2) uniform sampler2D u_q2;
layout(set = 2, binding = 3) uniform sampler2D u_q3;
layout(location = 0) out vec4 out_q0;
layout(location = 1) out vec4 out_q1;
layout(location = 2) out vec4 out_q2;
layout(location = 3) out vec4 out_q3;
layout(set = 3, binding = 0) uniform uniform_block
{
    float u_sigma;
    float u_shadow_softness;
    vec4 u_projection;
    vec2 u_world_per_px;
    vec2 u_canvas_size;
};

#include "hrc/surface_geometry.shd"

void main()
{
    ivec2 size = textureSize(u_q0, 0);
    ivec2 center = ivec2(gl_FragCoord.xy);
    vec4 receiver = texelFetch(u_q0, center, 0);
    vec4 geometry = texelFetch(u_q2, center, 0);
    out_q0 = receiver;
    vec4 material = texelFetch(u_q1, center, 0);
    out_q1 = material;
    out_q2 = geometry;
    out_q3 = texelFetch(u_q3, center, 0);
    if (geometry.a < 0.5) return;

    vec3 diffuse_sum = vec3(0), specular_sum = vec3(0);
    float total = 0.0, specular_total = 0.0;
    float sigma = max(u_sigma * 0.5, 0.001);
    vec3 origin = surface_position(surface_receiver_pixel(center, u_canvas_size, u_projection.w),
                                   receiver.a, u_projection, u_world_per_px);
    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            ivec2 p = center + ivec2(x, y);
            if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, size))) continue;
            float spatial = max(1.0 - float(x * x + y * y) / 6.25, 0.0);
            if (spatial <= 0.0) continue;
            vec4 neighbor = texelFetch(u_q2, p, 0);
            if (neighbor.a < 0.5) continue;
            float agreement = dot(geometry.xyz, neighbor.xyz);
            if (agreement < 0.9) continue;
            vec4 diffuse = texelFetch(u_q0, p, 0);
            vec3 position = surface_position(surface_receiver_pixel(p, u_canvas_size, u_projection.w),
                                             diffuse.a, u_projection, u_world_per_px);
            float dz = surface_plane_distance(position - origin, geometry.xyz, neighbor.xyz) / sigma;
            if (abs(dz) > 1.0) continue;
            float weight = spatial * spatial * pow(agreement, 8.0) * exp(-dz * dz);
            float boundary = smoothstep(0.9, 1.0, agreement) * (1.0 - smoothstep(0.6, 1.0, abs(dz)));
            weight *= mix(1.0, boundary, u_shadow_softness);
            diffuse_sum += max(diffuse.rgb, vec3(0)) * weight;
            vec4 specular = texelFetch(u_q1, p, 0);
            float specular_weight = weight * max(1.0 - abs(material.a - specular.a) * 10.0, 0.0);
            specular_sum += max(specular.rgb, vec3(0)) * specular_weight;
            specular_total += specular_weight;
            total += weight;
        }
    }
    // The valid center always contributes. Zero radiance remains a sample,
    // retaining its weight rather than renormalizing only the lit neighbors.
    out_q0.rgb = diffuse_sum / total;
    out_q1.rgb = specular_sum / max(specular_total, 1e-6);
}
// Optional short Depth history. Geometry stays current; only light is blended.
layout(set = 2, binding = 0) uniform sampler2D u_q0;
layout(set = 2, binding = 1) uniform sampler2D u_q1;
layout(set = 2, binding = 2) uniform sampler2D u_q2;
layout(set = 2, binding = 3) uniform sampler2D u_q3;
layout(set = 2, binding = 4) uniform sampler2D u_prev0;
layout(set = 2, binding = 5) uniform sampler2D u_prev1;
layout(set = 2, binding = 6) uniform sampler2D u_prev2;
layout(set = 2, binding = 7) uniform sampler2D u_prev3;
layout(location = 0) out vec4 out_q0;
layout(location = 1) out vec4 out_q1;
layout(location = 2) out vec4 out_q2;
layout(location = 3) out vec4 out_q3;
layout(set = 3, binding = 0) uniform uniform_block
{
    vec4 u_transform0;
    vec4 u_transform1;
    vec4 u_transform2;
    vec4 u_projection;
    vec4 u_previous_projection;
    vec2 u_focal;
    vec2 u_raster;
    float u_sigma;
    float u_history;
    int u_block;
    int u_valid;
};

vec3 transform_direction(vec3 n)
{
    return vec3(dot(u_transform0.xyz, n), dot(u_transform1.xyz, n), dot(u_transform2.xyz, n));
}
float history_weight(vec3 current, vec3 previous)
{
    float scale = max(max(length(current), length(previous)), 0.001);
    float difference = length(previous - current) / scale;
    // Strong emitter changes and newly dark pixels replace history immediately.
    return u_history * (1.0 - smoothstep(0.2, 0.7, difference));
}
void main()
{
    ivec2 p = ivec2(gl_FragCoord.xy);
    vec4 current = texelFetch(u_q0, p, 0);
    vec4 material = texelFetch(u_q1, p, 0);
    vec4 geometry = texelFetch(u_q2, p, 0);
    out_q0 = current;
    out_q1 = material;
    out_q2 = geometry;
    out_q3 = texelFetch(u_q3, p, 0);
    if (u_valid == 0 || geometry.a < 0.5 || u_history <= 0.0) return;

    // Match gather's actual receiver texel rather than the padded grid extent.
    vec2 pixel = floor(gl_FragCoord.xy * float(u_block)) + 0.5;
    vec2 uv = pixel / u_raster;
    vec2 plane = vec2(u_projection.x + uv.x * u_projection.z,
                      u_projection.y - uv.y * u_projection.w);
    float scale = u_focal.x > 0.0 ? max(1.0 - current.a / u_focal.x, 0.001) : 1.0;
    vec4 point = vec4(plane * scale, current.a, 1);
    vec3 prior_point = vec3(dot(u_transform0, point), dot(u_transform1, point), dot(u_transform2, point));
    float old_scale = u_focal.y > 0.0 ? 1.0 - prior_point.z / u_focal.y : 1.0;
    if (old_scale <= 0.001) return;
    vec2 old_plane = prior_point.xy / old_scale;
    vec2 old_uv = vec2((old_plane.x - u_previous_projection.x) / u_previous_projection.z,
                       (u_previous_projection.y - old_plane.y) / u_previous_projection.w);
    if (any(lessThan(old_uv, vec2(0))) || any(greaterThanEqual(old_uv, vec2(1)))) return;
    ivec2 old_p = ivec2(old_uv * u_raster / float(u_block));
    ivec2 size = textureSize(u_q0, 0);
    if (any(greaterThanEqual(old_p, size))) return;
    vec4 old_geometry = texelFetch(u_prev2, old_p, 0);
    if (old_geometry.a < 0.5 || dot(normalize(transform_direction(geometry.xyz)), old_geometry.xyz) < 0.95) return;
    vec4 previous = texelFetch(u_prev0, old_p, 0);
    // Small depth tolerance rejects disocclusion and changing geometry.
    if (abs(previous.a - prior_point.z) > max(u_sigma * 0.5, 0.001)) return;
    vec4 old_material = texelFetch(u_prev1, old_p, 0);
    if (abs(material.a - old_material.a) > 0.08) return;

    vec3 lo = current.rgb, hi = current.rgb;
    vec3 spec_lo = material.rgb, spec_hi = material.rgb;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 q = p + ivec2(x, y);
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
            vec4 n = texelFetch(u_q2, q, 0);
            vec4 d = texelFetch(u_q0, q, 0);
            if (n.a < 0.5 || dot(n.xyz, geometry.xyz) < 0.95 || abs(d.a - current.a) > u_sigma * 0.5) continue;
            lo = min(lo, d.rgb);
            hi = max(hi, d.rgb);
            vec4 s = texelFetch(u_q1, q, 0);
            if (abs(material.a - s.a) > 0.08) continue;
            spec_lo = min(spec_lo, s.rgb);
            spec_hi = max(spec_hi, s.rgb);
        }
    }
    float diffuse_weight = history_weight(current.rgb, previous.rgb);
    float specular_weight = history_weight(material.rgb, old_material.rgb);
    out_q0.rgb = mix(current.rgb, clamp(previous.rgb, lo, hi), diffuse_weight);
    out_q1.rgb = mix(material.rgb, clamp(old_material.rgb, spec_lo, spec_hi), specular_weight);
}
// Area-average emission and its energy-weighted position/depth variance.
// Child refinement separates sources; a brightness tie never moves all RGB
// to a different source. Non-emitting geometry contributes no moments.
#include "hrc/emitter_encoding.shd"
layout(set = 2, binding = 0) uniform sampler2D u_source;
layout(set = 2, binding = 1) uniform sampler2D u_geometry;
layout(set = 2, binding = 2) uniform sampler2D u_cover;
layout(set = 3, binding = 0) uniform uniform_block
{
    int u_first_level;
    int u_base_block;
};
layout(location = 0) out vec4 out_light;
layout(location = 1) out vec4 out_geometry;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
void main()
{
    int block = u_first_level == 1 || u_first_level == 2 ? u_base_block : 2;
    bool proxies = u_first_level == 2 || u_first_level == 3;
    ivec2 origin = ivec2(gl_FragCoord.xy) * block;
    ivec2 size = textureSize(u_source, 0);
    vec3 sum = vec3(0);
    float coverage = 0.0;
    vec4 representative = vec4(0);
    float mass = 0.0, depth_moment = 0.0, radius_moment = 0.0;
    for (int y = 0; y < block; y++) {
        for (int x = 0; x < block; x++) {
            ivec2 p = origin + ivec2(x, y);
            if (any(greaterThanEqual(p, size))) continue;
            vec4 light = texelFetch(u_source, p, 0);
            vec4 geometry = texelFetch(u_geometry, p, 0);
            if (u_first_level == 2) {
                float power = dot(max(light.rgb, vec3(0)), LUMA);
                if (power > 0.0) {
                    vec4 moments = geometry / power;
                    geometry = vec4(moments.xy, moments.z * 1024.0,
                        moments.w);
                }
                light.a = clamp(light.a, 0.0, 1.0);
                light.rgb *= EMITTER_STORAGE_SCALE;
            }
            if (u_first_level == 1) {
                vec2 cover = texelFetch(u_cover, p, 0).rg;
                light.rgb = max(light.rgb, vec3(0)) * max(cover.r, 0.0);
                light.a = dot(light.rgb, LUMA) > 0.0 ? 1.0 : 0.0;
                geometry = vec4((vec2(p) + 0.5) / vec2(size),
                                cover.g > 1e-6 ? geometry.a / cover.g : 0.0, 0.0);
            }
            sum += light.rgb / float(block * block);
            coverage += light.a / float(block * block);
            if (light.a <= 0.0) continue;
            float power = dot(light.rgb, LUMA);
            if (power <= 0.0) continue;
            radius_moment += geometry.w * power;
            representative.xyz += geometry.xyz * power;
            depth_moment += (geometry.z * geometry.z + geometry.w * geometry.w) * power;
            mass += power;
        }
    }
    if (mass > 0.0) {
        representative.xyz /= mass;
        representative.w = proxies ? radius_moment / mass :
            sqrt(max(depth_moment / mass - representative.z * representative.z, 0.0));
    }
    out_light = vec4(min(sum, vec3(65504)), coverage);
    out_geometry = representative;
}
// Temporal stabilization of four RGB surface quadrants. Geometry openness is
// current-frame data; only RGB uses reprojected, neighborhood-clamped history.
layout(set = 2, binding = 0) uniform sampler2D u_q0;
layout(set = 2, binding = 1) uniform sampler2D u_q1;
layout(set = 2, binding = 2) uniform sampler2D u_q2;
layout(set = 2, binding = 3) uniform sampler2D u_q3;
layout(set = 2, binding = 4) uniform sampler2D u_prev0;
layout(set = 2, binding = 5) uniform sampler2D u_prev1;
layout(set = 2, binding = 6) uniform sampler2D u_prev2;
layout(set = 2, binding = 7) uniform sampler2D u_prev3;

layout(location = 0) out vec4 out_q0;
layout(location = 1) out vec4 out_q1;
layout(location = 2) out vec4 out_q2;
layout(location = 3) out vec4 out_q3;

layout(set = 3, binding = 0) uniform uniform_block
{
	vec2 u_texel_size;
	vec2 u_history_offset;
	float u_hysteresis;
	int u_history_valid;
};

vec4 current_at(int i, vec2 uv)
{
	if (i == 0) return texture(u_q0, uv);
	if (i == 1) return texture(u_q1, uv);
	if (i == 2) return texture(u_q2, uv);
	return texture(u_q3, uv);
}

vec4 previous_at(int i, vec2 uv)
{
	if (i == 0) return texture(u_prev0, uv);
	if (i == 1) return texture(u_prev1, uv);
	if (i == 2) return texture(u_prev2, uv);
	return texture(u_prev3, uv);
}

void main()
{
	vec2 uv = gl_FragCoord.xy * u_texel_size;
	vec2 history_uv = uv + u_history_offset;
	vec2 inset = u_texel_size * 0.5;
	bool use_history = u_hysteresis < 1.0 && u_history_valid != 0 &&
		all(greaterThanEqual(history_uv, inset)) &&
		all(lessThanEqual(history_uv, vec2(1.0) - inset));
	for (int i = 0; i < 4; i++) {
		vec4 value = current_at(i, uv);
		if (use_history) {
			vec3 lower = value.rgb, upper = value.rgb;
			for (int y = -1; y <= 1; y++) {
				for (int x = -1; x <= 1; x++) {
					vec3 tap = current_at(i, uv + vec2(x, y) * u_texel_size).rgb;
					lower = min(lower, tap);
					upper = max(upper, tap);
				}
			}
			vec3 previous = previous_at(i, history_uv).rgb;
			value.rgb = mix(clamp(previous, lower, upper), value.rgb, u_hysteresis);
		}
		if (i == 0) out_q0 = value;
		else if (i == 1) out_q1 = value;
		else if (i == 2) out_q2 = value;
		else out_q3 = value;
	}
}
// Fixed-budget open-space probes for a projected heightfield receiver.
// Twelve candidates and at most 48 visibility taps per low-resolution cell.
// This reuses HRC quadrants; it does not trace SDFs or loop over emitters.
layout(set = 2, binding = 0) uniform sampler2D u_q0;
layout(set = 2, binding = 1) uniform sampler2D u_q1;
layout(set = 2, binding = 2) uniform sampler2D u_q2;
layout(set = 2, binding = 3) uniform sampler2D u_q3;
layout(set = 2, binding = 4) uniform sampler2D u_source;
layout(set = 2, binding = 5) uniform sampler2D u_albedo;
layout(set = 2, binding = 6) uniform sampler2D u_cover;
layout(set = 2, binding = 7) uniform sampler2D u_normal;
layout(location = 0) out vec4 out_q0;
layout(location = 1) out vec4 out_q1;
layout(location = 2) out vec4 out_q2;
layout(location = 3) out vec4 out_q3;
layout(set = 3, binding = 0) uniform uniform_block
{
    vec2 u_world_per_px;
    float u_radius;
    float u_relief;
    int u_block;
};

vec3 quadrant(int i, vec2 uv)
{
    if (i == 0) return texture(u_q0, uv).rgb;
    if (i == 1) return texture(u_q1, uv).rgb;
    if (i == 2) return texture(u_q2, uv).rgb;
    return texture(u_q3, uv).rgb;
}

bool inside(vec2 uv)
{
    return all(greaterThanEqual(uv, vec2(0))) && all(lessThan(uv, vec2(1)));
}

// Occupied taps are checked against a rising ray, not against equal depth.
// Equal-height receiver pixels stay below it: a flat face can receive light
// through its own footprint. Empty taps do not stop the visibility search.
float visibility(vec2 uv, vec2 offset, float height, float distance)
{
    if (u_relief <= 0.0) return 1.0;
    ivec2 size = textureSize(u_cover, 0);
    for (int j = 1; j <= 4; j++) {
        float fraction = float(j) / 5.0;
        ivec2 p = clamp(ivec2((uv + offset * fraction) * vec2(size)), ivec2(0), size - 1);
        float cover = texelFetch(u_cover, p, 0).g;
        if (cover < 0.5) continue;
        float obstacle = texelFetch(u_albedo, p, 0).a / cover;
        float ray_height = height + distance * fraction / u_relief;
        // Half-float height precision and one projected pixel of slope.
        float bias = max(0.002, max(abs(height), abs(obstacle)) * 0.001);
        bias += max(u_world_per_px.x, u_world_per_px.y) / u_relief;
        if (obstacle > ray_height + bias) return 0.0;
    }
    return 1.0;
}

void main()
{
    ivec2 size = textureSize(u_cover, 0);
    vec2 uv = (gl_FragCoord.xy * float(u_block)) / vec2(size);
    ivec2 p = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
    vec4 geometry = texelFetch(u_cover, p, 0);
    float height = geometry.g > 1e-6 ? texelFetch(u_albedo, p, 0).a / geometry.g : 0.0;
    if (geometry.b > geometry.g * 0.5 && geometry.g > 1e-6) {
        vec2 tilt = texelFetch(u_normal, p, 0).xy / geometry.g;
        float nz = sqrt(max(1.0 - dot(tilt, tilt), 0.0));
        vec2 offset = (uv * vec2(size) - (vec2(p) + 0.5)) * u_world_per_px;
        if (nz > 0.05) height -= dot(tilt, vec2(offset.x, -offset.y)) / nz;
    }
    vec2 axes[4] = vec2[4](vec2(1, 0), vec2(0, 1), vec2(-1, 0), vec2(0, -1));
    vec4 gathered[4];
    for (int i = 0; i < 4; i++) {
        vec3 light = vec3(0);
        float openness = 0.0;
        // Uniform radial quadrature preserves face reach without Gaussian
        // convolution across unrelated geometry. Missing/blocked probes stay
        // in the denominator rather than amplifying the surviving light.
        for (int k = 1; k <= 3; k++) {
            float distance = u_radius * float(k) * 0.5;
            vec2 offset = axes[i] * distance / (u_world_per_px * vec2(size));
            vec2 sample_uv = uv + offset;
            if (!inside(sample_uv)) continue;
            // Camera opacity is independent of transport: a nonabsorbing
            // floor remains a valid probe despite its opaque display color.
            float open = exp(-max(texture(u_source, sample_uv).a, 0.0));
            if (open <= 1e-6) continue;
            openness += open;
            float visible = geometry.g > 0.5 ? visibility(uv, offset, height, distance) : 1.0;
            light += max(quadrant(i, sample_uv), vec3(0)) * open * visible;
        }
        gathered[i] = vec4(light, openness) / 3.0;
    }
    // Composite uses quadrant zero's alpha as the shared receiver reach.
    float open = 0.25 * (gathered[0].a + gathered[1].a + gathered[2].a + gathered[3].a);
    out_q0 = vec4(gathered[0].rgb, open);
    out_q1 = vec4(gathered[1].rgb, open);
    out_q2 = vec4(gathered[2].rgb, open);
    out_q3 = vec4(gathered[3].rgb, open);
}
// Camera-space reconstruction uses the same perspective inversion as the
// depth gather. Projection.w is the receiver grid's full-resolution block.
vec3 surface_position(vec2 pixel, float height, vec4 projection, vec2 spacing)
{
    vec2 plane = projection.xy + pixel * spacing * vec2(1, -1);
    float scale = projection.z > 0.0 ? max(1.0 - height / projection.z, 0.001) : 1.0;
    return vec3(plane * scale, height);
}

vec2 surface_receiver_pixel(ivec2 p, vec2 canvas_size, float block)
{
    return clamp(floor((vec2(p) + 0.5) * block), vec2(0), canvas_size - 1.0) + 0.5;
}

// Raw height differences reject steep neighbors on a single surface. Require
// agreement with both tangent planes instead, retaining separation between
// parallel layers and the existing normal/coverage guards at object edges.
float surface_plane_distance(vec3 delta, vec3 normal, vec3 neighbor_normal)
{
    return max(abs(dot(delta, normal)), abs(dot(delta, neighbor_normal)));
}
// Averages square blocks of u_block texels of the surface seed's images; see
// surface_seed.frag. Each tap filters 2x2 texels, so a block has
// (u_block / 2)^2 taps.

layout(set = 2, binding = 0) uniform sampler2D u_q0;
layout(set = 2, binding = 1) uniform sampler2D u_q1;
layout(set = 2, binding = 2) uniform sampler2D u_q2;
layout(set = 2, binding = 3) uniform sampler2D u_q3;

layout(location = 0) out vec4 out_q0;
layout(location = 1) out vec4 out_q1;
layout(location = 2) out vec4 out_q2;
layout(location = 3) out vec4 out_q3;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_block;
};

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	int taps = u_block / 2;
	vec2 size = vec2(textureSize(u_q0, 0));
	vec4 q0 = vec4(0), q1 = vec4(0), q2 = vec4(0), q3 = vec4(0);
	for (int y = 0; y < taps; y++) {
		for (int x = 0; x < taps; x++) {
			vec2 uv = (vec2(p * u_block) + vec2(2 * x + 1, 2 * y + 1)) / size;
			q0 += texture(u_q0, uv);
			q1 += texture(u_q1, uv);
			q2 += texture(u_q2, uv);
			q3 += texture(u_q3, uv);
		}
	}
	float area = float(taps * taps);
	out_q0 = q0 / area;
	out_q1 = q1 / area;
	out_q2 = q2 / area;
	out_q3 = q3 / area;
}
// Surface seeds average each RGB quadrant over open space in square blocks.
// Every target stores light times openness in RGB and the open fraction in A.
//
// Each tap filters a 2x2 pixel group, so a block has (block / 2)^2 taps; the
// blur that follows is several blocks wide. Blurring these images gives, for
// a solid pixel, the light in the open space around it, how far that space
// is, and the directions the light arrives from.

layout(set = 2, binding = 0) uniform sampler2D u_q0;
layout(set = 2, binding = 1) uniform sampler2D u_q1;
layout(set = 2, binding = 2) uniform sampler2D u_q2;
layout(set = 2, binding = 3) uniform sampler2D u_q3;
layout(set = 2, binding = 4) uniform sampler2D u_scene;

layout(location = 0) out vec4 out_q0;
layout(location = 1) out vec4 out_q1;
layout(location = 2) out vec4 out_q2;
layout(location = 3) out vec4 out_q3;

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_canvas_w;
	int u_canvas_h;
	int u_block;
};

void main()
{
	ivec2 p = ivec2(gl_FragCoord.xy);
	int taps = max(u_block / 2, 1);
	float spacing = float(u_block) / float(taps);
	vec4 q0 = vec4(0), q1 = vec4(0), q2 = vec4(0), q3 = vec4(0);
	for (int y = 0; y < taps; y++) {
		for (int x = 0; x < taps; x++) {
			vec2 uv = (vec2(p * u_block) + (vec2(x, y) + 0.5) * spacing) /
			          vec2(u_canvas_w, u_canvas_h);
			float open = 1.0 - clamp(texture(u_scene, uv).a, 0.0, 1.0);
			q0 += vec4(max(texture(u_q0, uv).rgb, vec3(0)) * open, open);
			q1 += vec4(max(texture(u_q1, uv).rgb, vec3(0)) * open, open);
			q2 += vec4(max(texture(u_q2, uv).rgb, vec3(0)) * open, open);
			q3 += vec4(max(texture(u_q3, uv).rgb, vec3(0)) * open, open);
		}
	}
	float area = float(taps * taps);
	out_q0 = q0 / area;
	out_q1 = q1 / area;
	out_q2 = q2 / area;
	out_q3 = q3 / area;
}
// Adapted from Neon-Swarm shaders/hrc/trace.shd; original source comments retained.
// DDA path-traces the lowest level the hierarchy stores; see hrc_trace.shd.

#include "hrc/hrc_pass.shd"

layout(set = 3, binding = 0) uniform uniform_block
{
	int u_cascade;
	int u_rotate;
	int u_transposed;
	int u_work_w;
	int u_work_h;
	float u_step_scale;
};

#include "hrc/hrc_trace.shd"

void main()
{
	int directions = (1 << u_cascade) + 1;
	ivec2 er = hrc_element_row(u_transposed);
	int probe_x = er.x / directions;
	int k = hrc_parity_item(er.x - probe_x * directions, directions);
	out_value = interval_texel(trace_interval(u_cascade, probe_x, k, er.y));
}
#define HRC_SCALAR 1
#include "hrc/trace.frag"
// From Neon-Swarm shaders/hrc_common.shd.
// Shared HRC cascade utilities: interval type and probe helpers. The RGB
// transport's light is a color. The luminance transport (HRC_SCALAR) carries
// brightness alone and pairs each direction with its opposite: lane x holds
// quadrant u_rotate's value, lane y quadrant u_rotate + 2's.

#ifdef HRC_SCALAR
#define HRC_LIGHT vec2
#define HRC_DEPTH vec2
#else
#define HRC_LIGHT vec3
#define HRC_DEPTH float
#endif

struct Interval
{
	HRC_LIGHT rad;
	HRC_DEPTH tau;
};

int probe_count(int world_w, int n)
{
	int step = 1 << n;
	return (world_w + step - 1) / step;
}

const vec3 HRC_LUMA = vec3(0.2126, 0.7152, 0.0722);
layout(location=0) in vec3 v_world;
layout(location=1) in vec3 v_normal;
layout(location=2) in vec3 v_local;
layout(location=3) in vec3 v_object_normal;
layout(location=4) in vec2 v_uv;
layout(location=5) in vec3 v_part_position;
layout(location=6) in vec3 v_part_frame0;
layout(location=7) in vec3 v_part_frame1;
layout(location=8) in vec3 v_part_frame2;
void main()
{
    if(u_surface.w<=1.5) {
        shade_surface(v_world,v_normal,v_local,v_object_normal,v_uv);
        return;
    }
    vec3 object_rows[3],part_rows[3],uv_rows[2];
    surface_object_frame(object_rows);
    vec3 part_object[3]=vec3[3](v_part_frame0,v_part_frame1,v_part_frame2);
    for(int i=0;i<3;i++) {
        part_rows[i]=part_object[i].x*object_rows[0]
            +part_object[i].y*object_rows[1]+part_object[i].z*object_rows[2];
    }
    vec2 uv=v_uv;
    if(u_uv_bounds[0].w>0.5) {
        vec3 extent=u_uv_bounds[1].xyz-u_uv_bounds[0].xyz;
        vec3 center=(u_uv_bounds[0].xyz+u_uv_bounds[1].xyz)*0.5;
        vec3 local=(v_local-center)/extent;
        vec3 side=abs(v_object_normal);
        uv=side.y>=side.x&&side.y>=side.z ? local.xz+0.5
            : side.x>=side.z ? vec2(local.z+0.5,0.5-local.y)
            : vec2(local.x+0.5,0.5-local.y);
    }
    surface_uv_frame(v_world,uv,uv_rows);
    vec4 parameters[32];
    for(int i=0;i<32;i++) parameters[i]=u_parameters[i];
    shade_surface_points(v_world,v_normal,v_local,v_part_position,uv,
        object_rows,part_rows,uv_rows,int(u_surface.x),parameters);
}
layout(location=0) in vec3 in_pos;
layout(location=1) in vec3 in_normal;
layout(location=2) in vec2 in_uv;
layout(location=3) in vec3 in_part_position;
layout(location=4) in vec3 in_part_frame0;
layout(location=5) in vec3 in_part_frame1;
layout(location=6) in vec3 in_part_frame2;
layout(location=0) out vec3 v_world;
layout(location=1) out vec3 v_normal;
layout(location=2) out vec3 v_local;
layout(location=3) out vec3 v_object_normal;
layout(location=4) out vec2 v_uv;
layout(location=5) out vec3 v_part_position;
layout(location=6) out vec3 v_part_frame0;
layout(location=7) out vec3 v_part_frame1;
layout(location=8) out vec3 v_part_frame2;
layout(set=1,binding=0) uniform uniform_block {
    vec4 u_model[3];
    vec4 u_rect;
    vec2 u_depth;
    vec4 u_eye;
    vec4 u_camera[4];
    float u_part_coordinates;
};
vec3 camera_point(vec3 world)
{
    if(u_camera[3].w<0.5) return world;
    vec3 target=vec3(u_camera[0].w,u_camera[1].w,u_camera[2].w);
    vec3 delta=world-target;
    return vec3(target.x+dot(delta,u_camera[0].xyz),dot(delta,u_camera[1].xyz),
        target.z+dot(delta,u_camera[2].xyz));
}
void main()
{
    vec4 p=vec4(in_pos,1);
    v_world=vec3(dot(u_model[0],p),dot(u_model[1],p),dot(u_model[2],p));
    vec3 a=vec3(u_model[0].x,u_model[1].x,u_model[2].x);
    vec3 b=vec3(u_model[0].y,u_model[1].y,u_model[2].y);
    vec3 c=vec3(u_model[0].z,u_model[1].z,u_model[2].z);
    v_normal=normalize(cross(b,c)*in_normal.x+cross(c,a)*in_normal.y+cross(a,b)*in_normal.z);
    v_uv=in_uv;
    bool authored=u_part_coordinates>0.5;
    v_part_position=authored?in_part_position:in_pos;
    v_part_frame0=authored?in_part_frame0:vec3(1,0,0);
    v_part_frame1=authored?in_part_frame1:vec3(0,1,0);
    v_part_frame2=authored?in_part_frame2:vec3(0,0,1);
    v_local=in_pos;
    v_object_normal=in_normal;
    vec3 aligned=camera_point(v_world);
    gl_Position=vec4((aligned.x-u_rect.x)/u_rect.z*2.0-1.0,
        (-aligned.z-u_rect.y)/u_rect.w*2.0+1.0,
        (u_depth.y-aligned.y)/(u_depth.y-u_depth.x),1);
    if (u_eye.w > 0.5) {
        float focal=u_camera[3].x;
        float d=focal-aligned.y, w=d/focal;
        gl_Position=vec4(
            2.0*(aligned.x-u_camera[0].w)/u_rect.z
                +(2.0*(u_camera[0].w-u_rect.x)/u_rect.z-1.0)*w,
            2.0*(-aligned.z+u_camera[2].w)/u_rect.w
                +(2.0*(-u_camera[2].w-u_rect.y)/u_rect.w+1.0)*w,
            u_depth.y/(u_depth.y-u_depth.x)*(d-u_depth.x)/focal,w);
    }
}
// Adapted from the user-supplied Neon-Swarm shaders. Original shader equations retained.
// Noise utilities (from LYGIA, MIT/Prosperity License)

float random(vec2 st)
{
    return fract(sin(dot(st, vec2(12.9898, 78.233))) * 43758.5453);
}

vec2 random2(vec2 p)
{
    vec4 s = vec4(443.897, 441.423, 0.0973, 0.1099);
    vec3 p3 = fract(p.xyx * s.xyz);
    p3 += dot(p3, p3.yzx + 19.19);
    return fract((p3.xx + p3.yz) * p3.zy);
}

float gnoise(vec2 st)
{
    vec2 i = floor(st);
    vec2 f = fract(st);
    float a = random(i);
    float b = random(i + vec2(1.0, 0.0));
    float c = random(i + vec2(0.0, 1.0));
    float d = random(i + vec2(1.0, 1.0));
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(a, b, u.x) +
           (c - a) * u.y * (1.0 - u.x) +
           (d - b) * u.x * u.y;
}
// 13-tap bloom downsample (Jimenez, "Next Generation Post Processing in Call
// of Duty: Advanced Warfare", 2014). The first level weights each 2x2 group by
// the inverse of its luminance, so single bright pixels do not flicker.
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 source_texel;
    float karis;
};

vec3 tap(vec2 uv)
{
    vec3 c = texture(u_image, uv).rgb;
    if (isnan(c.r) || isnan(c.g) || isnan(c.b)) return vec3(0);
    return clamp(c, vec3(0), vec3(65504));
}

float weight(vec3 c)
{
    return 1.0 / (1.0 + dot(c, vec3(0.2126, 0.7152, 0.0722)));
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv, t = source_texel;
    vec3 a = tap(uv + t * vec2(-2, 2)), b = tap(uv + t * vec2(0, 2)), c = tap(uv + t * vec2(2, 2));
    vec3 d = tap(uv + t * vec2(-2, 0)), e = tap(uv), f = tap(uv + t * vec2(2, 0));
    vec3 g = tap(uv + t * vec2(-2, -2)), h = tap(uv + t * vec2(0, -2)), i = tap(uv + t * vec2(2, -2));
    vec3 j = tap(uv + t * vec2(-1, 1)), k = tap(uv + t * vec2(1, 1));
    vec3 l = tap(uv + t * vec2(-1, -1)), m = tap(uv + t * vec2(1, -1));
    vec3 g0 = (a + b + d + e) * .25, g1 = (b + c + e + f) * .25;
    vec3 g2 = (d + e + g + h) * .25, g3 = (e + f + h + i) * .25;
    vec3 g4 = (j + k + l + m) * .25;
    vec4 w = karis > .5 ? vec4(weight(g0), weight(g1), weight(g2), weight(g3)) : vec4(1);
    float w4 = karis > .5 ? weight(g4) : 1.0;
    vec3 sum = (g0 * w.x + g1 * w.y + g2 * w.z + g3 * w.w) * .125 + g4 * w4 * .5;
    return vec4(sum / (dot(w, vec4(.125)) + w4 * .5), 1);
}
// Linear HDR frame to display: energy-conserving bloom mix, exposure and AgX.
layout(set = 2, binding = 1) uniform sampler2D bloom_tex;
layout(set = 3, binding = 1) uniform shd_uniforms {
    float exposure;
    float bloom;
    float bloom_scale;
    float dither_phase;
};

#include "color.shd"
#include "tonemap.shd"

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv;
    vec3 hdr = finite_hdr(texture(u_image, uv).rgb);
    vec3 glow = finite_hdr(texture(bloom_tex, uv).rgb) * bloom_scale;
    vec3 mapped = agx(mix(hdr, glow, bloom) * exp2(exposure));
    float dither = dither8bit_ign(gl_FragCoord.xy, dither_phase);
    return vec4(clamp(mapped + vec3(dither), vec3(0), vec3(1)), 1);
}
// Bloom upsample: a 3x3 tent filter of the level below, added to this level.
layout(set = 2, binding = 1) uniform sampler2D current;
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 source_texel;
};

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv, t = source_texel;
    vec3 s = texture(u_image, uv + t * vec2(-1, 1)).rgb + texture(u_image, uv + t * vec2(1, 1)).rgb +
             texture(u_image, uv + t * vec2(-1, -1)).rgb + texture(u_image, uv + t * vec2(1, -1)).rgb;
    s += 2.0 * (texture(u_image, uv + t * vec2(0, 1)).rgb + texture(u_image, uv + t * vec2(0, -1)).rgb +
                texture(u_image, uv + t * vec2(1, 0)).rgb + texture(u_image, uv + t * vec2(-1, 0)).rgb);
    s += 4.0 * texture(u_image, uv).rgb;
    return vec4(texture(current, uv).rgb + s / 16.0, 1);
}
layout(location = 0) in vec3 v_normal;
layout(location = 1) in vec3 v_world;
layout(location = 2) flat in vec4 v_material;
#ifdef SCENE3D_MESH
layout(location = 3) in vec2 v_uv;
layout(location = 4) in vec3 v_object_normal;
layout(location = 5) in vec3 v_part_position;
layout(location = 6) in vec3 v_part_frame0;
layout(location = 7) in vec3 v_part_frame1;
layout(location = 8) in vec3 v_part_frame2;
layout(location = 9) in vec4 v_tangent;
#endif
// SCENE3D_SHADOW builds the program that draws a masked material into shadow
// maps: it writes only depth, where the material keeps its pixels, so it reads
// none of the lit pass's maps or outputs.
layout(set = 2, binding = 0) uniform sampler2D scene_parameters;
#ifndef SCENE3D_SHADOW
layout(location = 0) out vec4 result;
layout(set = 2, binding = SG_SHADOW_BINDING) uniform sampler2DShadow scene_shadow_map;
layout(set = 2, binding = SG_SHADOW_BLOCKERS_BINDING) uniform sampler2D scene_shadow_blockers;
layout(set = 2, binding = SG_LIGHT_SHADOW_BINDING) uniform sampler2DShadow scene_light_shadow_map;
layout(set = 2, binding = SG_SKY_SPECULAR_BINDING) uniform samplerCube scene_sky_specular;
layout(set = 2, binding = SG_SKY_BRDF_BINDING) uniform sampler2D scene_sky_brdf;
// The screen's ambient occlusion, one texel per pixel, or one open texel.
layout(set = 2, binding = SG_OCCLUSION_BINDING) uniform sampler2D scene_occlusion;
// SDL's Vulkan backend binds only the first 4 KB of each uniform block, which
// the scene's lights fill, so the sky's light has a block of its own. It takes
// the name draw3d fills besides uniform_block: GLES matches blocks by name.
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec4 scene_sky_light;
    vec4 scene_sky_irradiance[9];
};
#endif
const float PI = 3.141592653589793;
// Taps per blocker search and per soft filter, and the widest radius of each,
// in texels of the cascade; scene3d_shadow.c widens cascades by that radius.
const int SEARCH_TAPS = 16;
const int FILTER_TAPS = 32;
const float SOFT_TEXELS = 128.0;
// The surface's world-space derivatives across the screen.
vec3 world_dx;
vec3 world_dy;

vec4 material_value(int slot)
{
    int texel = int(v_material.x) * 39 + slot;
    return texelFetch(scene_parameters, ivec2(texel % 2048, texel / 2048), 0);
}

vec3 safe_normal(vec3 value, vec3 fallback)
{
    float magnitude = dot(value, value);
    return magnitude > 0.00000001 ? value * inversesqrt(magnitude) : fallback;
}

vec2 primitive_uv(vec3 local, vec3 dimensions, vec3 object_normal, int primitive)
{
    vec3 p = local / dimensions;
    if (primitive == 9 || primitive == 10) p.x -= 1.0 / 6.0;
    if (primitive == 0 || primitive >= 4) {
        vec3 side = abs(object_normal);
        if (side.y >= side.x && side.y >= side.z) return p.xz + 0.5;
        if (side.x >= side.z) return vec2(p.z + 0.5, 0.5 - p.y);
        return vec2(p.x + 0.5, 0.5 - p.y);
    }
    float u = atan(p.z, p.x) / (2.0 * PI) + 0.5;
    if (primitive == 1) {
        vec3 direction = safe_normal(p, vec3(0, 1, 0));
        return vec2(u, 0.5 - asin(clamp(direction.y, -1.0, 1.0)) / PI);
    }
    return vec2(u, 0.5 - p.y);
}

#ifdef SCENE3D_MESH
// A mesh's own texture coordinate, or with source bounds (slot 37's w), the
// box projection of its position within them, as the planar mesh pass does.
vec2 mesh_uv(vec3 local)
{
    vec4 low = material_value(37), high = material_value(38);
    if (low.w < 0.5) return v_uv;
    vec3 p = (local - (low.xyz + high.xyz) * 0.5) / (high.xyz - low.xyz);
    vec3 side = abs(v_object_normal);
    if (side.y >= side.x && side.y >= side.z) return p.xz + 0.5;
    if (side.x >= side.z) return vec2(p.z + 0.5, 0.5 - p.y);
    return vec2(p.x + 0.5, 0.5 - p.y);
}

// Turns the screen-space gradients of a mesh's own texture coordinate onto
// its interpolated tangent and bitangent, keeping their lengths. Per-triangle
// gradients facet normal maps on curved meshes; the vertex frame is smooth
// and is the one the mesh's normal maps were baked against. Box-projected
// coordinates keep their gradients, which the tangents don't describe.
void mesh_uv_frame(vec3 normal, inout vec3 uv_from_world[2])
{
    vec3 tangent = v_tangent.xyz - normal * dot(normal, v_tangent.xyz);
    if (material_value(37).w >= 0.5 || dot(tangent, tangent) < 1e-12) return;
    tangent = normalize(tangent);
    vec3 bitangent = cross(normal, tangent) * (v_tangent.w < 0.0 ? -1.0 : 1.0);
    uv_from_world[0] = tangent * length(uv_from_world[0]);
    uv_from_world[1] = bitangent * length(uv_from_world[1]);
}
#endif

#ifndef SCENE3D_SHADOW
// GGX distribution, height-correlated Smith visibility, Schlick Fresnel.
// Reference: https://google.github.io/filament/main/filament.html#materialsystem/standardmodelsummary
vec3 surface_light(vec3 base, float roughness, float metallic, vec3 normal, vec3 view, vec3 light)
{
    vec3 halfway = safe_normal(light + view, normal);
    float nv = max(dot(normal, view), 0.0001);
    float nl = max(dot(normal, light), 0.0);
    float nh = max(dot(normal, halfway), 0.0);
    float vh = max(dot(view, halfway), 0.0);
    float alpha = max(roughness * roughness, 0.0025);
    float a2 = alpha * alpha;
    float denominator = nh * nh * (a2 - 1.0) + 1.0;
    float distribution = a2 / max(PI * denominator * denominator, 0.00000001);
    float visibility = 0.5 / max(
        nl * sqrt(nv * nv * (1.0 - a2) + a2) +
        nv * sqrt(nl * nl * (1.0 - a2) + a2), 0.0001);
    vec3 f0 = mix(vec3(0.04), base, metallic);
    vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);
    vec3 diffuse = base * (1.0 - metallic) * (1.0 - fresnel) / PI;
    vec3 specular = fresnel * distribution * visibility;
    return (diffuse + specular) * nl;
}

// Nine hardware 2x2 comparisons around coord, a texel apart.
float hard_shadow(vec3 coord, vec2 texel)
{
    float lit = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            lit += textureLod(scene_shadow_map, vec3(coord.xy + vec2(x, y) * texel, coord.z), 0.0);
        }
    }
    return lit / 9.0;
}

// How a cascade's depth changes across its atlas UV along the surface's plane,
// so that wide filters compare each tap against the surface's own depth there
// rather than the center's (receiver plane depth bias).
vec2 depth_slope(mat4 matrix)
{
    vec2 scale = vec2(0.5, -0.5) * scene_shadow.zw;
    vec3 dx = (matrix * vec4(world_dx, 0.0)).xyz, dy = (matrix * vec4(world_dy, 0.0)).xyz;
    dx.xy *= scale;
    dy.xy *= scale;
    float determinant = dx.x * dy.y - dx.y * dy.x;
    if (determinant == 0.0) return vec2(0);
    return vec2(dy.y * dx.z - dx.y * dy.z, dx.x * dy.z - dy.x * dx.z) / determinant;
}

// The receiver's plane at uv. Taps past the far plane compare as the far
// plane, so texels with nothing in them stay lit.
float plane_depth(vec3 coord, vec2 slope, vec2 uv)
{
    return min(coord.z + dot(slope, uv - coord.xy), 1.0);
}

// Tap i of count on a unit Vogel disc turned by angle.
vec2 vogel_tap(int i, int count, float angle)
{
    float theta = float(i) * 2.39996323 + angle;
    return sqrt((float(i) + 0.5) / float(count)) * vec2(cos(theta), sin(theta));
}

// Percentage-closer soft shadows: the farther the receiver lies past the
// blockers around it, the wider its filter, by the sun's angular size. The
// blocker search reads the nearest depth of each 2x2 block of texels, then
// the filter spreads hardware comparisons over a Vogel disc that each pixel
// turns differently. Taps stay inside the cascade's square, low to high.
// Reference: https://developer.download.nvidia.com/shaderlibrary/docs/shadow_PCSS.pdf
float soft_shadow(int cascade, vec3 coord, vec2 low, vec2 high)
{
    vec2 texel = scene_shadow.y * scene_shadow.zw;
    vec2 slope = depth_slope(scene_shadow_matrices[cascade]);
    float per_depth = scene_shadow_soft.x * scene_shadow_ranges[cascade] / scene_shadow_texels[cascade];
    float angle = 2.0 * PI * fract(52.9829189 * fract(dot(gl_FragCoord.xy, vec2(0.06711056, 0.00583715))));
    // A block's nearest texel can lie two texels off the tap, and half floats
    // hold depths near the far plane only to a 2048th.
    float tolerance = 2.0 * dot(abs(slope), texel) + coord.z / 1024.0;
    float search = clamp(per_depth * coord.z, 1.0, SOFT_TEXELS), blockers = 0.0, count = 0.0;
    for (int i = 0; i < SEARCH_TAPS; i++) {
        vec2 uv = clamp(coord.xy + vogel_tap(i, SEARCH_TAPS, angle) * search * texel, low, high);
        float depth = texelFetch(scene_shadow_blockers, ivec2(uv / texel) / 2, 0).r;
        if (depth >= plane_depth(coord, slope, uv) - tolerance) continue;
        blockers += depth;
        count += 1.0;
    }
    float radius = count > 0.0 ? min(per_depth * (coord.z - blockers / count), SOFT_TEXELS) : 0.0;
    if (radius < 1.5) return hard_shadow(coord, texel);
    float lit = 0.0;
    for (int i = 0; i < FILTER_TAPS; i++) {
        vec2 uv = clamp(coord.xy + vogel_tap(i, FILTER_TAPS, angle) * radius * texel, low, high);
        lit += textureLod(scene_shadow_map, vec3(uv, plane_depth(coord, slope, uv)), 0.0);
    }
    return lit / float(FILTER_TAPS);
}

// The sun's visibility from the first cascade, finest first, whose square
// holds the lookup, lifted along its geometric normal by up to 2.5 of that
// cascade's texels so that sloped surfaces stay in front of their own stored
// depth. A sun without angular size compares a 3x3 grid around the point.
float sun_shadow()
{
    vec3 normal = safe_normal(v_normal, vec3(0, 1, 0));
    float facing = clamp(dot(normal, scene_sun_direction.xyz), 0.0, 1.0);
    float lift = 0.5 + 2.0 * sqrt(1.0 - facing * facing);
    float edge = 1.5 * scene_shadow.y;
    vec2 texel = scene_shadow.y * scene_shadow.zw;
    for (int i = 0; i < int(scene_shadow.x); i++) {
        vec4 clip = scene_shadow_matrices[i] * vec4(v_world + normal * lift * scene_shadow_texels[i], 1.0);
        vec2 uv = vec2(clip.x * 0.5 + 0.5, 0.5 - clip.y * 0.5);
        if (any(lessThan(uv, vec2(edge))) || any(greaterThan(uv, vec2(1.0 - edge))) || clip.z >= 1.0) continue;
        vec2 square = vec2(i & 1, i >> 1);
        vec3 coord = vec3((uv + square) * scene_shadow.zw, clip.z);
        if (scene_shadow_soft.x <= 0.0) return hard_shadow(coord, texel);
        return soft_shadow(i, coord, square * scene_shadow.zw + texel, (square + 1.0) * scene_shadow.zw - texel);
    }
    return 1.0;
}

int major_axis(vec3 v)
{
    vec3 a = abs(v);
    return a.x >= a.y && a.x >= a.z ? 0 : a.y >= a.z ? 1 : 2;
}

// The face of light i that holds a point at delta from the light: a spot
// light's one face along its cone, or the one of a point light's six faces
// whose 90 degrees hold it. Faces look along +x, -x, +y, -y, +z and -z, with
// up along +y, or +z for the faces along y, and a spot light's face looks
// along its axis with up along +y, or +z for an axis near y.
void light_face(int i, vec3 delta, out int face, out vec3 forward, out vec3 up, out float spread)
{
    vec4 cone = scene_light_cones[i];
    float scale = length(cone.xyz);
    if (scale > 0.0) {
        // The axis carries the cone's fade width, and the offset its outer
        // edge's cosine.
        float cosine = -cone.w / scale;
        face = 0;
        forward = cone.xyz / scale;
        up = abs(forward.y) > 0.99 ? vec3(0, 0, 1) : vec3(0, 1, 0);
        spread = sqrt(1.0 - cosine * cosine) / cosine * scene_light_shadow.y;
        return;
    }
    int along = major_axis(delta);
    face = 2 * along + (delta[along] >= 0.0 ? 0 : 1);
    forward = vec3(0);
    forward[along] = delta[along] >= 0.0 ? 1.0 : -1.0;
    up = along == 1 ? vec3(0, 0, 1) : vec3(0, 1, 0);
    spread = scene_light_shadow.y;
}

// Light i's visibility from the face that holds the lookup, lifted along the
// geometric normal like the sun's by that face's texels at the point's
// distance, then compared on a 3x3 grid. Each light takes one atlas row of
// faces.
float light_shadow(int i)
{
    vec4 light = scene_light_positions[i];
    vec3 normal = safe_normal(v_normal, vec3(0, 1, 0));
    vec3 delta = v_world - light.xyz;
    vec2 size = vec2(textureSize(scene_light_shadow_map, 0));
    float face_texels = scene_light_shadow.w;
    int face;
    vec3 forward, up;
    float spread;
    light_face(i, delta, face, forward, up, spread);
    float texel = 2.0 * spread * dot(delta, forward) / face_texels;
    // A face's depth runs along its axis, so a surface turned from the axis
    // needs the lift even where it faces the light.
    float facing = min(clamp(-dot(normal, safe_normal(delta, -normal)), 0.0, 1.0), abs(dot(normal, forward)));
    delta += normal * (0.5 + 2.0 * sqrt(1.0 - facing * facing)) * texel;
    light_face(i, delta, face, forward, up, spread);
    vec3 side = normalize(cross(forward, up));
    vec3 above = cross(side, forward);
    float ahead = dot(delta, forward);
    vec2 uv = vec2(dot(delta, side), -dot(delta, above)) / (ahead * spread) * 0.5 + 0.5;
    // Near a wide spot light's edge the lift can carry a lookup past its one
    // face, so every tap stays within the face, reading its edge. A point
    // light picks the face that holds the lifted point, so this never moves it.
    uv = clamp(uv, 1.5 / face_texels, 1.0 - 1.5 / face_texels);
    // Perspective depth with the near plane at a share of the radius.
    float near = scene_light_shadow.z;
    float depth = (1.0 - near * light.w / ahead) / (1.0 - near);
    vec2 coord = (vec2(face, i) + uv) * face_texels / size;
    float lit = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            lit += textureLod(scene_light_shadow_map, vec3(coord + vec2(x, y) / size, depth), 0.0);
        }
    }
    return lit / 9.0;
}

// A world direction in the sky's own frame, turned back by its rotation.
vec3 sky_direction(vec3 d)
{
    float c = scene_sky_light.z, s = scene_sky_light.w;
    return vec3(c * d.x - s * d.z, d.y, s * d.x + c * d.z);
}

// The sky's irradiance on a surface facing n, from its nine spherical
// harmonics (runtime/images/sky.h). Their ringing can dip below zero.
vec3 sky_irradiance(vec3 n)
{
    vec3 result = scene_sky_irradiance[0].rgb + scene_sky_irradiance[1].rgb * n.x +
        scene_sky_irradiance[2].rgb * n.y + scene_sky_irradiance[3].rgb * n.z +
        scene_sky_irradiance[4].rgb * (n.x * n.y) + scene_sky_irradiance[5].rgb * (n.y * n.z) +
        scene_sky_irradiance[6].rgb * (3.0 * n.y * n.y - 1.0) + scene_sky_irradiance[7].rgb * (n.x * n.z) +
        scene_sky_irradiance[8].rgb * (n.x * n.x - n.z * n.z);
    return max(result, vec3(0));
}

// Light from the sky: its irradiance for diffuse, and its prefiltered cube at
// the surface's roughness for specular, scaled by the split-sum terms.
// Reference: https://cdn2.unrealengine.com/Resources/files/2013SiggraphPresentationsNotes-26915738.pdf
vec3 sky_light(vec3 base, float roughness, float metallic, vec3 normal, vec3 view)
{
    float nv = max(dot(normal, view), 0.0001);
    vec2 split = textureLod(scene_sky_brdf, vec2(nv, roughness), 0.0).rg;
    vec3 reflectance = mix(vec3(0.04), base, metallic) * split.x + split.y;
    vec3 diffuse = base * (1.0 - metallic) * (1.0 - reflectance) *
                   sky_irradiance(sky_direction(normal)) / PI;
    vec3 reflected = textureLod(scene_sky_specular, sky_direction(reflect(-view, normal)),
                                roughness * scene_sky_light.y).rgb;
    return (diffuse + reflected * reflectance) * scene_sky_light.x;
}

// A sky lights the scene in place of the ambient colors, which blend from
// ground below to sky above.
vec3 ambient_light(vec3 base, float roughness, float metallic, vec3 normal, vec3 view)
{
    if (scene_sky_light.x > 0.0) return sky_light(base, roughness, metallic, normal, view);
    float sky = 0.5 + 0.5 * normal.y;
    return base * (1.0 - metallic) * mix(scene_ambient_ground.rgb, scene_ambient_sky.rgb, sky);
}

// The screen's ambient occlusion at this pixel.
float screen_occlusion()
{
    vec2 uv = gl_FragCoord.xy / vec2(textureSize(scene_occlusion, 0));
    return textureLod(scene_occlusion, uv, 0.0).r;
}

vec3 direct_light(vec3 base, float roughness, float metallic, float occlusion, vec3 normal, vec3 view)
{
    // Occlusion dims only the ambient and sky light, which arrive from every
    // side; the surface's own and the screen's overlap, so the stronger holds.
    float open = min(occlusion, screen_occlusion());
    vec3 result = ambient_light(base, roughness, metallic, normal, view) * open;
    if (dot(scene_sun_color.rgb, scene_sun_color.rgb) > 0.0) {
        result += surface_light(base, roughness, metallic, normal, view, scene_sun_direction.xyz) *
                  scene_sun_color.rgb * sun_shadow();
    }
    for (int i = 0; i < int(scene_light_count.x); i++) {
        vec3 delta = scene_light_positions[i].xyz - v_world;
        float radius = scene_light_positions[i].w;
        float distance_squared = dot(delta, delta);
        if (distance_squared >= radius * radius || dot(normal, delta) < 0.0) continue;
        float fade = 1.0 - distance_squared / (radius * radius);
        vec3 light = safe_normal(delta, normal);
        // A spot light fades across its cone's edge; a point light's cone
        // leaves it whole.
        float edge = clamp(dot(-light, scene_light_cones[i].xyz) + scene_light_cones[i].w, 0.0, 1.0);
        if (edge <= 0.0) continue;
        vec3 radiance = scene_light_colors[i].rgb * scene_light_colors[i].w * fade * fade * edge * edge;
        if (i < int(scene_light_shadow.x)) radiance *= light_shadow(i);
        result += surface_light(base, roughness, metallic, normal, view, light) * radiance;
    }
    return result;
}

vec4 graphic_particle(vec2 p, int shape, float age, vec4 tint, vec3 emission)
{
    float distance;
    if (shape == 1 || shape == 2) {
        distance = max(-p.x - 0.45, abs(p.y) - (0.9 - p.x) * 0.578);
        if (shape == 2) distance = max(distance, -distance - 0.14);
    } else if (shape == 3) {
        distance = abs(length(p) - 0.72) - mix(0.12, 0.045, age);
    } else if (shape == 4) {
        distance = abs(p.x) + abs(p.y) * 2.6 - 0.88;
    } else {
        // Three crisp lobes make a flat plasma mark, with no spherical shading.
        distance = length((p - vec2(0.05, 0)) * vec2(0.95, 1.12)) - 0.62;
        distance = min(distance, length(p - vec2(-0.42, 0.18)) - 0.33);
        distance = min(distance, length(p - vec2(-0.36, -0.25)) - 0.27);
    }
    float edge = max(fwidth(distance), 0.003);
    float coverage = 1.0 - smoothstep(-edge, edge, distance);
    float core = 1.0 - smoothstep(-edge, edge, distance + 0.19);
    if (shape == 2 || shape == 3) {
        core = 1.0 - smoothstep(-edge, edge, abs(distance + 0.06) - 0.025);
    }
    float ink = 1.0 - smoothstep(-edge, edge, distance + 0.055);
    vec3 body = tint.rgb * mix(0.48, 1.0, ink);
    body = mix(body, vec3(1.0, 0.98, 0.88), core * (0.86 - age * 0.3));
    return vec4(body + emission * (0.45 + core * 0.65), tint.a * coverage);
}
#endif

void main()
{
    vec4 inverse_x = material_value(34), inverse_y = material_value(35), inverse_z = material_value(36);
    vec4 world = vec4(v_world, 1.0);
    vec3 local = vec3(dot(inverse_x, world), dot(inverse_y, world), dot(inverse_z, world));
#ifndef SCENE3D_SHADOW
    if (v_material.w > 0.0) {
        result = graphic_particle(local.xy * 2.0 / material_value(37).xy,
            int(v_material.w) - 1, material_value(2).x, material_value(0), material_value(1).rgb);
        if (result.a <= 0.0) discard;
        return;
    }
#endif
    vec3 normal = safe_normal(v_normal, vec3(0, 1, 0));
    vec3 view = safe_normal(scene_eye.xyz - v_world * scene_eye.w, normal);
    SGSample sg_context;
    sg_context.position = local.xz;
    sg_context.object_position = local;
    sg_context.object_from_world[0]=inverse_x.xyz;
    sg_context.object_from_world[1]=inverse_y.xyz;
    sg_context.object_from_world[2]=inverse_z.xyz;
#ifdef SCENE3D_MESH
    // Baked models carry each vertex's part position and object-to-part frame.
    sg_context.uv = mesh_uv(local);
    sg_context.part_position = v_part_position;
    vec3 part_object[3] = vec3[3](v_part_frame0, v_part_frame1, v_part_frame2);
    for (int i = 0; i < 3; i++) {
        sg_context.part_from_world[i] = part_object[i].x * inverse_x.xyz +
            part_object[i].y * inverse_y.xyz + part_object[i].z * inverse_z.xyz;
    }
#else
    vec3 object_normal = vec3(dot(inverse_x.xyz, normal), dot(inverse_y.xyz, normal), dot(inverse_z.xyz, normal));
    sg_context.uv = primitive_uv(local, material_value(37).xyz, object_normal, int(v_material.z));
    sg_context.part_position = local;
    for(int i=0;i<3;i++) sg_context.part_from_world[i]=sg_context.object_from_world[i];
#endif
    vec3 dx=dFdx(v_world),dy=dFdy(v_world);
    world_dx = dx;
    world_dy = dy;
    vec2 du=dFdx(sg_context.uv),dv=dFdy(sg_context.uv);
    float xx=dot(dx,dx),yy=dot(dy,dy),xy=dot(dx,dy),determinant=xx*yy-xy*xy;
    for(int i=0;i<2;i++) sg_context.uv_from_world[i]=vec3(0);
    if(determinant>1e-20) {
        sg_context.uv_from_world[0]=(dx*(yy*du.x-xy*dv.x)+dy*(xx*dv.x-xy*du.x))/determinant;
        sg_context.uv_from_world[1]=(dx*(yy*du.y-xy*dv.y)+dy*(xx*dv.y-xy*du.y))/determinant;
    }
#ifdef SCENE3D_MESH
    mesh_uv_frame(normal, sg_context.uv_from_world);
#endif
    sg_context.world_position = v_world;
    sg_context.normal = normal;
    sg_context.view_direction = view;
    sg_context.time = scene_time.x;
    vec4 fallback = material_value(0);
    vec3 base = fallback.rgb;
    vec3 emission = material_value(1).rgb;
    float roughness = 0.5, metallic = 0.0, occlusion = 1.0, opacity = fallback.a;
    bool unlit = false;
    int material = int(v_material.y);
    if (material > 0) {
        vec4 parameters[32], surface[SG_OUTPUTS];
        for (int i = 0; i < 32; i++) parameters[i] = material_value(i + 2);
        sg_dispatch(material, sg_context, parameters, surface);
        base = max(surface[0].rgb, vec3(0));
        emission = max(surface[1].rgb, vec3(0));
        roughness = clamp(surface[2].x, 0.0, 1.0);
        metallic = clamp(surface[3].x, 0.0, 1.0);
        normal = safe_normal(surface[4].xyz, normal);
        opacity = clamp(surface[5].x, 0.0, 1.0);
        unlit = surface[6].x > 0.5;
        occlusion = clamp(surface[8].x, 0.0, 1.0);
    }
    if (isnan(opacity) || opacity <= 0.0) discard;
#ifndef SCENE3D_SHADOW
    vec3 color = (unlit ? base : direct_light(base, roughness, metallic, occlusion, normal, view)) + emission;
    // Keep the scene-linear result within RGBA16F storage. A graph can produce
    // a larger value without turning subsequent bloom taps into infinity.
    if (isnan(color.r)) color.r = 0.0;
    if (isnan(color.g)) color.g = 0.0;
    if (isnan(color.b)) color.b = 0.0;
    result = vec4(clamp(color, vec3(0), vec3(65504)), opacity);
#endif
}
layout(location = 0) in vec3 in_pos;
layout(location = 1) in vec3 in_normal;
layout(location = 8) in vec4 in_model0;
layout(location = 9) in vec4 in_model1;
layout(location = 10) in vec4 in_model2;
layout(location = 11) in vec4 in_uv_rect;
layout(location = 15) in vec4 in_mesh_attributes;
layout(location = 0) out vec3 v_normal;
layout(location = 1) out vec3 v_world;
layout(location = 2) flat out vec4 v_material;
layout(set = 1, binding = 0) uniform uniform_block {
    mat4 u_view_projection;
};

// The largest part of `v`, by size.
float largest_part(vec3 v)
{
    return max(abs(v.x), max(abs(v.y), abs(v.z)));
}

// `v` at unit length, divided by its largest part first so that a tiny or
// huge one neither underflows nor overflows on the way.
vec3 direction(vec3 v)
{
    return normalize(v / largest_part(v));
}

void main()
{
    vec4 p = vec4(in_pos, 1.0);
    vec3 world = vec3(dot(in_model0, p), dot(in_model1, p), dot(in_model2, p));
    // Cofactors preserve perpendicular normals under nonuniform scale. A
    // mirroring model's negative determinant would turn them inward. Its
    // sign comes from the axes' directions alone, as the CPU's culling
    // reads it, since the determinant itself underflows float at tiny
    // scales. Dividing every axis by one common scale keeps the cofactors in
    // range and their directions as they were, and taking the normal as the
    // direction of their sum keeps a short sum from underflowing.
    vec3 a = vec3(in_model0.x, in_model1.x, in_model2.x);
    vec3 b = vec3(in_model0.y, in_model1.y, in_model2.y);
    vec3 c = vec3(in_model0.z, in_model1.z, in_model2.z);
    float facing = dot(direction(a), cross(direction(b), direction(c))) < 0.0 ? -1.0 : 1.0;
    float scale = max(largest_part(a), max(largest_part(b), largest_part(c)));
    a /= scale;
    b /= scale;
    c /= scale;
    v_normal = facing * direction(cross(b, c) * in_normal.x + cross(c, a) * in_normal.y +
                                  cross(a, b) * in_normal.z);
    v_world = world;
    v_material = in_uv_rect;
    gl_Position = u_view_projection * vec4(world, 1.0);
}
layout(location = 0) in vec3 in_pos;
layout(location = 1) in vec3 in_normal;
layout(location = 2) in vec2 in_uv;
layout(location = 3) in vec3 in_part_position;
layout(location = 4) in vec3 in_part_frame0;
layout(location = 5) in vec3 in_part_frame1;
layout(location = 6) in vec3 in_part_frame2;
layout(location = 7) in vec4 in_tangent;
layout(location = 8) in vec4 in_model0;
layout(location = 9) in vec4 in_model1;
layout(location = 10) in vec4 in_model2;
layout(location = 11) in vec4 in_uv_rect;
layout(location = 0) out vec3 v_normal;
layout(location = 1) out vec3 v_world;
layout(location = 2) flat out vec4 v_material;
layout(location = 3) out vec2 v_uv;
layout(location = 4) out vec3 v_object_normal;
layout(location = 5) out vec3 v_part_position;
layout(location = 6) out vec3 v_part_frame0;
layout(location = 7) out vec3 v_part_frame1;
layout(location = 8) out vec3 v_part_frame2;
layout(location = 9) out vec4 v_tangent;
layout(set = 1, binding = 0) uniform uniform_block {
    mat4 u_view_projection;
};

// The largest part of `v`, by size.
float largest_part(vec3 v)
{
    return max(abs(v.x), max(abs(v.y), abs(v.z)));
}

// `v` at unit length, divided by its largest part first so that a tiny or
// huge one neither underflows nor overflows on the way.
vec3 direction(vec3 v)
{
    return normalize(v / largest_part(v));
}

// An imported mesh in the lit pass: scene3d.vert's placement, plus the
// vertex's texture coordinate, tangent and model part frame for its material.
void main()
{
    vec4 p = vec4(in_pos, 1.0);
    vec3 world = vec3(dot(in_model0, p), dot(in_model1, p), dot(in_model2, p));
    vec3 a = vec3(in_model0.x, in_model1.x, in_model2.x);
    vec3 b = vec3(in_model0.y, in_model1.y, in_model2.y);
    vec3 c = vec3(in_model0.z, in_model1.z, in_model2.z);
    // As in scene3d.vert, the axes' directions say whether the model
    // mirrors, one common scale keeps their cofactors in range, and the
    // normal is their direction.
    float facing = dot(direction(a), cross(direction(b), direction(c))) < 0.0 ? -1.0 : 1.0;
    float scale = max(largest_part(a), max(largest_part(b), largest_part(c)));
    a /= scale;
    b /= scale;
    c /= scale;
    v_normal = facing * direction(cross(b, c) * in_normal.x + cross(c, a) * in_normal.y +
                                  cross(a, b) * in_normal.z);
    v_world = world;
    v_material = in_uv_rect;
    v_uv = in_uv;
    v_object_normal = in_normal;
    v_part_position = in_part_position;
    v_part_frame0 = in_part_frame0;
    v_part_frame1 = in_part_frame1;
    v_part_frame2 = in_part_frame2;
    // Tangents run along the surface, so they turn with the model, and a
    // mirror turns the bitangent the normal and tangent imply. Taking their
    // direction keeps one along an axis far shorter than the longest.
    v_tangent = vec4(direction(a * in_tangent.x + b * in_tangent.y + c * in_tangent.z), in_tangent.w * facing);
    gl_Position = u_view_projection * vec4(world, 1.0);
}
// Ground-truth ambient occlusion: the share of cosine-weighted sky above each
// texel's surface that the depth around it leaves open. Each slice through
// the view direction searches the depth on both sides for the highest horizon
// within the radius, then integrates the visible arc between them. The
// slices' turn and the steps' offsets change over each 4x4 block of texels,
// which the blur averages.
// Reference: https://www.activision.com/cdn/research/Practical_Real_Time_Strategies_for_Accurate_Indirect_Occlusion_NEW%20VERSION_COLOR.pdf
// and XeGTAO, https://github.com/TechDev/XeGTAO
#include "scene3d_occlusion.shd"

const float PI = 3.141592653589793;
const float HALF_PI = 1.5707963267948966;
// The radius's outer share over which a sample's occlusion fades out.
const float FALLOFF = 0.615;
// The 4x4 ordered dither, one turn per texel of a block.
const float BLOCK[16] = float[16](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0,
                                  3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);

// How far up from the slice's lowest possible horizon the point at pixel q
// rises seen from the center, as the cosine of its angle from the view
// direction, faded out toward the radius. Pixels past the frame's edge show
// nothing; clamping them to it would raise false horizons off the slice.
float horizon(ivec2 q, vec3 center, vec3 eye, float lowest, vec2 falloff)
{
    if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, frame_size()))) return lowest;
    vec3 delta = view_point(q) - center;
    float distance = length(delta);
    if (distance <= 0.0) return lowest;
    float weight = clamp(distance * falloff.x + falloff.y, 0.0, 1.0);
    return mix(lowest, dot(delta, eye) / distance, weight);
}

void main()
{
    ivec2 texel = ivec2(gl_FragCoord.xy);
    ivec2 p = min(texel * int(occlusion_frame.z), frame_size() - 1);
    float depth = depth_at(p);
    // Nothing covers the sky.
    if (depth >= 1.0) {
        result = vec4(1.0);
        return;
    }
    vec2 pixel = vec2(p) + 0.5;
    vec3 center = view_at(pixel, depth);
    vec3 eye = toward_eye(pixel);
    vec3 normal = view_normal(p, center, eye);
    float w = occlusion_lens.y * center.z + occlusion_lens.z;
    float per_unit = occlusion_lens.x / w;
    float reach = min(occlusion_lens.w * per_unit, occlusion_frame.w);
    // A radius under a pixel finds nothing to search.
    if (reach < 1.0) {
        result = vec4(1.0);
        return;
    }
    float radius = reach / per_unit;
    vec2 falloff = vec2(-1.0 / (FALLOFF * radius), (1.0 - FALLOFF) / FALLOFF + 1.0);
    float turn = BLOCK[(texel.x & 3) + 4 * (texel.y & 3)];
    vec2 noise = fract(0.5 + turn * vec2(0.7548776662, 0.5698402910));
    int slices = int(occlusion_search.x), steps = int(occlusion_search.y);
    // Samples start past the center pixel, which tells nothing.
    float nearest = 1.3 / reach;
    float visibility = 0.0;
    for (int slice = 0; slice < slices; slice++) {
        float phi = (float(slice) + noise.x) / float(slices) * PI;
        // Screen rows run down the frame.
        vec2 omega = vec2(cos(phi), -sin(phi));
        // The slice's direction across the view, toward where omega leads.
        vec3 direction = view_at(pixel + omega, depth) - center;
        direction = normalize(direction - dot(direction, eye) * eye);
        vec3 axis = cross(direction, eye);
        vec3 projected = normal - axis * dot(normal, axis);
        float projected_length = length(projected);
        float cos_n = clamp(dot(projected, eye) / max(projected_length, 1e-6), 0.0, 1.0);
        float n = sign(dot(direction, projected)) * acos(cos_n);
        float lowest0 = cos(n + HALF_PI), lowest1 = cos(n - HALF_PI);
        float horizon0 = lowest0, horizon1 = lowest1;
        for (int step = 0; step < steps; step++) {
            float jitter = fract(noise.y + float(slice + step * steps) * 0.6180339887);
            float s = (float(step) + jitter) / float(steps);
            ivec2 offset = ivec2(round((s * s + nearest) * reach * omega));
            horizon0 = max(horizon0, horizon(p + offset, center, eye, lowest0, falloff));
            horizon1 = max(horizon1, horizon(p - offset, center, eye, lowest1, falloff));
        }
        // XeGTAO's correction for slight overdarkening on steep slopes.
        projected_length = mix(projected_length, 1.0, 0.05);
        float h0 = -acos(clamp(horizon1, -1.0, 1.0));
        float h1 = acos(clamp(horizon0, -1.0, 1.0));
        h0 = n + clamp(h0 - n, -HALF_PI, HALF_PI);
        h1 = n + clamp(h1 - n, -HALF_PI, HALF_PI);
        float arc0 = cos_n + 2.0 * h0 * sin(n) - cos(2.0 * h0 - n);
        float arc1 = cos_n + 2.0 * h1 * sin(n) - cos(2.0 * h1 - n);
        visibility += projected_length * (arc0 + arc1) * 0.25;
    }
    // Fades out where the radius covers only a few pixels.
    visibility = visibility / float(slices) + max(0.0, 10.0 - reach) * 0.005;
    result = vec4(clamp(visibility, 0.03, 1.0), 0.0, 0.0, 1.0);
}
// What both occlusion passes read: the camera's depth and how to place it.
layout(location = 0) out vec4 result;
layout(set = 2, binding = 0) uniform sampler2D depth_map;
layout(set = 3, binding = 0) uniform uniform_block {
    // Clip space back to view space.
    mat4 occlusion_unproject;
    // The depth map's size, frame pixels per occlusion texel, and the widest
    // search in pixels.
    vec4 occlusion_frame;
    // Pixels per view unit where clip w is one, clip w's change with view z
    // and its constant, and the radius in view units.
    vec4 occlusion_lens;
    // Slices and steps along each side of a slice.
    vec4 occlusion_search;
};

ivec2 frame_size()
{
    return ivec2(occlusion_frame.xy);
}

// The view-space point at a depth behind pixel coordinate p, whose row 0 is
// the top of the frame, as in the shadow lookups.
vec3 view_at(vec2 p, float depth)
{
    vec2 uv = p / occlusion_frame.xy;
    vec4 view = occlusion_unproject * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    return view.xyz / view.w;
}

float depth_at(ivec2 p)
{
    return texelFetch(depth_map, clamp(p, ivec2(0), frame_size() - 1), 0).r;
}

// The view-space point the depth map holds at pixel p.
vec3 view_point(ivec2 p)
{
    p = clamp(p, ivec2(0), frame_size() - 1);
    return view_at(vec2(p) + 0.5, texelFetch(depth_map, p, 0).r);
}

// The view-space direction toward the eye along pixel coordinate p's ray,
// which orthographic lenses keep parallel.
vec3 toward_eye(vec2 p)
{
    return normalize(view_at(p, 0.0) - view_at(p, 0.5));
}

// The surface's view-space normal at pixel p, facing the eye, from the
// neighbor nearer in depth along each axis, so that it keeps to one surface
// at an edge.
vec3 view_normal(ivec2 p, vec3 center, vec3 eye)
{
    ivec2 last = frame_size() - 1;
    vec3 left = view_point(p - ivec2(1, 0)), right = view_point(p + ivec2(1, 0));
    vec3 above = view_point(p - ivec2(0, 1)), below = view_point(p + ivec2(0, 1));
    bool rightward = p.x < last.x && (p.x == 0 || abs(right.z - center.z) < abs(center.z - left.z));
    bool downward = p.y < last.y && (p.y == 0 || abs(below.z - center.z) < abs(center.z - above.z));
    vec3 across = rightward ? right - center : center - left;
    vec3 down = downward ? below - center : center - above;
    vec3 normal = cross(across, down);
    float length_squared = dot(normal, normal);
    if (length_squared <= 0.0) return eye;
    normal *= inversesqrt(length_squared);
    return dot(normal, eye) < 0.0 ? -normal : normal;
}
// Averages the 4x4 occlusion texels around each frame pixel, which hold every
// turn of the search's slices, weighting each by how near its point lies to
// the pixel's surface plane, so that occlusion keeps to its own surface across
// edges. At half resolution it also brings the occlusion up to the frame's.
#include "scene3d_occlusion.shd"

layout(set = 2, binding = 1) uniform sampler2D occlusion_map;

void main()
{
    ivec2 p = ivec2(gl_FragCoord.xy);
    float depth = depth_at(p);
    if (depth >= 1.0) {
        result = vec4(1.0);
        return;
    }
    vec2 pixel = vec2(p) + 0.5;
    vec3 center = view_at(pixel, depth);
    vec3 normal = view_normal(p, center, toward_eye(pixel));
    int scale = int(occlusion_frame.z);
    // Two pixels' width at the surface, scaled with the search's texels.
    float w = occlusion_lens.y * center.z + occlusion_lens.z;
    float tolerance = 2.0 * float(scale) * w / occlusion_lens.x;
    ivec2 last = textureSize(occlusion_map, 0) - 1;
    ivec2 first = p / scale - 1;
    float sum = 0.0, weights = 0.0;
    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            ivec2 texel = clamp(first + ivec2(x, y), ivec2(0), last);
            float off = dot(normal, view_point(texel * scale) - center) / tolerance;
            // A floor keeps a pixel among other surfaces from dividing by zero.
            float weight = exp2(-off * off) + 1e-3;
            sum += texelFetch(occlusion_map, texel, 0).r * weight;
            weights += weight;
        }
    }
    result = vec4(sum / weights, 0.0, 0.0, 1.0);
}
layout(location = 0) in vec4 v_color;
layout(location = 0) out vec4 color;

void main()
{
    if (isnan(v_color.a) || v_color.a <= 0.0) discard;
    color = vec4(clamp(v_color.rgb, vec3(0.0), vec3(65504.0)), clamp(v_color.a, 0.0, 1.0));
}
layout(location = 0) in vec3 in_pos;
layout(location = 1) in float in_instance_offset;
layout(location = 2) in vec3 in_normal;
layout(location = 0) out vec4 v_color;
layout(set = 1, binding = 0) uniform uniform_block {
    mat4 u_view_projection;
    mat4 particle_frame;
    mat4 particle_normal_frame;
    vec4 particle_dimensions;
    vec4 particle_clock;
    vec4 particle_rhythm;
    vec4 particle_parameters[32];
    vec4 scene_sun_direction;
    vec4 scene_sun_color;
    vec4 scene_ambient_sky;
    vec4 scene_ambient_ground;
    vec4 scene_light_count;
    vec4 scene_light_positions[32];
    vec4 scene_light_colors[32];
    vec4 scene_light_cones[32];
};

#define SG_SCENE_INFLUENCE 1
float sg_scene_beat_phase() { return particle_rhythm.x; }
float sg_scene_beat_pulse() { return particle_rhythm.y; }
vec3 sg_scene_influence(vec3 position) { return vec3(0.0); }

// SG_PARTICLE_PROGRAM is replaced by the prepared shader function.

#ifndef SG_PARTICLE_OUTPUT_COUNT
#define SG_PARTICLE_OUTPUT_COUNT 3
#endif

mat3 particle_rotation(vec3 angle)
{
    vec3 c = cos(angle), s = sin(angle);
    mat3 x = mat3(1, 0, 0, 0, c.x, s.x, 0, -s.x, c.x);
    mat3 y = mat3(c.y, 0, -s.y, 0, 1, 0, s.y, 0, c.y);
    mat3 z = mat3(c.z, s.z, 0, -s.z, c.z, 0, 0, 0, 1);
    return z * y * x;
}

// Small instanced solids receive the scene's direct and hemisphere light.
// They do not sample shadow maps or screen-space occlusion.
vec3 particle_light(vec3 world, vec3 normal)
{
    vec3 radiance = mix(scene_ambient_ground.rgb, scene_ambient_sky.rgb,
                        clamp(normal.y * 0.5 + 0.5, 0.0, 1.0));
    radiance += scene_sun_color.rgb * max(dot(normal, scene_sun_direction.xyz), 0.0);
    for (int i = 0; i < int(scene_light_count.x); ++i) {
        vec3 delta = scene_light_positions[i].xyz - world;
        float radius = scene_light_positions[i].w;
        float squared = dot(delta, delta);
        if (squared >= radius * radius) continue;
        vec3 light = delta * inversesqrt(max(squared, 0.000001));
        float fade = 1.0 - squared / (radius * radius);
        float edge = clamp(dot(-light, scene_light_cones[i].xyz) + scene_light_cones[i].w, 0.0, 1.0);
        radiance += scene_light_colors[i].rgb * scene_light_colors[i].w *
                    fade * fade * edge * edge * max(dot(normal, light), 0.0);
    }
    return radiance;
}

void main()
{
    SGSample context;
    context.position = vec2(0.0);
    context.uv = vec2(0.0);
    context.object_position = vec3(0.0);
    context.part_position = vec3(0.0);
    context.world_position = vec3(0.0);
    context.normal = vec3(0.0);
    context.view_direction = vec3(0.0);
    for (int axis = 0; axis < 3; ++axis) {
        context.object_from_world[axis] = vec3(0.0);
        context.part_from_world[axis] = vec3(0.0);
    }
    context.uv_from_world[0] = vec3(0.0);
    context.uv_from_world[1] = vec3(0.0);
    context.time = particle_clock.x;
    vec4 parameters[32];
    for (int slot = 0; slot < 32; ++slot) parameters[slot] = particle_parameters[slot];
    parameters[0] = vec4(float(gl_InstanceIndex));
    parameters[1] = vec4(particle_clock.y);
    parameters[2] = vec4(particle_clock.z);
    vec4 result[9];
    sg_particle(context, parameters, result);
    float size = max(result[1].x, 0.0);
    vec3 scale = particle_dimensions.xyz;
    mat3 rotation = mat3(1.0);
#if SG_PARTICLE_OUTPUT_COUNT >= 4
    scale *= clamp(result[3].xyz, vec3(0.0001), vec3(10000.0));
#endif
#if SG_PARTICLE_OUTPUT_COUNT >= 5
    rotation = particle_rotation(result[4].xyz);
#endif
    vec3 local = result[0].xyz + rotation * (in_pos * scale * size) + vec3(in_instance_offset);
    vec4 world = particle_frame * vec4(local, 1.0);
    v_color = result[2];
#if SG_PARTICLE_OUTPUT_COUNT >= 6
    float lighting = clamp(result[5].x, 0.0, 1.0);
    if (lighting > 0.0) {
        vec3 normal = normalize((particle_normal_frame * vec4(rotation * (in_normal / scale), 0.0)).xyz);
        v_color.rgb *= mix(vec3(1.0), particle_light(world.xyz, normal), lighting);
    }
#endif
    v_color.rgb *= mix(clamp(v_color.a, 0.0, 1.0), 1.0, particle_clock.w);
    gl_Position = u_view_projection * world;
}
// Mean log2 luminance of the metered grid's lit taps, eased from the previous
// frame's value. A frame with no lit taps meters as middle gray. Rate 1 snaps
// to the current frame without reading the previous one. Slow easing moves
// the value by less than one half-float step a frame, so it is stored as r + g:
// r in steps of 1/64, exact in half floats below 32, and g the remainder.
// The remainder's own steps still let the slowest accepted speed, 0.1, settle
// within 0.02 EV of its target at 240 frames a second.
layout(set = 2, binding = 1) uniform sampler2D previous;
layout(set = 3, binding = 1) uniform shd_uniforms {
    float rate;
};

vec4 shader(vec4 color, ShaderParams params)
{
    ivec2 size = textureSize(u_image, 0);
    vec2 total = vec2(0);
    for (int y = 0; y < size.y; y++) {
        for (int x = 0; x < size.x; x++) {
            total += texelFetch(u_image, ivec2(x, y), 0).rg;
        }
    }
    float current = total.y > 0.0 ? total.x / total.y : log2(0.18);
    if (rate < 1.0) {
        vec4 stored = texelFetch(previous, ivec2(0), 0);
        current = mix(stored.r + stored.g, current, rate);
    }
    float high = floor(current * 64.0) / 64.0;
    return vec4(high, current - high, 0, 1);
}
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 step_uv;
};

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv;
    // Nine-tap Gaussian, sigma two samples. The caller sets their spacing in
    // viewport units, so non-square targets and resizing preserve the radius.
    vec3 c = texture(u_image, uv).rgb * 0.204164;
    c += (texture(u_image, uv - step_uv).rgb + texture(u_image, uv + step_uv).rgb) * 0.180174;
    c += (texture(u_image, uv - step_uv * 2.0).rgb + texture(u_image, uv + step_uv * 2.0).rgb) * 0.123832;
    c += (texture(u_image, uv - step_uv * 3.0).rgb + texture(u_image, uv + step_uv * 3.0).rgb) * 0.066282;
    c += (texture(u_image, uv - step_uv * 4.0).rgb + texture(u_image, uv + step_uv * 4.0).rgb) * 0.027630;
    return vec4(c, 1);
}
// Scene-linear HDR to display: bloom, exposure, then the Environment's tone map.
// Auto exposure moves the adapted mean log2 luminance to middle gray.
layout(set = 2, binding = 1) uniform sampler2D bloom_low;
layout(set = 2, binding = 2) uniform sampler2D bloom_high;
layout(set = 2, binding = 3) uniform sampler2D adapted;
layout(set = 3, binding = 1) uniform shd_uniforms {
    float exposure;
    float strength;
    float level_mix;
    int auto_exposure;
    int tone_mapping;
};

#include "tonemap.shd"

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 uv = params.uv;
    vec3 scene = finite_hdr(texture(u_image, uv).rgb);
    vec3 bloom = vec3(0);
    if (strength > 0.0) {
        bloom = mix(finite_hdr(texture(bloom_low, uv).rgb), finite_hdr(texture(bloom_high, uv).rgb), level_mix);
    }
    float ev = exposure;
    if (auto_exposure != 0) {
        vec4 stored = texelFetch(adapted, ivec2(0), 0);
        ev += log2(0.18) - (stored.r + stored.g);
    }
    vec3 hdr = (scene + bloom * strength) * exp2(ev);
    vec3 mapped = tone_mapping == 0 ? agx(hdr) : srgb_encode(pbr_neutral(hdr));
    return vec4(clamp(mapped, vec3(0), vec3(1)), 1);
}
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 source_texel;
    float threshold;
};

vec3 sample_bright(vec2 uv)
{
    vec3 c = texture(u_image, uv).rgb;
    if (isnan(c.r)) c.r = 0.0;
    if (isnan(c.g)) c.g = 0.0;
    if (isnan(c.b)) c.b = 0.0;
    c = clamp(c, vec3(0), vec3(65504));
    float peak = max(c.r, max(c.g, c.b));
    return threshold < 0.0 ? c : c * max(peak - threshold, 0.0) / max(peak, 0.00001);
}

vec4 shader(vec4 color, ShaderParams params)
{
    vec2 d = source_texel * 0.5;
    vec2 uv = params.uv;
    vec3 c = sample_bright(uv + vec2(-d.x, -d.y));
    c += sample_bright(uv + vec2(d.x, -d.y));
    c += sample_bright(uv + vec2(-d.x, d.y));
    c += sample_bright(uv + d);
    return vec4(c * 0.25, 1);
}
// Meters this texel's footprint in the scene with an 8x8 grid of point taps,
// which sanitize each raw texel so one NaN cannot spoil its neighbors' taps.
// Red is the sum of log2 luminance over lit taps and green the lit count, both
// divided by the tap count. Taps darker than 2^-10, such as an empty
// background, are left out so they cannot brighten the frame.
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 footprint;
};

#include "tonemap.shd"

vec4 shader(vec4 color, ShaderParams params)
{
    const int TAPS = 8;
    float sum = 0.0, lit = 0.0;
    for (int y = 0; y < TAPS; y++) {
        for (int x = 0; x < TAPS; x++) {
            vec2 offset = (vec2(x, y) + 0.5) / float(TAPS) - 0.5;
            vec3 c = finite_hdr(texture(u_image, params.uv + offset * footprint).rgb);
            float luminance = dot(c, vec3(0.2126, 0.7152, 0.0722));
            if (luminance > 1.0 / 1024.0) {
                sum += log2(luminance);
                lit += 1.0;
            }
        }
    }
    return vec4(vec2(sum, lit) / float(TAPS * TAPS), 0, 1);
}
#define SG_SCENE_INFLUENCE 1

layout(set = 3, binding = 0) uniform uniform_block {
    // Where surfaces are seen from: the camera, or the light a shadow pass
    // draws for. A point when w is 1; when w is 0, the direction toward a
    // distant viewer such as the sun.
    vec4 scene_eye;
    vec4 scene_time;
    vec4 scene_rhythm;
    vec4 scene_sun_direction;
    vec4 scene_sun_color;
    vec4 scene_ambient_sky;
    vec4 scene_ambient_ground;
    vec4 scene_light_count;
    vec4 scene_light_positions[32];
    vec4 scene_light_colors[32];
    vec4 scene_light_cones[32];
    vec4 scene_influence_count;
    vec4 scene_influence_positions[64];
    vec4 scene_influence_colors[64];
    mat4 scene_shadow_matrices[4];
    vec4 scene_shadow;
    vec4 scene_shadow_texels;
    vec4 scene_shadow_ranges;
    vec4 scene_shadow_soft;
    vec4 scene_light_shadow;
};

float sg_scene_beat_phase() { return scene_rhythm.x; }
float sg_scene_beat_pulse() { return scene_rhythm.y; }

vec3 sg_scene_influence(vec3 position)
{
    vec3 activity = vec3(0);
    for (int i = 0; i < int(scene_influence_count.x); i++) {
        vec4 source = scene_influence_positions[i];
        vec2 delta = (position.xz - source.xy) / source.z;
        float distance_squared = dot(delta, delta);
        if (distance_squared >= 1.0) continue;
        float fade = 1.0 - distance_squared;
        if (source.w > 0.0) {
            float middle = (1.0 + source.w) * 0.5;
            float half_width = (1.0 - source.w) * 0.5;
            fade = max(0.0, 1.0 - abs(sqrt(distance_squared) - middle) / half_width);
        }
        activity = max(activity, scene_influence_colors[i].rgb * fade * fade);
    }
    return activity;
}
// The shadow map is depth only.
void main()
{
}
layout(location = 0) in vec3 in_pos;
layout(location = 8) in vec4 in_model0;
layout(location = 9) in vec4 in_model1;
layout(location = 10) in vec4 in_model2;
layout(set = 1, binding = 0) uniform uniform_block {
    mat4 u_view_projection;
};

void main()
{
    vec4 p = vec4(in_pos, 1.0);
    vec3 world = vec3(dot(in_model0, p), dot(in_model1, p), dot(in_model2, p));
    gl_Position = u_view_projection * vec4(world, 1.0);
}
// The nearest of each 2x2 block of shadow depths, which the lit pass's blocker
// search reads raw.
layout(set = 2, binding = 0) uniform sampler2D map;
layout(location = 0) out vec4 result;

void main()
{
    ivec2 p = ivec2(gl_FragCoord.xy) * 2;
    float near = min(
        min(texelFetch(map, p, 0).r, texelFetch(map, p + ivec2(1, 0), 0).r),
        min(texelFetch(map, p + ivec2(0, 1), 0).r, texelFetch(map, p + ivec2(1, 1), 0).r));
    result = vec4(near, 0.0, 0.0, 1.0);
}
layout(location = 0) in vec3 v_ray;
layout(location = 0) out vec4 result;
layout(set = 2, binding = 0) uniform samplerCube sky_cube;
layout(set = 3, binding = 0) uniform uniform_block {
    vec4 sky_scale;
};

void main()
{
    result = vec4(min(texture(sky_cube, v_ray).rgb * sky_scale.x, vec3(65504.0)), 1.0);
}
layout(location = 0) in vec2 in_pos;
layout(location = 0) out vec3 v_ray;
layout(set = 1, binding = 0) uniform uniform_block {
    mat4 u_view_projection;
    mat4 sky_rays;
};

void main()
{
    // Two depths along each corner's view ray give its direction. Clip w
    // depends on depth alone, so the direction is linear across the screen
    // and interpolates exactly.
    vec4 near = sky_rays * vec4(in_pos, 0.0, 1.0);
    vec4 far = sky_rays * vec4(in_pos, 0.5, 1.0);
    v_ray = far.xyz / far.w - near.xyz / near.w;
    gl_Position = vec4(in_pos, 1.0, 1.0);
}
// Prefilters the sky for one roughness: each texel of a cube face averages the
// sky over the GGX lobe of a surface facing its direction and seen head on.
// Each sample reads the sky's mip that matches its share of the lobe, so few
// samples suffice.
// Reference: https://developer.nvidia.com/gpugems/gpugems3/part-iii-rendering/chapter-20-gpu-based-importance-sampling
layout(location = 0) out vec4 result;
layout(set = 2, binding = 0) uniform samplerCube sky_cube;
layout(set = 3, binding = 0) uniform uniform_block {
    // Roughness, the face's edge and the sky's in texels, and the face.
    vec4 filter_settings;
};

const float PI = 3.141592653589793;
const uint SAMPLES = 64u;

// Direction through face texel position st in [-1, 1], in the GPU cube-map
// layout that runtime/images/sky.c writes; row 0 holds t = -1.
vec3 face_direction(int face, vec2 st)
{
    float s = st.x, t = st.y;
    if (face == 0) return vec3(1.0, -t, -s);
    if (face == 1) return vec3(-1.0, -t, s);
    if (face == 2) return vec3(s, 1.0, t);
    if (face == 3) return vec3(s, -1.0, -t);
    if (face == 4) return vec3(s, -t, 1.0);
    return vec3(-s, -t, -1.0);
}

// The base-2 radical inverse of bits: Hammersley's second coordinate.
float radical_inverse(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

void main()
{
    float roughness = filter_settings.x, size = filter_settings.y, source = filter_settings.z;
    vec3 n = normalize(face_direction(int(filter_settings.w), gl_FragCoord.xy * 2.0 / size - 1.0));
    if (roughness == 0.0) {
        result = vec4(textureLod(sky_cube, n, max(log2(source / size), 0.0)).rgb, 1.0);
        return;
    }
    vec3 up = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);
    // The direct lights' alpha, and the solid angle of one sky texel.
    float alpha = max(roughness * roughness, 0.0025);
    float a2 = alpha * alpha;
    float texel = 4.0 * PI / (6.0 * source * source);
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (uint i = 0u; i < SAMPLES; i++) {
        float phi = 2.0 * PI * float(i) / float(SAMPLES), u = radical_inverse(i);
        float nh = sqrt((1.0 - u) / (1.0 + (a2 - 1.0) * u));
        float sh = sqrt(1.0 - nh * nh);
        vec3 h = tangent * (sh * cos(phi)) + bitangent * (sh * sin(phi)) + n * nh;
        vec3 l = 2.0 * nh * h - n;
        float nl = dot(n, l);
        if (nl <= 0.0) continue;
        // With the view along the normal, the light's density is D / 4.
        float d = nh * nh * (a2 - 1.0) + 1.0;
        float density = a2 / (4.0 * PI * d * d);
        float lod = 0.5 * log2(1.0 / (float(SAMPLES) * density * texel)) + 1.0;
        sum += textureLod(sky_cube, l, max(lod, 0.0)).rgb * nl;
        weight += nl;
    }
    result = vec4(sum / weight, 1.0);
}
layout(location = 0) in vec4 v_color;
layout(location = 1) in vec4 v_edge;
layout(location = 0) out vec4 result;

void main()
{
    float side = 1.0 - abs(v_edge.x);
    vec3 distance = vec3(side, v_edge.y, v_edge.z);
    vec3 coverage = smoothstep(vec3(0), max(fwidth(distance), vec3(0.00001)), distance);
    float alpha = v_color.a * min(coverage.x, min(coverage.y, coverage.z));
    if (alpha <= 0.0) discard;
    result = vec4(clamp(v_color.rgb * (1.0 + v_edge.w), vec3(0), vec3(65504)), alpha);
}
layout(location = 0) in vec3 in_pos;
layout(location = 1) in vec4 in_color;
layout(location = 2) in vec4 in_edge;
layout(location = 8) in vec4 in_model0;
layout(location = 9) in vec4 in_model1;
layout(location = 10) in vec4 in_model2;
layout(location = 0) out vec4 v_color;
layout(location = 1) out vec4 v_edge;
layout(set = 1, binding = 0) uniform uniform_block {
    mat4 u_view_projection;
    vec4 trail_origin;
};

void main()
{
    vec3 world = vec3(dot(in_model0.xyz, in_pos), dot(in_model1.xyz, in_pos),
                      dot(in_model2.xyz, in_pos)) + trail_origin.xyz;
    v_color = in_color;
    v_edge = in_edge;
    gl_Position = u_view_projection * vec4(world, 1.0);
}
// Adapted from the user-supplied Neon-Swarm shaders. Original shader equations retained.
// Shared SDF primitives.

float sdf_circle(vec2 p, float r)
{
    return length(p) - r;
}

float sdf_circle_stroked(vec2 p, float r, float t)
{
    return abs(length(p) - r) - t * 0.5;
}

float sdf_box(vec2 p, vec2 half_ext, float r)
{
    vec2 d = abs(p) - half_ext + r;
    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0) - r;
}

float sdf_segment(vec2 p, vec2 a, vec2 b)
{
    vec2 ba = b - a;
    vec2 pa = p - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}

float sdf_capsule(vec2 p, vec2 a, vec2 b, float r)
{
    return sdf_segment(p, a, b) - r;
}

float sdf_line(vec2 p, vec2 a, vec2 b, float t)
{
    return sdf_segment(p, a, b) - t * 0.5;
}

float cross2(vec2 a, vec2 b)
{
    return a.x * b.y - a.y * b.x;
}

float sdf_triangle(vec2 p, vec2 a, vec2 b, vec2 c, float r)
{
    vec2 e0 = b - a, e1 = c - b, e2 = a - c;
    vec2 v0 = p - a, v1 = p - b, v2 = p - c;

    vec2 pq0 = v0 - e0 * clamp(dot(v0, e0) / dot(e0, e0), 0.0, 1.0);
    vec2 pq1 = v1 - e1 * clamp(dot(v1, e1) / dot(e1, e1), 0.0, 1.0);
    vec2 pq2 = v2 - e2 * clamp(dot(v2, e2) / dot(e2, e2), 0.0, 1.0);

    float s = sign(cross2(e0, e2));
    vec2 d0 = vec2(dot(pq0, pq0), s * cross2(v0, e0));
    vec2 d1 = vec2(dot(pq1, pq1), s * cross2(v1, e1));
    vec2 d2 = vec2(dot(pq2, pq2), s * cross2(v2, e2));

    vec2 dm = min(min(d0, d1), d2);
    float dist = -sqrt(dm.x) * sign(dm.y);
    return dist - r;
}

float smin(float a, float b, float k)
{
    float h = max(k - abs(a - b), 0.0) / k;
    return min(a, b) - h * h * k * 0.25;
}

float sdf_square(vec2 p, float r)
{
    return max(abs(p.x), abs(p.y)) - r;
}

float sdf_diamond(vec2 p, float r)
{
    return (abs(p.x) + abs(p.y)) - r;
}
#ifndef SG_SHAPE_CALL
#define SG_SHAPE_CALL(id,context,values,result) sg_dispatch(id,context,values,result)
#endif
// Analytic shape graphs are distance bounds in authored object units.
// The box is only a raster proxy; hit depth participates in the mesh group's depth test.
layout(location=0) in vec3 v_world;
layout(location=1) in vec3 v_normal;

vec3 object_point(vec3 p, float w)
{
    vec4 v=vec4(p,w);
    return vec3(dot(v_inverse0,v),dot(v_inverse1,v),dot(v_inverse2,v))+v_center.xyz*w;
}
SGSample shape_context(vec3 p)
{
    SGSample context;
    context.position=p.xz;
    context.uv=p.xz/u_dimensions.xz+0.5;
    context.object_position=p;
    context.part_position=p;
    vec4 local=vec4((p-v_center.xyz)/u_dimensions.xyz,1);
    for(int i=0;i<3;i++) { context.object_from_world[i]=vec3(0); context.part_from_world[i]=vec3(0); }
    for(int i=0;i<2;i++) context.uv_from_world[i]=vec3(0);
    context.world_position=vec3(dot(v_model0,local),dot(v_model1,local),dot(v_model2,local));
    context.normal=vec3(0,1,0);
    context.view_direction=u_camera[3].w<0.5 ? vec3(0,1,0)
        : (u_eye.w>0.5 ? normalize(u_eye.xyz-context.world_position) : u_camera[1].xyz);
    context.time=u_surface.y;
    return context;
}
float distance_at(vec3 p)
{
    SGSample context=shape_context(p);
    vec4 values[32], result[SG_OUTPUTS];
    for(int i=0;i<32;i++) values[i]=SG_SHAPE_PARAMETER(i);
#ifdef SG_MODEL_ISOLATE
    sg_preview_distance(context,values,result);
    float distance=result[0].x*u_preview_options.x;
#else
    SG_SHAPE_CALL(int(u_shape.x),context,values,result);
    float distance=result[0].x;
#endif
#ifdef SG_MODEL_PREVIEW
    if(u_preview_options.y>0.5) distance=max(distance,dot(p,u_preview_plane.xyz)-u_preview_plane.w);
#endif
    return distance;
}
#if SG_ANALYTIC_GRADIENT
vec3 gradient_at(vec3 p, float tolerance)
{
    vec4 values[32];
    for(int i=0;i<32;i++) values[i]=SG_SHAPE_PARAMETER(i);
    return SG_GRADIENT_CALL(shape_context(p),values,tolerance);
}
#endif
void hidden_fragment(int evaluations, float reason)
{
    if(u_sdf_quality.z<1.5) discard;
    // Test-only readback includes discarded rays without GPU atomics.
    result_scene=vec4(float(evaluations)/128.0,1,reason,1);
    result_emission=vec4(0);
    result_absorption=vec4(0);
    result_albedo=vec4(0);
    result_normal=vec4(0);
    gl_FragDepth=0.0;
}
void main()
{
    vec3 aligned=camera_point(v_world);
    vec3 origin=u_eye.w>0.5 ? u_eye.xyz : camera_world(vec3(aligned.x,u_depth.y,aligned.z));
    vec3 direction=u_eye.w>0.5 ? normalize(v_world-origin) : -u_camera[1].xyz;
    float direction_up=camera_vector(direction).y;
    // Begin at the camera near plane so bounds crossing it can still expose later surfaces.
    if(u_eye.w>0.5) origin+=direction*(u_depth.x/max(-direction_up,1e-7));
    vec3 start=object_point(origin,1);
    vec3 ray=normalize(object_point(direction,0));
    // Derivatives must execute before divergent tracing or fragment rejection.
    // Their ray cone follows perspective depth and the instance inverse scale.
    vec3 start_dx=vec3(0), start_dy=vec3(0), ray_dx=vec3(0), ray_dy=vec3(0);
    if(u_sdf_quality.x>0.0) {
        start_dx=dFdx(start); start_dy=dFdy(start);
        ray_dx=dFdx(ray); ray_dy=dFdy(ray);
    }
    vec3 half_size=u_dimensions.xyz*0.5;
    // Outside the proxy only its entry faces need to trace. Inside, retain exit faces.
    if(any(greaterThan(abs(start-v_center.xyz),half_size))&&dot(v_normal,-direction)<=0.0) discard;
    float entry=0.0, exit_distance=1e30;
    for(int axis=0;axis<3;axis++) {
        if(abs(ray[axis])<1e-7) {
            if(abs(start[axis]-v_center[axis])>half_size[axis]) discard;
        } else {
            float a=(v_center[axis]-half_size[axis]-start[axis])/ray[axis];
            float b=(v_center[axis]+half_size[axis]-start[axis])/ray[axis];
            entry=max(entry,min(a,b));
            exit_distance=min(exit_distance,max(a,b));
        }
    }
    if(entry>exit_distance) discard;
    float visible_depth=1.0;
    bool clipped=false;
    if(u_occlusion.x>0.5) {
        visible_depth=min(1.0,texelFetch(u_geometric_depth,ivec2(gl_FragCoord.xy),0).r+u_occlusion.y);
        if(visible_depth<1.0) {
            float y=u_depth.y-visible_depth*(u_depth.y-u_depth.x);
            if(u_eye.w>0.5) {
                float d=u_depth.x*u_depth.y/(u_depth.y-visible_depth*(u_depth.y-u_depth.x));
                y=u_camera[3].x-d;
            }
            float limit=(y-camera_point(origin).y)/direction_up*length(object_point(direction,0));
            clipped=limit<exit_distance;
            exit_distance=min(exit_distance,limit);
            if(entry>exit_distance) { hidden_fragment(0,1.0); return; }
        }
    }
    float epsilon=max(0.00001,max(u_dimensions.x,max(u_dimensions.y,u_dimensions.z))*0.0002);
    float tolerance_cap=max(epsilon,max(u_dimensions.x,max(u_dimensions.y,u_dimensions.z))*0.002);
    float t=entry;
    int evaluations=0;
    bool hit=false, attempted_refinement=false;
    vec3 point=start+ray*t;
#if SG_ANALYTIC_SPHERE
    if(u_sdf_quality.y<0.5) {
        // Exact recognized sphere: one graph evaluation obtains its animated
        // radius. Intersect in object space, including camera-inside cases.
        float radius=-distance_at(vec3(0));
        evaluations++;
        if(radius<=0.0||isnan(radius)||isinf(radius)) discard;
        float b=dot(start,ray);
        vec3 closest=start-ray*b;
        float discriminant=radius*radius-dot(closest,closest);
        if(discriminant<0.0) discard;
        float root=sqrt(discriminant);
        float first=-b-root, last=-b+root;
        t=first>=entry ? first : last;
        if(t<entry) discard;
        if(t>exit_distance) {
            if(clipped) { hidden_fragment(evaluations,0.5); return; }
            discard;
        }
        point=start+ray*t;
        hit=true;
    }
#endif
#ifndef SG_DISTANCE_LIPSCHITZ
#define SG_DISTANCE_LIPSCHITZ 1.0
#endif
    for(int step=0;step<(SG_DISTANCE_LIPSCHITZ>1.0?512:128)&&!hit;step++) {
        point=start+ray*t;
        float distance=distance_at(point);
        evaluations++;
        if(isnan(distance)||isinf(distance)) discard;
        if(abs(distance)<=epsilon) { hit=true; break; }
        if(u_sdf_quality.x>0.0) {
            float footprint=max(length(start_dx+t*ray_dx),length(start_dy+t*ray_dy));
            float tolerance=clamp(u_sdf_quality.x*footprint,epsilon,tolerance_cap);
            // A coarse candidate is never a hit by itself. Refine against the
            // reference residual so silhouettes and thin gaps keep their contract.
            if(!attempted_refinement&&tolerance>epsilon&&abs(distance)<=tolerance) {
                attempted_refinement=true;
                float refined=t, residual=distance;
                for(int refine=0;refine<4;refine++) {
                    float probe=distance_at(start+ray*(refined+epsilon));
                    evaluations++;
                    float slope=(probe-residual)/epsilon;
                    // Near-tangent roots are ill conditioned: a small residual
                    // change can move depth/normals substantially. Keep the
                    // reference march for these rays instead of extrapolating.
                    if(abs(slope)<0.25||isnan(slope)||isinf(slope)) break;
                    float next=refined-residual/slope;
                    if(next<entry||next>exit_distance||abs(next-refined)>tolerance*4.0) break;
                    refined=next;
                    residual=distance_at(start+ray*refined);
                    evaluations++;
                    if(isnan(residual)||isinf(residual)) break;
                    if(abs(residual)<=epsilon) {
                        t=refined; point=start+ray*t; hit=true; break;
                    }
                }
                if(hit) break;
            }
        }
        t+=SG_DISTANCE_LIPSCHITZ>1.0 ? abs(distance)*0.8/SG_DISTANCE_LIPSCHITZ : max(abs(distance)*0.8,epsilon*0.25);
        if(t>exit_distance) break;
    }
    if(!hit) {
        if(clipped&&t>exit_distance) { hidden_fragment(evaluations,0.5); return; }
        discard;
    }
    vec3 local=(point-v_center.xyz)/u_dimensions.xyz;
    vec4 p=vec4(local,1);
    vec3 world=vec3(dot(v_model0,p),dot(v_model1,p),dot(v_model2,p));
    float camera_y=camera_point(world).y;
    float depth=(u_depth.y-camera_y)/(u_depth.y-u_depth.x);
    if(u_eye.w>0.5) {
        float d=u_camera[3].x-camera_y;
        if(d<u_depth.x) discard;
        depth=u_depth.y/(u_depth.y-u_depth.x)*(d-u_depth.x)/d;
    }
    if(depth<0.0||depth>1.0) discard;
    if(depth>visible_depth) { hidden_fragment(evaluations,0.5); return; }
    gl_FragDepth=depth;
    vec2 e=vec2(epsilon,0);
    vec3 normal=vec3(0);
    int normal_evaluations=0;
    bool analytic_normal=false;
#if SG_ANALYTIC_SPHERE
    if(u_sdf_quality.y<0.5) {
        normal=point;
        analytic_normal=true;
    }
#elif SG_ANALYTIC_GRADIENT
    if(u_sdf_quality.y<0.5) {
        normal=gradient_at(point,epsilon);
        normal_evaluations++;
        float squared=dot(normal,normal);
        analytic_normal=squared>=1e-16&&!isnan(squared)&&!isinf(squared);
    }
#endif
    if(!analytic_normal&&u_sdf_quality.y<5.0) {
        // The four tetrahedral offsets have zero mean and an isotropic moment.
        vec3 a=vec3(1,-1,-1), b=vec3(-1,-1,1), c=vec3(-1,1,-1), d=vec3(1,1,1);
        // Tetrahedral differences have first-order bias; use a smaller step
        // than the second-order central stencil, retaining a precision floor.
        float normal_step=max(0.00001,epsilon*0.25);
        normal=a*distance_at(point+a*normal_step)+b*distance_at(point+b*normal_step)
              +c*distance_at(point+c*normal_step)+d*distance_at(point+d*normal_step);
        normal_evaluations+=4;
    } else if(!analytic_normal) {
        normal=vec3(distance_at(point+e.xyy)-distance_at(point-e.xyy),
                    distance_at(point+e.yxy)-distance_at(point-e.yxy),
                    distance_at(point+e.yyx)-distance_at(point-e.yyx));
        normal_evaluations+=6;
    }
    float n2=dot(normal,normal);
    if(n2<1e-16||isnan(n2)||isinf(n2)) discard;
    normal*=inversesqrt(n2);
    vec3 world_normal=normalize(v_inverse0.xyz*normal.x+v_inverse1.xyz*normal.y+v_inverse2.xyz*normal.z);
    vec3 side=abs(normal);
    vec3 uv_dimensions=u_dimensions.xyz;
#ifdef SG_MODEL_ISOLATE
    uv_dimensions=u_preview_uv_bounds[1].xyz;
    local=(point-u_preview_uv_bounds[0].xyz)/uv_dimensions;
#endif
    vec2 uv=side.y>=side.x&&side.y>=side.z ? local.xz+0.5
        : side.x>=side.z ? vec2(local.z+0.5,0.5-local.y)
        : vec2(local.x+0.5,0.5-local.y);
    vec4 geometry_parameters[32], resolved[SG_OUTPUTS];
    for(int i=0;i<32;i++) geometry_parameters[i]=SG_SHAPE_PARAMETER(i);
    SGSample hit_context=shape_context(point);
#ifdef SG_MODEL_ISOLATE
    sg_preview_hit(hit_context,geometry_parameters,resolved);
#else
    sg_model_hit_dispatch(int(u_shape.x),hit_context,geometry_parameters,resolved);
#endif
    int binding_index=sg_model_material_slot(int(u_shape.x),int(resolved[0].x))+1;
    if(binding_index<0||binding_index>32) discard;
    vec4 binding=u_model_materials[binding_index];
    int offset=int(binding.y), count=int(binding.z);
    vec4 material_parameters[32];
    for(int i=0;i<32;i++) material_parameters[i]=i<count ? SG_MATERIAL_PARAMETER(offset+i) : vec4(0);
    vec3 object_rows[3], part_object_rows[3], part_rows[3], uv_rows[2];
    surface_object_frame(object_rows);
    sg_model_frame_dispatch(int(u_shape.x),int(resolved[0].x),hit_context,geometry_parameters,part_object_rows);
    for(int i=0;i<3;i++) part_rows[i]=part_object_rows[i].x*object_rows[0]+part_object_rows[i].y*object_rows[1]+part_object_rows[i].z*object_rows[2];
    uv_rows[0]=(side.y>=side.x&&side.y>=side.z || side.x<side.z) ? object_rows[0]/uv_dimensions.x : object_rows[2]/uv_dimensions.z;
    uv_rows[1]=side.y>=side.x&&side.y>=side.z ? object_rows[2]/uv_dimensions.z : -object_rows[1]/uv_dimensions.y;
    shade_surface_points(world,world_normal,point,resolved[1].xyz,uv,object_rows,part_rows,uv_rows,int(binding.x),material_parameters);
    if(u_sdf_quality.z>0.5) {
        // Optional capture: red is trace evaluations / 128, green marks a hit,
        // blue is normal graph calls / 8 (including a differentiated graph).
        // Misses retain the clear target; no atomics or readback affect normal rendering.
        result_scene=vec4(float(evaluations)/128.0,1,float(normal_evaluations)/8.0,1);
    }
}
layout(location=0) in vec3 in_pos;
layout(location=1) in vec3 in_normal;
layout(location=0) out vec3 v_world;
layout(location=1) out vec3 v_normal;
layout(location=2) in vec4 in_model0;
layout(location=2) flat out vec4 v_model0;
layout(location=3) in vec4 in_model1;
layout(location=3) flat out vec4 v_model1;
layout(location=4) in vec4 in_model2;
layout(location=4) flat out vec4 v_model2;
layout(location=5) in vec4 in_inverse0;
layout(location=5) flat out vec4 v_inverse0;
layout(location=6) in vec4 in_inverse1;
layout(location=6) flat out vec4 v_inverse1;
layout(location=7) in vec4 in_inverse2;
layout(location=7) flat out vec4 v_inverse2;
layout(location=8) in vec4 in_dimensions;
layout(location=8) flat out vec4 v_dimensions;
layout(location=9) in vec4 in_color0;
layout(location=9) flat out vec4 v_color0;
layout(location=10) in vec4 in_color1;
layout(location=10) flat out vec4 v_color1;
layout(location=11) in vec4 in_color2;
layout(location=11) flat out vec4 v_color2;
layout(location=12) in vec4 in_color3;
layout(location=12) flat out vec4 v_color3;
layout(location=13) in vec4 in_surface;
layout(location=13) flat out vec4 v_surface;
layout(location=14) in vec4 in_center;
layout(location=14) flat out vec4 v_center;
layout(set=1,binding=0) uniform uniform_block {
    vec4 u_rect;
    vec2 u_depth;
    vec4 u_eye;
    vec4 u_camera[4];
};
vec3 camera_point(vec3 world)
{
    if(u_camera[3].w<0.5) return world;
    vec3 target=vec3(u_camera[0].w,u_camera[1].w,u_camera[2].w);
    vec3 delta=world-target;
    return vec3(target.x+dot(delta,u_camera[0].xyz),dot(delta,u_camera[1].xyz),
        target.z+dot(delta,u_camera[2].xyz));
}
void main()
{
    v_model0=in_model0;
    v_model1=in_model1;
    v_model2=in_model2;
    v_inverse0=in_inverse0;
    v_inverse1=in_inverse1;
    v_inverse2=in_inverse2;
    v_dimensions=in_dimensions;
    v_color0=in_color0;
    v_color1=in_color1;
    v_color2=in_color2;
    v_color3=in_color3;
    v_surface=in_surface;
    v_center=in_center;
    vec4 p=vec4(in_pos,1);
    v_world=vec3(dot(in_model0,p),dot(in_model1,p),dot(in_model2,p));
    vec3 a=vec3(in_model0.x,in_model1.x,in_model2.x);
    vec3 b=vec3(in_model0.y,in_model1.y,in_model2.y);
    vec3 c=vec3(in_model0.z,in_model1.z,in_model2.z);
    v_normal=normalize(cross(b,c)*in_normal.x+cross(c,a)*in_normal.y+cross(a,b)*in_normal.z);
    vec3 aligned=camera_point(v_world);
    gl_Position=vec4((aligned.x-u_rect.x)/u_rect.z*2.0-1.0,
        (-aligned.z-u_rect.y)/u_rect.w*2.0+1.0,
        (u_depth.y-aligned.y)/(u_depth.y-u_depth.x),1);
    if (u_eye.w > 0.5) {
        float focal=u_camera[3].x;
        float d=focal-aligned.y, w=d/focal;
        gl_Position=vec4(
            2.0*(aligned.x-u_camera[0].w)/u_rect.z
                +(2.0*(u_camera[0].w-u_rect.x)/u_rect.z-1.0)*w,
            2.0*(-aligned.z+u_camera[2].w)/u_rect.w
                +(2.0*(-u_camera[2].w-u_rect.y)/u_rect.w+1.0)*w,
            u_depth.y/(u_depth.y-u_depth.x)*(d-u_depth.x)/focal,w);
    }
}
// Procedural star placement adapted from Neon-Swarm. Cached as unlit presentation.
layout(set = 3, binding = 1) uniform shd_uniforms {
    vec2 camera_pos;
    vec2 world_size;
    vec4 far_layer;
    vec4 middle_layer;
    vec4 near_layer;
    vec3 parallax;
    vec4 palette_a;
    vec4 palette_b;
    vec4 palette_c;
    vec4 palette_d;
};
#include "noise.shd"
vec2 voronoi_star(vec2 pos, float cell_size, float star_radius, float density, vec2 layer_seed)
{
    vec2 cell = floor(pos / cell_size);
    float min_dist = 1e9;
    float color_seed = 0.0;

    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            vec2 neighbor = cell + vec2(float(dx), float(dy));
            vec2 h = random2(neighbor + layer_seed);

            if (h.x > density) continue;

            vec2 star_pos = (neighbor + h) * cell_size;
            float d = length(pos - star_pos);

            if (d < min_dist) {
                min_dist = d;
                color_seed = random(neighbor + layer_seed * 17.31);
            }
        }
    }

    float brightness = exp(-min_dist * min_dist / (star_radius * star_radius));
    brightness = smoothstep(0.3, 1.0, brightness);

    return vec2(brightness, color_seed);
}


vec3 star_color(float seed) {
    float t = seed * 4.0;
    if (t < 1.0) return mix(palette_a.rgb, palette_b.rgb, t);
    if (t < 2.0) return mix(palette_b.rgb, palette_c.rgb, t - 1.0);
    if (t < 3.0) return mix(palette_c.rgb, palette_d.rgb, t - 2.0);
    return mix(palette_d.rgb, palette_a.rgb, t - 3.0);
}
vec3 layer(vec2 offset, vec4 settings, float depth, vec2 seed) {
    if (settings.x <= 0.0 || settings.y <= 0.0 || settings.z <= 0.0) return vec3(0.0);
    vec2 s = voronoi_star(offset + camera_pos * depth, settings.x, settings.y, settings.z, seed);
    return star_color(s.y) * s.x * settings.w;
}
vec4 shader(vec4 color, ShaderParams params) {
    vec2 offset = (screen_uv - 0.5) * vec2(1.0, -1.0) * world_size;
    vec3 stars = layer(offset, far_layer, parallax.x, vec2(0.0));
    stars += layer(offset, middle_layer, parallax.y, vec2(53.7,91.2));
    stars += layer(offset, near_layer, parallax.z, vec2(137.4,219.8));
    return vec4(stars, 1.0);
}
#ifndef SG_MATERIAL_PARAMETER
#define SG_MATERIAL_PARAMETER(i) u_parameters[i]
#endif
#ifndef SG_MATERIAL_CALL
#define SG_MATERIAL_CALL(id,context,values,result) sg_dispatch(id,context,values,result)
#endif
layout(location=0) out vec4 result_scene;
layout(location=1) out vec4 result_emission;
layout(location=2) out vec4 result_absorption;
layout(location=3) out vec4 result_albedo;
layout(location=4) out vec4 result_normal;
vec3 camera_point(vec3 world)
{
    if(u_camera[3].w<0.5) return world;
    vec3 target=vec3(u_camera[0].w,u_camera[1].w,u_camera[2].w);
    vec3 delta=world-target;
    return vec3(target.x+dot(delta,u_camera[0].xyz),dot(delta,u_camera[1].xyz),
        target.z+dot(delta,u_camera[2].xyz));
}
vec3 camera_vector(vec3 world)
{
    if(u_camera[3].w<0.5) return world;
    return vec3(dot(world,u_camera[0].xyz),dot(world,u_camera[1].xyz),dot(world,u_camera[2].xyz));
}
vec3 camera_world(vec3 aligned)
{
    if(u_camera[3].w<0.5) return aligned;
    vec3 target=vec3(u_camera[0].w,u_camera[1].w,u_camera[2].w);
    return target+u_camera[0].xyz*(aligned.x-target.x)+u_camera[1].xyz*aligned.y
        +u_camera[2].xyz*(aligned.z-target.z);
}
vec3 finite_rgb(vec3 value)
{
    if (isnan(value.x)||isinf(value.x)) value.x=0.0;
    if (isnan(value.y)||isinf(value.y)) value.y=0.0;
    if (isnan(value.z)||isinf(value.z)) value.z=0.0;
    return clamp(value,vec3(0),vec3(65504));
}
// UV gradients on the surface are the least-norm world covectors.
void surface_uv_frame(vec3 world, vec2 uv, out vec3 rows[2])
{
    vec3 x=dFdx(world), y=dFdy(world);
    vec2 a=dFdx(uv), b=dFdy(uv);
    float xx=dot(x,x), yy=dot(y,y), xy=dot(x,y), determinant=xx*yy-xy*xy;
    rows[0]=vec3(0); rows[1]=vec3(0);
    if(determinant>1e-20) {
        rows[0]=(x*(yy*a.x-xy*b.x)+y*(xx*b.x-xy*a.x))/determinant;
        rows[1]=(x*(yy*a.y-xy*b.y)+y*(xx*b.y-xy*a.y))/determinant;
    }
}
void surface_object_frame(out vec3 rows[3])
{
    rows[0]=SURFACE_OBJECT0; rows[1]=SURFACE_OBJECT1; rows[2]=SURFACE_OBJECT2;
}
void shade_surface_points(vec3 v_world, vec3 v_normal, vec3 object_point, vec3 part_point, vec2 uv, vec3 object_rows[3], vec3 part_rows[3], vec3 uv_rows[2], int material_id, vec4 parameters[32])
{
    // Shared flat primitives carry both windings. The perspective eye also
    // sees side faces; reject only surfaces facing away from that eye.
    vec3 eye=u_eye.w>0.5 ? u_eye.xyz-v_world : u_camera[1].xyz;
    if (dot(v_normal,eye) <= 0.0) discard;
    vec3 normal=normalize(v_normal);
    vec3 base=SURFACE_COLOR0.rgb, emission=SURFACE_COLOR1.rgb;
    vec3 albedo=SURFACE_COLOR2.rgb, absorption=SURFACE_COLOR3.rgb;
    float opacity=SURFACE_COLOR0.a, absorption_cover=SURFACE_COLOR3.a;
    float gloss=0.5, height=camera_point(v_world).y;
    bool unlit=false;
    if (material_id>0) {
        SGSample context;
        context.position=object_point.xz;
        context.uv=uv;
        context.object_position=object_point;
        context.part_position=part_point;
        for(int i=0;i<3;i++) { context.object_from_world[i]=object_rows[i]; context.part_from_world[i]=part_rows[i]; }
        for(int i=0;i<2;i++) context.uv_from_world[i]=uv_rows[i];
        context.world_position=v_world;
        context.normal=normal;
        context.view_direction=normalize(eye);
        context.time=u_surface.y;
        vec4 surface[SG_OUTPUTS];
        SG_MATERIAL_CALL(material_id,context,parameters,surface);
        base=surface[0].rgb; emission=surface[1].rgb;
        opacity=clamp(surface[5].x,0.0,1.0);
        unlit=surface[6].x>0.5;
        albedo=unlit?vec3(0):base*(1.0-clamp(surface[3].x,0.0,1.0));
        absorption=vec3(opacity); absorption_cover=opacity;
        gloss=1.0-clamp(surface[2].x,0.0,1.0);
        float n2=dot(surface[4].xyz,surface[4].xyz);
        if (n2>1e-8&&!isnan(n2)&&!isinf(n2)) normal=surface[4].xyz*inversesqrt(n2);
        if (!isnan(surface[7].x)&&!isinf(surface[7].x)) height+=surface[7].x;
    }
    // This first mesh contract is opaque. Zero opacity supports cutouts.
    if (isnan(opacity)||opacity<=0.0) discard;
    vec3 aligned_normal=camera_vector(normal);
    vec2 tilt=vec2(aligned_normal.x,-aligned_normal.z);
    float t2=dot(tilt,tilt);
    if(aligned_normal.y<=0.0&&t2>1e-8) tilt*=0.999*inversesqrt(t2);
    result_scene=vec4(finite_rgb(base),1);
    result_emission=vec4(finite_rgb(emission),1);
    result_absorption=vec4(finite_rgb(absorption),clamp(absorption_cover,0.0,1.0));
    result_albedo=vec4(finite_rgb(albedo),clamp(height,-65504.0,65504.0));
    result_normal=unlit?vec4(0):vec4(tilt,u_surface.z,gloss);
}

void shade_surface(vec3 world, vec3 normal, vec3 local, vec3 object_normal, vec2 uv)
{
    if (u_surface.w<=0.5) {
        vec3 side=abs(object_normal);
        uv=side.y>=side.x&&side.y>=side.z ? local.xz+0.5
            : side.x>=side.z ? vec2(local.z+0.5,0.5-local.y)
            : vec2(local.x+0.5,0.5-local.y);
    }
    vec4 parameters[32];
    for (int i=0;i<32;i++) parameters[i]=SG_MATERIAL_PARAMETER(i);
    vec3 object_point=local*u_dimensions.xyz;
    vec3 object_rows[3], uv_rows[2];
    surface_object_frame(object_rows);
    if(u_surface.w>0.5) surface_uv_frame(world,uv,uv_rows);
    else {
        vec3 side=abs(object_normal);
        uv_rows[0]=(side.y>=side.x&&side.y>=side.z || side.x<side.z) ? object_rows[0]/u_dimensions.x : object_rows[2]/u_dimensions.z;
        uv_rows[1]=side.y>=side.x&&side.y>=side.z ? object_rows[2]/u_dimensions.z : -object_rows[1]/u_dimensions.y;
    }
    shade_surface_points(world,normal,object_point,object_point,uv,object_rows,object_rows,uv_rows,int(u_surface.x),parameters);
}
// Display transforms for scene-linear HDR color, shared by the 2D and 3D paths.
// AgX is Troy Sobotka's, with Benjamin Wrensch's polynomial fit of the default
// contrast curve; its curve already encodes for display. PBR Neutral is
// Khronos' and returns linear display color for srgb_encode.

vec3 finite_hdr(vec3 c)
{
    if (isnan(c.r) || isnan(c.g) || isnan(c.b)) return vec3(0);
    return clamp(c, vec3(0), vec3(65504));
}

vec3 agx_contrast(vec3 x)
{
    vec3 x2 = x * x, x4 = x2 * x2;
    return 15.5 * x4 * x2 - 40.14 * x4 * x + 31.96 * x4 - 6.868 * x2 * x +
           0.4298 * x2 + 0.1191 * x - 0.00232;
}

vec3 agx(vec3 c)
{
    const mat3 inset = mat3(0.842479062253094, 0.0423282422610123, 0.0423756549057051,
                            0.0784335999999992, 0.878468636469772, 0.0784336,
                            0.0792237451477643, 0.0791661274605434, 0.879142973793104);
    const mat3 outset = mat3(1.19687900512017, -0.0528968517574562, -0.0529716355144438,
                             -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
                             -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
    const float min_ev = -12.47393, max_ev = 4.026069;
    c = inset * c;
    c = clamp(log2(max(c, vec3(1e-10))), min_ev, max_ev);
    c = (c - min_ev) / (max_ev - min_ev);
    return outset * agx_contrast(c);
}

vec3 pbr_neutral(vec3 c)
{
    const float start = 0.8 - 0.04, desaturation = 0.15;
    float low = min(c.r, min(c.g, c.b));
    c -= low < 0.08 ? low - 6.25 * low * low : 0.04;
    float peak = max(c.r, max(c.g, c.b));
    if (peak < start) return c;
    const float d = 1.0 - start;
    float compressed = 1.0 - d * d / (peak + d - start);
    c *= compressed / peak;
    float g = 1.0 - 1.0 / (desaturation * (peak - compressed) + 1.0);
    return mix(c, vec3(compressed), g);
}

vec3 srgb_encode(vec3 c)
{
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}
// Batched material colors and visible emission, without light transport.
layout(set = 2, binding = 1) uniform sampler2D scene_tex;
layout(set = 2, binding = 2) uniform sampler2D source_tex;
layout(set = 2, binding = 3) uniform sampler2D cover_tex;
layout(set = 2, binding = 4) uniform sampler2D background_tex;
layout(set = 3, binding = 1) uniform shd_uniforms
{
    vec2 lighting;
    float background_present;
};

vec4 shader(vec4 color, ShaderParams params)
{
    vec4 scene = texture(scene_tex, screen_uv);
    // The unlit raster matches the output pixels. Scale emission density by
    // its coverage before displaying it, including partially covered edges.
    vec3 emission = texture(source_tex, screen_uv).rgb * texture(cover_tex, screen_uv).r;
    vec3 background = texture(background_tex, screen_uv).rgb * background_present;
    return vec4(scene.rgb * lighting.x + emission * lighting.y + background * (1.0 - scene.a), 1);
}
<rml>
<head>
    <title>Chibi Graph Canvas</title>
</head>
<body class="graph-canvas">
    <div id="back"></div>
    <div id="world"></div>
    <div id="front"></div>
</body>
</rml>
<rml>
<head>
    <title>Chibi Studio</title>
</head>
<body class="studio">
    <div id="app"></div>
</body>
</rml>
