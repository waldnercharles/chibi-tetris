    state RowHeight: float = 24.0
    state Overscan: int = 6
    state ShownFirst: int = -1
    state ShownCount: int = -1
    on Tick {
        if "max(0, floor(Top / RowHeight) - Overscan)"(get_ui_scroll(Element: "#list")."Scroll Top", state."RowHeight", state."Overscan") != convert<"To Real">(state."ShownFirst") || "ceil(max(View, 400) / RowHeight) + 2 * Overscan"(get_ui_scroll(Element: "#list")."View Height", state."RowHeight", state."Overscan") != convert<"To Real">(state."ShownCount") {
            state."ShownFirst" = convert<"To Integer">("max(0, floor(Top / RowHeight) - Overscan)"(get_ui_scroll(Element: "#list")."Scroll Top", state."RowHeight", state."Overscan"))
            state."ShownCount" = convert<"To Integer">("ceil(max(View, 400) / RowHeight) + 2 * Overscan"(get_ui_scroll(Element: "#list")."View Height", state."RowHeight", state."Overscan"))
            await set_ui_data(Name: "first", Value: "max(0, floor(Top / RowHeight) - Overscan)"(get_ui_scroll(Element: "#list")."Scroll Top", state."RowHeight", state."Overscan"))
            await set_ui_data(Name: "row", Value: state."RowHeight")
            send_event<"ShowRows">(self, convert<"To Integer">("max(0, floor(Top / RowHeight) - Overscan)"(get_ui_scroll(Element: "#list")."Scroll Top", state."RowHeight", state."Overscan")), convert<"To Integer">("ceil(max(View, 400) / RowHeight) + 2 * Overscan"(get_ui_scroll(Element: "#list")."View Height", state."RowHeight", state."Overscan")))
        }
    }
    pure function "max(0, floor(Top / RowHeight) - Overscan)"<T0: float, T1: float, T2: int, T3: double>(Top: T0 = 0.0, RowHeight: T1 = 0.0, Overscan: T2 = 0) -> (Result: T3 = 0.0) {
        return max(real(0.0), floor(entry.Top / entry.RowHeight) - convert<"To Real">(entry.Overscan))
    }
    pure function "ceil(max(View, 400) / RowHeight) + 2 * Overscan"<T0: float, T1: float, T2: int, T3: double>(View: T0 = 0.0, RowHeight: T1 = 0.0, Overscan: T2 = 0) -> (Result: T3 = 0.0) {
        return ceiling(max(entry.View, real(400.0)) / entry.RowHeight) + real(2.0) * convert<"To Real">(entry.Overscan)
    }
}
