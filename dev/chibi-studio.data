e"},{"start":2537,"id":47,"kind":"graph"},{"start":2577,"id":56,"kind":"node"},{"start":2618,"id":59,"kind":"node"},{"start":2685,"id":63,"kind":"node"},{"start":2762,"id":67,"kind":"node"},{"start":2810,"id":70,"kind":"node"},{"start":2851,"id":73,"kind":"node"},{"start":2954,"id":77,"kind":"node"}],"source_hash":"c11a7c378a29d56c"}behavior "WidgetGallery" {
    state Rows: int[] = []
    action rows_2 = set_variable<"Rows">(resize(state."Rows", 10000))
    on Begin {
        rows_2()
    }
    after rows_2 {
        set_ui_data(Name: "total", Value: length(rows_2.Value))
    }
    on ShowRows {
        set_ui_data(Name: "rows", Value: slice(state."Rows", event.First, event.Count))
    }
}
